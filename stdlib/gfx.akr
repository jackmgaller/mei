// 3D meshes: the mesh format, mesh*(), fog, depth sorting (depth_*) and the clipping
// rectangle; also the screen (cls, dither) and the render state the camera, the ordering table
// and the packet arena share (render.akr).
//
// Each frame the runtime resets a 1,024-bucket ordering table (OT) and a packet arena.
// mesh() transforms vertices on the vector unit, culls, fogs and builds GPU packets into
// the arena and inserts them into the OT by depth. 2D calls (text, sprite, rect) append to
// an interface list. At the end of the frame the OT is drawn (farthest first), then the
// interface list on top.

// ---- mesh format (see docs/LANGUAGE.md)

struct Mesh {
    nverts: u16      // vertex count (at most MAX_MESH_VERTS)
    nfaces: u16      // face count
    verts: u32       // byte offset of the vertices from the start of the mesh
    faces: u32       // byte offset of the faces
    windows: u32     // byte offset of the texture window table, 0 for none (see Face.tex)
}

struct Face {
    flags: u8        // FACE_* bits; bits 0-3 match the GPU packet type bits
    blend: u8        // blend mode 0-3 for semi-transparent faces
    tex: u8          // bits 0-3 texture slot, bit 4 set for a 4-bit texture, bits 5-7 texture
                     // window 1-7: the window table's halfword 1-7 (0: none; ignored with no table)
    palette: u8      // palette number
    idx: [4]u16      // vertex indices (quads use all four, in strip order)
    col: [4]u32      // colours 0xBBGGRR; flat faces use col[0]; 0x808080 leaves textures unchanged
    uv: [4]u16       // texture coordinates u | v << 8
}

const FACE_GOURAUD = 1
const FACE_TEXTURED = 2
const FACE_QUAD = 4
const FACE_SEMI = 8
const FACE_DOUBLE = 16     // never culled
const FACE_KEYED = 32      // sorted into the ordering-table bucket held in col[3] (not Gouraud)

const MAX_MESH_VERTS = 2048

// ---- state

var __ot: [1024]u32
var __arena: [40960]u32
var __arena_ptr: *u32
var __arena_end: *u32
var __ui_head: u32
var __ui_tail: *u32
var __sv: [2192]ivec4      // transformed vertices (see __xform); 2048.. is subdiv.akr scratch,
                           // 2176.. clip.akr scratch
var __vp: mat4             // view-projection matrix
var __fx: fixed = 1.299
var __fy: fixed = 1.732
var __cam_near: fixed = 0.1
var __cam_far: fixed = 100.0
var __ot_k3: fixed
var __ot_k4: fixed
var __ot_k3b: fixed        // (camera_clip's scales; depth_key changes __ot_k3/__ot_k4)
var __ot_k4b: fixed
var __ot_user: s32         // depth_bias
var __ot_key: s32          // depth_key's share of __ot_bias
var __fog_on: u32          // 0, or 0x8001 while fog is on (+0x10000 while a mesh with windows draws)
var __fog_near: fixed
var __fog_scale: fixed
var __scr_x0: s32 = 0      // the cull rectangle (cull_rect), screen pixels
var __scr_x1: s32 = 320
var __scr_y0: s32 = 0
var __scr_y1: s32 = 240
var __win_tab: u32         // the window table of the mesh being drawn (__draw_mesh_win)
var __scr_k: [4]fixed = [-1.0, 1.0, 1.0, -1.0]    // its edges in clip space (x/w left, right; y/w top, bottom)

// ---- the screen

// Clears the back buffer now.
fn cls(c: u32) { GPU_CLEAR = rgb15(c) }

fn dither(on: bool) { GPU_CTRL = on as u32 }

// ---- clipping

// The rectangle (screen pixels) outside which mesh*() drop the faces they clip (faces that
// cross the near plane or the guard band): by default the screen, (0, 0)-(320, 240). Faces
// that need no clipping are never dropped for being off the screen, so a cart that keeps the
// packets of a mesh() pass and shifts them on screen later (a panned view drawn from a cache)
// widens the rectangle by the most it will shift them, so the clipped faces are kept as well.
// It stays set until changed; keep it within the guard band (-1000..999).
fn cull_rect(x0: s32, y0: s32, x1: s32, y1: s32) {
    __scr_x0 = x0
    __scr_x1 = x1
    __scr_y0 = y0
    __scr_y1 = y1
    __scr_k[0] = fixed(x0 - 160) / 160
    __scr_k[1] = fixed(x1 - 160) / 160
    __scr_k[2] = fixed(120 - y0) / 120
    __scr_k[3] = fixed(120 - y1) / 120
}

// ---- fog

// Blends vertex colours toward `colour` between view depths near and far. Textured faces
// can only darken (their colour is a tint), so they fade toward half the fog colour.
fn fog(colour: u32, near: fixed, far: fixed) {
    __fog_on = 0x8001
    __fog_col = colour & 0xFFFFFF
    __fogt_col = (colour >> 1) & 0x7F7F7F
    __fog_near = near
    __fog_scale = 256.0 / (far - near)
}

fn fog_off() { __fog_on = 0 }

// ---- meshes

import "faces.akr"
import "subdiv.akr"
import "clip.akr"

// Transforms n vertices by the matrix and projects them into __sv, three at a time (vxp3):
// lane 0 is 1 when screen x and y are both within -1000..999 (the guard band, see clip.akr)
// and 0 otherwise, lane 1 the fog amount 0..1.0 (16.16; unused without fog), lane 2 the
// packed screen position (x & 0xFFFF) | (y << 16), lane 3 the view depth w. Returns 1 when
// every vertex is inside the guard band. 26 cycles per vertex, 40 with fog.
asm fn __xform(src: *vec4, n: s32, dst: *ivec4, m: *mat4) -> s32 {
    vld  v4, [{m}+0]
    vld  v5, [{m}+16]
    vld  v6, [{m}+32]
    vld  v7, [{m}+48]
    bne  {n}, r0, .go
    addi r1, r0, 1
    ret
.go:
    addi sp, sp, -16
    sw   r9, [sp+0]
    sw   r10, [sp+4]
    sw   r11, [sp+8]
    sw   r12, [sp+12]
    addi r9, r0, 2000           ; x + 1000 < 2000 unsigned: -1000 <= x <= 999
    addi r10, r0, 1             ; all inside so far
    vsub v3, v3, v3
    addi r7, r0, 1000
    vset v3, r7, 0
    vset v3, r7, 1              ; v3 = (1000, 1000, 0, 0)
    shli r5, {n}, 4
    add  r5, r5, {src}          ; the end of the vertices
    addi r6, r5, -32            ; three or more are left while src < end - 32
    lbu  r7, [r0+{__fog_on}]
    bne  r7, r0, .fog
    bgeu {src}, r6, .tail
.loop:
    vld  v0, [{src}+0]
    vld  v1, [{src}+16]
    vld  v2, [{src}+32]
.x:
    vxp3 v0, v0
    vadd v0, v0, v3           ; x + 1000, y + 1000
    vget r7, v0, 0
    sltu r7, r7, r9             ; x in the guard band
    vget r8, v0, 1
    sltu r8, r8, r9             ; y in the guard band
    and  r7, r7, r8
    vset v0, r7, 0
    and  r10, r10, r7
    vadd v1, v1, v3           ; x + 1000, y + 1000
    vget r7, v1, 0
    sltu r7, r7, r9             ; x in the guard band
    vget r8, v1, 1
    sltu r8, r8, r9             ; y in the guard band
    and  r7, r7, r8
    vset v1, r7, 0
    and  r10, r10, r7
    vadd v2, v2, v3           ; x + 1000, y + 1000
    vget r7, v2, 0
    sltu r7, r7, r9             ; x in the guard band
    vget r8, v2, 1
    sltu r8, r8, r9             ; y in the guard band
    and  r7, r7, r8
    vset v2, r7, 0
    and  r10, r10, r7
    vst  v0, [{dst}+0]
    bgeu {src}, r6, .part     ; (only the last one or two)
    vst  v1, [{dst}+16]
    vst  v2, [{dst}+32]
    addi {src}, {src}, 48
    addi {dst}, {dst}, 48
    bltu {src}, r6, .loop
.tail:
    ; one or two left: through the same code, padded with copies that are not stored
    beq  {src}, r5, .end
    vld  v0, [{src}+0]
    vmov v1, v0
    vmov v2, v0
    addi r7, {src}, 16
    beq  r7, r5, .x
    vld  v1, [{src}+16]
    jmp  .x
.part:
    addi r7, {src}, 16
    beq  r7, r5, .end
    vst  v1, [{dst}+16]
    jmp  .end
.fog:
    lw   r11, [r0+{__fog_near}]
    lw   r12, [r0+{__fog_scale}]
    bgeu {src}, r6, .ftail
.floop:
    vld  v0, [{src}+0]
    vld  v1, [{src}+16]
    vld  v2, [{src}+32]
.fx:
    vxp3 v0, v0
    vadd v0, v0, v3           ; x + 1000, y + 1000
    vget r7, v0, 0
    sltu r7, r7, r9             ; x in the guard band
    vget r8, v0, 1
    sltu r8, r8, r9             ; y in the guard band
    and  r7, r7, r8
    vset v0, r7, 0
    and  r10, r10, r7
    vget r7, v0, 3
    sub  r7, r7, r11
    fmul r7, r7, r12
    sari r7, r7, 16
    bge  r7, r0, .a0
    mov  r7, r0
.a0:
    slti r8, r7, 257
    bne  r8, r0, .b0
    addi r7, r0, 256
.b0:
    shli r7, r7, 8              ; 0..256 as 16.16
    vset v0, r7, 1
    vadd v1, v1, v3           ; x + 1000, y + 1000
    vget r7, v1, 0
    sltu r7, r7, r9             ; x in the guard band
    vget r8, v1, 1
    sltu r8, r8, r9             ; y in the guard band
    and  r7, r7, r8
    vset v1, r7, 0
    and  r10, r10, r7
    vget r7, v1, 3
    sub  r7, r7, r11
    fmul r7, r7, r12
    sari r7, r7, 16
    bge  r7, r0, .a1
    mov  r7, r0
.a1:
    slti r8, r7, 257
    bne  r8, r0, .b1
    addi r7, r0, 256
.b1:
    shli r7, r7, 8              ; 0..256 as 16.16
    vset v1, r7, 1
    vadd v2, v2, v3           ; x + 1000, y + 1000
    vget r7, v2, 0
    sltu r7, r7, r9             ; x in the guard band
    vget r8, v2, 1
    sltu r8, r8, r9             ; y in the guard band
    and  r7, r7, r8
    vset v2, r7, 0
    and  r10, r10, r7
    vget r7, v2, 3
    sub  r7, r7, r11
    fmul r7, r7, r12
    sari r7, r7, 16
    bge  r7, r0, .a2
    mov  r7, r0
.a2:
    slti r8, r7, 257
    bne  r8, r0, .b2
    addi r7, r0, 256
.b2:
    shli r7, r7, 8              ; 0..256 as 16.16
    vset v2, r7, 1
    vst  v0, [{dst}+0]
    bgeu {src}, r6, .fpart     ; (only the last one or two)
    vst  v1, [{dst}+16]
    vst  v2, [{dst}+32]
    addi {src}, {src}, 48
    addi {dst}, {dst}, 48
    bltu {src}, r6, .floop
.ftail:
    ; one or two left: through the same code, padded with copies that are not stored
    beq  {src}, r5, .end
    vld  v0, [{src}+0]
    vmov v1, v0
    vmov v2, v0
    addi r7, {src}, 16
    beq  r7, r5, .fx
    vld  v1, [{src}+16]
    jmp  .fx
.fpart:
    addi r7, {src}, 16
    beq  r7, r5, .end
    vst  v1, [{dst}+16]
    jmp  .end
.end:
    mov  r1, r10
    lw   r9, [sp+0]
    lw   r10, [sp+4]
    lw   r11, [sp+8]
    lw   r12, [sp+12]
    addi sp, sp, 16
}

// Shifts the ordering-table buckets of the following mesh() calls: negative values draw
// later (nearer). Use it to keep an object in front of large polygons it stands on.
fn depth_bias(buckets: s32) {
    __ot_user = buckets
    __ot_bias = buckets + __ot_key
}

// The ordering-table bucket of view depth w (as mesh*() files a face whose average depth is w).
fn depth_bucket_of(w: fixed) -> s32 {
    return clamp(((w - __cam_near) * (1024.0 / (__cam_far - __cam_near))) as s32, 0, 1023)
}

// Sorts the faces of the following mesh*() calls around one view depth w, instead of each by its
// own average depth alone: a sort key per mesh, for a scene whose painter's order is known (a
// grid seen from a fixed angle, where an object is drawn as a unit by where it stands). The faces
// keep their own order among themselves but squash times closer to w (1: plain sorting; 8 keeps
// an object's faces within an eighth of its depth around w, so they don't interleave with its
// neighbours'). depth_bias() adds to it. Stays set until depth_key_off(). For a key per face,
// see FACE_KEYED.
fn depth_key(w: fixed, squash: s32) {
    let kb = depth_bucket_of(w)
    let n = max(squash, 1)
    __ot_k3 = __ot_k3b / n
    __ot_k4 = __ot_k4b / n
    __ot_key = kb - kb / n
    __ot_bias = __ot_user + __ot_key
}

fn depth_key_off() {
    __ot_k3 = __ot_k3b
    __ot_k4 = __ot_k4b
    __ot_key = 0
    __ot_bias = __ot_user
}

// Draws a mesh whose vertices are in world space.
fn mesh(m: *Mesh) { __draw_mesh(m, __vp) }

// Draws a mesh placed at pos and turned by yaw about +Y.
fn mesh_at(m: *Mesh, pos: vec3, yaw: fixed) {
    let s = sin(yaw)
    let c = cos(yaw)
    var model: mat4
    model[0] = vec4(c, 0.0, s, pos.x)
    model[1] = vec4(0.0, 1.0, 0.0, pos.y)
    model[2] = vec4(-s, 0.0, c, pos.z)
    model[3] = vec4(0.0, 0.0, 0.0, 1.0)
    let mvp = __vp * model
    __draw_mesh(m, mvp)
}

// Draws a mesh with a full model matrix.
fn mesh_xf(m: *Mesh, model: mat4) {
    let mvp = __vp * model
    __draw_mesh(m, mvp)
}

// A mesh with a window table goes to __draw_mesh_win, so the test is all a mesh without one
// pays (its stores to __clip_src and __clip_m moved ahead of __xform pay for it: the same cycles
// as before windows).
fn __draw_mesh(m: *Mesh, mvp: mat4) {
    let nv = m.nverts as s32
    if nv > MAX_MESH_VERTS {
        println("mesh(): too many vertices")
        return
    }
    if m.windows != 0 {
        __draw_mesh_win(m, mvp)
        return
    }
    let base = m as u32
    let src = (base + m.verts) as *vec4
    __clip_src = src      // for faces clip.akr has to clip
    __clip_m = &mvp
    let inside = __xform(src, nv, &__sv[0], &mvp)
    if __subdiv > 0 {
        __sub_src = (base + m.verts) as *vec4
        __sub_mvp = mvp
        __draw_faces_sub((base + m.faces) as *Face, m.nfaces as s32)
    } else if inside == 0 {
        __draw_faces((base + m.faces) as *Face, m.nfaces as s32)
    } else {
        __draw_faces_in((base + m.faces) as *Face, m.nfaces as s32)   // no vertex to clip
    }
}

// The same for a mesh with texture windows: bit 16 of __fog_on sends its faces (and their
// clipped and subdivided pieces) to the face loops' window variants, which look each face's
// window up in __win_tab and put it into the packet's second texture coordinate.
fn __draw_mesh_win(m: *Mesh, mvp: mat4) {
    __win_tab = m as u32 + m.windows
    __fog_on = __fog_on | 0x10000
    let base = m as u32
    let src = (base + m.verts) as *vec4
    __clip_src = src
    __clip_m = &mvp
    let inside = __xform(src, m.nverts as s32, &__sv[0], &mvp)
    if __subdiv > 0 {
        __sub_src = src
        __sub_mvp = mvp
        __draw_faces_sub((base + m.faces) as *Face, m.nfaces as s32)
    } else if inside == 0 {
        __draw_faces((base + m.faces) as *Face, m.nfaces as s32)
    } else {
        __draw_faces_in((base + m.faces) as *Face, m.nfaces as s32)
    }
    __fog_on = __fog_on & 0xFFFF
}
