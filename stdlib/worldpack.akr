// The world pack reader (docs/WORLDPACK.md): a world of square cells read in place from ROM.
// It answers geometric questions only: which cell holds a point, what to draw (far stand-ins,
// then the near ground, then the rest near the camera; culled by bounding sphere, layers applied,
// camera-relative), how to draw small objects into it (entities, the player's character), what is
// under, above or beside a point, where a segment first hits, and which entities become active or
// inactive. What entities, surfaces and layers mean is the game's.
//
// Not part of the prelude: a cart that reads a pack says `import "worldpack.akr"`.
//
//   embed CITY: u8 = "city.world.bin"
//   var hero_b: vec2                                   // the hero mesh's radius and lowest point
//   fn init() {
//       wp_open(CITY)
//       hero_b = wp_mesh_bounds(HERO)
//   }
//   fn draw() {
//       cls(SKY)
//       wp_draw(eye, yaw, pitch)                       // the world, around the camera's cell
//       wp_draw_entities()                             // the live entities' meshes
//       wp_draw_object(HERO, hero_pos, hero_yaw, hero_b.x, hero_pos.y + hero_b.y)
//   }
//
// Coordinates given to and returned by wp_* functions are world coordinates (fixed, Y up). The
// pack stores everything relative to its cell's centre, and the reader works there, so no
// product ever involves a large coordinate: world x and z may use the whole fixed range, but
// a cart's own maths on world positions (length(), dot()) still overflows past about 181.
// One pack is open at a time; an interior is another pack (wp_open it at the door).

import "texanim.akr"       // (wp_animate(), below)

// ---- the format (docs/WORLDPACK.md); every *_off is a byte offset from the pack's start

struct WpHeader {
    magic: u32
    major: u16
    minor: u16
    size: u32
    cell_shift: u8
    flags: u8
    header_size: u16
    i0: s16
    j0: s16
    w: u16
    h: u16
    index_off: u32
    pad: fixed
    overhang: fixed
    region_count: u16
    layer_count: u16
    region_off: u32
    layer_off: u32
    entity_count: u32
    entity_dir_off: u32
    mesh_count: u32
    mesh_dir_off: u32
    path_count: u32    // 1.2 (header_size 72): read only through wp_path_count()
    path_off: u32
    near_far: fixed    // 1.3 (header_size 80): the near pass's far depth, or 0 for 1.5 cells
    lod_slots: u32     // 1.3: placements in cells with a LOD table
}

struct WpLayer {
    name: u32
    group: u8          // exclusive group, 0xFF none
    flags: u8          // bit 0: on when the pack is opened
    reserved: u16
}

struct WpRegion {
    name: u32
    texture_count: u16
    sample_count: u16
    texture_off: u32
    sample_off: u32
    variant_count: u16
    colour_count: u16
    first_colour: u16
    backdrop_count: u16
    palette_off: u32
    backdrop_off: u32
}

struct WpTexture {
    slot: u8
    flags: u8          // bit 0: 4-bit
    reserved: u16
    data: u32
    bytes: u32
}

struct WpCell {
    i: s16
    j: s16
    region: u16
    layer_count: u8
    flags: u8
    layers: [8]u8      // global layer ids of the cell's layer bits 0-7
    bounds: vec4       // sphere (centre x, y, z, radius) around the placements, cell-local
    standin_bounds: vec4
    standin_off: u32
    placement_count: u32
    placement_off: u32
    entity_count: u32
    entity_off: u32
    entity_first: u32  // the global number of its first entity
    coll_off: u32
    ground_count: u32  // 1.1: its first ground_count placements are ground (0 in a 1.0 pack)
    lod_off: u32       // 1.3: a LOD set offset per placement (0: none), or 0 (reserved before 1.3)
    lod_first: u32     // 1.3: the reader's level memory slot of its first placement
    zone_count: u32    // 1.5: its occlusion zones (WpZone), or 0 (reserved before 1.5)
    zone_off: u32
}

struct WpPlacement {
    sphere: vec4       // bounding sphere, cell-local
    pos: vec4          // position, cell-local (w = 0)
    cos: fixed         // yaw, as mesh_at() turns
    sin: fixed
    mesh: u32
    mask: u8           // the cell layer bit it belongs to, or 0
    flags: u8          // bit 0 (1.1): ground
    tag: u16
}

struct WpEntity {
    pos: vec4          // cell-local (w = 0)
    type_id: u16
    mask: u8
    flags: u8          // bit 0: saved_bit is valid
    saved_bit: s32
    yaw: fixed
    mesh: u32
    coll: u32          // a collision block in the entity's own frame, or 0
    params: u32
    params_size: u32
    number: u32
    cell: u32
    reserved: [3]u32
}

struct WpColl {
    grid_shift: u8
    flags: u8
    reserved: u16
    half: fixed        // the lookup grid covers -half..half in x and z
    inv: fixed         // grid columns per unit
    pad: fixed         // walls are filed this much wider: wp_push radii up to it
    floor_count: u32
    floor_off: u32
    wall_count: u32
    wall_off: u32
    ceil_count: u32
    ceil_off: u32
    bucket_off: u32
    list_off: u32
}

struct WpBucket {
    start: u32         // first entry in the block's list of u16 triangle numbers
    nf: u8             // then this many floors, walls and ceilings
    nw: u8
    nc: u8
    reserved: u8
}

// A floor or ceiling: height y = h.x * x + h.y * z + h.z (dot(h, (x, z, 1, 0))), and the edges
// of its outline seen from above: inside where dot(e, (x, z, 1, 0)) >= 0 for all three. h.w
// holds the info word (surface | layer mask << 8 | tag << 16).
struct WpFlat {
    h: vec4
    e0: vec4
    e1: vec4
    e2: vec4
}

// A wall: signed distance dot(p, (x, y, z, 1)) from its plane (positive in front); its edges in
// the plane, inside where dot(e, (x, y, z, 1)) >= 0; the horizontal push direction and
// 1 / its length in the normal.
struct WpWall {
    p: vec4
    e0: vec4
    e1: vec4
    e2: vec4
    hx: fixed
    hz: fixed
    inv: fixed
    info: u32
}

const WP_FLOOR = 0
const WP_WALL = 1
const WP_CEILING = 2
const WP_MAX_TRACK = 25    // cells wp_track() can keep active (radius 2)

// What the last query found.
struct WpHit {
    y: fixed           // wp_floor / wp_ceiling: the height
    t: fixed           // wp_ray: how far along the segment, 0..1
    pos: vec3          // wp_ray: where (world)
    kind: s32          // WP_FLOOR, WP_WALL, WP_CEILING
    surface: s32       // the surface byte
    tag: s32           // the triangle's tag (0xFFFF: none)
    back: bool         // wp_ray: hit from behind
    walls: s32         // wp_push: walls that pushed
    rec: *u8           // the WpFlat or WpWall
    cell: *WpCell
}

struct WpStats {
    near_cells: s32    // near cells looked at
    placements: s32    // placements looked at
    drawn: s32         // placements drawn (ground included)
    standins: s32      // stand-ins drawn
    ground: s32        // ground placements drawn in the ground pass
    coarse: s32        // placements drawn at a level of detail other than 0
    lod_culled: s32    // placements in view not drawn: beyond their LOD cull distance
    occluded: s32      // placements skipped: hidden from the eye's occlusion zone (1.5)
    standins_occluded: s32  // stand-ins skipped so
    zone: s32          // the eye's occlusion zone: its number in the eye's cell, or -1
}

// An occlusion zone (1.5, docs/WORLDPACK.md "Occlusion zones"): while the eye is in its box (in
// its cell's local coordinates, lo <= eye < hi) and its layer is on, the placements whose bits are
// set in the near cells' masks and the stand-ins whose bits are set in far are not drawn.
struct WpZone {
    lo: vec4           // (x, y, z, 0), cell-local
    hi: vec4
    layer: u8          // a layer id: the zone counts only while it is on; 0xFF: always
    flags: u8
    reserved: u16
    far: [2]u32        // stand-ins hidden: bit (dj + 3) * 7 + di + 3 for the cell (di, dj) from this one
    near: [9]u32       // per near cell ((dj + 1) * 3 + di + 1): a mask, a bit per placement, or 0
}

// ---- state and settings

var wp_pack: *WpHeader     // the open pack, or null
var wp_hit: WpHit
var wp_stats: WpStats
var wp_clip_near: fixed = 0.1  // the near pass's near plane
var wp_near_far: fixed     // the near pass's far depth (wp_open: 1.5 cells)
var wp_far_ring: s32 = 3   // the far pass draws stand-ins out to this many cells (< 2: none)
var wp_region_loaded: s32 = -1  // near cells of other regions draw as stand-ins (-1: any)
var wp_ground_first: bool = true  // draw ground placements in a pass of their own, first
var wp_object_bias: fixed = 1.5  // wp_draw_object(): units nearer it sorts an object the eye is above
var wp_object_squash: s32 = 2    // wp_draw_object(): how much it squashes an object's own depths

var wp_lod: bool = true    // levels of detail (1.3); false draws every placement's level 0
var wp_lod_fine: bool      // draw the finest level the hysteresis band allows (the World Checker)
var wp_occlusion: bool = true  // occlusion zones (1.5); false draws what they hide too

var __wp_ground: bool      // the pack is 1.1 or later and has ground placements
var __wp_zones: bool       // the pack is 1.5 or later: cells may have occlusion zones
var __wp_zone: *WpZone     // the last wp_draw()'s occlusion zone, or null
var __wp_eye: vec4         // the last wp_draw()'s eye, relative to its origin (w = 0)
var __wp_eye_y: fixed      // the last wp_draw()'s eye height (world)

var __wp_base: u32
var __wp_shift: s32
var __wp_half: fixed
var __wp_i0: s32
var __wp_j0: s32
var __wp_w: u32
var __wp_h: u32
var __wp_index: *u32
var __wp_layer_on: [32]u8
var __wp_origin: vec3
var __wp_planes: [6]vec4
var __wp_safe_planes: [5]vec4  // a sphere inside all five needs no clipping (__wp_safe)
var __wp_track_n: s32
var __wp_slot_src: [32]u32      // per texture slot: the texture data wp_texture_load() last copied there (0: unknown)
var __wp_track_cell: [WP_MAX_TRACK]u32
var __wp_track_mask: [WP_MAX_TRACK]u32
var __wp_bkey: [16]u32         // wp_entity_draw()'s cache of wp_mesh_bounds(), by mesh address
var __wp_bval: [16]vec2

// ---- opening a pack

// Opens a pack embedded in ROM (or anywhere word-aligned). False, with a message on the debug
// console, if it is not a pack this reader reads (another major version, a bad cell size).
// Layers start as the pack says.
fn wp_open(pack: *u8) -> bool {
    let h = pack as *WpHeader
    wp_pack = null
    if h.magic != 0x5749454D {
        println("wp_open: not a world pack")
        return false
    }
    if h.major != 1 || h.flags & 0xF0 != 0 {
        println("wp_open: pack version is not 1.x, or needs a newer reader")
        return false
    }
    let shift = h.cell_shift as s32
    if shift < 4 || shift > 7 || h.w == 0 || h.h == 0 {
        println("wp_open: bad grid")
        return false
    }
    wp_pack = h
    __wp_ground = h.minor >= 1 && h.flags & 1 != 0
    __wp_zones = h.minor >= 5
    __wp_zone = null
    __wp_base = pack as u32
    __wp_shift = shift
    __wp_half = fixed(1 << (shift - 1))
    __wp_i0 = h.i0 as s32
    __wp_j0 = h.j0 as s32
    __wp_w = h.w as u32
    __wp_h = h.h as u32
    __wp_index = (__wp_base + h.index_off) as *u32
    wp_near_far = __wp_half * 3
    __wp_lod_open(h)
    wp_textures_forget()
    __wp_track_n = 0
    mem_fill(&__wp_bkey[0] as *u8, 0, 64)
    mem_fill(&__wp_layer_on[0], 0, 32)
    let layers = (__wp_base + h.layer_off) as *WpLayer
    for k in 0..h.layer_count as s32 {
        if layers[k].flags & 1 != 0 { __wp_layer_on[k >> 3] |= (1 << (k & 7)) as u8 }
    }
    return true
}

// The cell size in units (1 << the header's cell shift).
fn wp_cell_size() -> s32 { return 1 << __wp_shift }

// ---- cells

// The grid column of world x (or row of world z): floor(x / cell size).
fn wp_cell_index(x: fixed) -> s32 { return (x as s32) >> __wp_shift }

// The cell at grid position (i, j), or null where the world has none.
fn wp_cell(i: s32, j: s32) -> *WpCell {
    let x = (i - __wp_i0) as u32
    let y = (j - __wp_j0) as u32
    if x >= __wp_w || y >= __wp_h { return null }
    let off = __wp_index[y * __wp_w + x]
    if off == 0 { return null }
    return (__wp_base + off) as *WpCell
}

// The cell holding world point p, or null.
fn wp_cell_at(p: vec3) -> *WpCell { return wp_cell(wp_cell_index(p.x), wp_cell_index(p.z)) }

// The world position of a cell's centre (y = 0): its local coordinates are relative to this.
fn wp_cell_centre(c: *WpCell) -> vec3 {
    return vec3(fixed((c.i as s32) << __wp_shift) + __wp_half, 0.0,
                fixed((c.j as s32) << __wp_shift) + __wp_half)
}

// ---- layers

fn wp_layer_count() -> s32 { return wp_pack.layer_count as s32 }

// The layer's name, or null for an id outside 0 .. wp_layer_count() - 1.
fn wp_layer_name(id: s32) -> *u8 {
    if id < 0 || id >= wp_pack.layer_count as s32 { return null }
    let layers = (__wp_base + wp_pack.layer_off) as *WpLayer
    return (__wp_base + layers[id].name) as *u8
}

// The id of the layer with this name, or -1.
fn wp_layer_find(name: *u8) -> s32 {
    let layers = (__wp_base + wp_pack.layer_off) as *WpLayer
    for k in 0..wp_pack.layer_count as s32 {
        if streq((__wp_base + layers[k].name) as *u8, name) { return k }
    }
    return -1
}

fn wp_layer_on(id: s32) -> bool { return (__wp_layer_on[id >> 3] >> (id & 7)) & 1 != 0 }

// Switches a layer on or off in every cell that has it. Switching one on switches off the
// other layers of its exclusive group.
fn wp_layer_set(id: s32, on: bool) {
    if id < 0 || id >= wp_pack.layer_count as s32 { return }
    let layers = (__wp_base + wp_pack.layer_off) as *WpLayer
    if on {
        let g = layers[id].group
        if g != 0xFF {
            for k in 0..wp_pack.layer_count as s32 {
                if layers[k].group == g { __wp_layer_on[k >> 3] &= (~(1 << (k & 7))) as u8 }
            }
        }
        __wp_layer_on[id >> 3] |= (1 << (id & 7)) as u8
    } else {
        __wp_layer_on[id >> 3] &= (~(1 << (id & 7))) as u8
    }
}

// The cell's layer bits that are on now (bit k: its k-th layer).
fn wp_cell_mask(c: *WpCell) -> u32 {
    var m: u32 = 0
    for k in 0..c.layer_count as s32 {
        let id = c.layers[k] as s32
        if (__wp_layer_on[id >> 3] >> (id & 7)) & 1 != 0 { m |= (1 << k) as u32 }
    }
    return m
}

// ---- drawing

// The world position the last wp_draw() drew around: everything drawn after it this frame is
// drawn relative to it (mesh_at(m, pos - wp_view_origin(), yaw)).
fn wp_view_origin() -> vec3 { return __wp_origin }

// Draws the world from eye (world position) looking along yaw and pitch, as camera_look()
// would, and leaves that camera set (relative to wp_view_origin()) with the near pass's clip
// range. First the far pass: the stand-ins of the cells 2..wp_far_ring cells from the eye's
// cell, sorted in a table of their own and drawn at once (ot_flush()). Then the near pass, over
// the placements of the 3 x 3 cells around it whose layers are on and whose spheres are in view:
// their ground placements first, sorted among themselves and drawn at once (ot_flush(), when
// wp_ground_first is set and any was drawn), so that nothing standing on the ground can sort
// behind it; then the rest, into the frame's table, which the cart's own meshes join. Call it
// after cls(). (depth.akr replaces it with a version that does the same with the depth test off
// and draws in depth mode with it on: keep the two in step.)
weak fn wp_draw(eye: vec3, yaw: fixed, pitch: fixed) {
    let ci = wp_cell_index(eye.x)
    let cj = wp_cell_index(eye.z)
    __wp_origin = vec3(fixed(ci << __wp_shift) + __wp_half, 0.0, fixed(cj << __wp_shift) + __wp_half)
    let local = eye - __wp_origin
    __wp_eye_y = eye.y
    __wp_eye = vec4(local.x, local.y, local.z, 0.0)
    wp_stats = WpStats {}
    __wp_zone_find(wp_cell(ci, cj))
    let size = __wp_half * 2
    let r = wp_far_ring
    if r >= 2 {
        let far = size * (2 * r + 1) * 3 / 4
        camera_clip(__wp_half, far)
        camera_look(local, yaw, pitch)
        __wp_frustum(__wp_half, far)
        for dj in -r..r + 1 {
            for di in -r..r + 1 {
                if max(abs(di), abs(dj)) < 2 { continue }
                let c = wp_cell(ci + di, cj + dj)
                if c != null && c.standin_off != 0 { __wp_standin(c, di, dj) }
            }
        }
        ot_flush()
    }
    camera_clip(wp_clip_near, wp_near_far)
    camera_look(local, yaw, pitch)
    __wp_frustum(wp_clip_near, wp_near_far)
    let ground = wp_ground_first && __wp_ground
    if ground {
        for dj in -1..2 {
            for di in -1..2 {
                let c = wp_cell(ci + di, cj + dj)
                if c == null || c.ground_count == 0 { continue }
                if wp_region_loaded >= 0 && c.region as s32 != wp_region_loaded { continue }
                wp_stats.ground += __wp_placements(c, di, dj, 0, c.ground_count as s32)
            }
        }
        if wp_stats.ground != 0 { ot_flush() }
    }
    for dj in -1..2 {
        for di in -1..2 {
            let c = wp_cell(ci + di, cj + dj)
            if c == null { continue }
            if wp_region_loaded >= 0 && c.region as s32 != wp_region_loaded {
                if c.standin_off != 0 { __wp_standin(c, di, dj) }
            } else if c.placement_count != 0 {
                wp_stats.near_cells += 1
                var k0 = 0
                if ground { k0 = c.ground_count as s32 }
                __wp_placements(c, di, dj, k0, c.placement_count as s32)
            }
        }
    }
}

// The view volume's six planes from the camera just set, each scaled so dot(plane, (p, 1)) is
// the distance of p inside it.
fn __wp_frustum(near: fixed, far: fixed) {
    let r0 = __vp[0]
    let r1 = __vp[1]
    let r3 = __vp[3]
    let kx = 1.0 / sqrt(1.0 + __fx * __fx)     // right and forward are unit and square
    let ky = 1.0 / sqrt(1.0 + __fy * __fy)
    __wp_planes[0] = (r3 + r0) * kx
    __wp_planes[1] = (r3 - r0) * kx
    __wp_planes[2] = (r3 + r1) * ky
    __wp_planes[3] = (r3 - r1) * ky
    __wp_planes[4] = r3 - vec4(0.0, 0.0, 0.0, near)
    __wp_planes[5] = vec4(0.0, 0.0, 0.0, far) - r3
    // Inside these, every vertex projects inside the guard band (screen x and y in -1000..999,
    // where x = 160 + 160 X / w and y = 120 - 120 Y / w: X / w in -7.25..5.24, Y / w in
    // -7.33..9.33) and lies in front of the near plane, with room to spare for rounding.
    __wp_safe_planes[0] = __wp_unit(r0 + r3 * 7)
    __wp_safe_planes[1] = __wp_unit(r3 * 5 - r0)
    __wp_safe_planes[2] = __wp_unit(r1 + r3 * 7)
    __wp_safe_planes[3] = __wp_unit(r3 * 9 - r1)
    __wp_safe_planes[4] = r3 - vec4(0.0, 0.0, 0.0, near + 0.0625)
}

// A plane scaled so that its normal (x, y, z) is unit.
fn __wp_unit(p: vec4) -> vec4 {
    return p * (1.0 / sqrt(p.x * p.x + p.y * p.y + p.z * p.z))
}

// Whether a sphere in view (as __wp_visible) needs no clipping: inside the guard band and in
// front of the near plane, by a margin (__wp_safe_planes): dot(plane, (x, y, z, 1)) >= radius +
// 0.0625 for all five. Its meshes go to __draw_mesh_safe.
asm fn __wp_safe(s: vec4) -> bool {
    vget r2, v0, 3
    addi r2, r2, 4096           ; radius + 0.0625
    addi r3, r0, 65536
    vset v0, r3, 3              ; (x, y, z, 1)
    la   r4, {__wp_safe_planes}
    vld  v1, [r4+64]            ; the near plane first: the likeliest to fail
    vdot r3, v1, v0
    blt  r3, r2, .no
    vld  v1, [r4+0]
    vdot r3, v1, v0
    blt  r3, r2, .no
    vld  v1, [r4+16]
    vdot r3, v1, v0
    blt  r3, r2, .no
    vld  v1, [r4+32]
    vdot r3, v1, v0
    blt  r3, r2, .no
    vld  v1, [r4+48]
    vdot r3, v1, v0
    blt  r3, r2, .no
    addi r1, r0, 1
    ret
.no:
    mov  r1, r0
}

// Whether a sphere (x, y, z, radius), relative to the frame's origin, touches the view volume:
// dot(plane, (x, y, z, 1)) >= -radius for all six planes.
asm fn __wp_visible(s: vec4) -> bool {
    vget r2, v0, 3
    sub  r2, r0, r2             ; -radius
    addi r3, r0, 65536
    vset v0, r3, 3              ; (x, y, z, 1)
    la   r4, {__wp_planes}
    vld  v1, [r4+0]
    vdot r3, v1, v0
    blt  r3, r2, .no
    vld  v1, [r4+16]
    vdot r3, v1, v0
    blt  r3, r2, .no
    vld  v1, [r4+32]
    vdot r3, v1, v0
    blt  r3, r2, .no
    vld  v1, [r4+48]
    vdot r3, v1, v0
    blt  r3, r2, .no
    vld  v1, [r4+64]
    vdot r3, v1, v0
    blt  r3, r2, .no
    vld  v1, [r4+80]
    vdot r3, v1, v0
    blt  r3, r2, .no
    addi r1, r0, 1
    ret
.no:
    mov  r1, r0
}

// mesh_at()'s matrix for a mesh turned by (cos, sin) and moved by t, with the current camera,
// multiplied out without the mat4 product: row k of __vp, v, becomes
// (v.x c - v.z s, v.y, v.x s + v.z c, dot(v, (t.x, t.y, t.z, 1))).
asm fn __wp_mvp(dst: *mat4, t: vec4, c: fixed, s: fixed) {
    addi r4, r0, 65536
    vset v0, r4, 3              ; (t.x, t.y, t.z, 1)
    la   r4, {__vp}
    addi r5, {dst}, 64
.row:
    vld  v1, [r4+0]
    vdot r8, v1, v0
    vset v1, r8, 3
    vget r6, v1, 0
    vget r7, v1, 2
    fmul r8, r6, {c}
    fmul r6, r6, {s}
    vset v2, r6, 0              ; (x s, kept)
    fmul r6, r7, {s}
    sub  r8, r8, r6
    vset v1, r8, 0
    vget r6, v2, 0
    fmul r7, r7, {c}
    add  r6, r6, r7
    vset v1, r6, 2
    vst  v1, [{dst}+0]
    addi r4, r4, 16
    addi {dst}, {dst}, 16
    bne  {dst}, r5, .row
}

// Draws a mesh turned by (cos, sin) and moved by t, with the current camera.
fn __wp_mesh(m: *Mesh, t: vec4, c: fixed, s: fixed, safe: bool) {
    var mvp: mat4
    __wp_mvp(&mvp, t, c, s)
    if safe {
        __draw_mesh_safe(m, mvp)
    } else {
        __draw_mesh(m, mvp)
    }
}

// The eye's occlusion zone (1.5): the first of its cell's zones whose box holds __wp_eye and whose
// layer is on, into __wp_zone and wp_stats.zone (null and -1: none). About 40 cycles a zone looked at.
fn __wp_zone_find(c: *WpCell) {
    __wp_zone = null
    wp_stats.zone = -1
    if c == null || !__wp_zones || !wp_occlusion { return }
    let e = __wp_eye
    var z = (__wp_base + c.zone_off) as *WpZone
    for k in 0..c.zone_count as s32 {
        if e.x >= z.lo.x && e.x < z.hi.x && e.z >= z.lo.z && e.z < z.hi.z && e.y >= z.lo.y && e.y < z.hi.y {
            if z.layer == 0xFF || wp_layer_on(z.layer as s32) {
                __wp_zone = z
                wp_stats.zone = k
                return
            }
        }
        z = z + 1
    }
}

fn __wp_standin(c: *WpCell, di: s32, dj: s32) {
    if __wp_zone != null && abs(di) <= 3 && abs(dj) <= 3 {
        let b = (dj + 3) * 7 + di + 3
        if (__wp_zone.far[b >> 5] >> (b & 31)) & 1 != 0 {
            wp_stats.standins_occluded += 1
            return
        }
    }
    let off = vec4(fixed(di << __wp_shift), 0.0, fixed(dj << __wp_shift), 0.0)
    let sb = c.standin_bounds + off
    if !__wp_visible(sb) { return }
    __wp_mesh((__wp_base + c.standin_off) as *Mesh, off, 1.0, 0.0, __wp_safe(sb))
    wp_stats.standins += 1
}

// Draws placements k0..k1 - 1 of a near cell that are present and in view and not hidden from the
// eye's occlusion zone (the whole cell is culled by its bounds first). Returns how many it drew.
fn __wp_placements(c: *WpCell, di: s32, dj: s32, k0: s32, k1: s32) -> s32 {
    if k0 >= k1 { return 0 }
    let off = vec4(fixed(di << __wp_shift), 0.0, fixed(dj << __wp_shift), 0.0)
    if !__wp_visible(c.bounds + off) { return 0 }
    let mask = wp_cell_mask(c)
    var p = (__wp_base + c.placement_off) as *WpPlacement + k0
    wp_stats.placements += k1 - k0
    let lod = wp_lod && c.lod_off != 0
    var hid: *u32 = null
    if __wp_zone != null {
        let o = __wp_zone.near[(dj + 1) * 3 + di + 1]
        if o != 0 { hid = (__wp_base + o) as *u32 }
    }
    var drawn = 0
    var occl = 0
    for k in k0..k1 {
        if hid != null && (hid[k >> 5] >> (k & 31)) & 1 != 0 {
            occl += 1
        } else {
            let pm = p.mask as u32
            let ps = p.sphere + off
            if (pm == 0 || pm & mask != 0) && __wp_visible(ps) {
                var m = p.mesh
                if lod { m = __wp_lod_mesh(c, k, p, off) }
                if m != 0 {
                    __wp_mesh((__wp_base + m) as *Mesh, p.pos + off, p.cos, p.sin, __wp_safe(ps))
                    drawn += 1
                }
            }
        }
        p = p + 1
    }
    wp_stats.drawn += drawn
    wp_stats.occluded += occl
    return drawn
}

// ---- objects in the world (docs/WORLDPACK.md, "Objects")
//
// A small object drawn in the near pass sorts badly against the large faces it stands on or
// floats above: a platform's top sorts by its average depth, which can be nearer than the object
// although the object is in front of it at every pixel they share. wp_draw_object() draws an
// object's mesh as a unit keyed at its nearest point (depth_key, squashed wp_object_squash times),
// and, while the eye is above the object's base, wp_object_bias units nearer still (never nearer
// than the near plane). wp_object_squash 1 keeps the object's own depths and shifts them by the
// bias alone. Whatever lies wholly below the base is behind the object from such an eye, so the
// bias cannot be wrong against it; what it gets wrong is a face above the base truly in front of
// the object and less than about wp_object_bias + its radius from it (a thin wall, a post, a
// platform seen through from above).

// The sphere around a mesh's origin that holds its vertices, as a radius (x), and its lowest
// vertex's height (y), in its own units: what wp_draw_object() wants, for a mesh the cart draws
// often (its character's), worked out once. A scan of the vertices: about 17 cycles each and 260
// more.
fn wp_mesh_bounds(m: *Mesh) -> vec2 {
    let s = __wp_scan((m as u32 + m.verts) as *vec4, m.nverts as s32)
    return vec2(sqrt(max(s.x - 1.0, 0.0)) + 0.0078125, s.y)      // (vertices have w = 1)
}

// The largest dot(v, v) (x) and the lowest y (y) of n vertices.
asm fn __wp_scan(v: *vec4, n: s32) -> vec2 {
    vsub v0, v0, v0
    beq  {n}, r0, .done
    vld  v0, [{v}+0]
    vget r7, v0, 1              ; the lowest y so far
    mov  r6, r0                 ; the largest square so far
    shli r5, {n}, 4
    add  r5, r5, {v}            ; the end
.loop:
    vld  v0, [{v}+0]
    vdot r8, v0, v0
    bge  r6, r8, .a
    mov  r6, r8
.a:
    vget r8, v0, 1
    bge  r8, r7, .b
    mov  r7, r8
.b:
    addi {v}, {v}, 16
    bltu {v}, r5, .loop
    vset v0, r6, 0
    vset v0, r7, 1
.done:
}

// Draws mesh m at world position pos turned by yaw (as mesh_at() would, relative to
// wp_view_origin()), as an object standing on or floating above the world: an entity's mesh, a
// pickup, the player's character. Call it after wp_draw(), in the same frame. radius: the sphere
// around pos that holds the mesh (culled against the near pass's view volume, and drawn without
// clipping tests when it needs none, so it must hold every vertex; 0: never culled, and keyed at
// pos); base: the world height of its lowest point (its feet). Returns whether it
// was drawn. Leaves depth_key off; adds to the cart's own depth_bias. (depth.akr replaces it, as
// wp_draw().)
weak fn wp_draw_object(m: *Mesh, pos: vec3, yaw: fixed, radius: fixed, base: fixed) -> bool {
    let t = pos - __wp_origin
    let ts = vec4(t.x, t.y, t.z, radius)
    if radius > 0.0 && !__wp_visible(ts) { return false }
    let safe = radius > 0.0 && __wp_safe(ts)
    let near = view_depth(t) - radius
    var w = near
    if __wp_eye_y > base { w -= min(wp_object_bias, max(w - wp_clip_near, 0.0)) }
    if wp_object_squash > 1 {
        depth_key(w, wp_object_squash)
        __wp_mesh(m, vec4(t.x, t.y, t.z, 0.0), cos(yaw), sin(yaw), safe)
        depth_key_off()
    } else {
        let user = __ot_user        // no key: the bias alone
        depth_bias(user - ((near - w) * buckets_per_unit()) as s32)
        __wp_mesh(m, vec4(t.x, t.y, t.z, 0.0), cos(yaw), sin(yaw), safe)
        depth_bias(user)
    }
    return true
}

// Draws an entity's mesh with wp_draw_object(), if it has one and is live; its sphere and base
// come from its mesh (wp_mesh_bounds) and its position. Returns whether it was drawn.
fn wp_entity_draw(e: *WpEntity) -> bool {
    if e.mesh == 0 || !wp_entity_live(e) { return false }
    let m = (__wp_base + e.mesh) as *Mesh
    let k = ((m as u32) >> 4) & 15
    if __wp_bkey[k] != m as u32 {
        __wp_bval[k] = wp_mesh_bounds(m)
        __wp_bkey[k] = m as u32
    }
    let b = __wp_bval[k]
    let p = wp_entity_pos(e)
    return wp_draw_object(m, p, e.yaw, b.x, p.y + b.y)
}

// Draws the meshes of the live entities in the 3 x 3 cells the last wp_draw() drew (culled, as
// wp_entity_draw()). Returns how many it drew. A game that spawns its entities as objects of its
// own draws those instead, with wp_draw_object().
fn wp_draw_entities() -> s32 {
    let ci = wp_cell_index(__wp_origin.x)
    let cj = wp_cell_index(__wp_origin.z)
    var n = 0
    for dj in -1..2 {
        for di in -1..2 {
            let c = wp_cell(ci + di, cj + dj)
            if c == null || c.entity_count == 0 { continue }
            var e = (__wp_base + c.entity_off) as *WpEntity
            for k in 0..c.entity_count as s32 {
                if e.mesh != 0 && wp_entity_draw(e) { n += 1 }
                e = e + 1
            }
        }
    }
    return n
}

// ---- collision in a block's own frame
//
// A collision block is a cell's (in cell-local coordinates) or an entity's (in its own frame:
// for a moving object, turn the query into its frame, ask, and turn the answer back). mask is
// the layer bits that are on (wp_cell_mask(); entity blocks have no layers: pass 0).

fn __wp_bucket(cb: *WpColl, x: fixed, z: fixed) -> *WpBucket {
    let g1 = (1 << cb.grid_shift) - 1
    let bx = clamp(((x + cb.half) * cb.inv) as s32, 0, g1)
    let bz = clamp(((z + cb.half) * cb.inv) as s32, 0, g1)
    return (__wp_base + cb.bucket_off) as *WpBucket + ((bz << cb.grid_shift) + bx)
}

// The highest floor under p at or below p.y + above: true and wp_hit.y, .surface, ... set, or
// false.
fn wp_coll_floor(cb: *WpColl, p: vec3, above: fixed, mask: u32) -> bool {
    let b = __wp_bucket(cb, p.x, p.z)
    let n = b.nf as s32
    if n == 0 { return false }
    let ids = (__wp_base + cb.list_off) as *u16 + b.start
    let flats = (__wp_base + cb.floor_off) as *WpFlat
    let q = vec4(p.x, p.z, 1.0, 0.0)
    let lim = p.y + above
    var best: *WpFlat = null
    var by = 0.0
    for k in 0..n {
        let f = flats + ids[k] as s32
        let lm = (bits(f.h.w) >> 8) & 255
        if lm != 0 && (lm as u32) & mask == 0 { continue }
        if dot(f.e0, q) < 0.0 || dot(f.e1, q) < 0.0 || dot(f.e2, q) < 0.0 { continue }
        let y = dot(f.h, q)
        if y > lim || (best != null && y <= by) { continue }
        best = f
        by = y
    }
    if best == null { return false }
    __wp_hit_flat(best, WP_FLOOR)
    wp_hit.y = by
    return true
}

// The lowest ceiling over p at or above p.y - below.
fn wp_coll_ceiling(cb: *WpColl, p: vec3, below: fixed, mask: u32) -> bool {
    let b = __wp_bucket(cb, p.x, p.z)
    let n = b.nc as s32
    if n == 0 { return false }
    let ids = (__wp_base + cb.list_off) as *u16 + b.start + b.nf + b.nw
    let flats = (__wp_base + cb.ceil_off) as *WpFlat
    let q = vec4(p.x, p.z, 1.0, 0.0)
    let lim = p.y - below
    var best: *WpFlat = null
    var by = 0.0
    for k in 0..n {
        let f = flats + ids[k] as s32
        let lm = (bits(f.h.w) >> 8) & 255
        if lm != 0 && (lm as u32) & mask == 0 { continue }
        if dot(f.e0, q) < 0.0 || dot(f.e1, q) < 0.0 || dot(f.e2, q) < 0.0 { continue }
        let y = dot(f.h, q)
        if y < lim || (best != null && y >= by) { continue }
        best = f
        by = y
    }
    if best == null { return false }
    __wp_hit_flat(best, WP_CEILING)
    wp_hit.y = by
    return true
}

fn __wp_hit_flat(f: *WpFlat, kind: s32) {
    let info = bits(f.h.w)
    wp_hit.kind = kind
    wp_hit.surface = info & 255
    wp_hit.tag = (info >> 16) & 0xFFFF
    wp_hit.rec = f as *u8
    wp_hit.back = false
}

// Pushes an upright body's point p out of the walls within radius of it (radius at most the
// block's pad), along each wall's horizontal normal, one wall after another in the order the
// pack files them. Returns the pushed point; wp_hit.walls counts the walls that pushed and the
// last one's surface and record are in wp_hit. Sample a tall body at a few heights.
fn wp_coll_push(cb: *WpColl, p: vec3, radius: fixed, mask: u32) -> vec3 {
    let b = __wp_bucket(cb, p.x, p.z)
    let n = b.nw as s32
    wp_hit.walls = 0
    if n == 0 { return p }
    let ids = (__wp_base + cb.list_off) as *u16 + b.start + b.nf
    let walls = (__wp_base + cb.wall_off) as *WpWall
    var q = vec4(p.x, p.y, p.z, 1.0)
    for k in 0..n {
        let w = walls + ids[k] as s32
        let lm = (w.info >> 8) & 255
        if lm != 0 && lm & mask == 0 { continue }
        let d = dot(w.p, q)
        if d <= -radius || d >= radius { continue }
        if dot(w.e0, q) < 0.0 || dot(w.e1, q) < 0.0 || dot(w.e2, q) < 0.0 { continue }
        let push = (radius - d) * w.inv
        q.x += w.hx * push
        q.z += w.hz * push
        wp_hit.walls += 1
        wp_hit.kind = WP_WALL
        wp_hit.surface = (w.info & 255) as s32
        wp_hit.tag = (w.info >> 16) as s32
        wp_hit.rec = w as *u8
    }
    return vec3(q.x, q.y, q.z)
}

// The first triangle the segment a -> b crosses (from either side; a triangle it starts on does
// not count), if nearer than wp_hit.t: then true, with wp_hit.t (0..1), .kind, .back, .rec set
// (.pos is left to wp_ray). Set wp_hit.t = 1.0 before the first call.
fn wp_coll_ray(cb: *WpColl, a: vec3, b: vec3, mask: u32) -> bool {
    // The buckets the segment passes through, column by column: in each column of the grid
    // the segment crosses, the rows its z covers there (widened by EPS against rounding).
    const EPS = 0.015625
    let g1 = (1 << cb.grid_shift) - 1
    let half = cb.half
    let inv = cb.inv
    let bs = half * 2 / (1 << cb.grid_shift)
    let xlo = min(a.x, b.x)
    let xhi = max(a.x, b.x)
    let bx0 = clamp(((xlo + half) * inv) as s32, 0, g1)
    let bx1 = clamp(((xhi + half) * inv) as s32, 0, g1)
    let bzlo = clamp(((min(a.z, b.z) + half) * inv) as s32, 0, g1)
    let bzhi = clamp(((max(a.z, b.z) + half) * inv) as s32, 0, g1)
    let dx = b.x - a.x
    let dz = b.z - a.z
    let steep = abs(dx) < 0.0625            // nearly along z: every column takes every row
    var found = false
    for bx in bx0..bx1 + 1 {
        var bz0 = bzlo
        var bz1 = bzhi
        if !steep && bx0 != bx1 {
            var xl = xlo
            var xh = xhi
            if bx > bx0 { xl = max(xl, bs * bx - half - EPS) }
            if bx < bx1 { xh = min(xh, bs * (bx + 1) - half + EPS) }
            let za = a.z + dz * clamp((xl - a.x) / dx, 0.0, 1.0)
            let zb = a.z + dz * clamp((xh - a.x) / dx, 0.0, 1.0)
            bz0 = max(bz0, clamp(((min(za, zb) - EPS + half) * inv) as s32, 0, g1))
            bz1 = min(bz1, clamp(((max(za, zb) + EPS + half) * inv) as s32, 0, g1))
        }
        for bz in bz0..bz1 + 1 {
            if __wp_ray_bucket(cb, (bz << cb.grid_shift) + bx, a, b, mask) { found = true }
        }
    }
    return found
}

fn __wp_ray_bucket(cb: *WpColl, k: s32, a: vec3, b: vec3, mask: u32) -> bool {
    let bk = (__wp_base + cb.bucket_off) as *WpBucket + k
    var ids = (__wp_base + cb.list_off) as *u16 + bk.start
    var found = false
    if bk.nf != 0 && __wp_ray_flats((__wp_base + cb.floor_off) as *WpFlat, ids, bk.nf as s32, a, b, mask, WP_FLOOR) {
        found = true
    }
    ids = ids + bk.nf
    if bk.nw != 0 && __wp_ray_walls((__wp_base + cb.wall_off) as *WpWall, ids, bk.nw as s32, a, b, mask) {
        found = true
    }
    ids = ids + bk.nw
    if bk.nc != 0 && __wp_ray_flats((__wp_base + cb.ceil_off) as *WpFlat, ids, bk.nc as s32, a, b, mask, WP_CEILING) {
        found = true
    }
    return found
}

fn __wp_ray_flats(flats: *WpFlat, ids: *u16, n: s32, a: vec3, b: vec3, mask: u32, kind: s32) -> bool {
    let qa = vec4(a.x, a.z, 1.0, 0.0)
    let qb = vec4(b.x, b.z, 1.0, 0.0)
    var found = false
    for k in 0..n {
        let f = flats + ids[k] as s32
        let lm = (bits(f.h.w) >> 8) & 255
        if lm != 0 && (lm as u32) & mask == 0 { continue }
        let fa = a.y - dot(f.h, qa)
        let fb = b.y - dot(f.h, qb)
        if !((fa > 0.0 && fb <= 0.0) || (fa < 0.0 && fb >= 0.0)) { continue }
        let t = fa / (fa - fb)
        if t >= wp_hit.t { continue }
        let q = vec4(a.x + (b.x - a.x) * t, a.z + (b.z - a.z) * t, 1.0, 0.0)
        if dot(f.e0, q) < 0.0 || dot(f.e1, q) < 0.0 || dot(f.e2, q) < 0.0 { continue }
        __wp_hit_flat(f, kind)
        wp_hit.t = t
        wp_hit.back = (kind == WP_FLOOR) == (fa < 0.0)
        found = true
    }
    return found
}

fn __wp_ray_walls(walls: *WpWall, ids: *u16, n: s32, a: vec3, b: vec3, mask: u32) -> bool {
    let qa = vec4(a.x, a.y, a.z, 1.0)
    let qb = vec4(b.x, b.y, b.z, 1.0)
    var found = false
    for k in 0..n {
        let w = walls + ids[k] as s32
        let lm = (w.info >> 8) & 255
        if lm != 0 && lm & mask == 0 { continue }
        let fa = dot(w.p, qa)
        let fb = dot(w.p, qb)
        if !((fa > 0.0 && fb <= 0.0) || (fa < 0.0 && fb >= 0.0)) { continue }
        let t = fa / (fa - fb)
        if t >= wp_hit.t { continue }
        let q = qa + (qb - qa) * t
        if dot(w.e0, q) < 0.0 || dot(w.e1, q) < 0.0 || dot(w.e2, q) < 0.0 { continue }
        wp_hit.kind = WP_WALL
        wp_hit.surface = (w.info & 255) as s32
        wp_hit.tag = (w.info >> 16) as s32
        wp_hit.rec = w as *u8
        wp_hit.t = t
        wp_hit.back = fa < 0.0
        found = true
    }
    return found
}

// ---- collision in the world

// The highest floor under world point p at or below p.y + above, in p's cell (which holds every
// triangle over its square): true with wp_hit.y (world height), .surface, .tag, .cell set.
fn wp_floor(p: vec3, above: fixed) -> bool {
    let c = wp_cell_at(p)
    if c == null || c.coll_off == 0 { return false }
    let o = wp_cell_centre(c)
    wp_hit.cell = c
    return wp_coll_floor((__wp_base + c.coll_off) as *WpColl, p - o, above, wp_cell_mask(c))
}

// One step of wp_floor_across() along each of its four directions: 1/16 unit along x and z, and
// 181/4096 (0.0442, 1/16 times 0.707) in x and z along the two diagonals. Exact in fixed point,
// so the World Checker samples the same points (tools/worldkit/verify_static.py).
const __WP_ACROSS: [4]vec3 = [vec3(0.0625, 0.0, 0.0), vec3(0.0, 0.0, 0.0625),
                              vec3(0.044189453125, 0.0, 0.044189453125),
                              vec3(0.044189453125, 0.0, -0.044189453125)]

// wp_floor(p, above), bridging cracks: small gaps between floors (where two collision meshes
// meet) that a point query falls through. When wp_floor() finds a floor at or above p.y -
// below, that is the answer, unchanged. Otherwise the query steps out from p along x, z and the
// two diagonals, 1/16 unit a step, to the nearest floor within p.y - below .. p.y + above on
// each side; a direction with one on both sides, a + b steps apart with a + b at most span * 16
// (span in units), bridges the gap: the higher of the two floors is the answer (wp_hit as for
// it, wp_hit.y its height under that side's point). The first direction in that order that
// bridges wins. With none, the answer is wp_floor()'s again. A gap narrower than span - 1/8 is
// bridged across its line, and one narrower than 0.92 (span - 1/8) at any angle; a gap wider
// than span is never bridged, nor is an edge with no floor beyond it (WORLDKIT.md, "Cracks").
fn wp_floor_across(p: vec3, above: fixed, below: fixed, span: fixed) -> bool {
    let lo = p.y - below
    let found = wp_floor(p, above)
    if found && wp_hit.y >= lo { return true }
    let centre = wp_hit
    let n = (span * 16) as s32
    for d in 0..4 {
        let s = __WP_ACROSS[d]
        var a = 1
        var q = p + s
        while a < n && !(wp_floor(q, above) && wp_hit.y >= lo) {
            a += 1
            q = q + s
        }
        if a >= n { continue }
        let side = wp_hit
        var b = 1
        q = p - s
        while a + b <= n && !(wp_floor(q, above) && wp_hit.y >= lo) {
            b += 1
            q = q - s
        }
        if a + b > n { continue }
        if side.y > wp_hit.y { wp_hit = side }
        return true
    }
    wp_hit = centre
    return found
}

// The lowest ceiling over world point p at or above p.y - below.
fn wp_ceiling(p: vec3, below: fixed) -> bool {
    let c = wp_cell_at(p)
    if c == null || c.coll_off == 0 { return false }
    let o = wp_cell_centre(c)
    wp_hit.cell = c
    return wp_coll_ceiling((__wp_base + c.coll_off) as *WpColl, p - o, below, wp_cell_mask(c))
}

// World point p pushed out of the walls within radius (at most the pack's pad, 1.0 by
// default; see wp_coll_push).
fn wp_push(p: vec3, radius: fixed) -> vec3 {
    let c = wp_cell_at(p)
    wp_hit.walls = 0
    if c == null || c.coll_off == 0 { return p }
    let o = wp_cell_centre(c)
    wp_hit.cell = c
    return wp_coll_push((__wp_base + c.coll_off) as *WpColl, p - o, radius, wp_cell_mask(c)) + o
}

// The first floor, wall or ceiling the world segment a -> b crosses (a camera's line of sight):
// true with wp_hit.t, .pos, .kind, .surface, .back, .cell set. It looks in every cell the
// segment's box touches, so keep segments short (a camera's distance): the cost grows with the
// box's area.
fn wp_ray(a: vec3, b: vec3) -> bool {
    let i0 = wp_cell_index(min(a.x, b.x))
    let i1 = wp_cell_index(max(a.x, b.x))
    let j0 = wp_cell_index(min(a.z, b.z))
    let j1 = wp_cell_index(max(a.z, b.z))
    wp_hit.t = 1.0
    var found = false
    for j in j0..j1 + 1 {
        for i in i0..i1 + 1 {
            let c = wp_cell(i, j)
            if c == null || c.coll_off == 0 { continue }
            let o = wp_cell_centre(c)
            if wp_coll_ray((__wp_base + c.coll_off) as *WpColl, a - o, b - o, wp_cell_mask(c)) {
                wp_hit.cell = c
                found = true
            }
        }
    }
    if found { wp_hit.pos = a + (b - a) * wp_hit.t }
    return found
}

// The unit normal of what the last query hit (its front side).
fn wp_hit_normal() -> vec3 {
    if wp_hit.kind == WP_WALL {
        let w = wp_hit.rec as *WpWall
        return vec3(w.p.x, w.p.y, w.p.z)
    }
    let f = wp_hit.rec as *WpFlat
    let n = normalize(vec3(-f.h.x, 1.0, -f.h.y))
    if wp_hit.kind == WP_CEILING { return -n }
    return n
}

// ---- entities

// The entity with global number n (as an entity_ref parameter holds it).
fn wp_entity(n: s32) -> *WpEntity {
    if n < 0 || n >= wp_pack.entity_count as s32 { return null }
    return (__wp_base + ((__wp_base + wp_pack.entity_dir_off) as *u32)[n]) as *WpEntity
}

// The k-th entity of a cell (0 .. c.entity_count - 1).
fn wp_cell_entity(c: *WpCell, k: s32) -> *WpEntity {
    return (__wp_base + c.entity_off) as *WpEntity + k
}

fn wp_entity_cell(e: *WpEntity) -> *WpCell { return (__wp_base + e.cell) as *WpCell }

// The entity's world position.
fn wp_entity_pos(e: *WpEntity) -> vec3 {
    return vec3(e.pos.x, e.pos.y, e.pos.z) + wp_cell_centre(wp_entity_cell(e))
}

// Whether the entity's layer (if it has one) is on.
fn wp_entity_live(e: *WpEntity) -> bool {
    return e.mask == 0 || (e.mask as u32) & wp_cell_mask(wp_entity_cell(e)) != 0
}

// Its parameter record (the game's struct), or null.
fn wp_entity_params(e: *WpEntity) -> *u8 {
    if e.params == 0 { return null }
    return (__wp_base + e.params) as *u8
}

fn wp_entity_mesh(e: *WpEntity) -> *Mesh {
    if e.mesh == 0 { return null }
    return (__wp_base + e.mesh) as *Mesh
}

// Its collision block (in its own frame), or null.
fn wp_entity_coll(e: *WpEntity) -> *WpColl {
    if e.coll == 0 { return null }
    return (__wp_base + e.coll) as *WpColl
}

// Keeps the cells within `radius` cells (0..2) of world point p active: calls retire(e) for
// each entity that stops being active (its cell left the set, or its layer went off) and then
// spawn(e) for each that starts (its cell joined, or its layer came on). Call it every frame
// (or whenever p crosses a cell or a layer changes); the game owns what spawning means.
fn wp_track(p: vec3, radius: s32, spawn: fn(*WpEntity), retire: fn(*WpEntity)) {
    let r = clamp(radius, 0, 2)
    let ci = wp_cell_index(p.x)
    let cj = wp_cell_index(p.z)
    var ncell: [WP_MAX_TRACK]u32
    var nmask: [WP_MAX_TRACK]u32
    var nn = 0
    for dj in -r..r + 1 {
        for di in -r..r + 1 {
            let c = wp_cell(ci + di, cj + dj)
            if c != null && c.entity_count != 0 {
                ncell[nn] = c as u32
                nmask[nn] = wp_cell_mask(c) | 0x100        // bit 8: the entities with no layer
                nn += 1
            }
        }
    }
    for k in 0..__wp_track_n {
        var now: u32 = 0
        for m in 0..nn { if ncell[m] == __wp_track_cell[k] { now = nmask[m] } }
        __wp_track_change(__wp_track_cell[k] as *WpCell, __wp_track_mask[k], now, retire)
    }
    for m in 0..nn {
        var before: u32 = 0
        for k in 0..__wp_track_n { if __wp_track_cell[k] == ncell[m] { before = __wp_track_mask[k] } }
        __wp_track_change(ncell[m] as *WpCell, nmask[m], before, spawn)
    }
    for m in 0..nn {
        __wp_track_cell[m] = ncell[m]
        __wp_track_mask[m] = nmask[m]
    }
    __wp_track_n = nn
}

// Retires every tracked entity and empties the set (before wp_open() of another pack).
fn wp_track_clear(retire: fn(*WpEntity)) {
    for k in 0..__wp_track_n {
        __wp_track_change(__wp_track_cell[k] as *WpCell, __wp_track_mask[k], 0, retire)
    }
    __wp_track_n = 0
}

// Calls f for the cell's entities live under mask `from` but not under `to`.
fn __wp_track_change(c: *WpCell, from: u32, to: u32, f: fn(*WpEntity)) {
    if from & ~to == 0 { return }
    var e = (__wp_base + c.entity_off) as *WpEntity
    for k in 0..c.entity_count as s32 {
        var bit: u32 = 0x100
        if e.mask != 0 { bit = e.mask as u32 }
        if bit & from != 0 && bit & to == 0 { f(e) }
        e = e + 1
    }
}

// ---- regions (palettes and textures; audio banks are specified, not read yet)

fn wp_region(k: s32) -> *WpRegion {
    return (__wp_base + wp_pack.region_off) as *WpRegion + k
}

fn wp_region_count() -> s32 { return wp_pack.region_count as s32 }

// Region k's name, or null for k outside 0 .. wp_region_count() - 1.
fn wp_region_name(k: s32) -> *u8 {
    if k < 0 || k >= wp_pack.region_count as s32 { return null }
    return (__wp_base + wp_region(k).name) as *u8
}

// The name of region k's palette variant v (wp_region(k).variant_count of them), or null.
fn wp_variant_name(k: s32, v: s32) -> *u8 {
    if k < 0 || k >= wp_pack.region_count as s32 { return null }
    let r = wp_region(k)
    if v < 0 || v >= r.variant_count as s32 { return null }
    return (__wp_base + ((__wp_base + r.palette_off) as *u32)[v]) as *u8
}

// How far the pack copied walls past each cell's edge (its header's pad): the largest radius
// wp_push() answers for exactly.
fn wp_pad() -> fixed { return wp_pack.pad }

// Loads palette variant v of region k into palette memory.
fn wp_palette_load(k: s32, v: s32) {
    let r = wp_region(k)
    if v < 0 || v >= r.variant_count as s32 { return }
    let n = r.colour_count as s32
    let cols = (__wp_base + r.palette_off + 4 * (r.variant_count as u32)) as *u16 + v * n
    load_palette(r.first_colour as s32, cols, n)
}

// Writes region k's palette blended from variant va toward vb by t (palette_lerp: about 38
// cycles a colour).
fn wp_palette_blend(k: s32, va: s32, vb: s32, t: fixed) {
    let r = wp_region(k)
    let n = r.colour_count as s32
    if va < 0 || vb < 0 || va >= r.variant_count as s32 || vb >= r.variant_count as s32 { return }
    let cols = (__wp_base + r.palette_off + 4 * (r.variant_count as u32)) as *u16
    palette_lerp(r.first_colour as s32, cols + va * n, cols + vb * n, n, t)
}

// Copies region k's texture set into its slots now (about 56,000 cycles a 32 KB slot: spread a
// swap over frames by calling wp_texture_load for one texture a frame).
fn wp_textures_load(k: s32) {
    for t in 0..wp_region(k).texture_count as s32 { wp_texture_load(k, t) }
}

// Copies texture t of region k into its slot, unless that slot already holds it: a texture the
// pack stores once for several regions (the stand-ins' common set, WORLDKIT.md) is copied on the
// first region entry only. The reader remembers what it copied into each
// slot since wp_open(); a game that writes a world's slot itself calls wp_textures_forget().
fn wp_texture_load(k: s32, t: s32) {
    let r = wp_region(k)
    if t < 0 || t >= r.texture_count as s32 { return }
    let x = (__wp_base + r.texture_off) as *WpTexture + t
    let slot = x.slot as s32 & 31
    let src = __wp_base + x.data
    if __wp_slot_src[slot] == src { return }
    load_texture(slot, src as *u8, x.bytes as s32)
    __wp_slot_src[slot] = src
}

// Forgets what the reader copied into the texture slots, so the next region entry copies every
// texture again (after the game wrote a world's slot itself).
fn wp_textures_forget() { mem_fill(&__wp_slot_src[0] as *u8, 0, 128) }

// ---- region resources (1.4): every palette run, animated textures, backdrop art; entering a region
//
// A region's palette variants cover its main run (palette-backed entries and 4-bit texture
// palettes) and, in a 1.4 pack, extra runs (8-bit texture palettes). wp_variant_load() and
// wp_variant_blend() treat them all; wp_palette_load() and wp_palette_blend() the main run only.

struct WpRegionExt {
    run_count: u16
    anim_count: u16
    run_off: u32       // run_count WpRun records
    anim_off: u32      // anim_count WpAnim records
    sky_off: u32       // the backdrop's plane set-up (wpbackdrop.akr), or 0
    reserved0: u32
    reserved1: u32
    reserved2: u32
    reserved3: u32
}

struct WpRun {
    first_colour: u16
    colours: u16
    data: u32          // variant_count x colours u16, variant by variant
}

struct WpAnim {
    data: u32          // frames x rows x row_bytes bytes, frame by frame
    vram: u32          // the tile's first byte in the texture area (VRAM_TEXTURES + vram)
    frames: u16
    ticks: u16
    row_bytes: u16
    rows: u16
    stride: u16
    reserved: u16
}

struct WpBackdropCopy {
    address: u32       // a VRAM address (an atlas page, a plane map)
    data: u32
    bytes: u32
}

const WP_MAX_ANIM = 64     // animated textures wp_animate() keeps track of in the entered region
var __wp_anim_shown: [WP_MAX_ANIM]s32   // the frame in VRAM, -1: unknown
var __wp_anim_region: s32 = -1          // the region whose frames __wp_anim_shown tracks
var wp_anim_copied: s32    // the rows wp_animate() copied last time (a cost measure)

// Region k's 1.4 extension record, or null (an older pack, or a pack that needs none).
fn wp_region_ext(k: s32) -> *WpRegionExt {
    if k < 0 || k >= wp_pack.region_count as s32 { return null }
    if wp_pack.minor < 4 || wp_pack.header_size < 84 { return null }
    let off = ((__wp_base + 80) as *u32)[0]
    if off == 0 { return null }
    return (__wp_base + off) as *WpRegionExt + k
}

// Loads palette variant v of region k: its main run and every extra run (8-bit texture palettes).
fn wp_variant_load(k: s32, v: s32) {
    wp_palette_load(k, v)
    let e = wp_region_ext(k)
    if e == null { return }
    let r = wp_region(k)
    if v < 0 || v >= r.variant_count as s32 { return }
    for q in 0..e.run_count as s32 {
        let run = (__wp_base + e.run_off) as *WpRun + q
        let n = run.colours as s32
        load_palette(run.first_colour as s32, (__wp_base + run.data) as *u16 + v * n, n)
    }
}

// Writes region k's colours blended from variant va toward vb by t, every run (palette_lerp:
// about 38 cycles a colour; an 8-bit texture's palette is 256 colours, about 9,700 cycles).
fn wp_variant_blend(k: s32, va: s32, vb: s32, t: fixed) {
    wp_palette_blend(k, va, vb, t)
    let e = wp_region_ext(k)
    if e == null { return }
    let r = wp_region(k)
    if va < 0 || vb < 0 || va >= r.variant_count as s32 || vb >= r.variant_count as s32 { return }
    for q in 0..e.run_count as s32 {
        let run = (__wp_base + e.run_off) as *WpRun + q
        let n = run.colours as s32
        let cols = (__wp_base + run.data) as *u16
        palette_lerp(run.first_colour as s32, cols + va * n, cols + vb * n, n, t)
    }
}

// Copies region k's backdrop art (its backdrop copies: tile atlases, plane maps) into VRAM.
// Setting up the planes to show it is wpbackdrop.akr's wp_backdrop_show().
fn wp_backdrop_load(k: s32) {
    let r = wp_region(k)
    for b in 0..r.backdrop_count as s32 {
        let c = (__wp_base + r.backdrop_off) as *WpBackdropCopy + b
        memcpy(c.address as *u8, (__wp_base + c.data) as *u8, c.bytes)
    }
}

// Makes region k the loaded region: copies its texture set and backdrop art into VRAM (a slot
// that already holds the same texture, the stand-ins' common set, is not copied again), loads
// palette variant v (every run), restarts its animated textures from frame 0 (the frame the
// texture set holds) and sets wp_region_loaded = k, so near cells of other regions, whose
// textures are not loaded, draw as their stand-ins. About 56,000 cycles a 32 KB texture slot:
// call it where the player cannot see a region's textured cells, or spread a swap over frames
// with wp_texture_load() (WORLDKIT.md, "Region seams").
fn wp_region_enter(k: s32, v: s32) {
    if k < 0 || k >= wp_pack.region_count as s32 { return }
    wp_textures_load(k)
    wp_variant_load(k, v)
    wp_backdrop_load(k)
    for q in 0..WP_MAX_ANIM { __wp_anim_shown[q] = 0 }
    __wp_anim_region = k
    wp_region_loaded = k
}

// Advances the entered region's animated textures to tick t (frame() is the usual clock): each
// one whose frame changed has the new frame copied into its tile. Returns how many changed.
// About 125 cycles and 70 an animation whose frame did not change; a change copies the frame's
// rows (2 rows of 4 bytes: about 140 cycles; 17 rows of 17 bytes, not word-aligned: about 2,800).
fn wp_animate(t: s32) -> s32 {
    wp_anim_copied = 0
    let k = __wp_anim_region
    if k < 0 { return 0 }
    let e = wp_region_ext(k)
    if e == null { return 0 }
    var changed = 0
    for q in 0..min(e.anim_count as s32, WP_MAX_ANIM) {
        let a = (__wp_base + e.anim_off) as *WpAnim + q
        let f = tex_frame_at(t, a.frames as s32, a.ticks as s32)
        if f != __wp_anim_shown[q] {
            let rows = a.rows as s32
            let rb = a.row_bytes as s32
            tex_frame_copy((__wp_base + a.data + (f * rows * rb) as u32) as *u8, a.vram as s32, rows, rb, a.stride as s32)
            __wp_slot_src[(a.vram / TEXTURE_SLOT_SIZE) & 31] = 0     // the slot no longer holds the set's texture
            __wp_anim_shown[q] = f
            wp_anim_copied += rows
            changed += 1
        }
    }
    return changed
}

// ---- paths (1.2): named polylines in world coordinates, one table per world
//
// A rail to grind, a wire, a crane's jib, a train's route: the kit attaches no meaning to them.
// An entity names its path in a name parameter: wp_path_find(world_NAME_string(params.path)).

struct WpPath {
    name: u32
    point_count: u32   // stored points; a closed path stores its first point again at the end
    point_off: u32
    flags: u8          // WP_PATH_RAISED, WP_PATH_CLOSED
    surface: u8        // the surface byte of its tag
    reserved: u16
    lo: vec4           // the box of its points (world); lo.w: its length
    hi: vec4
}

struct WpPathPoint {
    pos: vec4          // world (w = 0)
    dir: vec4          // the unit direction of the segment to the next point (w = 0); zero for the last
    s: fixed           // the length along the path to this point
    len: fixed         // the segment's length; 0 for the last
}

const WP_PATH_RAISED = 1
const WP_PATH_CLOSED = 2

// What the last wp_path_nearest() or wp_path_at() found.
struct WpNear {
    pos: vec3          // the point on the path (world)
    dir: vec3          // the unit direction of its segment
    seg: s32           // the segment, from point seg to point seg + 1
    t: fixed           // how far along that segment (units)
    s: fixed           // how far along the path (units)
    dist2: fixed       // wp_path_nearest: the squared distance from the query point
}

var wp_near: WpNear

// The number of paths in the open pack (0 before version 1.2).
fn wp_path_count() -> s32 {
    if wp_pack.minor < 2 || wp_pack.header_size < 72 { return 0 }
    return wp_pack.path_count as s32
}

// Path n (as the world's PATH_ constants number them), or null.
fn wp_path(n: s32) -> *WpPath {
    if n < 0 || n >= wp_path_count() { return null }
    return (__wp_base + wp_pack.path_off) as *WpPath + n
}

// The path with this name, or null. A name parameter's string is the path's own when the kit
// wrote both, so the comparison is usually one pointer test.
fn wp_path_find(name: *u8) -> *WpPath {
    var pth = (__wp_base + wp_pack.path_off) as *WpPath
    for k in 0..wp_path_count() {
        let pn = (__wp_base + pth.name) as *u8
        if pn == name || streq(pn, name) { return pth }
        pth = pth + 1
    }
    return null
}

fn wp_path_name(pth: *WpPath) -> *u8 { return (__wp_base + pth.name) as *u8 }

// Its points as the recipe gives them (a closed path's repeat of its first point not counted).
fn wp_path_points(pth: *WpPath) -> s32 {
    var n = pth.point_count as s32
    if pth.flags & WP_PATH_CLOSED != 0 { n -= 1 }
    return n
}

// Point k (0 .. pth.point_count - 1), world.
fn wp_path_point(pth: *WpPath, k: s32) -> vec3 {
    let q = (__wp_base + pth.point_off) as *WpPathPoint + k
    return vec3(q.pos.x, q.pos.y, q.pos.z)
}

fn wp_path_length(pth: *WpPath) -> fixed { return pth.lo.w }

// The nearest point to world point p on the path, among segments whose nearest point lies
// within reach of p in each of x, y and z (reach at most 100 units): true with wp_near set, or
// false. A box test first rejects a path that is out of reach: about 120 cycles; otherwise
// about 250 and 45 a segment (docs/WORLDPACK.md, "Costs").
fn wp_path_nearest(pth: *WpPath, p: vec3, reach: fixed) -> bool {
    let r = min(reach, 100.0)
    if p.x < pth.lo.x - r || p.x > pth.hi.x + r || p.z < pth.lo.z - r || p.z > pth.hi.z + r { return false }
    if p.y < pth.lo.y - r || p.y > pth.hi.y + r { return false }
    let q = vec4(p.x, p.y, p.z, 0.0)
    var pt = (__wp_base + pth.point_off) as *WpPathPoint
    var best = -1
    var bd = 0.0
    var bt = 0.0
    for k in 0..pth.point_count as s32 - 1 {
        let d = q - pt.pos
        let t = clamp(dot(d, pt.dir), 0.0, pt.len)
        let e = d - pt.dir * t
        if abs(e.x) < r && abs(e.y) < r && abs(e.z) < r {
            let d2 = dot(e, e)
            if best < 0 || d2 < bd {
                best = k
                bd = d2
                bt = t
            }
        }
        pt = pt + 1
    }
    if best < 0 { return false }
    __wp_near_set(pth, best, bt)
    wp_near.dist2 = bd
    return true
}

// The point at length s along the path (world), with wp_near set (dist2 = 0): a closed path
// wraps s, an open one clamps it to its ends. For something moving along a path (a train).
fn wp_path_at(pth: *WpPath, s: fixed) -> vec3 {
    let total = pth.lo.w
    var u = s
    if pth.flags & WP_PATH_CLOSED != 0 && (u < 0.0 || u >= total) {
        u = u - total * fixed((u / total) as s32)
        if u < 0.0 { u += total }
        if u >= total { u -= total }
    }
    u = clamp(u, 0.0, total)
    // the last segment that starts at or before u
    let pts = (__wp_base + pth.point_off) as *WpPathPoint
    var lo = 0
    var hi = pth.point_count as s32 - 2
    while lo < hi {
        let mid = (lo + hi + 1) >> 1
        if pts[mid].s <= u { lo = mid } else { hi = mid - 1 }
    }
    __wp_near_set(pth, lo, u - pts[lo].s)
    wp_near.dist2 = 0.0
    return wp_near.pos
}

// Draws the path as one-pixel lines over the frame (a debug view: the lines go on top of
// everything, and a segment with an end behind the near plane is left out). Call it after
// wp_draw(), whose camera it uses.
fn wp_path_draw(pth: *WpPath, colour: u32) {
    var pt = (__wp_base + pth.point_off) as *WpPathPoint
    var a = project_point(vec3(pt.pos.x, pt.pos.y, pt.pos.z) - __wp_origin)
    for k in 1..pth.point_count as s32 {
        pt = pt + 1
        let b = project_point(vec3(pt.pos.x, pt.pos.y, pt.pos.z) - __wp_origin)
        if a.z >= 0 && b.z >= 0 { line(a.x, a.y, b.x, b.y, colour) }
        a = b
    }
}

fn __wp_near_set(pth: *WpPath, k: s32, t: fixed) {
    let b = (__wp_base + pth.point_off) as *WpPathPoint + k
    wp_near.seg = k
    wp_near.t = t
    wp_near.s = b.s + t
    wp_near.dir = vec3(b.dir.x, b.dir.y, b.dir.z)
    wp_near.pos = vec3(b.pos.x + b.dir.x * t, b.pos.y + b.dir.y * t, b.pos.z + b.dir.z * t)
}

// ---- levels of detail (1.3; docs/WORLDPACK.md, "Levels of detail")
//
// A placement whose cell has a LOD table may name a LOD set: coarser meshes from given distances
// out (and, last, a distance past which it is not drawn). The distance is from the eye to the
// placement's sphere centre. Each level switch has a hysteresis band: a placement drawn at level
// L stays there until the eye is band units past a switch distance, so a camera hovering at one
// does not flip the level every frame. The level drawn is remembered per placement (one byte, in
// a table of WP_MAX_LOD; a placement past it uses the plain distances, without hysteresis).

const WP_MAX_LOD = 2048    // placements whose level the reader remembers

struct WpLodSet {
    count: u8          // levels after level 0, the cull mark included
    flags: u8          // bit 0: the last level is the cull mark (mesh 0)
    reserved: u16
    band: fixed        // the hysteresis band, units (informative: the rows below hold it)
}

struct WpLodLevel {
    at2: fixed         // (distance / 8)^2: the level starts here
    out2: fixed        // ((distance + band) / 8)^2: a finer level gives way to it here
    in2: fixed         // ((distance - band) / 8)^2: it gives way to the finer level below here
    mesh: u32          // 0: not drawn (the cull mark)
}

var __wp_lod_state: [WP_MAX_LOD]u8   // per slot: 0 unknown, else the level drawn last + 1

fn __wp_lod_open(h: *WpHeader) {
    mem_fill(&__wp_lod_state[0], 0, WP_MAX_LOD)
    if h.minor >= 3 && h.header_size >= 80 && h.near_far > 0.0 { wp_near_far = h.near_far }
}

// Forgets the levels drawn, so the next frame chooses by the plain distances (after a jump of
// the camera, say).
fn wp_lod_reset() { mem_fill(&__wp_lod_state[0], 0, WP_MAX_LOD) }

// The mesh to draw for placement k of cell c (p, in view, its cell offset off), or 0.
fn __wp_lod_mesh(c: *WpCell, k: s32, p: *WpPlacement, off: vec4) -> u32 {
    let so = ((__wp_base + c.lod_off) as *u32)[k]
    if so == 0 { return p.mesh }
    let set = (__wp_base + so) as *WpLodSet
    let d = p.sphere + off - __wp_eye
    let q = vec4(d.x, d.y, d.z, 0.0) * 0.125
    let d2 = dot(q, q)
    var r = (set as u32 + 8) as *WpLodLevel
    var plain = 0
    var lo = 0
    var hi = 0
    for n in 0..set.count as s32 {
        if d2 < r.in2 { break }
        hi += 1
        if d2 >= r.at2 { plain += 1 }
        if d2 >= r.out2 { lo += 1 }
        r = r + 1
    }
    let slot = c.lod_first as s32 + k
    var level = plain
    if wp_lod_fine {
        level = lo
    } else if slot < WP_MAX_LOD && __wp_lod_state[slot] != 0 {
        level = clamp(__wp_lod_state[slot] as s32 - 1, lo, hi)
    }
    if slot < WP_MAX_LOD { __wp_lod_state[slot] = (level + 1) as u8 }
    if level == 0 { return p.mesh }
    let m = ((set as u32 + 8) as *WpLodLevel + (level - 1)).mesh
    if m == 0 { wp_stats.lod_culled += 1 } else { wp_stats.coarse += 1 }
    return m
}
