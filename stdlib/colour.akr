// Colours: building, converting and blending packed colours (0xBBGGRR), and changing palette
// memory in place.

// Packs 0-255 channels into a GPU colour word (red in the low byte).
fn rgb(r: s32, g: s32, b: s32) -> u32 {
    return (r as u32 & 255) | ((g as u32 & 255) << 8) | ((b as u32 & 255) << 16)
}

// Converts a colour word to the 15-bit framebuffer format.
fn rgb15(c: u32) -> u32 {
    return ((c >> 3) & 31) | (((c >> 11) & 31) << 5) | (((c >> 19) & 31) << 10)
}

// Blends two colours: t = 0 gives a, 1.0 gives b (clamped; each channel rounds down). One
// clerp instruction.
fn col_mix(a: u32, b: u32, t: fixed) -> u32 { return clerp(a, b, t) }

// Scales each channel by t (0..1.0, clamped): col_scale(c, 0.5) is half as bright.
fn col_scale(c: u32, t: fixed) -> u32 { return clerp(0, c, t) }

// Adds two colours channel by channel, each clamped at 255.
fn col_add(a: u32, b: u32) -> u32 {
    let r = min((a & 255) + (b & 255), 255)
    let g = min(((a >> 8) & 255) + ((b >> 8) & 255), 255)
    let bl = min(((a >> 16) & 255) + ((b >> 16) & 255), 255)
    return r | (g << 8) | (bl << 16)
}

// The 0xBBGGRR colour of a 15-bit palette or framebuffer colour (each channel expanded as the
// GPU does: c << 3 | c >> 2).
fn rgb_of15(c: u32) -> u32 {
    let r = c & 31
    let g = (c >> 5) & 31
    let b = (c >> 10) & 31
    return ((r << 3) | (r >> 2)) | (((g << 3) | (g >> 2)) << 8) | (((b << 3) | (b >> 2)) << 16)
}

// Writes `count` palette colours from colour `index` (0-8191) on: each the blend of a[i] and b[i]
// (15-bit colours, e.g. two keyframe palettes in ROM) by t (0..1.0, clamped; each channel
// rounds down, like clerp). About 38 cycles a colour (15 when a[i] == b[i]). A run that
// crosses colour 4096 continues at the start of palette bank 1.
fn palette_lerp(index: s32, a: *u16, b: *u16, count: s32, t: fixed) {
    if count <= 0 { return }
    var n = count
    if index < PALETTE_BANK_COLOURS && index + count > PALETTE_BANK_COLOURS {
        n = PALETTE_BANK_COLOURS - index
        __pal_lerp((PALETTE_BANK_COLOURS | ((count - n) << 16)) as u32, a + n, b + n, t)
    }
    __pal_lerp(((index & 0x1FFF) | (n << 16)) as u32, a, b, t)
}

// palette_lerp's loop: ic is the first colour (0-8191) | the count << 16, within one bank.
asm fn __pal_lerp(ic: u32, a: *u16, b: *u16, t: fixed) {
    addi sp, sp, -8
    sw   r9, [sp+0]
    sw   r10, [sp+4]
    shri r10, {ic}, 16              ; the count
    andi r1, {ic}, 0x1FFF
    shli r1, r1, 1
    li   r6, {VRAM_PALETTE}
    andi r7, r1, 0x2000             ; colours 4096-8191: palette bank 1
    beq  r7, r0, .bank0
    li   r6, {VRAM_PALETTE_HI}
    sub  r1, r1, r7
.bank0:
    add  r1, r1, r6                 ; the destination
.loop:
    lhu  r6, [{a}+0]
    lhu  r7, [{b}+0]
    beq  r6, r7, .store
    andi r8, r6, 0x3E0              ; spread a's channels into bytes
    shli r8, r8, 3
    andi r9, r6, 0x7C00
    shli r9, r9, 6
    or   r8, r8, r9
    andi r6, r6, 31
    or   r6, r6, r8
    andi r8, r7, 0x3E0              ; and b's
    shli r8, r8, 3
    andi r9, r7, 0x7C00
    shli r9, r9, 6
    or   r8, r8, r9
    andi r7, r7, 31
    or   r7, r7, r8
    clerp r6, r7, {t}
    shri r8, r6, 3                  ; pack back to 15 bits
    andi r8, r8, 0x3E0
    shri r9, r6, 6
    andi r9, r9, 0x7C00
    andi r6, r6, 31
    or   r6, r6, r8
    or   r6, r6, r9
.store:
    sh   r6, [r1+0]
    addi {a}, {a}, 2
    addi {b}, {b}, 2
    addi r1, r1, 2
    addi r10, r10, -1
    bne  r10, r0, .loop
    lw   r9, [sp+0]
    lw   r10, [sp+4]
    addi sp, sp, 8
}

// Rotates `count` palette colours from colour `index` on by `step` places: afterwards colour
// index + i holds what index + (i + step) mod count held (colours move toward `index`; a
// negative step moves them the other way). For colour cycling (water, fire, conveyor belts).
// About 14 cycles a colour.
fn palette_rotate(index: s32, count: s32, step: s32) {
    if count < 2 { return }
    var k = step % count
    if k < 0 { k += count }
    if k == 0 { return }
    let p = palette_ptr(index)          // (the colours must be in one bank)
    __rev16(p, p + (k - 1))
    __rev16(p + k, p + (count - 1))
    __rev16(p, p + (count - 1))
}

// Reverses the halfwords lo..hi (inclusive).
asm fn __rev16(lo: *u16, hi: *u16) {
.loop:
    bgeu {lo}, {hi}, .done
    lhu  r5, [{lo}+0]
    lhu  r6, [{hi}+0]
    sh   r6, [{lo}+0]
    sh   r5, [{hi}+0]
    addi {lo}, {lo}, 2
    addi {hi}, {hi}, -2
    jmp  .loop
.done:
}
