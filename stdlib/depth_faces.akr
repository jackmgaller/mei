    jmp  .nextr
.s111:   ; gouraud textured quad, 68 bytes
    lw   r11, [r1+12]
    shri r12, r4, 8           ; blend mode, upper and decal offset -> bits 24-31
    andi r12, r12, 255
    shli r12, r12, 24
    or   r11, r11, r12
    sw   r11, [r15+4]
    lw   r11, [r5+{__sv}+8]
    sw   r11, [r15+8]
    lhu  r11, [r1+28]
    shri r12, r4, 16          ; slot, depth and palette -> bits 16-31
    andi r12, r12, 0xFF1F
    shli r12, r12, 16
    or   r11, r11, r12
    sw   r11, [r15+12]
    lw   r11, [r1+16]
    sw   r11, [r15+16]
    lw   r11, [r6+{__sv}+8]
    sw   r11, [r15+20]
