    lw   r10, [r0+{__scr_x1}]
    slt  r8, r6, r10
    xori r8, r8, 1
    shli r8, r8, 1
    or   r7, r7, r8
    lw   r9, [r0+{__scr_y0}]
    slt  r8, r5, r9
    shli r8, r8, 2
    or   r7, r7, r8
    lw   r10, [r0+{__scr_y1}]
    slt  r8, r5, r10
    xori r8, r8, 1
    shli r8, r8, 3
    or   r7, r7, r8
    bge  r12, r0, .ow2
    xori r7, r7, 15             ; behind the camera
.ow2:
    and  r11, r11, r7
    andi r12, r4, 4
    beq  r12, r0, .near3
    lhu  r5, [r1+10]
    shli r5, r5, 4
    lw   r12, [r5+{__sv}+12]           ; w
    lw   r5, [r5+{__sv}+8]
    shli r6, r5, 16
    sari r6, r6, 16             ; x
    sari r5, r5, 16             ; y
    lw   r9, [r0+{__scr_x0}]
    slt  r7, r6, r9
    lw   r10, [r0+{__scr_x1}]
    slt  r8, r6, r10
    xori r8, r8, 1
    shli r8, r8, 1
    or   r7, r7, r8
    lw   r9, [r0+{__scr_y0}]
    slt  r8, r5, r9
    shli r8, r8, 2
    or   r7, r7, r8
    lw   r10, [r0+{__scr_y1}]
    slt  r8, r5, r10
    xori r8, r8, 1
    shli r8, r8, 3
    or   r7, r7, r8
    bge  r12, r0, .ow3
    xori r7, r7, 15             ; behind the camera
.ow3:
    and  r11, r11, r7
.near3:
    bne  r11, r0, .next         ; wholly beyond one side of the view
    sw   r1, [sp+24]
    sw   r2, [sp+28]
    call {__clip_face}     ; r1 = the face
    lw   r1, [sp+24]
    lw   r2, [sp+28]
    jmp  .next
.next:
    addi r1, r1, 36
    addi r2, r2, -1
    bne  r2, r0, .face
.done:
    lw   r9, [sp+0]
    lw   r10, [sp+4]
    lw   r11, [sp+8]
    lw   r12, [sp+12]
    lw   r13, [sp+16]
    lw   ra, [sp+20]
    addi sp, sp, 32
    ret
    .align 4
.table:
    .word .v0000
    .word .v1000
    .word .v0100
    .word .v1100
    .word .v0010
    .word .v1010
    .word .v0110
    .word .v1110
    .word .v1001
    .word .v1001
    .word .v1101
    .word .v1101
    .word .v1011
    .word .v1011
    .word .v1111
    .word .v1111
    .word .v0000
    .word .v1000
    .word .v0100w
    .word .v1100w
    .word .v0010
    .word .v1010
    .word .v0110w
    .word .v1110w
    .word .v1001
    .word .v1001
    .word .v1101w
    .word .v1101w
    .word .v1011
    .word .v1011
    .word .v1111w
    .word .v1111w
}

// The loop for a mesh that needs no clipping at all: see safe_loop() in gen_faces_asm.py.
asm fn __zdraw_faces_safe(first: *Face, nf: s32) {
    beq  r2, r0, .ret
    addi sp, sp, -24
    sw   r9, [sp+0]
    sw   r10, [sp+4]
    sw   r11, [sp+8]
    sw   r12, [sp+12]
    sw   r13, [sp+16]
    sw   ra, [sp+20]
    shli r11, r2, 5
    shli r2, r2, 2
    add  r2, r2, r11
    add  r2, r2, r1             ; the end of the faces (36 bytes each)
    lw   r15, [r0+{__arena_ptr}]
    lw   r3, [r0+{__cam_near}]
    add  r12, r3, r3
    add  r3, r12, r3            ; 3 near
    li   r8, 0xFF1F0000
.face:
    lw   r4, [r1]               ; flags, blend, texture, palette
    lhu  r5, [r1+4]
    shli r5, r5, 4
    lhu  r6, [r1+6]
    shli r6, r6, 4
    lhu  r7, [r1+8]
    shli r7, r7, 4
    ; back faces: nclip >= 0 (front faces are counter-clockwise on screen)
    lw   r12, [r5+{__sv}+8]
    lw   r11, [r6+{__sv}+8]     ; (r11 and r13 keep positions 1 and 2 for the flat triangle)
    lw   r13, [r7+{__sv}+8]
    nclip r12, r11, r13
    bge  r12, r0, .back
.front:
    andi r12, r4, 39            ; keyed, quad, textured, Gouraud
    addi r9, r0, 2
    bne  r12, r9, .notri        ; not a flat textured triangle
    lw   r10, [r5+{__sv}+12]
    sw   r10, [r15+32]          ; the corners' w
    lw   r12, [r6+{__sv}+12]
    sw   r12, [r15+36]
    add  r10, r10, r12
    lw   r12, [r7+{__sv}+12]
    sw   r12, [r15+40]
    add  r10, r10, r12
    sub  r12, r10, r3           ; w0 + w1 + w2 - 3 near
    lw   r6, [r0+{__ot_k3}]
    lw   r10, [r0+{__ot_bias}]
    otz  r10, r12, r6           ; ordering-table bucket
    lw   r12, [r0+{__z_flags}]  ; upper 0x400, decal offset << 11
    or   r4, r4, r12
    ; header and ordering-table insertion
    shli r10, r10, 2
    andi r6, r4, 8              ; semi-transparent: __z_tab[1], opaque: __z_tab[0]
    shri r6, r6, 1
    lw   r6, [r6+{__z_tab}]
    add  r10, r10, r6
    lw   r12, [r10]
    andi r6, r4, 15
    ori  r6, r6, 0x30
    shli r6, r6, 24
    or   r12, r12, r6
    sw   r12, [r15]
    sw   r15, [r10]
    ; the packet: flat textured triangle with depth, 44 bytes
    lw   r12, [r1+12]
    shri r6, r4, 8              ; blend mode -> bits 24 up
    andi r6, r6, 255
    shli r6, r6, 24
    or   r12, r12, r6
    sw   r12, [r15+4]
    lw   r12, [r5+{__sv}+8]
    sw   r12, [r15+8]
    lhu  r12, [r1+28]
    and  r6, r4, r8             ; slot, depth and palette -> bits 16-31
    or   r12, r12, r6
    sw   r12, [r15+12]
    sw   r11, [r15+16]
    lhu  r12, [r1+30]
    sw   r12, [r15+20]
    sw   r13, [r15+24]
    lhu  r12, [r1+32]
    sw   r12, [r15+28]
    addi r15, r15, 44
.next:
    addi r1, r1, 36
    bltu r1, r2, .face
    sw   r15, [r0+{__arena_ptr}]
    lw   r9, [sp+0]
    lw   r10, [sp+4]
    lw   r11, [sp+8]
    lw   r12, [sp+12]
    lw   r13, [sp+16]
    lw   ra, [sp+20]
    addi sp, sp, 24
.ret:
    ret
.back:
    andi r12, r4, 16            ; double-sided
    beq  r12, r0, .next
    jmp  .front
.nextr:
    li   r8, 0xFF1F0000
    jmp  .next
.notri:
    addi r9, r0, 6
    bne  r12, r9, .gen          ; not a flat textured quad either
    lw   r10, [r5+{__sv}+12]
    sw   r10, [r15+40]          ; the corners' w
    lw   r12, [r6+{__sv}+12]
    sw   r12, [r15+44]
    add  r10, r10, r12
    lw   r12, [r7+{__sv}+12]
    sw   r12, [r15+48]
    add  r10, r10, r12
    lhu  r7, [r1+10]
    shli r7, r7, 4
    lw   r12, [r7+{__sv}+12]
    sw   r12, [r15+52]
    add  r10, r10, r12
    lw   r6, [r0+{__cam_near}]
    shli r6, r6, 2
    sub  r12, r10, r6           ; w0 + w1 + w2 + w3 - 4 near
    lw   r6, [r0+{__ot_k4}]
    lw   r10, [r0+{__ot_bias}]
    otz  r10, r12, r6           ; ordering-table bucket
    lw   r12, [r0+{__z_flags}]  ; upper 0x400, decal offset << 11
    or   r4, r4, r12
    shli r10, r10, 2
    andi r6, r4, 8              ; semi-transparent: __z_tab[1], opaque: __z_tab[0]
    shri r6, r6, 1
    lw   r6, [r6+{__z_tab}]
    add  r10, r10, r6
    lw   r12, [r10]
    andi r6, r4, 15
    ori  r6, r6, 0x30
    shli r6, r6, 24
    or   r12, r12, r6
    sw   r12, [r15]
    sw   r15, [r10]
    ; the packet: flat textured quad with depth, 56 bytes
    lw   r12, [r1+12]
    shri r6, r4, 8              ; blend mode -> bits 24 up
    andi r6, r6, 255
    shli r6, r6, 24
    or   r12, r12, r6
    sw   r12, [r15+4]
    lw   r12, [r5+{__sv}+8]
    sw   r12, [r15+8]
    lhu  r12, [r1+28]
    and  r6, r4, r8             ; slot, depth and palette -> bits 16-31
    or   r12, r12, r6
    sw   r12, [r15+12]
    sw   r11, [r15+16]
    lhu  r12, [r1+30]
    sw   r12, [r15+20]
    sw   r13, [r15+24]
    lhu  r12, [r1+32]
    sw   r12, [r15+28]
    lw   r12, [r7+{__sv}+8]
    sw   r12, [r15+32]
    lhu  r12, [r1+34]
    sw   r12, [r15+36]
    addi r15, r15, 56
    jmp  .next
    ; any other face: as __draw_faces makes it
.gen:
    andi r12, r4, 32
    bne  r12, r0, .keyed        ; FACE_KEYED: the bucket is in col[3]
    lw   r10, [r5+{__sv}+12]
    lw   r12, [r6+{__sv}+12]
    add  r10, r10, r12
    lw   r12, [r7+{__sv}+12]
    add  r10, r10, r12          ; w0 + w1 + w2
    andi r12, r4, 4
    bne  r12, r0, .quad
    sub  r12, r10, r3           ; w0 + w1 + w2 - 3 near
    lw   r9, [r0+{__ot_k3}]
.depth:
    lw   r10, [r0+{__ot_bias}]
    otz  r10, r12, r9           ; ordering-table bucket
.dk:
    lw   r12, [r0+{__z_flags}]  ; upper 0x400, decal offset << 11
    or   r4, r4, r12
    shli r10, r10, 2
    andi r9, r4, 8              ; semi-transparent: __z_tab[1], opaque: __z_tab[0]
    shri r9, r9, 1
    lw   r9, [r9+{__z_tab}]
    add  r10, r10, r9
    lw   r12, [r10]
    andi r9, r4, 15
    ori  r9, r9, 0x30
    shli r9, r9, 24
    or   r12, r12, r9
    sw   r12, [r15]
    sw   r15, [r10]
    andi r12, r4, 7
    shli r12, r12, 2
    la   r9, .table
    add  r9, r9, r12
    lw   r9, [r9]
    jr   r9
.quad:
    lhu  r8, [r1+10]
    shli r8, r8, 4
    lw   r12, [r8+{__sv}+12]
    add  r10, r10, r12
    lw   r12, [r0+{__cam_near}]
    shli r12, r12, 2
    sub  r12, r10, r12          ; w0 + w1 + w2 + w3 - 4 near
    lw   r9, [r0+{__ot_k4}]
    jmp  .depth
.keyed:
    lhu  r8, [r1+10]            ; (the fourth corner, for a quad's writer)
    shli r8, r8, 4
    lw   r10, [r0+{__ot_bias}]
    lw   r9, [r1+24]
    add  r10, r10, r9
    bge  r10, r0, .k0
    mov  r10, r0
.k0:
    slti r9, r10, 1024
    bne  r9, r0, .dk
    addi r10, r0, 1023
    jmp  .dk
.s000:   ; flat triangle, 32 bytes
    lw   r11, [r1+12]
    shri r12, r4, 8           ; blend mode, upper and decal offset -> bits 24-31
    andi r12, r12, 255
    shli r12, r12, 24
    or   r11, r11, r12
    sw   r11, [r15+4]
    lw   r11, [r5+{__sv}+8]
    sw   r11, [r15+8]
    lw   r11, [r6+{__sv}+8]
    sw   r11, [r15+12]
    lw   r11, [r7+{__sv}+8]
    sw   r11, [r15+16]
    lw   r11, [r5+{__sv}+12]   ; w
    sw   r11, [r15+20]
    lw   r11, [r6+{__sv}+12]   ; w
    sw   r11, [r15+24]
    lw   r11, [r7+{__sv}+12]   ; w
    sw   r11, [r15+28]
    addi r15, r15, 32
    jmp  .nextr
.s100:   ; gouraud triangle, 40 bytes
    lw   r11, [r1+12]
    shri r12, r4, 8           ; blend mode, upper and decal offset -> bits 24-31
    andi r12, r12, 255
    shli r12, r12, 24
    or   r11, r11, r12
    sw   r11, [r15+4]
    lw   r11, [r5+{__sv}+8]
    sw   r11, [r15+8]
    lw   r11, [r1+16]
    sw   r11, [r15+12]
    lw   r11, [r6+{__sv}+8]
    sw   r11, [r15+16]
    lw   r11, [r1+20]
    sw   r11, [r15+20]
    lw   r11, [r7+{__sv}+8]
    sw   r11, [r15+24]
    lw   r11, [r5+{__sv}+12]   ; w
    sw   r11, [r15+28]
    lw   r11, [r6+{__sv}+12]   ; w
    sw   r11, [r15+32]
    lw   r11, [r7+{__sv}+12]   ; w
    sw   r11, [r15+36]
    addi r15, r15, 40
    jmp  .nextr
.s010:   ; flat textured triangle, 44 bytes
    lw   r11, [r1+12]
    shri r12, r4, 8           ; blend mode, upper and decal offset -> bits 24-31
    andi r12, r12, 255
    shli r12, r12, 24
    or   r11, r11, r12
    sw   r11, [r15+4]
    lw   r11, [r5+{__sv}+8]
    sw   r11, [r15+8]
    lhu  r11, [r1+28]
    shri r12, r4, 16          ; slot, depth and palette -> bits 16-31
    andi r12, r12, 0xFF1F
    shli r12, r12, 16
    or   r11, r11, r12
    sw   r11, [r15+12]
    lw   r11, [r6+{__sv}+8]
    sw   r11, [r15+16]
    lhu  r11, [r1+30]
    sw   r11, [r15+20]
    lw   r11, [r7+{__sv}+8]
    sw   r11, [r15+24]
    lhu  r11, [r1+32]
    sw   r11, [r15+28]
    lw   r11, [r5+{__sv}+12]   ; w
    sw   r11, [r15+32]
    lw   r11, [r6+{__sv}+12]   ; w
    sw   r11, [r15+36]
    lw   r11, [r7+{__sv}+12]   ; w
    sw   r11, [r15+40]
    addi r15, r15, 44
    jmp  .nextr
.s110:   ; gouraud textured triangle, 52 bytes
    lw   r11, [r1+12]
    shri r12, r4, 8           ; blend mode, upper and decal offset -> bits 24-31
    andi r12, r12, 255
    shli r12, r12, 24
    or   r11, r11, r12
    sw   r11, [r15+4]
    lw   r11, [r5+{__sv}+8]
    sw   r11, [r15+8]
    lhu  r11, [r1+28]
    shri r12, r4, 16          ; slot, depth and palette -> bits 16-31
    andi r12, r12, 0xFF1F
    shli r12, r12, 16
    or   r11, r11, r12
    sw   r11, [r15+12]
    lw   r11, [r1+16]
    sw   r11, [r15+16]
    lw   r11, [r6+{__sv}+8]
    sw   r11, [r15+20]
    lhu  r11, [r1+30]
    sw   r11, [r15+24]
    lw   r11, [r1+20]
    sw   r11, [r15+28]
    lw   r11, [r7+{__sv}+8]
    sw   r11, [r15+32]
    lhu  r11, [r1+32]
    sw   r11, [r15+36]
    lw   r11, [r5+{__sv}+12]   ; w
    sw   r11, [r15+40]
    lw   r11, [r6+{__sv}+12]   ; w
    sw   r11, [r15+44]
    lw   r11, [r7+{__sv}+12]   ; w
    sw   r11, [r15+48]
    addi r15, r15, 52
    jmp  .nextr
.s001:   ; flat quad, 40 bytes
    lw   r11, [r1+12]
    shri r12, r4, 8           ; blend mode, upper and decal offset -> bits 24-31
    andi r12, r12, 255
    shli r12, r12, 24
    or   r11, r11, r12
    sw   r11, [r15+4]
    lw   r11, [r5+{__sv}+8]
    sw   r11, [r15+8]
    lw   r11, [r6+{__sv}+8]
    sw   r11, [r15+12]
    lw   r11, [r7+{__sv}+8]
    sw   r11, [r15+16]
    lw   r11, [r8+{__sv}+8]
    sw   r11, [r15+20]
    lw   r11, [r5+{__sv}+12]   ; w
    sw   r11, [r15+24]
    lw   r11, [r6+{__sv}+12]   ; w
    sw   r11, [r15+28]
    lw   r11, [r7+{__sv}+12]   ; w
    sw   r11, [r15+32]
    lw   r11, [r8+{__sv}+12]   ; w
    sw   r11, [r15+36]
    addi r15, r15, 40
    jmp  .nextr
.s101:   ; gouraud quad, 52 bytes
    lw   r11, [r1+12]
    shri r12, r4, 8           ; blend mode, upper and decal offset -> bits 24-31
    andi r12, r12, 255
    shli r12, r12, 24
    or   r11, r11, r12
    sw   r11, [r15+4]
    lw   r11, [r5+{__sv}+8]
    sw   r11, [r15+8]
    lw   r11, [r1+16]
    sw   r11, [r15+12]
    lw   r11, [r6+{__sv}+8]
    sw   r11, [r15+16]
    lw   r11, [r1+20]
    sw   r11, [r15+20]
    lw   r11, [r7+{__sv}+8]
    sw   r11, [r15+24]
    lw   r11, [r1+24]
    sw   r11, [r15+28]
    lw   r11, [r8+{__sv}+8]
    sw   r11, [r15+32]
    lw   r11, [r5+{__sv}+12]   ; w
    sw   r11, [r15+36]
    lw   r11, [r6+{__sv}+12]   ; w
    sw   r11, [r15+40]
    lw   r11, [r7+{__sv}+12]   ; w
    sw   r11, [r15+44]
    lw   r11, [r8+{__sv}+12]   ; w
    sw   r11, [r15+48]
    addi r15, r15, 52
