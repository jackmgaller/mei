    shli r12, r12, 16
    or   r11, r11, r12
    sw   r11, [r15+12]
    lw   r11, [r6+{__sv}+8]
    sw   r11, [r15+16]
    lhu  r11, [r1+30]
    sw   r11, [r15+20]
    lw   r11, [r7+{__sv}+8]
    sw   r11, [r15+24]
    lhu  r11, [r1+32]
    sw   r11, [r15+28]
    lw   r11, [r8+{__sv}+8]
    sw   r11, [r15+32]
    lhu  r11, [r1+34]
    sw   r11, [r15+36]
    lw   r11, [r5+{__sv}+12]   ; w
    sw   r11, [r15+40]
    lw   r11, [r6+{__sv}+12]   ; w
    sw   r11, [r15+44]
    lw   r11, [r7+{__sv}+12]   ; w
    sw   r11, [r15+48]
    lw   r11, [r8+{__sv}+12]   ; w
    sw   r11, [r15+52]
