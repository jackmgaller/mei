.nb:
    ; corner 0 is behind the near plane: clip the face, unless they all are
    lhu  r5, [r1+6]
    shli r5, r5, 4
    lw   r11, [r5+{__sv}+12]
    bge  r11, r9, .near
    lhu  r5, [r1+8]
    shli r5, r5, 4
    lw   r11, [r5+{__sv}+12]
    bge  r11, r9, .near
    andi r11, r4, 4
    beq  r11, r0, .next
    lhu  r5, [r1+10]
    shli r5, r5, 4
    lw   r11, [r5+{__sv}+12]
    blt  r11, r9, .next
.near:
    addi r11, r0, 15
    lhu  r5, [r1+4]
    shli r5, r5, 4
    lw   r12, [r5+{__sv}+12]           ; w
    lw   r5, [r5+{__sv}+8]
    shli r6, r5, 16
    sari r6, r6, 16             ; x
    sari r5, r5, 16             ; y
    lw   r9, [r0+{__scr_x0}]
    slt  r7, r6, r9
    lw   r10, [r0+{__scr_x1}]
    slt  r8, r6, r10
    xori r8, r8, 1
    shli r8, r8, 1
    or   r7, r7, r8
    lw   r9, [r0+{__scr_y0}]
    slt  r8, r5, r9
    shli r8, r8, 2
    or   r7, r7, r8
    lw   r10, [r0+{__scr_y1}]
    slt  r8, r5, r10
    xori r8, r8, 1
    shli r8, r8, 3
    or   r7, r7, r8
    bge  r12, r0, .ow0
    xori r7, r7, 15             ; behind the camera
.ow0:
    and  r11, r11, r7
    lhu  r5, [r1+6]
    shli r5, r5, 4
    lw   r12, [r5+{__sv}+12]           ; w
    lw   r5, [r5+{__sv}+8]
    shli r6, r5, 16
    sari r6, r6, 16             ; x
    sari r5, r5, 16             ; y
    lw   r9, [r0+{__scr_x0}]
    slt  r7, r6, r9
    lw   r10, [r0+{__scr_x1}]
    slt  r8, r6, r10
    xori r8, r8, 1
    shli r8, r8, 1
    or   r7, r7, r8
    lw   r9, [r0+{__scr_y0}]
    slt  r8, r5, r9
    shli r8, r8, 2
    or   r7, r7, r8
    lw   r10, [r0+{__scr_y1}]
    slt  r8, r5, r10
    xori r8, r8, 1
    shli r8, r8, 3
    or   r7, r7, r8
    bge  r12, r0, .ow1
    xori r7, r7, 15             ; behind the camera
.ow1:
    and  r11, r11, r7
    lhu  r5, [r1+8]
    shli r5, r5, 4
    lw   r12, [r5+{__sv}+12]           ; w
