    ; corner 0 is behind the near plane: clip the face, unless they all are
    lhu  r5, [r1+6]
    shli r5, r5, 4
    lw   r11, [r5+{__sv}+12]
    bge  r11, r9, .near
    lhu  r5, [r1+8]
    shli r5, r5, 4
    lw   r11, [r5+{__sv}+12]
    bge  r11, r9, .near
    andi r11, r4, 4
    beq  r11, r0, .next
    lhu  r5, [r1+10]
    shli r5, r5, 4
    lw   r11, [r5+{__sv}+12]
