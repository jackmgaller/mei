// Memory-mapped I/O registers (spec pages 12-14). Assigning to a register is one sw.

reg GPU_DRAW: u32 @ 0xFF0000     // write: draw the packet list at this address
reg GPU_CLEAR: u32 @ 0xFF0004    // write: fill the back buffer with a 15-bit colour
reg GPU_CTRL: u32 @ 0xFF0008     // bit 0: dither
reg GPU_STATUS: u32 @ 0xFF000C   // bits 0-15 triangles drawn, bit 16 limit exceeded
reg GPU_BACK: u32 @ 0xFF0010     // address of the back buffer
reg GPU_LOAD: u32 @ 0xFF0014     // GPU cycles the last frame shown took to draw (budget 2,000,000 a tick)
reg GPU_TICKS: u32 @ 0xFF0018    // ticks the last frame shown took: 1 on time
reg GPU_LAG: u32 @ 0xFF001C      // ticks since reset a finished frame waited for the GPU
reg GPU_DEPTH: u32 @ 0xFF0020    // bit 0: test packets with depth (0x30-0x3F) against the depth buffer
reg GPU_ZCLEAR: u32 @ 0xFF0024   // write: fill the depth buffer with bits 0-15 (0 the farthest)
reg GPU_FOG: u32 @ 0xFF0028      // proposal: bits 0-23 the fog colour, bit 24 fog packets with depth
reg GPU_FOG_RANGE: u32 @ 0xFF002C   // proposal: bits 0-15 near (1/16 units), bits 16-31 the scale

reg PAD1: u32 @ 0xFF0200
reg PAD2: u32 @ 0xFF0204
reg STICK1_X: fixed @ 0xFF0208
reg STICK1_Y: fixed @ 0xFF020C
reg STICK2_X: fixed @ 0xFF0210
reg STICK2_Y: fixed @ 0xFF0214

reg FRAME: u32 @ 0xFF0300        // frames since reset
reg CYCLES: s32 @ 0xFF0304       // cycles left in this frame
reg RAND: u32 @ 0xFF0308         // read: next random number; write: seed
reg DEBUG: u32 @ 0xFF030C        // write: one character to the debug console
reg SYS_TIME: u32 @ 0xFF0318     // local time: seconds since midnight (docs/SYSTEM.md)
reg SYS_DATE: u32 @ 0xFF031C     // bits 0-4 day, 5-8 month, 9-11 weekday (0 = Sunday), 16-31 year

const AUDIO_BASE = 0xFF0100      // channel n at AUDIO_BASE + n * 32
// VRAM is 2 MB, 0x400000-0x5FFFFF (docs/DECISIONS.md, "VRAM at 2 MB").
const VRAM_PALETTE = 0x44C000    // palette bank 0: colour i (0-4095) at VRAM_PALETTE + i * 2
const VRAM_PALETTE_HI = 0x580000 // palette bank 1: colour i (4096-8191) at VRAM_PALETTE_HI + (i - 4096) * 2
const PALETTE_BANK_COLOURS = 4096
const VRAM_TEXTURES = 0x480000   // slot n (0-31) at VRAM_TEXTURES + n * TEXTURE_SLOT_SIZE
const TEXTURE_SLOT_SIZE = 0x8000
const TEXTURE_SLOTS = 32
const VRAM_FREE = 0x582000       // free VRAM to VRAM_END: plane pages 49-63 and the rest of page 48
const VRAM_END = 0x600000
const SCREEN_W = 320
const SCREEN_H = 240

asm fn vsync() {
    vsync
}
