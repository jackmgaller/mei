// Tsumiki shapes: meshes built from blocks in code, at start-up.
//
//     tk_shape_begin()
//     tk_paint(TK_RED, TK_WOOD)                       // the brush: colour and finish
//     tk_box(vec3(-0.5, 0.0, -0.5), vec3(0.5, 1.0, 0.5))
//     tk_paint(TK_YELLOW, TK_PLAIN)
//     tk_cone(vec3(0.0, 1.0, 0.0), 0.6, 0.8, 8)
//     let tower = tk_shape_end()                      // a *Mesh, for mesh_at() and friends
//
// The brush keeps its settings until they change; tk_shape_begin() resets it (white, plain,
// flat-lit, opaque, one-sided, solid). Faces are lit when they are built (tk_light()), so
// a block's top, front and sides come out in different shades of its paint. The mesh lives
// in the shape bin (base.akr) until tk_open() empties it.
//
// Between tk_level_begin() and tk_level_end() (scene.akr) the same shapes are also solid:
// each adds a collider (collide.akr) unless tk_solid(false).

const TK_EAST = 0              // ramp directions: the way the slope rises
const TK_WEST = 1
const TK_NORTH = 2             // +Z
const TK_SOUTH = 3             // -Z

const TK_MAX_SHAPE_FACES = 1024

var __tk_faces: [1024]Face     // the faces of the mesh being built (copied behind its vertices)
var __tk_nf: s32
var __tk_mesh: *Mesh           // the mesh being built, or null
var __tk_verts: *vec4
var __tk_nv: s32
var __tk_full: bool            // ran out of room (said once)
var __tk_lo: vec3              // the bounds of what was built
var __tk_hi: vec3
var __tk_level: bool           // building a level piece: shapes are solid too

// the brush
var __tk_colour: u32 = 0xFAFAFA
var __tk_cell: u32
var __tk_smooth: bool
var __tk_bmode: s32 = -1
var __tk_two: bool
var __tk_solid_on: bool = true

// Starts a new mesh. Shapes go into it until tk_shape_end().
fn tk_shape_begin() {
    if __tk_mesh != null { println("tsumiki: tk_shape_begin() again before tk_shape_end()") }
    __tk_mesh = (&__tk_bin[0] as *u8 + __tk_bin_used) as *Mesh
    __tk_verts = (__tk_mesh as *u8 + 16) as *vec4
    __tk_nv = 0
    __tk_nf = 0
    __tk_full = false
    __tk_lo = vec3(1000.0, 1000.0, 1000.0)
    __tk_hi = vec3(-1000.0, -1000.0, -1000.0)
    __tk_level = false
    __tk_colour = TK_WHITE
    __tk_cell = TK_PLAIN
    __tk_smooth = false
    __tk_bmode = -1
    __tk_two = false
    __tk_solid_on = true
}

// Finishes the mesh: returns it (in the shape bin), or null when nothing could be built.
fn tk_shape_end() -> *Mesh {
    let m = __tk_mesh
    __tk_mesh = null
    if m == null { return null }
    let fbytes = __tk_nf * sizeof(Face)
    let p = __tk_alloc(16 + __tk_nv * 16 + fbytes)      // the room the vertices already use, and the faces
    if p == null { return null }
    m.nverts = __tk_nv as u16
    m.nfaces = __tk_nf as u16
    m.verts = 16
    m.faces = (16 + __tk_nv * 16) as u32
    m.reserved = 0
    memcpy(p + m.faces, &__tk_faces[0] as *u8, fbytes as u32)
    return m
}

// ---- the brush

// Paint for the following faces: a colour and a finish, TK_PLAIN or a texture cell (TK_WOOD,
// TK_PLANKS, ... or one made by tools/tsumiki.py). A cell is drawn tinted by the colour, so a
// grey built-in finish takes the colour, and TK_WHITE shows a coloured cell as it is.
fn tk_paint(colour: u32, finish: u32) {
    __tk_colour = colour & 0xFFFFFF
    __tk_cell = finish
}

// Smooth (Gouraud) lighting: each corner lit by its own normal, so spheres, cylinders and
// cones look round. Off: each face one shade (the wooden-block look).
fn tk_smooth(on: bool) { __tk_smooth = on }

// Semi-transparent faces: BLEND_HALF (glass, water), BLEND_ADD (glows), BLEND_SUB,
// BLEND_QUARTER; BLEND_NONE for opaque.
fn tk_blend(mode: s32) { __tk_bmode = mode }

// Faces seen from both sides (thin things: flags, paper, leaves).
fn tk_two_sided(on: bool) { __tk_two = on }

// Inside a level: whether the following shapes are solid (default true). Rugs and other
// things to walk through: tk_solid(false).
fn tk_solid(on: bool) { __tk_solid_on = on }

// ---- vertices and faces

fn __tk_v(p: vec3) -> s32 {
    if __tk_mesh == null {
        println("tsumiki: a shape outside tk_shape_begin() .. tk_shape_end()")
        return 0
    }
    let room = TK_BIN_BYTES - __tk_bin_used - 16 - (__tk_nv + 1) * 16 - (__tk_nf + 12) * sizeof(Face)
    if __tk_nv >= MAX_MESH_VERTS || room < 0 {
        if !__tk_full { println("tsumiki: a shape is too big (2,048 vertices, or the bin is full)") }
        __tk_full = true
        return 0
    }
    __tk_verts[__tk_nv] = vec4(p, 1.0)
    __tk_lo = vec3(min(__tk_lo.x, p.x), min(__tk_lo.y, p.y), min(__tk_lo.z, p.z))
    __tk_hi = vec3(max(__tk_hi.x, p.x), max(__tk_hi.y, p.y), max(__tk_hi.z, p.z))
    __tk_nv += 1
    return __tk_nv - 1
}

// The brush colour of a face (or corner) with unit normal n: lit, and halved for a texture
// (its colour is a tint: 128 leaves a texel as it is).
fn __tk_shade(n: vec3) -> u32 {
    let c = col_scale(__tk_colour, __tk_bright(n))
    if __tk_cell != TK_PLAIN { return col_tint(c) }
    return c
}

// A face: a triangle (i3 < 0) or a quad in strip order (bottom-left, bottom-right, top-left,
// top-right seen from outside). It is turned to face along n whichever way round its corners
// came. With tk_smooth() on, the corners are lit by n0..n3 instead.
fn __tk_face(i0: s32, i1: s32, i2: s32, i3: s32, n: vec3, n0: vec3, n1: vec3, n2: vec3, n3: vec3) {
    if __tk_full { return }
    if __tk_nf >= TK_MAX_SHAPE_FACES {
        println("tsumiki: a shape has more than 1,024 faces")
        __tk_full = true
        return
    }
    var a = i0
    var b = i1
    var c = i2
    var d = i3
    var na = n0
    var nb = n1
    var nc = n2
    var nd = n3
    // Mei's world is left-handed: a face is front-facing when (b - a) x (c - a) points inward
    let e = cross((__tk_verts[b] - __tk_verts[a]) as vec3, (__tk_verts[c] - __tk_verts[a]) as vec3)
    if dot(e, n) > 0.0 {
        a = i1
        b = i0
        na = n1
        nb = n0
        if i3 >= 0 {
            c = i3
            d = i2
            nc = n3
            nd = n2
        }
    }
    let f = &__tk_faces[__tk_nf]
    __tk_nf += 1
    var flags: u32 = 0
    if d >= 0 { flags = FACE_QUAD } else { d = c }
    if __tk_two { flags |= FACE_DOUBLE }
    if __tk_bmode >= 0 { flags |= FACE_SEMI }
    f.blend = max(__tk_bmode, 0) as u8
    f.idx[0] = a as u16
    f.idx[1] = b as u16
    f.idx[2] = c as u16
    f.idx[3] = d as u16
    if __tk_smooth {
        flags |= FACE_GOURAUD
        f.col[0] = __tk_shade(na)
        f.col[1] = __tk_shade(nb)
        f.col[2] = __tk_shade(nc)
        f.col[3] = __tk_shade(nd)
    } else {
        let col = __tk_shade(n)
        for k in 0..4 { f.col[k] = col }
    }
    if __tk_cell != TK_PLAIN {
        flags |= FACE_TEXTURED
        let cl = __tk_cell
        f.tex = (((cl >> 20) & 15) | 16) as u8
        f.palette = (cl >> 24) as u8
        let u0 = tk_cell_u(cl)
        let v0 = tk_cell_v(cl)
        let u1 = u0 + tk_cell_w(cl) - 1
        let v1 = v0 + tk_cell_h(cl) - 1
        f.uv[0] = (u0 | (v1 << 8)) as u16
        f.uv[1] = (u1 | (v1 << 8)) as u16
        if (flags & FACE_QUAD) != 0 {
            f.uv[2] = (u0 | (v0 << 8)) as u16
            f.uv[3] = (u1 | (v0 << 8)) as u16
        } else {
            f.uv[2] = (((u0 + u1) >> 1) | (v0 << 8)) as u16
            f.uv[3] = f.uv[2]
        }
    } else {
        f.tex = 0
        f.palette = 0
        for k in 0..4 { f.uv[k] = 0 }
    }
    f.flags = flags as u8
}

fn __tk_quad(a: s32, b: s32, c: s32, d: s32, n: vec3) { __tk_face(a, b, c, d, n, n, n, n, n) }
fn __tk_tri(a: s32, b: s32, c: s32, n: vec3) { __tk_face(a, b, c, -1, n, n, n, n, n) }

// ---- shapes

// A block from corner lo to corner hi (the smaller x, y, z to the larger).
fn tk_box(lo: vec3, hi: vec3) {
    let base = __tk_nv
    for k in 0..8 {
        var x = lo.x
        var y = lo.y
        var z = lo.z
        if (k & 1) != 0 { x = hi.x }
        if (k & 2) != 0 { y = hi.y }
        if (k & 4) != 0 { z = hi.z }
        let _ = __tk_v(vec3(x, y, z))           // vertex base + x + 2y + 4z
    }
    __tk_quad(base + 0, base + 1, base + 2, base + 3, vec3(0.0, 0.0, -1.0))
    __tk_quad(base + 5, base + 4, base + 7, base + 6, vec3(0.0, 0.0, 1.0))
    __tk_quad(base + 1, base + 5, base + 3, base + 7, vec3(1.0, 0.0, 0.0))
    __tk_quad(base + 4, base + 0, base + 6, base + 2, vec3(-1.0, 0.0, 0.0))
    __tk_quad(base + 2, base + 3, base + 6, base + 7, vec3(0.0, 1.0, 0.0))
    __tk_quad(base + 4, base + 5, base + 0, base + 1, vec3(0.0, -1.0, 0.0))
    if __tk_level && __tk_solid_on { let _ = tk_add_box(lo, hi) }
}

// A point of the ramp in lo..hi rising toward dir: `a` 0..1 along the rise, `s` 0..1 across.
fn __tk_ramp_pt(lo: vec3, hi: vec3, dir: s32, a: fixed, s: fixed, y: fixed) -> vec3 {
    match dir {
        0 => return vec3(lo.x + (hi.x - lo.x) * a, y, lo.z + (hi.z - lo.z) * s)
        1 => return vec3(hi.x - (hi.x - lo.x) * a, y, lo.z + (hi.z - lo.z) * s)
        2 => return vec3(lo.x + (hi.x - lo.x) * s, y, lo.z + (hi.z - lo.z) * a)
        else => return vec3(lo.x + (hi.x - lo.x) * s, y, hi.z - (hi.z - lo.z) * a)
    }
}

// A wedge filling the block lo..hi: its slope rises from lo.y to hi.y toward dir (TK_EAST
// +X, TK_WEST -X, TK_NORTH +Z, TK_SOUTH -Z). Bodies walk up it when it is no steeper than
// their step allows (body.akr).
fn tk_ramp(lo: vec3, hi: vec3, dir: s32) {
    let b00 = __tk_v(__tk_ramp_pt(lo, hi, dir, 0.0, 0.0, lo.y))
    let b01 = __tk_v(__tk_ramp_pt(lo, hi, dir, 0.0, 1.0, lo.y))
    let b10 = __tk_v(__tk_ramp_pt(lo, hi, dir, 1.0, 0.0, lo.y))
    let b11 = __tk_v(__tk_ramp_pt(lo, hi, dir, 1.0, 1.0, lo.y))
    let t10 = __tk_v(__tk_ramp_pt(lo, hi, dir, 1.0, 0.0, hi.y))
    let t11 = __tk_v(__tk_ramp_pt(lo, hi, dir, 1.0, 1.0, hi.y))
    var fwd = vec3(1.0, 0.0, 0.0)
    var side = vec3(0.0, 0.0, -1.0)
    var run = hi.x - lo.x
    match dir {
        1 => fwd = vec3(-1.0, 0.0, 0.0)
        2 => { fwd = vec3(0.0, 0.0, 1.0); side = vec3(-1.0, 0.0, 0.0); run = hi.z - lo.z }
        3 => { fwd = vec3(0.0, 0.0, -1.0); side = vec3(-1.0, 0.0, 0.0); run = hi.z - lo.z }
        else => {}
    }
    let slope = normalize(fwd * -(hi.y - lo.y) + vec3(0.0, run, 0.0))
    __tk_quad(b00, b01, t10, t11, slope)
    __tk_quad(b10, b11, t10, t11, fwd)
    __tk_quad(b00, b01, b10, b11, vec3(0.0, -1.0, 0.0))
    __tk_tri(b00, b10, t10, side)
    __tk_tri(b01, b11, t11, -side)
    if __tk_level && __tk_solid_on { let _ = tk_add_ramp(lo, hi, dir) }
}

// A cylinder standing on `base` (the middle of its bottom), radius r, height h, with `sides`
// sides (3..32; 8 looks round enough for a toy). A cone when `apex`.
fn __tk_round(base: vec3, r: fixed, h: fixed, sides: s32, apex: bool) {
    let n = clamp(sides, 3, 32)
    let first = __tk_nv
    let slope = if_fixed(apex, r / max(h, 0.01), 0.0)
    for i in 0..n {
        let a = TAU * i / n
        let x = cos(a)
        let z = sin(a)
        let _ = __tk_v(vec3(base.x + x * r, base.y, base.z + z * r))
        if !apex { let _ = __tk_v(vec3(base.x + x * r, base.y + h, base.z + z * r)) }
    }
    let top = __tk_v(vec3(base.x, base.y + h, base.z))      // the apex, or the middle of the top
    var step = 2
    if apex { step = 1 }
    for i in 0..n {
        let j = (i + 1) % n
        let ai = TAU * i / n
        let aj = TAU * j / n
        let ni = normalize(vec3(cos(ai), slope, sin(ai)))
        let nj = normalize(vec3(cos(aj), slope, sin(aj)))
        let mid = normalize(ni + nj)
        if apex {
            __tk_face(first + i, first + j, top, -1, mid, ni, nj, vec3(0.0, 1.0, 0.0), ni)
        } else {
            __tk_face(first + i * 2, first + j * 2, first + i * 2 + 1, first + j * 2 + 1, mid, ni, nj, ni, nj)
        }
    }
    let up = vec3(0.0, 1.0, 0.0)
    let down = vec3(0.0, -1.0, 0.0)
    let was = __tk_smooth
    __tk_smooth = false
    for i in 1..(n - 1) {
        __tk_tri(first, first + i * step, first + (i + 1) * step, down)
        if !apex { __tk_face(first + 1, first + i * 2 + 1, first + (i + 1) * 2 + 1, -1, up, up, up, up, up) }
    }
    __tk_smooth = was
    let _ = top
}

private fn if_fixed(c: bool, a: fixed, b: fixed) -> fixed {
    if c { return a }
    return b
}

// A cylinder standing on `base` (the middle of its bottom). Solid in a level.
fn tk_cylinder(base: vec3, r: fixed, h: fixed, sides: s32) {
    __tk_round(base, r, h, sides, false)
    if __tk_level && __tk_solid_on { let _ = tk_add_cylinder(base, r, h) }
}

// A cone standing on `base`, its point h above. Solid in a level (as a cylinder).
fn tk_cone(base: vec3, r: fixed, h: fixed, sides: s32) {
    __tk_round(base, r, h, sides, true)
    if __tk_level && __tk_solid_on { let _ = tk_add_cylinder(base, r * 0.7, h) }
}

// A ball: `rings` bands from pole to pole (2..8; 3 or 4 is a toy ball), twice as many around.
// Best with tk_smooth(true). Solid in a level (as an upright cylinder around it).
fn tk_sphere(centre: vec3, r: fixed, rings: s32) {
    let nr = clamp(rings, 2, 8)
    let ns = nr * 2
    let first = __tk_nv
    for k in 1..nr {
        let ph = PI * k / nr
        let sp = sin(ph)
        let cp = cos(ph)
        for i in 0..ns {
            let th = TAU * i / ns
            let _ = __tk_v(centre + vec3(sp * cos(th), cp, sp * sin(th)) * r)
        }
    }
    let top = __tk_v(centre + vec3(0.0, r, 0.0))
    let bot = __tk_v(centre - vec3(0.0, r, 0.0))
    let up = vec3(0.0, 1.0, 0.0)
    let down = vec3(0.0, -1.0, 0.0)
    for i in 0..ns {
        let j = (i + 1) % ns
        // corner normals: from the centre (the mesh is a sphere)
        let a0 = first + i
        let b0 = first + j
        let n_a = __tk_unit(a0, centre)
        let n_b = __tk_unit(b0, centre)
        __tk_face(a0, b0, top, -1, normalize(n_a + n_b + up), n_a, n_b, up, up)
        let a1 = first + (nr - 2) * ns + i
        let b1 = first + (nr - 2) * ns + j
        let m_a = __tk_unit(a1, centre)
        let m_b = __tk_unit(b1, centre)
        __tk_face(a1, b1, bot, -1, normalize(m_a + m_b + down), m_a, m_b, down, down)
        for k in 0..(nr - 2) {
            let p0 = first + (k + 1) * ns + i
            let p1 = first + (k + 1) * ns + j
            let p2 = first + k * ns + i
            let p3 = first + k * ns + j
            let q0 = __tk_unit(p0, centre)
            let q1 = __tk_unit(p1, centre)
            let q2 = __tk_unit(p2, centre)
            let q3 = __tk_unit(p3, centre)
            __tk_face(p0, p1, p2, p3, normalize(q0 + q1 + q2 + q3), q0, q1, q2, q3)
        }
    }
    if __tk_level && __tk_solid_on { let _ = tk_add_cylinder(centre - vec3(0.0, r, 0.0), r * 0.8, r * 2) }
}

fn __tk_unit(i: s32, centre: vec3) -> vec3 { return normalize((__tk_verts[i] as vec3) - centre) }

// A flat floor of nx x nz tiles at height lo.y, from (lo.x, lo.z) to (hi.x, hi.z), facing up.
// Each tile shows the whole finish cell, so tiles also set how often a texture repeats. In a
// level it is solid: a slab one unit thick under it.
fn tk_grid(lo: vec3, hi: vec3, nx: s32, nz: s32) { __tk_tiles(lo, hi, nx, nz, __tk_colour) }

// A grid whose tiles alternate between the brush colour and `other`.
fn tk_checker(lo: vec3, hi: vec3, nx: s32, nz: s32, other: u32) { __tk_tiles(lo, hi, nx, nz, other) }

fn __tk_tiles(lo: vec3, hi: vec3, nx: s32, nz: s32, other: u32) {
    let cx = max(nx, 1)
    let cz = max(nz, 1)
    let first = __tk_nv
    for k in 0..(cz + 1) {
        let z = lo.z + (hi.z - lo.z) * k / cz
        for i in 0..(cx + 1) {
            let _ = __tk_v(vec3(lo.x + (hi.x - lo.x) * i / cx, lo.y, z))
        }
    }
    let base = __tk_colour
    let up = vec3(0.0, 1.0, 0.0)
    for k in 0..cz {
        for i in 0..cx {
            if ((i + k) & 1) != 0 { __tk_colour = other & 0xFFFFFF }
            let a = first + k * (cx + 1) + i
            __tk_quad(a, a + 1, a + cx + 1, a + cx + 2, up)
            __tk_colour = base
        }
    }
    if __tk_level && __tk_solid_on {
        let _ = tk_add_box(vec3(lo.x, lo.y - 1.0, lo.z), vec3(hi.x, lo.y, hi.z))
    }
}

// A wall: a vertical grid of nx x ny tiles from corner lo to corner hi, where lo and hi share
// an x (a wall facing along x) or a z (facing along z). `facing` is the way its front faces:
// TK_EAST, TK_WEST, TK_NORTH or TK_SOUTH. Not solid (put a tk_box behind it to stop bodies).
fn tk_wall(lo: vec3, hi: vec3, nx: s32, ny: s32, facing: s32) {
    let cx = max(nx, 1)
    let cy = max(ny, 1)
    let first = __tk_nv
    var n = vec3(1.0, 0.0, 0.0)
    match facing {
        1 => n = vec3(-1.0, 0.0, 0.0)
        2 => n = vec3(0.0, 0.0, 1.0)
        3 => n = vec3(0.0, 0.0, -1.0)
        else => {}
    }
    // across the wall: from the left edge to the right edge as seen from the front
    var a = vec3(lo.x, 0.0, lo.z)
    var b = vec3(hi.x, 0.0, hi.z)
    let s = cross(n, vec3(0.0, 1.0, 0.0))            // the right-hand direction seen from the front
    if dot(b - a, s) < 0.0 {
        a = vec3(hi.x, 0.0, hi.z)
        b = vec3(lo.x, 0.0, lo.z)
    }
    for k in 0..(cy + 1) {
        let y = lo.y + (hi.y - lo.y) * k / cy
        for i in 0..(cx + 1) {
            let p = a + (b - a) * (fixed(i) / cx)
            let _ = __tk_v(vec3(p.x, y, p.z))
        }
    }
    for k in 0..cy {
        for i in 0..cx {
            let q = first + k * (cx + 1) + i
            __tk_quad(q, q + 1, q + cx + 1, q + cx + 2, n)
        }
    }
}
