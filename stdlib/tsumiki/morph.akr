// Tsumiki morphs: meshes whose vertices move. A morph is a copy of a mesh in RAM (in the
// shape bin) that the cart reshapes each frame, either by blending between a few vertex
// poses (blinks, squashes, a mouth that opens) or with a cheap wave (flags, water, jelly).
//
//     var flag: *TkMorph
//     fn init() { flag = tk_new_morph_mesh(FLAG_CLOTH) }           // a mesh: waves only
//     fn update() {
//         tk_morph_wave(flag, vec3(0.0, 0.0, 0.12), vec3(5.0, 0.0, 0.0), frame_angle(tick, 0.15),
//                       vec3(1.0, 0.0, 0.0))                       // pinned at x = 0
//     }
//     fn draw() { mesh_at(flag.mesh, FLAG_POS, 0.0) }
//
// Poses come from tools/tsumiki.py ('morph' and 'pose' in a .toy file) as a TkMorphData:
//
//     face = tk_new_morph(&ZENMAI_FACE)
//     tk_morph_blend(face, ZENMAI_FACE_BASE, ZENMAI_FACE_BLINK, blink)    // 0..1.0
//
// Each call rewrites every vertex from the poses (or the base), so nothing builds up from
// frame to frame; the last call of a frame decides the shape. Lighting stays as it was baked.
// About 12 cycles a vertex for a blend and 70 for a wave (a sine each).

const TK_MAX_MORPHS = 16

struct TkMorphData {
    mesh: *Mesh              // the base mesh (pose 0 is its own vertices)
    poses: *vec4             // count x nverts vertices (w = 1.0), pose by pose
    count: s32
}

struct TkMorph {
    mesh: *Mesh              // the reshaped copy: draw this one
    poses: *vec4             // the poses (pose 0 the base)
    count: s32
    nverts: s32
}

var __tk_morphs: [16]TkMorph
var __tk_nmorphs: s32

fn __tk_new_morph(base: *Mesh, poses: *vec4, count: s32) -> *TkMorph {
    if __tk_nmorphs >= TK_MAX_MORPHS {
        println("tsumiki: more than 16 morphs")
        return null
    }
    if __tk_mesh != null {
        println("tsumiki: make morphs outside tk_shape_begin() .. tk_shape_end()")
        return null
    }
    let bytes = (base.faces + (base.nfaces as u32) * sizeof(Face)) as s32
    let copy = __tk_alloc(bytes)
    if copy == null { return null }
    memcpy(copy, base as *u8, bytes as u32)
    let m = &__tk_morphs[__tk_nmorphs]
    __tk_nmorphs += 1
    m.mesh = copy as *Mesh
    m.nverts = base.nverts as s32
    m.count = count
    m.poses = poses
    if poses == null {
        // the base pose is the copy's own vertices as they were made
        let keep = __tk_alloc(m.nverts * 16)
        if keep == null { return null }
        memcpy(keep, copy + base.verts, (m.nverts * 16) as u32)
        m.poses = keep as *vec4
        m.count = 1
    }
    return m
}

// A morph with the poses made by tools/tsumiki.py (pose 0 is the base).
fn tk_new_morph(data: *TkMorphData) -> *TkMorph { return __tk_new_morph(data.mesh, data.poses, data.count) }

// A morph of any mesh (one built with shapes, say), with only its own shape as pose 0: for
// tk_morph_wave().
fn tk_new_morph_mesh(base: *Mesh) -> *TkMorph { return __tk_new_morph(base, null, 1) }

fn __tk_morph_verts(m: *TkMorph) -> *vec4 { return (m.mesh as *u8 + m.mesh.verts) as *vec4 }

// Shapes the morph between pose a and pose b: t = 0 is a, 1.0 is b (values outside 0..1
// overshoot, for a springy squash).
fn tk_morph_blend(m: *TkMorph, a: s32, b: s32, t: fixed) {
    let n = m.nverts
    let dst = __tk_morph_verts(m)
    let pa = m.poses + clamp(a, 0, m.count - 1) * n
    let pb = m.poses + clamp(b, 0, m.count - 1) * n
    for i in 0..n {
        let va = pa[i]
        dst[i] = va + (pb[i] - va) * t
    }
}

// Shows one pose as it is.
fn tk_morph_pose(m: *TkMorph, p: s32) { tk_morph_blend(m, p, p, 0.0) }

// A wave through the base pose: each vertex p moves by amount * sin(dot(p, freq) + phase),
// times clamp(dot(p, pin), 0, 1) when pin is not zero (a flag pinned to its pole at x = 0
// and free at x = 1: pin = vec3(1.0, 0.0, 0.0)). freq is radians per unit along each axis.
fn tk_morph_wave(m: *TkMorph, amount: vec3, freq: vec3, phase: fixed, pin: vec3) {
    let n = m.nverts
    let dst = __tk_morph_verts(m)
    let base = m.poses
    let pinned = pin.x != 0.0 || pin.y != 0.0 || pin.z != 0.0
    for i in 0..n {
        let p = base[i]
        let v = p as vec3
        var k = sin(dot(v, freq) + phase)
        if pinned { k = k * clamp(dot(v, pin), 0.0, 1.0) }
        dst[i] = p + vec4(amount * k, 0.0)
    }
}
