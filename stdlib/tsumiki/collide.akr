// Tsumiki collision: shape tests, and the solids of the level with ray and overlap queries.
//
// The level is made of solids: blocks (axis-aligned boxes), ramps (wedges rising along an
// axis), upright cylinders, and at most one terrain (a heightfield floor). Blocks and ramps
// are what a toy room is built from, they are exact and cheap in fixed point (a few compares
// per solid), and slopes come from ramps and terrain. Arbitrary triangle soup is left out on
// purpose: in 16.16 fixed point its plane tests need wide products and divisions per
// triangle, thin triangles lose precision, and it needs a spatial index to be affordable.
//
// Everything is fixed point and deterministic: the same inputs always give the same answer.
// Vectors longer than about 180 units overflow a dot product, so keep levels within +-90.

const TK_SOLID_BOX = 0
const TK_SOLID_RAMP = 1
const TK_SOLID_CYLINDER = 2

const TK_MAX_SOLIDS = 256
const TK_NO_FLOOR: fixed = -1000.0         // tk_floor_at() where there is nothing below

struct TkSolid {
    lo: vec3                 // the bounds (a cylinder's box around it)
    hi: vec3
    kind: u8                 // TK_SOLID_BOX, TK_SOLID_RAMP or TK_SOLID_CYLINDER
    dir: u8                  // a ramp's rising direction (TK_EAST ...)
    on: bool                 // false: ignored by every query and body
    platform: s8             // the platform that carries it (scene.akr), or -1
}

// What a ray hit.
struct TkHit {
    pos: vec3                // where
    normal: vec3             // the surface's outward normal there
    t: fixed                 // how far along the ray: 0 at its start .. 1.0 at its end
    solid: s32               // the solid, or -1 for the terrain
}

// A heightfield floor: nx x nz cells of `cell` units from `origin`, with (nx + 1) x (nz + 1)
// heights (row by row along x, rows going +z), added to origin.y.
struct TkTerrain {
    origin: vec3
    cell: fixed
    nx: s32
    nz: s32
    heights: *fixed
    on: bool
}

var __tk_solids: [256]TkSolid
var __tk_nsolids: s32
var __tk_terrain: TkTerrain

// ---- adding solids (shapes in a level add their own; these are for invisible ones)

fn __tk_add(lo: vec3, hi: vec3, kind: s32, dir: s32) -> s32 {
    if __tk_nsolids >= TK_MAX_SOLIDS {
        println("tsumiki: more than 256 solids")
        return -1
    }
    let i = __tk_nsolids
    __tk_nsolids += 1
    let s = &__tk_solids[i]
    s.lo = vec3(min(lo.x, hi.x), min(lo.y, hi.y), min(lo.z, hi.z))
    s.hi = vec3(max(lo.x, hi.x), max(lo.y, hi.y), max(lo.z, hi.z))
    s.kind = kind as u8
    s.dir = dir as u8
    s.on = true
    s.platform = -1
    return i
}

// An invisible block from lo to hi. Returns its number (for tk_solid_on), or -1 when full.
fn tk_add_box(lo: vec3, hi: vec3) -> s32 { return __tk_add(lo, hi, TK_SOLID_BOX, 0) }

// An invisible wedge in lo..hi rising toward dir (as tk_ramp()).
fn tk_add_ramp(lo: vec3, hi: vec3, dir: s32) -> s32 { return __tk_add(lo, hi, TK_SOLID_RAMP, dir) }

// An invisible upright cylinder standing on base.
fn tk_add_cylinder(base: vec3, r: fixed, h: fixed) -> s32 {
    return __tk_add(vec3(base.x - r, base.y, base.z - r), vec3(base.x + r, base.y + h, base.z + r), TK_SOLID_CYLINDER, 0)
}

// Turns a solid on or off (a door that opens, a bridge that appears).
fn tk_solid_on(i: s32, on: bool) {
    if i >= 0 && i < __tk_nsolids { __tk_solids[i].on = on }
}

// The terrain (one per toy box): shapes.akr's tk_terrain() sets it and draws it.
fn tk_terrain_set(origin: vec3, cell: fixed, nx: s32, nz: s32, heights: *fixed) {
    __tk_terrain = TkTerrain { origin: origin, cell: cell, nx: nx, nz: nz, heights: heights, on: true }
}

// ---- surfaces

// How far along its rise point (x, z) is on ramp s: 0 at the low end, 1.0 at the high end,
// and beyond them outside the ramp (the slope's plane goes on).
fn __tk_rise_raw(s: *TkSolid, x: fixed, z: fixed) -> fixed {
    match s.dir as s32 {
        0 => return (x - s.lo.x) / max(s.hi.x - s.lo.x, 0.01)
        1 => return (s.hi.x - x) / max(s.hi.x - s.lo.x, 0.01)
        2 => return (z - s.lo.z) / max(s.hi.z - s.lo.z, 0.01)
        else => return (s.hi.z - z) / max(s.hi.z - s.lo.z, 0.01)
    }
}

// The same, clamped to the ramp: 0..1.0.
fn __tk_rise(s: *TkSolid, x: fixed, z: fixed) -> fixed { return clamp(__tk_rise_raw(s, x, z), 0.0, 1.0) }

// The height of solid i's top at (x, z) (a ramp's slope there; its clamped edge outside it).
fn tk_solid_top(i: s32, x: fixed, z: fixed) -> fixed { return __tk_top(&__tk_solids[i], x, z) }

// The outward normal of a ramp's slope.
fn __tk_ramp_normal(s: *TkSolid) -> vec3 {
    let h = s.hi.y - s.lo.y
    match s.dir as s32 {
        0 => return normalize(vec3(-h, s.hi.x - s.lo.x, 0.0))
        1 => return normalize(vec3(h, s.hi.x - s.lo.x, 0.0))
        2 => return normalize(vec3(0.0, s.hi.z - s.lo.z, -h))
        else => return normalize(vec3(0.0, s.hi.z - s.lo.z, h))
    }
}

// Does solid s's footprint hold (x, z), widened by `grow`?
fn __tk_holds(s: *TkSolid, x: fixed, z: fixed, grow: fixed) -> bool {
    if s.kind == TK_SOLID_CYLINDER {
        let r = (s.hi.x - s.lo.x) / 2 + grow
        let dx = x - (s.lo.x + s.hi.x) / 2
        let dz = z - (s.lo.z + s.hi.z) / 2
        if abs(dx) > r || abs(dz) > r { return false }
        return dx * dx + dz * dz <= r * r
    }
    return x >= s.lo.x - grow && x <= s.hi.x + grow && z >= s.lo.z - grow && z <= s.hi.z + grow
}

// The terrain's height at (x, z) (bilinear between its corners), or TK_NO_FLOOR off it.
fn tk_terrain_height(x: fixed, z: fixed) -> fixed {
    let t = &__tk_terrain
    if !t.on { return TK_NO_FLOOR }
    let fx = (x - t.origin.x) / t.cell
    let fz = (z - t.origin.z) / t.cell
    if fx < 0.0 || fz < 0.0 || fx >= fixed(t.nx) || fz >= fixed(t.nz) { return TK_NO_FLOOR }
    let i = fx as s32
    let k = fz as s32
    let u = fx - fixed(i)
    let v = fz - fixed(k)
    let row = t.nx + 1
    let h00 = t.heights[k * row + i]
    let h10 = t.heights[k * row + i + 1]
    let h01 = t.heights[(k + 1) * row + i]
    let h11 = t.heights[(k + 1) * row + i + 1]
    let a = h00 + (h10 - h00) * u
    let b = h01 + (h11 - h01) * u
    return t.origin.y + a + (b - a) * v
}

// The highest floor under (x, z) whose top is at most `below` (a body's feet plus how high
// it can step), searching footprints widened by `grip`. *which gets the solid (-1 for the
// terrain or nothing). TK_NO_FLOOR when there is none.
fn __tk_floor(x: fixed, z: fixed, below: fixed, grip: fixed, which: *s32) -> fixed {
    var best = tk_terrain_height(x, z)
    if best > below { best = TK_NO_FLOOR }
    *which = -1
    for i in 0..__tk_nsolids {
        let s = &__tk_solids[i]
        if !s.on || s.lo.y > below || s.hi.y <= best { continue }
        if !__tk_holds(s, x, z, grip) { continue }
        let top = __tk_top(s, x, z)
        if top <= below && top > best {
            best = top
            *which = i
        }
    }
    return best
}

// The highest floor at (x, z) no higher than `below`: block and cylinder tops, ramp slopes
// and the terrain. TK_NO_FLOOR when there is none. (Shadows use it to find the ground.)
fn tk_floor_at(x: fixed, z: fixed, below: fixed) -> fixed {
    var which = 0
    return __tk_floor(x, z, below, 0.0, &which)
}

// ---- shape tests (no solids involved)

// The point of the box lo..hi nearest to p.
fn tk_closest_in_box(lo: vec3, hi: vec3, p: vec3) -> vec3 {
    return vec3(clamp(p.x, lo.x, hi.x), clamp(p.y, lo.y, hi.y), clamp(p.z, lo.z, hi.z))
}

// The point of the segment a..b nearest to p.
fn tk_closest_on_segment(a: vec3, b: vec3, p: vec3) -> vec3 {
    let d = b - a
    let dd = dot(d, d)
    if dd < 0.0001 { return a }
    let t = clamp(dot(p - a, d) / dd, 0.0, 1.0)
    return a + d * t
}

fn tk_sphere_sphere(a: vec3, ra: fixed, b: vec3, rb: fixed) -> bool {
    let d = b - a
    let r = ra + rb
    return dot(d, d) < r * r
}

fn tk_sphere_box(c: vec3, r: fixed, lo: vec3, hi: vec3) -> bool {
    let d = c - tk_closest_in_box(lo, hi, c)
    return dot(d, d) < r * r
}

fn tk_box_box(alo: vec3, ahi: vec3, blo: vec3, bhi: vec3) -> bool {
    return alo.x < bhi.x && ahi.x > blo.x && alo.y < bhi.y && ahi.y > blo.y && alo.z < bhi.z && ahi.z > blo.z
}

// A capsule is the segment a..b grown by r (a body standing at p is p + (0, r, 0) to
// p + (0, height - r, 0), radius r).
fn tk_capsule_sphere(a: vec3, b: vec3, r: fixed, c: vec3, rc: fixed) -> bool {
    return tk_sphere_sphere(tk_closest_on_segment(a, b, c), r, c, rc)
}

// Capsule and box: the nearest points are found by going back and forth between the segment
// and the box twice, which settles to within a few hundredths at the box's edges.
fn tk_capsule_box(a: vec3, b: vec3, r: fixed, lo: vec3, hi: vec3) -> bool {
    var p = tk_closest_on_segment(a, b, (lo + hi) * 0.5)
    var q = tk_closest_in_box(lo, hi, p)
    p = tk_closest_on_segment(a, b, q)
    q = tk_closest_in_box(lo, hi, p)
    p = tk_closest_on_segment(a, b, q)
    let d = p - tk_closest_in_box(lo, hi, p)
    return dot(d, d) < r * r
}

fn tk_capsule_capsule(a0: vec3, a1: vec3, ra: fixed, b0: vec3, b1: vec3, rb: fixed) -> bool {
    // the nearest points of two segments (Ericson, "Real-Time Collision Detection" 5.1.9)
    let d1 = a1 - a0
    let d2 = b1 - b0
    let r = a0 - b0
    let aa = dot(d1, d1)
    let ee = dot(d2, d2)
    let f = dot(d2, r)
    var s: fixed = 0.0
    var t: fixed = 0.0
    if aa < 0.0001 && ee < 0.0001 {
        return tk_sphere_sphere(a0, ra, b0, rb)
    }
    if aa < 0.0001 {
        t = clamp(f / ee, 0.0, 1.0)
    } else {
        let c = dot(d1, r)
        if ee < 0.0001 {
            s = clamp(-c / aa, 0.0, 1.0)
        } else {
            let bb = dot(d1, d2)
            let den = aa * ee - bb * bb
            if den > 0.0001 { s = clamp((bb * f - c * ee) / den, 0.0, 1.0) }
            t = (bb * s + f) / ee
            if t < 0.0 {
                t = 0.0
                s = clamp(-c / aa, 0.0, 1.0)
            } else if t > 1.0 {
                t = 1.0
                s = clamp((bb - c) / aa, 0.0, 1.0)
            }
        }
    }
    return tk_sphere_sphere(a0 + d1 * s, ra, b0 + d2 * t, rb)
}

// Where the ray from `from` to `to` first enters the box lo..hi: 0..1.0 along it, or -1.0
// when it misses (0 when it starts inside). *normal gets the face it enters through.
fn __tk_ray_box(from: vec3, to: vec3, lo: vec3, hi: vec3, normal: *vec3) -> fixed {
    var t0: fixed = 0.0
    var t1: fixed = 1.0
    var n = vec3(0.0, 0.0, 0.0)
    let d = to - from
    for axis in 0..3 {
        var o = from.x
        var dd = d.x
        var l = lo.x
        var h = hi.x
        if axis == 1 { o = from.y; dd = d.y; l = lo.y; h = hi.y }
        if axis == 2 { o = from.z; dd = d.z; l = lo.z; h = hi.z }
        if abs(dd) < 0.002 {
            if o < l || o > h { return -1.0 }
            continue
        }
        var ta = (l - o) / dd
        var tb = (h - o) / dd
        var side: fixed = -1.0           // entering through the low face
        if ta > tb {
            let x = ta
            ta = tb
            tb = x
            side = 1.0
        }
        if ta > t0 {
            t0 = ta
            n = vec3(0.0, 0.0, 0.0)
            if axis == 0 { n.x = side }
            if axis == 1 { n.y = side }
            if axis == 2 { n.z = side }
        }
        t1 = min(t1, tb)
        if t0 > t1 { return -1.0 }
    }
    *normal = n
    return t0
}

// Where the ray from `from` to `to` first enters the box lo..hi: 0..1.0, or -1.0 for a miss.
fn tk_ray_box(from: vec3, to: vec3, lo: vec3, hi: vec3) -> fixed {
    var n: vec3
    return __tk_ray_box(from, to, lo, hi, &n)
}

// Where the ray from `from` to `to` first enters the ball at c of radius r: 0..1.0, or -1.0.
fn tk_ray_sphere(from: vec3, to: vec3, c: vec3, r: fixed) -> fixed {
    let d = to - from
    let len = length(d)
    if len < 0.001 {
        if tk_sphere_sphere(from, 0.0, c, r) { return 0.0 }
        return -1.0
    }
    let u = d / len
    let m = from - c
    let b = dot(m, u)
    let cc = dot(m, m) - r * r
    if cc <= 0.0 { return 0.0 }                       // starts inside
    if b > 0.0 { return -1.0 }                         // pointing away
    let disc = b * b - cc
    if disc < 0.0 { return -1.0 }
    let s = -b - sqrt(disc)
    if s > len { return -1.0 }
    return max(s, 0.0) / len
}

// The ray against one solid: 0..1.0 or -1.0, and the normal of what it hit.
fn __tk_ray_solid(s: *TkSolid, from: vec3, to: vec3, normal: *vec3) -> fixed {
    var n: vec3
    var t = __tk_ray_box(from, to, s.lo, s.hi, &n)
    if t < 0.0 { return -1.0 }
    if s.kind == TK_SOLID_RAMP {
        // the wedge is the box below the slope's plane: g <= 0, with g linear along the ray
        let h = s.hi.y - s.lo.y
        let pt = from + (to - from) * t
        let gt = pt.y - s.lo.y - h * __tk_rise_raw(s, pt.x, pt.z)
        if gt > 0.001 {
            // it enters the box above the slope: where does it cross the slope's plane?
            let g0 = from.y - s.lo.y - h * __tk_rise_raw(s, from.x, from.z)
            let g1 = to.y - s.lo.y - h * __tk_rise_raw(s, to.x, to.z)
            if g1 >= g0 || g1 > 0.0 { return -1.0 }
            let tc = g0 / (g0 - g1)
            if tc < t || tc > 1.0 { return -1.0 }
            let pc = from + (to - from) * tc
            if pc.x < s.lo.x - 0.01 || pc.x > s.hi.x + 0.01 || pc.z < s.lo.z - 0.01 || pc.z > s.hi.z + 0.01 { return -1.0 }
            t = tc
            n = __tk_ramp_normal(s)
        }
    } else if s.kind == TK_SOLID_CYLINDER {
        let r = (s.hi.x - s.lo.x) / 2
        let c = vec3((s.lo.x + s.hi.x) / 2, 0.0, (s.lo.z + s.hi.z) / 2)
        let a = vec3(from.x, 0.0, from.z)
        let b = vec3(to.x, 0.0, to.z)
        let pt = from + (to - from) * t
        let off = vec3(pt.x, 0.0, pt.z) - c
        if dot(off, off) > r * r + 0.005 {
            // entered the box beside the cylinder: find where it meets the round side
            let tc = tk_ray_sphere(a, b, c, r)       // in the xz plane a circle is a sphere's slice
            if tc < 0.0 { return -1.0 }
            let pc = from + (to - from) * tc
            if pc.y < s.lo.y || pc.y > s.hi.y { return -1.0 }
            t = tc
            n = normalize(vec3(pc.x, 0.0, pc.z) - c)
        }
    }
    *normal = n
    return t
}

fn __tk_top(s: *TkSolid, x: fixed, z: fixed) -> fixed {
    if s.kind == TK_SOLID_RAMP { return s.lo.y + (s.hi.y - s.lo.y) * __tk_rise(s, x, z) }
    return s.hi.y
}

// Casts a ray from `from` to `to` through the level (solids that are on, and the terrain).
// Returns true when it hits something, with the nearest hit in *hit. About 40 cycles a solid
// it passes far from and 300-600 for one near it.
fn tk_raycast(from: vec3, to: vec3, hit: *TkHit) -> bool {
    var best: fixed = 2.0
    var bn = vec3(0.0, 0.0, 0.0)
    var bs = -1
    let lo = vec3(min(from.x, to.x), min(from.y, to.y), min(from.z, to.z))
    let hi = vec3(max(from.x, to.x), max(from.y, to.y), max(from.z, to.z))
    for i in 0..__tk_nsolids {
        let s = &__tk_solids[i]
        if !s.on { continue }
        if s.lo.x > hi.x || s.hi.x < lo.x || s.lo.y > hi.y || s.hi.y < lo.y || s.lo.z > hi.z || s.hi.z < lo.z { continue }
        var n: vec3
        let t = __tk_ray_solid(s, from, to, &n)
        if t >= 0.0 && t < best {
            best = t
            bn = n
            bs = i
        }
    }
    if __tk_terrain.on {
        // march along the ray in steps of about a quarter cell; between the last step above
        // the ground and the first below it, the crossing is interpolated
        let d = to - from
        let steps = clamp((length(d) * 4 / __tk_terrain.cell) as s32 + 1, 1, 64)
        var t0: fixed = 0.0
        var g0: fixed = 1.0
        for k in 0..(steps + 1) {
            let t = fixed(k) / steps
            if t >= best { break }
            let p = from + d * t
            let h = tk_terrain_height(p.x, p.z)
            if h == TK_NO_FLOOR {
                g0 = 1.0
                t0 = t
                continue
            }
            let g = p.y - h
            if g <= 0.0 {
                var tc = t
                if k > 0 && g0 > 0.0 { tc = t0 + (t - t0) * (g0 / (g0 - g)) }
                if tc < best {
                    best = tc
                    bn = vec3(0.0, 1.0, 0.0)
                    bs = -1
                }
                break
            }
            t0 = t
            g0 = g
        }
    }
    if best > 1.0 { return false }
    hit.t = best
    hit.pos = from + (to - from) * best
    hit.normal = bn
    hit.solid = bs
    return true
}

// The first solid (that is on) overlapping the ball at c of radius r, or -1. Ramps count
// what is under their slope; the terrain is not checked (use tk_floor_at).
fn tk_overlap_sphere(c: vec3, r: fixed) -> s32 {
    for i in 0..__tk_nsolids {
        let s = &__tk_solids[i]
        if !s.on { continue }
        if !tk_sphere_box(c, r, s.lo, s.hi) { continue }
        if s.kind == TK_SOLID_BOX { return i }
        if s.kind == TK_SOLID_CYLINDER {
            let rr = (s.hi.x - s.lo.x) / 2 + r
            let dx = c.x - (s.lo.x + s.hi.x) / 2
            let dz = c.z - (s.lo.z + s.hi.z) / 2
            if dx * dx + dz * dz < rr * rr { return i }
            continue
        }
        // a ramp: the nearest point of its box, brought down onto the slope
        var q = tk_closest_in_box(s.lo, s.hi, c)
        q.y = min(q.y, __tk_top(s, q.x, q.z))
        if tk_sphere_sphere(c, r, q, 0.0) { return i }
    }
    return -1
}

// The first solid (that is on) overlapping the box lo..hi, or -1 (ramps and cylinders as
// their boxes).
fn tk_overlap_box(lo: vec3, hi: vec3) -> s32 {
    for i in 0..__tk_nsolids {
        let s = &__tk_solids[i]
        if s.on && tk_box_box(lo, hi, s.lo, s.hi) { return i }
    }
    return -1
}
