// The toy box: Tsumiki's scene glue. It keeps the level, the bodies, platforms, zones, props,
// particles and the camera, steps them all in tk_update() and draws them all in tk_draw().
//
//     fn init() {
//         tk_open(TK_SKY)                       // empty the toy box (and set the sky colour)
//         tk_ground_begin()                     // the floor: drawn first, under everything
//         tk_paint(TK_BEECH, TK_PLANKS)
//         tk_grid(vec3(-8.0, 0.0, -8.0), vec3(8.0, 0.0, 8.0), 8, 8)
//         tk_ground_end()
//         tk_level_begin()                      // blocks: drawn sorted, and solid
//         tk_paint(TK_RED, TK_WOOD)
//         tk_box(vec3(1.0, 0.0, 1.0), vec3(2.0, 1.0, 2.0))
//         tk_level_end()
//         hero = tk_new_body(vec3(0.0, 0.0, 0.0))
//         hero.mesh = HERO_MESH
//         tk_cam_follow(hero, 0)
//     }
//     fn update() { tk_drive_pad(hero); tk_update() }
//     fn draw() { tk_draw() }
//
// Each frame: the cart drives its bodies (tk_drive, tk_drive_pad) and picks clips, then
// tk_update() moves platforms, bodies (and their clips), zones, animations, particles and
// the camera, in that order. tk_draw() clears to the sky, points the camera, draws the ground
// (flushed at once, so nothing sorts under it), the level, platforms, props, bodies, their
// blob shadows and the particles. Call it first in draw(); draw your own things after it.

const TK_MAX_PIECES = 32
const TK_MAX_PLATFORMS = 8
const TK_MAX_ZONES = 16
const TK_MAX_PROPS = 32

// A piece of the level: a mesh drawn every frame.
struct TkPiece {
    mesh: *Mesh
    centre: vec3                 // the middle of its bounds and their radius, for culling
    radius: fixed
    ground: bool                 // drawn first and flushed (floors, rugs)
    shown: bool
}

// A moving platform: a mesh with a block collider that carries what stands on it.
struct TkPlatform {
    pos: vec3                    // where it is (its mesh's origin)
    delta: vec3                  // how far it moved in the last step
    mesh: *Mesh
    solid: s32                   // its collider
    lo: vec3                     // the collider around pos
    hi: vec3
    a: vec3                      // tk_platform_path: from a to b and back ...
    b: vec3
    frames: s32                  // ... taking this many frames each way
    pause: s32 = 30              // and resting this many at each end
    moving: bool                 // false: it stays where it is put (tk_platform_move)
    __t: s32
    __next: vec3                 // tk_platform_move's spot for the next step
    __set: bool
}

// A zone: a box that notices bodies coming in and going out.
struct TkZone {
    lo: vec3
    hi: vec3
    on: bool = true
    __in: u32                    // bit n: body n is inside
    __entered: u32               // ... came in at the last step
    __left: u32                  // ... went out at the last step
}

// A prop: a mesh or an animation placed in the toy box, turning and bobbing if asked.
struct TkProp {
    pos: vec3
    yaw: fixed
    scale: fixed = 1.0
    spin: fixed                  // radians a frame
    bob: fixed                   // how far it bobs up and down
    bob_speed: fixed = 0.06      // radians a frame
    mesh: *Mesh                  // drawn when there is no `anim`
    anim: *TkAnim
    shadow: fixed                // blob shadow radius (0: none)
    shown: bool = true
    __t: fixed
}

var __tk_pieces: [32]TkPiece
var __tk_npieces: s32
var __tk_platforms: [8]TkPlatform
var __tk_nplatforms: s32
var __tk_zones: [16]TkZone
var __tk_nzones: s32
var __tk_props: [32]TkProp
var __tk_nprops: s32
var __tk_sky: u32
var __tk_clear: bool
var __tk_fog_on: bool
var __tk_fog_col: u32
var __tk_fog_near: fixed
var __tk_fog_far: fixed
var __tk_tick: s32

// A one-quad mesh in RAM for blob shadows (rewritten for each).
struct __TkQuad { hdr: Mesh, v: [4]vec4, f: Face }
var __tk_shq: __TkQuad

// Empties the toy box and sets it up: the built-in textures, the camera range (near 0.1, far
// 64), the light, every pool. `sky` is the colour the screen clears to (tk_no_sky() for none).
fn tk_open(sky: u32) {
    __tk_bin_used = 0
    __tk_mesh = null
    __tk_nsolids = 0
    __tk_terrain.on = false
    __tk_npieces = 0
    __tk_nbodies = 0
    __tk_nanims = 0
    __tk_nmorphs = 0
    __tk_nplatforms = 0
    __tk_nzones = 0
    __tk_nprops = 0
    __tk_nemitters = 0
    for i in 0..TK_MAX_PARTICLES { __tk_parts[i].life = 0 }
    __tk_palive = 0
    __tk_pnext = 0
    __tk_pcap = 160
    __tk_styles_init()
    __tk_sky = sky
    __tk_clear = true
    __tk_fog_on = false
    __tk_tick = 0
    __tk_light = vec3(-0.399, 0.8479, -0.3491)
    __tk_ambient = 0.45
    tk_cam = TkCam {}
    tk_cam.__seed = 0x7A3B1C5D
    __tk_atlas_load()
    camera_clip(0.1, 64.0)
    // the shadow quad: four corners, one textured semi-transparent face
    __tk_shq.hdr.nverts = 4
    __tk_shq.hdr.nfaces = 1
    __tk_shq.hdr.verts = 16
    __tk_shq.hdr.faces = 80
    let f = &__tk_shq.f
    f.flags = (FACE_QUAD | FACE_TEXTURED | FACE_SEMI | FACE_DOUBLE) as u8
    f.blend = BLEND_SUB as u8
    f.tex = (15 | 16) as u8
    f.palette = 254
    for k in 0..4 { f.idx[k] = k as u16 }
    let u0 = tk_cell_u(TK_DOT)
    let v0 = tk_cell_v(TK_DOT)
    f.uv[0] = (u0 | ((v0 + 31) << 8)) as u16
    f.uv[1] = ((u0 + 31) | ((v0 + 31) << 8)) as u16
    f.uv[2] = (u0 | (v0 << 8)) as u16
    f.uv[3] = ((u0 + 31) | (v0 << 8)) as u16
}

// The screen is not cleared (a cart that draws its own sky or uses the plane chip).
fn tk_no_sky() { __tk_clear = false }

// Fog over everything the toy box draws: toward `colour` between view depths near and far.
fn tk_fog(colour: u32, near: fixed, far: fixed) {
    __tk_fog_on = true
    __tk_fog_col = colour
    __tk_fog_near = near
    __tk_fog_far = far
}

// ---- the level

// Starts a piece of the level: the shapes until tk_level_end() are drawn every frame and are
// solid (tk_solid(false) for ones to walk through).
fn tk_level_begin() {
    tk_shape_begin()
    __tk_level = true
}

// Ends the piece; returns its mesh (already added to the toy box).
fn tk_level_end() -> *Mesh { return __tk_piece_end(false) }

// Starts a piece of the ground: like a level piece, but drawn before everything else, so
// nothing standing on it can sort under it. Floors, rugs, roads; ground pieces draw in the
// order they were made (a rug after the floor it lies on).
fn tk_ground_begin() { tk_level_begin() }
fn tk_ground_end() -> *Mesh { return __tk_piece_end(true) }

fn __tk_piece_end(ground: bool) -> *Mesh {
    let lo = __tk_lo
    let hi = __tk_hi
    let m = tk_shape_end()
    __tk_level = false
    if m == null { return null }
    tk_add_piece(m, ground)
    __tk_pieces[__tk_npieces - 1].centre = (lo + hi) * 0.5
    __tk_pieces[__tk_npieces - 1].radius = length((hi - lo) * 0.5) + 0.1
    return m
}

// Adds a mesh to the level (one built by tools/tsumiki.py, say): drawn every frame (first,
// if `ground`). Not solid: add tk_add_box() colliders for it.
fn tk_add_piece(m: *Mesh, ground: bool) {
    if __tk_npieces >= TK_MAX_PIECES {
        println("tsumiki: more than 32 level pieces")
        return
    }
    let p = &__tk_pieces[__tk_npieces]
    __tk_npieces += 1
    *p = TkPiece { mesh: m, centre: vec3(0.0, 0.0, 0.0), radius: 0.0, ground: ground, shown: true }
}

// ---- platforms

// A moving platform drawing `mesh` at pos, solid over lo..hi around pos (the mesh's own
// bounds, usually). It stays put until tk_platform_path() or tk_platform_move().
fn tk_new_platform(mesh: *Mesh, pos: vec3, lo: vec3, hi: vec3) -> *TkPlatform {
    if __tk_nplatforms >= TK_MAX_PLATFORMS {
        println("tsumiki: more than 8 platforms")
        return null
    }
    let i = __tk_nplatforms
    let p = &__tk_platforms[i]
    __tk_nplatforms += 1
    *p = TkPlatform { pos: pos, mesh: mesh, lo: lo, hi: hi, a: pos, b: pos }
    p.solid = tk_add_box(pos + lo, pos + hi)
    if p.solid >= 0 { __tk_solids[p.solid].platform = i as s8 }
    return p
}

// Sends the platform from a to b and back, `frames` frames each way (easing in and out),
// resting `pause` frames at each end.
fn tk_platform_path(p: *TkPlatform, a: vec3, b: vec3, frames: s32) {
    p.a = a
    p.b = b
    p.frames = max(frames, 1)
    p.moving = true
    p.__t = 0
}

// Moves the platform to pos in the next step (carrying what stands on it); stops its path.
fn tk_platform_move(p: *TkPlatform, pos: vec3) {
    p.moving = false
    p.__next = pos
    p.__set = true
}

fn __tk_platforms_step() {
    for i in 0..__tk_nplatforms {
        let p = &__tk_platforms[i]
        var to = p.pos
        if p.moving {
            let cycle = (p.frames + p.pause) * 2
            p.__t = (p.__t + 1) % cycle
            var k: fixed = 0.0
            let t = p.__t
            if t < p.frames {
                k = tk_ease(fixed(t) / p.frames)
            } else if t < p.frames + p.pause {
                k = 1.0
            } else if t < p.frames * 2 + p.pause {
                k = 1.0 - tk_ease(fixed(t - p.frames - p.pause) / p.frames)
            }
            to = p.a + (p.b - p.a) * k
        } else if p.__set {
            to = p.__next
            p.__set = false
        }
        p.delta = to - p.pos
        p.pos = to
        if p.solid >= 0 {
            __tk_solids[p.solid].lo = to + p.lo
            __tk_solids[p.solid].hi = to + p.hi
        }
    }
}

// ---- zones

// A zone over the box lo..hi; null when all 16 are in use.
fn tk_new_zone(lo: vec3, hi: vec3) -> *TkZone {
    if __tk_nzones >= TK_MAX_ZONES {
        println("tsumiki: more than 16 zones")
        return null
    }
    let z = &__tk_zones[__tk_nzones]
    __tk_nzones += 1
    *z = TkZone { lo: lo, hi: hi }
    return z
}

// Did a body come into the zone in the last step?
fn tk_zone_entered(z: *TkZone) -> bool { return z.__entered != 0 }

// Did a body leave it in the last step?
fn tk_zone_left(z: *TkZone) -> bool { return z.__left != 0 }

// Is body b in it?
fn tk_zone_has(z: *TkZone, b: *TkBody) -> bool {
    let n = (b - &__tk_bodies[0]) as s32
    if n < 0 || n >= TK_MAX_BODIES { return false }
    return ((z.__in >> n as u32) & 1) != 0
}

// How many bodies are in it.
fn tk_zone_count(z: *TkZone) -> s32 {
    var n = 0
    var m = z.__in
    while m != 0 {
        n += (m & 1) as s32
        m >>= 1
    }
    return n
}

fn __tk_zones_step() {
    for i in 0..__tk_nzones {
        let z = &__tk_zones[i]
        var now: u32 = 0
        if z.on {
            for k in 0..__tk_nbodies {
                let b = &__tk_bodies[k]
                let blo = b.pos - vec3(b.radius, 0.0, b.radius)
                let bhi = b.pos + vec3(b.radius, b.height, b.radius)
                if tk_box_box(blo, bhi, z.lo, z.hi) { now |= (1 as u32) << k as u32 }
            }
        }
        z.__entered = now & ~z.__in
        z.__left = z.__in & ~now
        z.__in = now
    }
}

// ---- props

// A prop showing `mesh` at pos (set its `anim` to show an animation instead); null when all
// 32 are in use.
fn tk_new_prop(mesh: *Mesh, pos: vec3) -> *TkProp {
    if __tk_nprops >= TK_MAX_PROPS {
        println("tsumiki: more than 32 props")
        return null
    }
    let p = &__tk_props[__tk_nprops]
    __tk_nprops += 1
    *p = TkProp { mesh: mesh, pos: pos }
    return p
}

// Where the prop is drawn this frame (with its bob).
fn tk_prop_spot(p: *TkProp) -> vec3 { return p.pos + vec3(0.0, sin(p.__t * p.bob_speed) * p.bob, 0.0) }

// ---- input for a player

// The pad that tk_drive_pad() reads (a cart or a test can replace these two to script it).
weak fn tk_input_pad() -> u32 { return PAD1 }
weak fn tk_input_stick() -> vec2 { return stick() }

// Drives body b from controller 1, to suit the camera mode:
//  - follow, fixed and rail: the stick or d-pad runs (up = away from the camera), A jumps,
//    L and R turn a follow camera round;
//  - orbit: the d-pad runs, the stick orbits the camera, A jumps;
//  - first person: up/down runs forward and back, left/right turn, L/R step sideways, A jumps.
fn tk_drive_pad(b: *TkBody) {
    let pad = tk_input_pad()
    let s = tk_input_stick()
    var d = vec2(0.0, 0.0)
    if (pad & LEFT) != 0 { d.x = -1.0 }
    if (pad & RIGHT) != 0 { d.x = 1.0 }
    if (pad & UP) != 0 { d.y = 1.0 }
    if (pad & DOWN) != 0 { d.y = -1.0 }
    let jump = (pad & A) != 0
    match tk_cam.mode {
        TK_CAM_ORBIT => {
            tk_cam_turn(s.x * 0.05, s.y * 0.035)
            tk_drive(b, tk_cam_move_dir(d), jump)
        }
        TK_CAM_FIRST_PERSON => {
            let m = d + s
            tk_cam_turn(m.x * 0.05, 0.0)
            var side: fixed = 0.0
            if (pad & L) != 0 { side = -1.0 }
            if (pad & R) != 0 { side = 1.0 }
            tk_drive(b, tk_cam_move_dir(vec2(side, clamp(m.y, -1.0, 1.0))), jump)
        }
        else => {
            var m = d
            if m.x == 0.0 && m.y == 0.0 { m = s }
            if (pad & L) != 0 { tk_cam_turn(-0.045, 0.0) }
            if (pad & R) != 0 { tk_cam_turn(0.045, 0.0) }
            tk_drive(b, tk_cam_move_dir(m), jump)
        }
    }
}

// ---- each frame

// Moves everything one frame: platforms, bodies, zones, animations, particles, props, camera.
fn tk_update() {
    __tk_tick += 1
    __tk_platforms_step()
    for i in 0..__tk_nbodies { __tk_body_step(&__tk_bodies[i]) }
    __tk_zones_step()
    for i in 0..__tk_nanims { __tk_anim_step(&__tk_anims[i]) }
    __tk_particles_step()
    for i in 0..__tk_nprops {
        let p = &__tk_props[i]
        p.__t += 1.0
        p.yaw = tk_wrap(p.yaw + p.spin)
    }
    __tk_cam_step()
}

// Frames tk_update() has run since tk_open().
fn tk_ticks() -> s32 { return __tk_tick }

// Draws the toy box. Call it first in draw().
fn tk_draw() {
    if __tk_clear { cls(__tk_sky) }
    __tk_cam_apply()
    if __tk_fog_on { fog(__tk_fog_col, __tk_fog_near, __tk_fog_far) } else { fog_off() }
    // the ground: each piece drawn now, in order, so it is under everything
    for i in 0..__tk_npieces {
        let p = &__tk_pieces[i]
        if p.ground && p.shown {
            mesh(p.mesh)
            let _ = ot_flush()
        }
    }
    for i in 0..__tk_npieces {
        let p = &__tk_pieces[i]
        if !p.ground && p.shown && (p.radius == 0.0 || tk_visible(p.centre, p.radius)) { mesh(p.mesh) }
    }
    for i in 0..__tk_nplatforms {
        let p = &__tk_platforms[i]
        if p.mesh != null { mesh_at(p.mesh, p.pos, 0.0) }
    }
    for i in 0..__tk_nprops {
        let p = &__tk_props[i]
        if !p.shown { continue }
        let at = tk_prop_spot(p)
        if !tk_visible(at, p.scale * 1.5) { continue }
        let m = tk_place_scaled(at, p.yaw, vec3(p.scale, p.scale, p.scale))
        if p.anim != null { tk_anim_draw(p.anim, m) } else if p.mesh != null { mesh_xf(p.mesh, m) }
    }
    // bodies sort a little in front of what they stand on
    depth_bias(-6)
    for i in 0..__tk_nbodies {
        let b = &__tk_bodies[i]
        if b.hidden || !tk_visible(b.pos + vec3(0.0, b.height / 2, 0.0), b.height) { continue }
        let m = tk_body_matrix(b)
        if b.anim != null { tk_anim_draw(b.anim, m) } else if b.mesh != null { mesh_xf(b.mesh, m) }
    }
    // blob shadows on the floor under bodies and props
    depth_bias(-10)
    for i in 0..__tk_nbodies {
        let b = &__tk_bodies[i]
        if b.shadow > 0.0 && (!b.hidden || tk_cam.mode == TK_CAM_FIRST_PERSON) { tk_shadow(b.pos, b.shadow) }
    }
    for i in 0..__tk_nprops {
        let p = &__tk_props[i]
        if p.shown && p.shadow > 0.0 { tk_shadow(p.pos, p.shadow) }
    }
    depth_bias(0)
    __tk_particles_draw()
    fog_off()
}

// A soft round shadow on the floor under p, radius r, fainter and smaller the higher p is.
fn tk_shadow(p: vec3, r: fixed) {
    let floor = tk_floor_at(p.x, p.z, p.y + 0.05)
    if floor == TK_NO_FLOOR { return }
    let h = p.y - floor
    if h > 6.0 { return }
    let k = 1.0 - h * 0.12
    let rr = r * (0.6 + k * 0.4)
    if !tk_visible(vec3(p.x, floor, p.z), rr) { return }
    let c = col_scale(0x6E6E6E, k)
    let y = floor + 0.02
    for n in 0..4 { __tk_shq.f.col[n] = c }
    __tk_shq.v[0] = vec4(p.x - rr, y, p.z - rr, 1.0)
    __tk_shq.v[1] = vec4(p.x + rr, y, p.z - rr, 1.0)
    __tk_shq.v[2] = vec4(p.x - rr, y, p.z + rr, 1.0)
    __tk_shq.v[3] = vec4(p.x + rr, y, p.z + rr, 1.0)
    mesh(&__tk_shq.hdr)
}
