// Tsumiki basics: toy paint, texture cells, the shape bin, angles and placing things.
//
// Units: 1.0 is about a hand's width of toy (a block); speeds are units per frame (60 a
// second). Angles are radians; a yaw of 0 faces +Z and a positive yaw turns toward +X, as the
// camera does (docs/LANGUAGE.md, "Coordinates").
import "atlas.akr"

// ---- toy paint (colours 0xBBGGRR, as rgb() makes them)

const TK_RED = 0x2F32DC        // rgb(220, 50, 47)
const TK_ORANGE = 0x1E82F0     // rgb(240, 130, 30)
const TK_YELLOW = 0x28C8FA     // rgb(250, 200, 40)
const TK_GREEN = 0x46AA46      // rgb(70, 170, 70)
const TK_BLUE = 0xD26428       // rgb(40, 100, 210)
const TK_PURPLE = 0xB4508C     // rgb(140, 80, 180)
const TK_PINK = 0xAA8CF0       // rgb(240, 140, 170)
const TK_CREAM = 0xC8E6F5      // rgb(245, 230, 200)
const TK_WHITE = 0xFAFAFA      // rgb(250, 250, 250)
const TK_BLACK = 0x221C1E      // rgb(30, 28, 34)
const TK_BEECH = 0x78B2DE      // rgb(222, 178, 120): bare wood
const TK_WALNUT = 0x375A8C     // rgb(140, 90, 55): dark wood
const TK_SKY = 0xF0C896        // rgb(150, 200, 240)
const TK_MINT = 0xBEDC96       // rgb(150, 220, 190)
const TK_GREY = 0x968C8C       // rgb(140, 140, 150)

// The six bright block colours, for things that pick one by number (confetti, towers).
const TK_TOY_COLOURS: [6]u32 = [0x2F32DC, 0x1E82F0, 0x28C8FA, 0x46AA46, 0xD26428, 0xB4508C]

// ---- texture cells
//
// A cell is a rectangle of a 4-bit texture, with its palette, packed into one u32: u / 8 in
// bits 0-4, v / 8 in 5-9, width / 8 - 1 in 10-14, height / 8 - 1 in 15-19, the slot in 20-23
// and the palette in 24-31. The built-in cells (atlas.akr) are TK_WOOD, TK_PLANKS, TK_FELT,
// TK_STRIPES, TK_DOTS, TK_CHECK, TK_BRICK, TK_STARS (finishes for shapes) and TK_DOT, TK_STAR,
// TK_PUFF, TK_DROP, TK_FLAME, TK_SQUARE, TK_RING, TK_HEART (particles and sprites). They are
// grey, so a face's paint colour (or a sprite's tint) colours them. tools/tsumiki.py makes
// cells of your own.

const TK_PLAIN: u32 = 0        // no texture: flat paint

struct TkAtlas {
    slot: s32              // texture slot of the cells
    texels: *u8            // rows of 128 bytes (4-bit texels), from row 0 of the slot
    rows: s32
    palettes: *u16         // 16 colours for each cell's palette
    first_palette: s32
    count: s32             // palettes
}

// Copies a texture atlas made by tools/tsumiki.py into VRAM (its slot and palettes).
fn tk_load_atlas(a: *TkAtlas) {
    let dst = (VRAM_TEXTURES + a.slot * TEXTURE_SLOT_SIZE) as *u8
    memcpy(dst, a.texels, (a.rows * 128) as u32)
    load_palette(a.first_palette * 16, a.palettes, a.count * 16)
}

// The built-in cells: slot 15, rows 192-255 (the fonts keep rows 0-66), palette 254.
fn __tk_atlas_load() {
    let dst = (VRAM_TEXTURES + 15 * TEXTURE_SLOT_SIZE + 192 * 128) as *u8
    memcpy(dst, &__TK_ATLAS[0] as *u8, 8192)
    load_palette(254 * 16, &__TK_ATLAS_PAL[0], 16)
}

// A cell's texture page bits (for packets and sprite_ex) and its corners in texels.
fn tk_cell_page(c: u32) -> u32 { return tex_page(((c >> 20) & 15) as s32, (c >> 24) as s32, true) }
fn tk_cell_u(c: u32) -> s32 { return ((c & 31) << 3) as s32 }
fn tk_cell_v(c: u32) -> s32 { return (((c >> 5) & 31) << 3) as s32 }
fn tk_cell_w(c: u32) -> s32 { return ((((c >> 10) & 31) + 1) << 3) as s32 }
fn tk_cell_h(c: u32) -> s32 { return ((((c >> 15) & 31) + 1) << 3) as s32 }

// Draws a cell on the interface list, w x h pixels at (x, y), in `colour` (the cell's grey
// becomes that colour; white draws a coloured cell as it is) with a blend mode.
fn tk_sprite(c: u32, x: s32, y: s32, w: s32, h: s32, colour: u32, mode: s32) {
    sprite_ex(tk_cell_page(c), tk_cell_u(c), tk_cell_v(c), tk_cell_w(c) - 1, tk_cell_h(c) - 1,
              x, y, w, h, col_tint(colour), mode)
}

// ---- the shape bin
//
// Meshes built in code (shapes.akr) and the RAM copies that morphs change (morph.akr) live
// in one bin of 128 KB, handed out front to back. tk_open() empties it.

const TK_BIN_BYTES = 131072
var __tk_bin: [32768]u32
var __tk_bin_used: s32

// Takes `bytes` (rounded up to 16) from the bin; null (and a message) when it is full.
fn __tk_alloc(bytes: s32) -> *u8 {
    let n = (bytes + 15) & ~15
    if __tk_bin_used + n > TK_BIN_BYTES {
        println("tsumiki: the shape bin is full (128 KB): build fewer or smaller shapes")
        return null
    }
    let p = (&__tk_bin[0] as *u8) + __tk_bin_used
    __tk_bin_used += n
    return p
}

// Bytes of the shape bin still free.
fn tk_bin_left() -> s32 { return TK_BIN_BYTES - __tk_bin_used }

// ---- the light shapes are lit by (baked into their colours when they are built)

var __tk_light: vec3 = vec3(-0.399, 0.8479, -0.3491)     // normalised (-0.4, 0.85, -0.35)
var __tk_ambient: fixed = 0.45

// Sets the light of the shapes built from now on: the direction it comes from (it is
// normalised) and the ambient level 0..1 (the darkest a face gets).
fn tk_light(from: vec3, ambient: fixed) {
    __tk_light = normalize(from)
    __tk_ambient = clamp(ambient, 0.0, 1.0)
}

// How bright a face with (unit) normal n is: ambient + the rest times how much it faces
// the light.
fn __tk_bright(n: vec3) -> fixed {
    return __tk_ambient + (1.0 - __tk_ambient) * max(dot(n, __tk_light), 0.0)
}

// ---- angles

// a wrapped into -PI..PI.
fn tk_wrap(a: fixed) -> fixed {
    var r = a
    while r > PI { r -= TAU }
    while r < -PI { r += TAU }
    return r
}

// Turns angle a toward `target` by at most `step` radians (the short way round).
fn tk_turn_toward(a: fixed, target: fixed, step: fixed) -> fixed {
    return tk_wrap(a + clamp(tk_wrap(target - a), -step, step))
}

// Moves x toward `target` by at most `step`.
fn tk_approach(x: fixed, target: fixed, step: fixed) -> fixed {
    if x < target { return min(x + step, target) }
    return max(x - step, target)
}

// The yaw that faces from `from` toward `to` (ignoring height).
fn tk_yaw_to(from: vec3, to: vec3) -> fixed { return atan2(to.x - from.x, to.z - from.z) }

// The unit vector a yaw faces along (y = 0).
fn tk_yaw_dir(yaw: fixed) -> vec3 { return vec3(sin(yaw), 0.0, cos(yaw)) }

// Smoothstep: 0 at 0, 1 at 1, easing in and out.
fn tk_ease(t: fixed) -> fixed {
    let x = clamp(t, 0.0, 1.0)
    return x * x * (3.0 - 2.0 * x)
}

// A random fixed in -1.0..1.0.
fn tk_rand_signed() -> fixed { return rndf() * 2 - 1.0 }

// ---- placing things: model matrices for mesh_xf() and tk_anim_draw()

// At pos, turned by yaw.
fn tk_place(pos: vec3, yaw: fixed) -> mat4 {
    return tk_place_scaled(pos, yaw, vec3(1.0, 1.0, 1.0))
}

// At pos, turned by yaw, scaled along its own x, y and z.
fn tk_place_scaled(pos: vec3, yaw: fixed, scale: vec3) -> mat4 {
    let s = sin(yaw)
    let c = cos(yaw)
    var m: mat4
    m[0] = vec4(c * scale.x, 0.0, s * scale.z, pos.x)
    m[1] = vec4(0.0, scale.y, 0.0, pos.y)
    m[2] = vec4(-s * scale.x, 0.0, c * scale.z, pos.z)
    m[3] = vec4(0.0, 0.0, 0.0, 1.0)
    return m
}

// Squash and stretch about the feet at pos: amount > 0 stretches taller and thinner, < 0
// squashes flatter and wider, keeping roughly the same volume.
fn tk_squash(pos: vec3, yaw: fixed, amount: fixed) -> mat4 {
    let a = clamp(amount, -0.6, 0.6)
    let side = 1.0 - a * 0.5
    return tk_place_scaled(pos, yaw, vec3(side, 1.0 + a, side))
}

// Could a ball of radius r at p be on screen with the current camera? (A quick test against
// the sides of the view; true is not a promise.)
fn tk_visible(p: vec3, r: fixed) -> bool {
    let v = vec4(p, 1.0)
    let w = dot(__vp[3], v)
    if w < __cam_near - r { return false }
    let x = dot(__vp[0], v)
    let y = dot(__vp[1], v)
    let m = w + r * 2.2
    return x < m && x > -m && y < m && y > -m
}
