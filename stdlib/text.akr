// 2D interface drawing: text, sprites and rectangles go on the interface list, drawn
// after the 3D world in call order. The built-in font lives in texture slot 15 with
// 4-bit palette 255 (colours 4080-4095); those are reserved.
import "font_data.akr"

const FONT_SLOT = 15
const FONT_PALETTE = 255

fn __font_init() {
    let dst = (VRAM_TEXTURES + FONT_SLOT * TEXTURE_SLOT_SIZE) as *u8
    let src = &__FONT_TEX[0] as *u8
    for row in 0..48 {
        memcpy(dst + row * 128, src + row * 64, 64)
    }
    let pal = (VRAM_PALETTE + 2 * 16 * FONT_PALETTE) as *u16
    pal[1] = 0x7FFF
}

// Draws a string at pixel (x, y) with an 8x8 font. '\n' starts a new line.
fn text(x: s32, y: s32, s: *u8, colour: u32) {
    // texture tint: 128 leaves a texel unchanged, so halve the colour (rounding up)
    let tint = ((colour >> 1) & 0x7F7F7F) + (colour & 0x010101)
    let texinfo: u32 = (FONT_SLOT << 16) | (1 << 20) | (FONT_PALETTE << 24)
    var cx = x
    var cy = y
    var p = s
    while true {
        let ch = p[0] as s32
        if ch == 0 { break }
        p += 1
        if ch == '\n' {
            cx = x
            cy += 8
            continue
        }
        if ch > 32 && ch < 127 {
            let q = packet_alloc(10)
            if q == null { return }
            let g = ch - 32
            let u = ((g & 15) << 3) as u32
            let v = ((g >> 4) << 11) as u32
            let pos = (cx as u32 & 0xFFFF) | ((cy as u32) << 16)
            q[1] = tint
            q[2] = pos
            q[3] = u | v | texinfo
            q[4] = pos + 8
            q[5] = (u + 8) | v
            q[6] = pos + 0x80000
            q[7] = u | (v + 0x800)
            q[8] = pos + 0x80008
            q[9] = (u + 8) | (v + 0x800)
            ui_insert(q, 0x26)
        }
        cx += 8
    }
}

// Draws a w x h texel rectangle from texture slot `slot` at pixel (x, y), untinted.
// four_bit: the texture holds 4-bit texels (palette 0-255) instead of 8-bit (palette 0-15).
fn sprite(slot: u32, palette: u32, four_bit: bool, u: s32, v: s32, w: s32, h: s32, x: s32, y: s32) {
    let q = packet_alloc(10)
    if q == null { return }
    let info = ((slot & 15) << 16) | ((four_bit as u32) << 20) | (palette << 24)
    q[1] = 0x808080
    q[2] = __pos(x, y)
    q[3] = (u as u32) | ((v as u32) << 8) | info
    q[4] = __pos(x + w, y)
    q[5] = ((u + w) as u32) | ((v as u32) << 8)
    q[6] = __pos(x, y + h)
    q[7] = (u as u32) | (((v + h) as u32) << 8)
    q[8] = __pos(x + w, y + h)
    q[9] = ((u + w) as u32) | (((v + h) as u32) << 8)
    ui_insert(q, 0x26)
}

// Fills a rectangle on the interface layer.
fn rect(x: s32, y: s32, w: s32, h: s32, colour: u32) {
    let q = packet_alloc(6)
    if q == null { return }
    q[1] = colour
    q[2] = __pos(x, y)
    q[3] = __pos(x + w, y)
    q[4] = __pos(x, y + h)
    q[5] = __pos(x + w, y + h)
    ui_insert(q, 0x24)
}

// Copies texture data into a slot (bytes laid out as the GPU expects, spec p.11).
fn load_texture(slot: s32, src: *u8, bytes: u32) {
    memcpy((VRAM_TEXTURES + (slot & 15) * TEXTURE_SLOT_SIZE) as *u8, src, bytes)
}

// Copies `count` 15-bit colours into palette memory starting at colour `index`.
fn load_palette(index: s32, src: *u16, count: s32) {
    memcpy((VRAM_PALETTE + index * 2) as *u8, src as *u8, (count * 2) as u32)
}

// Formats n in decimal into buf (at least 12 bytes) and returns buf.
fn int_to_str(buf: *u8, n: s32) -> *u8 {
    var tmp: [12]u8
    var u = n as u32
    if n < 0 { u = (0 - n) as u32 }
    var i = 0
    while true {
        tmp[i] = (u % 10 + '0') as u8
        i += 1
        u /= 10
        if u == 0 { break }
    }
    var j = 0
    if n < 0 {
        buf[0] = '-'
        j = 1
    }
    while i > 0 {
        i -= 1
        buf[j] = tmp[i]
        j += 1
    }
    buf[j] = 0
    return buf
}

// Draws a number; returns the x coordinate after it.
fn text_int(x: s32, y: s32, n: s32, colour: u32) -> s32 {
    var buf: [12]u8
    int_to_str(&buf[0], n)
    text(x, y, &buf[0], colour)
    var k = 0
    while buf[k] != 0 { k += 1 }
    return x + 8 * k
}
