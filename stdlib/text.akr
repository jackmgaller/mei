// The 8x8 text: text() and text_int() go on the interface list, drawn after the 3D world in
// call order. The built-in font lives in texture slot 15 with 4-bit palette 255 (colours
// 4080-4095); those are reserved.
import "font_data.akr"

const FONT_SLOT = 15
const FONT_PALETTE = 255

fn __font_init() {
    let dst = (VRAM_TEXTURES + FONT_SLOT * TEXTURE_SLOT_SIZE) as *u8
    let src = &__FONT_TEX[0] as *u8
    for row in 0..48 {
        memcpy(dst + row * 128, src + row * 64, 64)
    }
    let pal = (VRAM_PALETTE + 2 * 16 * FONT_PALETTE) as *u16
    pal[1] = 0x7FFF
}

// Draws a string at pixel (x, y) with an 8x8 font. '\n' starts a new line.
fn text(x: s32, y: s32, s: *u8, colour: u32) {
    // texture tint: 128 leaves a texel unchanged, so halve the colour (rounding up)
    let tint = ((colour >> 1) & 0x7F7F7F) + (colour & 0x010101)
    let texinfo: u32 = (FONT_SLOT << 16) | (1 << 20) | (FONT_PALETTE << 24)
    var cx = x
    var cy = y
    var p = s
    while true {
        let ch = p[0] as s32
        if ch == 0 { break }
        p += 1
        if ch == '\n' {
            cx = x
            cy += 8
            continue
        }
        if ch > 32 && ch < 127 {
            let q = packet_alloc(10)
            if q == null { return }
            let g = ch - 32
            let u = ((g & 15) << 3) as u32
            let v = ((g >> 4) << 11) as u32
            q[1] = tint
            q[2] = __pos(cx, cy)
            q[3] = u | v | texinfo
            q[4] = __pos(cx + 8, cy)
            q[5] = (u + 8) | v
            q[6] = __pos(cx, cy + 8)
            q[7] = u | (v + 0x800)
            q[8] = __pos(cx + 8, cy + 8)
            q[9] = (u + 8) | (v + 0x800)
            ui_insert(q, 0x26)
        }
        cx += 8
    }
}

// Draws a number; returns the x coordinate after it.
fn text_int(x: s32, y: s32, n: s32, colour: u32) -> s32 {
    var buf: [12]u8
    int_to_str(&buf[0], n)
    text(x, y, &buf[0], colour)
    var k = 0
    while buf[k] != 0 { k += 1 }
    return x + 8 * k
}
