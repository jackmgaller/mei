// The frame loop. The compiler's start-up code runs global initialisers, then
// __rt_init(), then the cart's init(), then forever: __rt_frame_begin(), update(),
// draw(), __rt_frame_end(). Also what a cart can ask about frames and their budgets
// (cpu_used(), gpu_used(), frame() and the rest), and animation phases from a frame count
// (frame_phase(), frame_wave(), frame_angle()).

var __frame_cycles: s32
var __frame_tris: s32
var __frame_next: u32          // the tick the next frame starts in when this one makes its vsync
var __frames_dropped: s32

fn __rt_init() {
    __font_init()
    GPU_CTRL = 1
    camera_fov(1.04719755)
    camera_clip(0.1, 100.0)
    camera(vec3(0.0, 0.0, 0.0), 0.0)
}

fn __rt_frame_begin() {
    __ot_reset(&__ot[0])
    __arena_ptr = &__arena[0]
    __arena_end = &__arena[0] + ARENA_WORDS
    __ui_tail = null
    __ot_user = 0
    depth_key_off()
}

weak fn __rt_frame_end() {
    let before = GPU_STATUS & 0xFFFF
    GPU_DRAW = &__ot[OT_SIZE - 1] as u32
    __frame_tris = ((GPU_STATUS & 0xFFFF) - before) as s32
    if __ui_tail != null { GPU_DRAW = __ui_head }
    __pad_prev = PAD1
    __pad2_prev = PAD2
    __frame_cycles = CPU_BUDGET - CYCLES
    // A frame that ran over its budget ended in a later tick (FRAME counts every CPU_BUDGET
    // budget, presented or not): count the budgets it used up in full. (After CYCLES is read,
    // so a frame on time reads exactly as before.)
    let late = (FRAME - __frame_next) as s32
    __frames_dropped = late
    if late > 0 { __frame_cycles += min(late, 2000) * CPU_BUDGET }
    __frame_next = FRAME + 1
    vsync()
}

// CPU cycles used by the previous frame (of CPU_BUDGET a frame). A frame that ran over counts
// in full: CPU_BUDGET for each budget it used up plus what it used of the last, so the number
// goes above CPU_BUDGET instead of wrapping to a small one.
fn cpu_used() -> s32 { return __frame_cycles }

// The frames the previous frame ran over by: 0 when it was on time, n when the picture before
// it stayed on screen n more times (n extra CPU_BUDGET budgets).
fn frames_dropped() -> s32 { return __frames_dropped }

// A cycle clock that keeps counting across frames and overruns: FRAME * CPU_BUDGET - CYCLES.
// Differences between two readings are exact (the s32 wraps every 35 seconds; subtracting
// still works for spans shorter than that).
asm fn cycle_count() -> s32 {
    li   r5, {FRAME}
.again:
    lw   r6, [r5+0]                 ; FRAME
    lw   r7, [r5+4]                 ; CYCLES
    lw   r8, [r5+0]
    bne  r6, r8, .again             ; a new budget began in between
    li   r1, {CPU_BUDGET}
    mul  r1, r6, r1
    sub  r1, r1, r7
}

// Triangles drawn from the ordering table (the 3D world) in the previous frame.
fn tris_drawn() -> s32 { return __frame_tris }
// Frames since reset.
fn frame() -> u32 { return FRAME }

// The CPU's cycles per tick (MEI_CYCLES_PER_FRAME in src/core/mei.h; a 60 MHz CPU).
const CPU_BUDGET = 1000000
// The GPU's cycles per tick (docs/DECISIONS.md, "GPU budget").
const GPU_BUDGET = 1000000

// GPU cycles the previous frame took to draw, by the cost table in docs/DECISIONS.md (40 a
// triangle, 1-4 a pixel, 38,400 a clear). A frame over GPU_BUDGET for each tick it took is held
// back until it fits, so a cart can lower its detail as this nears GPU_BUDGET.
fn gpu_used() -> s32 {
    let c = GPU_LOAD
    if c > 0x7FFFFFFF { return 0x7FFFFFFF }
    return c as s32
}

// Ticks the previous frame took, from the picture before it to its own: 1 on time, n when the
// picture before it stayed up n - 1 more times because the CPU or the GPU ran over.
fn frame_ticks() -> s32 { return GPU_TICKS as s32 }

// Ticks since reset in which a finished frame waited for the GPU. Two readings' difference is
// the slowdown the GPU caused between them.
fn gpu_lag() -> s32 { return GPU_LAG as s32 }

// ---- animation phases that never jump
//
// fixed(frame_count) * speed overflows after 32,768 frames (about nine minutes) and makes every
// animation jump. These take the count itself (FRAME, or the cart's own tick counter, which may
// stop while paused) and are exact for any count.

// How far through a cycle of `period` frames t is: 0 up to (not including) 1.0.
fn frame_phase(t: s32, period: s32) -> fixed {
    if period <= 0 { return 0.0 }
    var m = t % period
    if m < 0 { m += period }
    return fixed(m) / period
}

// A sine wave over `period` frames: sin(TAU * frame_phase(t, period)), -1.0..1.0.
fn frame_wave(t: s32, period: s32) -> fixed { return sin(frame_phase(t, period) * TAU) }

// t * speed (radians per frame) as an angle in 0..TAU, exact for any t: what fixed(t) * speed
// would be, without the wrap. sin(frame_angle(t, 0.05)) turns once every 126 frames, forever.
fn frame_angle(t: s32, speed: fixed) -> fixed {
    let T: u32 = 411775                 // bits(TAU)
    var tm = t as u32
    if t < 0 { tm = (0 - t) as u32 }
    tm = tm % T
    let raw = bits(speed)
    var k = raw as u32
    if raw < 0 { k = (0 - raw) as u32 }
    k = k % T
    // (tm * k) mod T in 32 bits: k = k1 * 1024 + k0
    var r = (tm * (k >> 10)) % T
    r = (r << 10) % T
    r = (r + tm * (k & 1023)) % T
    if (t < 0) != (raw < 0) && r != 0 { r = T - r }
    return from_bits(r as s32)
}
