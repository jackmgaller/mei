    beq  r12, r0, .v1101w_n
    lw   r11, [r0+{__win_tab}]
    add  r12, r12, r11
    lhu  r12, [r12-2]         ; the window
    shli r12, r12, 16
.v1101w_n:
    lhu  r11, [r1+30]
    or   r11, r11, r12
    sw   r11, [r15+24]
    lw   r11, [r10]
    add  r10, r10, r13
    lw   r12, [r7+{__sv}+4]          ; fog amount
    clerp r11, r9, r12        ; toward the fog colour
    sw   r11, [r15+28]
    lw   r11, [r7+{__sv}+8]
    sw   r11, [r15+32]
    lhu  r11, [r1+32]
    sw   r11, [r15+36]
    jmp  .next
.v1111w:   ; gouraud textured quad fog, texture window, 52 bytes
    addi r11, r15, 52
    sw   r11, [r0+{__arena_ptr}]
    andi r13, r4, 1
    shli r13, r13, 2
    addi r10, r1, 12
    lw   r9, [r0+{__fogt_col}]
    lw   r11, [r10]
    add  r10, r10, r13
    lw   r12, [r5+{__sv}+4]          ; fog amount
    clerp r11, r9, r12        ; toward the fog colour
    shri r12, r4, 8           ; blend mode -> bits 24-25
    andi r12, r12, 3
    shli r12, r12, 24
    or   r11, r11, r12
    sw   r11, [r15+4]
    lw   r11, [r5+{__sv}+8]
    sw   r11, [r15+8]
    lhu  r11, [r1+28]
    shri r12, r4, 16          ; slot, depth and palette -> bits 16-31
    andi r12, r12, 0xFF1F
    shli r12, r12, 16
    or   r11, r11, r12
    sw   r11, [r15+12]
    lw   r11, [r10]
    add  r10, r10, r13
    lw   r12, [r6+{__sv}+4]          ; fog amount
    clerp r11, r9, r12        ; toward the fog colour
    sw   r11, [r15+16]
    lw   r11, [r6+{__sv}+8]
    sw   r11, [r15+20]
    shri r12, r4, 20          ; window index x 2
    andi r12, r12, 14
    beq  r12, r0, .v1111w_n
    lw   r11, [r0+{__win_tab}]
    add  r12, r12, r11
    lhu  r12, [r12-2]         ; the window
    shli r12, r12, 16
.v1111w_n:
    lhu  r11, [r1+30]
    or   r11, r11, r12
    sw   r11, [r15+24]
    lw   r11, [r10]
    add  r10, r10, r13
    lw   r12, [r7+{__sv}+4]          ; fog amount
    clerp r11, r9, r12        ; toward the fog colour
    sw   r11, [r15+28]
    lw   r11, [r7+{__sv}+8]
    sw   r11, [r15+32]
    lhu  r11, [r1+32]
    sw   r11, [r15+36]
    lw   r11, [r10]
    add  r10, r10, r13
    lw   r12, [r8+{__sv}+4]          ; fog amount
    clerp r11, r9, r12        ; toward the fog colour
    sw   r11, [r15+40]
    lw   r11, [r8+{__sv}+8]
    sw   r11, [r15+44]
    lhu  r11, [r1+34]
    sw   r11, [r15+48]
    jmp  .next
.gb:
    lw   r11, [sp+24]
    bne  r11, r0, .sub
    jmp  .clip
.sub:
    sw   r1, [sp+28]
    sw   r2, [sp+32]
    call {__subdivide_face}     ; r1 = the face
    lw   r1, [sp+28]
    lw   r2, [sp+32]
    jmp  .next
.nearsub:
    addi r11, r0, 15
    lhu  r5, [r1+4]
    shli r5, r5, 4
    lw   r12, [r5+{__sv}+12]           ; w
    lw   r5, [r5+{__sv}+8]
    shli r6, r5, 16
    sari r6, r6, 16             ; x
    sari r5, r5, 16             ; y
    lw   r9, [r0+{__scr_x0}]
    slt  r7, r6, r9
    lw   r10, [r0+{__scr_x1}]
    slt  r8, r6, r10
    xori r8, r8, 1
    shli r8, r8, 1
    or   r7, r7, r8
    lw   r9, [r0+{__scr_y0}]
    slt  r8, r5, r9
    shli r8, r8, 2
    or   r7, r7, r8
    lw   r10, [r0+{__scr_y1}]
    slt  r8, r5, r10
    xori r8, r8, 1
    shli r8, r8, 3
    or   r7, r7, r8
    bge  r12, r0, .ow0
    xori r7, r7, 15             ; behind the camera
.ow0:
    and  r11, r11, r7
    lhu  r5, [r1+6]
    shli r5, r5, 4
    lw   r12, [r5+{__sv}+12]           ; w
    lw   r5, [r5+{__sv}+8]
    shli r6, r5, 16
    sari r6, r6, 16             ; x
    sari r5, r5, 16             ; y
    lw   r9, [r0+{__scr_x0}]
    slt  r7, r6, r9
    lw   r10, [r0+{__scr_x1}]
    slt  r8, r6, r10
    xori r8, r8, 1
    shli r8, r8, 1
    or   r7, r7, r8
    lw   r9, [r0+{__scr_y0}]
    slt  r8, r5, r9
    shli r8, r8, 2
    or   r7, r7, r8
    lw   r10, [r0+{__scr_y1}]
    slt  r8, r5, r10
    xori r8, r8, 1
    shli r8, r8, 3
    or   r7, r7, r8
    bge  r12, r0, .ow1
    xori r7, r7, 15             ; behind the camera
.ow1:
    and  r11, r11, r7
    lhu  r5, [r1+8]
    shli r5, r5, 4
    lw   r12, [r5+{__sv}+12]           ; w
    lw   r5, [r5+{__sv}+8]
    shli r6, r5, 16
    sari r6, r6, 16             ; x
    sari r5, r5, 16             ; y
    lw   r9, [r0+{__scr_x0}]
    slt  r7, r6, r9
    lw   r10, [r0+{__scr_x1}]
    slt  r8, r6, r10
    xori r8, r8, 1
    shli r8, r8, 1
    or   r7, r7, r8
    lw   r9, [r0+{__scr_y0}]
    slt  r8, r5, r9
    shli r8, r8, 2
    or   r7, r7, r8
    lw   r10, [r0+{__scr_y1}]
    slt  r8, r5, r10
    xori r8, r8, 1
    shli r8, r8, 3
    or   r7, r7, r8
    bge  r12, r0, .ow2
    xori r7, r7, 15             ; behind the camera
.ow2:
    and  r11, r11, r7
    andi r12, r4, 4
    beq  r12, r0, .near3
    lhu  r5, [r1+10]
    shli r5, r5, 4
    lw   r12, [r5+{__sv}+12]           ; w
    lw   r5, [r5+{__sv}+8]
    shli r6, r5, 16
    sari r6, r6, 16             ; x
    sari r5, r5, 16             ; y
    lw   r9, [r0+{__scr_x0}]
    slt  r7, r6, r9
    lw   r10, [r0+{__scr_x1}]
    slt  r8, r6, r10
    xori r8, r8, 1
    shli r8, r8, 1
    or   r7, r7, r8
    lw   r9, [r0+{__scr_y0}]
    slt  r8, r5, r9
    shli r8, r8, 2
    or   r7, r7, r8
    lw   r10, [r0+{__scr_y1}]
    slt  r8, r5, r10
    xori r8, r8, 1
    shli r8, r8, 3
    or   r7, r7, r8
    bge  r12, r0, .ow3
    xori r7, r7, 15             ; behind the camera
.ow3:
    and  r11, r11, r7
.near3:
    bne  r11, r0, .next         ; wholly beyond one side of the view
    sw   r1, [sp+28]
    sw   r2, [sp+32]
    call {__clip_face_sub}     ; r1 = the face
    lw   r1, [sp+28]
    lw   r2, [sp+32]
    jmp  .next
.clip:
    addi r11, r0, 15
    lhu  r5, [r1+4]
    shli r5, r5, 4
    lw   r5, [r5+{__sv}+8]
    shli r6, r5, 16
    sari r6, r6, 16             ; x
    sari r5, r5, 16             ; y
    lw   r9, [r0+{__scr_x0}]
    slt  r7, r6, r9
    lw   r10, [r0+{__scr_x1}]
    slt  r8, r6, r10
    xori r8, r8, 1
    shli r8, r8, 1
    or   r7, r7, r8
    lw   r9, [r0+{__scr_y0}]
    slt  r8, r5, r9
    shli r8, r8, 2
    or   r7, r7, r8
    lw   r10, [r0+{__scr_y1}]
    slt  r8, r5, r10
    xori r8, r8, 1
    shli r8, r8, 3
    or   r7, r7, r8
    and  r11, r11, r7
    lhu  r5, [r1+6]
    shli r5, r5, 4
    lw   r5, [r5+{__sv}+8]
    shli r6, r5, 16
    sari r6, r6, 16             ; x
    sari r5, r5, 16             ; y
    lw   r9, [r0+{__scr_x0}]
    slt  r7, r6, r9
    lw   r10, [r0+{__scr_x1}]
    slt  r8, r6, r10
    xori r8, r8, 1
    shli r8, r8, 1
    or   r7, r7, r8
    lw   r9, [r0+{__scr_y0}]
    slt  r8, r5, r9
    shli r8, r8, 2
    or   r7, r7, r8
    lw   r10, [r0+{__scr_y1}]
    slt  r8, r5, r10
    xori r8, r8, 1
    shli r8, r8, 3
    or   r7, r7, r8
    and  r11, r11, r7
    lhu  r5, [r1+8]
    shli r5, r5, 4
    lw   r5, [r5+{__sv}+8]
    shli r6, r5, 16
    sari r6, r6, 16             ; x
    sari r5, r5, 16             ; y
    lw   r9, [r0+{__scr_x0}]
    slt  r7, r6, r9
    lw   r10, [r0+{__scr_x1}]
    slt  r8, r6, r10
    xori r8, r8, 1
    shli r8, r8, 1
    or   r7, r7, r8
    lw   r9, [r0+{__scr_y0}]
    slt  r8, r5, r9
    shli r8, r8, 2
    or   r7, r7, r8
    lw   r10, [r0+{__scr_y1}]
    slt  r8, r5, r10
    xori r8, r8, 1
    shli r8, r8, 3
    or   r7, r7, r8
    and  r11, r11, r7
    andi r12, r4, 4
    beq  r12, r0, .clip3
    lhu  r5, [r1+10]
    shli r5, r5, 4
    lw   r5, [r5+{__sv}+8]
    shli r6, r5, 16
    sari r6, r6, 16             ; x
    sari r5, r5, 16             ; y
    lw   r9, [r0+{__scr_x0}]
    slt  r7, r6, r9
    lw   r10, [r0+{__scr_x1}]
    slt  r8, r6, r10
    xori r8, r8, 1
    shli r8, r8, 1
    or   r7, r7, r8
    lw   r9, [r0+{__scr_y0}]
    slt  r8, r5, r9
    shli r8, r8, 2
    or   r7, r7, r8
    lw   r10, [r0+{__scr_y1}]
    slt  r8, r5, r10
    xori r8, r8, 1
    shli r8, r8, 3
    or   r7, r7, r8
    and  r11, r11, r7
.clip3:
    bne  r11, r0, .next         ; off the screen
    sw   r1, [sp+28]
    sw   r2, [sp+32]
    call {__clip_face}          ; r1 = the face
    lw   r1, [sp+28]
    lw   r2, [sp+32]
.next:
    addi r1, r1, 36
    addi r2, r2, -1
    bne  r2, r0, .face
.done:
    lw   r9, [sp+0]
    lw   r10, [sp+4]
    lw   r11, [sp+8]
    lw   r12, [sp+12]
    lw   r13, [sp+16]
    lw   ra, [sp+20]
    addi sp, sp, 56
    ret
    .align 4
.table:
    .word .v0000
    .word .v1000
    .word .v0100
    .word .v1100
    .word .v0010
    .word .v1010
    .word .v0110
    .word .v1110
    .word .v1001
    .word .v1001
    .word .v1101
    .word .v1101
    .word .v1011
    .word .v1011
    .word .v1111
    .word .v1111
    .word .v0000
    .word .v1000
    .word .v0100w
    .word .v1100w
    .word .v0010
    .word .v1010
    .word .v0110w
    .word .v1110w
    .word .v1001
    .word .v1001
    .word .v1101w
    .word .v1101w
    .word .v1011
    .word .v1011
    .word .v1111w
    .word .v1111w
}

// The loop for a mesh that needs no clipping at all: see safe_loop() in gen_faces_asm.py.
weak asm fn __draw_faces_safe(first: *Face, nf: s32) {
    beq  r2, r0, .ret
    addi sp, sp, -24
    sw   r9, [sp+0]
    sw   r10, [sp+4]
    sw   r11, [sp+8]
    sw   r12, [sp+12]
    sw   r13, [sp+16]
    sw   ra, [sp+20]
    shli r11, r2, 5
    shli r2, r2, 2
    add  r2, r2, r11
    add  r2, r2, r1             ; the end of the faces (36 bytes each)
    lw   r15, [r0+{__arena_ptr}]
    lw   r3, [r0+{__cam_near}]
    add  r12, r3, r3
    add  r3, r12, r3            ; 3 near
    li   r8, 0xFF1F0000
.face:
    lw   r4, [r1]               ; flags, blend, texture, palette
    lhu  r5, [r1+4]
    shli r5, r5, 4
    lhu  r6, [r1+6]
    shli r6, r6, 4
    lhu  r7, [r1+8]
    shli r7, r7, 4
    ; back faces: nclip >= 0 (front faces are counter-clockwise on screen)
    lw   r12, [r5+{__sv}+8]
    lw   r11, [r6+{__sv}+8]     ; (r11 and r13 keep positions 1 and 2 for the flat triangle)
    lw   r13, [r7+{__sv}+8]
    nclip r12, r11, r13
    bge  r12, r0, .back
.front:
    andi r12, r4, 39            ; keyed, quad, textured, Gouraud
    addi r9, r0, 2
    bne  r12, r9, .notri        ; not a flat textured triangle
    lw   r10, [r5+{__sv}+12]
    lw   r12, [r6+{__sv}+12]
    add  r10, r10, r12
    lw   r12, [r7+{__sv}+12]
    add  r10, r10, r12
    sub  r12, r10, r3           ; w0 + w1 + w2 - 3 near
    lw   r6, [r0+{__ot_k3}]
    lw   r10, [r0+{__ot_bias}]
    otz  r10, r12, r6           ; ordering-table bucket
    ; header and ordering-table insertion
    shli r10, r10, 2
    lw   r12, [r10+{__ot}]
    andi r6, r4, 15
    ori  r6, r6, 0x20
    shli r6, r6, 24
    or   r12, r12, r6
    sw   r12, [r15]
    sw   r15, [r10+{__ot}]
    ; the packet: flat textured triangle, 32 bytes
    lw   r12, [r1+12]
    shri r6, r4, 8              ; blend mode -> bits 24 up
    andi r6, r6, 3
    shli r6, r6, 24
    or   r12, r12, r6
    sw   r12, [r15+4]
    lw   r12, [r5+{__sv}+8]
    sw   r12, [r15+8]
    lhu  r12, [r1+28]
    and  r6, r4, r8             ; slot, depth and palette -> bits 16-31
    or   r12, r12, r6
    sw   r12, [r15+12]
    sw   r11, [r15+16]
    lhu  r12, [r1+30]
    sw   r12, [r15+20]
    sw   r13, [r15+24]
    lhu  r12, [r1+32]
    sw   r12, [r15+28]
    addi r15, r15, 32
.next:
    addi r1, r1, 36
    bltu r1, r2, .face
    sw   r15, [r0+{__arena_ptr}]
    lw   r9, [sp+0]
    lw   r10, [sp+4]
    lw   r11, [sp+8]
    lw   r12, [sp+12]
    lw   r13, [sp+16]
    lw   ra, [sp+20]
    addi sp, sp, 24
.ret:
    ret
.back:
    andi r12, r4, 16            ; double-sided
    beq  r12, r0, .next
    jmp  .front
.nextr:
    li   r8, 0xFF1F0000
    jmp  .next
.notri:
    addi r9, r0, 6
    bne  r12, r9, .gen          ; not a flat textured quad either
    lw   r10, [r5+{__sv}+12]
    lw   r12, [r6+{__sv}+12]
    add  r10, r10, r12
    lw   r12, [r7+{__sv}+12]
    add  r10, r10, r12
    lhu  r7, [r1+10]
    shli r7, r7, 4
    lw   r12, [r7+{__sv}+12]
    add  r10, r10, r12
    lw   r6, [r0+{__cam_near}]
    shli r6, r6, 2
    sub  r12, r10, r6           ; w0 + w1 + w2 + w3 - 4 near
    lw   r6, [r0+{__ot_k4}]
    lw   r10, [r0+{__ot_bias}]
    otz  r10, r12, r6           ; ordering-table bucket
    shli r10, r10, 2
    lw   r12, [r10+{__ot}]
    andi r6, r4, 15
    ori  r6, r6, 0x20
    shli r6, r6, 24
    or   r12, r12, r6
    sw   r12, [r15]
    sw   r15, [r10+{__ot}]
    ; the packet: flat textured quad, 40 bytes
    lw   r12, [r1+12]
    shri r6, r4, 8              ; blend mode -> bits 24 up
    andi r6, r6, 3
    shli r6, r6, 24
    or   r12, r12, r6
    sw   r12, [r15+4]
    lw   r12, [r5+{__sv}+8]
    sw   r12, [r15+8]
    lhu  r12, [r1+28]
    and  r6, r4, r8             ; slot, depth and palette -> bits 16-31
    or   r12, r12, r6
    sw   r12, [r15+12]
    sw   r11, [r15+16]
    lhu  r12, [r1+30]
    sw   r12, [r15+20]
    sw   r13, [r15+24]
    lhu  r12, [r1+32]
    sw   r12, [r15+28]
    lw   r12, [r7+{__sv}+8]
    sw   r12, [r15+32]
    lhu  r12, [r1+34]
    sw   r12, [r15+36]
    addi r15, r15, 40
    jmp  .next
    ; any other face: as __draw_faces makes it
.gen:
    andi r12, r4, 32
    bne  r12, r0, .keyed        ; FACE_KEYED: the bucket is in col[3]
    lw   r10, [r5+{__sv}+12]
    lw   r12, [r6+{__sv}+12]
    add  r10, r10, r12
    lw   r12, [r7+{__sv}+12]
    add  r10, r10, r12          ; w0 + w1 + w2
    andi r12, r4, 4
    bne  r12, r0, .quad
    sub  r12, r10, r3           ; w0 + w1 + w2 - 3 near
    lw   r9, [r0+{__ot_k3}]
.depth:
    lw   r10, [r0+{__ot_bias}]
    otz  r10, r12, r9           ; ordering-table bucket
.dk:
    shli r10, r10, 2
    lw   r12, [r10+{__ot}]
    andi r9, r4, 15
    ori  r9, r9, 0x20
    shli r9, r9, 24
    or   r12, r12, r9
    sw   r12, [r15]
    sw   r15, [r10+{__ot}]
    andi r12, r4, 7
    shli r12, r12, 2
    la   r9, .table
    add  r9, r9, r12
    lw   r9, [r9]
    jr   r9
.quad:
    lhu  r8, [r1+10]
    shli r8, r8, 4
    lw   r12, [r8+{__sv}+12]
    add  r10, r10, r12
    lw   r12, [r0+{__cam_near}]
    shli r12, r12, 2
    sub  r12, r10, r12          ; w0 + w1 + w2 + w3 - 4 near
    lw   r9, [r0+{__ot_k4}]
    jmp  .depth
.keyed:
    lhu  r8, [r1+10]            ; (the fourth corner, for a quad's writer)
    shli r8, r8, 4
    lw   r10, [r0+{__ot_bias}]
    lw   r9, [r1+24]
    add  r10, r10, r9
    bge  r10, r0, .k0
    mov  r10, r0
.k0:
    slti r9, r10, 1024
    bne  r9, r0, .dk
    addi r10, r0, 1023
    jmp  .dk
.s000:   ; flat triangle, 20 bytes
    lw   r11, [r1+12]
    shri r12, r4, 8           ; blend mode -> bits 24-25
    andi r12, r12, 3
    shli r12, r12, 24
    or   r11, r11, r12
    sw   r11, [r15+4]
    lw   r11, [r5+{__sv}+8]
    sw   r11, [r15+8]
    lw   r11, [r6+{__sv}+8]
    sw   r11, [r15+12]
    lw   r11, [r7+{__sv}+8]
    sw   r11, [r15+16]
    addi r15, r15, 20
    jmp  .nextr
.s100:   ; gouraud triangle, 28 bytes
    lw   r11, [r1+12]
    shri r12, r4, 8           ; blend mode -> bits 24-25
    andi r12, r12, 3
    shli r12, r12, 24
    or   r11, r11, r12
    sw   r11, [r15+4]
    lw   r11, [r5+{__sv}+8]
    sw   r11, [r15+8]
    lw   r11, [r1+16]
    sw   r11, [r15+12]
    lw   r11, [r6+{__sv}+8]
    sw   r11, [r15+16]
    lw   r11, [r1+20]
    sw   r11, [r15+20]
    lw   r11, [r7+{__sv}+8]
    sw   r11, [r15+24]
    addi r15, r15, 28
    jmp  .nextr
.s010:   ; flat textured triangle, 32 bytes
    lw   r11, [r1+12]
    shri r12, r4, 8           ; blend mode -> bits 24-25
    andi r12, r12, 3
    shli r12, r12, 24
    or   r11, r11, r12
    sw   r11, [r15+4]
    lw   r11, [r5+{__sv}+8]
    sw   r11, [r15+8]
    lhu  r11, [r1+28]
    shri r12, r4, 16          ; slot, depth and palette -> bits 16-31
    andi r12, r12, 0xFF1F
    shli r12, r12, 16
    or   r11, r11, r12
    sw   r11, [r15+12]
    lw   r11, [r6+{__sv}+8]
    sw   r11, [r15+16]
    lhu  r11, [r1+30]
    sw   r11, [r15+20]
    lw   r11, [r7+{__sv}+8]
    sw   r11, [r15+24]
    lhu  r11, [r1+32]
    sw   r11, [r15+28]
    addi r15, r15, 32
    jmp  .nextr
.s110:   ; gouraud textured triangle, 40 bytes
    lw   r11, [r1+12]
    shri r12, r4, 8           ; blend mode -> bits 24-25
    andi r12, r12, 3
    shli r12, r12, 24
    or   r11, r11, r12
    sw   r11, [r15+4]
    lw   r11, [r5+{__sv}+8]
    sw   r11, [r15+8]
    lhu  r11, [r1+28]
    shri r12, r4, 16          ; slot, depth and palette -> bits 16-31
    andi r12, r12, 0xFF1F
    shli r12, r12, 16
    or   r11, r11, r12
    sw   r11, [r15+12]
    lw   r11, [r1+16]
    sw   r11, [r15+16]
    lw   r11, [r6+{__sv}+8]
    sw   r11, [r15+20]
    lhu  r11, [r1+30]
    sw   r11, [r15+24]
    lw   r11, [r1+20]
    sw   r11, [r15+28]
    lw   r11, [r7+{__sv}+8]
    sw   r11, [r15+32]
    lhu  r11, [r1+32]
    sw   r11, [r15+36]
    addi r15, r15, 40
    jmp  .nextr
.s001:   ; flat quad, 24 bytes
    lw   r11, [r1+12]
    shri r12, r4, 8           ; blend mode -> bits 24-25
    andi r12, r12, 3
    shli r12, r12, 24
    or   r11, r11, r12
    sw   r11, [r15+4]
    lw   r11, [r5+{__sv}+8]
    sw   r11, [r15+8]
    lw   r11, [r6+{__sv}+8]
    sw   r11, [r15+12]
    lw   r11, [r7+{__sv}+8]
    sw   r11, [r15+16]
    lw   r11, [r8+{__sv}+8]
    sw   r11, [r15+20]
    addi r15, r15, 24
    jmp  .nextr
.s101:   ; gouraud quad, 36 bytes
    lw   r11, [r1+12]
    shri r12, r4, 8           ; blend mode -> bits 24-25
    andi r12, r12, 3
    shli r12, r12, 24
    or   r11, r11, r12
    sw   r11, [r15+4]
    lw   r11, [r5+{__sv}+8]
    sw   r11, [r15+8]
    lw   r11, [r1+16]
    sw   r11, [r15+12]
    lw   r11, [r6+{__sv}+8]
    sw   r11, [r15+16]
    lw   r11, [r1+20]
    sw   r11, [r15+20]
    lw   r11, [r7+{__sv}+8]
    sw   r11, [r15+24]
    lw   r11, [r1+24]
    sw   r11, [r15+28]
    lw   r11, [r8+{__sv}+8]
    sw   r11, [r15+32]
    addi r15, r15, 36
    jmp  .nextr
.s011:   ; flat textured quad, 40 bytes
    lw   r11, [r1+12]
    shri r12, r4, 8           ; blend mode -> bits 24-25
    andi r12, r12, 3
    shli r12, r12, 24
    or   r11, r11, r12
    sw   r11, [r15+4]
    lw   r11, [r5+{__sv}+8]
    sw   r11, [r15+8]
    lhu  r11, [r1+28]
    shri r12, r4, 16          ; slot, depth and palette -> bits 16-31
    andi r12, r12, 0xFF1F
    shli r12, r12, 16
    or   r11, r11, r12
    sw   r11, [r15+12]
    lw   r11, [r6+{__sv}+8]
    sw   r11, [r15+16]
    lhu  r11, [r1+30]
    sw   r11, [r15+20]
    lw   r11, [r7+{__sv}+8]
    sw   r11, [r15+24]
    lhu  r11, [r1+32]
    sw   r11, [r15+28]
    lw   r11, [r8+{__sv}+8]
    sw   r11, [r15+32]
    lhu  r11, [r1+34]
    sw   r11, [r15+36]
    addi r15, r15, 40
    jmp  .nextr
.s111:   ; gouraud textured quad, 52 bytes
    lw   r11, [r1+12]
    shri r12, r4, 8           ; blend mode -> bits 24-25
    andi r12, r12, 3
    shli r12, r12, 24
    or   r11, r11, r12
    sw   r11, [r15+4]
    lw   r11, [r5+{__sv}+8]
    sw   r11, [r15+8]
    lhu  r11, [r1+28]
    shri r12, r4, 16          ; slot, depth and palette -> bits 16-31
    andi r12, r12, 0xFF1F
    shli r12, r12, 16
    or   r11, r11, r12
    sw   r11, [r15+12]
    lw   r11, [r1+16]
    sw   r11, [r15+16]
    lw   r11, [r6+{__sv}+8]
    sw   r11, [r15+20]
    lhu  r11, [r1+30]
    sw   r11, [r15+24]
    lw   r11, [r1+20]
    sw   r11, [r15+28]
    lw   r11, [r7+{__sv}+8]
    sw   r11, [r15+32]
    lhu  r11, [r1+32]
    sw   r11, [r15+36]
    lw   r11, [r1+24]
    sw   r11, [r15+40]
    lw   r11, [r8+{__sv}+8]
    sw   r11, [r15+44]
    lhu  r11, [r1+34]
    sw   r11, [r15+48]
    addi r15, r15, 52
    jmp  .nextr
    .align 4
.table:
    .word .s000
    .word .s100
    .word .s010
    .word .s110
    .word .s001
    .word .s101
    .word .s011
    .word .s111
}

// The subdivision worklist of subdiv.akr: splits a face held in scratch vertices until
// no edge needs splitting, queueing the pieces with __sub_emit (see gen_faces_asm.py).
var __sub_stack: [320]u32

asm fn __sub_run(n: s32) {
    addi sp, sp, -108
    sw   ra, [sp+20]
    la   r5, {__sub_stack}
    sw   r5, [sp+24]
    sw   r0, [sp+28]
    addi r5, r0, 1
    sw   r5, [sp+32]
    addi r5, r0, 2
    sw   r5, [sp+36]
    addi r5, r0, -1
    addi r6, r0, 4
    bne  {n}, r6, .tri0
    addi r5, r0, 3
.tri0:
    sw   r5, [sp+40]
    sw   r0, [sp+44]
    jmp  .process
.pop:
    lw   r5, [sp+24]
    la   r6, {__sub_stack}
    beq  r5, r6, .end
    addi r5, r5, -20
    sw   r5, [sp+24]
    lw   r6, [r5+0]
    sw   r6, [sp+28]
    lw   r6, [r5+4]
    sw   r6, [sp+32]
    lw   r6, [r5+8]
    sw   r6, [sp+36]
    lw   r6, [r5+12]
    sw   r6, [sp+40]
    lw   r6, [r5+16]
    sw   r6, [sp+44]
.process:
    lw   r5, [r0+{__sub_n}]
    slti r5, r5, 122            ; scratch nearly full: draw the patch as it is
    beq  r5, r0, .emit
    lw   r5, [sp+24]
    la   r6, {__sub_stack}
    addi r6, r6, 1200
    bge  r5, r6, .emit          ; worklist nearly full
    lw   r5, [sp+44]
    shri r6, r5, 0
    andi r6, r6, 15
    sw   r6, [sp+48]
    shri r6, r5, 4
    andi r6, r6, 15
    sw   r6, [sp+52]
    shri r6, r5, 8
    andi r6, r6, 15
    sw   r6, [sp+56]
    shri r6, r5, 12
    andi r6, r6, 15
    sw   r6, [sp+60]
    shri r6, r5, 16
    andi r6, r6, 15
    sw   r6, [sp+96]
    lw   r5, [sp+40]
    blt  r5, r0, .tri
    ; ---- quad: if the bottom and top both split, cut into left and right halves
    lw   r6, [sp+48]
    lw   r7, [r0+{__subdiv}]
    bge  r6, r7, .no1
    lw   r1, [sp+28]
    lw   r2, [sp+32]
    call {__sub_split}
    beq  r1, r0, .no1
    addi r7, r0, 2
    bne  r1, r7, .yes2
    lw   r6, [sp+48]
    beq  r6, r0, .yes2         ; crossing the near plane: only halved once
.no1:
    addi r6, r0, 15
    sw   r6, [sp+48]
    sw   r0, [sp+64]
    jmp  .dn3
.yes2:
    addi r6, r0, 1
    sw   r6, [sp+64]
.dn3:
    lw   r6, [sp+56]
    lw   r7, [r0+{__subdiv}]
    bge  r6, r7, .no4
    lw   r1, [sp+40]
    lw   r2, [sp+36]
    call {__sub_split}
    beq  r1, r0, .no4
    addi r7, r0, 2
    bne  r1, r7, .yes5
    lw   r6, [sp+56]
    beq  r6, r0, .yes5         ; crossing the near plane: only halved once
.no4:
    addi r6, r0, 15
    sw   r6, [sp+56]
    sw   r0, [sp+72]
    jmp  .dn6
.yes5:
    addi r6, r0, 1
    sw   r6, [sp+72]
.dn6:
    lw   r5, [sp+64]
    lw   r6, [sp+72]
    and  r5, r5, r6
    beq  r5, r0, .q2
    lw   r1, [sp+28]
    lw   r2, [sp+32]
    call {__sub_mid}
    sw   r1, [sp+80]
    lw   r1, [sp+40]
    lw   r2, [sp+36]
    call {__sub_mid}
    sw   r1, [sp+84]
    lw   r1, [sp+80]
    lw   r2, [sp+32]
    lw   r3, [sp+84]
    lw   r4, [sp+40]
    mov  r5, r0
    lw   r8, [sp+48]
    addi r8, r8, 1
    or   r5, r5, r8
    lw   r8, [sp+52]
    shli r8, r8, 4
    or   r5, r5, r8
    lw   r8, [sp+56]
    addi r8, r8, 1
    shli r8, r8, 8
    or   r5, r5, r8
    lw   r8, [sp+48]
    addi r8, r8, 1
    shli r8, r8, 12
    or   r5, r5, r8
    lw   r8, [sp+96]
    addi r8, r8, 1
    shli r8, r8, 16
    or   r5, r5, r8
    lw   r6, [sp+24]
    sw   r1, [r6+0]
    sw   r2, [r6+4]
    sw   r3, [r6+8]
    sw   r4, [r6+12]
    sw   r5, [r6+16]
    addi r6, r6, 20
    sw   r6, [sp+24]
    lw   r1, [sp+28]
    lw   r2, [sp+80]
    lw   r3, [sp+36]
    lw   r4, [sp+84]
    mov  r5, r0
    lw   r8, [sp+48]
    addi r8, r8, 1
    or   r5, r5, r8
    lw   r8, [sp+48]
    addi r8, r8, 1
    shli r8, r8, 4
    or   r5, r5, r8
    lw   r8, [sp+56]
    addi r8, r8, 1
    shli r8, r8, 8
    or   r5, r5, r8
    lw   r8, [sp+60]
    shli r8, r8, 12
    or   r5, r5, r8
    lw   r8, [sp+96]
    addi r8, r8, 1
    shli r8, r8, 16
    or   r5, r5, r8
    lw   r6, [sp+24]
    sw   r1, [r6+0]
    sw   r2, [r6+4]
    sw   r3, [r6+8]
    sw   r4, [r6+12]
    sw   r5, [r6+16]
    addi r6, r6, 20
    sw   r6, [sp+24]
    jmp  .pop
.q2:
    ; if the right and left both split, cut into bottom and top halves
    lw   r6, [sp+52]
    lw   r7, [r0+{__subdiv}]
    bge  r6, r7, .no7
    lw   r1, [sp+32]
    lw   r2, [sp+40]
    call {__sub_split}
    beq  r1, r0, .no7
    addi r7, r0, 2
    bne  r1, r7, .yes8
    lw   r6, [sp+52]
    beq  r6, r0, .yes8         ; crossing the near plane: only halved once
.no7:
    addi r6, r0, 15
    sw   r6, [sp+52]
    sw   r0, [sp+68]
    jmp  .dn9
.yes8:
    addi r6, r0, 1
    sw   r6, [sp+68]
.dn9:
    lw   r6, [sp+60]
    lw   r7, [r0+{__subdiv}]
    bge  r6, r7, .no10
    lw   r1, [sp+36]
    lw   r2, [sp+28]
    call {__sub_split}
    beq  r1, r0, .no10
    addi r7, r0, 2
    bne  r1, r7, .yes11
    lw   r6, [sp+60]
    beq  r6, r0, .yes11         ; crossing the near plane: only halved once
.no10:
    addi r6, r0, 15
    sw   r6, [sp+60]
    sw   r0, [sp+76]
    jmp  .dn12
.yes11:
    addi r6, r0, 1
    sw   r6, [sp+76]
.dn12:
    lw   r5, [sp+68]
    lw   r6, [sp+76]
    and  r5, r5, r6
    beq  r5, r0, .q3
    lw   r1, [sp+32]
    lw   r2, [sp+40]
    call {__sub_mid}
    sw   r1, [sp+80]
    lw   r1, [sp+36]
    lw   r2, [sp+28]
    call {__sub_mid}
    sw   r1, [sp+84]
    lw   r1, [sp+84]
    lw   r2, [sp+80]
    lw   r3, [sp+36]
    lw   r4, [sp+40]
    mov  r5, r0
    lw   r8, [sp+52]
    addi r8, r8, 1
    or   r5, r5, r8
    lw   r8, [sp+52]
    addi r8, r8, 1
    shli r8, r8, 4
    or   r5, r5, r8
    lw   r8, [sp+56]
    shli r8, r8, 8
    or   r5, r5, r8
    lw   r8, [sp+60]
    addi r8, r8, 1
    shli r8, r8, 12
    or   r5, r5, r8
    lw   r8, [sp+96]
    addi r8, r8, 1
    shli r8, r8, 16
    or   r5, r5, r8
    lw   r6, [sp+24]
    sw   r1, [r6+0]
    sw   r2, [r6+4]
    sw   r3, [r6+8]
    sw   r4, [r6+12]
    sw   r5, [r6+16]
    addi r6, r6, 20
    sw   r6, [sp+24]
    lw   r1, [sp+28]
    lw   r2, [sp+32]
    lw   r3, [sp+84]
    lw   r4, [sp+80]
    mov  r5, r0
    lw   r8, [sp+48]
    or   r5, r5, r8
    lw   r8, [sp+52]
    addi r8, r8, 1
    shli r8, r8, 4
    or   r5, r5, r8
    lw   r8, [sp+52]
    addi r8, r8, 1
    shli r8, r8, 8
    or   r5, r5, r8
    lw   r8, [sp+60]
    addi r8, r8, 1
    shli r8, r8, 12
    or   r5, r5, r8
    lw   r8, [sp+96]
    addi r8, r8, 1
    shli r8, r8, 16
    or   r5, r5, r8
    lw   r6, [sp+24]
    sw   r1, [r6+0]
    sw   r2, [r6+4]
    sw   r3, [r6+8]
    sw   r4, [r6+12]
    sw   r5, [r6+16]
    addi r6, r6, 20
    sw   r6, [sp+24]
    jmp  .pop
.q3:
    ; no edge to split: draw it. Otherwise go on with its two triangles (a b c) and
    ; (b d c), as the GPU draws it. (Quads are only ever cut into quads or into their
    ; own two triangles: fanning around a new inner point would bend texture lines
    ; that run parallel to the edges, such as bricks and floor tiles.)
    lw   r5, [sp+64]
    lw   r6, [sp+68]
    or   r5, r5, r6
    lw   r6, [sp+72]
    or   r5, r5, r6
    lw   r6, [sp+76]
    or   r5, r5, r6
    beq  r5, r0, .emit
    lw   r1, [sp+32]
    lw   r2, [sp+40]
    lw   r3, [sp+36]
    addi r4, r0, -1
    mov  r5, r0
    lw   r8, [sp+52]
    or   r5, r5, r8
    lw   r8, [sp+56]
    shli r8, r8, 4
    or   r5, r5, r8
    lw   r8, [sp+96]
    shli r8, r8, 8
    or   r5, r5, r8
    lw   r6, [sp+24]
    sw   r1, [r6+0]
    sw   r2, [r6+4]
    sw   r3, [r6+8]
    sw   r4, [r6+12]
    sw   r5, [r6+16]
    addi r6, r6, 20
    sw   r6, [sp+24]
    lw   r1, [sp+28]
    lw   r2, [sp+32]
    lw   r3, [sp+36]
    addi r4, r0, -1
    mov  r5, r0
    lw   r8, [sp+48]
    or   r5, r5, r8
    lw   r8, [sp+96]
    shli r8, r8, 4
    or   r5, r5, r8
    lw   r8, [sp+60]
    shli r8, r8, 8
    or   r5, r5, r8
    lw   r6, [sp+24]
    sw   r1, [r6+0]
    sw   r2, [r6+4]
    sw   r3, [r6+8]
    sw   r4, [r6+12]
    sw   r5, [r6+16]
    addi r6, r6, 20
    sw   r6, [sp+24]
    jmp  .pop
    ; ---- triangle a b c: split into four if all edges split, else bisect one edge
.tri:
    lw   r6, [sp+48]
    lw   r7, [r0+{__subdiv}]
    bge  r6, r7, .no13
    lw   r1, [sp+28]
    lw   r2, [sp+32]
    call {__sub_split}
    beq  r1, r0, .no13
    addi r7, r0, 2
    bne  r1, r7, .yes14
    lw   r6, [sp+48]
    beq  r6, r0, .yes14         ; crossing the near plane: only halved once
.no13:
    addi r6, r0, 15
    sw   r6, [sp+48]
    sw   r0, [sp+64]
    jmp  .dn15
.yes14:
    addi r6, r0, 1
    sw   r6, [sp+64]
.dn15:
    lw   r6, [sp+52]
    lw   r7, [r0+{__subdiv}]
    bge  r6, r7, .no16
    lw   r1, [sp+32]
    lw   r2, [sp+36]
    call {__sub_split}
    beq  r1, r0, .no16
    addi r7, r0, 2
    bne  r1, r7, .yes17
    lw   r6, [sp+52]
    beq  r6, r0, .yes17         ; crossing the near plane: only halved once
.no16:
    addi r6, r0, 15
    sw   r6, [sp+52]
    sw   r0, [sp+68]
    jmp  .dn18
.yes17:
    addi r6, r0, 1
    sw   r6, [sp+68]
.dn18:
    lw   r6, [sp+56]
    lw   r7, [r0+{__subdiv}]
    bge  r6, r7, .no19
    lw   r1, [sp+36]
    lw   r2, [sp+28]
    call {__sub_split}
    beq  r1, r0, .no19
    addi r7, r0, 2
    bne  r1, r7, .yes20
    lw   r6, [sp+56]
    beq  r6, r0, .yes20         ; crossing the near plane: only halved once
.no19:
    addi r6, r0, 15
    sw   r6, [sp+56]
    sw   r0, [sp+72]
    jmp  .dn21
