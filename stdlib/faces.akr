    beq  r12, r0, .v1011_3         ; in front of the fog
    slti r9, r12, 256
    beq  r9, r0, .v1011_f3
    lw   r9, [r0+{__mask_rb}]
    and  r9, r11, r9          ; red and blue lanes
    xor  r11, r11, r9         ; green lane
    addi r3, r0, 256
    sub  r3, r3, r12          ; 256 - t
    mul  r9, r9, r3
    mul  r11, r11, r3
    lw   r3, [r0+{__fog_rb}]
    mul  r3, r3, r12
    add  r9, r9, r3
    lw   r3, [r0+{__fog_g}]
    mul  r3, r3, r12
    add  r11, r11, r3
    shri r9, r9, 8
    lw   r3, [r0+{__mask_rb}]
    and  r9, r9, r3
    shri r11, r11, 8
    andi r11, r11, 0xFF00
    or   r11, r11, r9
    jmp  .v1011_3
.v1011_f3:
    lw   r11, [r0+{__fog_rb}]
    lw   r9, [r0+{__fog_g}]
    or   r11, r11, r9
.v1011_3:
    sw   r11, [r15+28]
    lw   r11, [r8]
    sw   r11, [r15+32]
    la   r3, {__sv}
    jmp  .next
.v1111:   ; gouraud textured quad fog, 52 bytes
    addi r11, r15, 52
    sw   r11, [r0+{__arena_ptr}]
    andi r13, r4, 1
    shli r13, r13, 2
    addi r10, r1, 12
    lw   r11, [r10]
    add  r10, r10, r13
    lw   r12, [r5+4]          ; fog amount
    beq  r12, r0, .v1111_0         ; in front of the fog
    slti r9, r12, 256
    beq  r9, r0, .v1111_f0
    lw   r9, [r0+{__mask_rb}]
    and  r9, r11, r9          ; red and blue lanes
    xor  r11, r11, r9         ; green lane
    addi r3, r0, 256
    sub  r3, r3, r12          ; 256 - t
    mul  r9, r9, r3
    mul  r11, r11, r3
    lw   r3, [r0+{__fogt_rb}]
    mul  r3, r3, r12
    add  r9, r9, r3
    lw   r3, [r0+{__fogt_g}]
    mul  r3, r3, r12
    add  r11, r11, r3
    shri r9, r9, 8
    lw   r3, [r0+{__mask_rb}]
    and  r9, r9, r3
    shri r11, r11, 8
    andi r11, r11, 0xFF00
    or   r11, r11, r9
    jmp  .v1111_0
.v1111_f0:
    lw   r11, [r0+{__fogt_rb}]
    lw   r9, [r0+{__fogt_g}]
    or   r11, r11, r9
.v1111_0:
    shri r12, r4, 8           ; blend mode -> bits 24-25
    andi r12, r12, 3
    shli r12, r12, 24
    or   r11, r11, r12
    sw   r11, [r15+4]
    lw   r11, [r5]
    sw   r11, [r15+8]
    lhu  r11, [r1+28]
    shri r12, r4, 16          ; slot, depth and palette -> bits 16-31
    andi r12, r12, 0xFF1F
    shli r12, r12, 16
    or   r11, r11, r12
    sw   r11, [r15+12]
    lw   r11, [r10]
    add  r10, r10, r13
    lw   r12, [r6+4]          ; fog amount
    beq  r12, r0, .v1111_1         ; in front of the fog
    slti r9, r12, 256
    beq  r9, r0, .v1111_f1
    lw   r9, [r0+{__mask_rb}]
    and  r9, r11, r9          ; red and blue lanes
    xor  r11, r11, r9         ; green lane
    addi r3, r0, 256
    sub  r3, r3, r12          ; 256 - t
    mul  r9, r9, r3
    mul  r11, r11, r3
    lw   r3, [r0+{__fogt_rb}]
    mul  r3, r3, r12
    add  r9, r9, r3
    lw   r3, [r0+{__fogt_g}]
    mul  r3, r3, r12
    add  r11, r11, r3
    shri r9, r9, 8
    lw   r3, [r0+{__mask_rb}]
    and  r9, r9, r3
    shri r11, r11, 8
    andi r11, r11, 0xFF00
    or   r11, r11, r9
    jmp  .v1111_1
.v1111_f1:
    lw   r11, [r0+{__fogt_rb}]
    lw   r9, [r0+{__fogt_g}]
    or   r11, r11, r9
.v1111_1:
    sw   r11, [r15+16]
    lw   r11, [r6]
    sw   r11, [r15+20]
    lhu  r11, [r1+30]
    sw   r11, [r15+24]
    lw   r11, [r10]
    add  r10, r10, r13
    lw   r12, [r7+4]          ; fog amount
    beq  r12, r0, .v1111_2         ; in front of the fog
    slti r9, r12, 256
    beq  r9, r0, .v1111_f2
    lw   r9, [r0+{__mask_rb}]
    and  r9, r11, r9          ; red and blue lanes
    xor  r11, r11, r9         ; green lane
    addi r3, r0, 256
    sub  r3, r3, r12          ; 256 - t
    mul  r9, r9, r3
    mul  r11, r11, r3
    lw   r3, [r0+{__fogt_rb}]
    mul  r3, r3, r12
    add  r9, r9, r3
    lw   r3, [r0+{__fogt_g}]
    mul  r3, r3, r12
    add  r11, r11, r3
    shri r9, r9, 8
    lw   r3, [r0+{__mask_rb}]
    and  r9, r9, r3
    shri r11, r11, 8
    andi r11, r11, 0xFF00
    or   r11, r11, r9
    jmp  .v1111_2
.v1111_f2:
    lw   r11, [r0+{__fogt_rb}]
    lw   r9, [r0+{__fogt_g}]
    or   r11, r11, r9
.v1111_2:
    sw   r11, [r15+28]
    lw   r11, [r7]
    sw   r11, [r15+32]
    lhu  r11, [r1+32]
    sw   r11, [r15+36]
    lw   r11, [r10]
    add  r10, r10, r13
    lw   r12, [r8+4]          ; fog amount
    beq  r12, r0, .v1111_3         ; in front of the fog
    slti r9, r12, 256
    beq  r9, r0, .v1111_f3
    lw   r9, [r0+{__mask_rb}]
    and  r9, r11, r9          ; red and blue lanes
    xor  r11, r11, r9         ; green lane
    addi r3, r0, 256
    sub  r3, r3, r12          ; 256 - t
    mul  r9, r9, r3
    mul  r11, r11, r3
    lw   r3, [r0+{__fogt_rb}]
    mul  r3, r3, r12
    add  r9, r9, r3
    lw   r3, [r0+{__fogt_g}]
    mul  r3, r3, r12
    add  r11, r11, r3
    shri r9, r9, 8
    lw   r3, [r0+{__mask_rb}]
    and  r9, r9, r3
    shri r11, r11, 8
    andi r11, r11, 0xFF00
    or   r11, r11, r9
    jmp  .v1111_3
.v1111_f3:
    lw   r11, [r0+{__fogt_rb}]
    lw   r9, [r0+{__fogt_g}]
    or   r11, r11, r9
.v1111_3:
    sw   r11, [r15+40]
    lw   r11, [r8]
    sw   r11, [r15+44]
    lhu  r11, [r1+34]
    sw   r11, [r15+48]
    la   r3, {__sv}
    jmp  .next
.sub:
    sw   r1, [sp+28]
    sw   r2, [sp+32]
    call {__subdivide_face}     ; r1 = the face
    lw   r1, [sp+28]
    lw   r2, [sp+32]
    la   r3, {__sv}
.next:
    addi r1, r1, 36
    addi r2, r2, -1
    bne  r2, r0, .face
.done:
    lw   r9, [sp+0]
    lw   r10, [sp+4]
    lw   r11, [sp+8]
    lw   r12, [sp+12]
    lw   r13, [sp+16]
    lw   ra, [sp+20]
    addi sp, sp, 56
    ret
    .align 4
.table:
    .word .v0000
    .word .v1000
    .word .v0100
    .word .v1100
    .word .v0010
    .word .v1010
    .word .v0110
    .word .v1110
    .word .v1001
    .word .v1001
    .word .v1101
    .word .v1101
    .word .v1011
    .word .v1011
    .word .v1111
    .word .v1111
}

// The subdivision worklist of subdiv.akr: splits a face held in scratch vertices until
// no edge needs splitting, queueing the pieces with __sub_emit (see gen_faces_asm.py).
var __sub_stack: [320]u32

asm fn __sub_run(n: s32) {
    addi sp, sp, -108
    sw   ra, [sp+20]
    la   r5, {__sub_stack}
    sw   r5, [sp+24]
    sw   r0, [sp+28]
    addi r5, r0, 1
    sw   r5, [sp+32]
    addi r5, r0, 2
    sw   r5, [sp+36]
    addi r5, r0, -1
    addi r6, r0, 4
    bne  {n}, r6, .tri0
    addi r5, r0, 3
.tri0:
    sw   r5, [sp+40]
    sw   r0, [sp+44]
    jmp  .process
.pop:
    lw   r5, [sp+24]
    la   r6, {__sub_stack}
    beq  r5, r6, .end
    addi r5, r5, -20
    sw   r5, [sp+24]
    lw   r6, [r5+0]
    sw   r6, [sp+28]
    lw   r6, [r5+4]
    sw   r6, [sp+32]
    lw   r6, [r5+8]
    sw   r6, [sp+36]
    lw   r6, [r5+12]
    sw   r6, [sp+40]
    lw   r6, [r5+16]
    sw   r6, [sp+44]
.process:
    lw   r5, [r0+{__sub_n}]
    slti r5, r5, 122            ; scratch nearly full: draw the patch as it is
    beq  r5, r0, .emit
    lw   r5, [sp+24]
    la   r6, {__sub_stack}
    addi r6, r6, 1200
    bge  r5, r6, .emit          ; worklist nearly full
    lw   r5, [sp+44]
    shri r6, r5, 0
    andi r6, r6, 15
    sw   r6, [sp+48]
    shri r6, r5, 4
    andi r6, r6, 15
    sw   r6, [sp+52]
    shri r6, r5, 8
    andi r6, r6, 15
    sw   r6, [sp+56]
    shri r6, r5, 12
    andi r6, r6, 15
    sw   r6, [sp+60]
    shri r6, r5, 16
    andi r6, r6, 15
    sw   r6, [sp+96]
    lw   r5, [sp+40]
    blt  r5, r0, .tri
    ; ---- quad: if the bottom and top both split, cut into left and right halves
    lw   r6, [sp+48]
    lw   r7, [r0+{__subdiv}]
    bge  r6, r7, .no1
    lw   r1, [sp+28]
    lw   r2, [sp+32]
    call {__sub_split}
    beq  r1, r0, .no1
    addi r7, r0, 2
    bne  r1, r7, .yes2
    lw   r6, [sp+48]
    beq  r6, r0, .yes2         ; crossing the near plane: only halved once
.no1:
    addi r6, r0, 15
    sw   r6, [sp+48]
    sw   r0, [sp+64]
    jmp  .dn3
.yes2:
    addi r6, r0, 1
    sw   r6, [sp+64]
.dn3:
    lw   r6, [sp+56]
    lw   r7, [r0+{__subdiv}]
    bge  r6, r7, .no4
    lw   r1, [sp+40]
    lw   r2, [sp+36]
    call {__sub_split}
    beq  r1, r0, .no4
    addi r7, r0, 2
    bne  r1, r7, .yes5
    lw   r6, [sp+56]
    beq  r6, r0, .yes5         ; crossing the near plane: only halved once
.no4:
    addi r6, r0, 15
    sw   r6, [sp+56]
    sw   r0, [sp+72]
    jmp  .dn6
.yes5:
    addi r6, r0, 1
    sw   r6, [sp+72]
.dn6:
    lw   r5, [sp+64]
    lw   r6, [sp+72]
    and  r5, r5, r6
    beq  r5, r0, .q2
    lw   r1, [sp+28]
    lw   r2, [sp+32]
    call {__sub_mid}
    sw   r1, [sp+80]
    lw   r1, [sp+40]
    lw   r2, [sp+36]
    call {__sub_mid}
    sw   r1, [sp+84]
    lw   r1, [sp+80]
    lw   r2, [sp+32]
    lw   r3, [sp+84]
    lw   r4, [sp+40]
    mov  r5, r0
    lw   r8, [sp+48]
    addi r8, r8, 1
    or   r5, r5, r8
    lw   r8, [sp+52]
    shli r8, r8, 4
    or   r5, r5, r8
    lw   r8, [sp+56]
    addi r8, r8, 1
    shli r8, r8, 8
    or   r5, r5, r8
    lw   r8, [sp+48]
    addi r8, r8, 1
    shli r8, r8, 12
    or   r5, r5, r8
    lw   r8, [sp+96]
    addi r8, r8, 1
    shli r8, r8, 16
    or   r5, r5, r8
    lw   r6, [sp+24]
    sw   r1, [r6+0]
    sw   r2, [r6+4]
    sw   r3, [r6+8]
    sw   r4, [r6+12]
    sw   r5, [r6+16]
    addi r6, r6, 20
    sw   r6, [sp+24]
    lw   r1, [sp+28]
    lw   r2, [sp+80]
    lw   r3, [sp+36]
    lw   r4, [sp+84]
    mov  r5, r0
    lw   r8, [sp+48]
    addi r8, r8, 1
    or   r5, r5, r8
    lw   r8, [sp+48]
    addi r8, r8, 1
    shli r8, r8, 4
    or   r5, r5, r8
    lw   r8, [sp+56]
    addi r8, r8, 1
    shli r8, r8, 8
    or   r5, r5, r8
    lw   r8, [sp+60]
    shli r8, r8, 12
    or   r5, r5, r8
    lw   r8, [sp+96]
    addi r8, r8, 1
    shli r8, r8, 16
    or   r5, r5, r8
    lw   r6, [sp+24]
    sw   r1, [r6+0]
    sw   r2, [r6+4]
    sw   r3, [r6+8]
    sw   r4, [r6+12]
    sw   r5, [r6+16]
    addi r6, r6, 20
    sw   r6, [sp+24]
    jmp  .pop
.q2:
    ; if the right and left both split, cut into bottom and top halves
    lw   r6, [sp+52]
    lw   r7, [r0+{__subdiv}]
    bge  r6, r7, .no7
    lw   r1, [sp+32]
    lw   r2, [sp+40]
    call {__sub_split}
    beq  r1, r0, .no7
    addi r7, r0, 2
    bne  r1, r7, .yes8
    lw   r6, [sp+52]
    beq  r6, r0, .yes8         ; crossing the near plane: only halved once
.no7:
    addi r6, r0, 15
    sw   r6, [sp+52]
    sw   r0, [sp+68]
    jmp  .dn9
.yes8:
    addi r6, r0, 1
    sw   r6, [sp+68]
.dn9:
    lw   r6, [sp+60]
    lw   r7, [r0+{__subdiv}]
    bge  r6, r7, .no10
    lw   r1, [sp+36]
    lw   r2, [sp+28]
    call {__sub_split}
    beq  r1, r0, .no10
    addi r7, r0, 2
    bne  r1, r7, .yes11
    lw   r6, [sp+60]
    beq  r6, r0, .yes11         ; crossing the near plane: only halved once
.no10:
    addi r6, r0, 15
    sw   r6, [sp+60]
    sw   r0, [sp+76]
    jmp  .dn12
.yes11:
    addi r6, r0, 1
    sw   r6, [sp+76]
.dn12:
    lw   r5, [sp+68]
    lw   r6, [sp+76]
    and  r5, r5, r6
    beq  r5, r0, .q3
    lw   r1, [sp+32]
    lw   r2, [sp+40]
    call {__sub_mid}
    sw   r1, [sp+80]
    lw   r1, [sp+36]
    lw   r2, [sp+28]
    call {__sub_mid}
    sw   r1, [sp+84]
    lw   r1, [sp+84]
    lw   r2, [sp+80]
    lw   r3, [sp+36]
    lw   r4, [sp+40]
    mov  r5, r0
    lw   r8, [sp+52]
    addi r8, r8, 1
    or   r5, r5, r8
    lw   r8, [sp+52]
    addi r8, r8, 1
    shli r8, r8, 4
    or   r5, r5, r8
    lw   r8, [sp+56]
    shli r8, r8, 8
    or   r5, r5, r8
    lw   r8, [sp+60]
    addi r8, r8, 1
    shli r8, r8, 12
    or   r5, r5, r8
    lw   r8, [sp+96]
    addi r8, r8, 1
    shli r8, r8, 16
    or   r5, r5, r8
    lw   r6, [sp+24]
    sw   r1, [r6+0]
    sw   r2, [r6+4]
    sw   r3, [r6+8]
    sw   r4, [r6+12]
    sw   r5, [r6+16]
    addi r6, r6, 20
    sw   r6, [sp+24]
    lw   r1, [sp+28]
    lw   r2, [sp+32]
    lw   r3, [sp+84]
    lw   r4, [sp+80]
    mov  r5, r0
    lw   r8, [sp+48]
    or   r5, r5, r8
    lw   r8, [sp+52]
    addi r8, r8, 1
    shli r8, r8, 4
    or   r5, r5, r8
    lw   r8, [sp+52]
    addi r8, r8, 1
    shli r8, r8, 8
    or   r5, r5, r8
    lw   r8, [sp+60]
    addi r8, r8, 1
    shli r8, r8, 12
    or   r5, r5, r8
    lw   r8, [sp+96]
    addi r8, r8, 1
    shli r8, r8, 16
    or   r5, r5, r8
    lw   r6, [sp+24]
    sw   r1, [r6+0]
    sw   r2, [r6+4]
    sw   r3, [r6+8]
    sw   r4, [r6+12]
    sw   r5, [r6+16]
    addi r6, r6, 20
    sw   r6, [sp+24]
    jmp  .pop
.q3:
    ; no edge to split: draw it. Otherwise go on with its two triangles (a b c) and
    ; (b d c), as the GPU draws it. (Quads are only ever cut into quads or into their
    ; own two triangles: fanning around a new inner point would bend texture lines
    ; that run parallel to the edges, such as bricks and floor tiles.)
    lw   r5, [sp+64]
    lw   r6, [sp+68]
    or   r5, r5, r6
    lw   r6, [sp+72]
    or   r5, r5, r6
    lw   r6, [sp+76]
    or   r5, r5, r6
    beq  r5, r0, .emit
    lw   r1, [sp+32]
    lw   r2, [sp+40]
    lw   r3, [sp+36]
    addi r4, r0, -1
    mov  r5, r0
    lw   r8, [sp+52]
    or   r5, r5, r8
    lw   r8, [sp+56]
    shli r8, r8, 4
    or   r5, r5, r8
    lw   r8, [sp+96]
    shli r8, r8, 8
    or   r5, r5, r8
    lw   r6, [sp+24]
    sw   r1, [r6+0]
    sw   r2, [r6+4]
    sw   r3, [r6+8]
    sw   r4, [r6+12]
    sw   r5, [r6+16]
    addi r6, r6, 20
    sw   r6, [sp+24]
    lw   r1, [sp+28]
    lw   r2, [sp+32]
    lw   r3, [sp+36]
    addi r4, r0, -1
    mov  r5, r0
    lw   r8, [sp+48]
    or   r5, r5, r8
    lw   r8, [sp+96]
    shli r8, r8, 4
    or   r5, r5, r8
    lw   r8, [sp+60]
    shli r8, r8, 8
    or   r5, r5, r8
    lw   r6, [sp+24]
    sw   r1, [r6+0]
    sw   r2, [r6+4]
    sw   r3, [r6+8]
    sw   r4, [r6+12]
    sw   r5, [r6+16]
    addi r6, r6, 20
    sw   r6, [sp+24]
    jmp  .pop
    ; ---- triangle a b c: split into four if all edges split, else bisect one edge
.tri:
    lw   r6, [sp+48]
    lw   r7, [r0+{__subdiv}]
    bge  r6, r7, .no13
    lw   r1, [sp+28]
    lw   r2, [sp+32]
    call {__sub_split}
    beq  r1, r0, .no13
    addi r7, r0, 2
    bne  r1, r7, .yes14
    lw   r6, [sp+48]
    beq  r6, r0, .yes14         ; crossing the near plane: only halved once
.no13:
    addi r6, r0, 15
    sw   r6, [sp+48]
    sw   r0, [sp+64]
    jmp  .dn15
