.v1100w_n:
    lhu  r11, [r1+30]
    or   r11, r11, r12
    sw   r11, [r15+24]
    lw   r11, [r1+20]
    sw   r11, [r15+28]
    lw   r11, [r7+{__sv}+8]
    sw   r11, [r15+32]
    lhu  r11, [r1+32]
    sw   r11, [r15+36]
    jmp  .next
.v0110w:   ; flat textured quad, texture window, 40 bytes
    addi r11, r15, 40
    sw   r11, [r0+{__arena_ptr}]
    lw   r11, [r1+12]
    shri r12, r4, 8           ; blend mode -> bits 24-25
    andi r12, r12, 3
    shli r12, r12, 24
    or   r11, r11, r12
    sw   r11, [r15+4]
    lw   r11, [r5+{__sv}+8]
    sw   r11, [r15+8]
    lhu  r11, [r1+28]
    shri r12, r4, 16          ; slot, depth and palette -> bits 16-31
    andi r12, r12, 0xFF1F
    shli r12, r12, 16
    or   r11, r11, r12
    sw   r11, [r15+12]
    lw   r11, [r6+{__sv}+8]
    sw   r11, [r15+16]
    shri r12, r4, 20          ; window index x 2
    andi r12, r12, 14
    beq  r12, r0, .v0110w_n
    lw   r11, [r0+{__win_tab}]
    add  r12, r12, r11
    lhu  r12, [r12-2]         ; the window
    shli r12, r12, 16
.v0110w_n:
    lhu  r11, [r1+30]
    or   r11, r11, r12
    sw   r11, [r15+20]
    lw   r11, [r7+{__sv}+8]
    sw   r11, [r15+24]
    lhu  r11, [r1+32]
    sw   r11, [r15+28]
    lw   r11, [r8+{__sv}+8]
    sw   r11, [r15+32]
    lhu  r11, [r1+34]
    sw   r11, [r15+36]
    jmp  .next
.v1110w:   ; gouraud textured quad, texture window, 52 bytes
    addi r11, r15, 52
    sw   r11, [r0+{__arena_ptr}]
    lw   r11, [r1+12]
    shri r12, r4, 8           ; blend mode -> bits 24-25
    andi r12, r12, 3
    shli r12, r12, 24
    or   r11, r11, r12
    sw   r11, [r15+4]
    lw   r11, [r5+{__sv}+8]
    sw   r11, [r15+8]
    lhu  r11, [r1+28]
    shri r12, r4, 16          ; slot, depth and palette -> bits 16-31
    andi r12, r12, 0xFF1F
    shli r12, r12, 16
    or   r11, r11, r12
    sw   r11, [r15+12]
    lw   r11, [r1+16]
    sw   r11, [r15+16]
    lw   r11, [r6+{__sv}+8]
    sw   r11, [r15+20]
    shri r12, r4, 20          ; window index x 2
    andi r12, r12, 14
    beq  r12, r0, .v1110w_n
    lw   r11, [r0+{__win_tab}]
    add  r12, r12, r11
    lhu  r12, [r12-2]         ; the window
    shli r12, r12, 16
.v1110w_n:
    lhu  r11, [r1+30]
    or   r11, r11, r12
    sw   r11, [r15+24]
    lw   r11, [r1+20]
    sw   r11, [r15+28]
    lw   r11, [r7+{__sv}+8]
    sw   r11, [r15+32]
    lhu  r11, [r1+32]
    sw   r11, [r15+36]
    lw   r11, [r1+24]
    sw   r11, [r15+40]
    lw   r11, [r8+{__sv}+8]
    sw   r11, [r15+44]
    lhu  r11, [r1+34]
    sw   r11, [r15+48]
    jmp  .next
.v1101w:   ; gouraud textured triangle fog, texture window, 40 bytes
    addi r11, r15, 40
    sw   r11, [r0+{__arena_ptr}]
    andi r13, r4, 1
    shli r13, r13, 2
    addi r10, r1, 12
    lw   r9, [r0+{__fogt_col}]
    lw   r11, [r10]
    add  r10, r10, r13
    lw   r12, [r5+{__sv}+4]          ; fog amount
    clerp r11, r9, r12        ; toward the fog colour
    shri r12, r4, 8           ; blend mode -> bits 24-25
    andi r12, r12, 3
    shli r12, r12, 24
    or   r11, r11, r12
    sw   r11, [r15+4]
    lw   r11, [r5+{__sv}+8]
    sw   r11, [r15+8]
    lhu  r11, [r1+28]
    shri r12, r4, 16          ; slot, depth and palette -> bits 16-31
    andi r12, r12, 0xFF1F
    shli r12, r12, 16
    or   r11, r11, r12
    sw   r11, [r15+12]
    lw   r11, [r10]
    add  r10, r10, r13
    lw   r12, [r6+{__sv}+4]          ; fog amount
    clerp r11, r9, r12        ; toward the fog colour
    sw   r11, [r15+16]
    lw   r11, [r6+{__sv}+8]
    sw   r11, [r15+20]
    shri r12, r4, 20          ; window index x 2
    andi r12, r12, 14
    beq  r12, r0, .v1101w_n
    lw   r11, [r0+{__win_tab}]
    add  r12, r12, r11
    lhu  r12, [r12-2]         ; the window
    shli r12, r12, 16
.v1101w_n:
    lhu  r11, [r1+30]
    or   r11, r11, r12
    sw   r11, [r15+24]
    lw   r11, [r10]
    add  r10, r10, r13
    lw   r12, [r7+{__sv}+4]          ; fog amount
    clerp r11, r9, r12        ; toward the fog colour
    sw   r11, [r15+28]
    lw   r11, [r7+{__sv}+8]
    sw   r11, [r15+32]
    lhu  r11, [r1+32]
    sw   r11, [r15+36]
    jmp  .next
.v1111w:   ; gouraud textured quad fog, texture window, 52 bytes
    addi r11, r15, 52
    sw   r11, [r0+{__arena_ptr}]
    andi r13, r4, 1
    shli r13, r13, 2
    addi r10, r1, 12
    lw   r9, [r0+{__fogt_col}]
    lw   r11, [r10]
    add  r10, r10, r13
    lw   r12, [r5+{__sv}+4]          ; fog amount
    clerp r11, r9, r12        ; toward the fog colour
    shri r12, r4, 8           ; blend mode -> bits 24-25
    andi r12, r12, 3
    shli r12, r12, 24
    or   r11, r11, r12
    sw   r11, [r15+4]
    lw   r11, [r5+{__sv}+8]
    sw   r11, [r15+8]
    lhu  r11, [r1+28]
    shri r12, r4, 16          ; slot, depth and palette -> bits 16-31
    andi r12, r12, 0xFF1F
    shli r12, r12, 16
    or   r11, r11, r12
    sw   r11, [r15+12]
    lw   r11, [r10]
    add  r10, r10, r13
    lw   r12, [r6+{__sv}+4]          ; fog amount
    clerp r11, r9, r12        ; toward the fog colour
    sw   r11, [r15+16]
    lw   r11, [r6+{__sv}+8]
    sw   r11, [r15+20]
    shri r12, r4, 20          ; window index x 2
    andi r12, r12, 14
    beq  r12, r0, .v1111w_n
    lw   r11, [r0+{__win_tab}]
    add  r12, r12, r11
    lhu  r12, [r12-2]         ; the window
    shli r12, r12, 16
.v1111w_n:
    lhu  r11, [r1+30]
    or   r11, r11, r12
    sw   r11, [r15+24]
    lw   r11, [r10]
    add  r10, r10, r13
    lw   r12, [r7+{__sv}+4]          ; fog amount
    clerp r11, r9, r12        ; toward the fog colour
    sw   r11, [r15+28]
    lw   r11, [r7+{__sv}+8]
    sw   r11, [r15+32]
    lhu  r11, [r1+32]
    sw   r11, [r15+36]
    lw   r11, [r10]
    add  r10, r10, r13
    lw   r12, [r8+{__sv}+4]          ; fog amount
    clerp r11, r9, r12        ; toward the fog colour
    sw   r11, [r15+40]
    lw   r11, [r8+{__sv}+8]
    sw   r11, [r15+44]
    lhu  r11, [r1+34]
    sw   r11, [r15+48]
    jmp  .next
.nb:
    ; corner 0 is behind the near plane: clip the face, unless they all are
    lhu  r5, [r1+6]
    shli r5, r5, 4
    lw   r11, [r5+{__sv}+12]
    bge  r11, r9, .near
    lhu  r5, [r1+8]
    shli r5, r5, 4
    lw   r11, [r5+{__sv}+12]
    bge  r11, r9, .near
    andi r11, r4, 4
    beq  r11, r0, .next
    lhu  r5, [r1+10]
    shli r5, r5, 4
    lw   r11, [r5+{__sv}+12]
    blt  r11, r9, .next
.near:
    addi r11, r0, 15
    lhu  r5, [r1+4]
    shli r5, r5, 4
    lw   r12, [r5+{__sv}+12]           ; w
    lw   r5, [r5+{__sv}+8]
    shli r6, r5, 16
    sari r6, r6, 16             ; x
    sari r5, r5, 16             ; y
    lw   r9, [r0+{__scr_x0}]
    slt  r7, r6, r9
    lw   r10, [r0+{__scr_x1}]
    slt  r8, r6, r10
    xori r8, r8, 1
    shli r8, r8, 1
    or   r7, r7, r8
    lw   r9, [r0+{__scr_y0}]
    slt  r8, r5, r9
    shli r8, r8, 2
    or   r7, r7, r8
    lw   r10, [r0+{__scr_y1}]
    slt  r8, r5, r10
    xori r8, r8, 1
    shli r8, r8, 3
    or   r7, r7, r8
    bge  r12, r0, .ow0
    xori r7, r7, 15             ; behind the camera
.ow0:
    and  r11, r11, r7
    lhu  r5, [r1+6]
    shli r5, r5, 4
    lw   r12, [r5+{__sv}+12]           ; w
    lw   r5, [r5+{__sv}+8]
    shli r6, r5, 16
    sari r6, r6, 16             ; x
    sari r5, r5, 16             ; y
    lw   r9, [r0+{__scr_x0}]
    slt  r7, r6, r9
    lw   r10, [r0+{__scr_x1}]
    slt  r8, r6, r10
    xori r8, r8, 1
    shli r8, r8, 1
    or   r7, r7, r8
    lw   r9, [r0+{__scr_y0}]
    slt  r8, r5, r9
    shli r8, r8, 2
    or   r7, r7, r8
    lw   r10, [r0+{__scr_y1}]
    slt  r8, r5, r10
    xori r8, r8, 1
    shli r8, r8, 3
    or   r7, r7, r8
    bge  r12, r0, .ow1
    xori r7, r7, 15             ; behind the camera
.ow1:
    and  r11, r11, r7
    lhu  r5, [r1+8]
    shli r5, r5, 4
    lw   r12, [r5+{__sv}+12]           ; w
    lw   r5, [r5+{__sv}+8]
    shli r6, r5, 16
    sari r6, r6, 16             ; x
    sari r5, r5, 16             ; y
    lw   r9, [r0+{__scr_x0}]
    slt  r7, r6, r9
    lw   r10, [r0+{__scr_x1}]
    slt  r8, r6, r10
    xori r8, r8, 1
    shli r8, r8, 1
    or   r7, r7, r8
    lw   r9, [r0+{__scr_y0}]
    slt  r8, r5, r9
    shli r8, r8, 2
    or   r7, r7, r8
    lw   r10, [r0+{__scr_y1}]
    slt  r8, r5, r10
    xori r8, r8, 1
    shli r8, r8, 3
    or   r7, r7, r8
    bge  r12, r0, .ow2
    xori r7, r7, 15             ; behind the camera
.ow2:
    and  r11, r11, r7
    andi r12, r4, 4
    beq  r12, r0, .near3
    lhu  r5, [r1+10]
    shli r5, r5, 4
    lw   r12, [r5+{__sv}+12]           ; w
    lw   r5, [r5+{__sv}+8]
    shli r6, r5, 16
    sari r6, r6, 16             ; x
    sari r5, r5, 16             ; y
    lw   r9, [r0+{__scr_x0}]
    slt  r7, r6, r9
    lw   r10, [r0+{__scr_x1}]
    slt  r8, r6, r10
    xori r8, r8, 1
    shli r8, r8, 1
    or   r7, r7, r8
    lw   r9, [r0+{__scr_y0}]
    slt  r8, r5, r9
    shli r8, r8, 2
    or   r7, r7, r8
    lw   r10, [r0+{__scr_y1}]
    slt  r8, r5, r10
    xori r8, r8, 1
    shli r8, r8, 3
    or   r7, r7, r8
    bge  r12, r0, .ow3
    xori r7, r7, 15             ; behind the camera
.ow3:
    and  r11, r11, r7
.near3:
    bne  r11, r0, .next         ; wholly beyond one side of the view
    sw   r1, [sp+24]
    sw   r2, [sp+28]
    call {__clip_face}     ; r1 = the face
    lw   r1, [sp+24]
    lw   r2, [sp+28]
    jmp  .next
.clip:
    addi r11, r0, 15
    lhu  r5, [r1+4]
    shli r5, r5, 4
    lw   r5, [r5+{__sv}+8]
    shli r6, r5, 16
    sari r6, r6, 16             ; x
    sari r5, r5, 16             ; y
    lw   r9, [r0+{__scr_x0}]
    slt  r7, r6, r9
    lw   r10, [r0+{__scr_x1}]
    slt  r8, r6, r10
    xori r8, r8, 1
    shli r8, r8, 1
    or   r7, r7, r8
    lw   r9, [r0+{__scr_y0}]
    slt  r8, r5, r9
    shli r8, r8, 2
    or   r7, r7, r8
    lw   r10, [r0+{__scr_y1}]
    slt  r8, r5, r10
    xori r8, r8, 1
    shli r8, r8, 3
    or   r7, r7, r8
    and  r11, r11, r7
    lhu  r5, [r1+6]
    shli r5, r5, 4
    lw   r5, [r5+{__sv}+8]
    shli r6, r5, 16
    sari r6, r6, 16             ; x
    sari r5, r5, 16             ; y
    lw   r9, [r0+{__scr_x0}]
    slt  r7, r6, r9
    lw   r10, [r0+{__scr_x1}]
    slt  r8, r6, r10
    xori r8, r8, 1
    shli r8, r8, 1
    or   r7, r7, r8
    lw   r9, [r0+{__scr_y0}]
    slt  r8, r5, r9
    shli r8, r8, 2
    or   r7, r7, r8
    lw   r10, [r0+{__scr_y1}]
    slt  r8, r5, r10
    xori r8, r8, 1
    shli r8, r8, 3
    or   r7, r7, r8
    and  r11, r11, r7
    lhu  r5, [r1+8]
    shli r5, r5, 4
    lw   r5, [r5+{__sv}+8]
    shli r6, r5, 16
    sari r6, r6, 16             ; x
    sari r5, r5, 16             ; y
    lw   r9, [r0+{__scr_x0}]
    slt  r7, r6, r9
    lw   r10, [r0+{__scr_x1}]
    slt  r8, r6, r10
    xori r8, r8, 1
    shli r8, r8, 1
    or   r7, r7, r8
    lw   r9, [r0+{__scr_y0}]
    slt  r8, r5, r9
    shli r8, r8, 2
    or   r7, r7, r8
    lw   r10, [r0+{__scr_y1}]
    slt  r8, r5, r10
    xori r8, r8, 1
    shli r8, r8, 3
    or   r7, r7, r8
    and  r11, r11, r7
    andi r12, r4, 4
    beq  r12, r0, .clip3
    lhu  r5, [r1+10]
    shli r5, r5, 4
    lw   r12, [r5+{__sv}+12]           ; w
    lw   r5, [r5+{__sv}+8]
    shli r6, r5, 16
    sari r6, r6, 16             ; x
    sari r5, r5, 16             ; y
    lw   r9, [r0+{__scr_x0}]
    slt  r7, r6, r9
    lw   r10, [r0+{__scr_x1}]
    slt  r8, r6, r10
    xori r8, r8, 1
    shli r8, r8, 1
    or   r7, r7, r8
    lw   r9, [r0+{__scr_y0}]
    slt  r8, r5, r9
    shli r8, r8, 2
    or   r7, r7, r8
    lw   r10, [r0+{__scr_y1}]
    slt  r8, r5, r10
    xori r8, r8, 1
    shli r8, r8, 3
    or   r7, r7, r8
    bge  r12, r0, .cw3
    xori r7, r7, 15             ; behind the camera
.cw3:
    and  r11, r11, r7
.clip3:
    bne  r11, r0, .next         ; off the screen
    sw   r1, [sp+24]
    sw   r2, [sp+28]
    call {__clip_face}          ; r1 = the face
    lw   r1, [sp+24]
    lw   r2, [sp+28]
.next:
    addi r1, r1, 36
    addi r2, r2, -1
    bne  r2, r0, .face
.done:
    lw   r9, [sp+0]
    lw   r10, [sp+4]
    lw   r11, [sp+8]
    lw   r12, [sp+12]
    lw   r13, [sp+16]
    lw   ra, [sp+20]
    addi sp, sp, 32
    ret
    .align 4
.table:
    .word .v0000
    .word .v1000
    .word .v0100
    .word .v1100
    .word .v0010
    .word .v1010
    .word .v0110
    .word .v1110
    .word .v1001
    .word .v1001
    .word .v1101
    .word .v1101
    .word .v1011
    .word .v1011
    .word .v1111
    .word .v1111
    .word .v0000
    .word .v1000
    .word .v0100w
    .word .v1100w
    .word .v0010
    .word .v1010
    .word .v0110w
    .word .v1110w
    .word .v1001
    .word .v1001
    .word .v1101w
    .word .v1101w
    .word .v1011
    .word .v1011
    .word .v1111w
    .word .v1111w
}

// The same loop without the guard-band test, for meshes wholly inside the band.
weak asm fn __draw_faces_in(first: *Face, nf: s32) {
    addi sp, sp, -32
    sw   r9, [sp+0]
    sw   r10, [sp+4]
    sw   r11, [sp+8]
    sw   r12, [sp+12]
    sw   r13, [sp+16]
    sw   ra, [sp+20]
    beq  r2, r0, .done
.face:
    lw   r4, [r1]               ; flags, blend, texture, palette
    lw   r9, [r0+{__cam_near}]
    lhu  r5, [r1+4]
    shli r5, r5, 4
    lw   r10, [r5+{__sv}+12]
    blt  r10, r9, .nb
    lhu  r6, [r1+6]
    shli r6, r6, 4
    lw   r11, [r6+{__sv}+12]
    blt  r11, r9, .near
    add  r10, r10, r11
    lhu  r7, [r1+8]
    shli r7, r7, 4
    lw   r11, [r7+{__sv}+12]
    blt  r11, r9, .near
    add  r10, r10, r11          ; w0 + w1 + w2
    ; back faces: nclip >= 0 (front faces are counter-clockwise on screen). The positions
    ; are exact here: a corner outside the guard band went to .clip first.
    lw   r12, [r5+{__sv}+8]
    lw   r11, [r6+{__sv}+8]
    lw   r13, [r7+{__sv}+8]
    nclip r12, r11, r13
    blt  r12, r0, .front
    andi r11, r4, 16            ; double-sided
    beq  r11, r0, .next
.front:
    andi r11, r4, 4
    bne  r11, r0, .quad
    add  r11, r9, r9
    add  r11, r11, r9
    sub  r12, r10, r11          ; w0 + w1 + w2 - 3 near
    lw   r11, [r0+{__ot_k3}]
    jmp  .depth
.quad:
    lhu  r8, [r1+10]
    shli r8, r8, 4
    lw   r11, [r8+{__sv}+12]
    blt  r11, r9, .near
    add  r10, r10, r11
    shli r11, r9, 2
    sub  r12, r10, r11          ; w0 + w1 + w2 + w3 - 4 near
    lw   r11, [r0+{__ot_k4}]
.depth:
    lw   r10, [r0+{__ot_bias}]
    andi r13, r4, 32
    bne  r13, r0, .keyed        ; FACE_KEYED: the bucket is in col[3]
    otz  r10, r12, r11          ; ordering-table bucket
.dk:
    lw   r15, [r0+{__arena_ptr}]
    lw   r11, [r0+{__arena_end}]
    addi r12, r15, 52
    bltu r11, r12, .done        ; packet memory full
    lw   r12, [r0+{__fog_on}]   ; fog: bits 0 and 15; a mesh with windows: bit 16
    andi r9, r4, 15
