    and  r9, r11, r9          ; red and blue lanes
    xor  r11, r11, r9         ; green lane
    addi r3, r0, 256
    sub  r3, r3, r12          ; 256 - t
    mul  r9, r9, r3
    mul  r11, r11, r3
    lw   r3, [r0+{__fog_rb}]
    mul  r3, r3, r12
    add  r9, r9, r3
    lw   r3, [r0+{__fog_g}]
    mul  r3, r3, r12
    add  r11, r11, r3
    shri r9, r9, 8
    lw   r3, [r0+{__mask_rb}]
    and  r9, r9, r3
    shri r11, r11, 8
    andi r11, r11, 0xFF00
    or   r11, r11, r9
    jmp  .v1011_0
.v1011_f0:
    lw   r11, [r0+{__fog_rb}]
    lw   r9, [r0+{__fog_g}]
    or   r11, r11, r9
.v1011_0:
    shri r12, r4, 8           ; blend mode -> bits 24-25
    andi r12, r12, 3
    shli r12, r12, 24
    or   r11, r11, r12
    sw   r11, [r15+4]
    lw   r11, [r5]
    sw   r11, [r15+8]
    lw   r11, [r10]
    add  r10, r10, r13
    lw   r12, [r6+4]          ; fog amount
    beq  r12, r0, .v1011_1         ; in front of the fog
    slti r9, r12, 256
    beq  r9, r0, .v1011_f1
    lw   r9, [r0+{__mask_rb}]
    and  r9, r11, r9          ; red and blue lanes
    xor  r11, r11, r9         ; green lane
    addi r3, r0, 256
    sub  r3, r3, r12          ; 256 - t
    mul  r9, r9, r3
    mul  r11, r11, r3
    lw   r3, [r0+{__fog_rb}]
    mul  r3, r3, r12
    add  r9, r9, r3
    lw   r3, [r0+{__fog_g}]
    mul  r3, r3, r12
    add  r11, r11, r3
    shri r9, r9, 8
    lw   r3, [r0+{__mask_rb}]
    and  r9, r9, r3
    shri r11, r11, 8
    andi r11, r11, 0xFF00
    or   r11, r11, r9
    jmp  .v1011_1
.v1011_f1:
    lw   r11, [r0+{__fog_rb}]
    lw   r9, [r0+{__fog_g}]
    or   r11, r11, r9
.v1011_1:
    sw   r11, [r15+12]
    lw   r11, [r6]
    sw   r11, [r15+16]
    lw   r11, [r10]
    add  r10, r10, r13
    lw   r12, [r7+4]          ; fog amount
    beq  r12, r0, .v1011_2         ; in front of the fog
    slti r9, r12, 256
    beq  r9, r0, .v1011_f2
    lw   r9, [r0+{__mask_rb}]
    and  r9, r11, r9          ; red and blue lanes
    xor  r11, r11, r9         ; green lane
    addi r3, r0, 256
    sub  r3, r3, r12          ; 256 - t
    mul  r9, r9, r3
    mul  r11, r11, r3
    lw   r3, [r0+{__fog_rb}]
    mul  r3, r3, r12
    add  r9, r9, r3
    lw   r3, [r0+{__fog_g}]
    mul  r3, r3, r12
    add  r11, r11, r3
    shri r9, r9, 8
    lw   r3, [r0+{__mask_rb}]
    and  r9, r9, r3
    shri r11, r11, 8
    andi r11, r11, 0xFF00
    or   r11, r11, r9
    jmp  .v1011_2
.v1011_f2:
    lw   r11, [r0+{__fog_rb}]
    lw   r9, [r0+{__fog_g}]
    or   r11, r11, r9
.v1011_2:
    sw   r11, [r15+20]
    lw   r11, [r7]
    sw   r11, [r15+24]
    lw   r11, [r10]
    add  r10, r10, r13
    lw   r12, [r8+4]          ; fog amount
    beq  r12, r0, .v1011_3         ; in front of the fog
    slti r9, r12, 256
    beq  r9, r0, .v1011_f3
    lw   r9, [r0+{__mask_rb}]
    and  r9, r11, r9          ; red and blue lanes
    xor  r11, r11, r9         ; green lane
    addi r3, r0, 256
    sub  r3, r3, r12          ; 256 - t
    mul  r9, r9, r3
    mul  r11, r11, r3
    lw   r3, [r0+{__fog_rb}]
    mul  r3, r3, r12
    add  r9, r9, r3
    lw   r3, [r0+{__fog_g}]
    mul  r3, r3, r12
    add  r11, r11, r3
    shri r9, r9, 8
    lw   r3, [r0+{__mask_rb}]
    and  r9, r9, r3
    shri r11, r11, 8
    andi r11, r11, 0xFF00
    or   r11, r11, r9
    jmp  .v1011_3
.v1011_f3:
    lw   r11, [r0+{__fog_rb}]
    lw   r9, [r0+{__fog_g}]
    or   r11, r11, r9
.v1011_3:
    sw   r11, [r15+28]
    lw   r11, [r8]
    sw   r11, [r15+32]
    la   r3, {__sv}
    jmp  .next
.v1111:   ; gouraud textured quad fog, 52 bytes
    addi r11, r15, 52
    sw   r11, [r0+{__arena_ptr}]
    andi r13, r4, 1
    shli r13, r13, 2
    addi r10, r1, 12
    lw   r11, [r10]
    add  r10, r10, r13
    lw   r12, [r5+4]          ; fog amount
    beq  r12, r0, .v1111_0         ; in front of the fog
    slti r9, r12, 256
    beq  r9, r0, .v1111_f0
    lw   r9, [r0+{__mask_rb}]
    and  r9, r11, r9          ; red and blue lanes
    xor  r11, r11, r9         ; green lane
    addi r3, r0, 256
    sub  r3, r3, r12          ; 256 - t
    mul  r9, r9, r3
    mul  r11, r11, r3
    lw   r3, [r0+{__fogt_rb}]
    mul  r3, r3, r12
    add  r9, r9, r3
    lw   r3, [r0+{__fogt_g}]
    mul  r3, r3, r12
    add  r11, r11, r3
    shri r9, r9, 8
    lw   r3, [r0+{__mask_rb}]
    and  r9, r9, r3
    shri r11, r11, 8
    andi r11, r11, 0xFF00
    or   r11, r11, r9
    jmp  .v1111_0
.v1111_f0:
    lw   r11, [r0+{__fogt_rb}]
    lw   r9, [r0+{__fogt_g}]
    or   r11, r11, r9
.v1111_0:
    shri r12, r4, 8           ; blend mode -> bits 24-25
    andi r12, r12, 3
    shli r12, r12, 24
    or   r11, r11, r12
    sw   r11, [r15+4]
    lw   r11, [r5]
    sw   r11, [r15+8]
    lhu  r11, [r1+28]
    shri r12, r4, 16          ; slot, depth and palette -> bits 16-31
    andi r12, r12, 0xFF1F
    shli r12, r12, 16
    or   r11, r11, r12
    sw   r11, [r15+12]
    lw   r11, [r10]
    add  r10, r10, r13
    lw   r12, [r6+4]          ; fog amount
    beq  r12, r0, .v1111_1         ; in front of the fog
    slti r9, r12, 256
    beq  r9, r0, .v1111_f1
    lw   r9, [r0+{__mask_rb}]
    and  r9, r11, r9          ; red and blue lanes
    xor  r11, r11, r9         ; green lane
    addi r3, r0, 256
    sub  r3, r3, r12          ; 256 - t
    mul  r9, r9, r3
    mul  r11, r11, r3
    lw   r3, [r0+{__fogt_rb}]
    mul  r3, r3, r12
    add  r9, r9, r3
    lw   r3, [r0+{__fogt_g}]
    mul  r3, r3, r12
    add  r11, r11, r3
    shri r9, r9, 8
    lw   r3, [r0+{__mask_rb}]
    and  r9, r9, r3
    shri r11, r11, 8
    andi r11, r11, 0xFF00
    or   r11, r11, r9
    jmp  .v1111_1
.v1111_f1:
    lw   r11, [r0+{__fogt_rb}]
    lw   r9, [r0+{__fogt_g}]
    or   r11, r11, r9
.v1111_1:
    sw   r11, [r15+16]
    lw   r11, [r6]
    sw   r11, [r15+20]
    lhu  r11, [r1+30]
    sw   r11, [r15+24]
    lw   r11, [r10]
    add  r10, r10, r13
    lw   r12, [r7+4]          ; fog amount
    beq  r12, r0, .v1111_2         ; in front of the fog
    slti r9, r12, 256
    beq  r9, r0, .v1111_f2
    lw   r9, [r0+{__mask_rb}]
    and  r9, r11, r9          ; red and blue lanes
    xor  r11, r11, r9         ; green lane
    addi r3, r0, 256
    sub  r3, r3, r12          ; 256 - t
    mul  r9, r9, r3
    mul  r11, r11, r3
    lw   r3, [r0+{__fogt_rb}]
    mul  r3, r3, r12
    add  r9, r9, r3
    lw   r3, [r0+{__fogt_g}]
    mul  r3, r3, r12
    add  r11, r11, r3
    shri r9, r9, 8
    lw   r3, [r0+{__mask_rb}]
    and  r9, r9, r3
    shri r11, r11, 8
    andi r11, r11, 0xFF00
    or   r11, r11, r9
    jmp  .v1111_2
.v1111_f2:
    lw   r11, [r0+{__fogt_rb}]
    lw   r9, [r0+{__fogt_g}]
    or   r11, r11, r9
.v1111_2:
    sw   r11, [r15+28]
    lw   r11, [r7]
    sw   r11, [r15+32]
    lhu  r11, [r1+32]
    sw   r11, [r15+36]
    lw   r11, [r10]
    add  r10, r10, r13
    lw   r12, [r8+4]          ; fog amount
    beq  r12, r0, .v1111_3         ; in front of the fog
    slti r9, r12, 256
    beq  r9, r0, .v1111_f3
    lw   r9, [r0+{__mask_rb}]
    and  r9, r11, r9          ; red and blue lanes
    xor  r11, r11, r9         ; green lane
    addi r3, r0, 256
    sub  r3, r3, r12          ; 256 - t
    mul  r9, r9, r3
    mul  r11, r11, r3
    lw   r3, [r0+{__fogt_rb}]
    mul  r3, r3, r12
    add  r9, r9, r3
    lw   r3, [r0+{__fogt_g}]
    mul  r3, r3, r12
    add  r11, r11, r3
    shri r9, r9, 8
    lw   r3, [r0+{__mask_rb}]
    and  r9, r9, r3
    shri r11, r11, 8
    andi r11, r11, 0xFF00
    or   r11, r11, r9
    jmp  .v1111_3
.v1111_f3:
    lw   r11, [r0+{__fogt_rb}]
    lw   r9, [r0+{__fogt_g}]
    or   r11, r11, r9
.v1111_3:
    sw   r11, [r15+40]
    lw   r11, [r8]
    sw   r11, [r15+44]
    lhu  r11, [r1+34]
    sw   r11, [r15+48]
    la   r3, {__sv}
    jmp  .next
.next:
    addi r1, r1, 36
    addi r2, r2, -1
    bne  r2, r0, .face
.done:
    lw   r9, [sp+0]
    lw   r10, [sp+4]
    lw   r11, [sp+8]
    lw   r12, [sp+12]
    lw   r13, [sp+16]
    lw   ra, [sp+20]
    addi sp, sp, 24
    ret
    .align 4
.table:
    .word .v0000
    .word .v1000
    .word .v0100
    .word .v1100
    .word .v0010
    .word .v1010
    .word .v0110
    .word .v1110
    .word .v1001
    .word .v1001
    .word .v1101
    .word .v1101
    .word .v1011
    .word .v1011
    .word .v1111
    .word .v1111
}

// The same loop for carts that called subdivide(): see the header of gen_faces_asm.py.
asm fn __draw_faces_sub(first: *Face, nf: s32) {
    addi sp, sp, -56
    sw   r9, [sp+0]
    sw   r10, [sp+4]
    sw   r11, [sp+8]
    sw   r12, [sp+12]
    sw   r13, [sp+16]
    sw   ra, [sp+20]
    la   r3, {__sv}
    beq  r2, r0, .done
.face:
    lw   r4, [r1]               ; flags, blend, texture, palette
    lw   r9, [r0+{__cam_near}]
    lhu  r5, [r1+4]
    shli r5, r5, 4
    add  r5, r5, r3
    lw   r10, [r5+12]
    mov  r12, r10               ; nearest w
    mov  r13, r10               ; farthest w
    lhu  r6, [r1+6]
    shli r6, r6, 4
    add  r6, r6, r3
    lw   r11, [r6+12]
    add  r10, r10, r11
    bge  r11, r12, .n1
    mov  r12, r11
.n1:
    bge  r13, r11, .f1
    mov  r13, r11
.f1:
    lhu  r7, [r1+8]
    shli r7, r7, 4
    add  r7, r7, r3
    lw   r11, [r7+12]
    add  r10, r10, r11          ; w0 + w1 + w2
    bge  r11, r12, .n2
    mov  r12, r11
.n2:
    bge  r13, r11, .f2
    mov  r13, r11
.f2:
    andi r11, r4, 4
    beq  r11, r0, .mm
    lhu  r8, [r1+10]
    shli r8, r8, 4
    add  r8, r8, r3
    lw   r11, [r8+12]
    bge  r11, r12, .n3
    mov  r12, r11
.n3:
    bge  r13, r11, .mm
    mov  r13, r11
.mm:
    blt  r13, r9, .next         ; wholly behind the near plane
    andi r11, r4, 2
    beq  r11, r0, .plain        ; untextured faces are never split
    blt  r12, r9, .test         ; crosses the near plane
    lw   r11, [r0+{__sub_dist}]
    bge  r12, r11, .nosub       ; nearest vertex beyond the subdivision distance
    lw   r11, [r0+{__sub_q}]
    fmul r11, r12, r11
    add  r11, r11, r12
    bge  r11, r13, .nosub       ; depth spread within the tolerance: no edge can split
.test:
    ; screen bounding box of the vertices in front of the near plane
    addi r11, r0, 32767
    sw   r11, [sp+36]
    sw   r11, [sp+44]
    addi r11, r0, -32768
    sw   r11, [sp+40]
    sw   r11, [sp+48]
    lw   r11, [r5+12]
    blt  r11, r9, .bb0
    lw   r11, [r5]
    shli r15, r11, 16
    sari r15, r15, 16
    sari r11, r11, 16
    lw   r3, [sp+36]
    bge  r15, r3, .bx0a
    sw   r15, [sp+36]
.bx0a:
    lw   r3, [sp+40]
    bge  r3, r15, .bx0b
    sw   r15, [sp+40]
.bx0b:
    lw   r3, [sp+44]
    bge  r11, r3, .by0a
    sw   r11, [sp+44]
.by0a:
    lw   r3, [sp+48]
    bge  r3, r11, .bb0
    sw   r11, [sp+48]
.bb0:
    lw   r11, [r6+12]
    blt  r11, r9, .bb1
    lw   r11, [r6]
    shli r15, r11, 16
    sari r15, r15, 16
    sari r11, r11, 16
    lw   r3, [sp+36]
    bge  r15, r3, .bx1a
    sw   r15, [sp+36]
.bx1a:
    lw   r3, [sp+40]
    bge  r3, r15, .bx1b
    sw   r15, [sp+40]
.bx1b:
    lw   r3, [sp+44]
    bge  r11, r3, .by1a
    sw   r11, [sp+44]
.by1a:
    lw   r3, [sp+48]
    bge  r3, r11, .bb1
    sw   r11, [sp+48]
.bb1:
    lw   r11, [r7+12]
    blt  r11, r9, .bb2
    lw   r11, [r7]
    shli r15, r11, 16
    sari r15, r15, 16
    sari r11, r11, 16
    lw   r3, [sp+36]
    bge  r15, r3, .bx2a
    sw   r15, [sp+36]
.bx2a:
    lw   r3, [sp+40]
    bge  r3, r15, .bx2b
    sw   r15, [sp+40]
.bx2b:
    lw   r3, [sp+44]
    bge  r11, r3, .by2a
    sw   r11, [sp+44]
.by2a:
    lw   r3, [sp+48]
    bge  r3, r11, .bb2
    sw   r11, [sp+48]
.bb2:
    andi r11, r4, 4
    beq  r11, r0, .bbq
    lw   r11, [r8+12]
    blt  r11, r9, .bb3
    lw   r11, [r8]
    shli r15, r11, 16
    sari r15, r15, 16
    sari r11, r11, 16
    lw   r3, [sp+36]
    bge  r15, r3, .bx3a
    sw   r15, [sp+36]
.bx3a:
    lw   r3, [sp+40]
    bge  r3, r15, .bx3b
    sw   r15, [sp+40]
.bx3b:
    lw   r3, [sp+44]
    bge  r11, r3, .by3a
    sw   r11, [sp+44]
.by3a:
    lw   r3, [sp+48]
    bge  r3, r11, .bb3
    sw   r11, [sp+48]
.bb3:
.bbq:
    la   r3, {__sv}
    lw   r11, [sp+40]
    blt  r11, r0, .next         ; all left of the screen
    lw   r11, [sp+36]
    slti r11, r11, 321
    beq  r11, r0, .next         ; all right of it
    lw   r11, [sp+48]
    blt  r11, r0, .next         ; all above
    lw   r11, [sp+44]
    slti r11, r11, 241
    beq  r11, r0, .next         ; all below
    blt  r12, r9, .sub          ; crosses the near plane and may be seen: split it
    addi r11, r0, 1             ; a candidate (if front-facing)
    sw   r11, [sp+24]
    jmp  .cull
.nosub:
    sw   r0, [sp+24]
    jmp  .cull
.plain:
    blt  r12, r9, .next
    sw   r0, [sp+24]
.cull:
    ; back faces: (x1-x0)*(y2-y0) - (x2-x0)*(y1-y0) >= 0 (front faces are counter-clockwise)
    lw   r12, [r5]
    shli r13, r12, 16
    sari r13, r13, 16           ; x0
    sari r12, r12, 16           ; y0
    lw   r11, [r6]
    shli r15, r11, 16
    sari r15, r15, 16
    sub  r15, r15, r13          ; x1 - x0
    sari r11, r11, 16
    sub  r11, r11, r12          ; y1 - y0
    lw   r8, [r7]
    shli r3, r8, 16
    sari r3, r3, 16
    sub  r3, r3, r13            ; x2 - x0
    sari r8, r8, 16
    sub  r8, r8, r12            ; y2 - y0
    mul  r15, r15, r8
    mul  r3, r3, r11
    sub  r15, r15, r3
    la   r3, {__sv}
    blt  r15, r0, .front
    andi r11, r4, 16            ; double-sided
    beq  r11, r0, .next
.front:
    lw   r11, [sp+24]
    bne  r11, r0, .sub
    andi r11, r4, 4
    bne  r11, r0, .quad
    add  r11, r9, r9
    add  r11, r11, r9
    sub  r10, r10, r11
    lw   r11, [r0+{__ot_k3}]
    jmp  .depth
.quad:
    lhu  r8, [r1+10]
    shli r8, r8, 4
    add  r8, r8, r3
    lw   r11, [r8+12]
    blt  r11, r9, .next
    add  r10, r10, r11
    shli r11, r9, 2
    sub  r10, r10, r11
    lw   r11, [r0+{__ot_k4}]
.depth:
    fmul r10, r10, r11          ; ordering-table bucket
    sari r10, r10, 16
    lw   r11, [r0+{__ot_bias}]
    add  r10, r10, r11
    bge  r10, r0, .d1
    mov  r10, r0
.d1:
    slti r11, r10, 1024
    bne  r11, r0, .d2
    addi r10, r0, 1023
.d2:
    lw   r15, [r0+{__arena_ptr}]
    lw   r11, [r0+{__arena_end}]
    addi r12, r15, 52
    bltu r11, r12, .done        ; packet memory full
    lbu  r12, [r0+{__fog_on}]
    andi r9, r4, 15
    or   r9, r9, r12            ; fog makes every face Gouraud
    ; header and ordering-table insertion
    la   r11, {__ot}
    shli r10, r10, 2
    add  r11, r11, r10
    lw   r10, [r11]
    ori  r13, r9, 0x20
    shli r13, r13, 24
    or   r10, r10, r13
    sw   r10, [r15]
