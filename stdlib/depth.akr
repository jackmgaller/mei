// The depth buffer and perspective-correct texturing (docs/RENDERING.md) for mesh*(). Not part
// of the prelude: a cart that uses them says `import "depth.akr"`, then render_depth(true) and/or
// render_perspective(true). A cart that does not import it draws exactly as before, and one that
// imports it draws as before until it turns one of them on.
//
// While either is on, mesh*() draws with the face loops of depth_faces.akr (generated by
// tools/gen_faces_asm.py --depth): every face becomes a packet with depth (0x30-0x3F, the corners'
// view depths after the usual words), and the GPU maps every textured one perspective-correct, so
// render_depth(true) brings perspective with it, and subdivide() is ignored (it only straightens
// affine textures). While the depth test is on, faces do not go into the
// frame's ordering table but into two of depth.akr's, spliced in ahead of the frame's entries so
// that one list draws them all at the end of the frame: opaque faces nearest bucket first (so
// that early depth rejects what they hide for 1 cycle a pixel), then semi-transparent faces back
// to front (they test, but write no depth). The frame's table follows: whatever ot_insert() put
// there is drawn after the scene (packets the cart built, with depth or without), except bucket
// 1023, which is drawn before it. The depth buffer is cleared (GPU_ZCLEAR 0) at the start of every
// frame while the test is on.
//
// Works with planes.akr: a face drawn while poly_upper() is on is upper, as with the plain loops.
// A drawn face costs 14-24 CPU cycles more than without depth (docs/LANGUAGE.md, "Performance
// notes"); the two tables cost about 3,000 cycles a frame to empty, and 8 KB of RAM.

import "depth_faces.akr"
import "worldpack.akr"         // (wp_draw() and wp_draw_object() in depth mode, below)

var __z_test: bool             // render_depth()
var __z_persp: bool            // render_perspective()
var __z_on: bool               // either: mesh*() writes packets with depth
var __z_ready: bool            // this frame's buffer is cleared and its tables spliced in
var __z_off: u32               // depth_offset() << 11 (bits 27-31 of the colour word, via the flags)
var __z_flags: u32             // what the depth loops OR into a face's flags word (+ upper, 0x400)
var __z_tab: [2]u32            // where the depth loops put opaque and semi-transparent faces
var __zo: [1024]u32            // opaque faces: entry k links to k + 1, entry 1023 to __zt[1023]
var __zt: [1024]u32            // semi-transparent faces: entry k links to k - 1, entry 0 on

// Turns the depth test on or off for mesh*() (off at the start). On, mesh*() writes packets with
// depth that hide each other per pixel, whatever order they are drawn in (their textures are
// perspective-correct too), and the buffer is cleared every frame. GPU_DEPTH applies to every list the GPU draws while it is set, so the test
// stays on for the rest of the frame once turned on (render_depth(false) stops mesh*() from making
// packets for it); a frame that starts with it off draws untested.
fn render_depth(on: bool) {
    __z_test = on
    if on {
        GPU_DEPTH = 1
        if !__z_ready { __z_setup() }
    }
    __z_mode()
}

// Turns perspective-correct texturing on or off for mesh*() (off at the start). On, mesh*() writes
// packets with depth, whose textures the GPU maps perspective-correct (a divide every 16 pixels);
// with the depth test off they are drawn untested in the frame's ordering table, back to front,
// as before. (With the test on, textures are perspective-correct whatever this says.)
fn render_perspective(on: bool) {
    __z_persp = on
    __z_mode()
}

// Whether render_depth() is on.
fn depth_on() -> bool { return __z_test }

// Moves the faces of the following mesh*() calls n key steps nearer in the depth test (0-31,
// clamped; 0 is off): for decals, such as a sign or a road marking on a wall or a floor, so that
// coplanar faces don't fight. A step is 1/4,096 of the depth, so the same n works at any distance;
// 2 is enough for a surface seen face on, one seen at a grazing angle needs more (RENDERING.md,
// "Precision"). Stays set until changed.
fn depth_offset(n: s32) { __z_off = (clamp(n, 0, 31) as u32) << 11 }

fn __z_mode() {
    __z_on = __z_test || __z_persp
    if __z_test {
        __z_tab[0] = &__zo[0] as u32
        __z_tab[1] = &__zt[0] as u32
    } else {
        __z_tab[0] = &__ot[0] as u32
        __z_tab[1] = &__ot[0] as u32
    }
}

// Clears the depth buffer and splices the two (empty) tables in for this frame.
fn __z_setup() {
    GPU_ZCLEAR = 0
    __z_link()
    __z_ready = true
}

// Empties the two tables and splices them in at the head of the frame's ordering table (after
// what its bucket 1023 holds already).
fn __z_link() {
    __zo_reset(&__zo[0], &__zt[1023] as u32)
    __ot_reset(&__zt[0])
    __zt[0] = __ot[1023]
    __ot[1023] = &__zo[0] as u32
}

// Links entry i of the table at t to entry i + 1 and entry 1023 to `last`: drawn from entry 0.
asm fn __zo_reset(t: *u32, last: u32) {
    addi r3, {t}, 4
    vset v0, r3, 0
    addi r3, {t}, 8
    vset v0, r3, 1
    addi r3, {t}, 12
    vset v0, r3, 2
    addi r3, {t}, 16
    vset v0, r3, 3
    addi r3, r0, 16
    vset v1, r3, 0
    vset v1, r3, 1
    vset v1, r3, 2
    vset v1, r3, 3
    mov  r3, {t}
    addi r4, r0, 32
.loop:
    vst  v0, [r3+0]
    vadd v0, v0, v1
    vst  v0, [r3+16]
    vadd v0, v0, v1
    vst  v0, [r3+32]
    vadd v0, v0, v1
    vst  v0, [r3+48]
    vadd v0, v0, v1
    vst  v0, [r3+64]
    vadd v0, v0, v1
    vst  v0, [r3+80]
    vadd v0, v0, v1
    vst  v0, [r3+96]
    vadd v0, v0, v1
    vst  v0, [r3+112]
    vadd v0, v0, v1
    addi r3, r3, 128
    addi r4, r4, -1
    bne  r4, r0, .loop
    sw   {last}, [{t}+4092]
}

// The upper bit (0x400 in a face's flags word) while planes.akr's poly_upper() is on: planes.akr
// replaces this.
weak fn __z_upper() -> u32 { return 0 }

fn __z_room(nf: s32) -> bool { return ((__arena_end as u32) - (__arena_ptr as u32)) as s32 >= nf * 68 }

// ---- what depth.akr replaces (each the same as before while both modes are off)

// (replaces runtime.akr's) The same, then this frame's depth buffer and tables.
fn __rt_frame_begin() {
    __ot_reset(&__ot[0])
    __arena_ptr = &__arena[0]
    __arena_end = &__arena[0] + ARENA_WORDS
    __ui_tail = null
    __ot_user = 0
    depth_key_off()
    __z_ready = false
    GPU_DEPTH = __z_test as u32
    if __z_test { __z_setup() }
}

// (replaces render.akr's) The same, and the depth tables are emptied and spliced in again.
fn ot_clear() {
    __ot_reset(&__ot[0])
    if __z_ready { __z_link() }
}

// (replaces render.akr's) The same: the depth tables are drawn with the frame's table (they are
// spliced into it), then emptied and spliced in again. The depth buffer is not cleared.
fn ot_flush() -> s32 {
    let n = ot_draw(&__ot[0])
    __ot_reset(&__ot[0])
    if __z_ready { __z_link() }
    return n
}

// (replaces gfx.akr's) The same, with the depth loops while a mode is on.
fn __draw_mesh(m: *Mesh, mvp: mat4) {
    let nv = m.nverts as s32
    if nv > MAX_MESH_VERTS {
        println("mesh(): too many vertices")
        return
    }
    if m.windows != 0 {
        if __z_on { __zdraw_mesh_win(m, mvp) } else { __draw_mesh_win(m, mvp) }
        return
    }
    let base = m as u32
    let src = (base + m.verts) as *vec4
    let faces = (base + m.faces) as *Face
    let nf = m.nfaces as s32
    __clip_src = src      // for faces clip.akr has to clip
    __clip_m = &mvp
    let inside = __xform(src, nv, &__sv[0], &mvp)
    if __z_on {
        __z_flags = __z_off | __z_upper()
        if inside & 1 == 0 {
            __zdraw_faces(faces, nf)
        } else if inside == 3 && __fog_on == 0 && __z_room(nf) {
            __zdraw_faces_safe(faces, nf)
        } else {
            __zdraw_faces_in(faces, nf)
        }
    } else if __subdiv > 0 {
        __sub_src = src
        __sub_mvp = mvp
        __draw_faces_sub(faces, nf)
    } else if inside & 1 == 0 {
        __draw_faces(faces, nf)
    } else if inside == 3 && __fog_on == 0 && __arena_room(nf) {
        __draw_faces_safe(faces, nf)
    } else {
        __draw_faces_in(faces, nf)
    }
}

// gfx.akr's __draw_mesh_win with the depth loops.
fn __zdraw_mesh_win(m: *Mesh, mvp: mat4) {
    __win_tab = m as u32 + m.windows
    __fog_on = __fog_on | 0x10000
    __z_flags = __z_off | __z_upper()
    let base = m as u32
    let src = (base + m.verts) as *vec4
    let faces = (base + m.faces) as *Face
    __clip_src = src
    __clip_m = &mvp
    let inside = __xform(src, m.nverts as s32, &__sv[0], &mvp)
    if inside & 1 == 0 {
        __zdraw_faces(faces, m.nfaces as s32)
    } else {
        __zdraw_faces_in(faces, m.nfaces as s32)
    }
    __fog_on = __fog_on & 0xFFFF
}

// (replaces gfx.akr's) The same, with the depth loops while a mode is on.
fn __draw_mesh_safe(m: *Mesh, mvp: mat4) {
    let nf = m.nfaces as s32
    if m.windows != 0 || __fog_on != 0 || (__subdiv > 0 && !__z_on) || m.nverts as s32 > MAX_MESH_VERTS {
        __draw_mesh(m, mvp)
        return
    }
    let base = m as u32
    if __z_on {
        if !__z_room(nf) {
            __draw_mesh(m, mvp)
            return
        }
        __z_flags = __z_off | __z_upper()
        __xform_safe((base + m.verts) as *vec4, m.nverts as s32, &__sv[0], &mvp)
        __zdraw_faces_safe((base + m.faces) as *Face, nf)
    } else {
        if !__arena_room(nf) {
            __draw_mesh(m, mvp)
            return
        }
        __xform_safe((base + m.verts) as *vec4, m.nverts as s32, &__sv[0], &mvp)
        __draw_faces_safe((base + m.faces) as *Face, nf)
    }
}

// (replaces clip.akr's) The same, with the depth loops while a mode is on.
fn __clip_draw(f: *Face) {
    var n = __clip_n
    let planes = __clip_planes
    var src = &__clip_p[0]
    var dst = &__clip_q[0]
    for q in 0..5 {
        let p = (q + 4) % 5                       // the near plane (4) first
        if (planes >> p) & 1 != 0 {
            let r = __clip_plane(src, n, dst, p)
            if r >= 0 {
                if r < 3 { return }               // wholly outside
                n = r
                let t = src
                src = dst
                dst = t
            }
            if p == 4 && __clip_offview(src, n) { return }
        }
    }
    __clip_v = src
    for k in 0..n { __clip_put(src[k].c, k) }
    var np = 0
    var i = 1
    while i + 1 < n {
        if i + 2 < n {
            __clip_piece(&__clip_out[np], f, i, i + 1, 0, i + 2)
            i += 2
        } else {
            __clip_piece(&__clip_out[np], f, 0, i, i + 1, -1)
            i += 1
        }
        np += 1
    }
    if __z_on { __zdraw_faces(&__clip_out[0], np) } else { __draw_faces(&__clip_out[0], np) }
}

// ---- the world reader (worldpack.akr) in depth mode
//
// The depth buffer orders the world, so what wp_draw() and wp_draw_object() do to help the
// ordering table is skipped while the test is on. A cart that does not use worldpack.akr pays
// nothing for these (unused functions take no ROM).

// (replaces worldpack.akr's) The same with the depth test off. With it on: the far pass's
// stand-ins and every near placement, ground or not, go into the same tables, without ot_flush()
// and without the ground pass (wp_stats.ground stays 0), all sorted over one clip range,
// wp_clip_near to the far pass's far depth (wp_near_far without a far pass), which it leaves set.
// The opaque table then draws the whole scene nearest first.
fn wp_draw(eye: vec3, yaw: fixed, pitch: fixed) {
    let z = __z_test
    let ci = wp_cell_index(eye.x)
    let cj = wp_cell_index(eye.z)
    __wp_origin = vec3(fixed(ci << __wp_shift) + __wp_half, 0.0, fixed(cj << __wp_shift) + __wp_half)
    let local = eye - __wp_origin
    __wp_eye_y = eye.y
    __wp_eye = vec4(local.x, local.y, local.z, 0.0)
    wp_stats = WpStats {}
    __wp_zone_find(wp_cell(ci, cj))
    let size = __wp_half * 2
    let r = wp_far_ring
    var far = wp_near_far
    if r >= 2 {
        let farp = size * (2 * r + 1) * 3 / 4
        if z {
            far = max(far, farp)
            camera_clip(wp_clip_near, far)
        } else {
            camera_clip(__wp_half, farp)
        }
        camera_look(local, yaw, pitch)
        __wp_frustum(__wp_half, farp)
        for dj in -r..r + 1 {
            for di in -r..r + 1 {
                if max(abs(di), abs(dj)) < 2 { continue }
                let c = wp_cell(ci + di, cj + dj)
                if c != null && c.standin_off != 0 { __wp_standin(c, di, dj) }
            }
        }
        if !z { ot_flush() }
    }
    if !z || r < 2 {
        camera_clip(wp_clip_near, far)
        camera_look(local, yaw, pitch)
    }
    __wp_frustum(wp_clip_near, wp_near_far)
    let ground = wp_ground_first && __wp_ground && !z
    if ground {
        for dj in -1..2 {
            for di in -1..2 {
                let c = wp_cell(ci + di, cj + dj)
                if c == null || c.ground_count == 0 { continue }
                if wp_region_loaded >= 0 && c.region as s32 != wp_region_loaded { continue }
                wp_stats.ground += __wp_placements(c, di, dj, 0, c.ground_count as s32)
            }
        }
        if wp_stats.ground != 0 { ot_flush() }
    }
    for dj in -1..2 {
        for di in -1..2 {
            let c = wp_cell(ci + di, cj + dj)
            if c == null { continue }
            if wp_region_loaded >= 0 && c.region as s32 != wp_region_loaded {
                if c.standin_off != 0 { __wp_standin(c, di, dj) }
            } else if c.placement_count != 0 {
                wp_stats.near_cells += 1
                var k0 = 0
                if ground { k0 = c.ground_count as s32 }
                __wp_placements(c, di, dj, k0, c.placement_count as s32)
            }
        }
    }
}

// (replaces worldpack.akr's) The same with the depth test off. With it on, the object is drawn
// with its own faces' depths: no depth_key(), no wp_object_bias (the cart's depth_bias() still
// applies, to the order only).
fn wp_draw_object(m: *Mesh, pos: vec3, yaw: fixed, radius: fixed, base: fixed) -> bool {
    let t = pos - __wp_origin
    let ts = vec4(t.x, t.y, t.z, radius)
    if radius > 0.0 && !__wp_visible(ts) { return false }
    let safe = radius > 0.0 && __wp_safe(ts)
    if __z_test {
        __wp_mesh(m, vec4(t.x, t.y, t.z, 0.0), cos(yaw), sin(yaw), safe)
        return true
    }
    let near = view_depth(t) - radius
    var w = near
    if __wp_eye_y > base { w -= min(wp_object_bias, max(w - wp_clip_near, 0.0)) }
    if wp_object_squash > 1 {
        depth_key(w, wp_object_squash)
        __wp_mesh(m, vec4(t.x, t.y, t.z, 0.0), cos(yaw), sin(yaw), safe)
        depth_key_off()
    } else {
        let user = __ot_user        // no key: the bias alone
        depth_bias(user - ((near - w) * buckets_per_unit()) as s32)
        __wp_mesh(m, vec4(t.x, t.y, t.z, 0.0), cos(yaw), sin(yaw), safe)
        depth_bias(user)
    }
    return true
}
