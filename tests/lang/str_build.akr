// String helpers (stdlib/str.akr): lengths, comparison and building strings in a buffer.
var buf: [32]u8

fn show(s: *u8) {
    print("[")
    print(s)
    println("]")
}

fn init() {
    let b = &buf[0]
    assert_eq(strlen(""), 0)
    assert_eq(strlen("hello"), 5)
    assert(streq("abc", "abc"))
    assert(!streq("abc", "abd"))
    assert(!streq("ab", "abc"))
    assert(!streq("abc", "ab"))
    assert(streq("", ""))

    show(str_copy(b, 32, "Day "))                          // expect: [Day ]
    show(str_append_int(b, 32, 12, 0, false))              // expect: [Day 12]
    show(str_append(str_copy(b, 32, "a"), 32, "bc"))       // expect: [abc]
    show(str_append_char(b, 32, '!'))                      // expect: [abc!]

    // integers: width and padding
    show(str_append_int(str_copy(b, 32, ""), 32, 0, 0, false))        // expect: [0]
    show(str_append_int(str_copy(b, 32, ""), 32, -45, 0, false))      // expect: [-45]
    show(str_append_int(str_copy(b, 32, ""), 32, 7, 3, true))         // expect: [007]
    show(str_append_int(str_copy(b, 32, ""), 32, -7, 4, true))        // expect: [-007]
    show(str_append_int(str_copy(b, 32, ""), 32, -7, 4, false))       // expect: [  -7]
    show(str_append_int(str_copy(b, 32, ""), 32, 12345, 3, true))     // expect: [12345]
    show(str_append_int(str_copy(b, 32, ""), 32, -2147483648, 0, false))  // expect: [-2147483648]

    // fixed point with N decimals, rounded half away from zero
    show(str_append_fixed(str_copy(b, 32, ""), 32, 3.14159, 2))       // expect: [3.14]
    show(str_append_fixed(str_copy(b, 32, ""), 32, 2.0, 1))           // expect: [2.0]
    show(str_append_fixed(str_copy(b, 32, ""), 32, 1.5, 0))           // expect: [2]
    show(str_append_fixed(str_copy(b, 32, ""), 32, -1.25, 1))         // expect: [-1.3]
    show(str_append_fixed(str_copy(b, 32, ""), 32, -0.04, 1))         // expect: [0.0]
    show(str_append_fixed(str_copy(b, 32, ""), 32, 0.99999, 3))       // expect: [1.000]
    show(str_append_fixed(str_copy(b, 32, ""), 32, 12.5, 4))          // expect: [12.5000]

    // clocks: seconds as m:ss, minutes as h:mm
    show(str_append_time(str_copy(b, 32, ""), 32, 125))               // expect: [2:05]
    show(str_append_time(str_copy(b, 32, ""), 32, 605))               // expect: [10:05]
    show(str_append_time(str_copy(b, 32, ""), 32, 59))                // expect: [0:59]
    show(str_append_time(str_copy(b, 32, ""), 32, -61))               // expect: [-1:01]

    // the buffer size is respected (the NUL included)
    show(str_copy(b, 8, "truncated text"))                 // expect: [truncat]
    show(str_append(b, 8, "more"))                         // expect: [truncat]
    show(str_append_int(str_copy(b, 6, "n="), 6, 12345, 0, false))   // expect: [n=123]
    buf[20] = 'x'
    str_copy(b, 20, "0123456789012345678901234")
    assert_eq(strlen(b), 19)
    assert_eq(buf[20] as s32, 'x')
}
