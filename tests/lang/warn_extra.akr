// meic -W: unused locals and parameters, values never read, a loop variable hidden, a bool result ignored.
// flags: -W
// warning: parameter 'b' of add() is never used (call it _b if that is intended)
// warning: 'unused' is never used
// warning: 'written' is assigned but its value is never read
// warning: this variable 'i' hides the loop variable 'i' of the enclosing loop (line 22)
// warning: the bool result of found() is ignored (test it with 'if', or write 'let _ = ...' to discard it)
var hits = 0

fn add(a: s32, b: s32) -> s32 { return a + 1 }
fn quiet(_x: s32) {}
fn found(n: s32) -> bool { hits += 1; return n > 2 }

fn init() {
    let unused = 4
    var written = 1
    written = 2
    var total = 0
    total += 3
    var t = 0
    t = 5
    for i in 0..3 {
        for j in 0..2 { total += j }
        let i = 7
        total += i
    }
    found(5)
    let _ = found(1)
    let _ = found(9)
    let f = fn(v: s32) => v * t
    quiet(f(1))
    print_int(add(total, 1)); println("")   // expect: 28
    print_int(hits); println("")            // expect: 3
}
