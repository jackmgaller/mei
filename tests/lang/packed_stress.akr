// Generated coverage of every bit alignment and unsigned width boundary.
// flags: -g
fn check_bytes(p: *u8, shift: s32, width: s32, n: s32, value: u32) {
    for b in 0..n {
        var expected: u8 = 0
        for k in 0..8 {
            let bit = b * 8 + k
            var set: bool
            if bit >= shift && bit < shift + width { set = ((value >> (bit - shift)) & 1) != 0 }
            else { set = ((0xa5 >> k) & 1) != 0 }
            if set { expected |= (1 << k) as u8 }
        }
        assert_eq(p[b], expected)
    }
}
