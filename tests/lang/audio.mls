// Sound channels: play, position, stop.
// frames: 3
embed SAMPLE: s8 = "data/sample.raw"

fn init() {
    play(2, SAMPLE, len(SAMPLE), 1.0, 200, 100, false)
    play(3, SAMPLE, 100, 2.0, 255, 255, true)
    if sound_playing(2) { println("playing") }   // expect: playing
}

fn update() {
    if frame() == 2 {
        let p = sound_pos(2)
        if p >= 734 && p <= 736 { println("pos ok") }   // expect: pos ok
        if sound_playing(3) { println("looping") }      // expect: looping
        stop(2)
        if !sound_playing(2) { println("stopped") }     // expect: stopped
    }
}
