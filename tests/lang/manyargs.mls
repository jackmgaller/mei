// Calls with more arguments than argument registers, mixed classes, aggregates.
fn p(n: s32) { print_int(n); print_char('\n') }
fn pf(f: fixed) { print_fixed(f); print_char('\n') }

struct Pt { a: s32, b: s32 }

fn f6(a: s32, b: s32, c: s32, d: s32, e: s32, f: s32) -> s32 {
    return a + 2 * b + 3 * c + 4 * d + 5 * e + 6 * f
}
fn mix(a: s32, v: vec3, b: fixed, w: vec4, c: s32, s: Pt, d: s32, e: s32, f: s32, u: vec2, x: vec3, y: vec4) -> fixed {
    return (a + c + s.a + s.b + d + e + f) as fixed + v.x + b + w.w + u.y + x.z + y.x
}
fn swap6(a: s32, b: s32, c: s32, d: s32, e: s32, f: s32) -> s32 {
    // passes its arguments on in a rotated order
    return f6(f, a, b, c, d, e)
}
fn sum8(a: s32, b: s32, c: s32, d: s32, e: s32, f: s32, g: s32, h: s32) -> s32 {
    if a == 0 { return b + c + d + e + f + g + h }
    return sum8(a - 1, b + 1, c, d, e, f, g, h)
}

fn init() {
    p(f6(1, 2, 3, 4, 5, 6))  // expect: 91
    p(f6(f6(1, 1, 1, 1, 1, 1), 2, f6(1, 0, 0, 0, 0, 0), 4, 5, f6(0, 0, 0, 0, 0, 1)))  // expect: 105
    pf(mix(1, vec3(0.5, 0.0, 0.0), 0.25, vec4(0.0, 0.0, 0.0, 2.0), 2, Pt { a: 3, b: 4 }, 5, 6, 7, vec2(0.0, 0.125), vec3(0.0, 0.0, 1.0), vec4(10.0, 0.0, 0.0, 0.0)))  // expect: 41.875
    p(swap6(1, 2, 3, 4, 5, 6))  // expect: 76
    p(sum8(10, 1, 2, 3, 4, 5, 6, 7))  // expect: 38
    let a = 1
    let b = 2
    p(f6(b, a, b, a, b, a))  // expect: 30
}
