// The GPU budget registers: light frames, then frames over 1,000,000 GPU cycles (27 clears of
// 38,400 each = 1,036,800) that are shown a tick late.
// frames: 9
var n: s32
fn update() {
    print_int(gpu_used())
    print(" ")
    print_int(frame_ticks())
    print(" ")
    print_int(gpu_lag())
    print("\n")
}
fn draw() {
    n += 1
    if n >= 3 {
        for i in 0..27 { cls(0) }
    }
}
// expect: 0 0 0
// expect: 0 1 0
// expect: 0 1 0
// expect: 1036800 2 1
// expect: 1036800 2 2
// expect: 1036800 2 3
