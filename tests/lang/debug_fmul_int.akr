// meic --trap-fmul: fixed * integer (a plain mul) that does not fit halts with a report.
// flags: --trap-fmul
// exit: 2
fn scale(a: fixed, n: s32) -> fixed { return a * n }
fn twice(n: s32, a: fixed) -> fixed { return n * a }

fn init() {
    print_fixed(scale(1000.0, 32)); println("")      // expect: 32000.0
    print_fixed(scale(-1000.0, 32)); println("")     // expect: -32000.0
    print_fixed(scale(-1.0, 32768)); println("")     // expect: -32768.0
    print_fixed(scale(5000.0, 0)); println("")       // expect: 0.0
    print_fixed(scale(30000.0, -1)); println("")     // expect: -30000.0
    print_fixed(twice(3, 10000.0)); println("")      // expect: 30000.0
    print_fixed(scale(-1000.0, 63)); println("")
}
// expect: check failed: debug_fmul_int.akr:4: fixed-point multiply overflow (fixed * integer)
