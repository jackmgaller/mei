// flags: --release
// UFCS uses ordinary calls: evaluation order, fields, captures, builtins and chaining.
import "lib/ufcs_private.akr"
struct Point { x: s32, y: s32 }
struct Button { fire: fn(s32) -> s32, count: s32 }
enum Mode { Idle, Busy }
var point = Point { x: 2, y: 7 }
var trace: s32
var calls: s32
var handler: fn(s32) -> s32 = twice
var buttons: [2]Button
fn twice(n: s32) -> s32 { return n * 2 }
fn squared(n: s32) -> s32 { return n * n }
fn ignored(n: s32, result: s32) -> s32 { return result }
fn add(n: s32, m: s32) -> s32 { return n + m }
fn shifted(q: Point, by: s32) -> Point { return Point { x: q.x + by, y: q.y } }
fn touch(q: *Point, by: s32) -> *Point { q.x += by; return q }
fn get_point() -> *Point { calls += 1; return &point }
fn ordered(n: s32) -> s32 { trace = trace * 10 + n; return n }
fn fire(b: Button, n: s32) -> s32 { return 999 }
fn mode_number(m: Mode) -> s32 { return m as s32 }
fn small_sum(a: [2]s16) -> s32 { return a[0] + a[1] }
fn invoke(f: fn(s32) -> s32, n: s32) -> s32 { return f(n) }
fn make_button(i: s32) -> *Button { calls += 1; return &buttons[i] }
fn via_capture(n: s32) -> s32 {
    let run = fn() -> s32 {
        let local_add = fn(x: s32, y: s32) => x + y + n
        return (3).local_add(4)
    }
    return run()
}
fn init() {
    assert_eq((3).twice().add(4), 10)
    assert_eq((7).handler(), 14)
    let twice = fn(x: s32) => x + 100
    assert_eq((3).twice(), 103)
    assert_eq(point.shifted(5).x, 7)
    assert_eq((&point).touch(3).touch(4).x, 9)
    let p = &point
    assert_eq(p.touch(2).x, 11)
    assert_eq(get_point().touch(5).x, 16)
    assert_eq(calls, 1)
    assert_eq(ordered(1).add(ordered(2)), 3)
    assert_eq(trace, 12)
    trace = 0
    assert_eq(ordered(3).squared(), 9)
    assert_eq(trace, 3)
    assert_eq(ordered(4).ignored(5), 5)
    assert_eq(trace, 34)
    assert_eq((3).ufcs_private_use(), 12)
    buttons[0] = Button { fire: twice }
    // Same-named free function loses to the function-valued field; no receiver inserted.
    buttons[0].fire = fn(x: s32) => x + 9
    assert_eq(make_button(0).fire(5), 14)
    assert_eq(calls, 2)
    assert_eq(Mode.Busy.mode_number(), 1)
    assert_eq([1, 2].small_sum(), 3)
    assert_eq((fn(x) => x + 6).invoke(4), 10)
    assert_eq(via_capture(5), 12)
    let v = vec3(1.0, 0.0, 0.0)
    assert_eq(v.dot(v), 1.0)
    var xs = [1, 2, 3]
    assert_eq(xs.len(), 3)
    let ys = xs.map(fn(x) => x + 1)
    assert_eq(ys[2], 4)
    assert_eq(xs.filter(fn(x) => x > 1), 2)
    assert_eq(xs[0], 2)
    assert_eq((8).max(12).min(10), 10)
    println("ufcs ok") // expect: ufcs ok
}
