// Packed element intrinsics, aggregate copies/returns, captures and live call values.
struct Pair16 { x: fixed16, y: fixed16 }
var input: [4]fixed16 = [0.5, -1.25, 7.0, -8.0]
var output: [4]fixed16
var live: fixed16 = 0.125
var calls: s32
fn identity(x: fixed16) -> fixed16 { return x }
fn positive(x: fixed16) -> bool { return x > 0.0 }
fn plus(x: fixed16, y: fixed16) -> fixed16 { return x + y }
fn modify(x: *fixed16) { *x *= 0.5 }
fn pair(x: fixed16, y: fixed16) -> Pair16 { return Pair16 { x: x, y: y } }
fn stack_live(a: fixed16, b: fixed16, c: fixed16, d: fixed16, e: fixed16, f: fixed16) -> fixed16 {
    let p = &f
    print("")
    return identity(a) + identity(b) + identity(c) + identity(d) + identity(e) + *p
}
fn next() -> s32 { calls += 1; return 1 }
fn init() {
    map_into(output, input, identity)
    for i in 0..4 { assert_eq(bits(input[i]), bits(output[i])) }
    let copied = input
    for i in 0..4 { assert_eq(bits(input[i]), bits(copied[i])) }
    each(output, modify)
    assert_eq(bits(output[0]), 1024)
    assert_eq(bits(output[1]), -2560)
    assert_eq(bits(output[2]), 14336)
    assert_eq(bits(output[3]), -16384)
    assert_eq(bits(live), 512)
    let count = filter_into(output, input, positive)
    assert_eq(count, 2)
    assert_eq(bits(output[0]), 2048)
    assert_eq(bits(output[1]), 28672)
    let total = reduce(input, fixed16(0.0), plus)
    assert_eq(bits(total), -7168)
    let returned = pair(input[0], input[1])
    var copied_pair = returned
    assert_eq(bits(copied_pair.x), 2048)
    assert_eq(bits(copied_pair.y), -5120)
    copied_pair = pair(-0.5, 1.25)
    assert_eq(bits(copied_pair.x), -2048)
    assert_eq(bits(copied_pair.y), 5120)
    assert_eq(bits(stack_live(-0.5, 0.5, -1.0, 1.0, -2.0, 2.5)), 2048)
    input[next()] += 0.5
    assert_eq(calls, 1)
    assert_eq(bits(input[1]), -3072)
    let captured = input[1]
    let inc: fn(fixed16) -> fixed16 = fn(x: fixed16) -> fixed16 { print(""); return x + captured }
    assert_eq(bits(inc(0.5)), -1024)
    print("fixed16 functions ok\n") // expect: fixed16 functions ok
}
