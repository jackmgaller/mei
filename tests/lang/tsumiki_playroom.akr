// The Playroom (carts/playroom), played by a script: a bot steers Zenmai with the stick (in
// the camera's frame, as a player would) through a list of moves, presses the button, rides
// the lift and climbs to every star. The cart must reach its goal: all five stars tidied.
// frames: 3600
import "../../carts/playroom/game.akr"

const GO = 0          // run to (x, z)
const JUMP = 1        // run to (x, z), jumping once within `arg` of the start of the move
const LIFT_DOWN = 2   // wait until the lift is down
const LIFT_UP = 3     // wait until the lift is up
const WAIT = 4        // stand still for `arg` frames
const HOP = 5         // jump where it stands

struct Move { kind: s32, x: fixed, z: fixed, arg: fixed }

const MOVES: [30]Move = [
    // star 1: up the ramp onto the red block, then a jump onto the blue one
    Move { kind: GO, x: -5.0, z: -4.4 },
    Move { kind: GO, x: -5.0, z: -2.0 },
    Move { kind: GO, x: -8.9, z: -1.6 },
    Move { kind: JUMP, x: -10.6, z: -1.8, arg: 0.1 },
    // star 4: down again, across to the chair, onto the seat, onto the table
    Move { kind: GO, x: -8.0, z: -1.8 },
    Move { kind: GO, x: -4.8, z: -2.0 },
    Move { kind: GO, x: -4.6, z: -4.6 },
    Move { kind: GO, x: 3.7, z: -7.4 },
    Move { kind: JUMP, x: 3.7, z: -8.9, arg: 0.1 },
    Move { kind: JUMP, x: 5.4, z: -8.9, arg: 0.1 },
    Move { kind: GO, x: 8.2, z: -8.9 },
    Move { kind: GO, x: 8.1, z: -5.8 },
    // star 2: off the table, up the book stairs
    Move { kind: GO, x: 9.6, z: -5.4 },
    Move { kind: GO, x: 6.2, z: -3.3 },
    Move { kind: GO, x: 11.3, z: -3.3 },
    // star 3: to the lift, up, along the shelf
    Move { kind: GO, x: 6.2, z: -1.8 },
    Move { kind: GO, x: 4.4, z: 6.4 },
    Move { kind: GO, x: 4.4, z: 8.2 },
    Move { kind: LIFT_DOWN },
    Move { kind: GO, x: 6.1, z: 8.2 },
    Move { kind: LIFT_UP },
    Move { kind: GO, x: 10.2, z: 8.4 },
    // star 5: off the shelf, onto the button, and up to the star out of the chest
    Move { kind: GO, x: 7.6, z: 7.2 },
    Move { kind: GO, x: 6.4, z: 6.6 },
    Move { kind: GO, x: 1.5, z: 4.4 },
    Move { kind: GO, x: 0.0, z: 5.0 },
    Move { kind: WAIT, arg: 90.0 },
    Move { kind: GO, x: 0.0, z: 6.2 },
    Move { kind: HOP },
    Move { kind: WAIT, arg: 60.0 },
]

var bot_tick: s32 = -1
var bot_pad: u32
var bot_stick: vec2
var step: s32
var step_t: s32
var jumped: bool
var shown_got: s32
var reported: bool

// The stick that runs toward world point (x, z), seen from the camera (the inverse of
// tk_cam_move_dir).
fn stick_to(x: fixed, z: fixed) -> vec2 {
    let dx = x - hero.pos.x
    let dz = z - hero.pos.z
    let d = sqrt(dx * dx + dz * dz)
    if d < 0.05 { return vec2(0.0, 0.0) }
    let k = min(d * 3, 1.0) / d
    let wx = dx * k
    let wz = dz * k
    let sy = sin(tk_cam.yaw)
    let cy = cos(tk_cam.yaw)
    return vec2(wx * cy - wz * sy, wx * sy + wz * cy)
}

fn near(x: fixed, z: fixed, r: fixed) -> bool {
    let dx = x - hero.pos.x
    let dz = z - hero.pos.z
    return dx * dx + dz * dz < r * r
}

fn bot() {
    bot_pad = 0
    bot_stick = vec2(0.0, 0.0)
    if mode == Mode.Title {
        if mode_t > 20 && mode_t < 24 { bot_pad = START }
        return
    }
    if mode != Mode.Play || step >= len(MOVES) { return }
    let m = &MOVES[step]
    step_t += 1
    var done = false
    match m.kind {
        GO => {
            bot_stick = stick_to(m.x, m.z)
            done = near(m.x, m.z, 0.25)
        }
        JUMP => {
            bot_stick = stick_to(m.x, m.z)
            if step_t < 14 { bot_pad = A }
            done = near(m.x, m.z, 0.3) && hero.on_ground
        }
        LIFT_DOWN => done = lift.pos.y < LIFT_LOW.y + 0.32 && lift.delta.y == 0.0
        LIFT_UP => done = lift.pos.y > LIFT_HIGH.y + 0.28 && lift.delta.y == 0.0
        WAIT => done = fixed(step_t) >= m.arg
        HOP => {
            if step_t < 12 { bot_pad = A }
            done = step_t > 40
        }
        else => done = true
    }
    // a move that takes far too long is reported (the bot is stuck)
    if step_t > 900 {
        print("stuck at move ")
        print_int(step)
        println("")
        done = true
    }
    if done {
        step += 1
        step_t = 0
    }
}

fn tk_input_pad() -> u32 {
    if bot_tick != tk_ticks() {
        bot_tick = tk_ticks()
        bot()
        if got != shown_got {
            shown_got = got
            print("star ")
            print_int(got)
            println("")
        }
        if mode == Mode.Tidy && !reported {
            reported = true
            println("all tidy")
        }
    }
    return bot_pad
}

fn tk_input_stick() -> vec2 { return bot_stick }

// expect: star 1
// expect: star 2
// expect: star 3
// expect: star 4
// expect: star 5
// expect: all tidy
