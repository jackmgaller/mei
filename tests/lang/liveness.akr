// Register allocation around calls inside single statements.
fn p(n: s32) { print_int(n); print_char('\n') }
fn id(x: s32) -> s32 { return x }
fn clobber(x: s32) -> s32 {
    // uses every caller-saved register
    var a = x + 1
    var b = x + 2
    var c = x + 3
    var d = x + 4
    var e = x + 5
    var f = x + 6
    var g = x + 7
    var h = x + 8
    return a + b + c + d + e + f + g + h - 8 * x - 36
}
fn vclobber(v: vec4) -> vec4 { return v * 0.0 + vec4(9.0, 9.0, 9.0, 9.0) - vec4(9.0, 9.0, 9.0, 9.0) }

fn init() {
    let a = id(3)
    let b = a + clobber(4)
    p(b)                        // expect: 3
    var total = 0
    for i in 1..id(4) + clobber(0) { total += i }
    p(total)                    // expect: 6
    var x = 10
    x += clobber(5) + x
    p(x)                        // expect: 20
    let v = vec4(1.0, 2.0, 3.0, 4.0)
    let w = v + vclobber(v) + v
    print_vec(w)
    print_char('\n')            // expect: (2.0, 4.0, 6.0, 8.0)
    var k = 0
    while k < clobber(7) + 5 { k += 1 }
    p(k)                        // expect: 5
    p(id(1) + id(2) + id(3) + id(4) + id(5))  // expect: 15
    let s = sum3(id(1), clobber(9) + 2, id(3))
    p(s)                        // expect: 6
}
fn sum3(a: s32, b: s32, c: s32) -> s32 { return a + b + c }
