// meic -g: an index out of bounds halts with a report.
// flags: -g
// exit: 2
var buf: [8]u8
var rows: [4][3]s32

fn get(i: s32) -> s32 { return buf[i] as s32 }

fn init() {
    for i in 0..8 { buf[i] = i as u8 }          // in range: no check needed
    var k = 2
    rows[k][1] = 5
    print_int(rows[2][1] + get(7)); println("")  // expect: 12
    print_int(get(9)); println("")
}
// expect: check failed: debug_bounds.akr:7: index out of bounds for 'buf' ([8]u8)
// expect:   index 9, length 8
