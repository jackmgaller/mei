// Tsumiki particles: the spawn cap per frame, the pool's ring (256 at most alive), the draw cap
// and its thinning, emitters' rates, lifetimes, and confetti landing on the floor.
// frames: 160
import "tsumiki.akr"

var t: s32
var em: *TkEmitter

fn init() {
    tk_open(0)
    let _ = tk_add_box(vec3(-10.0, -1.0, -10.0), vec3(10.0, 0.0, 10.0))
    tk_cam_fixed(vec3(0.0, 2.0, -6.0), null, vec3(0.0, 1.0, 0.0), 0)
    *tk_style(6) = *tk_style(TK_SPARKLE)          // a style of our own: long-lived, still
    tk_style(6).life = 1000
    tk_style(6).life_jitter = 0
    tk_style(6).speed = 0.0
    tk_style(6).lift = 0.0
    tk_style(6).drag = 1.0
    tk_style(6).twinkle = false
}

fn update() {
    t += 1
    if t == 1 {
        tk_burst(6, vec3(0.0, 1.0, 0.0), 100)       // only 64 start in one frame
    }
    if t >= 2 && t <= 6 { tk_burst(6, vec3(0.0, 1.0, 0.0), 64) }   // the ring fills: 256 at most
    if t == 10 {
        tk_open(0)                                   // empty again
        let _ = tk_add_box(vec3(-10.0, -1.0, -10.0), vec3(10.0, 0.0, 10.0))
        tk_cam_fixed(vec3(0.0, 2.0, -6.0), null, vec3(0.0, 1.0, 0.0), 0)
        em = tk_new_emitter(TK_SPARKLE, vec3(0.0, 1.0, 0.0))
        em.rate = 0.25
    }
    if t == 50 {
        em.on = false
        tk_burst(TK_CONFETTI, vec3(0.0, 2.0, 0.0), 20)
    }
    tk_update()
    if t == 1 || t == 6 {
        print_int(tk_particles_alive())
        println("")
    }
    if t == 49 {
        print_int(tk_particles_alive())          // one every 4 frames, each living 30-42
        println("")
    }
    if t == 155 {
        // the confetti has landed (and every sparkle is gone)
        var on_floor = 0
        for i in 0..TK_MAX_PARTICLES {
            let p = &__tk_parts[i]
            if p.life != 0 && p.pos.y == 0.02 { on_floor += 1 }
        }
        print_int(tk_particles_alive())
        print(",")
        print_int(on_floor)
        println("")
    }
}

fn draw() {
    tk_draw()
    if t == 7 {
        print_int(tk_particles_drawn())            // 256 alive, at most 160 drawn: every 2nd
        tk_particle_cap(256)
        println("")
    }
    if t == 8 {
        print_int(tk_particles_drawn())
        tk_particle_cap(50)
        println("")
    }
    if t == 9 {
        print_int(tk_particles_drawn())            // every 6th, so 42
        println("")
    }
}
// expect: 64
// expect: 256
// expect: 128
// expect: 256
// expect: 42
// expect: 8
// expect: 20,20
