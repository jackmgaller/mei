// Region resources in VRAM's second megabyte (docs/DECISIONS.md, "VRAM at 2 MB"): a texture in
// slot 20, the main palette run in palette bank 1 (colour 4112 on), an 8-bit palette run at
// colour 7936 (8-bit palette 31), an animated tile in slot 20 and backdrop art in a free page.
// Driven by tests/test_worldpack.py (RegionExtTests); PACK is a 1.4 pack built there.
import "worldpack.akr"

fn vram8(at: s32) -> s32 { return ((VRAM_TEXTURES + at) as *u8)[0] as s32 }
fn colour(c: s32) -> s32 { return palette_ptr(c)[0] as s32 }

fn show(label: *u8, a: s32, b: s32, c: s32) {
    print(label)
    print_char(' ')
    print_int(a)
    print_char(' ')
    print_int(b)
    print_char(' ')
    print_int(c)
    println("")
}

fn init() {
    if !wp_open(PACK) {
        println("open 0")
        return
    }
    wp_region_enter(0, 0)
    show("texture", vram8(20 * 32768), vram8(20 * 32768 + 1), vram8(20 * 32768 + 128 * 8))
    show("slot4", vram8(4 * 32768), vram8(4 * 32768 + 1), 0)           // slot 20's bits 0-3: untouched
    show("day", colour(4096 + 17), colour(7936 + 1), colour(7936 + 2))
    show("bank0", colour(17), colour(3840 + 1), 0)                     // the same colours in bank 0: untouched
    show("backdrop", ((0x590000) as *u8)[0] as s32, ((0x590000) as *u8)[3] as s32, 0)
    wp_variant_load(0, 1)
    show("night", colour(4096 + 17), colour(7936 + 1), colour(7936 + 2))
    let a = wp_animate(0)
    let b = wp_animate(4)
    show("frame1", a, b, vram8(20 * 32768 + 128 * 8))
    println("done")
}

fn draw() { cls(0) }
