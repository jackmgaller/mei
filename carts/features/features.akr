// Language features showcase: an enum state machine drives a menu; screens are picked
// with `match`; a particle system is updated with each/filter/map_into/reduce; orbit
// curves are function values, and the colour ramps are closures. Flocking uses vectors,
// creatures use enum states, and cellular automata use double-buffered arrays.
// Up/Down + A to choose,
// B to go back. Left alone, the cart cycles through its screens by itself.
cart "Features"

import "flocking.akr"
import "creatures.akr"
import "automata.akr"

enum Screen { Menu, Particles, Orbits, Flocking, Creatures, Automata, About }

struct Item { label: *u8, target: Screen }
struct Particle { pos: vec2, vel: vec2, life: s32, hue: u8 }

const MAX_PARTS = 96
const IDLE_MENU = 75         // frames before the menu picks an item by itself
const IDLE_SCREEN = 240      // frames before a screen returns to the menu by itself
const IDLE_SIM = 600         // let the new simulations demonstrate their behaviour

var screen = Screen.Menu
var cursor = 0
var idle = 0
var items: [6]Item
var parts: [96]Particle
var count = 0
var speeds: [96]fixed
var tint: [4]fn(s32) -> u32           // one colour ramp per particle hue
var curves: [3]fn(fixed) -> vec2      // orbit shapes
var t: fixed

fn init() {
    items[0] = Item { label: "PARTICLES", target: Screen.Particles }
    items[1] = Item { label: "ORBITS", target: Screen.Orbits }
    items[2] = Item { label: "FLOCKING", target: Screen.Flocking }
    items[3] = Item { label: "TINY CREATURES", target: Screen.Creatures }
    items[4] = Item { label: "CELLULAR AUTOMATA", target: Screen.Automata }
    items[5] = Item { label: "ABOUT", target: Screen.About }
    tint[0] = ramp(255, -1, 40)
    tint[1] = ramp(60, 255, -1)
    tint[2] = ramp(-1, 140, 255)
    tint[3] = ramp(255, 255, -1)
    curves[0] = fn(a: fixed) => vec2(cos(a), sin(a))
    curves[1] = fn(a: fixed) => vec2(sin(a), sin(a * 2) * 0.5)
    curves[2] = ellipse
}

fn ellipse(a: fixed) -> vec2 { return vec2(cos(a) * 1.6, sin(a) * 0.4) }

// A colour ramp: a closure that captures three channel values (all a function value can
// hold); a negative channel follows the brightness argument instead.
fn ramp(r: s32, g: s32, b: s32) -> fn(s32) -> u32 {
    return fn(l: s32) => rgb(channel(r, l), channel(g, l), channel(b, l))
}
fn channel(c: s32, l: s32) -> s32 {
    if c < 0 { return l * 3 }
    return c
}

fn enter(s: Screen) {
    screen = s
    idle = 0
    if s == Screen.Particles { count = 0 }
    if s == Screen.Flocking { flocking_reset() }
    if s == Screen.Creatures { creatures_reset() }
    if s == Screen.Automata { automata_reset() }
}

// ---- update

fn update() {
    t += 0.03
    idle += 1
    if btn(UP | DOWN | LEFT | RIGHT | A | B | X | Y | L | R | START | SELECT) { idle = 0 }
    match screen {
        Menu => update_menu()
        Particles => update_particles()
        Flocking => flocking_update()
        Creatures => creatures_update()
        Automata => automata_update()
        Orbits, About => {}
    }
    var duration = IDLE_SCREEN
    match screen {
        Flocking, Creatures, Automata => duration = IDLE_SIM
        else => {}
    }
    if screen != Screen.Menu && (btnp(B) || idle > duration) {
        // come back with the cursor on the next item
        cursor = (cursor + 1) % len(items)
        enter(Screen.Menu)
    }
}

fn update_menu() {
    let n = len(items)
    if btnp(UP) { cursor = (cursor + n - 1) % n }
    if btnp(DOWN) { cursor = (cursor + 1) % n }
    if btnp(A) || btnp(START) || idle > IDLE_MENU { enter(items[cursor].target) }
}

fn spawn() {
    if count >= MAX_PARTS { return }
    let a = rndf() * PI + PI           // upward half circle (screen y grows down)
    let speed = 1.0 + rndf() * 2.5
    parts[count] = Particle {
        pos: vec2(160.0, 170.0),
        vel: vec2(cos(a) * speed, sin(a) * speed),
        life: 40 + rnd(40),
        hue: rnd(4) as u8,
    }
    count += 1
}

fn step(p: *Particle) {
    p.pos = p.pos + p.vel
    p.vel.y += 0.06                     // gravity
    p.life -= 1
}

fn update_particles() {
    for i in 0..3 { spawn() }
    each(parts, step, count)
    let floor = 236.0
    count = filter(parts, fn(p) => p.life > 0 && p.pos.y < floor, count)   // captures floor
}

// ---- draw

fn draw() {
    match screen {
        Menu => draw_menu()
        Particles => draw_particles()
        Orbits => draw_orbits()
        Flocking => flocking_draw()
        Creatures => creatures_draw()
        Automata => automata_draw()
        About => draw_about()
    }
    text(8, 228, "CPU", rgb(120, 120, 140))
    text_int(40, 228, cpu_used(), rgb(120, 120, 140))
    if screen != Screen.Menu { text(216, 228, "B: BACK", rgb(120, 120, 140)) }
}

fn heading(s: *u8) {
    rect(0, 0, 320, 20, rgb(30, 30, 60))
    text(8, 6, s, rgb(255, 255, 255))
}

fn draw_menu() {
    cls(rgb(12, 14, 30))
    heading("MEI LANGUAGE FEATURES")
    for i in 0..len(items) {
        let y = 54 + i * 22
        var colour = rgb(150, 150, 170)
        if i == cursor {
            colour = rgb(255, 220, 90)
            rect(56, y - 4, 208, 16, rgb(50, 40, 90))
            text(64, y, ">", colour)
        }
        text(80, y, items[i].label, colour)
    }
    text(56, 192, "UP/DOWN + A TO CHOOSE", rgb(120, 120, 150))
    text(56, 208, "LEAVE IDLE FOR AUTO TOUR", rgb(90, 90, 120))
}

fn draw_particle(p: Particle) {
    let c = tint[p.hue](p.life * 2)
    rect(p.pos.x as s32 - 1, p.pos.y as s32 - 1, 3, 3, c)
}

fn draw_particles() {
    cls(rgb(8, 8, 16))
    heading("PARTICLES: EACH / FILTER / REDUCE")
    each(parts, draw_particle, count)
    // statistics with map_into and reduce
    map_into(speeds, parts, fn(p) => length(p.vel), count)
    let fastest = reduce(speeds, 0.0, fn(a, s) => max(a, s), count)
    let total = reduce(parts, 0, fn(a: s32, p: Particle) => a + p.life, count)
    text(8, 28, "COUNT", rgb(160, 160, 200))
    text_int(64, 28, count, rgb(255, 255, 255))
    text(8, 40, "LIFE", rgb(160, 160, 200))
    text_int(64, 40, total, rgb(255, 255, 255))
    text(8, 52, "FASTEST", rgb(160, 160, 200))
    text_int(72, 52, (fastest * 100) as s32, rgb(255, 255, 255))
}

fn draw_orbits() {
    cls(rgb(6, 10, 20))
    heading("ORBITS: FUNCTION VALUES")
    for k in 0..len(curves) {
        let f = curves[k]
        let cx = 60 + k * 100
        for i in 0..24 {
            let a = t * fixed(k + 1) - fixed(i) * 0.08
            let q = f(a) * 36.0
            let c = tint[k](80 - i * 3)
            rect(cx + q.x as s32 - 1, 120 + q.y as s32 - 1, 3, 3, c)
        }
    }
}

fn draw_about() {
    cls(rgb(20, 12, 24))
    heading("ABOUT")
    let lines = ["enum Screen { Menu, ... }", "match screen { ... }", "ramp(r, g, b): closures",
                 "fn(p) => p.life > 0", "each / filter / map_into", "reduce(xs, 0, f, n)",
                 "vec2: steering a flock", "enum states: tiny creatures",
                 "arrays: cellular automata"]
    for i in 0..len(lines) {
        text(24, 40 + i * 16, lines[i], rgb(200, 190, 230))
    }
}
