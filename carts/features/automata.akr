// Conway's Life: fixed-size arrays are read from one buffer and written to the
// other. Pointer swapping commits the whole generation at once, without copying.
const AUTOMATA_W = 48
const AUTOMATA_H = 26
const AUTOMATA_CELLS = AUTOMATA_W * AUTOMATA_H
const AUTOMATA_SEED_TIME = 180

var automata_a: [1248]u8
var automata_b: [1248]u8
var automata_current: *u8
var automata_next: *u8
var automata_generation = 0
var automata_live = 0
var automata_seed = 0
var automata_clock = 0
var automata_age = 0
var automata_paused = false

fn automata_cell(x: s32, y: s32) {
    automata_current[y * AUTOMATA_W + x] = 1
}

fn automata_glider(x: s32, y: s32) {
    automata_cell(x + 1, y)
    automata_cell(x + 2, y + 1)
    for dx in 0..3 { automata_cell(x + dx, y + 2) }
}

fn automata_reseed() {
    automata_current = automata_a
    automata_next = automata_b
    memset(automata_a, 0, AUTOMATA_CELLS)
    memset(automata_b, 0, AUTOMATA_CELLS)
    automata_generation = 0
    automata_clock = 0
    automata_age = 0
    match automata_seed {
        0 => {
            // Travelling gliders interleaved with blinkers and beacon oscillators.
            for y in 0..3 {
                for x in 0..5 { automata_glider(2 + x * 9, 2 + y * 8) }
            }
            for x in 0..4 {
                let px = 7 + x * 10
                for dy in 0..3 { automata_cell(px, 8 + dy) }
                automata_cell(px, 17)
                automata_cell(px + 1, 17)
                automata_cell(px, 18)
                automata_cell(px + 1, 18)
                automata_cell(px + 2, 19)
                automata_cell(px + 3, 19)
                automata_cell(px + 2, 20)
                automata_cell(px + 3, 20)
            }
        }
        1 => {
            // Small R-pentomino seeds expand into colonies and collide.
            for y in 0..3 {
                for x in 0..5 {
                    let px = 4 + x * 9
                    let py = 3 + y * 8
                    automata_cell(px + 1, py)
                    automata_cell(px + 2, py)
                    automata_cell(px, py + 1)
                    automata_cell(px + 1, py + 1)
                    automata_cell(px + 1, py + 2)
                }
            }
        }
        2 => {
            for i in 0..AUTOMATA_CELLS {
                if rnd(100) < 27 { automata_current[i] = 1 }
            }
        }
        else => {}
    }
    automata_live = 0
    for i in 0..AUTOMATA_CELLS {
        if automata_current[i] != 0 { automata_live += 1 }
    }
}

fn automata_reset() {
    automata_seed = 0
    automata_paused = false
    automata_reseed()
}

fn automata_step() {
    let src = automata_current
    let dst = automata_next
    var live = 0
    for y in 0..AUTOMATA_H {
        let row = y * AUTOMATA_W
        var above = row - AUTOMATA_W
        var below = row + AUTOMATA_W
        if y == 0 { above = AUTOMATA_CELLS - AUTOMATA_W }
        if y == AUTOMATA_H - 1 { below = 0 }
        for x in 0..AUTOMATA_W {
            var left = x - 1
            var right = x + 1
            if x == 0 { left = AUTOMATA_W - 1 }
            if x == AUTOMATA_W - 1 { right = 0 }
            // A nonzero cell's byte records its age; births are age one.
            let neighbours = (src[above + left] != 0) as s32 +
                (src[above + x] != 0) as s32 + (src[above + right] != 0) as s32 +
                (src[row + left] != 0) as s32 + (src[row + right] != 0) as s32 +
                (src[below + left] != 0) as s32 + (src[below + x] != 0) as s32 +
                (src[below + right] != 0) as s32
            let i = row + x
            var age = 0
            if neighbours == 3 || (neighbours == 2 && src[i] != 0) {
                age = min(src[i] as s32 + 1, 12)
                live += 1
            }
            dst[i] = age as u8
        }
    }
    automata_current = dst
    automata_next = src
    automata_live = live
    automata_generation += 1
}

fn automata_update() {
    if btnp(START) { automata_paused = !automata_paused }
    if btnp(A) {
        automata_seed = (automata_seed + 1) % 3
        automata_reseed()
    }
    if automata_paused { return }
    automata_age += 1
    if automata_age >= AUTOMATA_SEED_TIME || automata_live == 0 {
        automata_seed = (automata_seed + 1) % 3
        automata_reseed()
        return
    }
    automata_clock += 1
    if automata_clock >= 4 {
        automata_clock = 0
        automata_step()
    }
}

fn automata_draw() {
    cls(rgb(8, 15, 24))
    heading("CELLULAR AUTOMATA: GAME OF LIFE")
    let labels = ["GLIDER GARDEN", "GROWING COLONIES", "RANDOM SOUP"]
    text(16, 28, labels[automata_seed], rgb(110, 180, 210))
    text(164, 28, "GEN", rgb(90, 115, 140))
    text_int(196, 28, automata_generation, rgb(225, 240, 250))
    text(232, 28, "LIVE", rgb(90, 115, 140))
    text_int(272, 28, automata_live, rgb(225, 240, 250))
    rect(14, 44, 292, 160, rgb(32, 49, 65))
    rect(16, 46, 288, 156, rgb(12, 24, 34))
    let src = automata_current
    for y in 0..AUTOMATA_H {
        for x in 0..AUTOMATA_W {
            let age = src[y * AUTOMATA_W + x] as s32
            if age != 0 {
                // New cells shine gold; survivors settle into mint and blue.
                var colour = rgb(90, 165, 205)
                if age == 1 { colour = rgb(255, 218, 105) }
                else if age < 5 { colour = rgb(125, 225, 175) }
                rect(16 + x * 6, 46 + y * 6, 5, 5, colour)
            }
        }
    }
    text(16, 206, "ARRAYS / NEIGHBOURS / DOUBLE BUFFER", rgb(120, 160, 180))
    if automata_paused {
        text(16, 216, "PAUSED  A: SEED  START: RUN", rgb(255, 218, 105))
    } else {
        text(16, 216, "A: RESEED  START: PAUSE", rgb(100, 125, 150))
    }
}
