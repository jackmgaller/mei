// Sound: day and night music (a 16 s pad and a shorter melody loop that phase against each
// other, so the mix keeps changing), nature ambience and effects. Samples come from
// tools/gen_lantern_audio.py. Every melodic sound uses the pentatonic notes C D E G A, so the
// reeling chime (a C6 bell repitched) always fits the music.

embed MUS_DAY_PAD: s16 = "audio/mus_day_pad.raw"
embed MUS_DAY_MEL: s8 = "audio/mus_day_mel.raw"
embed MUS_NIGHT_PAD: s16 = "audio/mus_night_pad.raw"
embed MUS_NIGHT_MEL: s8 = "audio/mus_night_mel.raw"
embed AMB_WATER: s8 = "audio/amb_water.raw"
embed AMB_CRICKETS: s8 = "audio/amb_crickets.raw"
embed SFX_BIRD1: s8 = "audio/sfx_bird1.raw"
embed SFX_BIRD2: s8 = "audio/sfx_bird2.raw"
embed SFX_BIRD3: s8 = "audio/sfx_bird3.raw"
embed SFX_FROG: s8 = "audio/sfx_frog.raw"
embed SFX_CAST: s8 = "audio/sfx_cast.raw"
embed SFX_PLOP: s8 = "audio/sfx_plop.raw"
embed SFX_SPLASH: s8 = "audio/sfx_splash.raw"
embed SFX_CLICK: s8 = "audio/sfx_click.raw"
embed SFX_CHIME: s8 = "audio/sfx_chime.raw"
embed SFX_BITE: s8 = "audio/sfx_bite.raw"
embed SFX_NIBBLE: s8 = "audio/sfx_nibble.raw"
embed SFX_CATCH: s8 = "audio/sfx_catch.raw"
embed SFX_NEW: s8 = "audio/sfx_new.raw"
embed SFX_SNAP: s8 = "audio/sfx_snap.raw"
embed SFX_BLIP: s8 = "audio/sfx_blip.raw"
embed SFX_OK: s8 = "audio/sfx_ok.raw"
embed SFX_BACK: s8 = "audio/sfx_back.raw"
embed SFX_COIN: s8 = "audio/sfx_coin.raw"
embed SFX_FESTIVAL: s8 = "audio/sfx_festival.raw"
embed SFX_TENSION: s8 = "audio/sfx_tension.raw"
embed SFX_FIREWORK: s8 = "audio/sfx_firework.raw"

const CH_PAD = 0
const CH_MEL = 1
const CH_WATER = 2
const CH_NATURE = 3        // crickets (night loop) or birds (day)
const CH_CHIME = 4
const CH_SFX = 5
const CH_JINGLE = 6
const CH_EXTRA = 7         // line tension creak, frogs

const PAD_VOL = 110
const MEL_VOL = 92
const WATER_VOL = 44

// C D E G A over two octaves, as playback rates of the C6 chime
const PENTA: [10]fixed = [1.0, 1.1225, 1.2599, 1.4983, 1.6818, 2.0, 2.2449, 2.5198, 2.9966, 3.3636]

var music_night: bool
var music_on: bool
var music_fade: s32         // 0..256 current music level
var music_want: s32         // target level
var music_switch: bool      // fading out to change arrangement
var duck: s32
var pause_duck: s32 = 256   // 256 normal, down to PAUSE_DUCK while the world is paused
const PAUSE_DUCK = 64
var nature_t: s32
var tension_on: bool

fn set_vol(ch: s32, l: s32, r: s32) {
    let chan = (AUDIO_BASE + ch * 32) as *u32
    chan[4] = (clamp(l, 0, 255) as u32) | ((clamp(r, 0, 255) as u32) << 8)
}

fn music_start(nightm: bool) {
    music_night = nightm
    if nightm {
        play16(CH_PAD, MUS_NIGHT_PAD, len(MUS_NIGHT_PAD), 0.25, 0, 0, true)
        play(CH_MEL, MUS_NIGHT_MEL, len(MUS_NIGHT_MEL), 0.5, 0, 0, true)
    } else {
        play16(CH_PAD, MUS_DAY_PAD, len(MUS_DAY_PAD), 0.25, 0, 0, true)
        play(CH_MEL, MUS_DAY_MEL, len(MUS_DAY_MEL), 0.5, 0, 0, true)
    }
    music_on = true
    music_fade = 0
    music_want = 256
}

fn ambience_start() {
    play(CH_WATER, AMB_WATER, len(AMB_WATER), 0.5, WATER_VOL, WATER_VOL, true)
}

// Called every frame: crossfades day and night music, ducks under jingles, plays the
// birds, crickets and frogs.
fn sound_update(want_night: bool, ambience: bool) {
    // paused (or behind the menus): duck to a quarter, the melody further than the pad,
    // which sounds muffled rather than just quieter; back up smoothly
    if world_frozen() { pause_duck = max(pause_duck - 8, PAUSE_DUCK) } else { pause_duck = min(pause_duck + 6, 256) }
    if music_on {
        if want_night != music_night && !music_switch {
            music_switch = true
            music_want = 0
        }
        if music_switch && music_fade == 0 {
            music_switch = false
            music_start(want_night)
        }
        if music_fade < music_want { music_fade = min(music_fade + 2, music_want) }
        if music_fade > music_want { music_fade = max(music_fade - 2, music_want) }
        var k = music_fade * pause_duck / 256
        if duck > 0 {
            duck -= 1
            var d = 80
            if duck < 60 { d = 256 - duck * 176 / 60 }
            k = k * d / 256
        }
        let km = k * pause_duck / 256
        set_vol(CH_PAD, PAD_VOL * k / 256, PAD_VOL * k * 9 / 2560)
        set_vol(CH_MEL, MEL_VOL * km * 8 / 2560, MEL_VOL * km / 256)
    }
    // the water and the crickets follow the pause duck too
    set_vol(CH_WATER, WATER_VOL * pause_duck / 256, WATER_VOL * pause_duck / 256)
    if want_night && sound_playing(CH_NATURE) { set_vol(CH_NATURE, 26 * pause_duck / 256, 22 * pause_duck / 256) }
    if !ambience { return }
    nature_t += 1
    if want_night {
        // crickets: a soft loop; now and then a frog
        if !sound_playing(CH_NATURE) || nature_t == 1 {
            play(CH_NATURE, AMB_CRICKETS, len(AMB_CRICKETS), 1.0, 26, 22, true)
        }
        if nature_t % 400 == 0 && !tension_on && rnd(3) == 0 {
            let p = 0.45 + fixed(rnd(64)) / 640
            if rnd(2) == 0 { play(CH_EXTRA, SFX_FROG, len(SFX_FROG), p, 80, 40, false) }
            else { play(CH_EXTRA, SFX_FROG, len(SFX_FROG), p, 40, 80, false) }
        }
    } else {
        if nature_t % 140 == 0 && rnd(2) == 0 {
            let p = 0.85 + fixed(rnd(64)) / 180
            let l = 20 + rnd(50)
            let r = 70 - l + 20
            match rnd(3) {
                0 => play(CH_NATURE, SFX_BIRD1, len(SFX_BIRD1), p, l, r, false)
                1 => play(CH_NATURE, SFX_BIRD2, len(SFX_BIRD2), p, l, r, false)
                else => play(CH_NATURE, SFX_BIRD3, len(SFX_BIRD3), p, l, r, false)
            }
        }
    }
}

// Pausing: effects stop (the tension creak goes quiet until the fight resumes and sets it
// again); music and ambience duck in sound_update().
fn sound_pause() {
    stop(CH_SFX)
    stop(CH_CHIME)
    if tension_on { set_vol(CH_EXTRA, 0, 0) } else { stop(CH_EXTRA) }
    if !music_night { stop(CH_NATURE) }      // a bird mid-song
}

fn nature_reset() {
    stop(CH_NATURE)
    nature_t = 0
}

// Volumes for a sound at p, panned by its direction from the camera.
fn pan_play(ch: s32, sample: *s8, n: u32, pitch: fixed, p: vec3, vol: s32) {
    let dx = p.x - cam_pos.x
    let dz = p.z - cam_pos.z
    let side = dx * cam_c - dz * cam_s
    let dist = abs(dx) + abs(dz) + 1.0
    let pan = clamp(side / dist, -1.0, 1.0)
    let fall = clamp(1.3 - dist / 40, 0.4, 1.0)
    let l = ((1.0 - pan * 0.6) * fall * vol) as s32
    let r = ((1.0 + pan * 0.6) * fall * vol) as s32
    play(ch, sample, n, pitch, l, r, false)
}

fn sfx_cast() { play(CH_SFX, SFX_CAST, len(SFX_CAST), 1.0 + fixed(rnd(32)) / 400, 120, 120, false) }
fn sfx_plop(p: vec3) { pan_play(CH_SFX, SFX_PLOP, len(SFX_PLOP), 0.95 + fixed(rnd(32)) / 300, p, 170) }
fn sfx_splash(p: vec3) { pan_play(CH_SFX, SFX_SPLASH, len(SFX_SPLASH), 0.9 + fixed(rnd(32)) / 200, p, 170) }
fn sfx_bite(p: vec3) { pan_play(CH_SFX, SFX_BITE, len(SFX_BITE), 1.0, p, 200) }
fn sfx_nibble(p: vec3) { pan_play(CH_SFX, SFX_NIBBLE, len(SFX_NIBBLE), 1.0 + fixed(rnd(32)) / 200, p, 150) }
fn sfx_click() { play(CH_CHIME, SFX_CLICK, len(SFX_CLICK), 0.9 + fixed(rnd(32)) / 300, 60, 60, false) }
fn sfx_snap() { play(CH_JINGLE, SFX_SNAP, len(SFX_SNAP), 1.0, 160, 160, false) }
fn sfx_blip() { play(CH_JINGLE, SFX_BLIP, len(SFX_BLIP), 1.0, 90, 90, false) }
fn sfx_ok() { play(CH_JINGLE, SFX_OK, len(SFX_OK), 1.0, 120, 120, false) }
fn sfx_back() { play(CH_JINGLE, SFX_BACK, len(SFX_BACK), 1.0, 110, 110, false) }
fn sfx_coin() { play(CH_JINGLE, SFX_COIN, len(SFX_COIN), 1.0, 130, 130, false) }
fn sfx_miss() { play(CH_CHIME, SFX_CLICK, len(SFX_CLICK), 0.55, 70, 70, false) }

// A reeling step: the chime climbs the pentatonic scale with the pattern, an octave up
// when you keep the rhythm.
fn sfx_step(k: s32, combo: s32) {
    var i = k % 5
    if combo >= 4 { i += 5 }
    let pan = (k % 3) * 20
    play(CH_CHIME, SFX_CHIME, len(SFX_CHIME), PENTA[i], 70 + pan, 110 - pan, false)
}

fn sfx_catch(is_new: bool) {
    play(CH_JINGLE, SFX_CATCH, len(SFX_CATCH), 0.5, 170, 170, false)
    if is_new { play(CH_CHIME, SFX_NEW, len(SFX_NEW), 1.0, 130, 130, false) }
    duck = 120
}

fn sfx_festival() {
    play(CH_JINGLE, SFX_FESTIVAL, len(SFX_FESTIVAL), 0.5, 190, 190, false)
    duck = 200
}

fn sfx_firework(p: vec3) { pan_play(CH_SFX, SFX_FIREWORK, len(SFX_FIREWORK), 0.45 + fixed(rnd(32)) / 300, p, 140) }

fn tension_sound(on: bool) {
    tension_on = on
    if on { play(CH_EXTRA, SFX_TENSION, len(SFX_TENSION), 1.0, 0, 0, true) } else { stop(CH_EXTRA) }
}

fn tension_sound_level() {
    if !tension_on { return }
    let v = clamp(((f_tension - 0.55) * 300) as s32, 0, 110)
    set_vol(CH_EXTRA, v, v)
    let chan = (AUDIO_BASE + CH_EXTRA * 32) as *u32
    chan[3] = bits(0.8 + f_tension * 0.5) as u32
}
