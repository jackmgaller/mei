fn sky_point(az: fixed, el: fixed, dist: fixed) -> vec3 {
    let ce = cos(el) * dist
    return vec3(cam_pos.x + sin(az) * ce, cam_pos.y + sin(el) * dist, cam_pos.z + cos(az) * ce)
}

// Mirror a point in the water plane.
fn mirror(p: vec3) -> vec3 { return vec3(p.x, -p.y, p.z) }

// Is a sphere possibly in view (horizontal test)?
fn in_view(c: vec3, r: fixed) -> bool {
    let dx = c.x - cam_pos.x
    let dz = c.z - cam_pos.z
    let z = dx * cam_s + dz * cam_c
    if z < -r { return false }
    let x = dx * cam_c - dz * cam_s
    return abs(x) < z * 0.82 + r * 1.3
}

// Stars: fixed directions, shown at night.
const NSTARS = 28
var star_az: [28]fixed
var star_el: [28]fixed

fn stars_init() {
    seed(1234)
    for i in 0..NSTARS {
        star_az[i] = rndf() * 6.28318 - 3.14159
        star_el[i] = 0.06 + rndf() * rndf() * 0.6
    }
}

fn draw_sky_objects(refl: bool) {
    // stars: projected directly to the screen (cheaper than billboards)
    if night > 0.3 {
        let k = ((night - 0.3) * 360) as s32
        for i in 0..NSTARS {
            if refl && i % 2 == 1 { continue }
            let az = star_az[i]
            if abs(angle_diff(az, cam_yaw)) > 0.75 { continue }
            var p = sky_point(az, star_el[i], 180.0)
            if refl { p = mirror_about_cam(p) }
            if !project(p) { continue }
            let tw = 140 + ((i * 37 + tick_count / 6) & 63)
            var c = scale_col(rgb(220, 230, 255), k * tw / 256)
            if refl { c = scale_col(c, 150) }
            var sz = 1
            if i % 5 == 0 { sz = 2 }
            star_quad(proj_x, proj_y, sz, c)
        }
    }
    // the sun: a disc inside a wide warm glow
    if sun_el > -0.12 {
        let sp0 = sky_point(sun_az, sun_el, 160.0)
        var sp = sp0
        if refl { sp = mirror_about_cam(sp0) }
        let low = clamp(1.0 - sun_el * 2, 0.0, 1.0)
        glow_look(1)
        let core = mix_col(rgb(255, 250, 220), rgb(255, 170, 90), (low * 256) as s32)
        billboard(sp, 4.5, 4.5, core, core)
        let halo = mix_col(rgb(120, 110, 70), rgb(170, 80, 40), (low * 256) as s32)
        billboard(sp, 22.0, 22.0, halo, halo)
        if !refl {
            glow_look(3)
            billboard(sp, 3.0, 3.0, rgb(255, 255, 255), rgb(255, 255, 255))
        }
    }
    // the moon: a textured disc with a cool halo
    if moon_el > -0.1 {
        var mp = sky_point(moon_az, moon_el, 150.0)
        if refl { mp = mirror_about_cam(mp) }
        bt_look(F_TEX | F_SEMI, 1, SLOT_WORLD, PAL_MOON, UV_MOON_U, UV_MOON_V, UV_MOON_U + 31, UV_MOON_V + 31)
        let mc = scale_col(rgb(150, 150, 150), (night * 256) as s32 + 60)
        billboard(mp, 3.4, 3.4, mc, mc)
        glow_look(3)
        let hc = scale_col(rgb(110, 130, 190), (night * 256) as s32)
        billboard(mp, 14.0, 14.0, hc, hc)
    }
}

fn star_quad(x: s32, y: s32, sz: s32, c: u32) {
    if x < 0 || x > 320 || y < 0 || y > 240 { return }
    let q = packet_alloc(6)
    if q == null { return }
    q[1] = c | (1 << 24)
    q[2] = spos(x, y)
    q[3] = spos(x + sz, y)
    q[4] = spos(x, y + sz)
    q[5] = spos(x + sz, y + sz)
    ot_insert(q, 0x2C, 1022)
}

// A sky point mirrored in the water plane as seen from the camera (for far objects whose
// mirror image must stay at the same distance).
fn mirror_about_cam(p: vec3) -> vec3 { return vec3(p.x, -p.y, p.z) }

fn angle_diff(a: fixed, b: fixed) -> fixed {
    var d = a - b
    while d > 3.14159 { d -= 6.28318 }
    while d < -3.14159 { d += 6.28318 }
    return d
}

// Clouds: drifting tinted billboards high in the sky, and their reflections in the lake.
// A far object's reflection sits as far below the horizon as the object is above it, while
// the reflected treeline reaches further down (the eye is 1.6 above the water), so a cloud
// that just clears the trees is hidden in the water. The first-person view (60 degree fov,
// pitched 0.17 down) shows the sky up to about 0.2 rad before the HUD row, so the clouds
// sit at 0.15-0.19: high enough for their reflections to clear the reflected trees.
const NCLOUD = 9
const CLOUD_AZ: [9]fixed = [-1.2, -0.5, 0.15, 0.7, 1.4, 2.4, -2.5, 0.45, -0.15]
const CLOUD_EL: [9]fixed = [0.17, 0.19, 0.16, 0.18, 0.17, 0.19, 0.16, 0.18, 0.15]

fn draw_clouds(refl: bool) {
    if night > 0.75 { return }
    // one slow turn of the sky every ~105 minutes (16.16 fixed: keep the numerator small)
    let drift = fixed((tick_count / 16) % 23562) / 3750
    bt_look(F_TEX, 0, SLOT_WORLD, PAL_GREY, UV_CLOUD_U, UV_CLOUD_V, UV_CLOUD_U + 63, UV_CLOUD_V + 31)
    // cloud colour: lit from the sky, warm at dusk, dark at night
    var ct = mix_col(sky_hor, rgb(255, 255, 255), (light * 180) as s32)
    ct = scale_col(ct, 150)
    var cb = mix_col(ct, sky_mid, 100)
    if refl {
        // seen in the water: darker, like the shore's reflection palettes (the half-transparent
        // water plane over the low polygons tints it with the lake's colour and waves)
        ct = scale_col(ct, 230)
        cb = scale_col(cb, 205)
    }
    for i in 0..NCLOUD {
        let az = CLOUD_AZ[i] + drift
        if abs(angle_diff(az, cam_yaw)) > 1.2 { continue }
        var p = sky_point(az, CLOUD_EL[i], 170.0)
        let w = 20.0 + fixed(i % 3) * 6
        if refl {
            p = mirror_about_cam(p)
            // the waves break the reflection up: a slow sideways wobble and a squashed height
            let wob = sin(tick_angle(0.05) + fixed(i) * 1.7) * 0.6
            p = p + vec3(cam_c * wob, 0.0, -cam_s * wob)
            billboard(p, w, w * 0.4, ct, cb)
        } else {
            billboard(p, w, w * 0.45, cb, ct)
        }
    }
}

// ---- scenery

fn draw_scenery(refl: bool) {
    // far hills
    if refl { mesh(HILLS_R) } else { mesh(HILLS) }
    // the shore, in chunks: the full version near the camera, a coarse one further away
    for i in 0..NCHUNK {
        let c = CHUNK_C[i]
        if in_view(c, CHUNK_R[i]) {
            let dx = c.x - cam_pos.x
            let dz = c.z - cam_pos.z
            let far = dx * dx + dz * dz > (CHUNK_R[i] + 8.0) * (CHUNK_R[i] + 8.0)
            mesh(terr_mesh(i, refl, far))
        }
    }
    // docks
    for d in 0..NDOCK {
        if d == g.dock && !refl {
            // the deck right under you: the generator cuts it into small tiles (a quarter
            // texture cell each), which keeps the affine warp of the plank seams small; that
            // costs far less than subdivide() here (about 210k vs 270-300k cycles at the bridge)
            mesh(dock_mesh(d, false, false))
        } else if d == g.dock || (!refl && in_view(DOCK_STAND[d], 9.0)) {
            mesh(dock_mesh(d, refl, d != g.dock))
        }
    }
    // houses (the new house and the festival hall appear as the village grows)
    for i in 0..NHOUSE {
        if i == 6 && g.village < 2 { continue }
        if i == 7 && g.village < 4 { continue }
        if in_view(HOUSE_POS[i], 5.0) {
            let dx = HOUSE_POS[i].x - cam_pos.x
            let dz = HOUSE_POS[i].z - cam_pos.z
            let d2 = dx * dx + dz * dz
            if refl && d2 > 900.0 { continue }
            mesh(house_mesh(i, refl, d2 > 400.0))
        }
    }
    // reeds (only the nearby ones are reflected)
    for i in 0..4 {
        if !in_view(REED_C[i], REED_R[i]) { continue }
        if i != g.dock {
            if refl { continue }
            let dx = REED_C[i].x - cam_pos.x
            let dz = REED_C[i].z - cam_pos.z
            if dx * dx + dz * dz > 900.0 { continue }
        }
        mesh(reed_mesh(i, refl))
    }
}

// Lantern glows: posts on the docks (the pier lights more of them as the village grows),
// the festival hall, and the garlands strung between houses.
fn lantern_lit(i: s32) -> bool {
    let d = LANTERN_DOCK[i] as s32
    if d == 0 {
        // pier lanterns: count how many pier lanterns come before this one
        var k = 0
        for j in 0..i { if LANTERN_DOCK[j] == 0 { k += 1 } }
        return k < 2 + g.village * 2
    }
    if d == 9 { return g.village >= 4 }
    return true
}

var lantern_on: [24]u8

fn lanterns_prepare() {
    for i in 0..NLANTERN { lantern_on[i] = lantern_lit(i) as u8 }
}

fn draw_lantern_glows(refl: bool) {
    if night < 0.15 { return }
    let k = (night * 256) as s32
    let flick = (tick_count / 3) & 7
    ss_look(SS_HALO)
    for i in 0..NLANTERN {
        if lantern_on[i] == 0 { continue }
        var p = LANTERN_POS[i]
        if !in_view(p, 3.0) { continue }
        if refl { p = mirror(p) }
        let f = 220 + ((flick + i * 3) & 7) * 5
        let c = scale_col(rgb(200, 130, 60), k * f / 256)
        ssprite(p, 1.1, 1.1, c, 1, -3)
    }
    // garlands
    if g.village > 0 {
        ss_look(SS_DOT)
        for i in 0..NGARLAND {
            if GARLAND_LVL[i] as s32 > g.village { continue }
            var p = GARLAND_POS[i]
            if refl {
                if i % 2 == 1 { continue }
                p = mirror(p)
            }
            var c = rgb(255, 120, 60)
            if i % 3 == 1 { c = rgb(255, 200, 80) }
            if i % 3 == 2 { c = rgb(120, 160, 255) }
            ssprite(p, 0.22, 0.22, scale_col(c, k), 1, -3)
        }
    }
}

// Paper garland lanterns by day (small red quads), with no glow.
fn draw_garlands_day() {
    if g.village == 0 || night > 0.6 { return }
    ss_look(SS_PAPER)
    let c = rgb(128, 128, 128)
    for i in 0..NGARLAND {
        if GARLAND_LVL[i] as s32 > g.village { continue }
        ssprite(GARLAND_POS[i], 0.12, 0.17, c, -1, -2)
    }
}

// Lantern light on the water under the lanterns (pass B).
fn draw_lantern_pools() {
    if night < 0.2 { return }
    let k = (night * 200) as s32
    ss_look(SS_HALO)
    for i in 0..NLANTERN {
        if lantern_on[i] == 0 { continue }
        let p = LANTERN_POS[i]
        if !in_view(p, 4.0) { continue }
        sflat(vec3(p.x, 0.02, p.z), 2.2, 2.2, scale_col(rgb(255, 170, 80), k), 3, -1024)
    }
}

// ---- the water: BG2, the water texture in perspective

const WATER_PAL = 216         // 8 palettes: the water's colours at 8 brightnesses
const NWATER = 8
const LT_WATER = 0x44B000     // BG2's palette base per line (channel 4; spare VRAM)
const WATER_FAR: fixed = 76.0
// the old fan's rings: the water darkens with distance, ring by ring
const FAN_R: [11]fixed = [1.8, 3.0, 4.6, 7.0, 10.5, 16.0, 24.0, 36.0, 52.0, 64.0, 76.0]
var wave_tbl: [64]s32
var wob_tbl: [64]fixed        // a line's wobble, in screen pixels
var amp_tbl: [11]s32          // the swells' height by ring, x 256 / 14
var water_top: s32 = 240

// The plane chip's setup (once): the compositor, BG2 as the water texture (slot 3) tiled 32 x 32
// as 8x8 tiles, wrapping, half over what lies below it; BG1 the warm glow, added to the sky;
// the low polygons (the reflection, pass A and B) behind the water and the sky glow, the high
// ones (the world, pass C and D, the interface) in front.
fn planes_setup() {
    planes_on()
    plane(BG2, tex_atlas(SLOT_WATER), MAP_BG2, 32, 32, PLANE_WRAP, WATER_PAL)
    let m = MAP_BG2 as *u32
    for i in 0..512 { m[i] = ((i * 2) as u32) | (((i * 2 + 1) as u32) << 16) }
    layer_blend(BG2, BLEND_HALF)
    glow_build()
    glow_profile()
    plane(BG1, ATLAS_0, MAP_BG1, 128, 32, PLANE_16PX, GLOW_PAL)
    layer_blend(BG1, BLEND_ADD)
    plane_priority(BG1, 1, 1)
    plane_priority(BG2, 1, 1)
    poly_priority(0, 2)
    for i in 0..64 {
        wave_tbl[i] = (sin(fixed(i) * 0.09817) * 14) as s32
        wob_tbl[i] = fixed(wave_tbl[i]) / 10
    }
    for j in 0..11 { amp_tbl[j] = max(12 - j, 3) * 256 / 14 }
    for j in 0..10 { wl_rdux[j] = FAN_R[j] / 27.45 }
}

// The water for this frame's camera: the Mode 7 table (8 texels a unit, out to 76 units, as
// far as the fan reached), a wobble of each line's start (the waves), and each line's palette:
// darker with distance, as the fan's rings were, and lighter and darker in swells that roll in
// (the fan's travelling vertex colours).
fn draw_water() {
    let top = plane_floor(0.0, 8.0, 0.0, 0.0, WATER_FAR)
    water_top = top
    if top < 240 {
        wl_t3 = tick_count / 3
        wl_t4 = tick_count / 4
        wl_mode = (PLANE_WRAP as u32) | ((WATER_PAL as u32) << 8)
        __water_lines((LT_AFFINE + top * 16) as *fixed, (LT_WATER + top * 4) as *u32, 240 - top, top)
    }
    line_channel(4, lc_mode(BG2), 1, LT_WATER)
}

var wl_t3: s32
var wl_t4: s32
var wl_mode: u32
var wl_rdux: [10]fixed      // the rings' radii as texels a pixel (FAN_R / 27.45)

// draw_water's lines: for each line from the first water line down, its ring j (from its
// depth: DUX x 219.6 / 8, rings compared as DUX), the swell w (two travelling waves by depth,
// dz = depth x 4, taken as DUX x 28 / 16384), its palette (brightness 134 - 3 j + w amp(j) / 256,
// 8 levels from 92 in steps of 8) into the mode table, and the wobble of its start, U0 +=
// DUX x wob_tbl[(5 y + t3) mod 64]. About 45 cycles a line.
asm fn __water_lines(t: *fixed, p: *u32, n: s32, y: s32) {
    addi sp, sp, -20
    sw   r9, [sp+0]
    sw   r10, [sp+4]
    sw   r11, [sp+8]
    sw   r12, [sp+12]
    sw   r13, [sp+16]
    addi r9, r0, 10             ; j: the farthest ring
    la   r10, {wl_rdux}
    la   r11, {wave_tbl}
    la   r12, {amp_tbl}
    la   r13, {wob_tbl}
.line:
    lw   r5, [{t}+8]            ; DUX
.ring:
    beq  r9, r0, .rdone
    shli r7, r9, 2
    add  r7, r7, r10
    lw   r8, [r7-4]             ; the ring inside: rdux[j - 1]
    blt  r8, r5, .rdone         ; still beyond it
    addi r9, r9, -1
    jmp  .ring
.rdone:
    shli r7, r5, 3
    sub  r7, r7, r5             ; DUX x 7
    sari r7, r7, 12             ; dz
    lw   r6, [r0+{wl_t3}]
    add  r8, r7, r6
    andi r8, r8, 63
    shli r8, r8, 2
    add  r8, r8, r11
    lw   r8, [r8]               ; wave(dz + t3)
    shli r6, r7, 1
    add  r6, r6, r7
    sari r6, r6, 1              ; dz x 3 / 2
    lw   r7, [r0+{wl_t4}]
    sub  r6, r6, r7
    addi r6, r6, 21
    andi r6, r6, 63
    shli r6, r6, 2
    add  r6, r6, r11
    lw   r6, [r6]
    add  r8, r8, r6             ; w
    shli r7, r9, 2
    add  r7, r7, r12
    lw   r7, [r7]
    mul  r8, r8, r7
    sari r8, r8, 8              ; w x amp(j) / 256
    shli r7, r9, 1
    add  r7, r7, r9
    sub  r8, r8, r7
    addi r8, r8, 42             ; 134 - 3 j - 92 + ...
    sari r8, r8, 3
    bge  r8, r0, .l0
    mov  r8, r0
.l0:
    slti r7, r8, 8
    bne  r7, r0, .l1
    addi r8, r0, 7
.l1:
    shli r8, r8, 8
    lw   r7, [r0+{wl_mode}]
    add  r8, r8, r7
    sw   r8, [{p}+0]            ; this line's palette
    shli r7, {y}, 2
    add  r7, r7, {y}
    lw   r6, [r0+{wl_t3}]
    add  r7, r7, r6
    andi r7, r7, 63
    shli r7, r7, 2
    add  r7, r7, r13
    lw   r7, [r7]
    fmul r7, r5, r7
    lw   r8, [{t}+0]
    add  r8, r8, r7
    sw   r8, [{t}+0]            ; U0 + the wobble
    addi {t}, {t}, 16
    addi {p}, {p}, 4
    addi {y}, {y}, 1
    addi {n}, {n}, -1
    bne  {n}, r0, .line
    lw   r9, [sp+0]
    lw   r10, [sp+4]
    lw   r11, [sp+8]
    lw   r12, [sp+12]
    lw   r13, [sp+16]
    addi sp, sp, 20
}

// The water's palettes: the live water colours (water_base, rotated for the shimmer) at
// NWATER brightnesses from 0.75 to 1.19, a little bluer, as the fan's tint made them.
fn water_palettes() {
    let dst = VRAM_PALETTE as *u16
    for lv in 0..NWATER {
        let k = 96 + lv * 8
        let kb = k + 8
        let o = (WATER_PAL + lv) * 16
        for i in 1..16 {
            let c = water_base[(i - 1 + water_rot) % 15 + 1] as s32
            let r = min(((c & 31) * k) >> 7, 31)
            let gg = min((((c >> 5) & 31) * k) >> 7, 31)
            let b = min((((c >> 10) & 31) * kb) >> 7, 31)
            dst[o + i] = (r | (gg << 5) | (b << 10)) as u16
        }
    }
}

// ---- ripples and splashes

const NRIPPLE = 16
var rip_pos: [16]vec3
var rip_age: [16]s32
var rip_life: [16]s32
var rip_size: [16]fixed
var rip_next: s32

fn ripple(p: vec3, size: fixed, life: s32) {
    let i = rip_next
    rip_next = (rip_next + 1) % NRIPPLE
    rip_pos[i] = vec3(p.x, 0.03, p.z)
    rip_age[i] = 1
    rip_life[i] = life
    rip_size[i] = size
}

fn ripples_update() {
    for i in 0..NRIPPLE {
        if rip_age[i] > 0 {
            rip_age[i] += 1
            if rip_age[i] > rip_life[i] { rip_age[i] = 0 }
        }
    }
}

fn draw_ripples() {
    ss_look(SS_RING)
    let base = mix_col(rgb(70, 80, 90), rgb(110, 120, 120), (light * 256) as s32)
    for i in 0..NRIPPLE {
        if rip_age[i] == 0 { continue }
        let t = fixed(rip_age[i]) / rip_life[i]
        let r = rip_size[i] * (0.25 + t)
        let c = scale_col(base, ((1.0 - t) * 256) as s32)
        sflat(rip_pos[i], r, r, c, 1, -1024)
    }
}

// Splash particles: short-lived sparkles thrown up from the water.
const NSPLASH = 24
var sp_pos: [24]vec3
var sp_vel: [24]vec3
var sp_age: [24]s32
var sp_next: s32

fn splash(p: vec3, n: s32, power: fixed) {
    for k in 0..n {
        let i = sp_next
        sp_next = (sp_next + 1) % NSPLASH
        let a = rndf() * 6.28
        let s = (0.02 + rndf() * 0.04) * power
        sp_pos[i] = vec3(p.x, 0.05, p.z)
        sp_vel[i] = vec3(cos(a) * s, (0.08 + rndf() * 0.08) * power, sin(a) * s)
        sp_age[i] = 1
    }
}

fn splashes_update() {
    for i in 0..NSPLASH {
        if sp_age[i] == 0 { continue }
        sp_pos[i] = sp_pos[i] + sp_vel[i]
        sp_vel[i].y -= 0.012
        sp_age[i] += 1
        if sp_pos[i].y < 0.0 || sp_age[i] > 60 { sp_age[i] = 0 }
    }
}

fn draw_splashes() {
    ss_look(SS_SPARK)
    let c = mix_col(rgb(120, 140, 170), rgb(220, 230, 240), (light * 256) as s32)
    for i in 0..NSPLASH {
        if sp_age[i] == 0 { continue }
        ssprite(sp_pos[i], 0.12, 0.12, c, 1, -20)
    }
}

// The moon's (or the low sun's) glittering path on the water toward the camera.
fn draw_glitter() {
    var az = moon_az
    var el = moon_el
    var col = rgb(170, 180, 220)
    var amt = night
    if night < 0.5 {
        az = sun_az
        el = sun_el
        col = rgb(255, 190, 110)
        amt = clamp(1.0 - sun_el * 3, 0.0, 1.0) * light
    }
    if el < -0.02 || amt < 0.1 { return }
    if abs(angle_diff(az, cam_yaw)) > 1.0 { return }
    ss_look(SS_GLINT)
    let s = sin(az)
    let c = cos(az)
    let k = (amt * 256) as s32
    for i in 0..30 {
        // distance grows along the path; the path widens with distance (half-width about
        // 0.35 + d * 0.06; the fishable zone, in_moon_path(), is wider)
        let h = (i * 2654435761) as u32
        let d = 2.5 + fixed(i) * fixed(i) * 0.048
        let lat = (fixed(((h >> 8) & 255) as s32) / 256 - 0.5) * (0.7 + d * 0.12)
        let ph = ((h >> 16) as s32 + tick_count * (2 + i % 3)) & 63
        if ph > 40 { continue }
        let tw = 256 - abs(ph - 20) * 12
        let x = cam_pos.x + s * d + c * lat
        let z = cam_pos.z + c * d - s * lat
        if !is_water(x, z) { continue }
        let cc = scale_col(col, k * tw / 256)
        let w = 0.3 + d * 0.025
        ssprite(vec3(x, 0.03, z), w * 2.2, w * 0.3, cc, 1, -1024)
    }
}

// Is (x, z) on the lake (inside the shore)?
fn shore_at(x: fixed, z: fixed) -> fixed {
    let a = atan2(x, z)
    let f = (a + 3.14159) * 10.1859      // 64 / TAU
    var i = f as s32
    if i < 0 { i = 0 }
    if i > 63 { i = 63 }
    let t = f - fixed(i)
    return SHORE_R[i] + (SHORE_R[i + 1] - SHORE_R[i]) * t
}

fn is_water(x: fixed, z: fixed) -> bool {
    let r = sqrt(x * x + z * z)
    return r < shore_at(x, z) - 0.6
}

// ---- fireflies (night, near the shore by the current dock)
const NFLY = 10
var fly_pos: [10]vec3
var fly_vel: [10]vec3

fn fireflies_reset() {
    let s = DOCK_STAND[g.dock]
    for i in 0..NFLY {
        fly_pos[i] = vec3(s.x + (rndf() - 0.5) * 16, 0.5 + rndf() * 1.5, s.z + (rndf() - 0.5) * 16)
        fly_vel[i] = vec3(0.0, 0.0, 0.0)
    }
}

fn fireflies_update() {
    let s = DOCK_STAND[g.dock]
    for i in 0..NFLY {
        var v = fly_vel[i]
        v.x += (rndf() - 0.5) * 0.004
        v.y += (rndf() - 0.5) * 0.003
        v.z += (rndf() - 0.5) * 0.004
        v = v * 0.97
        var p = fly_pos[i] + v
        // stay near the dock, above the water
        if p.y < 0.3 { v.y += 0.004 }
        if p.y > 2.4 { v.y -= 0.004 }
        if p.x < s.x - 10.0 { v.x += 0.003 }
        if p.x > s.x + 10.0 { v.x -= 0.003 }
        if p.z < s.z - 10.0 { v.z += 0.003 }
        if p.z > s.z + 10.0 { v.z -= 0.003 }
        fly_vel[i] = v
        fly_pos[i] = p
    }
}

fn draw_fireflies() {
    if night < 0.5 { return }
    ss_look(SS_HALO)
    for i in 0..NFLY {
        let ph = (tick_count + i * 23) % 120
        if ph > 70 { continue }
        let b = 256 - abs(ph - 35) * 7
        let c = scale_col(rgb(200, 255, 120), b * ((night - 0.5) * 512) as s32 / 256)
        ssprite(fly_pos[i], 0.3, 0.3, c, 1, -20)
    }
}

// ---- screen projection (for the rod, the line and markers)

var proj_x: s32
var proj_y: s32
var proj_w: fixed
var proj_iw: fixed

// Projects p; false when it is behind the camera.
fn project(p: vec3) -> bool {
    let v = __vp * vec4(p, 1.0)
    proj_w = v.w
    if v.w < 0.12 { return false }
    let iw = 1.0 / v.w
    proj_iw = iw
    proj_x = 160 + ((v.x * iw) * 160) as s32
    proj_y = 120 - ((v.y * iw) * 120) as s32
    return true
}

// The ordering-table bucket of a view depth.
fn depth_bucket(w: fixed) -> s32 { return clamp(((w - 0.1) * 5.1226) as s32, 0, 1023) }

// A screen-space segment from (x0, y0) to (x1, y1), w pixels wide, sorted at bucket b.
fn seg2d(x0: s32, y0: s32, x1: s32, y1: s32, w: s32, c: u32, b: s32) {
    let q = packet_alloc(6)
    if q == null { return }
    let dx = x1 - x0
    let dy = y1 - y0
    var ox = 0
    var oy = 0
    if abs(dx) > abs(dy) { oy = w } else { ox = w }
    q[1] = c
    q[2] = spos(x0, y0)
    q[3] = spos(x1, y1)
    q[4] = spos(x0 + ox, y0 + oy)
    q[5] = spos(x1 + ox, y1 + oy)
    ot_insert(q, 0x24, b)
}
