// Rendering the lake. The sky and the water are the plane chip's (docs/PLANES.md); the rest is
// polygons, drawn in passes, each flushed through the ordering table before the next starts,
// so the layers stack without depth sorting between them. Back to front:
//
//   backdrop  the sky gradient above the horizon and its darker mirror below (a line table)
//   BG1       the warm glow toward a low sun, added to the sky (above the horizon only)
//   PL  A     everything mirrored under the water line (the reflection): hills, shore, docks,
//             houses, reeds, sun and moon, clouds, stars, lantern glows; also the sky objects
//      B     what lies in or on the water: fish shadows (subtractive), ripple rings, the
//             moon's glittering path and lantern light (additive), at double strength, since
//             the water halves what lies under it
//   BG2       the water: the water texture in perspective (Mode 7), half over the layers
//             below; its palette darkens with distance and swells, its lines wobble
//   PH  C     the world above the water: shore, docks, village, reeds, lily pads, the bobber,
//             leaping fish, lantern glows, fireflies, festival lanterns
//      D     the first-person view (view.akr): the line, the rod and hand, a fish held up,
//             and the interface
//
// Lighting by time of day is done with palettes: every world material has four keyframe
// palettes (night, dawn, day, dusk) and two are blended into the live palettes every few
// frames. The reflection uses darker, bluer copies of the same palettes.

import "assets.akr"
import "planes.akr"

const SLOT_WORLD = 0
const SLOT_FISH = 1
const SLOT_FONT = 2
const SLOT_WATER = 3

const F_GOURAUD = 1
const F_TEX = 2
const F_QUAD = 4
const F_SEMI = 8
const F_DOUBLE = 16

const KEY_NIGHT = 0
const KEY_DAWN = 1
const KEY_DAY = 2
const KEY_DUSK = 3

// ---- camera
var cam_pos: vec3
var cam_yaw: fixed
var cam_pitch: fixed = -0.14
var cam_s: fixed
var cam_c: fixed

// ---- live time-of-day values (set by tod_update)
var tod_a: s32           // the two keyframes and the blend between them (0..256)
var tod_b: s32
var tod_t: s32
var sky_top: u32
var sky_mid: u32
var sky_hor: u32
var sky_warm: u32
var light: fixed         // 0 night .. 1 day
var night: fixed         // 1 - light (smoothed nightness)
var sun_az: fixed
var sun_el: fixed
var moon_az: fixed
var moon_el: fixed
var water_rot: s32       // palette rotation of the water shimmer
var pal_tick: s32
var dest_src: [24]u8     // the source material of each live palette
var tod_force: s32       // tests and scenes: -1 = follow the clock, else minutes

const SKY_TOP: [4]u32 = [0x2A120A, 0x6E4A3C, 0xC08848, 0x5A2C30]
const SKY_MID: [4]u32 = [0x40200F, 0x9070A0, 0xDCAA70, 0x7C4C8C]
const SKY_HOR: [4]u32 = [0x603418, 0xB0A0E8, 0xF0D0A0, 0x9070D0]
const SKY_WARM: [4]u32 = [0x603418, 0x80B0FF, 0xF0D8B0, 0x4C8CFF]

// ---- colour helpers (colours are 0xBBGGRR words)

fn mix_col(a: u32, b: u32, k: s32) -> u32 {
    let kk = clamp(k, 0, 256) as u32
    let rb = ((a & 0xFF00FF) * (256 - kk) + (b & 0xFF00FF) * kk) >> 8
    let gg = ((a & 0x00FF00) * (256 - kk) + (b & 0x00FF00) * kk) >> 8
    return (rb & 0xFF00FF) | (gg & 0x00FF00)
}

fn scale_col(c: u32, k: s32) -> u32 {
    let kk = clamp(k, 0, 256) as u32
    return ((((c & 0xFF00FF) * kk) >> 8) & 0xFF00FF) | ((((c & 0x00FF00) * kk) >> 8) & 0x00FF00)
}

fn key_col(tbl: *u32) -> u32 { return mix_col(tbl[tod_a], tbl[tod_b], tod_t) }

// ---- time of day

const TOD_MIN: [9]s16 = [0, 300, 370, 450, 1050, 1110, 1170, 1230, 1440]
const TOD_KEY: [9]u8 = [0, 0, 1, 2, 2, 3, 3, 0, 0]

fn tod_update() {
    var m = minutes()
    if tod_force >= 0 { m = tod_force }
    var k = 0
    while k < 7 && m >= TOD_MIN[k + 1] as s32 { k += 1 }
    let m0 = TOD_MIN[k] as s32
    let m1 = TOD_MIN[k + 1] as s32
    tod_a = TOD_KEY[k] as s32
    tod_b = TOD_KEY[k + 1] as s32
    tod_t = (m - m0) * 256 / max(m1 - m0, 1)
    sky_top = key_col(&SKY_TOP[0])
    sky_mid = key_col(&SKY_MID[0])
    sky_hor = key_col(&SKY_HOR[0])
    sky_warm = key_col(&SKY_WARM[0])
    // night: 1 at night, 0 by day, smooth at dusk and dawn
    var n = 0.0
    if m < 300 || m >= 1230 { n = 1.0 }
    else if m < 450 { n = 1.0 - fixed(m - 300) / 150 }
    else if m >= 1080 { n = fixed(m - 1080) / 150 }
    night = n
    light = 1.0 - n
    // the sun crosses the northern sky from east to west between 6:00 and 18:30
    let ts = fixed(m - 350) / 790
    sun_az = 1.3 - ts * 3.1
    sun_el = sin(ts * 3.14159) * 0.45 - 0.05
    // the moon rises at dusk and sets at dawn (above the water ~18:50 - 5:40), crossing the
    // northern sky in front of the pier; its path on the water is where the Silver Moon Koi bites
    let tm = fixed((m - 1110 + 1440) % 1440) / 690
    moon_az = 1.3 - tm * 2.6
    moon_el = sin(tm * 3.14159) * 0.30 - 0.03
    if tm > 1.0 { moon_el = -1.0 }
}

// Blends the keyframe palettes into palette memory: every live world palette and its
// reflection. One palette per frame (all of them when `all`), round robin; the water
// palette is rotated every few frames for the shimmer.
var pal_rr: s32
var water_base: [16]u16

fn palettes_update(all: bool) {
    pal_tick += 1
    if all {
        for d in 0..NDEST { palette_blend(d) }
    } else {
        palette_blend(pal_rr)
        pal_rr = (pal_rr + 1) % NDEST
    }
    if all || pal_tick % 5 == 0 {
        water_rot = (water_rot + 1) % 15
        water_palettes()
    }
}

fn palette_blend(d: s32) {
    let ka = tod_a * NSRC * 16
    let kb = tod_b * NSRC * 16
    let t = tod_t
    let refl = 4 * NSRC * 16
    let dst = VRAM_PALETTE as *u16
    let src = dest_src[d] as s32 * 16
    if d == PAL_WATER {
        for i in 1..16 { water_base[i] = lerp15(KEYPAL[ka + src + i] as s32, KEYPAL[kb + src + i] as s32, t) as u16 }
        return
    }
    for i in 1..16 {
        let o = src + i
        dst[d * 16 + i] = lerp15(KEYPAL[ka + o] as s32, KEYPAL[kb + o] as s32, t) as u16
        dst[(d + REFL_OFF) * 16 + i] = lerp15(KEYPAL[refl + ka + o] as s32, KEYPAL[refl + kb + o] as s32, t) as u16
    }
}

// Blends two 15-bit colours: t = 0..256.
fn lerp15(a: s32, b: s32, t: s32) -> s32 {
    if a == b { return a }
    let r = (a & 31) + (((b & 31) - (a & 31)) * t >> 8)
    let gg = ((a >> 5) & 31) + ((((b >> 5) & 31) - ((a >> 5) & 31)) * t >> 8)
    let bb = ((a >> 10) & 31) + ((((b >> 10) & 31) - ((a >> 10) & 31)) * t >> 8)
    return r | (gg << 5) | (bb << 10)
}

// Which houses have lit windows: called when the village grows.
fn village_palettes() {
    for d in 0..NDEST { dest_src[d] = DEST_SRC[d] }
    let lit = 2 + g.village
    for i in 0..NHOUSE {
        let timber = HOUSE_TIMBER[i] != 0
        var on = i < lit
        if i == 7 { on = g.village >= 4 }
        if timber {
            if on { dest_src[PAL_HOUSE0 + i] = SRC_TIMBER_LIT as u8 } else { dest_src[PAL_HOUSE0 + i] = SRC_TIMBER_DARK as u8 }
        } else {
            if on { dest_src[PAL_HOUSE0 + i] = SRC_WALL_LIT as u8 } else { dest_src[PAL_HOUSE0 + i] = SRC_WALL_DARK as u8 }
        }
    }
}

// ---- a batch of quads in RAM, drawn with one mesh() call

struct Batch { hdr: Mesh, v: [128]vec4, f: [32]Face }
var bt: Batch
var bt_n: s32
var bt_flags: u8
var bt_blend: u8
var bt_tex: u8
var bt_pal: u8
var bt_uv: [4]u16

fn batch_init() {
    bt.hdr.verts = 16
    bt.hdr.faces = 16 + 128 * 16
    for i in 0..32 {
        for k in 0..4 { bt.f[i].idx[k] = (i * 4 + k) as u16 }
    }
}

fn bt_flush() {
    if bt_n == 0 { return }
    bt.hdr.nverts = (bt_n * 4) as u16
    bt.hdr.nfaces = bt_n as u16
    mesh(&bt.hdr)
    bt_n = 0
}

// The look of the following quads: flags (F_*), blend mode, texture slot, palette, and a
// texture rectangle (u0, v0) - (u1, v1).
fn bt_look(flags: u32, blend: u32, slot: u32, pal: u32, u0: s32, v0: s32, u1: s32, v1: s32) {
    bt_flags = (flags | F_QUAD | F_DOUBLE | F_GOURAUD) as u8
    bt_blend = blend as u8
    bt_tex = (slot | 0x10) as u8
    bt_pal = pal as u8
    bt_uv[0] = (u0 | (v1 << 8)) as u16
    bt_uv[1] = (u1 | (v1 << 8)) as u16
    bt_uv[2] = (u0 | (v0 << 8)) as u16
    bt_uv[3] = (u1 | (v0 << 8)) as u16
}

fn glow_look(mode: u32) { bt_look(F_TEX | F_SEMI, mode, SLOT_WORLD, PAL_GREY, UV_HALO_U, UV_HALO_V, UV_HALO_U + 63, UV_HALO_V + 63) }
fn dot_look(mode: u32) { bt_look(F_TEX | F_SEMI, mode, SLOT_WORLD, PAL_GREY, UV_DOT_U, UV_DOT_V, UV_DOT_U + 15, UV_DOT_V + 15) }
fn ring_look(mode: u32) { bt_look(F_TEX | F_SEMI, mode, SLOT_WORLD, PAL_GREY, UV_RING_U, UV_RING_V, UV_RING_U + 63, UV_RING_V + 63) }
fn spark_look(mode: u32) { bt_look(F_TEX | F_SEMI, mode, SLOT_WORLD, PAL_GREY, UV_SPARK_U, UV_SPARK_V, UV_SPARK_U + 15, UV_SPARK_V + 15) }

fn bt_quad(p0: vec4, p1: vec4, p2: vec4, p3: vec4, cb: u32, ct: u32) {
    if bt_n >= 32 { bt_flush() }
    let i = bt_n
    let vb = i * 4
    bt.v[vb] = p0
    bt.v[vb + 1] = p1
    bt.v[vb + 2] = p2
    bt.v[vb + 3] = p3
    let f = &bt.f[i]
    f.flags = bt_flags
    f.blend = bt_blend
    f.tex = bt_tex
    f.palette = bt_pal
    f.col[0] = cb
    f.col[1] = cb
    f.col[2] = ct
    f.col[3] = ct
    for k in 0..4 { f.uv[k] = bt_uv[k] }
    bt_n = i + 1
}

// A camera-facing quad of half-size hw x hh centred at pos.
fn billboard(pos: vec3, hw: fixed, hh: fixed, cb: u32, ct: u32) {
    let p = vec4(pos, 1.0)
    let r = vec4(cam_c * hw, 0.0, -cam_s * hw, 0.0)
    let u = vec4(0.0, hh, 0.0, 0.0)
    bt_quad(p - r - u, p + r - u, p - r + u, p + r + u, cb, ct)
}

// A horizontal square of half-size r centred at pos, turned by angle a.
fn flat_quad(pos: vec3, rx: fixed, rz: fixed, a: fixed, c: u32) {
    let s = sin(a)
    let co = cos(a)
    let ax = vec4(co * rx, 0.0, -s * rx, 0.0)
    let az = vec4(s * rz, 0.0, co * rz, 0.0)
    let p = vec4(pos, 1.0)
    bt_quad(p - ax - az, p + ax - az, p - ax + az, p + ax + az, c, c)
}

// ---- screen-space sprites: project the centre, size by distance, one packet. Much cheaper
// than a mesh billboard; used for glows, dots, sparkles and things lying flat on the water.

var ss_info: u32
var ss_u0: s32
var ss_v0: s32
var ss_u1: s32
var ss_v1: s32
const SS_HALO = 0
const SS_DOT = 1
const SS_SPARK = 2
const SS_RING = 3
const SS_GLINT = 4
const SS_PAPER = 5

fn ss_look(kind: s32) {
    var pal = PAL_GREY
    match kind {
        0 => { ss_u0 = UV_HALO_U; ss_v0 = UV_HALO_V; ss_u1 = UV_HALO_U + 63; ss_v1 = UV_HALO_V + 63 }
        1 => { ss_u0 = UV_DOT_U; ss_v0 = UV_DOT_V; ss_u1 = UV_DOT_U + 15; ss_v1 = UV_DOT_V + 15 }
        2 => { ss_u0 = UV_SPARK_U; ss_v0 = UV_SPARK_V; ss_u1 = UV_SPARK_U + 15; ss_v1 = UV_SPARK_V + 15 }
        3 => { ss_u0 = UV_RING_U; ss_v0 = UV_RING_V; ss_u1 = UV_RING_U + 63; ss_v1 = UV_RING_V + 63 }
        4 => { ss_u0 = UV_GLINT_U; ss_v0 = UV_GLINT_V; ss_u1 = UV_GLINT_U + 15; ss_v1 = UV_GLINT_V + 7 }
        else => {
            ss_u0 = UV_PAPER_U
            ss_v0 = UV_PAPER_V
            ss_u1 = UV_PAPER_U + 15
            ss_v1 = UV_PAPER_V + 23
            pal = PAL_PAPER
        }
    }
    ss_info = (SLOT_WORLD << 16) | (1 << 20) | ((pal as u32) << 24)
}

// Where a sprite goes: its bucket is clamped to ss_min..ss_max (the passes share tables: the
// reflection from bucket 1, what lies in the water at 0, the world from 16, the rod below 16).
// With SS_SPLIT (things in the water, drawn with the low polygons), a blended sprite is drawn
// at double strength where it lies under the water plane (from water_top, the plane's first
// line, down), which halves it, so it looks as it did drawn over the old water fan; it is split
// in two at that line when it straddles it.
const SS_ALL = 0
const SS_SPLIT = 1
var ss_min = 0
var ss_max = 1023
var ss_mode = SS_ALL

// A sprite of half-size rw x rh (world units) centred on p. mode: blend mode, or -1 opaque.
// bias: added to the ordering-table bucket (-1024: in front of everything).
fn ssprite(p: vec3, rw: fixed, rh: fixed, c: u32, mode: s32, bias: s32) {
    if !project(p) { return }
    let k = (__fx * 160) * proj_iw
    let hw = clamp((rw * k) as s32, 1, 56)
    let hh = clamp((rh * k) as s32, 1, 56)
    let x = proj_x
    let y = proj_y
    if x + hw < 0 || x - hw > 320 || y + hh < 0 || y - hh > 240 { return }
    let b = clamp(depth_bucket(proj_w) + bias, ss_min, ss_max)
    if mode < 0 {
        ss_part(x - hw, y - hh, x + hw, y + hh, ss_v0, ss_v1, c, 0x26, b)
        return
    }
    let col = (mode as u32) << 24
    let y0 = y - hh
    let y1 = y + hh
    if ss_mode == SS_ALL {
        ss_part(x - hw, y0, x + hw, y1, ss_v0, ss_v1, c | col, 0x2E, b)
        return
    }
    let s = clamp(water_top, y0, y1)
    let vs = ss_v0 + (ss_v1 - ss_v0) * (s - y0) / (y1 - y0)
    if s > y0 { ss_part(x - hw, y0, x + hw, s, ss_v0, vs, c | col, 0x2E, b) }
    if s < y1 { ss_double(x - hw, s, x + hw, y1, vs, ss_v1, c, col, b) }
}

// Double strength: twice the colour, or, for a bright glow, as much as keeps its hue (the
// brightest channel at 255; drawing it twice would cost twice the fill, and the low layer
// clips at 31 anyway).
fn ss_double(x0: s32, y0: s32, x1: s32, y1: s32, v0: s32, v1: s32, c: u32, col: u32, b: s32) {
    let m = max(max((c & 255) as s32, ((c >> 8) & 255) as s32), ((c >> 16) & 255) as s32)
    var c2 = col_add(c, c)
    if m > 127 {
        let f = 65280 / m                                  // 255 / m, times 256
        c2 = ((((c & 255) * f as u32) >> 8) & 255) | (((((c >> 8) & 255) * f as u32) >> 8) << 8) | (((((c >> 16) & 255) * f as u32) >> 8) << 16)
    }
    ss_part(x0, y0, x1, y1, v0, v1, c2 | col, 0x2E, b)
}

fn ss_part(x0: s32, y0: s32, x1: s32, y1: s32, v0: s32, v1: s32, col: u32, t: u32, b: s32) {
    let q = packet_alloc(10)
    if q == null { return }
    q[1] = col
    q[2] = spos(x0, y0)
    q[3] = (ss_u0 as u32) | ((v0 as u32) << 8) | ss_info
    q[4] = spos(x1, y0)
    q[5] = (ss_u1 as u32) | ((v0 as u32) << 8)
    q[6] = spos(x0, y1)
    q[7] = (ss_u0 as u32) | ((v1 as u32) << 8)
    q[8] = spos(x1, y1)
    q[9] = (ss_u1 as u32) | ((v1 as u32) << 8)
    ot_insert(q, t, b)
}

// Something lying flat on the water: squashed by the viewing angle.
fn sflat(p: vec3, rw: fixed, rl: fixed, c: u32, mode: s32, bias: s32) {
    let dx = p.x - cam_pos.x
    let dz = p.z - cam_pos.z
    let d = abs(dx) + abs(dz) * 0.8 + 0.5
    let aspect = clamp((cam_pos.y - p.y) / d, 0.06, 1.0)
    ssprite(p, rw, rl * aspect, c, mode, bias)
}

// ---- passes

fn flush_pass() {
    bt_flush()
    GPU_DRAW = &__ot[OT_SIZE - 1] as u32
    __ot_reset(&__ot[0])
}

fn spos(x: s32, y: s32) -> u32 { return (x as u32 & 0xFFFF) | ((y as u32) << 16) }

// How much the view direction yaw faces the low sun (warm sky): 0..256.
fn warmth(yaw: fixed) -> s32 {
    var w = (cos(yaw - sun_az) + 1.0) * 0.5
    w = w * w
    // only when the sun is low
    let low = clamp(1.0 - abs(sun_el - 0.05) * 4, 0.0, 1.0)
    return (w * low * 256) as s32
}

// The horizon's screen row: a far point at eye level, projected.
fn horizon_y() -> s32 {
    if project(vec3(cam_pos.x + cam_s * 150.0, cam_pos.y, cam_pos.z + cam_c * 150.0)) { return proj_y }
    return 120 - ((tan(-cam_pitch) * 219.6) as s32)
}

// ---- the sky: the backdrop and BG1

const GLOW_PAL = 200          // 16 palettes: the warm glow at 16 strengths (its vertical fade)
const LT_GLOW = LT_FREE       // BG1's palette base per line (channel 3)
const GLOW_PX: fixed = 266.7  // glow strip pixels per radian of azimuth (0.6 rad = half the screen)

var sky_ys: [6]s32
var sky_cols: [6]u32
var glow_key: u32 = 0xFFFFFFFF
var glow_yh: s32 = -1

// The sky gradient above the horizon and its darker mirror below it, in the backdrop (a line
// table, dithered by the chip), and the warm glow toward a low sun on BG1, added to the sky
// above the horizon. The mirror is tinted by the warmth straight ahead.
fn draw_sky() {
    let yh = horizon_y()
    let wc = warmth(cam_yaw)
    let hc = mix_col(sky_hor, sky_warm, wc)
    let mc = mix_col(sky_mid, sky_warm, wc / 3)
    let k = 200
    sky_ys[0] = yh - 300
    sky_ys[1] = yh - 60
    sky_ys[2] = yh
    sky_ys[3] = yh
    sky_ys[4] = yh + 60
    sky_ys[5] = yh + 300
    sky_cols[0] = sky_top
    sky_cols[1] = sky_mid
    sky_cols[2] = sky_hor
    sky_cols[3] = scale_col(hc, k)
    sky_cols[4] = scale_col(mc, k)
    sky_cols[5] = scale_col(sky_top, k)
    sky_gradient(&sky_cols[0], &sky_ys[0], 6)
    sky_glow(yh)
}

// BG1: a 2,048-pixel strip around the sky (glow_build), scrolled with the view's angle to the
// sun. Its 16 palettes are the glow colour (the warm colour's excess over the horizon's,
// scaled by how low the sun is) at 16 strengths; a line table picks one per line, fading from
// the horizon up, as the old sky bands mixed the warm colour into the horizon (fully) and the
// middle colour (a third).
fn sky_glow(yh: s32) {
    let low = clamp(1.0 - abs(sun_el - 0.05) * 4, 0.0, 1.0)
    let dr = max((sky_warm & 0xFF) as s32 - (sky_hor & 0xFF) as s32, 0)
    let dg = max(((sky_warm >> 8) & 0xFF) as s32 - ((sky_hor >> 8) & 0xFF) as s32, 0)
    let db = max(((sky_warm >> 16) & 0xFF) as s32 - ((sky_hor >> 16) & 0xFF) as s32, 0)
    let kl = (low * 256) as s32
    let r = dr * kl / 256
    let gg = dg * kl / 256
    let b = db * kl / 256
    if r < 8 && gg < 8 && b < 8 {
        plane_show(BG1, false)
        return
    }
    plane_show(BG1, true)
    let key = (r as u32) | ((gg as u32) << 8) | ((b as u32) << 16)
    if key != glow_key {
        glow_key = key
        // colour i of palette j: (r, g, b) x (i / 15) x (j / 15), 8 bits to 5: x i j / 1800,
        // stepped in i as 16.16 sums (one division per palette and channel)
        let pal = VRAM_PALETTE as *u16
        for j in 0..16 {
            let sr = r * j * 65536 / 1800
            let sg = gg * j * 65536 / 1800
            let sb = b * j * 65536 / 1800
            var ar = 0
            var ag = 0
            var ab = 0
            for i in 1..16 {
                ar += sr
                ag += sg
                ab += sb
                pal[(GLOW_PAL + j) * 16 + i] = ((ar >> 16) | ((ag >> 16) << 5) | ((ab >> 16) << 10)) as u16
            }
        }
    }
    let d = angle_diff(cam_yaw, sun_az)
    plane_scroll(BG1, 1024 - 160 + (d * GLOW_PX) as s32, 0)
    if yh != glow_yh {
        glow_yh = yh
        let t = LT_GLOW as *u32
        let n = clamp(yh, 0, 240)
        for y in 0..n { t[y] = glow_prof[yh - y] }
        plane_window(BG1, 0, 0, 320, n)
    }
}

// BG1's mode word for a line a lines above the horizon: 15 at the horizon, 5 at 60 above, 0 at
// 300 above (palette GLOW_PAL + level); a 128 x 32 map of 16x16 tiles.
var glow_prof: [300]u32

fn glow_profile() {
    for a in 0..300 {
        var f = (300 - a) * 5 / 240
        if a <= 60 { f = 15 - a * 10 / 60 }
        glow_prof[a] = (2 | 0x10) as u32 | ((GLOW_PAL + clamp(f, 0, 15)) as u32 << 8)
    }
}

// The glow strip (once): map column c holds tile c, the same in every row; tile c is 16
// columns of the glow's strength 0-15 at azimuth (x - 1024) / GLOW_PX from the sun, with x the
// strip column: round(15 ((cos + 1) / 2)^2), as warmth() weighs it. GLOW_ROW holds a row of
// every tile (two texels a byte, as in the atlas), from tools/gen_lantern_assets.py's formula.
fn glow_build() {
    let page = ATLAS_0 as *u32
    let row = &GLOW_ROW[0] as *u32
    for c in 0..128 {
        let w0 = row[c * 2]
        let w1 = row[c * 2 + 1]
        let o = (c / 16) * 16 * 32 + (c % 16) * 2       // in words: 16 tiles a row of cells
        for v in 0..16 {
            page[o + v * 32] = w0
            page[o + v * 32 + 1] = w1
        }
    }
    let m = MAP_BG1 as *u16
    for c in 0..128 { m[c] = c as u16 }
    for r in 1..32 { memcpy((m + r * 128) as *u8, m as *u8, 256) }
}

