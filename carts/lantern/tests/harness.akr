// Test scenarios for Lantern Lake (run with tests/run.sh SCENARIO FRAMES OUT).
// The scenario number comes from a generated file that defines SCENARIO and imports this.
// The hooks drive the game with simulated stick input: casts, circular reeling and a bot
// that traces each species' pattern (and leans against pulls, eases off leaps).

const TEST = 1
const JR_SEL = 7

var bot_on: bool
var bot_miss: s32          // every Nth step goes wrong on purpose (0: never)
var force_fish: s32 = -1
var scen_t: s32
var report_at: s32 = 0
var cpu_max: s32
var tri_max: s32
var cpu_sum: s32
var cpu_n: s32

fn input_pad(f: s32) -> u32 { return script_pad(f) }
fn input_stick(f: s32) -> vec2 { return vec2(0.0, 0.0) }

fn clock_at(h: s32, m: s32) -> s32 { return (h * 60 + m) * 25 / 2 }

fn start_at(dock: s32, h: s32, m: s32) {
    new_game()
    g.dock = dock
    g.clock = clock_at(h, m)
    g.tutorial = 0xFF
    g.fest = 3
    g.village = 2
    begin_fishing()
}

fn test_init() {
    show_debug = SHOT == 0
    match SCENARIO {
        1 => start_at(0, 10, 0)               // day at the pier
        2 => start_at(0, 18, 20)              // dusk at the pier
        3 => start_at(0, 22, 0)               // night at the pier: the moon on the water
        4 => { start_at(1, 11, 0); force_fish = 4 }    // a fight: Lily Carp
        5 => { start_at(3, 23, 0); force_fish = 3 }    // a fight: Ghost Pike at night
        6 => {                                // the journal with some catches
            start_at(0, 12, 0)
            for f in 0..14 {
                if f % 3 != 2 {
                    g.journal[f].caught = (1 + f % 4) as u16
                    g.journal[f].best_mm = (FISH[f].min_mm + 37) as u16
                }
            }
            open_journal(Screen.Fish)
            jr_sel = JR_SEL
        }
        7 => {                                // the festival (target met)
            start_at(0, 18, 50)
            g.fest = 1
            g.village = 1
            g.points = 400
            g.fest_day = 1
        }
        8 => { start_at(0, 12, 0); g.coins = 500; open_menu(); enter(Screen.Shop); shop_sel = 1 }
        9 => { start_at(0, 12, 0); open_menu(); menu_sel = 2 }
        10 => { start_at(2, 21, 30) }          // night at the bridge, a perf sweep
        11 => {                                // the grand festival and the ending
            start_at(0, 18, 50)
            g.fest = 4
            g.village = 4
            g.points = 2000
            g.fest_day = 1
        }
        12 => { start_at(2, 14, 0); force_fish = 6 }   // Bridge Catfish (heavy)
        13 => { start_at(2, 23, 0); force_fish = 7; g.up[UP_LANTERN] = 1 }  // Lantern Catfish (circles)
        14 => { start_at(3, 9, 0); force_fish = 8 }    // Dawn Trout (leaps)
        15 => { start_at(0, 9, 0) }                     // a full cast-and-wait at the pier, natural bites
        16 => { start_at(0, 6, 30) }                    // dawn
        17 => { new_game(); enter(Screen.Title) }        // the title (with no save)
        18 => { start_at(1, 20, 30); force_fish = 5 }   // Dusk Carp
        19 => { start_at(0, 23, 0); force_fish = 1 }    // Moonperch (pause step)
        20 => { start_at(1, 13, 0); force_fish = 12 }   // Golden Koi
        24 => { start_at(1, 21, 50); view_off = -1.1; g.total = 5 }   // the deck, looking back to the shore (night)
        25 => { start_at(1, 11, 0); view_off = -1.1; g.total = 5 }    // the same by day
        26 => { start_at(2, 12, 0); view_off = 1.0; g.total = 5 }     // along the bridge deck
        27 => { start_at(0, 12, 0); view_off = -1.0; g.total = 5 }    // along the pier
        28 => { start_at(2, 21, 0); view_off = -1.0; g.total = 5 }    // along the bridge at night
        23 => { start_at(0, 21, 30); view_off = 0.6; g.total = 5 }    // facing the moon (az ~0.62 at 21:30)
        29 => { start_at(0, 10, 0); view_off = -1.1; g.total = 5 }    // clouds and their reflections: a slow pan by day
        30 => { start_at(0, 18, 20); view_off = -1.1; g.total = 5 }   // ... at dusk
        31 => { start_at(0, 6, 30); view_off = -1.1; g.total = 5 }    // ... at dawn
        32 => { start_at(0, 12, 0); g.fest = 4; g.village = 3; g.points = 9999; g.coins = 9999 }   // the HUD at the last goal, a huge score
        33 => { start_at(2, 12, 0); g.fest = 4; g.village = 3; g.points = 1087 }                  // ... at the bridge, just short
        34 => {                                // the festival screen at the last goal with a huge score
            start_at(0, 18, 50)
            g.fest = 4
            g.village = 4
            g.points = 9999
            g.fest_day = 1
        }
        35 => { start_at(0, 12, 0); open_journal(Screen.Fish); jr_sel = 13 }    // the moon koi's journal page, not caught yet
        36 => {                                // ... and caught
            start_at(0, 12, 0)
            g.journal[13].caught = 2
            g.journal[13].best_mm = 661
            open_journal(Screen.Fish)
            jr_sel = 13
        }
        // koi bots: cast into the moon's path (40-45) or near the golden koi (46-47) and wait
        40 => koi_start(0, 21, 0)
        41 => koi_start(0, 0, 0)
        42 => koi_start(0, 3, 0)
        43 => koi_start(3, 20, 0)
        44 => koi_start(1, 4, 0)
        45 => koi_start(2, 0, 0)
        46 => koi_start(1, 10, 0)
        47 => koi_start(0, 13, 0)
        22 => { start_at(0, 10, 0); g.tutorial = TUT_CAST; force_fish = 0 }   // the first hook's tutorial
        21 => {                                // a festival that comes up short
            start_at(0, 18, 50)
            g.fest = 0
            g.village = 0
            g.points = 60
            g.fest_day = 1
        }
        else => {}
    }
}

// ---- the koi bots
var koi_casts: s32
var koi_wait: s32           // frames spent waiting with the lure in the water
var koi_inpath: s32         // ... of those, in the moon's path
var koi_first: s32 = -1     // frame of the first koi bite
var koi_bites: [14]s32
var koi_t0: s32

fn koi_start(dock: s32, h: s32, m: s32) {
    start_at(dock, h, m)
    g.total = 5
    seed((77 + SEEDV * 7919) as u32)
    swimmers_reset()
    koi_t0 = g.clock
}

fn koi_scen() -> bool { return SCENARIO >= 40 && SCENARIO <= 47 }

// Where the bot wants to cast: along the moon's path, or ~5.5 short of the golden koi.
var koi_yaw: fixed
var koi_d: fixed

fn koi_target() {
    let s = stand_pos()
    koi_yaw = DOCK_YAW[g.dock]
    koi_d = 14.0
    if SCENARIO <= 45 {
        koi_yaw = moon_az
        // aim a little off now and then, like a person would (every third cast)
        let k = koi_casts % 6
        if k == 2 { koi_yaw += 0.12 }
        if k == 5 { koi_yaw -= 0.12 }
        return
    }
    for i in 0..NSWIM {
        if sw[i].id == 12 && sw[i].state == SW_WANDER {
            let d = sw[i].pos - s
            koi_yaw = atan2(d.x, d.z)
            koi_d = sqrt(d.x * d.x + d.z * d.z) - 5.5
        }
    }
}

fn koi_bot() -> vec2 {
    if phase == Phase.Idle {
        koi_target()
        let want = clamp(angle_diff(koi_yaw, DOCK_YAW[g.dock]), -1.1, 1.1)
        let dv = want - view_off
        if abs(dv) > 0.03 {
            if dv > 0.0 { return vec2(min(dv * 30, 1.0), 0.0) }
            return vec2(max(dv * 30, -1.0), 0.0)
        }
        if scen_t % 20 != 0 { return vec2(0.0, 0.0) }
        return vec2(0.0, -1.0)
    }
    if phase == Phase.Aim {
        koi_target()
        let ax = clamp(angle_diff(koi_yaw, view_yaw()) / aim_spread(), -1.0, 1.0)
        // hold just long enough for the distance wanted
        let pw = clamp((koi_d - 3.0) / cast_range(), 0.35, 1.0)
        let need = ((pw - 0.35) / 0.65 * 45) as s32
        if aim_hold < max(need, 2) { return vec2(ax, -1.0) }
        return vec2(0.0, 1.0)
    }
    if phase == Phase.Fly && fly_t == 1 { koi_casts += 1 }
    if phase == Phase.Wait {
        koi_wait += 1
        if in_moon_path(lure) { koi_inpath += 1 }
        if force_fish >= 0 && phase_t == 5 { force_bite() }
        return vec2(0.0, 0.0)
    }
    if phase == Phase.Bite { if phase_t > 6 { return vec2(0.0, -1.0) } }
    if phase == Phase.Fight { return fight_bot() }
    return vec2(0.0, 0.0)
}

fn koi_report() {
    print("koi casts ")
    print_int(koi_casts)
    print(" wait ")
    print_int(koi_wait)
    print(" inpath ")
    print_int(koi_inpath)
    print(" first ")
    print_int(koi_first)
    print(" bites")
    for f in 0..14 {
        print(" ")
        print_int(koi_bites[f])
    }
    print(" caught12 ")
    print_int(g.journal[12].caught as s32)
    print(" caught13 ")
    print_int(g.journal[13].caught as s32)
    print(" clock ")
    print_int(minutes())
    println("")
}

fn script_pad(f: s32) -> u32 {
    if koi_scen() && phase == Phase.Wait && phase_t > 900 { return B }    // nothing for 15 s: reel in, cast again
    if koi_scen() && SHOT != 0 && phase == Phase.Catch && f_id >= 12 { return 0 }   // screenshots: stay on the koi
    if SCENARIO == 7 || SCENARIO == 11 || SCENARIO == 21 {
        if f > 500 && f % 60 == 0 { return A }
    }
    if (SCENARIO >= 4 && SCENARIO <= 5) || SCENARIO >= 12 {
        if phase == Phase.Catch && phase_t > 60 { return A }
    }
    if SCENARIO == 11 && screen == Screen.Ending && screen_t > 950 { return A }
    return 0
}

// Simulated stick for this frame.
fn bot_stick() -> vec2 {
    let t = scen_t
    if screen != Screen.Fish { return vec2(0.0, 0.0) }
    if koi_scen() { return koi_bot() }
    match phase {
        Idle => {
            if SCENARIO >= 24 && SCENARIO <= 28 { return vec2(0.0, 0.0) }
            if SCENARIO >= 29 && SCENARIO <= 31 { return vec2(0.25, 0.0) }   // pan right, 0.0055 rad a frame
            if SCENARIO == 10 {
                // sweep the view left and right
                if (t / 200) % 2 == 0 { return vec2(1.0, 0.0) }
                return vec2(-1.0, 0.0)
            }
            if t > 40 { return vec2(0.0, -1.0) }          // pull back
            return vec2(0.0, 0.0)
        }
        Aim => {
            if aim_hold < 40 { return vec2(0.25, -1.0) }
            return vec2(0.0, 1.0)                         // flick
        }
        Wait => {
            if force_fish >= 0 && phase_t == 5 { force_bite() }
            // circle the stick slowly now and then (8-way, like a keyboard)
            if SCENARIO == 15 && (phase_t / 120) % 2 == 1 {
                return dir_vec((phase_t / 5) % 8)
            }
            return vec2(0.0, 0.0)
        }
        Bite => {
            if phase_t > 6 { return vec2(0.0, -1.0) }      // hook!
            return vec2(0.0, 0.0)
        }
        Fight => return fight_bot()
        else => return vec2(0.0, 0.0)
    }
}

fn force_bite() {
    let i = 0
    sw[i].id = force_fish
    sw[i].state = SW_AT_LURE
    sw[i].pos = lure
    sw[i].size_mm = random_size(force_fish)
    sw[i].t = 0
    start_bite(i)
}

var bot_dir: s32 = -1
var bot_hold: s32

fn fight_bot() -> vec2 {
    if f_surge == 1 || f_surge == 3 {
        return vec2(sin(f_lean_ang), cos(f_lean_ang))
    }
    if f_surge == 4 || f_surge == 5 { return vec2(0.0, 0.0) }
    let info = &FISH[f_id]
    let tempo = info.tempo as s32
    let want = info.pat[f_k] as s32
    // move to the next step on the beat (faster while it charges)
    var due = tempo
    if f_surge == 2 { due = tempo / 2 }
    if f_step_t >= due - 1 || bot_dir < 0 {
        bot_dir = want
    }
    if bot_dir == DIR_C { return vec2(0.0, 0.0) }
    if want == DIR_C && f_step_t > 1 { return vec2(0.0, 0.0) }
    return dir_vec(bot_dir)
}

fn test_hook(f: s32) {
    scen_t += 1
    stick_in = bot_stick()
    if SCENARIO == 10 {
        // hop between docks every 400 frames for the perf sweep
        if scen_t % 400 == 0 {
            g.dock = (g.dock + 1) % 4
            begin_fishing()
        }
    }
    // statistics
    if scen_t > 30 {
        let u = cpu_used()
        cpu_max = max(cpu_max, u)
        tri_max = max(tri_max, world_tris + ui_tris)
        cpu_sum += u / 10
        cpu_n += 1
    }
    if scen_t % 100 == 0 {
        print("passes ")
        print_int(tris_a)
        print(" ")
        print_int(tris_b)
        print(" ")
        print_int(world_tris)
        print(" cpu ")
        print_int(cpu_used())
        print(" prof")
        for k in 0..8 {
            print(" ")
            print_int(prof[k])
        }
        println("")
    }
    if koi_scen() {
        if phase == Phase.Bite && phase_t == 1 {
            let id = sw[hooked].id
            if id >= 0 { koi_bites[id] += 1 }
            if (id == 12 || id == 13) && koi_first < 0 { koi_first = scen_t }
        }
        if scen_t % 750 == 0 { koi_report() }
    }
    if scen_t % 300 == 0 {
        print("t=")
        print_int(scen_t)
        print(" cpu max ")
        print_int(cpu_max)
        print(" avg ")
        print_int(cpu_sum / max(cpu_n, 1) * 10)
        print(" tris max ")
        print_int(tri_max)
        print(" fan ")
        print_int(fan_squashed)
        print("/")
        print_int(fan_quads)
        print(" phase ")
        print_int(phase as s32)
        print(" dist ")
        print_fixed(f_dist)
        print(" tens ")
        print_fixed(f_tension)
        println("")
    }
}
