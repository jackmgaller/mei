// Test scenarios for Lantern Lake (run with tests/run.sh SCENARIO FRAMES OUT).
// The scenario number comes from a generated file that defines SCENARIO and imports this.
// The hooks drive the game with simulated stick input: casts, circular reeling and a bot
// that traces each species' pattern (and leans against pulls, eases off leaps).

const TEST = 1
const JR_SEL = 7

var bot_on: bool
var bot_miss: s32          // every Nth step goes wrong on purpose (0: never)
var force_fish: s32 = -1
var scen_t: s32
var report_at: s32 = 0
var cpu_max: s32
var tri_max: s32
var cpu_sum: s32
var cpu_n: s32

fn input_pad(f: s32) -> u32 { return script_pad(f) }
fn input_stick(f: s32) -> vec2 { return vec2(0.0, 0.0) }

fn clock_at(h: s32, m: s32) -> s32 { return (h * 60 + m) * 25 / 2 }

fn start_at(dock: s32, h: s32, m: s32) {
    new_game()
    g.dock = dock
    g.clock = clock_at(h, m)
    g.tutorial = 0xFF
    g.fest = 3
    g.village = 2
    begin_fishing()
}

fn test_init() {
    show_debug = SHOT == 0
    match SCENARIO {
        1 => start_at(0, 10, 0)               // day at the pier
        2 => start_at(0, 18, 20)              // dusk at the pier
        3 => start_at(0, 22, 0)               // night at the pier: the moon on the water
        4 => { start_at(1, 11, 0); force_fish = 4 }    // a fight: Lily Carp
        5 => { start_at(3, 23, 0); force_fish = 3 }    // a fight: Ghost Pike at night
        6 => {                                // the journal with some catches
            start_at(0, 12, 0)
            for f in 0..14 {
                if f % 3 != 2 {
                    g.journal[f].caught = (1 + f % 4) as u16
                    g.journal[f].best_mm = (FISH[f].min_mm + 37) as u16
                }
            }
            open_journal(Screen.Fish)
            jr_sel = JR_SEL
        }
        7 => {                                // the festival (target met)
            start_at(0, 18, 50)
            g.fest = 1
            g.village = 1
            g.points = 400
            g.fest_day = 1
        }
        8 => { start_at(0, 12, 0); g.coins = 500; open_menu(); enter(Screen.Shop); shop_sel = 1 }
        9 => { start_at(0, 12, 0); open_menu(); menu_sel = 2 }
        10 => { start_at(2, 21, 30) }          // night at the bridge, a perf sweep
        11 => {                                // the grand festival and the ending
            start_at(0, 18, 50)
            g.fest = 4
            g.village = 4
            g.points = 2000
            g.fest_day = 1
        }
        12 => { start_at(2, 14, 0); force_fish = 6 }   // Bridge Catfish (heavy)
        13 => { start_at(2, 23, 0); force_fish = 7; g.up[UP_LANTERN] = 1 }  // Lantern Catfish (circles)
        14 => { start_at(3, 9, 0); force_fish = 8 }    // Dawn Trout (leaps)
        15 => { start_at(0, 9, 0) }                     // a full cast-and-wait at the pier, natural bites
        16 => { start_at(0, 6, 30) }                    // dawn
        17 => { new_game(); enter(Screen.Title) }        // the title (with no save)
        18 => { start_at(1, 20, 30); force_fish = 5 }   // Dusk Carp
        19 => { start_at(0, 23, 0); force_fish = 1 }    // Moonperch (pause step)
        20 => { start_at(1, 13, 0); force_fish = 12 }   // Golden Koi
        24 => { start_at(1, 21, 50); view_off = -1.1; g.total = 5 }   // the deck, looking back to the shore (night)
        25 => { start_at(1, 11, 0); view_off = -1.1; g.total = 5 }    // the same by day
        26 => { start_at(2, 12, 0); view_off = 1.0; g.total = 5 }     // along the bridge deck
        27 => { start_at(0, 12, 0); view_off = -1.0; g.total = 5 }    // along the pier
        28 => { start_at(2, 21, 0); view_off = -1.0; g.total = 5 }    // along the bridge at night
        23 => { start_at(0, 21, 30); view_off = 0.6; g.total = 5 }    // facing the moon (az ~0.62 at 21:30)
        29 => { start_at(0, 10, 0); view_off = -1.1; g.total = 5 }    // clouds and their reflections: a slow pan by day
        30 => { start_at(0, 18, 20); view_off = -1.1; g.total = 5 }   // ... at dusk
        31 => { start_at(0, 6, 30); view_off = -1.1; g.total = 5 }    // ... at dawn
        32 => { start_at(0, 12, 0); g.fest = 4; g.village = 3; g.points = 9999; g.coins = 9999 }   // the HUD at the last goal, a huge score
        33 => { start_at(2, 12, 0); g.fest = 4; g.village = 3; g.points = 1087 }                  // ... at the bridge, just short
        34 => {                                // the festival screen at the last goal with a huge score
            start_at(0, 18, 50)
            g.fest = 4
            g.village = 4
            g.points = 9999
            g.fest_day = 1
        }
        35 => { start_at(0, 12, 0); open_journal(Screen.Fish); jr_sel = 13 }    // the moon koi's journal page, not caught yet
        36 => {                                // ... and caught
            start_at(0, 12, 0)
            g.journal[13].caught = 2
            g.journal[13].best_mm = 661
            open_journal(Screen.Fish)
            jr_sel = 13
        }
        50 => { start_at(0, 12, 0); force_fish = SEEDV; g.total = 5 }
        37 => {                                // a fight for the guide's legibility: dock BOT / 100 at hour BOT % 100, view SEED / 100 - 1
            start_at(BOTV / 100, BOTV % 100, 0)
            view_off = fixed(SEEDV) / 100 - 1.0
            force_fish = 2
            g.total = 5
            g.journal[2].caught = 1
        }   // pattern test: species SEED, stick BOT (0 keys, 1 analog straight, 8 analog round the rim, 2-7 circling)
        // pause tests: START at a moment, hold the pause PAUSE_LEN frames, carry on
        60 => { start_at(0, 23, 0); force_fish = 2; g.total = 5 }       // mid-fight, at night
        61 => { start_at(0, 10, 0); g.total = 5 }                       // mid-cast: winding up
        62 => { start_at(0, 10, 0); g.total = 5 }                       // mid-cast: the lure in flight
        63 => {                                                         // the festival
            start_at(0, 18, 50)
            g.fest = 1
            g.village = 1
            g.points = 400
            g.fest_day = 1
        }
        64 => { start_at(1, 11, 0); g.total = 5 }                       // the menu with the lure in the water
        // koi bots: cast into the moon's path (40-45) or near the golden koi (46-47) and wait
        40 => koi_start(0, 21, 0)
        41 => koi_start(0, 0, 0)
        42 => koi_start(0, 3, 0)
        43 => koi_start(3, 20, 0)
        44 => koi_start(1, 4, 0)
        45 => koi_start(2, 0, 0)
        46 => koi_start(1, 10, 0)
        47 => koi_start(0, 13, 0)
        48 => koi_start(2, 22, 0)              // short casts at night: the Frost Trout (bridge)
        49 => koi_start(3, 22, 0)              // ... at the reeds
        22 => { start_at(0, 10, 0); g.tutorial = TUT_CAST; force_fish = 0 }   // the first hook's tutorial
        21 => {                                // a festival that comes up short
            start_at(0, 18, 50)
            g.fest = 0
            g.village = 0
            g.points = 60
            g.fest_day = 1
        }
        else => {}
    }
}

// ---- the pattern test
var pt_frames: s32
var pt_was_fight: bool
var pt_done: bool

fn pt_report(caught: bool) {
    print("PATTERN fish ")
    print_int(SEEDV)
    print(" bot ")
    print_int(BOTV)
    if caught { print(" caught") } else if phase == Phase.Fight { print(" timeout") } else { print(" lost") }
    print(" frames ")
    print_int(pt_frames)
    print(" steps ")
    print_int(f_steps)
    print(" breaks ")
    print_int(pt_breaks())
    print(" dist ")
    print_fixed(f_dist)
    println("")
}

// ---- the koi bots
var koi_casts: s32
var koi_wait: s32           // frames spent waiting with the lure in the water
var koi_inpath: s32         // ... of those, in the moon's path
var koi_first: s32 = -1     // frame of the first koi bite
var koi_bites: [14]s32
var koi_t0: s32

fn koi_start(dock: s32, h: s32, m: s32) {
    start_at(dock, h, m)
    g.total = 5
    seed((77 + SEEDV * 7919) as u32)
    swimmers_reset()
    koi_t0 = g.clock
}

fn koi_scen() -> bool { return SCENARIO >= 40 && SCENARIO <= 49 }
fn pt_breaks() -> s32 { return f_breaks }

// Where the bot wants to cast: along the moon's path, or ~5.5 short of the golden koi.
var koi_yaw: fixed
var koi_d: fixed

fn koi_target() {
    let s = stand_pos()
    koi_yaw = DOCK_YAW[g.dock]
    koi_d = 14.0
    if SCENARIO >= 48 {
        koi_d = 7.0
        return
    }
    if SCENARIO <= 45 {
        koi_yaw = moon_az
        // aim a little off now and then, like a person would (every third cast)
        let k = koi_casts % 6
        if k == 2 { koi_yaw += 0.12 }
        if k == 5 { koi_yaw -= 0.12 }
        return
    }
    for i in 0..NSWIM {
        if sw[i].id == 12 && sw[i].state == SW_WANDER {
            let d = sw[i].pos - s
            koi_yaw = atan2(d.x, d.z)
            koi_d = sqrt(d.x * d.x + d.z * d.z) - 5.5
        }
    }
}

fn koi_bot() -> vec2 {
    if phase == Phase.Idle {
        koi_target()
        let want = clamp(angle_diff(koi_yaw, DOCK_YAW[g.dock]), -1.1, 1.1)
        let dv = want - view_off
        if abs(dv) > 0.03 {
            if dv > 0.0 { return vec2(min(dv * 30, 1.0), 0.0) }
            return vec2(max(dv * 30, -1.0), 0.0)
        }
        if scen_t % 20 != 0 { return vec2(0.0, 0.0) }
        return vec2(0.0, -1.0)
    }
    if phase == Phase.Aim {
        koi_target()
        let ax = clamp(angle_diff(koi_yaw, view_yaw()) / aim_spread(), -1.0, 1.0)
        // hold just long enough for the distance wanted
        let pw = clamp((koi_d - 3.0) / cast_range(), 0.35, 1.0)
        let need = ((pw - 0.35) / 0.65 * 45) as s32
        if aim_hold < max(need, 2) { return vec2(ax, -1.0) }
        return vec2(0.0, 1.0)
    }
    if phase == Phase.Fly && fly_t == 1 { koi_casts += 1 }
    if phase == Phase.Wait {
        koi_wait += 1
        if in_moon_path(lure) { koi_inpath += 1 }
        if force_fish >= 0 && phase_t == 5 { force_bite() }
        return vec2(0.0, 0.0)
    }
    if phase == Phase.Bite { if phase_t > 6 { return vec2(0.0, -1.0) } }
    if phase == Phase.Fight { return fight_bot() }
    return vec2(0.0, 0.0)
}

fn koi_report() {
    print("koi casts ")
    print_int(koi_casts)
    print(" wait ")
    print_int(koi_wait)
    print(" inpath ")
    print_int(koi_inpath)
    print(" first ")
    print_int(koi_first)
    print(" bites")
    for f in 0..14 {
        print(" ")
        print_int(koi_bites[f])
    }
    print(" caught12 ")
    print_int(g.journal[12].caught as s32)
    print(" caught13 ")
    print_int(g.journal[13].caught as s32)
    print(" clock ")
    print_int(minutes())
    println("")
}

// ---- the pause tests
const PAUSE_LEN = 300
var pz_at: s32 = -1         // scen_t when START was pressed
var pz_done: bool

fn pause_moment() -> bool {
    match SCENARIO {
        60 => return phase == Phase.Fight && phase_t == 150
        61 => return phase == Phase.Aim && aim_hold == 20
        62 => return phase == Phase.Fly && fly_t == 9
        63 => return screen == Screen.Festival && screen_t == 380
        64 => return phase == Phase.Wait && phase_t == 60
        else => return false
    }
}

fn pause_pad() -> u32 {
    if pz_at < 0 {
        if pause_moment() && pz_at < 0 {
            pz_at = scen_t
            snapshot("before")
            return START
        }
        return 0
    }
    if pz_done && scen_t == pz_at + PAUSE_LEN + 2 { snapshot("resumed") }
    if !pz_done {
        if scen_t == pz_at + 2 { snapshot("paused") }
        if scen_t == pz_at + PAUSE_LEN - 1 { snapshot("held") }
        if scen_t == pz_at + PAUSE_LEN {
            pz_done = true
            if SCENARIO == 64 { return B }
            return START
        }
    }
    return 0
}

// Everything that would move if the world weren't frozen.
fn snapshot(label: *u8) {
    print("SNAP ")
    print(label)
    print(" tick ")
    print_int(tick_count)
    print(" clock ")
    print_int(g.clock)
    print(" screen ")
    print_int(screen as s32)
    print(" screen_t ")
    print_int(screen_t)
    print(" phase ")
    print_int(phase as s32)
    print(" phase_t ")
    print_int(phase_t)
    print(" aim ")
    print_int(aim_hold)
    print(" fly ")
    print_int(fly_t)
    print(" lure ")
    print_fixed(lure.x)
    print(",")
    print_fixed(lure.y)
    print(",")
    print_fixed(lure.z)
    print(" fish ")
    print_fixed(f_dist)
    print("/")
    print_fixed(f_tension)
    print("/")
    print_int(f_k)
    print(" sw0 ")
    print_fixed(sw[0].pos.x)
    print(",")
    print_fixed(sw[0].pos.z)
    print(" firefly ")
    print_fixed(fly_pos[0].x)
    print(" splash ")
    print_int(sp_age[0])
    print(" lanterns ")
    print_int(fl_n)
    print(" lantern0 ")
    print_fixed(fl_pos[0].y)
    print(" water ")
    print_int(water_rot)
    print(" duck ")
    print_int(pause_duck)
    print(" sfx ")
    print_int(sound_playing(CH_SFX) as s32)
    println("")
}

fn script_pad(f: s32) -> u32 {
    if SCENARIO >= 60 && SCENARIO <= 64 {
        let p = pause_pad()
        if p != 0 { return p }
        if pz_at >= 0 && !pz_done { return 0 }
        if SCENARIO == 63 && f > 900 && f % 60 == 0 { return A }
        if phase == Phase.Catch && phase_t > 60 { return A }
        return 0
    }
    if koi_scen() && phase == Phase.Wait && phase_t > 900 { return B }    // nothing for 15 s: reel in, cast again
    if koi_scen() && SHOT != 0 && phase == Phase.Catch && f_id >= 12 { return 0 }   // screenshots: stay on the koi
    if SCENARIO == 7 || SCENARIO == 11 || SCENARIO == 21 {
        if f > 500 && f % 60 == 0 { return A }
    }
    if (SCENARIO >= 4 && SCENARIO <= 5) || SCENARIO >= 12 {
        if phase == Phase.Catch && phase_t > 60 { return A }
    }
    if SCENARIO == 11 && screen == Screen.Ending && screen_t > 950 { return A }
    return 0
}

// Simulated stick for this frame.
fn bot_stick() -> vec2 {
    let t = scen_t
    if screen != Screen.Fish { return vec2(0.0, 0.0) }
    if koi_scen() { return koi_bot() }
    match phase {
        Idle => {
            if SCENARIO >= 24 && SCENARIO <= 28 { return vec2(0.0, 0.0) }
            if SCENARIO >= 29 && SCENARIO <= 31 { return vec2(0.25, 0.0) }   // pan right, 0.0055 rad a frame
            if SCENARIO == 37 && t > 40 { return vec2(0.0, -1.0) }
            if SCENARIO == 10 {
                // sweep the view left and right
                if (t / 200) % 2 == 0 { return vec2(1.0, 0.0) }
                return vec2(-1.0, 0.0)
            }
            if t > 40 { return vec2(0.0, -1.0) }          // pull back
            return vec2(0.0, 0.0)
        }
        Aim => {
            if aim_hold < 40 { return vec2(0.25, -1.0) }
            return vec2(0.0, 1.0)                         // flick
        }
        Wait => {
            if force_fish >= 0 && phase_t == 5 { force_bite() }
            // circle the stick slowly now and then (8-way, like a keyboard)
            if SCENARIO == 15 && (phase_t / 120) % 2 == 1 {
                return dir_vec((phase_t / 5) % 8)
            }
            return vec2(0.0, 0.0)
        }
        Bite => {
            if phase_t > 6 { return vec2(0.0, -1.0) }      // hook!
            return vec2(0.0, 0.0)
        }
        Fight => return fight_bot()
        else => return vec2(0.0, 0.0)
    }
}

fn force_bite() {
    let i = 0
    sw[i].id = force_fish
    sw[i].state = SW_AT_LURE
    sw[i].pos = lure
    sw[i].size_mm = random_size(force_fish)
    sw[i].t = 0
    start_bite(i)
}

var bot_dir: s32 = -1
var bot_hold: s32

var pt_ang: fixed           // the circling cheat's stick angle
var pt_stick: vec2          // the analog bot's stick

fn fight_bot() -> vec2 {
    if SCENARIO == 50 && BOTV != 0 && f_surge != 1 && f_surge != 3 && f_surge != 4 && f_surge != 5 {
        let tempo = FISH[f_id].tempo as s32
        if BOTV >= 2 && BOTV <= 7 {
            // the cheat: circle the stick whatever the pattern, clockwise (even BOT) or not,
            // at one (2-3), two (4-5) or four (6-7) octants per beat
            var oct = 1
            if BOTV >= 4 { oct = 2 }
            if BOTV >= 6 { oct = 4 }
            let step = 0.785398 * fixed(oct) / fixed(tempo)
            if BOTV % 2 == 0 { pt_ang += step } else { pt_ang -= step }
            return vec2(sin(pt_ang), cos(pt_ang))
        }
        // analog: glide in a straight line toward the wanted direction (through the centre
        // for opposite directions), arriving over about five frames; BOT 8 swings round the
        // rim instead (the shorter way) whenever the step is less than 180 degrees
        let k = keys_bot()
        if BOTV == 8 && sqrt(dot(k, k)) > 0.5 && sqrt(dot(pt_stick, pt_stick)) > 0.5 {
            let a0 = atan2(pt_stick.x, pt_stick.y)
            let a1 = atan2(k.x, k.y)
            let da = angle_diff(a1, a0)
            if abs(da) < 2.8 {
                let a = a0 + da * 0.38
                pt_stick = vec2(sin(a), cos(a))
                return pt_stick
            }
        }
        pt_stick = pt_stick + (k - pt_stick) * 0.38
        return pt_stick
    }
    return keys_bot()
}

fn keys_bot() -> vec2 {
    if f_surge == 1 || f_surge == 3 {
        bot_dir = -1          // after the lean, go straight on to the next step
        return vec2(sin(f_lean_ang), cos(f_lean_ang))
    }
    if f_surge == 4 || f_surge == 5 {
        bot_dir = -1
        return vec2(0.0, 0.0)
    }
    let info = &FISH[f_id]
    let tempo = info.tempo as s32
    let want = info.pat[f_k] as s32
    // move to the next step on the beat (faster while it charges)
    var due = tempo
    if f_surge == 2 { due = tempo / 2 }
    if f_step_t >= due - 1 || bot_dir < 0 {
        bot_dir = want
    }
    if bot_dir == DIR_C { return vec2(0.0, 0.0) }
    if want == DIR_C && f_step_t > 1 { return vec2(0.0, 0.0) }
    return dir_vec(bot_dir)
}

fn test_hook(f: s32) {
    scen_t += 1
    stick_in = bot_stick()
    if SCENARIO == 10 {
        // hop between docks every 400 frames for the perf sweep
        if scen_t % 400 == 0 {
            g.dock = (g.dock + 1) % 4
            begin_fishing()
        }
    }
    // statistics
    if scen_t > 30 {
        let u = cpu_used()
        cpu_max = max(cpu_max, u)
        tri_max = max(tri_max, world_tris + ui_tris)
        cpu_sum += u / 10
        cpu_n += 1
    }
    if scen_t % 100 == 0 {
        print("passes ")
        print_int(tris_a)
        print(" ")
        print_int(tris_b)
        print(" ")
        print_int(world_tris)
        print(" cpu ")
        print_int(cpu_used())
        print(" prof")
        for k in 0..8 {
            print(" ")
            print_int(prof[k])
        }
        println("")
    }
    if SCENARIO == 50 {
        if phase == Phase.Fight { pt_frames += 1 }
        if pt_was_fight && phase != Phase.Fight && !pt_done {
            pt_done = true
            pt_report(phase == Phase.Catch)
        }
        pt_was_fight = phase == Phase.Fight
        if !pt_done && phase == Phase.Fight && pt_frames == 2400 {
            pt_done = true
            pt_report(false)
        }
    }
    if koi_scen() {
        if phase == Phase.Bite && phase_t == 1 {
            let id = sw[hooked].id
            if id >= 0 { koi_bites[id] += 1 }
            if (id == 12 || id == 13) && koi_first < 0 { koi_first = scen_t }
        }
        if scen_t % 750 == 0 { koi_report() }
    }
    if scen_t % 300 == 0 {
        print("t=")
        print_int(scen_t)
        print(" cpu max ")
        print_int(cpu_max)
        print(" avg ")
        print_int(cpu_sum / max(cpu_n, 1) * 10)
        print(" tris max ")
        print_int(tri_max)
        print(" fan ")
        print_int(fan_squashed)
        print("/")
        print_int(fan_quads)
        print(" phase ")
        print_int(phase as s32)
        print(" dist ")
        print_fixed(f_dist)
        print(" tens ")
        print_fixed(f_tension)
        println("")
    }
}
