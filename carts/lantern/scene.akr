// Drawing a frame of the lake: the three passes (see world.akr) plus the angler, the rod
// and line, the bobber, the fish under the water and the festival lanterns.

var world_tris: s32           // triangles drawn by the passes this frame
var tris_a: s32
var prof: [8]s32
var prof_last: s32
fn pmark(i: s32) {
    let c = CYCLES as s32
    prof[i] = prof_last - c
    prof_last = c
}
var tris_b: s32
var show_angler = true
var fest_lanterns_on = false

// Sets the camera behind the angler, looking out over the water.
fn camera_at_dock() {
    let s = stand_pos()
    let y = view_yaw()
    let sn = sin(y)
    let cs = cos(y)
    cam_yaw = y
    cam_pitch = -0.15
    cam_pos = vec3(s.x - sn * 3.6, s.y + 2.25, s.z - cs * 3.6)
}

fn begin_camera() {
    camera_look(cam_pos, cam_yaw, cam_pitch)
    cam_s = sin(cam_yaw)
    cam_c = cos(cam_yaw)
}

// The whole world for the current camera.
fn draw_lake() {
    prof_last = CYCLES as s32
    begin_camera()
    lanterns_prepare()
    let before = (GPU_STATUS & 0xFFFF) as s32

    // ---- pass A: the reflection
    fog_off()
    draw_scenery(true)
    pmark(0)
    fog_off()
    draw_sky_objects(true)
    draw_clouds(true)
    bt_flush()
    draw_lantern_glows(true)
    if fest_lanterns_on {
        draw_fest_lanterns(true)
        draw_fireworks(true)
    }
    bt_flush()
    draw_sky()
    draw_sky_objects(false)
    draw_clouds(false)
    flush_pass()
    tris_a = (GPU_STATUS & 0xFFFF) as s32 - before
    pmark(1)

    // ---- pass B: the water and what lies in it
    fan_build()
    pmark(2)
    mesh(&fan.hdr)
    pmark(3)
    depth_bias(-1024)
    draw_shadows()
    bt_flush()
    draw_lantern_pools()
    draw_bobber_light()
    draw_glitter()
    draw_ripples()
    if phase == Phase.Aim { draw_aim_marker() }
    bt_flush()
    depth_bias(0)
    flush_pass()
    tris_b = (GPU_STATUS & 0xFFFF) as s32 - before - tris_a
    pmark(4)

    // ---- pass C: the world above the water
    draw_scenery(false)
    if in_view(LILY_POS[0], 14.0) || in_view(DOCK_STAND[1], 12.0) { mesh(LILIES) }
    pmark(5)
    fog_off()
    draw_garlands_day()
    bt_flush()
    if show_angler { draw_angler() }
    draw_leaping_fish()
    depth_bias(-6)
    draw_lantern_glows(false)
    bt_flush()
    depth_bias(-30)
    draw_splashes()
    draw_fireflies()
    if fest_lanterns_on {
        draw_fest_lanterns(false)
        draw_fireworks(false)
    }
    bt_flush()
    depth_bias(0)
    flush_pass()
    world_tris = (GPU_STATUS & 0xFFFF) as s32 - before
    pmark(6)
}

fn draw_angler() {
    let s = stand_pos()
    let y = view_yaw()
    mesh_at(ANGLER, s, y)
    // the bobber on the water (or the lure in the air)
    if phase == Phase.Wait || phase == Phase.Bite || phase == Phase.Fly {
        mesh_at(BOBBER, lure, 0.0)
    }
    draw_rod_and_line()
}

// The rod (a tapering screen-space strip) and the line from its tip to the lure.
fn draw_rod_and_line() {
    let root = rod_root()
    let tip = rod_tip()
    if !project(root) { return }
    let rx = proj_x
    let ry = proj_y
    let rb = depth_bucket(proj_w) - 4
    if !project(tip) { return }
    let tx = proj_x
    let ty = proj_y
    let tb = depth_bucket(proj_w) - 4
    let rodc = mix_col(rgb(40, 28, 20), rgb(130, 92, 56), (light * 200) as s32 + 56)
    // a slight bend
    let mx = (rx + tx) / 2 + (ty - ry) / 14
    let my = (ry + ty) / 2 + (rx - tx) / 14
    seg2d(rx, ry, mx, my, 2, rodc, rb)
    seg2d(mx, my, tx, ty, 1, rodc, tb)
    if phase == Phase.Catch { return }
    // the line: a sagging curve to the lure (taut in a fight)
    var sag = 0.0
    match phase {
        Wait, Bite => sag = 0.9
        Idle, Aim => sag = 0.0
        Fly => sag = 0.25
        Fight => sag = clamp(0.5 - f_tension, 0.0, 0.5) * 2
        else => sag = 0.6
    }
    var end = lure
    if phase == Phase.Idle || phase == Phase.Aim {
        end = vec3(tip.x, tip.y - 0.6, tip.z)
    }
    let linec = mix_col(rgb(90, 100, 120), rgb(225, 230, 240), (light * 256) as s32)
    var px = tx
    var py = ty
    for i in 1..9 {
        let t = fixed(i) / 8
        var p = lerp(tip, end, t)
        p.y -= sag * (t * (1.0 - t)) * 4.0
        if !project(p) { return }
        seg2d(px, py, proj_x, proj_y, 1, linec, max(depth_bucket(proj_w) - 6, 0))
        px = proj_x
        py = proj_y
    }
}

// Fish under the water: subtractive shadows by day; at night a few give themselves away
// (bubbles, a glow, a glint).
fn draw_shadows() {
    let day = light
    bt_look(F_TEX | F_SEMI, 2, SLOT_WORLD, PAL_GREY, UV_SHADOW_U, UV_SHADOW_V, UV_SHADOW_U + 31, UV_SHADOW_V + 15)
    for i in 0..NSWIM {
        let s = &sw[i]
        if s.state == SW_NONE { continue }
        var p = s.pos
        var head = s.heading
        if s.state == SW_HOOKED {
            p = fish_pos()
            head = f_ang + 3.14159 + sin(fixed(phase_t) * 0.2) * 0.4
            if f_surge == 5 { continue }
        }
        if !in_view(p, 2.0) { continue }
        let len_ = fixed(s.size_mm) / 1000 + 0.25
        if day > 0.3 {
            let k = (day * 150) as s32
            var c = scale_col(rgb(60, 56, 40), k)
            if s.id == 12 { c = scale_col(rgb(30, 50, 90), k) }   // the golden koi: a gold shimmer (less dark in blue)
            flat_quad(vec3(p.x, 0.02, p.z), len_ * 0.5, len_, head + 1.5708 + 1.5708, c)
        }
    }
    bt_flush()
    // night cues
    if night > 0.4 {
        for i in 0..NSWIM {
            let s = &sw[i]
            if s.state == SW_NONE || s.state == SW_HOOKED { continue }
            let id = s.id
            if id == 5 && (s.t + i * 31) % 70 == 0 { ripple(s.pos, 0.5, 30) }
            if id == 7 || id == 11 {
                ss_look(SS_HALO)
                sflat(vec3(s.pos.x, 0.03, s.pos.z), 0.7, 0.7, scale_col(rgb(120, 100, 40), (night * 200) as s32), 1, -1024)
            }
            if id == 13 && (s.t / 6) % 4 == 0 {
                ss_look(SS_SPARK)
                ssprite(vec3(s.pos.x, 0.15, s.pos.z), 0.25, 0.25, rgb(200, 210, 255), 1, -1024)
            }
        }
    }
    // the golden koi by day: a glint
    for i in 0..NSWIM {
        if sw[i].id == 12 && sw[i].state != SW_NONE && sw[i].state != SW_HOOKED && day > 0.3 && (sw[i].t / 5) % 6 == 0 {
            ss_look(SS_SPARK)
            ssprite(vec3(sw[i].pos.x, 0.12, sw[i].pos.z), 0.3, 0.3, rgb(255, 220, 120), 1, -1024)
        }
    }
}

// The lantern upgrade lights the water around the bobber at night.
fn draw_bobber_light() {
    if night < 0.3 { return }
    if phase != Phase.Wait && phase != Phase.Bite && phase != Phase.Fight { return }
    let k = (night * 256) as s32
    ss_look(SS_HALO)
    if g.up[UP_LANTERN] != 0 {
        sflat(vec3(lure.x, 0.03, lure.z), 2.6, 2.6, scale_col(rgb(150, 110, 60), k), 1, -1024)
    }
    if g.lure == LURE_GLOW {
        sflat(vec3(lure.x, 0.04, lure.z), 1.0, 1.0, scale_col(rgb(50, 140, 110), k * (200 + ((tick_count / 4) & 31) * 2) / 256), 1, -1024)
    }
}

// Where the cast will land, and the arc of the throw.
fn draw_aim_marker() {
    let tgt = cast_target(charge_power(), view_yaw() + aim_x * aim_spread())
    ss_look(SS_RING)
    let pulse = 0.7 + sin(fixed(tick_count) * 0.25) * 0.1
    sflat(vec3(tgt.x, 0.04, tgt.z), pulse, pulse, rgb(150, 140, 90), 1, -1024)
    aim_tgt = tgt
}

var aim_tgt: vec3

// The arc preview: dots along the throw (interface layer, additive).
fn draw_aim_arc() {
    let from = rod_tip()
    let to = aim_tgt
    let d = to - from
    let dist = sqrt(d.x * d.x + d.z * d.z)
    for i in 1..12 {
        let t = fixed(i) / 12
        var p = lerp(from, to, t)
        p.y = from.y * (1.0 - t) + (t * (1.0 - t)) * (2.0 + dist * 0.25)
        if project(p) {
            let c = scale_col(rgb(255, 240, 180), 120 + i * 10)
            ui_rect(proj_x - 1, proj_y - 1, 2, 2, c, 1)
        }
    }
}

// A trout's leap during a fight: the fish sprite arcs out of the water.
fn draw_leaping_fish() {
    if phase != Phase.Fight || f_surge != 5 { return }
    let p = fish_pos()
    let sp = f_id / 2
    let u = FISH_U[sp] as s32
    let v = FISH_V[sp] as s32
    bt_look(F_TEX, 0, SLOT_FISH, fish_pal(f_id) as u32, u, v, u + 63, v + 31)
    let c = mix_col(rgb(60, 60, 80), rgb(128, 128, 128), (light * 256) as s32 + 80)
    billboard(vec3(p.x, f_leap_h + 0.3, p.z), 1.1, 0.55, c, c)
}

// ---- festival lanterns: paper lanterns floating out over the water

const NFL = 36
var fl_pos: [36]vec3
var fl_vel: [36]vec3
var fl_age: [36]s32
var fl_n: s32

fn fest_lanterns_reset() {
    fl_n = 0
    for i in 0..NFL { fl_age[i] = 0 }
}

fn fest_lantern_spawn(origin: vec3) {
    if fl_n >= NFL { return }
    let i = fl_n
    fl_n += 1
    fl_pos[i] = vec3(origin.x + (rndf() - 0.5) * 2.0, 0.25, origin.z + (rndf() - 0.5) * 2.0)
    // drift out over the lake (away from the shore, toward the middle)
    let len_ = sqrt(origin.x * origin.x + origin.z * origin.z) + 0.01
    let sp = 0.008 + rndf() * 0.006
    fl_vel[i] = vec3(-origin.x / len_ * sp + (rndf() - 0.5) * 0.004, 0.0, -origin.z / len_ * sp + (rndf() - 0.5) * 0.004)
    fl_age[i] = 1
}

fn fest_lanterns_update() {
    for i in 0..fl_n {
        if fl_age[i] == 0 { continue }
        fl_age[i] += 1
        var p = fl_pos[i] + fl_vel[i]
        // floating on the water, some rising into the sky
        if i % 3 == 0 && fl_age[i] > 120 { p.y += 0.004 } else { p.y = 0.25 + sin(fixed(fl_age[i] + i * 17) * 0.05) * 0.04 }
        fl_pos[i] = p
    }
}

fn draw_fest_lanterns(refl: bool) {
    for i in 0..fl_n {
        if fl_age[i] == 0 { continue }
        var p = fl_pos[i]
        if !in_view(p, 2.0) { continue }
        let fade = min(fl_age[i] * 8, 256)
        ss_look(SS_HALO)
        if refl {
            ssprite(mirror(p), 0.6, 0.6, scale_col(rgb(170, 90, 40), fade), 1, -2)
        } else {
            ssprite(p, 0.7, 0.7, scale_col(rgb(200, 110, 50), fade), 1, -2)
            ss_look(SS_PAPER)
            ssprite(p, 0.2, 0.28, scale_col(rgb(150, 150, 150), fade), -1, -3)
        }
    }
}

// ---- fireworks (the grand festival)
const NFW = 4
var fw_pos: [4]vec3
var fw_age: [4]s32
var fw_col: [4]u32

fn firework(p: vec3, c: u32) {
    for i in 0..NFW {
        if fw_age[i] == 0 {
            fw_pos[i] = p
            fw_age[i] = 1
            fw_col[i] = c
            sfx_firework(p)
            return
        }
    }
}

fn fireworks_update() {
    for i in 0..NFW {
        if fw_age[i] > 0 {
            fw_age[i] += 1
            if fw_age[i] > 70 { fw_age[i] = 0 }
        }
    }
}

fn draw_fireworks(refl: bool) {
    ss_look(SS_SPARK)
    for i in 0..NFW {
        if fw_age[i] == 0 { continue }
        let t = fixed(fw_age[i]) / 70
        let c = scale_col(fw_col[i], ((1.0 - t) * 256) as s32)
        let r = 1.5 + t * 9.0
        for k in 0..8 {
            let a = fixed(k) * 0.7854
            var p = vec3(fw_pos[i].x + cos(a) * r * cam_c, fw_pos[i].y + sin(a) * r - t * t * 3.0, fw_pos[i].z - cos(a) * r * cam_s)
            if refl { p = mirror(p) }
            ssprite(p, 1.5, 1.5, c, 1, -2)
        }
    }
}
