fn terr_mesh(i: s32, refl: bool, far: bool) -> *Mesh {
    match i {
        0 => { if refl { return TERR0_R } if far { return TERR0_LO } return TERR0 }
        1 => { if refl { return TERR1_R } if far { return TERR1_LO } return TERR1 }
        2 => { if refl { return TERR2_R } if far { return TERR2_LO } return TERR2 }
        3 => { if refl { return TERR3_R } if far { return TERR3_LO } return TERR3 }
        4 => { if refl { return TERR4_R } if far { return TERR4_LO } return TERR4 }
        5 => { if refl { return TERR5_R } if far { return TERR5_LO } return TERR5 }
        6 => { if refl { return TERR6_R } if far { return TERR6_LO } return TERR6 }
        7 => { if refl { return TERR7_R } if far { return TERR7_LO } return TERR7 }
        8 => { if refl { return TERR8_R } if far { return TERR8_LO } return TERR8 }
        9 => { if refl { return TERR9_R } if far { return TERR9_LO } return TERR9 }
        10 => { if refl { return TERR10_R } if far { return TERR10_LO } return TERR10 }
        11 => { if refl { return TERR11_R } if far { return TERR11_LO } return TERR11 }
        12 => { if refl { return TERR12_R } if far { return TERR12_LO } return TERR12 }
        13 => { if refl { return TERR13_R } if far { return TERR13_LO } return TERR13 }
        14 => { if refl { return TERR14_R } if far { return TERR14_LO } return TERR14 }
        else => { if refl { return TERR0_R } return TERR0 }
    }
}
fn dock_mesh(i: s32, refl: bool, far: bool) -> *Mesh {
