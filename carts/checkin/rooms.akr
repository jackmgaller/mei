// Room detection: a room's type comes from what stands in it. Each type has a checklist of
// required objects (RT_REQ_*: "one of these, n times") and bonus objects that raise its quality.
// A room meets the first type in priority order whose checklist is complete; otherwise it is an
// unfinished room, and the type it is closest to is kept for the checklist panel.

var rooms_dirty = true
var rcount: [200][74]u8          // objects of each type per room

const PRIO: [14]u8 = [5, 4, 17, 6, 8, 12, 7, 9, 10, 11, 14, 15, 16, 13]   // suite, guest, bathroom, lobby, kitchen, bar (before restaurant: counters win), ...

// How many of a type's requirements room r meets.
fn reqs_met(r: s32, rt: s32) -> s32 {
    let n = RT_NREQ[rt] as s32
    var met = 0
    for k in 0..n { if req_ok(r, rt, k) { met += 1 } }
    return met
}

fn req_have(r: s32, rt: s32, k: s32) -> s32 {
    var have = 0
    for a in 0..3 {
        let t = RT_REQ_ALT[(rt * 7 + k) * 3 + a] as s32
        if t != 255 { have += rcount[r][t] as s32 }
    }
    return have
}

fn req_ok(r: s32, rt: s32, k: s32) -> bool { return req_have(r, rt, k) >= RT_REQ_CNT[rt * 7 + k] as s32 }

fn type_valid(r: s32, rt: s32) -> bool {
    if reqs_met(r, rt) < RT_NREQ[rt] as s32 { return false }
    return type_fits(r, rt)
}

// A room's size, floor and water fit type rt (its requirements aside).
fn type_fits(r: s32, rt: s32) -> bool {
    let rm = &rooms[r]
    if (rm.ntiles - rm.nvoid) as s32 < RT_MIN[rt] as s32 { return false }
    if rt == RT_LOBBY && rm.floor != 0 { return false }
    if rt == RT_POOL && rm.nwater < 6 { return false }
    return true
}

fn detect_room(r: s32) {
    let rm = &rooms[r]
    rm.flags = rm.flags & ~RF_VALID
    rm.best = RT_NONE as u8
    rm.missing = 0
    let k = rm.kind as s32
    if k == KIND_CORR { rm.rtype = RT_CORRIDOR as u8; rm.flags = rm.flags | RF_VALID; return }
    if k == KIND_SERVICE { rm.rtype = RT_SERVICE as u8; rm.flags = rm.flags | RF_VALID; return }
    if k == KIND_DECK {
        if type_valid(r, RT_POOL) { rm.rtype = RT_POOL as u8 } else { rm.rtype = RT_OUTDOOR as u8 }
        rm.best = RT_POOL as u8
        rm.flags = rm.flags | RF_VALID
        return
    }
    rm.rtype = RT_NONE as u8
    var best = -1
    var best_score = 0
    var best_met = 0
    for p in 0..14 {
        let rt = PRIO[p] as s32
        let n = RT_NREQ[rt] as s32
        let met = reqs_met(r, rt)
        if met >= n && type_fits(r, rt) {
            rm.rtype = rt as u8
            rm.flags = rm.flags | RF_VALID
            rm.best = rt as u8
            return
        }
        // closeness: the share of requirements met (water counts for pools)
        var score = met * 256 / max(n, 1)
        if rt == RT_POOL && rm.nwater > 0 { score += 128 }
        if score > best_score {
            best_score = score
            best = rt
            best_met = met
        }
    }
    if best >= 0 {
        rm.best = best as u8
        rm.missing = (RT_NREQ[best] as s32 - best_met) as u8
    }
}

// Quality 0..100: bonus items (each distinct type once, by appeal), windows, room to move.
fn room_quality(r: s32) {
    let rm = &rooms[r]
    let rt = rm.best as s32
    var q = 20
    let nb = RT_NBONUS[rt] as s32
    for k in 0..nb {
        let t = RT_BONUS[rt * 12 + k] as s32
        if rcount[r][t] > 0 { q += 4 + OBJ_APPEAL[t] as s32 * 3 }
    }
    q += min(rm.windows as s32 * 6, 18)
    q += min(rm.view as s32, 20)
    // crowding: few free tiles is cramped, a generous room is nicer
    var used = 0
    for t in 0..NOBJT { used += rcount[r][t] as s32 * OBJ_W[t] as s32 * OBJ_D[t] as s32 }
    let free = (rm.ntiles - rm.nvoid) as s32 - used
    if free < 3 { q -= 10 }
    if free > 8 { q += 5 }
    // a bedroom's bathroom: its en-suite's extras (a tub, a jacuzzi...) count, sharing one down the
    // hall costs
    if RT_BATH_NEED[rt] != 0 {
        let b = r_ens[r] as s32
        if b > 0 && r_bath[r] as s32 >= BATH_ENSUITE {
            for k in 0..RT_NBONUS[RT_BATHROOM] as s32 {
                let t = RT_BONUS[RT_BATHROOM * 12 + k] as s32
                if rcount[b][t] > 0 { q += 2 + OBJ_APPEAL[t] as s32 * 2 }
            }
        }
        if r_bath[r] as s32 == BATH_SHARED { q -= ECO_SHARED_QUALITY }
    }
    rm.quality = clamp(q, 0, 100) as s16
}

// ---- bathrooms (CONTRACT.md, "Feature round, C")
//
// A bathroom is a room of its own. One whose doors all open into a single bedroom (a guest room or
// a suite) is that bedroom's en-suite: private, its guests' alone. Any other bathroom with a door
// is shared: public, for the guests of bedrooms without an en-suite on the same floor, who walk
// there through corridors and public rooms. A bedroom with neither isn't bookable (it stays
// unfinished, room_why = WHY_NO_BATH); a suite needs an en-suite with a bathtub or a jacuzzi, or it
// is only a guest room. Everything here is derived from the grid, per floor, in rooms_update.

const BATH_NONE = 0
const BATH_SHARED = 1
const BATH_ENSUITE = 2
const BATH_ENSUITE_TUB = 3

const WHY_NO_BATH = 1            // a bedroom with no en-suite and no shared bathroom on its floor
const WHY_SUITE_TUB = 2          // a suite's furniture, but no en-suite with a tub: a guest room
const WHY_FIXTURES = 3           // bathroom fixtures standing in a bedroom (they don't count)
const WHY_NO_DOOR = 4            // a bathroom without a door
const WHY_LEGACY = 5             // an old save's in-room fixtures, accepted as an en-suite

var r_ens: [200]u8               // a bedroom's en-suite bathroom (0: none; maybe unfinished)
var r_host: [200]u8              // an en-suite bathroom's bedroom (0: shared, or no door)
var r_bath: [200]u8              // a bedroom's BATH_*
var r_why: [200]u8               // WHY_* (0: nothing to say)
var r_grp: [200]u8               // privacy group: the room itself, or an en-suite's bedroom
var legacy_baths: bool           // a hotel from an old save (version 3): see save.akr

fn room_ensuite(r: s32) -> s32 { if r <= 0 || r >= MAXROOM { return 0 } return r_ens[r] as s32 }
fn bath_host(b: s32) -> s32 { if b <= 0 || b >= MAXROOM { return 0 } return r_host[b] as s32 }
fn room_bath(r: s32) -> s32 { if r <= 0 || r >= MAXROOM { return 0 } return r_bath[r] as s32 }
fn room_why(r: s32) -> s32 { if r <= 0 || r >= MAXROOM { return 0 } return r_why[r] as s32 }

// The price of a night in bedroom r (CONTRACT.md).
fn room_price(r: s32) -> s32 {
    if r > 0 && rooms[r].rtype as s32 == RT_SUITE { return price_suite }
    if r > 0 && r_bath[r] as s32 == BATH_SHARED { return (price_room * ECO_SHARED_PRICE + 50) / 100 }
    return price_room
}

fn is_bedroom(r: s32) -> bool {
    if r <= 0 { return false }
    let rm = &rooms[r]
    var t = rm.rtype as s32
    if t == RT_NONE { t = rm.best as s32 }
    return t == RT_GUEST || t == RT_SUITE
}

fn is_bathroom(r: s32) -> bool {
    if r <= 0 { return false }
    let rm = &rooms[r]
    return rm.rtype as s32 == RT_BATHROOM || (rm.rtype as s32 == RT_NONE && rm.best as s32 == RT_BATHROOM)
}

fn bath_valid(b: s32) -> bool { return b > 0 && rooms[b].rtype as s32 == RT_BATHROOM }

fn has_tub(r: s32) -> bool { return rcount[r][OB_BATHTUB] > 0 || rcount[r][OB_JACUZZI] > 0 }

fn fixtures_in(r: s32) -> s32 {
    return rcount[r][OB_TOILET] as s32 + rcount[r][OB_SINK] as s32 + rcount[r][OB_SHOWER] as s32 + rcount[r][OB_BATHTUB] as s32
}

// Wall class: 0 outdoors (room 0, decks), 1 a room, 2 a corridor (as path.akr's rclass).
fn bath_cls(r: s32) -> s32 {
    if r == 0 { return 0 }
    let k = rooms[r].kind as s32
    if k == KIND_ROOM { return 1 }
    if k == KIND_CORR || k == KIND_SERVICE { return 2 }
    return 0
}

// Public for guests: not a bedroom, an en-suite, a staff-only or service room.
fn bath_public(r: s32) -> bool {
    if r == 0 { return true }
    let rm = &rooms[r]
    if rm.kind as s32 == KIND_SERVICE || is_bedroom(r) || r_host[r] != 0 { return false }
    let t = rm.rtype as s32
    return !(t == RT_KITCHEN || t == RT_LAUNDRY || t == RT_STORAGE || t == RT_STAFF)
}

// The open edges between different rooms of a floor (a door, or no wall), each pair once.
const BPAIRS = 320
var bp_a: [320]u8
var bp_b: [320]u8
var bp_n: s32
var bp_seen: [40000]u8           // [a * 200 + b]: the stamp of the floor scan that saw it
var bp_stamp: s32
var b_n1: [200]s16               // a bathroom's first neighbour (-1: none)
var b_multi: [200]u8             // ... it has more than one
var uf_up: [200]u8               // union-find over the floor's public rooms
var uf_shared: [200]u8           // the component has a shared bathroom

fn bp_add(a: s32, b: s32) {
    var x = a
    var y = b
    if x > y { x = b; y = a }
    let k = x * 200 + y
    if bp_seen[k] as s32 == bp_stamp || bp_n >= BPAIRS { return }
    bp_seen[k] = bp_stamp as u8
    bp_a[bp_n] = x as u8
    bp_b[bp_n] = y as u8
    bp_n += 1
}

fn bp_open(ra: s32, rb: s32, feat: s32) -> bool {
    let ca = bath_cls(ra)
    let cb = bath_cls(rb)
    if ca == 0 && cb == 0 { return true }
    if ca == 2 && cb == 2 { return true }
    return feat == EF_DOOR
}

fn uf_find(r: s32) -> s32 {
    var x = r
    while uf_up[x] as s32 != x { x = uf_up[x] as s32 }
    return x
}

fn bath_floor(f: s32) {
    // reset the floor's rooms
    for r in 1..nrooms {
        if rooms[r].used == 0 || rooms[r].floor as s32 != f { continue }
        r_ens[r] = 0
        r_host[r] = 0
        r_bath[r] = 0
        r_why[r] = 0
        r_grp[r] = r as u8
        b_n1[r] = -1
        b_multi[r] = 0
        uf_up[r] = r as u8
        uf_shared[r] = 0
    }
    uf_up[0] = 0
    uf_shared[0] = 0
    // the open edges between rooms
    bp_stamp += 1
    if bp_stamp > 255 {
        bp_stamp = 1
        fill16(&bp_seen[0], 0, 40000)
    }
    bp_n = 0
    let b = f * NT
    let tr = &troom[b]
    let ew = &edge_w[b]
    let en = &edge_n[b]
    for t in 0..NT {
        let ra = tr[t] as s32
        if (t & 31) != 31 {
            let rb = tr[t + 1] as s32
            if ra != rb && (f == 0 || (ra != 0 && rb != 0)) && bp_open(ra, rb, ew[t + 1] as s32) { bp_add(ra, rb) }
        }
        if t + GW < NT {
            let rb = tr[t + GW] as s32
            if ra != rb && (f == 0 || (ra != 0 && rb != 0)) && bp_open(ra, rb, en[t + GW] as s32) { bp_add(ra, rb) }
        }
    }
    // each bathroom's neighbours: one bedroom only makes it that bedroom's en-suite
    for k in 0..bp_n {
        let a = bp_a[k] as s32
        let c = bp_b[k] as s32
        if is_bathroom(a) { bath_nb(a, c) }
        if is_bathroom(c) { bath_nb(c, a) }
    }
    for r in 1..nrooms {
        if rooms[r].used == 0 || rooms[r].floor as s32 != f || !is_bathroom(r) { continue }
        let n1 = b_n1[r] as s32
        if n1 < 0 { r_why[r] = WHY_NO_DOOR as u8; continue }
        if b_multi[r] == 0 && is_bedroom(n1) {
            r_host[r] = n1 as u8
            r_grp[r] = n1 as u8
            // the bedroom's en-suite: a finished one first, with a tub first
            let e = r_ens[n1] as s32
            if e == 0 || (!bath_valid(e) && bath_valid(r)) || (bath_valid(r) && has_tub(r) && !has_tub(e)) { r_ens[n1] = r as u8 }
        }
    }
    // public rooms joined up; components with a (finished) shared bathroom
    for k in 0..bp_n {
        let a = bp_a[k] as s32
        let c = bp_b[k] as s32
        if bath_public(a) && bath_public(c) {
            let x = uf_find(a)
            let y = uf_find(c)
            if x != y { uf_up[x] = y as u8 }
        }
    }
    for r in 1..nrooms {
        if rooms[r].used == 0 || rooms[r].floor as s32 != f || r_host[r] != 0 || !bath_valid(r) || b_n1[r] < 0 { continue }
        uf_shared[uf_find(r)] = 1
    }
    // bedrooms beside a public room whose component has one
    for k in 0..bp_n {
        let a = bp_a[k] as s32
        let c = bp_b[k] as s32
        if is_bedroom(a) && bath_public(c) && uf_shared[uf_find(c)] != 0 { r_bath[a] = BATH_SHARED as u8 }
        if is_bedroom(c) && bath_public(a) && uf_shared[uf_find(a)] != 0 { r_bath[c] = BATH_SHARED as u8 }
    }
    // each bedroom's verdict
    for r in 1..nrooms {
        if rooms[r].used == 0 || rooms[r].floor as s32 != f || !is_bedroom(r) { continue }
        bath_verdict(r)
    }
}

fn bath_nb(b: s32, other: s32) {
    if b_n1[b] < 0 { b_n1[b] = other as s16 } else if b_n1[b] as s32 != other { b_multi[b] = 1 }
}

fn bath_verdict(r: s32) {
    let rm = &rooms[r]
    let e = r_ens[r] as s32
    let ens = bath_valid(e)
    let shared = r_bath[r] as s32 == BATH_SHARED
    // an old save's bedroom with its fixtures inside
    let legacy = legacy_baths && !ens && rcount[r][OB_TOILET] > 0 && rcount[r][OB_SINK] > 0 &&
                 (rcount[r][OB_SHOWER] > 0 || has_tub(r))
    if ens {
        if has_tub(e) { r_bath[r] = BATH_ENSUITE_TUB as u8 } else { r_bath[r] = BATH_ENSUITE as u8 }
    } else if legacy {
        if has_tub(r) { r_bath[r] = BATH_ENSUITE_TUB as u8 } else { r_bath[r] = BATH_ENSUITE as u8 }
        r_why[r] = WHY_LEGACY as u8
    } else if !shared {
        r_bath[r] = BATH_NONE as u8
    }
    let t = rm.rtype as s32
    // a suite without its tub is a guest room
    if t == RT_SUITE && r_bath[r] as s32 != BATH_ENSUITE_TUB {
        rm.rtype = RT_GUEST as u8
        rm.best = RT_GUEST as u8
        r_why[r] = WHY_SUITE_TUB as u8
    }
    if r_bath[r] as s32 == BATH_NONE {
        if fixtures_in(r) > 0 { r_why[r] = WHY_FIXTURES as u8 } else { r_why[r] = WHY_NO_BATH as u8 }
        // not bookable: unfinished, one thing missing
        if rm.rtype as s32 != RT_NONE {
            rm.best = rm.rtype
            rm.rtype = RT_NONE as u8
            rm.flags = rm.flags & ~RF_VALID
            rm.missing = 0
        }
        rm.missing = rm.missing + 1
    } else if fixtures_in(r) > 0 && r_why[r] == 0 {
        r_why[r] = WHY_FIXTURES as u8
    }
}

fn count_windows(r: s32) {
    let rm = &rooms[r]
    let f = rm.floor as s32
    var n = 0
    for z in rm.z0 as s32..rm.z1 as s32 + 1 {
        for x in rm.x0 as s32..rm.x1 as s32 + 1 {
            if room_at(f, x, z) != r { continue }
            if edge_feat(f, x, z, -1, 0) == EF_WINDOW { n += 1 }
            if edge_feat(f, x, z, 1, 0) == EF_WINDOW { n += 1 }
            if edge_feat(f, x, z, 0, -1) == EF_WINDOW { n += 1 }
            if edge_feat(f, x, z, 0, 1) == EF_WINDOW { n += 1 }
        }
    }
    rm.windows = min(n, 255) as u8
}

// ---- the update after an edit
//
// Only the floors whose tiles, rooms, walls or objects changed are measured again (a snapshot of
// each floor's state tells them apart), in single passes over their tiles; a full refresh happens after
// a reset or a load (rooms_refresh_all). The grand hotel's update costs about 100k cycles for a
// one-floor edit (it was about 3M, a ~6-frame freeze), and part of it waits for the next frame.

var rooms_refresh_all = true
var floors_changed: s32          // bits: floors that changed in the last rooms_update

// Each floor's state as of the last update (tiles, rooms, flags, edges, objects), compared
// word by word to find the floors an edit changed.
var snap_fl: [4608]u8
var snap_rm: [4608]u8
var snap_tf: [4608]u8
var snap_en: [4608]u8
var snap_ew: [4608]u8
var snap_ob: [4608]s16
var snap_oh: [6]u32

fn floor_differs(f: s32) -> bool {
    if snap_oh[f] != obj_hash[f] { return true }
    let b = f * NT
    if words_differ(&tfloor[b] as *u32, &snap_fl[b] as *u32, NT / 4) { return true }
    if words_differ(&troom[b] as *u32, &snap_rm[b] as *u32, NT / 4) { return true }
    if words_differ(&tflag[b] as *u32, &snap_tf[b] as *u32, NT / 4) { return true }
    if words_differ(&edge_n[b] as *u32, &snap_en[b] as *u32, NT / 4) { return true }
    if words_differ(&edge_w[b] as *u32, &snap_ew[b] as *u32, NT / 4) { return true }
    return words_differ(&tobj[b] as *u32, &snap_ob[b] as *u32, NT / 2)
}

fn words_differ(a: *u32, b: *u32, n: s32) -> bool {
    for k in 0..n { if a[k] != b[k] { return true } }
    return false
}

fn floor_snap(f: s32) {
    let b = f * NT
    memcpy(&snap_fl[b], &tfloor[b], NT)
    memcpy(&snap_rm[b], &troom[b], NT)
    memcpy(&snap_tf[b], &tflag[b], NT)
    memcpy(&snap_en[b], &edge_n[b], NT)
    memcpy(&snap_ew[b], &edge_w[b], NT)
    memcpy(&snap_ob[b] as *u8, &tobj[b] as *u8, NT * 2)
    snap_oh[f] = obj_hash[f]
}

// The objects' types, places and turns, hashed per floor (one pass over the objects).
var obj_hash: [6]u32
var shaft_hash: u32              // the elevators' places and the floors their shafts reach
var snap_shaft: u32
fn objs_hash() {
    for f in 0..NFL { obj_hash[f] = 2166136261 }
    var sh: u32 = 2166136261
    for i in 0..nobjs {
        let o = &objs[i]
        if o.used == 0 { continue }
        let f = o.f as s32
        obj_hash[f] = (obj_hash[f] ^ ((o.t as u32) | ((o.x as u32) << 8) | ((o.z as u32) << 16) | ((o.rot as u32) << 24))) * 16777619
        if o.f1 != o.f { sh = (sh ^ ((i as u32) | ((o.f as u32) << 12) | ((o.f1 as u32) << 16))) * 16777619 }
    }
    shaft_hash = sh
}

// Fills n bytes (a multiple of 16, word aligned) with the word w, 16 bytes a store.
fn fill16(dst: *u8, w: s32, n: s32) {
    let q = dst as *ivec4
    let v = ivec4(w, w, w, w)
    for k in 0..n / 16 { q[k] = v }
}

// The objects of each room on the floors in `mask`, by type.
fn rooms_count(mask: s32) {
    if mask == (1 << NFL) - 1 {
        fill16(&rcount[0][0], 0, 200 * 74)
    } else {
        for r in 1..nrooms {
            if rooms[r].used == 0 || mask & (1 << rooms[r].floor as s32) == 0 { continue }
            let row = &rcount[r][0]
            for t in 0..74 { row[t] = 0 }
        }
    }
    for i in 0..nobjs {
        let o = &objs[i]
        if o.used == 0 || mask & (1 << o.f as s32) == 0 { continue }
        let r = troom[o.f as s32 * NT + o.z as s32 * GW + o.x as s32] as s32
        o.room = r as u8
        if r > 0 && rcount[r][o.t as s32] < 255 { rcount[r][o.t as s32] += 1 }
    }
}

// Tiles, voids, water, bounding box and windows of every room on floor f, in one pass.
var mf_n: [200]s32
var mf_v: [200]s32
var mf_w: [200]s32
var mf_win: [200]s32
var mf_x0: [208]u8
var mf_z0: [208]u8
var mf_x1: [208]u8
var mf_z1: [208]u8
fn measure_floor(f: s32) {
    fill16(&mf_n[0] as *u8, 0, 800)
    fill16(&mf_v[0] as *u8, 0, 800)
    fill16(&mf_w[0] as *u8, 0, 800)
    fill16(&mf_win[0] as *u8, 0, 800)
    fill16(&mf_x0[0], 0x63636363, 208)
    fill16(&mf_z0[0], 0x63636363, 208)
    fill16(&mf_x1[0], 0, 208)
    fill16(&mf_z1[0], 0, 208)
    let b = f * NT
    let tr = &troom[b]
    let tf = &tflag[b]
    let ew = &edge_w[b]
    let en = &edge_n[b]
    for t in 0..NT {
        let r = tr[t] as s32
        let x = t & 31
        let z = ROWZ[t >> 5] as s32
        if ew[t] as s32 == EF_WINDOW {
            mf_win[r] += 1
            if x > 0 { mf_win[tr[t - 1] as s32] += 1 }
        }
        if en[t] as s32 == EF_WINDOW {
            mf_win[r] += 1
            if z > 0 { mf_win[tr[t - GW] as s32] += 1 }
        }
        if r == 0 { continue }
        mf_n[r] += 1
        let fl = tf[t] as s32
        if fl & TF_VOID != 0 { mf_v[r] += 1 }
        if fl & TF_WATER != 0 { mf_w[r] += 1 }
        if x < mf_x0[r] as s32 { mf_x0[r] = x as u8 }
        if x > mf_x1[r] as s32 { mf_x1[r] = x as u8 }
        if z < mf_z0[r] as s32 { mf_z0[r] = z as u8 }
        if z > mf_z1[r] as s32 { mf_z1[r] = z as u8 }
    }
    for r in 1..nrooms {
        let rm = &rooms[r]
        if rm.used == 0 || rm.floor as s32 != f { continue }
        rm.ntiles = mf_n[r] as s16
        rm.nvoid = mf_v[r] as s16
        rm.nwater = mf_w[r] as s16
        rm.windows = min(mf_win[r], 255) as u8
        rm.x0 = mf_x0[r]
        rm.z0 = mf_z0[r]
        rm.x1 = mf_x1[r]
        rm.z1 = mf_z1[r]
        if rm.ntiles == 0 { rm.used = 0 }
    }
}

fn rooms_update() {
    rooms_dirty = false
    edges_dirty = false
    elevators_respan()
    objs_hash()
    // edits happen on the floor in view (stairs cut into the one above, shafts run up from it)
    let all = rooms_refresh_all
    var f0 = 0
    if !all { f0 = max(view_floor - 1, 0) }
    // floors above the next one change only with their objects, or when a shaft grows or shrinks
    let far = !all && screen == Screen.Play && shaft_hash == snap_shaft
    snap_shaft = shaft_hash
    var mask = 0
    for f in f0..NFL {
        if far && f > view_floor + 1 && snap_oh[f] == obj_hash[f] { continue }
        if all || floor_differs(f) {
            mask = mask | (1 << f)
            clean_edges(f)
            floor_snap(f)
        }
    }
    rooms_refresh_all = false
    floors_changed = mask
    if mask == 0 { return }
    for f in 0..NFL { if mask & (1 << f) != 0 { measure_floor(f) } }
    rooms_count(mask)
    for r in 1..nrooms {
        let rm = &rooms[r]
        if rm.used == 0 || mask & (1 << rm.floor as s32) == 0 { continue }
        detect_room(r)
    }
    if all { for r in 0..MAXROOM { r_grp[r] = r as u8 } }
    for f in 0..NFL { if mask & (1 << f) != 0 { bath_floor(f) } }
    room_classes()
    elevs_rebuild()
    reception_queues_reset()
    // who sits where (objects may have gone)
    fill16(&spot_mask[0], 0, MAXOBJ)
    for i in 0..npeople {
        let p = &people[i]
        if p.used == 0 { continue }
        if p.seat >= 0 && p.sspot >= 0 && objs[p.seat as s32].used != 0 {
            spot_mask[p.seat as s32] = spot_mask[p.seat as s32] | ((1 << (p.sspot as s32 & 7)) as u8)
        }
        if p.obj < 0 || p.spot < 0 { continue }
        let oi = p.obj as s32
        if objs[oi].used == 0 { continue }
        spot_mask[oi] = spot_mask[oi] | ((1 << (p.spot as s32 & 7)) as u8)
    }
    // the rest (views, qualities, the entrance, paths) waits for the next frame after an edit
    // in play, whose frame is busy enough (anything else, a reset, a load, a setup, finishes now)
    rooms_stage2 = rooms_stage2 | mask
    rooms_stage2_t = tick_count
    if all || screen != Screen.Play { rooms_finish() }
}

var rooms_stage2: s32            // floors whose second stage is still to do
var rooms_stage2_t: s32          // the frame the first stage ran

// The second stage of an update (from paths_update, the frame after the edit; or now).
fn rooms_finish() {
    let mask = rooms_stage2
    if mask == 0 { return }
    rooms_stage2 = 0
    arch_update(mask)
    let top = top_floor()
    for r in 1..nrooms {
        let rm = &rooms[r]
        if rm.used == 0 { continue }
        let was = rm.flags & RF_PENTHOUSE
        rm.flags = rm.flags & ~RF_PENTHOUSE
        if rm.rtype as s32 == RT_SUITE && rm.floor as s32 == top && rm.floor > 0 { rm.flags = rm.flags | RF_PENTHOUSE }
        if mask & (1 << rm.floor as s32) != 0 || was != rm.flags & RF_PENTHOUSE { room_quality(r) }
    }
    rooms_after_update()
    if mask & 1 != 0 { entrance_update() }
    paths_changed(mask)
}

fn room_type_name(rt: s32) -> *u8 { return str_of(RT_NAME_OFF[rt] as s32) }
