// Check-In!: the frame loop, input and screens (the HUD is in hud.akr).
import "gen.akr"
import "art_link.akr"
import "audio_link.akr"
import "ui.akr"
import "style.akr"
import "world.akr"
import "render.akr"
import "objects.akr"
import "build.akr"
import "paste.akr"
import "rooms.akr"
import "path.akr"
import "people.akr"
import "transport.akr"
import "people_draw.akr"
import "sim.akr"
import "guests.akr"
import "staff.akr"
import "jobs.akr"
import "screens.akr"
import "save.akr"
import "lighting.akr"
import "overlays.akr"
import "hud.akr"
import "scripted.akr"
import "sim_vis.akr"

enum Screen { Title, Play, Pause }

var screen = Screen.Play
var screen_t: s32
var tick_count: s32
var show_debug: bool
var stars: s32

// input, sampled once per frame through input_pad() / input_stick()
var pad_now: u32
var pad_prev: u32
var stick_in: vec2
var rep_t: [16]s32

fn held_in(b: u32) -> bool { return pad_now & b != 0 }
fn btnp_in(b: u32) -> bool { return pad_now & ~pad_prev & b != 0 }
fn btnr_in(b: u32) -> bool { return ~pad_now & pad_prev & b != 0 }

// Pressed, or held long enough to repeat (menus).
fn rep_in(b: u32) -> bool {
    var i = 0
    while ((1 as u32) << (i as u32)) != b && i < 15 { i += 1 }
    if pad_now & b == 0 {
        rep_t[i] = 0
        return false
    }
    rep_t[i] += 1
    let t = rep_t[i]
    return t == 1 || (t > 18 && t % 5 == 0)
}

fn init() {
    load_texture(SLOT_UI, GEN_UI_TEX, len(GEN_UI_TEX))
    load_texture(SLOT_HUD, GEN_HUD_TEX, len(GEN_HUD_TEX))
    load_palette(GEN_PAL_BASE * 16, GEN_PAL, len(GEN_PAL))
    if ART_PRESENT { art_load() }
    mb_init()
    world_reset()
    audio_init()
    seed(2001)
    enter_title()
    test_init()
}

// Everything back to an empty lot (new game, loading, the title backdrop).
fn new_hotel_state() {
    world_reset()
    memset(&people[0] as *u8, 0, sizeof(Person) * MAXP)
    npeople = 0
    memset(&jobs[0] as *u8, 0, sizeof(Job) * MAXJOB)
    njobs = 0
    memset(&orders[0] as *u8, 0, sizeof(Order) * MAXORD)
    memset(&objs[0] as *u8, 0, sizeof(Obj) * MAXOBJ)
    nobjs = 0
    nelevs = 0
    for k in 0..MAXELEV { elevs[k].obj = -1 }
    for k in 0..NLG { ledger[k] = 0; ledger_y[k] = 0 }
    reviews_n = 0
    reviews_avg10 = 0
    day = 1
    tod = 8 * 60 * MIN_FRAMES
    money = 60000
    loan = 50000
    stars = 0
    reputation = 50
    price_room = 79
    price_suite = 249
    speed = 1
    view_rot = 2
    view_zoom = 1
    view_floor = 0
    tool = Tool.Inspect
    menu_open = false
    guide_room = 0
    guide_host = 0
    guide_t = 0
    cpq_stage = 0
    cpq_n = 0
    drop_t = 0
    deliveries_left = 0
    service_wait_avg = 0
    rooms_dirty = true
    cache_dirty = true
    paths_invalidate()
}

fn update() {
    pad_prev = pad_now
    pad_now = input_pad(tick_count)
    stick_in = input_stick(tick_count)
    test_hook(tick_count)
    tick_count += 1
    screen_t += 1
    if msg_t > 0 { msg_t -= 1 }
    saving_update()
    match screen {
        Title => title_update()
        Play => {
            if menu_open { menu_update() } else { build_update() }
            select_update()
            if btnp_in(START) && !menu_open && !paste_busy() { open_pause() }
            transition_update()
            cursor_anim()
            camera_follow()
            drop_update()
            paste_update()
            info_update()
        }
        Pause => pause_update()
    }
    if rooms_dirty {
        rooms_update()
        rooms_watch()
    }
    // the simulation runs while playing (not on the pause menu)
    if screen == Screen.Play || screen == Screen.Title {
        for k in 0..speed { sim_tick() }
    }
    paths_update()
    lighting_frame()
    if screen == Screen.Play { ambience_update(); goal_update() } else { ambience_off() }
    audio_update(hour(), minute() % 60)
    if star_flash > 0 { star_flash -= 1 }
    if review_new > 0 { review_new -= 1 }
    if day_report_t > 0 { day_report_t -= 1 }
    hud_update()
    toasts_update()
}

// SELECT: a tap cycles the speed (x1, x2, x4, paused); held, the d-pad picks an overlay.
var sel_used: bool

fn select_update() {
    if btnp_in(SELECT) {
        sel_used = false
        sel_held = 0
    }
    if held_in(SELECT) {
        sel_held += 1
        var ov = -1
        if btnp_in(UP) { ov = OV_ROOMS }
        if btnp_in(RIGHT) { ov = OV_NOISE }
        if btnp_in(DOWN) { ov = OV_STAFF }
        if btnp_in(LEFT) { ov = OV_MOOD }
        if ov >= 0 {
            if overlay == ov { overlay = OV_NONE } else { overlay = ov }
            ov_fade = 0
            sel_used = true
            fx(FX_TAB)
        }
    }
    if btnr_in(SELECT) && !sel_used && sel_held < 30 && !menu_open {
        if speed == 0 { speed = 1 } else if speed == 1 { speed = 2 } else if speed == 2 { speed = 4 } else { speed = 0 }
        prev_speed = max(speed, 1)
        hud_speed = -1
        hud_update()
        fx(FX_CLICK)
    }
}

fn fx_at(id: s32, f: s32) {
    if f == view_floor { fx(id) }
}

fn draw() {
    ui_tris = 0
    cls(sky_col())
    begin_world()
    draw_people()
    draw_elevators()
    draw_glows()
    draw_lower()
    match screen {
        Title => draw_title()
        Play => {
            draw_overlay()
            draw_build_overlay()
            draw_effects()
            draw_transition()
            draw_info()
            draw_ticker()
            draw_hud()
            draw_build_menu()
        }
        Pause => {
            draw_hud()
            draw_pause()
        }
    }
    draw_saving()
    if show_debug { draw_debug() }
    frame_words = ((__arena_ptr as s32) - ((&__arena[0]) as s32)) / 4
    // the GPU draws 2,000 triangles a frame and the interface comes last: when zoomed in on a
    // crowded view, fall back to the low-detail meshes (until the view changes)
    if !cache_lo && view_zoom == 2 && tris_drawn() + lo_tris + ui_tris > 1930 {
        cache_lo = true
        cache_dirty = true
    }
}

var frame_words: s32             // per-frame packet arena used (debug)

