// Building: the cursor, the camera that follows it, view changes, the build tools, the placement
// ghost and the build drawer. Owner: workstream B (UI and controls). See CONTRACT.md.
//
// The cursor lives on the grid. The d-pad steps exactly one tile along a grid axis (UP is the
// axis that points up-right on screen, RIGHT the one that points down-right, whatever the view
// rotation), repeating after 12 frames and then every 4; the most recently pressed direction
// wins, so a drag is always a clean rectangle. The stick moves a free point smoothly (the tile
// under it is the cursor tile) and eases it onto the tile centre when released. The highlight
// eases between tiles over about 3 frames; the camera follows softly with a little lookahead.
//
// Tools:
//   paint (a room type with its floor finish, or a bare finish) - hold A and move to drag a rectangle
//   object - A places (the anchor tile is the cursor tile, the footprint is centred on it), Y turns
//   door / window - A on a wall edge of the cursor tile (Y picks another edge)
//   void / glass void - drag on an upper floor to open it to the floor below
//   demolish - A on an object removes it; drag over tiles removes floors (half refunded)

enum Tool { Inspect, Paint, Object, Door, Window, Void, VoidGlass, Demolish }

var tool = Tool.Inspect
var tool_arg: s32
var tool_rot: s32
var tool_rt: s32 = -1            // Paint: the room type being built (-1: a bare floor finish)
var cur_x: fixed = 16.0          // the cursor's point, world units on the viewed floor
var cur_z: fixed = 10.0
var cur_tx: s32                  // the cursor tile
var cur_tz: s32
var cur_hold: s32                // frames the stick has been pushed (acceleration)
var dragging: bool
var drag_x0: s32
var drag_z0: s32
var msg: *u8                     // (legacy: the latest toast, for tests and save.akr)
var msg_t: s32
var msg_col: u32
var money: s32 = 30000
var last_err: s32

fn say(s: *u8, c: u32) {
    msg = s
    msg_t = 150
    msg_col = c
    toast(s, c)
}

// ---- the cursor

var cu_vx: fixed = 16.5          // the highlight (eased toward the cursor tile's centre)
var cu_vz: fixed = 10.5
var cu_dir: u32                  // the d-pad direction being held (the latest pressed)
var cu_rep: s32                  // frames it has been held
var cu_stick: bool               // the stick moved the cursor this frame
var cu_snap: s32                 // frames left of easing onto the tile centre after the stick
var cu_moved: s32                // frames since the cursor tile last changed
var cu_bump: s32                 // frames left of the edge bump
var cu_bdx: s32                  // bump direction on screen
var cu_bdy: s32
var cu_last_gx: s32              // grid direction of the last step (door/window tools)
var cu_last_gz: s32

// The grid step for a d-pad direction in the current view (see the header).
var gd_x: s32
var gd_z: s32
fn grid_dir(b: u32) {
    // UP per view_rot: +x, -z, -x, +z; RIGHT: -z, -x, +z, +x
    var ux = 0
    var uz = 0
    match view_rot & 3 {
        0 => ux = 1
        1 => uz = -1
        2 => ux = -1
        else => uz = 1
    }
    // RIGHT is UP turned a quarter: (ux, uz) -> (uz, -ux)
    gd_x = 0
    gd_z = 0
    if b == UP { gd_x = ux; gd_z = uz }
    if b == DOWN { gd_x = -ux; gd_z = -uz }
    if b == RIGHT { gd_x = uz; gd_z = -ux }
    if b == LEFT { gd_x = -uz; gd_z = ux }
}

fn cursor_set_tile(tx: s32, tz: s32) {
    cur_tx = clamp(tx, 0, GW - 1)
    cur_tz = clamp(tz, 0, GH - 1)
    cur_x = fixed(cur_tx) + 0.5
    cur_z = fixed(cur_tz) + 0.5
}

fn cursor_step(b: u32) {
    grid_dir(b)
    let nx = cur_tx + gd_x
    let nz = cur_tz + gd_z
    cu_last_gx = gd_x
    cu_last_gz = gd_z
    if !in_lot(nx, nz) {
        // the lot edge: a small bump instead of sliding along it
        if cu_bump == 0 {
            cu_bump = 6
            set_camera()
            project(vec3(fixed(cur_tx) + 0.5, fixed(view_floor) * STOREY, fixed(cur_tz) + 0.5))
            let ax = proj_x
            let ay = proj_y
            project(vec3(fixed(nx) + 0.5, fixed(view_floor) * STOREY, fixed(nz) + 0.5))
            cu_bdx = sgn(proj_x - ax)
            cu_bdy = sgn(proj_y - ay)
            sfx_at(Sfx.Click, 0, 90)
        }
        return
    }
    cursor_set_tile(nx, nz)
    cu_snap = 0
    edge_follow()
    fx(FX_CLICK)
}

fn cursor_update(st: vec2) {
    // (the cursor may have been placed directly: new game, recentring, loading)
    cur_tx = clamp(cur_x as s32, 0, GW - 1)
    cur_tz = clamp(cur_z as s32, 0, GH - 1)
    let ox = cur_tx
    let oz = cur_tz
    cu_stick = false
    // d-pad: one tile along the grid, the most recently pressed direction wins
    let held = pad_now & (UP | DOWN | LEFT | RIGHT)
    let fresh = held & ~pad_prev
    if fresh != 0 {
        cu_dir = fresh & (0 - fresh)              // the lowest new bit
        cu_rep = 0
        cursor_step(cu_dir)
    } else if held & cu_dir != 0 {
        cu_rep += 1
        if cu_rep >= 12 && (cu_rep - 12) % 4 == 0 { cursor_step(cu_dir) }
    } else {
        cu_dir = 0
        if held != 0 {
            cu_dir = held & (0 - held)
            cu_rep = 4
        }
    }
    // the stick: a free point, normalised, accelerating a little while held
    var sx = st.x
    var sy = st.y
    let m2 = sx * sx + sy * sy
    if held == 0 && m2 > 0.01 {
        if m2 > 1.0 {
            let m = sqrt(m2)
            sx = sx / m
            sy = sy / m
        }
        cur_hold += 1
        var speed = 1.0 + fixed(min(cur_hold, 45)) / 18
        if view_zoom == 0 { speed = speed * 1.3 }
        let s = sin(cam_yaw)
        let c = cos(cam_yaw)
        let k = speed / ppu
        let up = sy * 1.74                        // screen up is foreshortened ground
        cur_x = clamp(cur_x + (sx * c + up * s) * k, 0.02, fixed(GW) - 0.02)
        cur_z = clamp(cur_z + (-sx * s + up * c) * k, 0.02, fixed(GH) - 0.02)
        cur_tx = cur_x as s32
        cur_tz = cur_z as s32
        cu_stick = true
        cu_snap = 4
    } else {
        cur_hold = 0
        if cu_snap > 0 {
            // ease onto the tile centre over 4 frames
            let cx = fixed(cur_tx) + 0.5
            let cz = fixed(cur_tz) + 0.5
            cur_x = cur_x + (cx - cur_x) / cu_snap
            cur_z = cur_z + (cz - cur_z) / cu_snap
            cu_snap -= 1
        }
    }
    if cur_tx != ox || cur_tz != oz {
        cu_moved = 0
        if cu_stick { fx(FX_CLICK) }
    }
}

// Every frame (also while the drawer is open): the highlight, the bump, the ghost's easing.
fn cursor_anim() {
    cu_moved += 1
    if cu_bump > 0 { cu_bump -= 1 }
    let tx = fixed(cur_tx) + 0.5
    let tz = fixed(cur_tz) + 0.5
    if abs(tx - cu_vx) > 3.0 || abs(tz - cu_vz) > 3.0 {
        cu_vx = tx
        cu_vz = tz
    } else if cu_dir != 0 && cu_rep >= 10 {
        // held: glide at the repeat speed (a tile every 4 frames), so the motion is even
        cu_vx = cu_vx + clamp(tx - cu_vx, -0.25, 0.25)
        cu_vz = cu_vz + clamp(tz - cu_vz, -0.25, 0.25)
    } else {
        cu_vx = cu_vx + (tx - cu_vx) / 2
        cu_vz = cu_vz + (tz - cu_vz) / 2
        if abs(tx - cu_vx) < 0.02 { cu_vx = tx }
        if abs(tz - cu_vz) < 0.02 { cu_vz = tz }
    }
}

fn sgn(v: s32) -> s32 {
    if v > 0 { return 1 }
    if v < 0 { return -1 }
    return 0
}

// ---- the camera: a soft follow with lookahead
//
// The view pans by whole pixels (the static cache shifts), but the follow runs in fixed point:
// a velocity that accelerates at most CAM_ACC px/frame^2 toward a target that keeps the cursor
// (plus a lookahead along its motion) within a small soft zone around the centre, and drifts
// it gently back to the centre inside the zone. No dead-zone box, no overshoot.

var pan_tx: s32                  // (kept for the title backdrop drift)
var pan_ty: s32
var cam_fx: fixed                // the pan, sub-pixel
var cam_fy: fixed
var cam_vx: fixed                // pan velocity, px/frame
var cam_vy: fixed
var cam_lx: fixed                // smoothed screen velocity of the followed point
var cam_ly: fixed
var cam_px: s32                  // its screen position last frame (without the pan)
var cam_py: s32
var cam_slide: s32               // floor-change slide offset (px), eases to 0
var cam_cy: s32 = 127            // the screen y the cursor is kept around

const CAM_ZONE = 24
const CAM_ACC = 0.5
const CAM_VMAX = 8.0
const CAM_LOOK = 8

fn cam_axis(err: fixed, v: fixed) -> fixed {
    let inner = clamp(err, -24.0, 24.0)
    let outer = err - inner
    let want = outer * 0.14 + inner * 0.035
    return v + clamp(want - v, -CAM_ACC, CAM_ACC)
}

fn camera_follow() {
    set_camera()
    var fx0 = cu_vx
    var fz0 = cu_vz
    if cu_stick || cu_snap > 0 { fx0 = cur_x; fz0 = cur_z }
    if !project(vec3(fx0, fixed(view_floor) * STOREY, fz0)) { return }
    let sx = proj_x - pan_x
    let sy = proj_y - pan_y
    cam_lx = cam_lx * 0.7 + fixed(sx - cam_px) * 0.3
    cam_ly = cam_ly * 0.7 + fixed(sy - cam_py) * 0.3
    cam_px = sx
    cam_py = sy
    var cy = 127
    if menu_open { cy = 86 }
    if cam_cy != cy { cam_cy += sgn(cy - cam_cy) * min(abs(cy - cam_cy), 3) }
    let lx = clamp(cam_lx * CAM_LOOK, -40.0, 40.0)
    let ly = clamp(cam_ly * CAM_LOOK, -30.0, 30.0)
    let ex = fixed(160 - sx) - lx - cam_fx
    let ey = fixed(cam_cy - sy) - ly - cam_fy
    cam_vx = clamp(cam_axis(ex, cam_vx), -CAM_VMAX, CAM_VMAX)
    cam_vy = clamp(cam_axis(ey, cam_vy), -CAM_VMAX, CAM_VMAX)
    cam_fx = cam_fx + cam_vx
    cam_fy = cam_fy + cam_vy
    if cam_slide != 0 && !(tr_on && tr_t <= 4) { cam_slide = cam_slide * 2 / 3 }   // (slides in as the fade lifts)
    pan_x = (cam_fx + 0.5) as s32
    pan_y = (cam_fy + 0.5) as s32 + cam_slide
    pan_tx = pan_x
    pan_ty = pan_y
    set_camera()
}

// Re-centres the view on the cursor (after a rotation, zoom or floor change, or a jump).
fn view_recentre() {
    cache_lo = false
    pan_x = 0
    pan_y = 0
    cursor_set_tile(cur_x as s32, cur_z as s32)
    cu_vx = cur_x
    cu_vz = cur_z
    set_camera()
    var cy = 127
    if menu_open { cy = 86 }
    cam_cy = cy
    if project(vec3(cur_x, fixed(view_floor) * STOREY, cur_z)) {
        pan_x = 160 - proj_x
        pan_y = cy - proj_y
        cam_px = proj_x
        cam_py = proj_y
    }
    cam_fx = fixed(pan_x)
    cam_fy = fixed(pan_y)
    cam_vx = 0.0
    cam_vy = 0.0
    cam_lx = 0.0
    cam_ly = 0.0
    pan_tx = pan_x
    pan_ty = pan_y
    cache_dirty = true
}

// ---- view changes: rotate, zoom and floor, behind a short fade (7 frames)
//
// Stage 1 darkens a little, 2 is half the ambient tint, 3 applies the change under the opaque
// tint (the cache rebuild happens in a covered frame) and 4 holds it, then 5-7 fade back in; a
// floor change also slides the new floor 12 px into place. Further requests wait. Stage 4
// holds (up to TR_HOLD_MAX frames) until the rebuilt view is ready (render's view_ready()), so
// the old view never shows through the fade-in.

const TR_APPLY = 3
const TR_END = 7
const TR_HOLD_MAX = 30
var tr_on: bool
var tr_hold: s32                 // frames stage 4 has waited for the rebuild
var tr_t: s32                    // the stage being shown (0: none)
var tr_kind: s32                 // 1 rotate, 2 zoom, 3 floor
var tr_arg: s32
var tr_floor_from: s32           // (the HUD's floor badge animates from this)
var tr_badge_t: s32

fn view_change(kind: s32, arg: s32) {
    if tr_on { return }
    if kind == 2 {
        let z = clamp(view_zoom + arg, 0, 2)
        if z == view_zoom { sfx_at(Sfx.Click, 0, 90); return }
    }
    if kind == 3 {
        let f = clamp(arg, 0, NFL - 1)
        if f == view_floor { sfx_at(Sfx.Click, 0, 90); return }
    }
    tr_on = true
    tr_t = 0
    tr_hold = 0
    tr_kind = kind
    tr_arg = arg
    fx(FX_TAB)
}

fn transition_update() {
    if tr_badge_t > 0 { tr_badge_t -= 1 }
    if !tr_on { return }
    if tr_t == 4 && !view_ready() && tr_hold < TR_HOLD_MAX {
        tr_hold += 1
        return
    }
    tr_t += 1
    if tr_t > TR_END {
        tr_on = false
        tr_t = 0
        return
    }
    if tr_t == TR_APPLY {
        match tr_kind {
            1 => {
                view_rot = (view_rot + tr_arg) & 3
                view_recentre()
            }
            2 => {
                view_zoom = clamp(view_zoom + tr_arg, 0, 2)
                view_recentre()
            }
            else => {
                let nf = clamp(tr_arg, 0, NFL - 1)
                tr_floor_from = view_floor
                tr_badge_t = 12
                view_floor = nf
                view_recentre()
                if nf > tr_floor_from { cam_slide = 12 } else { cam_slide = -12 }
                pan_y += cam_slide
            }
        }
    }
}

// The cover over the world (drawn after the world, before the HUD).
fn draw_transition() {
    let tint = ST_HUD_BAR
    match tr_t {
        1 => ui_rect(0, 0, 320, 240, rgb(48, 48, 44), 2)
        2, 5 => ui_rect(0, 0, 320, 240, tint, 0)
        3, 4 => ui_rect(0, 0, 320, 240, tint, -1)
        6 => ui_rect(0, 0, 320, 240, rgb(48, 48, 44), 2)
        7 => ui_rect(0, 0, 320, 240, rgb(18, 18, 16), 2)
        else => {}
    }
}

fn set_floor(f: s32) { view_change(3, f) }
fn rotate_view(d: s32) { view_change(1, d) }
fn zoom_view(d: s32) { view_change(2, d) }

// ---- the edge under the cursor (door and window tools)

var edge_x: s32
var edge_z: s32
var edge_dx: s32
var edge_dz: s32
var edge_pref: s32 = 3           // 0 -x, 1 +x, 2 -z, 3 +z

fn edge_vec(k: s32) {
    edge_dx = 0
    edge_dz = 0
    match k & 3 {
        0 => edge_dx = -1
        1 => edge_dx = 1
        2 => edge_dz = -1
        else => edge_dz = 1
    }
}

// After a d-pad step: walking into a wall picks that wall.
fn edge_follow() {
    if tool != Tool.Door && tool != Tool.Window { return }
    var k = 0
    if cu_last_gx == 1 { k = 1 }
    if cu_last_gz == -1 { k = 2 }
    if cu_last_gz == 1 { k = 3 }
    if wall_between(view_floor, cur_tx, cur_tz, cu_last_gx, cu_last_gz) { edge_pref = k }
}

fn pick_edge() {
    edge_x = cur_tx
    edge_z = cur_tz
    if cu_stick || cu_snap > 0 {
        // the stick: the edge nearest the free point
        let fx = cur_x - fixed(cur_tx)
        let fz = cur_z - fixed(cur_tz)
        var best = fx
        var k = 0
        if 1.0 - fx < best { best = 1.0 - fx; k = 1 }
        if fz < best { best = fz; k = 2 }
        if 1.0 - fz < best { k = 3 }
        edge_pref = k
    }
    // the preferred edge if it has a wall, else the next one round that does
    for i in 0..4 {
        edge_vec(edge_pref + i)
        if wall_between(view_floor, edge_x, edge_z, edge_dx, edge_dz) { return }
    }
    edge_vec(edge_pref)
}

fn edge_cycle() {
    for i in 1..5 {
        edge_vec(edge_pref + i)
        if wall_between(view_floor, cur_tx, cur_tz, edge_dx, edge_dz) {
            edge_pref = (edge_pref + i) & 3
            fx(FX_CLICK)
            return
        }
    }
}

// ---- costs and checks

fn tile_cost(fk: s32) -> s32 { return FLOORK_PRICE[fk] as s32 }

// The drag rectangle (inclusive), from the drag start to the cursor tile.
var rx0: s32
var rz0: s32
var rx1: s32
var rz1: s32

fn drag_rect() {
    if dragging {
        rx0 = min(drag_x0, cur_tx)
        rx1 = max(drag_x0, cur_tx)
        rz0 = min(drag_z0, cur_tz)
        rz1 = max(drag_z0, cur_tz)
    } else {
        rx0 = cur_tx
        rx1 = cur_tx
        rz0 = cur_tz
        rz1 = cur_tz
    }
}

// Validity of painting floor key fk over the rectangle; returns the cost (or -1 when invalid).
var paint_target: s32            // the room the paint extends (0: a new room)

fn paint_tile_ok(f: s32, x: s32, z: s32, fk: s32) -> bool {
    if !paint_ok(f, x, z, fk) { return false }
    if FLOORK_KIND[fk] as s32 == KIND_POOL { return true }
    let t = tix(f, x, z)
    return !(tobj[t] >= 0 && troom[t] as s32 != paint_target)
}

fn paint_eval(fk: s32) -> s32 {
    let f = view_floor
    let kind = FLOORK_KIND[fk] as s32
    var cost = 0
    // extend the room the drag started in, if it is of the same kind and finish
    paint_target = 0
    let r0 = room_at(f, drag_x0, drag_z0)
    if kind != KIND_POOL && r0 != 0 && rooms[r0].kind as s32 == kind && rooms[r0].fk as s32 == fk { paint_target = r0 }
    for z in rz0..rz1 + 1 {
        for x in rx0..rx1 + 1 {
            if !paint_tile_ok(f, x, z, fk) { return -1 }
            let t = tix(f, x, z)
            if kind == KIND_POOL {
                if tflag[t] & TF_WATER == 0 { cost += tile_cost(fk) }
                continue
            }
            if troom[t] as s32 != paint_target || tfloor[t] as s32 != fk + 1 { cost += tile_cost(fk) }
        }
    }
    return cost
}

var last_room: s32               // the room the last paint made or extended

fn paint_commit(fk: s32) {
    let cost = paint_eval(fk)
    if cost < 0 {
        fx(FX_ERROR)
        say(paint_why(fk), RED)
        return
    }
    if cost > money {
        fx(FX_ERROR)
        say("Not enough money", RED)
        return
    }
    let f = view_floor
    let kind = FLOORK_KIND[fk] as s32
    last_room = 0
    if kind == KIND_POOL {
        for z in rz0..rz1 + 1 {
            for x in rx0..rx1 + 1 {
                let t = tix(f, x, z)
                tflag[t] = tflag[t] | TF_WATER
            }
        }
    } else {
        var r = paint_target
        if r == 0 {
            r = room_alloc()
            if r == 0 {
                say("Too many rooms", RED)
                return
            }
            rooms[r].used = 1
            rooms[r].kind = kind as u8
            rooms[r].fk = fk as u8
            rooms[r].floor = f as u8
            room_intent[r] = 255
        }
        for z in rz0..rz1 + 1 {
            for x in rx0..rx1 + 1 {
                let t = tix(f, x, z)
                let old = troom[t] as s32
                troom[t] = r as u8
                tfloor[t] = (fk + 1) as u8
                tflag[t] = tflag[t] & ~(TF_WATER | TF_VOID | TF_GLASS)
                if old != 0 && old != r { room_measure(old) }
            }
        }
        room_measure(r)
        last_room = r
    }
    money -= cost
    world_changed()
    last_cost = cost
}

// The paint tool: paint_commit (also used by scripted building) plus the feedback.
var last_cost: s32

fn paint_tool_commit() {
    last_cost = -1
    paint_commit(tool_arg)
    if last_cost < 0 { return }
    if last_room != 0 && tool_rt >= 0 { room_intent[last_room] = tool_rt as u8 }
    fx(FX_BUILD)
    built_juice(last_cost)
    after_paint()
}

fn void_tool_commit(glass: bool) {
    last_cost = -1
    void_commit(glass)
    if last_cost < 0 { return }
    fx(FX_BUILD)
    built_juice(last_cost)
}

// Why a paint is refused (the first bad tile).
fn paint_why(fk: s32) -> *u8 {
    let f = view_floor
    let kind = FLOORK_KIND[fk] as s32
    for z in rz0..rz1 + 1 {
        for x in rx0..rx1 + 1 {
            if paint_tile_ok(f, x, z, fk) { continue }
            if z <= 1 && f == 0 { return "Can't build on the road" }
            if z >= SEA_Z { return "Can't build in the sea" }
            if tobj[tix(f, x, z)] >= 0 { return "Furniture is in the way" }
            if kind == KIND_DECK { return "Decks go outside on the ground floor" }
            if kind == KIND_POOL { return "Pools go on decks or in rooms" }
            if f > 0 { return "Upper floors need a floor below" }
            return "Can't build there"
        }
    }
    return "Can't build there"
}

// Void: open tiles of an upper floor to the floor below.
fn void_eval() -> s32 {
    let f = view_floor
    if f == 0 { return -1 }
    var n = 0
    for z in rz0..rz1 + 1 {
        for x in rx0..rx1 + 1 {
            let t = tix(f, x, z)
            if troom[t] == 0 || !kind_indoor(rooms[troom[t] as s32].kind as s32) { return -1 }
            if tobj[t] >= 0 || tflag[t] & TF_HOLE != 0 { return -1 }
            if tflag[t] & TF_VOID == 0 { n += 1 }
        }
    }
    return n * 50
}

fn void_commit(glass: bool) {
    let cost = void_eval()
    if cost < 0 {
        fx(FX_ERROR)
        say("Voids go inside rooms on upper floors", RED)
        return
    }
    if cost > money {
        fx(FX_ERROR)
        say("Not enough money", RED)
        return
    }
    let f = view_floor
    for z in rz0..rz1 + 1 {
        for x in rx0..rx1 + 1 {
            let t = tix(f, x, z)
            tflag[t] = tflag[t] | TF_VOID
            if glass { tflag[t] = tflag[t] | TF_GLASS } else { tflag[t] = tflag[t] & ~TF_GLASS }
        }
    }
    money -= cost
    world_changed()
    last_cost = cost
}

// Demolish: objects under the cursor first, otherwise the floor tiles of the rectangle.
fn demolish_commit() {
    let f = view_floor
    var refund = 0
    if !dragging || (rx0 == rx1 && rz0 == rz1) {
        let oi = tobj[tix(f, cur_tx, cur_tz)] as s32
        if oi >= 0 {
            refund = OBJ_PRICE[objs[oi].t as s32] as s32 / 2
            let c = obj_centre(oi)
            obj_remove(oi)
            money += refund
            world_changed()
            fx(FX_DEMOLISH)
            puff(c.x, fixed(f) * STOREY, c.z, 1.0)
            popup_money(c.x, fixed(f) * STOREY + 1.0, c.z, refund)
            return
        }
    }
    var any = false
    for z in rz0..rz1 + 1 {
        for x in rx0..rx1 + 1 {
            let t = tix(f, x, z)
            // nothing may stand on this tile from the floor above
            if f + 1 < NFL && tfloor[tix(f + 1, x, z)] != 0 { continue }
            let oi = tobj[t] as s32
            if oi >= 0 {
                refund += OBJ_PRICE[objs[oi].t as s32] as s32 / 2
                obj_remove(oi)
            }
            if tflag[t] & TF_WATER != 0 {
                tflag[t] = tflag[t] & ~TF_WATER
                any = true
                continue
            }
            if tflag[t] & TF_VOID != 0 {
                tflag[t] = tflag[t] & ~(TF_VOID | TF_GLASS)
                any = true
                continue
            }
            let r = troom[t] as s32
            if r != 0 {
                refund += tile_cost(tfloor[t] as s32 - 1) / 2
                troom[t] = 0
                tfloor[t] = 0
                room_measure(r)
                any = true
            }
        }
    }
    if any || refund > 0 {
        money += refund
        world_changed()
        fx(FX_DEMOLISH)
        let cx = (fixed(rx0) + fixed(rx1 + 1)) / 2
        let cz = (fixed(rz0) + fixed(rz1 + 1)) / 2
        puff(cx, fixed(f) * STOREY, cz, fixed(min(rx1 - rx0 + 1, 4)))
        popup_money(cx, fixed(f) * STOREY + 0.6, cz, refund)
    } else {
        fx(FX_ERROR)
        say("Nothing to demolish here", RED)
    }
}

// ---- objects: the footprint is centred on the cursor tile (so turning keeps that tile)

var ob_x: s32                    // origin (min corner) for the current tool, rotation and cursor
var ob_z: s32

fn obj_origin(t: s32, rot: s32) {
    ob_x = cur_tx - (obj_gw(t, rot) - 1) / 2
    ob_z = cur_tz - (obj_gd(t, rot) - 1) / 2
}

// A placement in flight: the object drops into place over a few frames, then it is added.
const DROP_N = 6
var drop_t: s32
var drop_obj: s32
var drop_x: s32
var drop_z: s32
var drop_rot: s32
var drop_f: s32
var ghost_hide: s32              // frames the ghost stays hidden after a placement

fn place_commit() {
    if drop_t > 0 { return }
    let t = tool_arg
    if OBJ_UNLOCK[t] as s32 > stars {
        fx(FX_ERROR)
        say(pe_text(PE_LOCKED), RED)
        return
    }
    obj_origin(t, tool_rot)
    let e = place_check(t, view_floor, ob_x, ob_z, tool_rot)
    if e != PE_OK {
        fx(FX_ERROR)
        say(pe_text(e), RED)
        return
    }
    let price = OBJ_PRICE[t] as s32
    if price > money {
        fx(FX_ERROR)
        say(pe_text(PE_MONEY), RED)
        return
    }
    drop_t = DROP_N
    drop_obj = t
    drop_x = ob_x
    drop_z = ob_z
    drop_rot = tool_rot
    drop_f = view_floor
    ghost_hide = 14
    cu_moved = 0
    sfx_at(Sfx.Click, 0, 120)
}

fn drop_update() {
    if drop_t == 0 { return }
    drop_t -= 1
    if drop_t > 0 { return }
    let t = drop_obj
    let price = OBJ_PRICE[t] as s32
    if place_check(t, drop_f, drop_x, drop_z, drop_rot) != PE_OK || price > money {
        fx(FX_ERROR)
        say("Something got in the way", RED)
        return
    }
    let i = obj_add(t, drop_f, drop_x, drop_z, drop_rot)
    if i < 0 {
        say("Too many objects", RED)
        return
    }
    money -= price
    world_changed()
    let c = obj_centre(i)
    fx_pan(FX_PLACE, proj_screen_x(c))
    puff(c.x, c.y, c.z, fixed(max(obj_gw(t, drop_rot), obj_gd(t, drop_rot))))
    popup_money(c.x, c.y + fixed(OBJ_HT[t] as s32) / 16 + 0.3, c.z, -price)
    land_t = 3
    land_obj = i
}

var land_t: s32                  // a short squash on the frame the object lands
var land_obj: s32 = -1

fn proj_screen_x(c: vec3) -> s32 {
    if project(c) { return proj_x }
    return 160
}

fn edge_commit(feat: s32) {
    pick_edge()
    let f = view_floor
    if !wall_between(f, edge_x, edge_z, edge_dx, edge_dz) {
        fx(FX_ERROR)
        say("Doors and windows go on walls", RED)
        return
    }
    let cur = edge_feat(f, edge_x, edge_z, edge_dx, edge_dz)
    if cur == feat {
        set_edge_feat(f, edge_x, edge_z, edge_dx, edge_dz, EF_NONE)
        world_changed()
        fx(FX_DEMOLISH)
        return
    }
    if feat == EF_WINDOW {
        // windows only look outside
        if indoor(f, edge_x, edge_z) && indoor(f, edge_x + edge_dx, edge_z + edge_dz) {
            fx(FX_ERROR)
            say("Windows go on outside walls", RED)
            return
        }
    }
    let price = OBJ_PRICE[OB_DOOR] as s32
    if price > money {
        fx(FX_ERROR)
        say("Not enough money", RED)
        return
    }
    money -= price
    set_edge_feat(f, edge_x, edge_z, edge_dx, edge_dz, feat)
    world_changed()
    fx(FX_PLACE)
    let ex = fixed(edge_x) + 0.5 + fixed(edge_dx) / 2
    let ez = fixed(edge_z) + 0.5 + fixed(edge_dz) / 2
    puff(ex, fixed(f) * STOREY, ez, 0.6)
    popup_money(ex, fixed(f) * STOREY + 1.0, ez, -price)
}

// Everything that depends on the building is recomputed here.
// (the heavy part runs once, in rooms_update, however many edits a frame made)
fn world_changed() {
    edges_dirty = true
    cache_dirty = true
    rooms_dirty = true
}

var edges_dirty: bool

// ---- input in build mode

var y_chord: bool

fn build_update() {
    let yheld = held_in(Y)
    if yheld {
        // Y + left/right turns the view, Y + up/down zooms
        if btnp_in(LEFT) { rotate_view(1) }
        if btnp_in(RIGHT) { rotate_view(-1) }
        if btnp_in(UP) { zoom_view(1) }
        if btnp_in(DOWN) { zoom_view(-1) }
        if pad_now & (LEFT | RIGHT | UP | DOWN) != 0 { y_chord = true }
    } else if !held_in(SELECT) {
        cursor_update(stick_in)
    }
    if btnp_in(Y) { y_chord = false }
    if btnr_in(Y) && !y_chord {
        // a plain tap: turn the object being placed, pick another wall edge, else turn the view
        if tool == Tool.Object {
            tool_rot = (tool_rot + 1) & 3
            sfx_at(Sfx.Click, 0, 200)
        } else if tool == Tool.Door || tool == Tool.Window {
            edge_cycle()
        } else {
            rotate_view(1)
        }
    }
    if btnp_in(L) { set_floor(view_floor - 1) }
    if btnp_in(R) { set_floor(view_floor + 1) }
    drag_rect()
    if btnp_in(A) {
        match tool {
            Inspect => inspect_press()
            Paint, Void, VoidGlass, Demolish => {
                dragging = true
                drag_x0 = cur_tx
                drag_z0 = cur_tz
                sfx_at(Sfx.Click, 0, 160)
            }
            Object => place_commit()
            Door => edge_commit(EF_DOOR)
            Window => edge_commit(EF_WINDOW)
        }
    }
    drag_rect()
    if dragging && !held_in(A) {
        match tool {
            Paint => paint_tool_commit()
            Void => void_tool_commit(false)
            VoidGlass => void_tool_commit(true)
            Demolish => demolish_commit()
            else => {}
        }
        dragging = false
    }
    if btnp_in(B) {
        if dragging {
            dragging = false
            fx(FX_BACK)
        } else if info_kind != 0 {
            info_close()
            fx(FX_BACK)
        } else if tool != Tool.Inspect {
            tool = Tool.Inspect
            fx(FX_BACK)
        }
    }
    if btnp_in(X) && !dragging { open_build_menu() }
}

// ---- drawing: the cursor, the drag rectangle, the ghost (in the world and the interface list)

// Screen corners of a rectangle of tiles on the viewed floor: false when off screen.
var oc_x: [4]s32
var oc_y: [4]s32

fn rect_corners(x0: fixed, z0: fixed, x1: fixed, z1: fixed) -> bool {
    let y = fixed(view_floor) * STOREY
    if !project(vec3(x0, y, z0)) { return false }
    oc_x[0] = proj_x
    oc_y[0] = proj_y
    project(vec3(x1, y, z0))
    oc_x[1] = proj_x
    oc_y[1] = proj_y
    project(vec3(x1, y, z1))
    oc_x[2] = proj_x
    oc_y[2] = proj_y
    project(vec3(x0, y, z1))
    oc_x[3] = proj_x
    oc_y[3] = proj_y
    return true
}

// The outline of the projected rectangle: a t-px line with a dark 1-px rim on both sides.
fn draw_outline(col: u32, t: s32, ox: s32, oy: s32) {
    for k in 0..4 {
        let j = (k + 1) & 3
        ui_thick(oc_x[k] + ox, oc_y[k] + oy - 1, oc_x[j] + ox, oc_y[j] + oy - 1, t + 2, ST_SHADOW, -1)
    }
    for k in 0..4 {
        let j = (k + 1) & 3
        ui_thick(oc_x[k] + ox, oc_y[k] + oy, oc_x[j] + ox, oc_y[j] + oy, t, col, -1)
    }
}

// Corner ticks: short bright brackets at each corner, a fraction f/8 of each edge long.
fn draw_ticks(col: u32, f: s32, ox: s32, oy: s32) {
    for k in 0..4 {
        let j = (k + 1) & 3
        let i = (k + 3) & 3
        let x = oc_x[k] + ox
        let y = oc_y[k] + oy
        ui_thick(x, y, x + (oc_x[j] - oc_x[k]) * f / 8, y + (oc_y[j] - oc_y[k]) * f / 8, 2, col, -1)
        ui_thick(x, y, x + (oc_x[i] - oc_x[k]) * f / 8, y + (oc_y[i] - oc_y[k]) * f / 8, 2, col, -1)
    }
}

var cu_shake: s32                // frames of the error shake (toasts set it)

// The cursor: a crisp outline with corner ticks and a floating marker above the tile.
fn draw_cursor(col: u32) {
    var ox = 0
    var oy = 0
    if cu_bump > 0 {
        var a = 2
        if cu_bump < 3 { a = 1 }
        ox = cu_bdx * a
        oy = cu_bdy * a
    }
    if cu_shake > 0 {
        cu_shake -= 1
        if (cu_shake / 2) % 2 == 0 { ox += 2 } else { ox -= 2 }
    }
    let x0 = cu_vx - 0.5
    let z0 = cu_vz - 0.5
    if !rect_corners(x0, z0, x0 + 1.0, z0 + 1.0) { return }
    draw_outline(col, 2, ox, oy)
    draw_ticks(ST_CURSOR_HI, 2, ox, oy)
    // the marker: a small chevron bobbing 1 px above the tile
    var cx = 0
    var top = 999
    for k in 0..4 {
        cx += oc_x[k]
        top = min(top, oc_y[k])
    }
    cx = cx / 4 + ox
    let bob = ((tick_count / 20) & 1)
    let s = 3 + view_zoom
    let ty = top + oy - 4 - bob
    ui_tri(cx - s - 1, ty - s - 2, cx + s + 2, ty - s - 2, cx, ty + 2, ST_SHADOW, -1)
    ui_tri(cx - s, ty - s - 2, cx + s, ty - s - 2, cx, ty, col, -1)
}

// A small ground marker at the centre of tile (x, z): a diamond a third of a tile wide.
fn tile_dot(x: s32, z: s32, col: u32, big: bool) {
    let y = fixed(view_floor) * STOREY
    if !project(vec3(fixed(x) + 0.5, y, fixed(z) + 0.5)) { return }
    var r = 1 + view_zoom
    if big { r += 2 }
    let h = max(r * 4 / 7, 1)
    ui_quad(proj_x - r, proj_y, proj_x, proj_y - h, proj_x, proj_y + h, proj_x + r, proj_y, col, -1)
}

// A red cross on an invalid tile.
fn tile_cross(x: s32, z: s32) {
    if !project(vec3(fixed(x) + 0.5, fixed(view_floor) * STOREY, fixed(z) + 0.5)) { return }
    glyph(proj_x - 2, proj_y - 3, 18)
}

fn draw_build_overlay() {
    let y = fixed(view_floor) * STOREY + 0.03
    bm_bias = -30
    look_flat()
    mb_flags = FACE_SEMI
    mb_blend = 3
    match tool {
        Paint, Void, VoidGlass, Demolish => draw_drag(y)
        Object => draw_ghost(y)
        Door, Window => {
            pick_edge()
            var col = ST_CURSOR
            if !wall_between(view_floor, edge_x, edge_z, edge_dx, edge_dz) { col = ST_BAD }
            mb_blend = 0
            let ex = fixed(edge_x)
            let ez = fixed(edge_z)
            let h = 0.9
            if edge_dx == -1 { mb_vquad_z(ex, ez + 0.1, ez + 0.9, y, y + h, col) }
            if edge_dx == 1 { mb_vquad_z(ex + 1.0, ez + 0.1, ez + 0.9, y, y + h, col) }
            if edge_dz == -1 { mb_vquad_x(ex + 0.1, ex + 0.9, ez, y, y + h, col) }
            if edge_dz == 1 { mb_vquad_x(ex + 0.1, ex + 0.9, ez + 1.0, y, y + h, col) }
        }
        Inspect => {}
    }
    mb_flush()
    mb_flags = 0
    mb_blend = 0
    bm_bias = 0
    draw_drop()
    if tool != Tool.Object || ghost_hide > 0 || drop_t > 0 { draw_cursor(ST_CURSOR) }
    draw_flash()
}

// Paint, void and demolish: the rectangle with its validity, cost, and where the walls will go.
fn draw_drag(y: fixed) {
    var ok = true
    var cost = 0
    let paint = tool == Tool.Paint
    if paint { cost = paint_eval(tool_arg) }
    if tool == Tool.Void || tool == Tool.VoidGlass { cost = void_eval() }
    ok = cost >= 0
    var col = ST_OK
    if !ok { col = ST_BAD }
    if tool == Tool.Demolish { col = ST_WARN }
    // a faint fill
    mb_blend = 3
    mb_hquad(fixed(rx0), fixed(rz0), fixed(rx1 + 1), fixed(rz1 + 1), y, shade(col, 150))
    // where the walls will rise (rooms and corridors)
    if paint && ok && dragging && FLOORK_KIND[tool_arg] as s32 <= KIND_SERVICE {
        mb_blend = 0
        let h = 0.42
        let wc = ST_WALL_PREVIEW
        let x0 = fixed(rx0)
        let x1 = fixed(rx1 + 1)
        let z0 = fixed(rz0)
        let z1 = fixed(rz1 + 1)
        mb_vquad_x(x0, x1, z0, y, y + h, wc)
        mb_vquad_x(x0, x1, z1, y, y + h, wc)
        mb_vquad_z(x0, z0, z1, y, y + h, wc)
        mb_vquad_z(x1, z0, z1, y, y + h, wc)
    }
    mb_flush()
    if !dragging { return }
    // per-tile dots, and crosses on the tiles that can't be built
    let nx = rx1 - rx0 + 1
    let nz = rz1 - rz0 + 1
    var crosses = 0
    for z in rz0..rz1 + 1 {
        for x in rx0..rx1 + 1 {
            var bad = false
            if paint && !ok { bad = !paint_tile_ok(view_floor, x, z, tool_arg) }
            if bad && crosses < 48 {
                tile_cross(x, z)
                crosses += 1
            } else if nx * nz <= 150 {
                tile_dot(x, z, shade(col, 200), false)
            }
        }
    }
    if rect_corners(fixed(rx0), fixed(rz0), fixed(rx1 + 1), fixed(rz1 + 1)) {
        draw_outline(col, 2, 0, 0)
        // the size and cost chip, pinned above the rectangle's far corner (the cursor's)
        // the size along the screen's RIGHT axis first, then along DOWN (as the player drags it)
        let b = nb()
        if view_rot & 1 == 0 {
            sint(b, nz)
            sappend(b, "\x18")
            sint(b, nx)
        } else {
            sint(b, nx)
            sappend(b, "\x18")
            sint(b, nz)
        }
        if ok && tool != Tool.Demolish && cost > 0 {
            sappend(b, "  ")
            smoney(b, cost)
        }
        if !ok && paint { sappend(b, "  can't build") }
        var top = 999
        var cx = 0
        for k in 0..4 { top = min(top, oc_y[k]) }
        // the corner nearest the cursor tile
        if !rect_corners(fixed(cur_tx), fixed(cur_tz), fixed(cur_tx + 1), fixed(cur_tz + 1)) { return }
        for k in 0..4 { cx += oc_x[k] }
        cx = cx / 4
        let w = text_w(b, false) + 8
        let bx = clamp(cx - w / 2, 2, 318 - w)
        let by = clamp(top - 18, 17, 210)
        panel(bx, by, w, 13)
        var tc = ST_TEXT
        if !ok { tc = ST_BAD }
        ftext(bx + 4, by + 2, b, tc, false)
    }
}

// ---- the placement ghost: the object's real mesh, tinted, turning smoothly about its centre

var gh_ang: fixed                // shown yaw (eases toward tool_rot * 90 degrees)
var gh_cx: fixed                 // shown centre
var gh_cz: fixed
var gh_obj: s32 = -1
var gh_sx: s32
var gh_rot_seen: s32

fn ghost_reset() {
    gh_obj = -1
}

// Copies mesh m into the batch turned by yaw `ang` about +Y at c; semi-transparent and tinted
// when tint != 0 (textured faces multiply by it; flat faces mix toward it).
fn bake_turned(m: *Mesh, c: vec3, ang: fixed, tint: u32, sy: fixed) {
    let nv = m.nverts as s32
    let nf = m.nfaces as s32
    if nv > 2048 { return }
    mb_flush()
    let base = m as u32
    let vs = (base + m.verts) as *vec4
    let fs = (base + m.faces) as *Face
    let s = sin(ang)
    let co = cos(ang)
    for k in 0..nv {
        let p = vs[k]
        bm.v[k] = vec4(c.x + p.x * co + p.z * s, c.y + p.y * sy, c.z - p.x * s + p.z * co, 1.0)
    }
    for k in 0..nf {
        let dst = &bm.f[k]
        *dst = fs[k]
        if tint != 0 {
            dst.flags = dst.flags | FACE_SEMI
            dst.blend = 0
            if dst.flags & FACE_TEXTURED != 0 {
                for j in 0..4 { dst.col[j] = tint }
            } else {
                for j in 0..4 { dst.col[j] = clerp(dst.col[j], tint, 0.6) }
            }
        }
    }
    bm_nv = nv
    bm_nf = nf
    mb_flush()
}

fn rot_ang(r: s32) -> fixed { return fixed(r & 3) * 1.5708 }

fn draw_ghost(y: fixed) {
    let t = tool_arg
    if gh_obj != t {
        // a new object: no tween
        gh_obj = t
        gh_ang = rot_ang(tool_rot)
    }
    obj_origin(t, tool_rot)
    let gw = obj_gw(t, tool_rot)
    let gd = obj_gd(t, tool_rot)
    let tcx = fixed(ob_x) + fixed(gw) / 2
    let tcz = fixed(ob_z) + fixed(gd) / 2
    // ease the yaw the short way round, and the centre
    var da = rot_ang(tool_rot) - gh_ang
    while da > 3.1416 { da = da - 6.2832 }
    while da < -3.1416 { da = da + 6.2832 }
    gh_ang = gh_ang + da / 2
    if abs(da) < 0.03 { gh_ang = rot_ang(tool_rot) }
    if abs(tcx - gh_cx) > 2.5 || abs(tcz - gh_cz) > 2.5 {
        gh_cx = tcx
        gh_cz = tcz
    } else {
        gh_cx = gh_cx + (tcx - gh_cx) / 2
        gh_cz = gh_cz + (tcz - gh_cz) / 2
    }
    if ghost_hide > 0 {
        // hidden after a placement until the cursor moves on (or the object is turned)
        if ghost_hide > 1 { ghost_hide -= 1 }
        if ghost_hide < 12 && (cu_moved < 2 || gh_rot_seen != tool_rot) { ghost_hide = 0 }
        if ghost_hide > 0 { return }
    }
    gh_rot_seen = tool_rot
    if drop_t > 0 { return }
    let e = place_check(t, view_floor, ob_x, ob_z, tool_rot)
    let locked = OBJ_UNLOCK[t] as s32 > stars
    let good = e == PE_OK && !locked && OBJ_PRICE[t] as s32 <= money
    var col = ST_OK
    if !good { col = ST_BAD }
    // the footprint, faint
    mb_blend = 3
    mb_hquad(fixed(ob_x), fixed(ob_z), fixed(ob_x + gw), fixed(ob_z + gd), y, shade(col, 140))
    // the front: an arrow on the floor just past the front edge
    let fxd = sin(gh_ang)
    let fzd = cos(gh_ang)
    var reach = fixed(gd) / 2
    if tool_rot & 1 != 0 { reach = fixed(gw) / 2 }
    let ax = gh_cx + fxd * (reach + 0.15)
    let az = gh_cz + fzd * (reach + 0.15)
    mb_blend = 0
    mb_need(3, 1)
    let a0 = mb_v(ax + fxd * 0.35, y + 0.01, az + fzd * 0.35)
    let a1 = mb_v(ax - fzd * 0.28, y + 0.01, az + fxd * 0.28)
    let a2 = mb_v(ax + fzd * 0.28, y + 0.01, az - fxd * 0.28)
    mb_face(a0, a1, a2, -1, ST_CURSOR)
    mb_flush()
    // the ghost itself
    var tint: u32 = ST_GHOST_OK
    if !good { tint = ST_GHOST_BAD }
    let m = obj_mesh(t, view_zoom < 2)
    let c = vec3(gh_cx, fixed(view_floor) * STOREY + 0.01, gh_cz)
    bm_bias = -2
    if m != null {
        bake_turned(m, c, gh_ang, tint, 1.0)
    } else {
        mb_flags = FACE_SEMI
        mb_blend = 0
        bake_box(t, c, tool_rot, col)
        mb_flush()
    }
    bm_bias = -30
    mb_flags = FACE_SEMI
    // the footprint outline and the use spots (where people stand to use it)
    gh_sx = 160
    if rect_corners(fixed(ob_x), fixed(ob_z), fixed(ob_x + gw), fixed(ob_z + gd)) {
        draw_outline(col, 1, 0, 0)
        gh_sx = (oc_x[0] + oc_x[1] + oc_x[2] + oc_x[3]) / 4
    }
    let ns = OBJ_NSPOT[t] as s32
    for i in 0..ns {
        local_to_grid(t, ob_x, ob_z, tool_rot, OBJ_SPOT[(t * 5 + i) * 2] as s32, OBJ_SPOT[(t * 5 + i) * 2 + 1] as s32)
        var sc = ST_CURSOR
        if !tile_free(view_floor, lg_x, lg_z) { sc = ST_BAD }
        tile_dot(lg_x, lg_z, sc, true)
    }
    // why it can't go here, under the footprint
    if !good && cu_moved > 8 {
        var why = pe_text(e)
        if locked { why = pe_text(PE_LOCKED) } else if e == PE_OK { why = pe_text(PE_MONEY) }
        var by = 0
        for k in 0..4 { by = max(by, oc_y[k]) }
        let w = text_w(why, false) + 10
        let bx = clamp(gh_sx - w / 2, 2, 318 - w)
        panel_glass(bx, by + 4, w, 12)
        ftext(bx + 5, by + 5, why, ST_BAD, false)
    }
}

// The object in flight: it falls 0.7 units onto its spot, speeding up.
fn draw_drop() {
    if drop_t > 0 && drop_f == view_floor {
        let t = drop_obj
        let m = obj_mesh(t, view_zoom < 2)
        let gw = obj_gw(t, drop_rot)
        let gd = obj_gd(t, drop_rot)
        let k = fixed(drop_t) / DROP_N
        let c = vec3(fixed(drop_x) + fixed(gw) / 2, fixed(drop_f) * STOREY + k * k * 0.7, fixed(drop_z) + fixed(gd) / 2)
        if m != null { bake_turned(m, c, rot_ang(drop_rot), 0, 1.0) }
    }
    if land_t > 0 { land_t -= 1 }
}

// ---- juice: a flash over what was just built

var bfl_t: s32
var bfl_x0: s32
var bfl_z0: s32
var bfl_x1: s32
var bfl_z1: s32

fn built_juice(cost: s32) {
    bfl_t = 12
    bfl_x0 = rx0
    bfl_z0 = rz0
    bfl_x1 = rx1 + 1
    bfl_z1 = rz1 + 1
    let cx = (fixed(rx0) + fixed(rx1 + 1)) / 2
    let cz = (fixed(rz0) + fixed(rz1 + 1)) / 2
    let y = fixed(view_floor) * STOREY
    if cost > 0 { popup_money(cx, y + 0.8, cz, -cost) }
    puff(cx, y, cz, fixed(min(max(rx1 - rx0, rz1 - rz0) + 1, 6)))
}

fn draw_flash() {
    if bfl_t == 0 { return }
    bfl_t -= 1
    if !rect_corners(fixed(bfl_x0), fixed(bfl_z0), fixed(bfl_x1), fixed(bfl_z1)) { return }
    let c = clerp(ST_CURSOR, WHITE, fixed(bfl_t) / 12)
    if bfl_t > 4 { draw_outline(c, 2, 0, -(12 - bfl_t) / 3) } else { draw_outline(shade(c, 120 + bfl_t * 30), 1, 0, -3) }
}

// ---- room types first: what the Rooms tab offers, each with a default floor finish

const NRT_MENU = 16
const RTM: [16]u8 = [RT_LOBBY, RT_GUEST, RT_CORRIDOR, RT_RESTAURANT, RT_KITCHEN, RT_BAR, RT_STAFF, RT_LAUNDRY,
                     RT_STORAGE, RT_SUITE, RT_GYM, RT_SPA, RT_CONFERENCE, RT_OUTDOOR, RT_POOL, RT_SERVICE]
var rt_fk: [17]u8                // the finish chosen per room type (255: not set yet)
var room_intent: [200]u8         // the type a room was built as (255: none)

fn rt_default_fk(rt: s32) -> s32 {
    match rt {
        RT_LOBBY => return FK_MARBLE
        RT_GUEST => return FK_CARPET_BLUE
        RT_SUITE => return FK_CARPET_RED
        RT_CORRIDOR => return FK_CORR_CARPET
        RT_SERVICE => return FK_SERVICE
        RT_OUTDOOR => return FK_DECK
        RT_POOL => return FK_POOL_WATER
        RT_RESTAURANT, RT_BAR => return FK_WOOD
        RT_KITCHEN, RT_LAUNDRY, RT_SPA => return FK_TILE
        RT_CONFERENCE => return FK_CARPET_GREEN
        else => return FK_CONCRETE
    }
}

fn rt_fk_of(rt: s32) -> s32 {
    if rt_fk[rt] == 0 { rt_fk[rt] = (rt_default_fk(rt) + 1) as u8 }
    return rt_fk[rt] as s32 - 1
}

// The next finish of the same kind (UP/DOWN in the drawer).
fn rt_finish_step(rt: s32, d: s32) {
    let fk = rt_fk_of(rt)
    let kind = FLOORK_KIND[fk] as s32
    var k = fk
    for i in 0..NFLOORK {
        k = (k + d + NFLOORK) % NFLOORK
        if FLOORK_KIND[k] as s32 == kind { break }
    }
    rt_fk[rt] = (k + 1) as u8
}

// The type a room is being furnished toward: its own when complete, else what it was built as,
// else the closest match.
fn room_target(r: s32) -> s32 {
    let rm = &rooms[r]
    if rm.rtype as s32 != RT_NONE && rm.rtype as s32 != RT_OUTDOOR { return rm.rtype as s32 }
    if room_intent[r] != 255 && room_intent[r] != 0 { return room_intent[r] as s32 }
    if rm.rtype as s32 == RT_OUTDOOR { return RT_POOL }
    return rm.best as s32
}

// The finish name without its "Room: " prefix.
fn finish_name(fk: s32) -> *u8 {
    let s = str_of(FLOORK_NAME_OFF[fk] as s32)
    var k = 0
    while s[k] != 0 && s[k] != ':' { k += 1 }
    if s[k] == ':' { return s + k + 2 }
    return s
}

// After a room was painted: show what it needs (the drawer opens on its checklist).
fn after_paint() {
    if last_room == 0 { return }
    let rt = room_target(last_room)
    if rt == RT_NONE || RT_NREQ[rt] == 0 { return }
    let b = nb()
    sappend(b, room_type_name(rt))
    sappend(b, " needs: ")
    let n = RT_NREQ[rt] as s32
    for k in 0..n {
        if k > 0 { sappend(b, ", ") }
        sappend(b, obj_name(RT_REQ_ALT[(rt * 7 + k) * 3] as s32))
    }
    hint_show(b)
    open_build_menu()
}

// ---- the build drawer (X): a tab strip, one row of items, one detail line

enum MenuKind { Floor, Obj, Special, RoomType }

struct MenuItem { kind: u8, arg: u8 }

const SP_DOOR = 0
const SP_WINDOW = 1
const SP_VOID = 2
const SP_VOIDGLASS = 3
const SP_DEMOLISH = 4

// drawer tabs: 0 "Needs" (the room under the cursor), then the catalogue's tabs (TAB_* + 1)
const DT_NEEDS = 0
const NDT = 10

var menu_open: bool
var menu_tab: s32 = 1
var menu_sel: s32
var menu_items: [48]MenuItem
var menu_n: s32
var menu_scroll: s32
var menu_room: s32               // the room the Needs tab is about
var menu_anim: s32               // 0..6: the drawer sliding in
var menu_out: s32                // 6..0: the drawer sliding away after closing

const MENU_VIS = 7
const DRAWER_Y = 152

fn dt_name(t: s32) -> *u8 {
    if t == DT_NEEDS { return "Needs" }
    return str_of(TAB_NAME_OFF[t - 1] as s32)
}

fn dt_icon(t: s32) -> Icon {
    match t {
        0 => return IC_CHECK
        1 => return IC_LAYERS
        2 => return IC_HAMMER
        3 => return IC_BED
        4 => return IC_SOAP
        5 => return IC_BELL
        6 => return IC_FOOD
        7 => return IC_BROOM
        8 => return IC_FUN
        else => return IC_HEART
    }
}

fn menu_fill() {
    menu_n = 0
    if menu_tab == DT_NEEDS {
        let r = menu_room
        if r == 0 { return }
        let rt = room_target(r)
        // the requirements first (every alternative), then the bonus items
        let n = RT_NREQ[rt] as s32
        for k in 0..n {
            for a in 0..3 {
                let t = RT_REQ_ALT[(rt * 7 + k) * 3 + a] as s32
                if t != 255 { menu_add(1, t) }
            }
        }
        let nb2 = RT_NBONUS[rt] as s32
        for k in 0..nb2 {
            let t = RT_BONUS[rt * 12 + k] as s32
            if t != 255 && !menu_has(1, t) { menu_add(1, t) }
        }
        return
    }
    let tab = menu_tab - 1
    if tab == TAB_ROOMS {
        for k in 0..NRT_MENU { menu_add(3, RTM[k] as s32) }
        return
    }
    if tab == TAB_BUILD {
        menu_add(2, SP_DOOR)
        menu_add(2, SP_WINDOW)
        menu_add(1, OB_STAIRS)
        menu_add(1, OB_ELEVATOR)
        menu_add(1, OB_GLASS_ELEVATOR)
        menu_add(1, OB_GRAND_STAIRCASE)
        menu_add(2, SP_VOID)
        menu_add(2, SP_VOIDGLASS)
        menu_add(2, SP_DEMOLISH)
        return
    }
    for t in 0..NOBJT {
        let fl = OBJ_FLAGS[t] as s32
        if fl & (F_WALLPIECE | F_TRANSPORT) != 0 { continue }
        if OBJ_TAB[t] as s32 == tab { menu_add(1, t) }
    }
}

fn menu_has(kind: s32, arg: s32) -> bool {
    for i in 0..menu_n { if menu_items[i].kind as s32 == kind && menu_items[i].arg as s32 == arg { return true } }
    return false
}

fn menu_add(kind: s32, arg: s32) {
    if menu_n >= 48 { return }
    menu_items[menu_n].kind = kind as u8
    menu_items[menu_n].arg = arg as u8
    menu_n += 1
}

fn needs_room() -> s32 {
    let r = room_at(view_floor, cur_tx, cur_tz)
    if r == 0 { return 0 }
    let rt = room_target(r)
    if rt == RT_NONE || RT_NREQ[rt] as s32 + RT_NBONUS[rt] as s32 == 0 { return 0 }
    return r
}

fn open_build_menu() {
    menu_open = true
    menu_out = 0
    menu_anim = 0
    dragging = false
    menu_room = needs_room()
    // the room under the cursor still needs things: its checklist; outside any room: rooms
    if menu_room != 0 && !room_done(menu_room) {
        menu_tab = DT_NEEDS
    } else if menu_room == 0 && room_at(view_floor, cur_tx, cur_tz) == 0 {
        menu_tab = 1 + TAB_ROOMS
    } else if menu_tab == DT_NEEDS && menu_room == 0 {
        menu_tab = 1 + TAB_ROOMS
    }
    menu_fill()
    menu_sel = clamp(menu_sel, 0, max(menu_n - 1, 0))
    if menu_tab == DT_NEEDS { menu_sel = first_missing() }
    menu_keep_visible()
    fx(FX_OK)
    if menu_tab == 1 + TAB_ROOMS { hint_once(HINT_ROOMS, "Pick a room type, then drag it out on the lot") }
}

fn room_done(r: s32) -> bool { return rooms[r].flags & RF_VALID != 0 && rooms[r].rtype as s32 != RT_OUTDOOR }

// The first item of the Needs tab the room still lacks.
fn first_missing() -> s32 {
    for i in 0..menu_n {
        if item_needed(menu_items[i]) == 1 { return i }
    }
    return 0
}

// For the Needs tab: 1 still required, 2 required and present, 0 a bonus item.
fn item_needed(it: MenuItem) -> s32 {
    if menu_room == 0 || it.kind != 1 { return 0 }
    let rt = room_target(menu_room)
    let n = RT_NREQ[rt] as s32
    let t = it.arg as s32
    for k in 0..n {
        for a in 0..3 {
            if RT_REQ_ALT[(rt * 7 + k) * 3 + a] as s32 == t {
                if req_ok(menu_room, rt, k) { return 2 }
                return 1
            }
        }
    }
    return 0
}

fn menu_keep_visible() {
    if menu_sel < menu_scroll { menu_scroll = menu_sel }
    if menu_sel >= menu_scroll + MENU_VIS { menu_scroll = menu_sel - MENU_VIS + 1 }
    menu_scroll = clamp(menu_scroll, 0, max(menu_n - MENU_VIS, 0))
}

fn menu_tab_step(d: s32) {
    var t = menu_tab
    for i in 0..NDT {
        t = (t + d + NDT) % NDT
        if t != DT_NEEDS || menu_room != 0 { break }
    }
    menu_tab = t
    menu_fill()
    menu_sel = 0
    menu_scroll = 0
    if menu_tab == DT_NEEDS { menu_sel = first_missing() }
    menu_keep_visible()
    fx(FX_TAB)
}

fn menu_update() {
    if menu_anim < 6 { menu_anim += 1 }
    if btnp_in(L) { menu_tab_step(-1) }
    if btnp_in(R) { menu_tab_step(1) }
    var d = 0
    if rep_in(LEFT) { d = -1 }
    if rep_in(RIGHT) { d = 1 }
    if d != 0 {
        let n = clamp(menu_sel + d, 0, max(menu_n - 1, 0))
        if n != menu_sel { menu_sel = n; fx(FX_CLICK) } else { sfx_at(Sfx.Click, 0, 80) }
        menu_keep_visible()
    }
    // up/down: the floor finish of a room type
    if menu_n > 0 && menu_items[menu_sel].kind == 3 {
        var e = 0
        if rep_in(UP) { e = -1 }
        if rep_in(DOWN) { e = 1 }
        if e != 0 {
            rt_finish_step(menu_items[menu_sel].arg as s32, e)
            fx(FX_CLICK)
        }
    }
    if btnp_in(B) || btnp_in(X) {
        menu_open = false
        menu_out = 5
        fx(FX_BACK)
        return
    }
    if btnp_in(A) && menu_n > 0 {
        let it = menu_items[menu_sel]
        let arg = it.arg as s32
        if item_locked(it) {
            fx(FX_ERROR)
            say(pe_text(PE_LOCKED), RED)
            return
        }
        tool_rt = -1
        match it.kind as s32 {
            0 => { tool = Tool.Paint; tool_arg = arg }
            1 => { tool = Tool.Object; tool_arg = arg; ghost_reset() }
            3 => { tool = Tool.Paint; tool_rt = arg; tool_arg = rt_fk_of(arg) }
            else => {
                match arg {
                    0 => tool = Tool.Door
                    1 => tool = Tool.Window
                    2 => tool = Tool.Void
                    3 => tool = Tool.VoidGlass
                    else => tool = Tool.Demolish
                }
            }
        }
        menu_open = false
        menu_out = 5
        info_close()
        fx(FX_OK)
        if tool == Tool.Paint && tool_rt >= 0 && RT_MIN[tool_rt] > 0 {
            let b = nb()
            sappend(b, "Drag to paint a room: a ")
            sappend(b, room_type_name(tool_rt))
            sappend(b, " needs ")
            sint(b, RT_MIN[tool_rt] as s32)
            sappend(b, " tiles or more")
            hint_show(b)
        }
        if tool == Tool.Object { hint_once(HINT_OBJECT, "Its front faces the arrow: guests use it from there") }
        if tool == Tool.Door { hint_once(HINT_DOOR, "Doors go on walls: \x04 picks another wall of the tile") }
    }
}

fn item_locked(it: MenuItem) -> bool {
    if it.kind == 1 { return OBJ_UNLOCK[it.arg as s32] as s32 > stars }
    if it.kind == 3 { return RT_UNLOCK[it.arg as s32] as s32 > stars }
    return false
}

fn item_name(it: MenuItem) -> *u8 {
    let arg = it.arg as s32
    match it.kind as s32 {
        0 => return str_of(FLOORK_NAME_OFF[arg] as s32)
        1 => return obj_name(arg)
        3 => {
            if arg == RT_POOL { return "Pool water" }
            return room_type_name(arg)
        }
        else => {
            match arg {
                0 => return "Door"
                1 => return "Window"
                2 => return "Void (railing)"
                3 => return "Void (glass)"
                else => return "Demolish"
            }
        }
    }
}

fn item_price(it: MenuItem) -> s32 {
    let arg = it.arg as s32
    match it.kind as s32 {
        0 => return FLOORK_PRICE[arg] as s32
        1 => return OBJ_PRICE[arg] as s32
        3 => return FLOORK_PRICE[rt_fk_of(arg)] as s32
        else => {
            if arg <= 1 { return OBJ_PRICE[OB_DOOR] as s32 }
            if arg <= 3 { return 50 }
            return 0
        }
    }
}

// A 24x24 picture of a menu item: the art's icon, a patch of the floor, or a coloured swatch.
fn menu_icon(x: s32, y: s32, it: MenuItem, tint: u32) {
    let arg = it.arg as s32
    var ob = -1
    if it.kind == 1 { ob = arg }
    if it.kind == 3 {
        // a room type: a patch of its floor with its key object over it
        let fk = rt_fk_of(arg)
        floor_icon(x, y, fk, tint)
        if RT_NREQ[arg] > 0 {
            let t = RT_REQ_ALT[arg * 21] as s32
            if ART_PRESENT && OBJ_ART[t] >= 0 {
                let a = OBJ_ART[t] as s32
                ui_tex(x + 4, y + 4, 18, 18, ART_ICON_SLOT, ART_ICON_PAL[a] as s32, ART_ICON_U[a] as s32, ART_ICON_V[a] as s32, 24, 24, tint, -1)
            }
        }
        return
    }
    if it.kind == 2 {
        if arg == SP_DOOR { ob = OB_DOOR }
        if arg == SP_WINDOW { ob = OB_WINDOW }
        if arg == SP_VOID { ob = OB_RAILING }
        if arg == SP_VOIDGLASS { ob = OB_RAILING_GLASS }
        if arg == SP_DEMOLISH {
            icon_tint(x + 4, y + 4, IC_TRASH, tint)
            return
        }
    }
    if ART_PRESENT && ob >= 0 && OBJ_ART[ob] >= 0 {
        let a = OBJ_ART[ob] as s32
        ui_tex(x, y, 24, 24, ART_ICON_SLOT, ART_ICON_PAL[a] as s32, ART_ICON_U[a] as s32, ART_ICON_V[a] as s32, 24, 24, tint, -1)
        return
    }
    if it.kind == 0 {
        floor_icon(x, y, arg, tint)
        return
    }
    var sc = rgb(200, 200, 200)
    if it.kind == 1 { sc = OBJ_COL[arg] }
    ui_rect(x + 5, y + 5, 14, 14, sc, -1)
}

fn floor_icon(x: s32, y: s32, fk: s32, tint: u32) {
    if ART_PRESENT && SURF_BLOCK[fk] == 1 {
        ui_tex(x + 1, y + 1, 22, 22, SURF_SLOT, SURF_PAL[fk] as s32, SURF_U[fk] as s32, SURF_V[fk] as s32, 24, 24, tint, -1)
        return
    }
    ui_rect(x + 1, y + 1, 22, 22, FLOORK_COL[fk], -1)
}

fn draw_build_menu() {
    let x = 4
    let w = 312
    let h = 86
    var y = DRAWER_Y + (6 - menu_anim) * (6 - menu_anim) * 2
    if !menu_open {
        if menu_out <= 0 { return }
        menu_out -= 1
        y = DRAWER_Y + (5 - menu_out) * (5 - menu_out) * 4
    }
    panel(x, y, w, 88)
    // tabs: icons, the current one with its name
    var tx = x + 18
    ftext(x + 5, y + 5, "\x05", WHITE, false)
    for t in 0..NDT {
        if t == DT_NEEDS && menu_room == 0 { continue }
        if t == menu_tab {
            let nm = dt_name(t)
            let tw = text_w(nm, false)
            ui_sel(tx - 2, y + 3, tw + 24, 18)
            icon(tx, y + 4, dt_icon(t))
            ftext(tx + 18, y + 7, nm, ST_TEXT, false)
            tx += tw + 26
        } else {
            icon_tint(tx, y + 4, dt_icon(t), 0x585858)
            tx += 19
        }
    }
    ftext(tx + 2, y + 5, "\x06", WHITE, false)
    // one row of items
    let iy = y + 24
    let sw = 38
    let ix0 = 160 - MENU_VIS * sw / 2
    if menu_scroll > 0 { ftext(ix0 - 10, iy + 12, "\x15", WHITE, false) }
    if menu_scroll + MENU_VIS < menu_n { ftext(ix0 + MENU_VIS * sw + 4, iy + 12, "\x16", WHITE, false) }
    if menu_n == 0 { ftext_c(160, iy + 12, "Nothing here yet", ST_TEXT_DIM, false) }
    for k in 0..MENU_VIS {
        let i = menu_scroll + k
        if i >= menu_n { break }
        let it = menu_items[i]
        let cx = ix0 + k * sw + 2
        let locked = item_locked(it)
        if i == menu_sel { ui_sel(cx, iy, 34, 32) } else { ui_rect(cx, iy, 34, 32, ST_SLOT, -1) }
        var tint: u32 = 0x808080
        if locked { tint = 0x404040 }
        menu_icon(cx + 5, iy + 4, it, tint)
        // needs: a check or a dot in the corner
        let need = item_needed(it)
        if need == 2 { glyph(cx + 26, iy + 2, 17) }
        if need == 1 { ui_rect(cx + 28, iy + 3, 3, 3, ST_BAD, -1) }
        if locked {
            // a small padlock and the stars it needs, in the icon's corner (never over text)
            let b = nb()
            sappend(b, "\x10")
            if it.kind == 1 { sint(b, OBJ_UNLOCK[it.arg as s32] as s32) } else { sint(b, RT_UNLOCK[it.arg as s32] as s32) }
            sappend(b, "\x0F")
            let bw = text_w(b, false)
            ui_rect(cx + 33 - bw - 3, iy + 21, bw + 3, 10, ST_PANEL, -1)
            ftext(cx + 33 - bw - 1, iy + 22, b, ST_GOLD, false)
        }
    }
    // the selection: name, price, size, what it is for
    let dy = y + 60
    if menu_n > 0 {
        let it = menu_items[menu_sel]
        let nx = ftext(x + 8, dy, item_name(it), ST_TEXT, false)
        let p = item_price(it)
        let b = nb()
        if p > 0 { smoney(b, p) }
        if (it.kind == 0 || it.kind == 3) && p > 0 { sappend(b, " a tile") }
        if it.kind == 1 {
            let t = it.arg as s32
            sappend(b, "  ")
            sint(b, OBJ_W[t] as s32)
            sappend(b, "\x18")
            sint(b, OBJ_D[t] as s32)
        }
        ftext(nx + 8, dy, b, ST_GOLD, false)
        var d = nb()
        if it.kind == 3 {
            let fk = rt_fk_of(it.arg as s32)
            sappend(d, "Floor: ")
            sappend(d, finish_name(fk))
            sappend(d, "   \x0C finish")
        } else if it.kind == 1 {
            item_purpose(d, it.arg as s32)
        } else if it.kind == 2 {
            if it.arg as s32 == SP_DEMOLISH { sappend(d, "Get half the price back") }
            else if it.arg as s32 <= SP_WINDOW { sappend(d, "On a wall between two tiles") }
            else { sappend(d, "Opens an upper floor to the one below") }
        }
        if item_locked(it) { d = nb(); sappend(d, "Unlocks at a higher star rating") }
        ftext(x + 8, dy + 11, d, ST_TEXT_DIM, false)
    }
    ftext_r(x + w - 6, dy + 11, "\x01 choose  \x02 close", ST_TEXT_DIM, false)
}

// "Needed for: Lobby" / "Makes a Guest room nicer"
fn item_purpose(d: *u8, t: s32) {
    if menu_tab == DT_NEEDS {
        let n = item_needed(menu_items[menu_sel])
        if n == 1 { sappend(d, "Still needed here"); return }
        if n == 2 { sappend(d, "\x11 Done for this room"); return }
        sappend(d, "Makes this room nicer")
        return
    }
    for rt in 0..NROOMT {
        let n = RT_NREQ[rt] as s32
        for k in 0..n {
            for a in 0..3 {
                if RT_REQ_ALT[(rt * 7 + k) * 3 + a] as s32 == t {
                    sappend(d, "Needed for: ")
                    sappend(d, room_type_name(rt))
                    return
                }
            }
        }
    }
    sappend(d, "Makes rooms nicer")
}
