// People: guests, staff and visitors share one pool and one way of moving about.
//
// A person walks from tile centre to tile centre down a flow field toward its goal tile. A step
// onto a link is a climb up or down stairs or a ride in an elevator (transport.akr). When the
// goal is reached, `arrived` is set and the owner's state machine (guests.akr, staff.akr) takes
// it from there. People are drawn by people_draw.akr (billboards sorted into the ordering table).

const MAXP = 128

const P_GUEST = 1
const P_STAFF = 2
const P_VISITOR = 3          // the delivery driver

const M_WALK = 0
const M_STAND = 1            // standing still (using something, waiting)
const M_WAIT_ELEV = 2
const M_RIDE = 3
const M_STAIRS = 4
const M_HIDDEN = 5           // off site (staff off shift)

const POSE_STAND = 0
const POSE_WALK = 1
const POSE_SIT = 2
const POSE_LIE = 3
const POSE_SWIM = 4
const POSE_USE = 5

struct Person {
    used: u8
    kind: u8
    type: u8                 // guest type or staff role
    look: u8                 // appearance variant
    state: u8                // owner's state
    mode: u8                 // M_*
    f: u8                    // floor
    dir: u8                  // facing: 0 +x, 1 +z, 2 -x, 3 -z
    pose: u8
    arrived: u8              // reached the goal this frame
    carry: u8                // item carried (IT_*)
    shift: u8
    x: fixed
    z: fixed
    y: fixed                 // height above the floor (stairs)
    tile: s16                // global tile index
    goal: s16                // goal tile (-1: none)
    nxt: s16                 // tile being walked to (-1: at a centre)
    fslot: s16               // field slot
    timer: s16
    wait: s16                // frames spent waiting for a path/service
    obj: s16                 // object in use / station
    room: s16                // guest: their room; staff: -
    job: s16
    elev: s16
    link: s16
    sfrom: s16               // stairs: tiles
    sto: s16
    ride_to: u8
    nights: u8
    act: u8                  // activity in progress (USE_*)
    stars: u8                // a guest's review, when leaving
    pad2: u16
    needs: [4]u8             // sleep, hunger, hygiene, fun (255 = fine)
    energy: s16              // staff stamina
    mood: s16
    budget: s16
    spent: s16
    complaints: u32          // CP_* bits
    praise: u32              // PR_* bits
    speed: fixed
    party: s16               // family members follow the leader
}

var people: [128]Person
var npeople: s32

const N_SLEEP = 0
const N_HUNGER = 1
const N_HYGIENE = 2
const N_FUN = 3

fn person_new(kind: s32, type: s32, f: s32, x: s32, z: s32) -> s32 {
    var i = -1
    for k in 0..MAXP {
        if people[k].used == 0 { i = k; break }
    }
    if i < 0 { return -1 }
    if i >= npeople { npeople = i + 1 }
    let p = &people[i]
    memset(p as *u8, 0, sizeof(Person))
    p.used = 1
    p.kind = kind as u8
    p.type = type as u8
    p.look = rnd(4) as u8
    p.f = f as u8
    p.x = fixed(x) + 0.5
    p.z = fixed(z) + 0.5
    p.tile = tix(f, x, z) as s16
    p.goal = -1
    p.nxt = -1
    p.fslot = -1
    p.obj = -1
    p.room = -1
    p.job = -1
    p.elev = -1
    p.party = -1
    p.speed = 0.045
    p.energy = 1000
    for k in 0..4 { p.needs[k] = (180 + rnd(70)) as u8 }
    return i
}

fn person_free(i: s32) {
    let p = &people[i]
    if p.elev >= 0 { elev_forget(i) }
    p.used = 0
    while npeople > 0 && people[npeople - 1].used == 0 { npeople -= 1 }
}

fn ptile_x(t: s32) -> s32 { return (t % NT) % GW }
fn ptile_z(t: s32) -> s32 { return (t % NT) / GW }
fn ptile_f(t: s32) -> s32 { return t / NT }

// Sends a person toward a tile.
fn go_to(i: s32, goal: s32) {
    let p = &people[i]
    p.goal = goal as s16
    p.fslot = -1
    p.arrived = 0
    p.wait = 0
    p.mode = M_WALK as u8
    if p.nxt < 0 && p.tile as s32 == goal { p.arrived = 1 }
}

fn stop_walk(i: s32) {
    let p = &people[i]
    p.goal = -1
    p.mode = M_STAND as u8
}

// Puts a person on a tile centre (spawn, teleport after a ride).
fn place_at(i: s32, t: s32) {
    let p = &people[i]
    p.tile = t as s16
    p.f = ptile_f(t) as u8
    p.x = fixed(ptile_x(t)) + 0.5
    p.z = fixed(ptile_z(t)) + 0.5
    p.y = 0.0
    p.nxt = -1
}

// One frame of movement. Sets p.arrived when the goal is reached; p.wait counts frames stuck.
fn person_move(i: s32) {
    let p = &people[i]
    match p.mode as s32 {
        2 => { p.wait += 1; return }
        3 => return
        4 => { stairs_step(i); return }
        5 => return
        else => {}
    }
    if p.goal < 0 { return }
    if p.nxt < 0 {
        // at a tile centre: arrived, or pick the next tile
        if p.tile == p.goal {
            p.arrived = 1
            p.goal = -1
            p.pose = POSE_STAND as u8
            return
        }
        let staff = p.kind as s32 != P_GUEST
        // another floor: first to the stairs or elevator that leads there
        var target = p.goal as s32
        let gf = target / NT
        if gf != p.f as s32 {
            let lk = link_toward(p.f as s32, gf, p.x as s32, p.z as s32)
            if lk < 0 {
                p.wait += 1
                p.pose = POSE_STAND as u8
                return
            }
            target = links[lk].a as s32
            if p.tile as s32 == target {
                start_link(i, lk)
                return
            }
        }
        let fs = field_for(target, staff)
        if fs < 0 {
            p.wait += 1
            p.pose = POSE_STAND as u8
            return
        }
        p.fslot = fs as s16
        let n = path_next(fs, p.tile as s32)
        if n < 0 {
            p.wait += 1
            p.pose = POSE_STAND as u8
            return
        }
        p.nxt = n as s16
        p.wait = 0
        let d = n - p.tile as s32
        if d == 1 { p.dir = 0 }
        if d == GW { p.dir = 1 }
        if d == -1 { p.dir = 2 }
        if d == -GW { p.dir = 3 }
    }
    // walk toward the centre of nxt
    p.pose = POSE_WALK as u8
    let n = p.nxt as s32
    let tx = fixed(ptile_x(n)) + 0.5
    let tz = fixed(ptile_z(n)) + 0.5
    let sp = p.speed
    let dx = tx - p.x
    let dz = tz - p.z
    if abs(dx) <= sp && abs(dz) <= sp {
        p.x = tx
        p.z = tz
        p.tile = n as s16
        p.nxt = -1
    } else {
        p.x += clamp(dx, -sp, sp)
        p.z += clamp(dz, -sp, sp)
    }
}

// ---- links: stairs and elevators

fn start_link(i: s32, k: s32) {
    let p = &people[i]
    let l = &links[k]
    if l.kind as s32 == LK_STAIRS {
        p.mode = M_STAIRS as u8
        p.sfrom = l.a as s16
        p.sto = l.b as s16
        p.timer = 0
        p.pose = POSE_WALK as u8
        return
    }
    // an elevator: wait at its door for the car
    let e = elev_of_obj(l.obj as s32)
    if e < 0 { return }
    p.mode = M_WAIT_ELEV as u8
    p.elev = e as s16
    p.ride_to = ptile_f(l.b as s32) as u8
    p.link = k as s16
    p.pose = POSE_STAND as u8
    elev_call(e, p.f as s32)
}

const STAIR_T = 150

fn stairs_step(i: s32) {
    let p = &people[i]
    p.timer += 1
    let a = p.sfrom as s32
    let b = p.sto as s32
    let t = fixed(p.timer as s32) / STAIR_T
    let ax = fixed(ptile_x(a)) + 0.5
    let az = fixed(ptile_z(a)) + 0.5
    let bx = fixed(ptile_x(b)) + 0.5
    let bz = fixed(ptile_z(b)) + 0.5
    let fa = ptile_f(a)
    let fb = ptile_f(b)
    p.x = ax + (bx - ax) * t
    p.z = az + (bz - az) * t
    // y relative to the lower floor
    let lowf = min(fa, fb)
    p.f = lowf as u8
    if fb > fa { p.y = STOREY * t } else { p.y = STOREY * (1.0 - t) }
    let ddx = bx - ax
    let ddz = bz - az
    if abs(ddx) > abs(ddz) {
        if ddx > 0.0 { p.dir = 0 } else { p.dir = 2 }
    } else {
        if ddz > 0.0 { p.dir = 1 } else { p.dir = 3 }
    }
    if p.timer as s32 >= STAIR_T {
        place_at(i, b)
        p.mode = M_WALK as u8
    }
}

// One simulation tick for everyone.
fn people_tick() {
    for i in 0..npeople {
        let p = &people[i]
        if p.used == 0 { continue }
        person_move(i)
        let k = p.kind as s32
        if k == P_GUEST {
            guest_tick(i)
            if p.used != 0 && (tod + i) % MIN_FRAMES == 0 { guest_minute(i) }
        } else if k == P_STAFF {
            staff_tick(i)
        } else {
            visitor_tick(i)
        }
    }
}
