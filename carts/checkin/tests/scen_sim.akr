// Workstream C (simulation, people) test scenarios: existing 10-15, 20, 22-24, 30, 90-95; new
// ones 400-499. See harness.akr for the fixtures.

fn scen_sim_init() {
    match SCENARIO {
        10 => scen_hotel(0)       // the demo hotel, staffed, from 13:00
        11 => scen_hotel(1)       // with a first floor and an elevator
        12 => { scen_hotel(1); view_floor = 1; view_recentre() }
        13 => { scen_hotel(1); s_obj(OB_FLOOR_LAMP, 0, 11, 3, 0); s_obj(OB_FLOOR_LAMP, 0, 19, 8, 0); tod = 21 * 60 * MIN_FRAMES }
        14 => { scen_hotel(1); tod = 19 * 60 * MIN_FRAMES }
        15 => { scen_hotel(1); view_floor = 1; view_zoom = 2; cur_x = 14.0; cur_z = 15.0; view_recentre() }
        20 => scen_grand(0, 0, 13)           // the grand hotel, ground floor, afternoon
        22 => scen_grand(0, 60, 15)          // busy: 60 guests checked in
        23 => scen_grand(0, 60, 22)          // busy at night (the bar)
        24 => scen_grand(5, 60, 15)          // the top floor
        30 => { scen_hotel(1); speed = 4 }   // two days at x4: reviews and money
        90 => { new_hotel_state(); start_play(); scen_hotel(1); day = 7; money = 123456; view_floor = 1; view_recentre() }
        91 => {}                  // the title: Continue loads the save
        95 => {}                  // the title: New hotel (no card)
        92 => { new_hotel_state(); start_play(); money = 9999999; scen_grand(0, 0, 13) }   // the grand hotel's save size
        // ---- polish workstream C (POLISH.md section 6); parameters P1..P6 from tests/run.sh P="..."
        // 403: people log (PP lines) on floor P1 of the busy grand hotel at P2 h (+P6 min), zoom 2,
        //      cursor (P3, P4) (default the lobby fountain); P5 = 1 pauses at frame 300
        403 => {
            new_hotel_state(); start_play(); money = 9999999
            scen_grand(P1, 60, max(P2, 1))
            tod += P6 * MIN_FRAMES
            view_zoom = 2
            cur_x = 14.5
            cur_z = 7.0
            if P3 > 0 { cur_x = fixed(P3); cur_z = fixed(P4) }
            view_recentre()
        }
        // 404: the same people log in the demo hotel (as a new player gets it) at P2 h + P6 min,
        //      cursor (P3, P4) (default the reception desk), zoom 2, view rotation P5 - 1 (0: default)
        404 => {
            new_hotel_state(); start_play(); demo_game()
            tod = max(P2, 1) * 60 * MIN_FRAMES + P6 * MIN_FRAMES
            view_zoom = 2
            if P5 > 0 { view_rot = P5 - 1 }
            cur_x = 16.0
            cur_z = 5.5
            if P3 > 0 { cur_x = fixed(P3); cur_z = fixed(P4) }
            view_recentre()
        }
        // 410: still shots: grand hotel floor P1, P2 guests, P3 h, zoom P4, rotation P5, cursor x P6
        410 => {
            new_hotel_state(); start_play(); money = 9999999
            scen_grand(P1, P2, P3)
            view_zoom = P4
            view_rot = P5
            if P6 > 0 { cur_x = fixed(P6); cur_z = 8.0 }
            view_recentre()
        }
        // 421: the grand hotel with P1 guests from P2 h at speed P3: state histograms (HIST lines)
        421 => { new_hotel_state(); start_play(); money = 9999999; scen_grand(0, P1, P2); speed = max(P3, 1) }
        // 422: the demo hotel (as a new player gets it) at speed P3 for days: HIST lines + day reports
        422 => { new_hotel_state(); start_play(); demo_game(); speed = max(P3, 1) }
        // 423: a plant placed in the busy lobby at frame 150 (P1 = 1: no edit): MOV lines per frame
        423 => { new_hotel_state(); start_play(); money = 9999999; scen_grand(0, 60, 15) }
        // 424: per-frame PERF on floor P1 at P2 h, speed P3
        424 => { new_hotel_state(); start_play(); money = 9999999; scen_grand(P1, 60, P2); speed = max(P3, 1) }
        // 427: a well-run mid-size hotel built from the demo (P3 speed): day reports
        427 => { new_hotel_state(); start_play(); demo_game(); s_upgrade_demo(); speed = max(P3, 1) }
        // 405: every use spot and staff spot of the grand (P1 = 0) or demo (1) hotel can be reached
        405 => {
            new_hotel_state(); start_play(); money = 9999999
            if P1 == 1 { scen_hotel(1) } else if P1 == 2 { scen_hotel(1); s_upgrade_demo() } else { scen_grand(0, 0, 13) }
        }
        // 430: what guests are doing (IDLE lines per game hour): the grand hotel (P1 = 0, P2 guests,
        //      default 60) or the demo game (P1 = 1) from P4 h (default 6) at speed P3 (default 4);
        //      P5 > 0: zoom 2 on floor P5 - 1 with the cursor at x P6 % 100, z 12.5 (z 7 if P6 >= 100)
        430 => {
            new_hotel_state(); start_play(); money = 9999999
            var g = P2
            if g == 0 { g = 60 }
            if P1 == 1 { demo_game() } else { scen_grand(0, g, 6) }
            if P4 > 0 { tod = P4 * 60 * MIN_FRAMES }
            speed = P3
            if speed == 0 { speed = 4 }
            // P5 > 0: a close look (zoom 2) at floor P5 - 1, cursor x P6 over the south rooms
            if P5 > 0 { view_zoom = 2; view_floor = P5 - 1; cur_x = fixed(P6 % 100); cur_z = 12.5; if P6 >= 100 { cur_z = 7.0 } view_recentre() }
        }
        // 431: a budget corridor: six rooms without en-suites share one small bathroom (toilet,
        //      sink, shower), 12 guests from 6:30 with low hygiene: queues (BATHQ lines); P5 > 0: zoom 2
        431 => {
            new_hotel_state(); start_play(); money = 9999999
            scen_shared()
            if P5 > 0 { view_zoom = 2; cur_x = 19.0; cur_z = 9.5; view_recentre() }
        }
        // 433: a day in two rooms: the demo hotel with 12 guests from P2 h (default 12) at speed 4, a
        //      close look (zoom 2) at the two west rooms on G; ACT lines (what their guests do)
        433 => {
            new_hotel_state(); start_play(); money = 9999999
            scen_hotel(1)
            var h = P2
            if h == 0 { h = 12 }
            tod = h * 60 * MIN_FRAMES
            s_fill_guests(12)
            speed = 4
            view_zoom = 2
            view_floor = 0
            cur_x = 8.0
            cur_z = 13.0
            view_recentre()
        }
        // 432: the bathroom rules on a test floor (RULE lines: each bedroom's verdict)
        432 => { new_hotel_state(); start_play(); money = 9999999; scen_rules() }
        // 499: cost probes (rooms_update, compute_pass, one field)
        499 => { new_hotel_state(); start_play(); money = 9999999; scen_grand(0, 60, 15) }
        else => {}
    }
}

var probe_f: u32
fn probe(name: *u8, c0: s32) {
    print(name)
    print(" ")
    print_int(c0 - CYCLES as s32 + ((frame() - probe_f) as s32) * 500000)
    println("")
}

fn scen_sim_pad(f: s32) -> u32 {
    if (SCENARIO == 91 || SCENARIO == 95) && (f == 60 || f == 61) { return A }
    return 0
}

// ---- motion and crowd metrics (cheap per-frame counters; the PP log is analysed offline)
var m_px: [128]fixed
var m_pz: [128]fixed
var m_pf: [128]s32
var m_pvis: [128]bool
var m_eq_max: s32                // most people waiting at one elevator since the last HIST
var m_stall_max: s32
var m_stall_bad: s32             // frames with more than 3 stalled walkers
var m_tp: s32                    // jumps over 0.6 tiles while visible
var m_tick0: s32
var m_frame0: u32
var m_fprev: u32
var m_real: s32                  // the previous frame's real cost (cycles), counting overruns

fn m_cost() {
    let f = frame()
    m_real = cpu_used()
    if m_fprev != 0 && f - m_fprev > 1 { m_real += ((f - m_fprev - 1) as s32) * 500000 }
    m_fprev = f
}

fn m_visible(p: *Person) -> bool { return p.used != 0 && p.mode as s32 != M_HIDDEN && p.mode as s32 != M_RIDE }

// Walkers that want to move (walking with a goal, or on stairs), and how many of them did not
// move since the previous frame. Also counts teleports and the elevator queues.
var m_walkers: s32
var m_stalled: s32
var m_nofield: s32               // stalled walkers with no next tile (waiting for a field)
var m_nofield_max: s32
var m_nofield_bad: s32           // samples with more than 3 of them
fn m_sample() {
    m_walkers = 0
    m_stalled = 0
    m_nofield = 0
    for i in 0..npeople {
        let p = &people[i]
        let vis = m_visible(p)
        if vis && m_pvis[i] && m_pf[i] == p.f as s32 && speed > 0 {
            let d = alen(p.x - m_px[i], p.z - m_pz[i])
            if d > 0.6 {
                m_tp += 1
                if P5 == 9 {
                    print("TP ")
                    print_int(scen_t)
                    print(" #")
                    print_int(i)
                    print(" k")
                    print_int(p.kind as s32)
                    print(" st")
                    print_int(p.state as s32)
                    print(" m")
                    print_int(p.mode as s32)
                    print(" ")
                    print_fixed(m_px[i])
                    print(",")
                    print_fixed(m_pz[i])
                    print(" -> ")
                    print_fixed(p.x)
                    print(",")
                    print_fixed(p.z)
                    print(" f")
                    print_int(p.f as s32)
                    println("")
                }
            }
            let wants = (p.mode as s32 == M_WALK && p.goal >= 0) || p.mode as s32 == M_STAIRS
            if wants {
                m_walkers += 1
                if d == 0.0 {
                    m_stalled += 1
                    if p.nxt < 0 { m_nofield += 1 }
                }
            }
        }
        m_px[i] = p.x
        m_pz[i] = p.z
        m_pf[i] = p.f as s32
        m_pvis[i] = vis
    }
    if speed > 0 {
        m_stall_max = max(m_stall_max, m_stalled)
        m_nofield_max = max(m_nofield_max, m_nofield)
        if m_nofield > 3 { m_nofield_bad += 1 }
        if m_stalled > 3 { m_stall_bad += 1 }
    }
    for k in 0..nelevs {
        var n = 0
        for i in 0..npeople {
            let p = &people[i]
            if p.used != 0 && p.mode as s32 == M_WAIT_ELEV && p.elev as s32 == k { n += 1 }
        }
        m_eq_max = max(m_eq_max, n)
    }
}

var hist_g: [16]s32
var hist_s: [16]s32
var hist_m: [8]s32
fn hist_dump() {
    for k in 0..16 { hist_g[k] = 0; hist_s[k] = 0 }
    for k in 0..8 { hist_m[k] = 0 }
    var stacked = 0
    for i in 0..npeople {
        let p = &people[i]
        if p.used == 0 { continue }
        if p.kind as s32 == P_GUEST { hist_g[p.state as s32 & 15] += 1 } else if p.kind as s32 == P_STAFF { hist_s[p.state as s32 & 15] += 1 }
        hist_m[p.mode as s32 & 7] += 1
        if !m_visible(p) { continue }
        for j in 0..i {
            let q = &people[j]
            if !m_visible(q) || q.f != p.f { continue }
            if abs(q.x - p.x) < 0.25 && abs(q.z - p.z) < 0.25 { stacked += 1 }
        }
    }
    print("HIST ")
    print(fmt_clock())
    print(" money ")
    print_int(money)
    print(" G")
    for k in 0..13 { print(" "); print_int(hist_g[k]) }
    print(" | S")
    for k in 0..11 { print(" "); print_int(hist_s[k]) }
    print(" | M")
    for k in 0..6 { print(" "); print_int(hist_m[k]) }
    print(" | stacked ")
    print_int(stacked)
    print(" elevq ")
    print_int(m_eq_max)
    print(" stallmax ")
    print_int(m_stall_max)
    print(" nofield ")
    print_int(m_nofield_max)
    print("/")
    print_int(m_nofield_bad)
    print(" tp ")
    print_int(m_tp)
    print(" rev ")
    print_int(reviews_n)
    print(" avg10 ")
    print_int(reviews_avg10)
    print(" stars ")
    print_int(stars)
    println("")
    m_eq_max = 0
    m_stall_max = 0
    m_nofield_max = 0
    m_nofield_bad = 0
}

// Guests in view-floor rooms of one type (liveliness), and guests visible on a floor.
fn guests_in(rt: s32) -> s32 {
    var n = 0
    for i in 0..npeople {
        let p = &people[i]
        if !m_visible(p) || p.kind as s32 != P_GUEST { continue }
        let r = room_at(p.f as s32, p.x as s32, p.z as s32)
        if r > 0 && rooms[r].rtype as s32 == rt { n += 1 }
    }
    return n
}

fn guests_on(f: s32) -> s32 {
    var n = 0
    for i in 0..npeople {
        let p = &people[i]
        if m_visible(p) && p.kind as s32 == P_GUEST && p.f as s32 == f { n += 1 }
    }
    return n
}

fn pp_log() {
    for i in 0..npeople {
        let p = &people[i]
        if p.used == 0 || p.f as s32 != view_floor || p.mode as s32 == M_HIDDEN { continue }
        let v = &people_vis[i]
        project(vec3(p.x + v.ox, fixed(p.f as s32) * STOREY + p.y, p.z + v.oz))
        print("PP ")
        print_int(scen_t)
        print(" ")
        print_int(i)
        print(" ")
        print_int(p.kind as s32)
        print(" ")
        print_int(p.mode as s32)
        print(" ")
        print_int(p.pose as s32)
        print(" ")
        print_int(p.dir as s32)
        print(" ")
        print_fixed(p.x + v.ox)
        print(" ")
        print_fixed(p.z + v.oz)
        print(" ")
        print_int(proj_x)
        print(" ")
        print_int(proj_y)
        print(" ")
        print_int(p.state as s32)
        print(" ")
        print_int(v.anim as s32)
        print(" ")
        print_int(v.fade as s32)
        print(" ")
        print_int(p.party as s32)
        print(" ")
        print_int(speed)
        println("")
    }
}

