        for i in 0..npeople {
            let p = &people[i]
            if p.used == 0 { continue }
            if p.mode as s32 == M_WALK && p.goal >= 0 { nw += 1; person_move(i) }
        }
        probe("move walkers", c0)
        probe_f = frame()
        c0 = CYCLES as s32
        for i in 0..npeople {
            let p = &people[i]
            if p.used == 0 { continue }
            if !(p.mode as s32 == M_WALK && p.goal >= 0) { ns += 1; person_move(i) }
        }
        probe("move others", c0)
        probe_f = frame()
        c0 = CYCLES as s32
        for i in 0..npeople {
            let p = &people[i]
            if p.used != 0 && p.kind as s32 == P_GUEST { guest_tick(i) }
        }
        probe("guest_tick", c0)
        probe_f = frame()
        c0 = CYCLES as s32
        for i in 0..npeople {
            let p = &people[i]
            if p.used != 0 && p.kind as s32 == P_STAFF { staff_tick(i) }
        }
        probe("staff_tick", c0)
        var c_st = 0
        var c_ki = 0
        var c_pn = 0
        var c_al = 0
        for i in 0..npeople {
            let p = &people[i]
            if p.used == 0 || p.mode as s32 != M_WALK || p.goal < 0 { continue }
            var c1 = CYCLES as s32
            steer(i, p.x + 0.3, p.z + 0.2, false)
            c_st += c1 - CYCLES as s32
            c1 = CYCLES as s32
            keep_inside(p)
            c_ki += c1 - CYCLES as s32
            c1 = CYCLES as s32
            let a = alen(p.vx, p.vz)
            c_al += c1 - CYCLES as s32
            let sn = p.nxt
            p.nxt = -1
            c1 = CYCLES as s32
            pick_next(i)
            c_pn += c1 - CYCLES as s32
        }
        print("steer ")
        print_int(c_st)
        print(" keep ")
        print_int(c_ki)
        print(" alen ")
        print_int(c_al)
        print(" pick_next ")
        print_int(c_pn)
        println("")
        print("walkers ")
        print_int(nw)
        print(" others ")
        print_int(ns)
        println("")
        probe_f = frame()
        c0 = CYCLES as s32
        paths_update()
        probe("paths_update", c0)
    }
    if SCENARIO == 499 && scen_t == 140 {
        let oi = s_obj(OB_PLANT, 0, 18, 8, 0)
