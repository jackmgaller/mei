        let c = &people[4]
        print(" cook st ")
        print_int(c.state as s32)
        print(" act ")
        print_int(c.act as s32)
        print(" @")
        print_int(ptile_x(c.tile as s32))
        print(",")
        print_int(ptile_z(c.tile as s32))
        print(" wait ")
        print_int(c.wait as s32)
        let w = &people[5]
        print(" | waiter st ")
        print_int(w.state as s32)
        print(" job ")
        print_int(w.job as s32)
        print(" @")
        print_int(ptile_x(w.tile as s32))
        print(",")
        print_int(ptile_z(w.tile as s32))
        print(" wait ")
        print_int(w.wait as s32)
        print(" ")
        println(fmt_clock())
        for k in 0..njobs {
            let j = &jobs[k]
            if j.kind == 0 { continue }
            print("   job kind ")
            print_int(j.kind as s32)
            print(" role ")
            print_int(j.role as s32)
            print(" who ")
            print_int(j.who as s32)
            print(" target ")
            println(num(j.target as s32))
        }
    }
    if SCENARIO == 30 && scen_t % 720 == 0 && scen_t > 5000 && scen_t < 9000 {
        for k in 0..njobs {
            let j = &jobs[k]
            if j.kind == 0 { continue }
            print("  job ")
            print_int(k)
            print(" kind ")
            print_int(j.kind as s32)
            print(" step ")
            print_int(j.step as s32)
            print(" who ")
            print_int(j.who as s32)
            print(" target ")
            println(num(j.target as s32))
        }
        for k in 0..nelevs {
            let e = &elevs[k]
            print("  elev ")
            print_int(k)
            print(" obj ")
            print_int(e.obj as s32)
            print(" pos ")
            print_fixed(e.pos)
            print(" dir ")
            print_int(e.dir)
            print(" door ")
            print_int(e.door)
            print(" calls ")
            print_int(e.calls as s32)
            print(" n ")
            print_int(e.n)
            print(" f0 ")
            print_int(e.f0 as s32)
            print(" f1 ")
            println(num(e.f1 as s32))
        }
        for i in 0..npeople {
            let p = &people[i]
            if p.used == 0 || p.kind as s32 != P_STAFF { continue }
            print("  staff ")
            print_int(i)
            print(" role ")
            print_int(p.type as s32)
            print(" st ")
            print_int(p.state as s32)
            print(" job ")
            print_int(p.job as s32)
            print(" @")
            print_int(ptile_f(p.tile as s32))
            print(":")
            print_int(ptile_x(p.tile as s32))
            print(",")
            print_int(ptile_z(p.tile as s32))
            print(" goal ")
            print_int(p.goal as s32)
            print(" wait ")
            print_int(p.wait as s32)
            print(" carry ")
            print_int(p.carry as s32)
            print(" mode ")
            print_int(p.mode as s32)
            print(" elev ")
            print_int(p.elev as s32)
            print(" energy ")
            println(num(p.energy as s32))
        }
    }
    if SCENARIO == 91 && scen_t == 100 {
        print("loaded: day ")
        print_int(day)
        print(" money ")
        print_int(money)
        print(" objs ")
        print_int(nobjs)
        print(" staff ")
        print_int(staff_count())
        print(" rooms ")
        print_int(nrooms)
        // bathrooms after a load (an old save keeps its in-room fixtures as en-suites)
        var nb = 0
        var ne = 0
        var nl = 0
        var nv = 0
        for r in 1..nrooms {
            if rooms[r].used == 0 || !is_bedroom(r) { continue }
            nb += 1
            if rooms[r].flags & RF_VALID != 0 { nv += 1 }
            if r_bath[r] as s32 >= BATH_ENSUITE { ne += 1 }
            if r_why[r] as s32 == WHY_LEGACY { nl += 1 }
        }
        print(" bedrooms ")
        print_int(nb)
        print(" bookable ")
        print_int(nv)
        print(" en-suite ")
        print_int(ne)
        print(" legacy ")
        print_int(nl)
        print(" legacy_baths ")
        print_int(legacy_baths as s32)
        println("")
    }
    // P1 = 1: save it again (in the current format)
    if SCENARIO == 91 && P1 == 1 && scen_t == 130 { save_game(); print("saved again, size "); print_int(spos); println("") }
}

fn report() {
    print("== ")
    println(fmt_clock())
    print("money ")
    print_int(money)
    print(" stars ")
    print_int(stars)
    print(" score ")
    print_int(score)
    print(" rep ")
    print_int(reputation)
    print(" guests ")
    print_int(guest_count())
    print(" served ")
    print_int(guests_served)
    print(" svc wait ")
    print_int(service_wait_avg)
    println("")
    print("ledger y:")
    for k in 0..NLG { print(" "); print_int(ledger_y[k]) }
    print("  today:")
    for k in 0..NLG { print(" "); print_int(ledger[k]) }
    println("")
    for k in 0..reviews_n {
        print("  ")
        print_int(reviews[k].stars as s32)
        print("* ")
        println(str_of(REVIEW_OFF[reviews[k].quote as s32] as s32))
    }
    print("jobs ")
    print_int(njobs)
    print(" dirty rooms ")
    var d = 0
    for r in 1..nrooms { if rooms[r].used != 0 && rooms[r].state as s32 == RS_DIRTY { d += 1 } }
    print_int(d)
    print(" linen ")
    for i in 0..nobjs { if objs[i].used != 0 && objs[i].t as s32 == OB_LINEN_SHELF { print_int(objs[i].stock as s32); print(" ") } }
    print(" washer ")
    for i in 0..nobjs { if objs[i].used != 0 && objs[i].t as s32 == OB_WASHER { print_int(objs[i].stock as s32); print("/"); print_int(objs[i].pad as s32); print(" ") } }
    print(" fridge ")
    for i in 0..nobjs { if objs[i].used != 0 && objs[i].t as s32 == OB_FRIDGE { print_int(objs[i].stock as s32); print(" ") } }
    println("")
}
