// Test scenarios for Check-In! (run with tests/run.sh SCENARIO FRAMES OUT).
const TEST = 1
const TEST_CARD = SCENARIO >= 90

var scen_t: s32
var cpu_max: s32
var tri_max: s32
var cpu_sum: s32
var cpu_n: s32

fn input_pad(f: s32) -> u32 { return script_pad(f) }
fn input_stick(f: s32) -> vec2 { return vec2(0.0, 0.0) }

fn test_init() {
    show_debug = SHOT == 0
    if SCENARIO != 0 && SCENARIO < 90 {
        new_hotel_state()
        start_play()
    }
    money = 9999999
    match SCENARIO {
        1 => scen_basic()
        2 => { scen_basic(); view_zoom = 2; view_recentre() }
        3 => { scen_basic(); view_rot = 0; view_recentre() }
        4 => { scen_basic(); view_floor = 1; view_recentre() }
        5 => { scen_basic(); view_zoom = 0; view_rot = 1; view_recentre() }
        6 => { scen_basic() }     // open the menu, pick a bed, place it
        7 => { scen_basic() }     // pick a floor and drag a room
        10 => scen_hotel(0)       // the demo hotel, staffed, from 13:00
        11 => scen_hotel(1)       // with a first floor and an elevator
        12 => { scen_hotel(1); view_floor = 1; view_recentre() }
        13 => { scen_hotel(1); s_obj(OB_FLOOR_LAMP, 0, 11, 3, 0); s_obj(OB_FLOOR_LAMP, 0, 19, 8, 0); tod = 21 * 60 * MIN_FRAMES }
        14 => { scen_hotel(1); tod = 19 * 60 * MIN_FRAMES }
        15 => { scen_hotel(1); view_floor = 1; view_zoom = 2; cur_x = 14.0; cur_z = 15.0; view_recentre() }
        20 => scen_grand(0, 0, 13)           // the grand hotel, ground floor, afternoon
        21 => scen_grand(3, 0, 13)           // the atrium from above
        22 => scen_grand(0, 60, 15)          // busy: 60 guests checked in
        23 => scen_grand(0, 60, 22)          // busy at night (the bar)
        24 => scen_grand(5, 60, 15)          // the top floor
        30 => { scen_hotel(1); speed = 4 }   // two days at x4: reviews and money
        25 => { scen_grand(3, 0, 13); no_haze = true; view_zoom = 0; view_recentre() }
        // screenshot set (run with SHOT=1)
        40 => { scen_hotel(1); tool = Tool.Paint; tool_arg = FK_DECK; cur_x = 8.5; cur_z = 15.5; view_recentre() }
        41 => { scen_grand(0, 60, 15); overlay = OV_ROOMS }
        42 => { scen_grand(0, 60, 15) }                   // the rating page (opened by the hook)
        43 => { scen_grand(0, 60, 20); tod = tod + 30 * MIN_FRAMES; view_zoom = 2; view_rot = 0; cur_x = 23.0; cur_z = 5.0; view_recentre() }
        44 => { scen_grand(3, 30, 13); view_zoom = 2; cur_x = 14.5; cur_z = 7.0; view_recentre() }
        45 => { scen_grand(1, 30, 11); view_zoom = 2; cur_x = 15.0; cur_z = 7.0; view_recentre() }
        46 => { scen_grand(0, 60, 15); view_zoom = 2; cur_x = 15.0; cur_z = 5.5; view_recentre() }
        47 => { scen_grand(5, 60, 15); view_zoom = 2; cur_x = 14.0; cur_z = 13.0; view_recentre() }
        48 => { scen_hotel(1); view_floor = 1; view_recentre() }   // the build menu (Bedroom tab)
        90 => { new_hotel_state(); start_play(); scen_hotel(1); day = 7; money = 123456; view_floor = 1; view_recentre() }
        91 => {}                  // the title: Continue loads the save
        95 => {}                  // the title: New hotel (no card)
        92 => { new_hotel_state(); start_play(); money = 9999999; scen_grand(0, 0, 13) }   // the grand hotel's save size
        else => {}
    }
}

fn scen_basic() {
    s_room(0, FK_MARBLE, 10, 3, 17, 8)
    s_room(0, FK_CORR_CARPET, 4, 9, 27, 10)
    s_room(0, FK_CARPET_RED, 4, 11, 7, 13)
    s_room(0, FK_WOOD, 8, 11, 11, 13)
    s_door(0, 12, 8, 0, 1)
    s_door(0, 13, 3, 0, -1)
    s_door(0, 5, 11, 0, -1)
    s_window(0, 4, 12, -1, 0)
    s_obj(OB_RECEPTION_DESK, 0, 12, 5, 2)
    s_obj(OB_KEY_RACK, 0, 10, 3, 0)
    s_obj(OB_PLANT, 0, 17, 3, 0)
    s_obj(OB_WAITING_SOFA, 0, 15, 7, 2)
    s_obj(OB_BED_DOUBLE, 0, 6, 12, 3)
    s_room(1, FK_CARPET_BLUE, 10, 3, 17, 8)
    s_room(0, FK_DECK, 6, 14, 20, 19)
    s_room(0, FK_POOL_WATER, 9, 15, 15, 17)
    s_obj(OB_LOUNGER, 0, 17, 15, 0)
    s_obj(OB_PALM, 0, 19, 18, 0)
    cur_x = 14.0
    cur_z = 10.0
    view_recentre()
}

// Scripted input: (frame, pad) pairs; the pad holds until the next pair.
const SCRIPT6: [24]s32 = [10, 64, 12, 0, 20, 512, 22, 0, 30, 512, 32, 0, 40, 8, 42, 0, 60, 16, 62, 0, 70, 2, 90, 0]
const SCRIPT7: [22]s32 = [10, 64, 12, 0, 20, 8, 22, 0, 30, 16, 32, 0, 40, 16, 50, 16 | 8, 75, 16 | 2, 95, 16, 100, 0]

const SCRIPT48: [12]s32 = [10, 64, 12, 0, 20, 512, 22, 0, 30, 512, 32, 0]

fn script_from(tab: *s32, n: s32, f: s32) -> u32 {
    var pad: u32 = 0
    var k = 0
    while k < n {
        if tab[k] > f { break }
        pad = tab[k + 1] as u32
        k += 2
    }
    return pad
}

fn scen_hotel(level: s32) {
    s_demo_hotel(level)
    rooms_update()
    tod = 13 * 60 * MIN_FRAMES
    s_demo_staff()
    stars = 1
    cur_x = 16.0
    cur_z = 8.0
    view_recentre()
}

fn scen_grand(f: s32, guests: s32, h: s32) {
    s_grand_hotel()
    tod = h * 60 * MIN_FRAMES
    s_grand_staff()
    stars = 5
    reputation = 100
    rooms_update()
    s_fill_guests(guests)
    view_floor = f
    cur_x = 15.0
    cur_z = 8.0
    view_recentre()
}

fn script_pad(f: s32) -> u32 {
    if (SCENARIO == 91 || SCENARIO == 95) && (f == 60 || f == 61) { return A }
    if SCENARIO == 40 && f >= 3 { return A }
    if SCENARIO == 48 { return script_from(&SCRIPT48[0], len(SCRIPT48), f) }
    if SCENARIO == 6 { return script_from(&SCRIPT6[0], len(SCRIPT6), f) }
    if SCENARIO == 7 { return script_from(&SCRIPT7[0], len(SCRIPT7), f) }
    return 0
}

fn test_hook(f: s32) {
    scen_t += 1
    if (SCENARIO == 90 || SCENARIO == 92) && scen_t == 40 { save_game(); print("save size "); print_int(spos); println("") }
    if SCENARIO == 40 && scen_t == 12 { cur_x = 14.5; cur_z = 17.5 }
    if SCENARIO == 40 && scen_t == 30 { print("drag "); print_int(dragging as s32); print(" "); print_int(rx0); print(","); print_int(rz0); print(" "); print_int(rx1); print(","); print_int(rz1); print(" tool "); print_int(tool as s32); println("") }
    if SCENARIO == 43 && scen_t == 30 {
        for r in 1..nrooms {
            let rm = &rooms[r]
            if rm.used == 0 || rm.floor != 0 { continue }
            print("room "); print_int(r); print(" rt "); print_int(rm.rtype as s32); print(" kind "); print_int(rm.kind as s32); print(" @"); print_int(rm.x0 as s32); print(","); print_int(rm.z0 as s32); print(" missing "); print_int(rm.missing as s32); println("")
        }
    }
    if SCENARIO == 42 && scen_t == 150 {
        add_review(GT_BUSINESS, 4, RV_GREAT_ROOM)
        add_review(GT_FAMILY, 3, RV_NO_FUN)
        add_review(GT_HONEYMOON, 5, RV_GREAT_VIEW)
        add_review(GT_ROCKSTAR, 2, RV_NOISY)
        add_review(GT_BUSINESS, 4, RV_GREAT_WIFI)
        add_review(GT_FAMILY, 5, RV_GREAT_POOL)
        stars = 4
        compute_score()
        screen = Screen.Pause
        page = Page.Hotel
    }
    if (SCENARIO == 25 && scen_t == 240) || (SCENARIO == 44 && scen_t == 300) {
        set_camera()
        for k in 0..4 {
            var v = vec3(16.5, 0.0, 0.5)
            if k == 1 { v = vec3(15.0, 9.0, 8.0) }
            if k == 2 { v = vec3(15.0, 0.0, 3.0) }
            if k == 3 { v = vec3(15.0, 9.0, 6.0) }
            project(v)
            print("proj ")
            print_int(proj_x)
            print(",")
            print_int(proj_y)
            print(" w ")
            print_fixed(proj_w)
            println("")
        }
        for i in 0..npeople {
            let p = &people[i]
            if p.used == 0 || p.mode as s32 == M_HIDDEN { continue }
            project(vec3(p.x, fixed(p.f as s32) * STOREY + p.y, p.z))
            print("person ")
            print_int(i)
            print(" at ")
            print_int(proj_x)
            print(",")
            print_int(proj_y)
            print(" exposed ")
            print_int(exposed(p.f as s32, p.x as s32, p.z as s32) as s32)
            println("")
        }
    }
    if SCENARIO == 30 && scen_t % 2880 == 0 { report() }
    if SCENARIO == 30 && scen_t % 60 == 0 && scen_t > 360 && scen_t < 1100 && false {
        print("orders:")
        for k in 0..MAXORD { if orders[k].state != 0 { print(" #"); print_int(k); print("="); print_int(orders[k].state as s32); print(" g"); print_int(orders[k].guest as s32); print(" gs"); print_int(people[orders[k].guest as s32].state as s32) } }
        let c = &people[4]
        print(" cook st ")
        print_int(c.state as s32)
        print(" act ")
        print_int(c.act as s32)
        print(" @")
        print_int(ptile_x(c.tile as s32))
        print(",")
        print_int(ptile_z(c.tile as s32))
        print(" wait ")
        print_int(c.wait as s32)
        let w = &people[5]
        print(" | waiter st ")
        print_int(w.state as s32)
        print(" job ")
        print_int(w.job as s32)
        print(" @")
        print_int(ptile_x(w.tile as s32))
        print(",")
        print_int(ptile_z(w.tile as s32))
        print(" wait ")
        print_int(w.wait as s32)
        print(" ")
        println(fmt_clock())
        for k in 0..njobs {
            let j = &jobs[k]
            if j.kind == 0 { continue }
            print("   job kind ")
            print_int(j.kind as s32)
            print(" role ")
            print_int(j.role as s32)
            print(" who ")
            print_int(j.who as s32)
            print(" target ")
            println(num(j.target as s32))
        }
    }
    if SCENARIO == 30 && scen_t % 720 == 0 && scen_t > 5000 && scen_t < 9000 {
        for k in 0..njobs {
            let j = &jobs[k]
            if j.kind == 0 { continue }
            print("  job ")
            print_int(k)
            print(" kind ")
            print_int(j.kind as s32)
            print(" step ")
            print_int(j.step as s32)
            print(" who ")
            print_int(j.who as s32)
            print(" target ")
            println(num(j.target as s32))
        }
        for k in 0..nelevs {
            let e = &elevs[k]
            print("  elev ")
            print_int(k)
            print(" obj ")
            print_int(e.obj as s32)
            print(" pos ")
            print_fixed(e.pos)
            print(" dir ")
            print_int(e.dir)
            print(" door ")
            print_int(e.door)
            print(" calls ")
            print_int(e.calls as s32)
            print(" n ")
            print_int(e.n)
            print(" f0 ")
            print_int(e.f0 as s32)
            print(" f1 ")
            println(num(e.f1 as s32))
        }
        for i in 0..npeople {
            let p = &people[i]
            if p.used == 0 || p.kind as s32 != P_STAFF { continue }
            print("  staff ")
            print_int(i)
            print(" role ")
            print_int(p.type as s32)
            print(" st ")
            print_int(p.state as s32)
            print(" job ")
            print_int(p.job as s32)
            print(" @")
            print_int(ptile_f(p.tile as s32))
            print(":")
            print_int(ptile_x(p.tile as s32))
            print(",")
            print_int(ptile_z(p.tile as s32))
            print(" goal ")
            print_int(p.goal as s32)
            print(" wait ")
            print_int(p.wait as s32)
            print(" carry ")
            print_int(p.carry as s32)
            print(" mode ")
            print_int(p.mode as s32)
            print(" elev ")
            print_int(p.elev as s32)
            print(" energy ")
            println(num(p.energy as s32))
        }
    }
    if SCENARIO == 91 && scen_t == 100 {
        print("loaded: day ")
        print_int(day)
        print(" money ")
        print_int(money)
        print(" objs ")
        print_int(nobjs)
        print(" staff ")
        print_int(staff_count())
        print(" rooms ")
        print_int(nrooms)
        println("")
    }
    if scen_t > 30 {
        let u = cpu_used()
        cpu_max = max(cpu_max, u)
        tri_max = max(tri_max, tris_drawn() + ui_tris)
        cpu_sum += u / 10
        cpu_n += 1
    }
    if scen_t % 120 == 0 {
        print("t=")
        print_int(scen_t)
        print(" cpu ")
        print_int(cpu_used())
        print(" max ")
        print_int(cpu_max)
        print(" avg ")
        print_int(cpu_sum / max(cpu_n, 1) * 10)
        print(" tris ")
        print_int(tris_drawn())
        print(" max ")
        print_int(tri_max)
        print(" cache ")
        print_int(cache_cycles)
        print(" arena ")
        print_int((cache_end as s32 - (&cache_arena[0]) as s32) / 4)
        print(" full ")
        print_int(cache_full as s32)
        print(" lo ")
        print_int(lo_tris)
        print(" drop ")
        print_int(((GPU_STATUS >> 16) & 1) as s32)
        print(" ppl ")
        print_int(npeople)
        print(" guests ")
        print_int(guest_count())
        print(" ")
        println(fmt_clock())
        if SCENARIO >= 10 && scen_t % 1200 == 0 || scen_t == 240 { dump_people() }
        print("bfs nodes ")
        print_int(bfs_nodes)
        print(" ready:")
        var nr = 0
        var np = 0
        for k in 0..NFIELD { if fld_key[k] >= 0 { if fld_ready[k] { nr += 1 } else { np += 1 } } }
        print_int(nr)
        print(" pending ")
        print_int(np)
        print(" pass@16,0=")
        print_int(pass[16] as s32)
        print(" @15,4=")
        print_int(pass[143] as s32)
        println("")
    }
}

fn dump_people() {
    for i in 0..npeople {
        let p = &people[i]
        if p.used == 0 { continue }
        print("  #")
        print_int(i)
        print(" k")
        print_int(p.kind as s32)
        print(" t")
        print_int(p.type as s32)
        print(" st")
        print_int(p.state as s32)
        print(" m")
        print_int(p.mode as s32)
        print(" f")
        print_int(p.f as s32)
        print(" @")
        print_int(ptile_x(p.tile as s32))
        print(",")
        print_int(ptile_z(p.tile as s32))
        print(" goal ")
        print_int(p.goal as s32)
        print(" w")
        print_int(p.wait as s32)
        print(" act")
        print_int(p.act as s32)
        print(" room")
        println(num(p.room as s32))
    }
}

fn report() {
    print("== ")
    println(fmt_clock())
    print("money ")
    print_int(money)
    print(" stars ")
    print_int(stars)
    print(" score ")
    print_int(score)
    print(" rep ")
    print_int(reputation)
    print(" guests ")
    print_int(guest_count())
    print(" served ")
    print_int(guests_served)
    print(" svc wait ")
    print_int(service_wait_avg)
    println("")
    print("ledger y:")
    for k in 0..NLG { print(" "); print_int(ledger_y[k]) }
    print("  today:")
    for k in 0..NLG { print(" "); print_int(ledger[k]) }
    println("")
    for k in 0..reviews_n {
        print("  ")
        print_int(reviews[k].stars as s32)
        print("* ")
        println(str_of(REVIEW_OFF[reviews[k].quote as s32] as s32))
    }
    print("jobs ")
    print_int(njobs)
    print(" dirty rooms ")
    var d = 0
    for r in 1..nrooms { if rooms[r].used != 0 && rooms[r].state as s32 == RS_DIRTY { d += 1 } }
    print_int(d)
    print(" linen ")
    for i in 0..nobjs { if objs[i].used != 0 && objs[i].t as s32 == OB_LINEN_SHELF { print_int(objs[i].stock as s32); print(" ") } }
    print(" washer ")
    for i in 0..nobjs { if objs[i].used != 0 && objs[i].t as s32 == OB_WASHER { print_int(objs[i].stock as s32); print("/"); print_int(objs[i].pad as s32); print(" ") } }
    print(" fridge ")
    for i in 0..nobjs { if objs[i].used != 0 && objs[i].t as s32 == OB_FRIDGE { print_int(objs[i].stock as s32); print(" ") } }
    println("")
}
