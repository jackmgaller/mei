// Test harness for Check-In! (run with tests/run.sh SCENARIO FRAMES OUT [mei-headless args]).
// This file is the infrastructure: scripted input, the shared fixtures (scen_basic, scen_hotel,
// scen_grand) and the periodic logs. The scenarios themselves live per workstream:
//   scen_ui.akr  (B, UI and controls)   existing 1-7, 40, 48;  new ones 300-399
//   scen_art.akr (A, art and rendering) existing 21, 25, 41-47; new ones 200-299
//   scen_sim.akr (C, simulation)        existing 10-15, 20, 22-24, 30, 90-95; new ones 400-499
// Each file provides scen_<ws>_init(), scen_<ws>_pad(f) (0 unless it scripts SCENARIO) and
// scen_<ws>_hook(), which only act on their own scenario numbers.
// Frame sequences: tests/run.sh 22 600 out --dump-every 4 out_seq --dump-from 100
// Owner: workstream C (infrastructure); add scenarios in your own scen_ file.
import "scen_ui.akr"
import "scen_art.akr"
import "scen_sim.akr"

const TEST = 1
const TEST_CARD = SCENARIO >= 90

var scen_t: s32
var cpu_max: s32
var tri_max: s32
var cpu_sum: s32
var cpu_n: s32

fn input_pad(f: s32) -> u32 { return script_pad(f) }
fn input_stick(f: s32) -> vec2 { return vec2(0.0, 0.0) }

fn test_init() {
    show_debug = SHOT == 0
    if SCENARIO != 0 && SCENARIO < 90 {
        new_hotel_state()
        start_play()
    }
    money = 9999999
    scen_ui_init()
    scen_art_init()
    scen_sim_init()
}

fn scen_basic() {
    s_room(0, FK_MARBLE, 10, 3, 17, 8)
    s_room(0, FK_CORR_CARPET, 4, 9, 27, 10)
    s_room(0, FK_CARPET_RED, 4, 11, 7, 13)
    s_room(0, FK_WOOD, 8, 11, 11, 13)
    s_door(0, 12, 8, 0, 1)
    s_door(0, 13, 3, 0, -1)
    s_door(0, 5, 11, 0, -1)
    s_window(0, 4, 12, -1, 0)
    s_obj(OB_RECEPTION_DESK, 0, 12, 5, 2)
    s_obj(OB_KEY_RACK, 0, 10, 3, 0)
    s_obj(OB_PLANT, 0, 17, 3, 0)
    s_obj(OB_WAITING_SOFA, 0, 15, 7, 2)
    s_obj(OB_BED_DOUBLE, 0, 6, 12, 3)
    s_room(1, FK_CARPET_BLUE, 10, 3, 17, 8)
    s_room(0, FK_DECK, 6, 14, 20, 19)
    s_room(0, FK_POOL_WATER, 9, 15, 15, 17)
    s_obj(OB_LOUNGER, 0, 17, 15, 0)
    s_obj(OB_PALM, 0, 19, 18, 0)
    cur_x = 14.0
    cur_z = 10.0
    view_recentre()
}

fn script_from(tab: *s32, n: s32, f: s32) -> u32 {
    var pad: u32 = 0
    var k = 0
    while k < n {
        if tab[k] > f { break }
        pad = tab[k + 1] as u32
        k += 2
    }
    return pad
}

fn scen_hotel(level: s32) {
    s_demo_hotel(level)
    rooms_update()
    tod = 13 * 60 * MIN_FRAMES
    s_demo_staff()
    stars = 1
    cur_x = 16.0
    cur_z = 8.0
    view_recentre()
}

fn scen_grand(f: s32, guests: s32, h: s32) {
    s_grand_hotel()
    tod = h * 60 * MIN_FRAMES
    s_grand_staff()
    stars = 5
    reputation = 100
    rooms_update()
    s_fill_guests(guests)
    view_floor = f
    cur_x = 15.0
    cur_z = 8.0
    view_recentre()
}

// Scripted input: (frame, pad) pairs; the pad holds until the next pair (see script_from).
fn script_pad(f: s32) -> u32 {
    return scen_ui_pad(f) | scen_art_pad(f) | scen_sim_pad(f)
}

fn test_hook(f: s32) {
    scen_t += 1
    scen_ui_hook()
    scen_art_hook()
    scen_sim_hook()
    if scen_t > 30 {
        let u = cpu_used()
        cpu_max = max(cpu_max, u)
        tri_max = max(tri_max, tris_drawn() + ui_tris)
        cpu_sum += u / 10
        cpu_n += 1
    }
    if scen_t % 120 == 0 {
        print("t=")
        print_int(scen_t)
        print(" cpu ")
        print_int(cpu_used())
        print(" max ")
        print_int(cpu_max)
        print(" avg ")
        print_int(cpu_sum / max(cpu_n, 1) * 10)
        print(" tris ")
        print_int(tris_drawn())
        print(" max ")
        print_int(tri_max)
        print(" cache ")
        print_int(cache_cycles)
        print(" arena ")
        print_int((cache_end as s32 - (&cache_arena[0]) as s32) / 4)
        print(" full ")
        print_int(cache_full as s32)
        print(" lo ")
        print_int(lo_tris)
        print(" drop ")
        print_int(((GPU_STATUS >> 16) & 1) as s32)
        print(" ppl ")
        print_int(npeople)
        print(" guests ")
        print_int(guest_count())
        print(" ")
        println(fmt_clock())
        if SCENARIO >= 10 && scen_t % 1200 == 0 || scen_t == 240 { dump_people() }
        print("bfs nodes ")
        print_int(bfs_nodes)
        print(" ready:")
        var nr = 0
        var np = 0
        for k in 0..NFIELD { if fld_key[k] >= 0 { if fld_ready[k] { nr += 1 } else { np += 1 } } }
        print_int(nr)
        print(" pending ")
        print_int(np)
        print(" pass@16,0=")
        print_int(pass[16] as s32)
        print(" @15,4=")
        print_int(pass[143] as s32)
        println("")
    }
}

fn dump_people() {
    for i in 0..npeople {
        let p = &people[i]
        if p.used == 0 { continue }
        print("  #")
        print_int(i)
        print(" k")
        print_int(p.kind as s32)
        print(" t")
        print_int(p.type as s32)
        print(" st")
        print_int(p.state as s32)
        print(" m")
        print_int(p.mode as s32)
        print(" f")
        print_int(p.f as s32)
        print(" @")
        print_int(ptile_x(p.tile as s32))
        print(",")
        print_int(ptile_z(p.tile as s32))
        print(" goal ")
        print_int(p.goal as s32)
        print(" w")
        print_int(p.wait as s32)
        print(" act")
        print_int(p.act as s32)
        print(" room")
        println(num(p.room as s32))
    }
}
