// SELECT cycles the overlays: room types, noise, staff coverage and guest happiness. Also the
// inspect panels for people and objects, the review ticker, the end-of-day report, and the
// ambience that follows what is on screen.

const OV_NONE = 0
const OV_ROOMS = 1
const OV_NOISE = 2
const OV_STAFF = 3
const OV_MOOD = 4
const NOV = 5

var overlay: s32

fn overlay_name() -> *u8 {
    match overlay {
        1 => return "Overlay: room types"
        2 => return "Overlay: noise at night"
        3 => return "Overlay: staff coverage"
        4 => return "Overlay: guest happiness"
        else => return ""
    }
}

// Tints the tiles of room r (as runs per row) with colour c.
fn tint_room(r: s32, c: u32) {
    let rm = &rooms[r]
    let f = rm.floor as s32
    let y = fixed(f) * STOREY + 0.04
    for z in rm.z0 as s32..rm.z1 as s32 + 1 {
        var x = rm.x0 as s32
        while x <= rm.x1 as s32 {
            if room_at(f, x, z) != r { x += 1; continue }
            var x1 = x
            while x1 + 1 <= rm.x1 as s32 && room_at(f, x1 + 1, z) == r { x1 += 1 }
            mb_hquad(fixed(x), fixed(z), fixed(x1 + 1), fixed(z + 1), y, c)
            x = x1 + 1
        }
    }
}

fn room_label(r: s32, s: *u8, c: u32) {
    let rm = &rooms[r]
    let cx = (fixed(rm.x0 as s32) + fixed(rm.x1 as s32 + 1)) / 2
    let cz = (fixed(rm.z0 as s32) + fixed(rm.z1 as s32 + 1)) / 2
    if !project(vec3(cx, fixed(rm.floor as s32) * STOREY, cz)) { return }
    if proj_x < 0 || proj_x > 320 || proj_y < 20 || proj_y > 220 { return }
    let w = text_w(s, false)
    ui_rect(proj_x - w / 2 - 2, proj_y - 6, w + 4, 12, rgb(10, 12, 30), 2)
    ftext_c(proj_x, proj_y - 7, s, c, false)
}

fn draw_overlay() {
    if overlay == OV_NONE { return }
    bm_bias = B_SLAB - 2
    look_flat()
    mb_flags = FACE_SEMI
    mb_blend = 0
    let f = view_floor
    for r in 1..nrooms {
        let rm = &rooms[r]
        if rm.used == 0 || rm.floor as s32 != f { continue }
        if overlay == OV_ROOMS {
            var c = RT_COL[rm.rtype as s32]
            if rm.rtype as s32 == RT_NONE { c = rgb(90, 90, 100) }
            tint_room(r, c)
        } else if overlay == OV_NOISE {
            let n = clamp(rm.noise as s32, 0, 10)
            tint_room(r, clerp(rgb(60, 200, 90), rgb(240, 50, 40), fixed(n) / 10))
        } else if overlay == OV_MOOD {
            let gi = rm.occupant as s32
            if gi >= 0 && people[gi].used != 0 {
                let m = clamp(people[gi].mood as s32 + 30, 0, 80)
                tint_room(r, clerp(rgb(240, 60, 50), rgb(70, 220, 90), fixed(m) / 80))
            }
        }
    }
    if overlay == OV_STAFF {
        // stations: green when manned, red when not
        for i in 0..nobjs {
            let o = &objs[i]
            if o.used == 0 || o.f as s32 != f || !obj_flag(o.t as s32, F_STATION) { continue }
            var c = rgb(230, 60, 50)
            if desk_staffed(i) { c = rgb(60, 220, 90) }
            let gw = obj_gw(o.t as s32, o.rot as s32)
            let gd = obj_gd(o.t as s32, o.rot as s32)
            mb_hquad(fixed(o.x as s32) - 0.2, fixed(o.z as s32) - 0.2, fixed(o.x as s32 + gw) + 0.2, fixed(o.z as s32 + gd) + 0.2, fixed(f) * STOREY + 0.04, c)
        }
    }
    mb_flush()
    mb_flags = 0
    bm_bias = 0
    // labels
    for r in 1..nrooms {
        let rm = &rooms[r]
        if rm.used == 0 || rm.floor as s32 != f { continue }
        if overlay == OV_ROOMS {
            if rm.kind as s32 == KIND_CORR { continue }
            let b = nb()
            if rm.rtype as s32 == RT_NONE {
                sappend(b, room_type_name(rm.best as s32))
                sappend(b, "?")
                room_label(r, b, rgb(255, 170, 160))
            } else {
                room_label(r, room_type_name(rm.rtype as s32), WHITE)
            }
        } else if overlay == OV_NOISE && rm.noise > 0 {
            let b = nb()
            sint(b, rm.noise as s32)
            room_label(r, b, WHITE)
        }
    }
    if overlay == OV_MOOD { draw_mood_dots() }
    if overlay == OV_STAFF { draw_staff_panel() }
}

fn draw_mood_dots() {
    for i in 0..npeople {
        let p = &people[i]
        if p.used == 0 || p.kind as s32 != P_GUEST || p.f as s32 != view_floor || p.party >= 0 && p.state as s32 == GS_FOLLOW { continue }
        if p.mode as s32 == M_RIDE || p.mode as s32 == M_HIDDEN { continue }
        if !project(vec3(p.x, fixed(p.f as s32) * STOREY + 2.0, p.z)) { continue }
        let m = clamp(p.mood as s32 + 30, 0, 80)
        let c = clerp(rgb(240, 60, 50), rgb(70, 220, 90), fixed(m) / 80)
        ui_rect(proj_x - 2, proj_y - 2, 5, 5, c, -1)
    }
}

fn draw_staff_panel() {
    panel(4, 40, 116, 14 + NROLES * 11)
    ftext(8, 41, "On duty now", GOLD, false)
    for r in 0..NROLES {
        var on = 0
        for i in 0..npeople {
            let p = &people[i]
            if p.used != 0 && p.kind as s32 == P_STAFF && p.type as s32 == r && p.state as s32 != SS_HOME { on += 1 }
        }
        let y = 53 + r * 11
        ui_rect(8, y + 3, 5, 5, ROLE_COL[r], -1)
        var c = CREAM
        if on == 0 { c = DIM }
        ftext(16, y - 1, str_of(ROLE_NAME_OFF[r] as s32), c, false)
        ftext_r(114, y - 1, num(on), c, false)
    }
}

// ---- inspect: the person or object under the cursor

fn person_at_cursor() -> s32 {
    var best = -1
    var bd = 0.7
    for i in 0..npeople {
        let p = &people[i]
        if p.used == 0 || p.f as s32 != view_floor || p.mode as s32 == M_HIDDEN || p.mode as s32 == M_RIDE { continue }
        let d = abs(p.x - cur_x) + abs(p.z - cur_z)
        if d < bd { bd = d; best = i }
    }
    return best
}

fn guest_doing(p: *Person) -> *u8 {
    match p.state as s32 {
        1 => return "Arriving"
        2 => return "Queueing at reception"
        3 => return "Checking in"
        5 => return "On the way"
        6 => {
            let u = p.act as s32
            if u == USE_SLEEP { return "Sleeping" }
            if u == USE_EAT { return "Eating" }
            if u == USE_TV { return "Watching TV" }
            if u == USE_MODEM { return "Online (56k!)" }
            if u == USE_DRINK { return "Having a drink" }
            if u == USE_SHOWER || u == USE_BATH { return "Freshening up" }
            return "Relaxing"
        }
        7 => return "Waiting for food"
        8 => return "Leaving"
        9 => return "Tagging along"
        10 => return "Checking out"
        11 => return "Waiting to be served"
        12 => return "Swimming"
        else => return "Thinking"
    }
}

fn staff_doing(p: *Person) -> *u8 {
    match p.state as s32 {
        1 => return "Off shift"
        2 => return "Coming to work"
        3 => return "Going to the station"
        4 => return "On duty"
        5 => {
            let k = p.job as s32
            if k >= 0 {
                match jobs[k].kind as s32 {
                    1 => return "Cleaning a room"
                    2 => return "Repairing"
                    3 => return "Serving food"
                    4 => return "Carrying luggage"
                    5 => return "Moving linen"
                    else => {}
                }
            }
            return "Working"
        }
        6, 7 => return "On a break"
        9 => return "Going home"
        10 => return "Patrolling"
        else => return "Waiting for work"
    }
}

fn need_bar(x: s32, y: s32, label: *u8, v: s32) {
    ftext(x, y, label, SOFT, false)
    ui_rect(x + 46, y + 4, 52, 5, rgb(20, 24, 60), -1)
    let c = clerp(rgb(240, 70, 60), rgb(80, 220, 100), fixed(v) / 255)
    ui_rect(x + 46, y + 4, v * 52 / 255, 5, c, -1)
}

fn draw_person_info(i: s32) {
    let p = &people[i]
    let x = 204
    let y = 24
    if p.kind as s32 == P_GUEST {
        panel(x, y, 112, 96)
        ftext(x + 4, y + 2, str_of(GT_NAME_OFF[p.type as s32] as s32), WHITE, false)
        ftext(x + 4, y + 14, guest_doing(p), GOLD, false)
        need_bar(x + 4, y + 28, "Sleep", p.needs[N_SLEEP] as s32)
        need_bar(x + 4, y + 39, "Hunger", p.needs[N_HUNGER] as s32)
        need_bar(x + 4, y + 50, "Hygiene", p.needs[N_HYGIENE] as s32)
        need_bar(x + 4, y + 61, "Fun", p.needs[N_FUN] as s32)
        let b = nb()
        sappend(b, "Mood ")
        sint(b, p.mood as s32)
        sappend(b, "  spent ")
        smoney(b, p.spent as s32)
        ftext(x + 4, y + 74, b, CREAM, false)
    } else if p.kind as s32 == P_STAFF {
        panel(x, y, 112, 50)
        ftext(x + 4, y + 2, str_of(ROLE_NAME_OFF[p.type as s32] as s32), WHITE, false)
        ftext(x + 4, y + 14, staff_doing(p), GOLD, false)
        need_bar(x + 4, y + 28, "Energy", p.energy as s32 / 4)
        if p.shift == 0 { ftext(x + 4, y + 38, "Day shift", DIM, false) } else { ftext(x + 4, y + 38, "Night shift", DIM, false) }
    } else {
        panel(x, y, 112, 28)
        ftext(x + 4, y + 2, "Delivery driver", WHITE, false)
        ftext(x + 4, y + 13, "Bringing supplies", GOLD, false)
    }
}

fn draw_object_info(oi: s32) {
    let o = &objs[oi]
    let t = o.t as s32
    let x = 204
    let y = 24
    panel(x, y, 112, 40)
    ftext(x + 4, y + 2, obj_name(t), WHITE, false)
    let b = nb()
    if o.state & OS_BROKEN != 0 { sappend(b, "BROKEN - needs repair") }
    else {
        sappend(b, "Wear ")
        sint(b, o.wear as s32 * 100 / 255)
        sappend(b, "%")
        if t == OB_FRIDGE || t == OB_LINEN_SHELF || t == OB_STORAGE_SHELF || t == OB_WASHER {
            sappend(b, "  stock ")
            sint(b, o.stock as s32)
        }
    }
    ftext(x + 4, y + 14, b, GOLD, false)
    if obj_flag(t, F_STATION) {
        if desk_staffed(oi) { ftext(x + 4, y + 25, "Staffed", GREEN, false) } else { ftext(x + 4, y + 25, "Nobody on duty!", RED, false) }
    }
}

// ---- the review ticker and the day report

fn draw_ticker() {
    if review_new > 0 && reviews_n > 0 {
        let rv = &reviews[0]
        var y = 206
        if review_new > 280 { y += (review_new - 280) }
        if review_new < 20 { y += (20 - review_new) }
        ui_rect(0, y, 320, 20, rgb(10, 12, 40), 2)
        for st in 0..5 {
            if st < rv.stars as s32 { icon_tint(4 + st * 9, y + 2, IC_STAR, 0x606060) } else { icon_tint(4 + st * 9, y + 2, IC_STAR_OFF, 0x606060) }
        }
        ftext(52, y + 3, str_of(REVIEW_OFF[rv.quote as s32] as s32), CREAM, false)
    }
    if day_report_t > 0 && screen == Screen.Play {
        let y = 60
        panel(70, y, 180, 70)
        let b = nb()
        sappend(b, "Day ")
        sint(b, day - 1)
        sappend(b, " is done")
        ftext_c(160, y + 2, b, WHITE, true)
        var inc = 0
        var cost = 0
        for k in 0..NLG {
            if ledger_y[k] > 0 { inc += ledger_y[k] } else { cost += ledger_y[k] }
        }
        ftext(80, y + 26, "Income", SOFT, false)
        ftext_r(240, y + 26, smoney(nb(), inc), GREEN, false)
        ftext(80, y + 38, "Costs", SOFT, false)
        ftext_r(240, y + 38, smoney(nb(), cost), RED, false)
        ftext(80, y + 52, "Profit", WHITE, false)
        var c = GREEN
        if inc + cost < 0 { c = RED }
        ftext_r(240, y + 52, smoney(nb(), inc + cost), c, false)
    }
}

// ---- ambience: what is on screen is what you hear

var amb_t: s32

fn ambience_update() {
    amb_t += 1
    if amb_t % 30 != 0 { return }
    var lobby = 0
    var bar = 0
    var rest = 0
    var pool = 0
    var kitchen = 0
    for i in 0..npeople {
        let p = &people[i]
        if p.used == 0 || p.f as s32 != view_floor || p.mode as s32 == M_HIDDEN { continue }
        let r = room_at(p.f as s32, p.x as s32, p.z as s32)
        if r == 0 { continue }
        let t = rooms[r].rtype as s32
        if t == RT_LOBBY { lobby += 1 }
        if t == RT_BAR { bar += 1 }
        if t == RT_RESTAURANT { rest += 1 }
        if t == RT_POOL { pool += 1 }
        if t == RT_KITCHEN { kitchen += 1 }
    }
    amb(AMB_LOBBY, min(lobby * 40, 220))
    amb(AMB_BAR, min(bar * 50, 230))
    amb(AMB_RESTAURANT, min(rest * 40, 200))
    amb(AMB_KITCHEN, min(kitchen * 60, 160))
    var outdoor = 0
    if view_floor == 0 { outdoor = 120 + pool * 20 }
    if night_amt > 128 { amb(AMB_NIGHT, outdoor); amb(AMB_SEA, outdoor / 2) } else { amb(AMB_SEA, outdoor); amb(AMB_NIGHT, 0) }
}
