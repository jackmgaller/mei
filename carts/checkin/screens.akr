// Menus over the game: the pause menu (speed, staff, prices, the hotel's rating and reviews,
// the ledger, saving), and the title screen.

enum Page { Main, Staff, Prices, Hotel, Ledger, Controls }

var page = Page.Main
var pm_sel: s32
var st_row: s32
var st_col: s32
var pr_sel: s32
var prev_speed: s32 = 1

const PM_N = 9

fn open_pause() {
    prev_speed = max(speed, 1)
    screen = Screen.Pause
    page = Page.Main
    pm_sel = 0
    fx(FX_OK)
}

fn close_pause() {
    screen = Screen.Play
    fx(FX_BACK)
}

fn pm_label(k: s32) -> *u8 {
    match k {
        0 => return "Resume"
        1 => return "Speed"
        2 => return "Staff"
        3 => return "Room prices"
        4 => return "Hotel rating & reviews"
        5 => return "Ledger"
        6 => return "Controls"
        7 => return "Save to memory card"
        else => return "Quit to title"
    }
}

fn pause_update() {
    match page {
        Main => pm_update()
        Staff => staff_page_update()
        Prices => prices_update()
        Hotel, Ledger, Controls => {
            if btnp_in(B) || btnp_in(A) || btnp_in(START) { page = Page.Main; fx(FX_BACK) }
        }
    }
}

fn pm_update() {
    if rep_in(UP) { pm_sel = (pm_sel + PM_N - 1) % PM_N; fx(FX_CLICK) }
    if rep_in(DOWN) { pm_sel = (pm_sel + 1) % PM_N; fx(FX_CLICK) }
    if pm_sel == 1 {
        if btnp_in(LEFT) { speed_step(-1) }
        if btnp_in(RIGHT) { speed_step(1) }
    }
    if btnp_in(B) || btnp_in(START) { close_pause(); return }
    if btnp_in(A) {
        match pm_sel {
            0 => close_pause()
            1 => speed_step(1)
            2 => { page = Page.Staff; fx(FX_OK) }
            3 => { page = Page.Prices; fx(FX_OK) }
            4 => { page = Page.Hotel; fx(FX_OK); compute_score() }
            5 => { page = Page.Ledger; fx(FX_OK) }
            6 => { page = Page.Controls; fx(FX_OK) }
            7 => save_game()
            else => { screen = Screen.Title; screen_t = 0; fx(FX_BACK) }
        }
    }
}

fn speed_step(d: s32) {
    var k = 0
    if speed == 1 { k = 1 }
    if speed == 2 { k = 2 }
    if speed == 4 { k = 3 }
    k = clamp(k + d, 0, 3)
    let v: [4]s32 = [0, 1, 2, 4]
    speed = v[k]
    prev_speed = max(speed, 1)
    fx(FX_CLICK)
}

fn speed_name() -> *u8 {
    if speed == 0 { return "Paused" }
    if speed == 1 { return "x1" }
    if speed == 2 { return "x2" }
    return "x4"
}

fn draw_pause() {
    ui_rect(0, BAR_H, 320, 240 - BAR_H, ST_HUD_BAR, 0)
    match page {
        Main => draw_pm()
        Staff => draw_staff_page()
        Prices => draw_prices()
        Hotel => draw_hotel_page()
        Ledger => draw_ledger()
        Controls => draw_controls()
    }
}

// A page title and a back hint.
fn page_head(x: s32, y: s32, w: s32, title: *u8) {
    ftext(x + 8, y + 4, title, WHITE, true)
    ui_div(x + 6, y + 20, w - 12)
}

fn draw_pm() {
    let x = 92
    let y = 30
    let w = 136
    panel(x, y, w, 42 + PM_N * 13)
    page_head(x, y, w, "Paused")
    for k in 0..PM_N {
        let yy = y + 26 + k * 13
        var c = ST_TEXT
        if k == pm_sel {
            ui_sel(x + 6, yy - 2, w - 12, 13)
            c = WHITE
        }
        ftext(x + 12, yy, pm_label(k), c, false)
        if k == 1 {
            let b = nb()
            sappend(b, "\x15 ")
            sappend(b, speed_name())
            sappend(b, " \x16")
            ftext_r(x + w - 12, yy, b, ST_GOLD, false)
        }
    }
    // the next goal
    if goal_text != null {
        let b = nb()
        sappend(b, "Next: ")
        sappend(b, goal_text)
        let gw = text_w(b, false) + 16
        panel(160 - gw / 2, y + 48 + PM_N * 13, gw, 15)
        ftext(160 - gw / 2 + 8, y + 51 + PM_N * 13, b, ST_GOLD, false)
    }
}

// ---- controls: what every button does

fn draw_controls() {
    let x = 26
    let y = 22
    let w = 268
    panel(x, y, w, 196)
    page_head(x, y, w, "Controls")
    let rows: [15]*u8 = ["\x0B", "Stick", "\x01", "\x02", "\x03", "\x04", "\x04 + \x15\x16", "\x04 + \x13\x14", "\x05 \x06",
                         "\x08 tap", "\x08 + \x0B", "\x07", "\x05 \x06 (drawer)", "\x04 room card", "Pasting"]
    let what: [15]*u8 = ["Move one tile along the grid", "Move freely (settles on a tile)", "Build, place, or look at what's here",
                         "Back, close, put the tool away", "Open the build drawer", "Turn the object (or the view)",
                         "Turn the view", "Zoom in and out", "Floor down / up", "Game speed: x1, x2, x4, pause",
                         "Show rooms, noise, staff or moods", "Pause menu", "Drawer tabs",
                         "Copy the room (and its en-suite)", "\x01 paste  \x04 turn  \x05 \x06 another floor"]
    for k in 0..15 {
        let yy = y + 26 + k * 11
        if k % 2 == 0 { ui_rect(x + 6, yy - 1, w - 12, 11, ST_SLOT, -1) }
        ftext(x + 12, yy, rows[k], ST_TEXT, false)
        ftext(x + 82, yy, what[k], ST_TEXT, false)
    }
}

// ---- staff: hire and fire per role and shift

fn staff_page_update() {
    if rep_in(UP) { st_row = (st_row + NROLES - 1) % NROLES; fx(FX_CLICK) }
    if rep_in(DOWN) { st_row = (st_row + 1) % NROLES; fx(FX_CLICK) }
    if btnp_in(LEFT) || btnp_in(RIGHT) { st_col = 1 - st_col; fx(FX_CLICK) }
    if btnp_in(A) {
        if staff_count() >= 30 {
            fx(FX_ERROR)
        } else if hire(st_row, st_col) >= 0 {
            fx(FX_HIRE)
        }
    }
    if btnp_in(Y) {
        // let one go (one not in the middle of something, if possible)
        var who = -1
        for i in 0..npeople {
            let p = &people[i]
            if p.used != 0 && p.kind as s32 == P_STAFF && p.type as s32 == st_row && p.shift as s32 == st_col {
                who = i
                if p.state as s32 == SS_HOME { break }
            }
        }
        if who >= 0 { fire(who); fx(FX_DEMOLISH) }
    }
    if btnp_in(B) || btnp_in(START) { page = Page.Main; fx(FX_BACK) }
}

fn staff_count() -> s32 {
    var n = 0
    for i in 0..npeople { if people[i].used != 0 && people[i].kind as s32 == P_STAFF { n += 1 } }
    return n
}

fn role_need_note(role: s32) -> *u8 {
    let st = role_station(role)
    if st >= 0 {
        let n = objs_of(st)
        if n == 0 { return "No station built for this role yet" }
    }
    return ""
}

fn draw_staff_page() {
    let x = 24
    let y = 22
    let w = 272
    panel(x, y, w, 196)
    page_head(x, y, w, "Staff")
    ftext(x + 12, y + 26, "Role", ST_TEXT_DIM, false)
    ftext_c(x + 136, y + 26, "Day", ST_TEXT_DIM, false)
    ftext_c(x + 176, y + 26, "Night", ST_TEXT_DIM, false)
    ftext_r(x + w - 12, y + 26, "Wage a day", ST_TEXT_DIM, false)
    for r in 0..NROLES {
        let yy = y + 40 + r * 14
        if r % 2 == 0 { ui_rect(x + 6, yy - 2, w - 12, 14, ST_SLOT, -1) }
        if r == st_row { ui_sel(x + 118 + st_col * 40, yy - 3, 36, 15) }
        ui_rect(x + 10, yy + 1, 5, 5, ROLE_COL[r], -1)
        ftext(x + 20, yy, str_of(ROLE_NAME_OFF[r] as s32), ST_TEXT, false)
        ftext_c(x + 136, yy, num(staff_of(r, 0)), WHITE, false)
        ftext_c(x + 176, yy, num(staff_of(r, 1)), WHITE, false)
        ftext_r(x + w - 12, yy, smoney(nb(), ROLE_WAGE[r] as s32), ST_TEXT_DIM, false)
    }
    let note = role_need_note(st_row)
    ftext(x + 12, y + 168, note, ST_BAD, false)
    ftext(x + 12, y + 180, "\x01 hire   \x04 let go   \x15\x16 shift   \x02 back", ST_TEXT_DIM, false)
}

// ---- prices

fn prices_update() {
    if rep_in(UP) || rep_in(DOWN) { pr_sel = 1 - pr_sel; fx(FX_CLICK) }
    var d = 0
    if rep_in(LEFT) { d = -1 }
    if rep_in(RIGHT) { d = 1 }
    if d != 0 {
        if pr_sel == 0 { price_room = clamp(price_room + d * 5, 20, 400) } else { price_suite = clamp(price_suite + d * 10, 80, 1500) }
        fx(FX_CLICK)
    }
    if btnp_in(B) || btnp_in(A) || btnp_in(START) { page = Page.Main; fx(FX_BACK) }
}

fn draw_prices() {
    let x = 56
    let y = 60
    let w = 208
    panel(x, y, w, 100)
    page_head(x, y, w, "Room prices")
    for k in 0..2 {
        let yy = y + 30 + k * 16
        if k == pr_sel { ui_sel(x + 6, yy - 3, w - 12, 15) }
        if k == 0 { ftext(x + 12, yy, "Guest room", ST_TEXT, false) } else { ftext(x + 12, yy, "Suite", ST_TEXT, false) }
        var v = price_room
        if k == 1 { v = price_suite }
        let b = nb()
        sappend(b, "\x15 ")
        smoney(b, v)
        sappend(b, " \x16 a night")
        ftext_r(x + w - 12, yy, b, ST_GOLD, false)
    }
    ftext(x + 12, y + 68, "Guests pay up to their budget: business", ST_TEXT_DIM, false)
    ftext(x + 12, y + 79, "$110, families $140, couples $320...", ST_TEXT_DIM, false)
}

// ---- the hotel: stars, what the next star needs, the score, reviews

fn draw_hotel_page() {
    let x = 12
    let y = 20
    let w = 296
    panel(x, y, w, 204)
    page_head(x, y, w, "Hotel rating")
    var sx = x + w - 12 - stars * 8
    for i in 0..stars { sx = glyph(sx, y + 8, 15) }
    if stars == 0 { ftext_r(x + w - 12, y + 8, "unrated", DIM, false) }
    // next tier
    let y0 = y + 26
    if stars < 5 {
        let b = nb()
        sappend(b, "Next star: ")
        let ok = tier_ok(stars + 1)
        if ok { sappend(b, "all done, wait for the 6:00 rating!") } else { sappend(b, tier_missing[stars + 1]) }
        ftext(x + 10, y0, b, ST_GOLD, false)
    } else {
        ftext(x + 10, y0, "Five stars! The finest hotel on the coast.", ST_GOLD, false)
    }
    // the score's parts, with their numbers
    let names: [6]*u8 = ["Rooms", "Facilities", "Service", "Cleanliness", "Architecture", "Reviews"]
    for k in 0..6 {
        let bx = x + 10 + (k % 3) * 94
        let by = y0 + 15 + (k / 3) * 22
        ftext(bx, by, names[k], ST_TEXT_DIM, false)
        ftext_r(bx + 86, by, num(score_parts[k]), ST_TEXT, false)
        ui_rect(bx, by + 11, 86, 3, ST_SLOT, -1)
        ui_rect(bx, by + 11, score_parts[k] * 86 / 100, 3, clerp(ST_BAD, ST_OK, fixed(score_parts[k]) / 100), -1)
    }
    let s = nb()
    sappend(s, "Score ")
    sint(s, score)
    sappend(s, "   \x17   Reputation ")
    sint(s, reputation)
    if reviews_n > 0 {
        sappend(s, "   \x17   Reviews ")
        sint(s, reviews_avg10 / 10)
        sappend(s, ".")
        sint(s, reviews_avg10 % 10)
    }
    ftext(x + 10, y0 + 62, s, ST_TEXT, false)
    ui_div(x + 6, y0 + 76, w - 12)
    // the latest reviews
    let ry = y0 + 82
    if reviews_n == 0 { ftext(x + 10, ry, "No reviews yet.", ST_TEXT_DIM, false) }
    for k in 0..min(reviews_n, 5) {
        let rv = &reviews[k]
        let yy = ry + k * 20
        var gx = x + 10
        for st in 0..rv.stars as s32 { gx = glyph(gx, yy, 15) - 1 }
        ftext(x + 52, yy, str_of(REVIEW_OFF[rv.quote as s32] as s32), ST_TEXT, false)
        let who = nb()
        sappend(who, "- ")
        sappend(who, str_of(GT_NAME_OFF[rv.gtype as s32] as s32))
        sappend(who, ", day ")
        sint(who, rv.day as s32)
        ftext(x + 60, yy + 9, who, ST_TEXT_DIM, false)
    }
}

fn draw_ledger() {
    let x = 40
    let y = 22
    let w = 240
    panel(x, y, w, 196)
    page_head(x, y, w, "Ledger")
    ftext_r(x + 160, y + 26, "Today", ST_TEXT_DIM, false)
    ftext_r(x + w - 12, y + 26, "Yesterday", ST_TEXT_DIM, false)
    let names: [10]*u8 = ["Rooms", "Restaurant", "Bar", "Spa", "Other", "Wages", "Upkeep", "Supplies", "Building", "Loan interest"]
    var tt = 0
    var ty = 0
    for k in 0..NLG {
        let yy = y + 40 + k * 12
        if k % 2 == 0 { ui_rect(x + 6, yy - 2, w - 12, 12, ST_SLOT, -1) }
        ftext(x + 12, yy, names[k], ST_TEXT, false)
        var c = ST_OK
        if ledger[k] < 0 { c = ST_BAD }
        if ledger[k] == 0 { c = ST_TEXT_DIM }
        ftext_r(x + 160, yy, smoney(nb(), ledger[k]), c, false)
        var c2 = ST_OK
        if ledger_y[k] < 0 { c2 = ST_BAD }
        if ledger_y[k] == 0 { c2 = ST_TEXT_DIM }
        ftext_r(x + w - 12, yy, smoney(nb(), ledger_y[k]), c2, false)
        tt += ledger[k]
        ty += ledger_y[k]
    }
    ui_div(x + 6, y + 163, w - 12)
    ftext(x + 12, y + 167, "Total", WHITE, false)
    ftext_r(x + 160, y + 167, smoney(nb(), tt), WHITE, false)
    ftext_r(x + w - 12, y + 167, smoney(nb(), ty), WHITE, false)
    let l = nb()
    sappend(l, "Bank loan: ")
    smoney(l, loan)
    sappend(l, " at 6%")
    ftext(x + 12, y + 181, l, ST_TEXT_DIM, false)
}

// ---- the title screen: the demo hotel at dusk behind the logo, slowly drifting

var title_sel: s32
var title_has_save: bool
var title_ready: bool

fn enter_title() {
    new_hotel_state()
    s_demo_hotel(1)
    money = 50000
    rooms_update()
    s_demo_staff()
    stars = 1
    tod = (18 * 60 + 30) * MIN_FRAMES
    view_rot = 2
    view_zoom = 1
    view_floor = 0
    cur_x = 15.0
    cur_z = 12.0
    view_recentre()
    screen = Screen.Title
    screen_t = 0
    title_sel = 0
    title_has_save = save_exists()
    if title_has_save { title_sel = 1 }
    music(Music.Title)
}

fn title_items() -> s32 {
    if title_has_save { return 3 }
    return 2
}

fn title_label(k: s32) -> *u8 {
    if !title_has_save {
        if k == 0 { return "New hotel" }
        return "Open the demo hotel"
    }
    if k == 0 { return "New hotel" }
    if k == 1 { return "Continue" }
    return "Open the demo hotel"
}

fn title_update() {
    // the camera drifts along the hotel
    if screen_t % 5 == 0 {
        pan_x -= 1
        pan_tx = pan_x
    }
    if screen_t % 2300 == 0 && screen_t > 0 { pan_x += 460; pan_tx = pan_x }
    let n = title_items()
    if rep_in(UP) { title_sel = (title_sel + n - 1) % n; fx(FX_CLICK) }
    if rep_in(DOWN) { title_sel = (title_sel + 1) % n; fx(FX_CLICK) }
    if screen_t > 20 && (btnp_in(A) || btnp_in(START)) {
        fx(FX_OK)
        let lab = title_label(title_sel)
        if lab[0] == 'N' {
            new_game()
        } else if lab[0] == 'C' {
            if load_game() {
                start_play()
                say("Welcome back!", GOLD)
                controls_hint()
            } else {
                fx(FX_ERROR)
                say("The save couldn't be read", RED)
                title_has_save = false
                title_sel = 0
            }
        } else {
            demo_game()
        }
    }
}

fn draw_title() {
    // a calm band behind the menu
    ui_rect(0, 160, 320, 80, ST_HUD_BAR, 0)
    let bob = (sin(fixed(screen_t) * 0.03) * 2) as s32
    ui_tex(32, 10 + bob, LOGO_W, LOGO_H, SLOT_UI, PAL_LOGO, LOGO_U, LOGO_V, LOGO_W - 1, LOGO_H - 1, 0x808080, -1)
    let n = title_items()
    let w = 140
    panel(160 - w / 2, 168, w, 10 + n * 14)
    for k in 0..n {
        let y = 174 + k * 14
        var c = ST_TEXT
        if k == title_sel {
            ui_sel(160 - w / 2 + 6, y - 2, w - 12, 13)
            c = WHITE
        }
        ftext_c(160, y, title_label(k), c, false)
    }
    if (screen_t / 40) % 3 != 2 { ftext_c(160, 214, "\x01 start", ST_TEXT_DIM, false) }
    ftext_r(316, 228, "(c) 2001 Mei Hotels Inc.", DIM, false)
}

// A fresh lot by the sea, with a bank loan.
fn new_game() {
    new_hotel_state()
    start_play()
    cur_x = 16.0
    cur_z = 9.0
    view_recentre()
    first_flow = true
    say("Welcome to your lot by the sea!", GOLD)
}

fn demo_game() {
    new_hotel_state()
    s_demo_hotel(1)
    rooms_update()
    s_demo_staff()
    money = 40000
    for k in 0..NLG { ledger[k] = 0 }
    stars = 1
    start_play()
    cur_x = 16.0
    cur_z = 9.0
    view_recentre()
    controls_hint()
}

fn controls_hint() { hint_show("\x03 build   \x01 look closer   \x08 speed   \x07 menu") }

fn start_play() {
    screen = Screen.Play
    screen_t = 0
    tool = Tool.Inspect
    tool_rt = -1
    menu_open = false
    menu_out = 0
    dragging = false
    first_flow = false
    info_close()
    tr_t = 0
    tr_on = false
    drop_t = 0
    overlay = OV_NONE
    watch_ready = false
    for k in 0..200 { room_intent[k] = 255 }
    hud_money = money
    hud_last = money
    hud_delta_t = 0
    speed = 1
    music(Music.Hotel)
    cache_dirty = true
}
