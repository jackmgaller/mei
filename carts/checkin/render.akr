// Rendering: the near-orthographic camera, the static geometry cache and helpers.
import "render_pass.akr"
//
// The camera is far away (CAM_DIST) with a very narrow field of view, so the view is almost
// orthographic. It turns in 90-degree steps and has three zoom levels. Panning does not move
// the camera: it shifts the projection on screen (an off-axis view), which moves every
// projected vertex by the same whole number of pixels.
//
// Static geometry (floors, walls, objects of the visible floors) is baked into world-space
// meshes and drawn with the stdlib mesh() ONCE, into a persistent packet arena; the ordering
// table it produced is kept (cache_ots) and copied back every frame. When the view pans, the
// cached packets are shifted in place. Anything that changes the picture otherwise (an edit,
// rotation, zoom, another floor) sets cache_dirty and the cache is rebuilt, into the other of
// two buffers and a few steps per frame, while the old picture stays up (rebuild_steps).
//
// Depth layers (ordering-table bias, larger = drawn earlier): content of the viewed floor 0,
// its floor surfaces +B_SLAB, each floor below one more +B_FLOOR.
//
// Look ("Calm & clean", POLISH.md section 3): every baked face is textured, flat colours included
// (solid palette cells, look_in / look_out), so the time of day only relights palettes
// (lighting.akr) and never rebuilds the cache. Zoomed out, and on the floors below, floors use the
// quiet low-detail blocks (slot 6). The floors below are ghosted: drawn at 5/8 brightness, then a
// light grey is added over them (draw_lower), a 37% mix toward #C8CCD4.

const CAM_DIST = 300.0
const CAM_PITCH = -0.6109        // -35 degrees
const B_SLAB = 40
const B_FLOOR = 55
const LOW_H = 0.42               // cutaway walls
const FULL_H = 2.75
const WALL_T = 0.09              // half the wall thickness

var view_rot: s32 = 2            // 0..3 (2: the camera stands on the beach side)
var view_zoom: s32 = 1           // 0..2
var view_floor: s32
var pan_x: s32                   // screen offset of the view, pixels
var pan_y: s32
var cam_yaw: fixed
var ppu: fixed                   // screen pixels per world unit at the target
var vis_px: bool                 // faces whose normal is +x are seen by the camera
var vis_pz: bool
var xface_left: bool             // the visible face of constant x is the left one on screen

// The cache is double-buffered and rebuilt a few steps per frame (rebuild_steps): while a new one
// is being built, the previous one stays on screen, so no frame carries a whole rebuild (A13).
var cache_dirty = true
const ARENA_W = 40960            // words per buffer
var cache_arena: [81920]u32      // two packet arenas (buffer k at k * ARENA_W)
var cache_ots: [2][1024]u32      // their ordering tables
var lo_snaps: [2][1024]u32       // and those of the floors below
var c_have: [2]bool              // the buffer holds a finished build
var c_cull: [2]bool              // its packets off the screen are marked (cache_shift)
var c_end: [2]*u32
var c_px: [2]s32                 // pan the buffer was built (or last shifted) for
var c_py: [2]s32
var c_bpx: [2]s32                // pan at its build (zoomed in, objects off screen are left out)
var c_bpy: [2]s32
var c_lo: [2]bool                // it has floors below
var c_rot: [2]s32                // the view it was built for
var c_zoom: [2]s32
var c_floor: [2]s32
var cur: s32                     // the buffer on screen
var cache_end: *u32              // end of the buffer on screen (stats)
var cache_full: bool
var cache_tris: s32              // stats
var cache_cycles: s32            // cycles of the last whole rebuild (all its frames)
var cache_builds: s32            // rebuilds so far (tests)
var night_glow: bool
var cache_lo: bool               // use low-detail meshes (when the full ones were too many triangles)
var build_px: s32                // pan the buffer on screen was built for
var build_py: s32

// The cache is baked for one pan (rb_px/py) and shifted on screen as the view pans, so it holds
// what lies near the screen at that pan: floors, walls and the ground within CULL_S pixels of the
// screen's edge, objects within CULL_O. begin_world rebuilds it once the view has panned DRIFT
// pixels from its pan (zoomed in, objects off screen are many, and so is their margin: rebuilds
// come after short pans; zoomed out, only after long ones). A rebuild takes a few frames (up to
// ~14 on a tall hotel) while the camera glides up to 8 px a frame, so the margins are DRIFT plus
// that. A face that the stdlib has to clip (one crossing the guard band) is dropped when it lies
// beyond the static margin (cull_rect); before, it was dropped when it lay beyond the screen at
// the pan of the build, and then went missing once the view panned to it.
const DRIFT: [3]s32 = [200, 200, 48]
const CULL_S: [3]s32 = [320, 320, 224]
const CULL_O: [3]s32 = [320, 320, 224]

// The pan's velocity (pixels a frame, smoothed): a rebuild for a pan starts early enough, and is
// built for where the view will be when it is done, so the buffer on screen stays within DRIFT
// of its own pan (and well inside its margin) while the camera glides.
var pv_x: fixed
var pv_y: fixed
var pv_lx: s32
var pv_ly: s32
var pv_view: s32 = -1
var lead_x: s32                  // the pan expected when a rebuild started now is done, less now's
var lead_y: s32
var drift_max: s32               // (tests) the furthest the buffer on screen was shifted from its pan

fn pan_track() {
    let v = view_rot | (view_zoom << 2) | (view_floor << 4)
    let dx = pan_x - pv_lx
    let dy = pan_y - pv_ly
    if v != pv_view || abs(dx) > 24 || abs(dy) > 24 {
        // another view or a jump: no glide to follow
        pv_x = 0.0
        pv_y = 0.0
    } else {
        pv_x = (pv_x + fixed(dx)) / 2
        pv_y = (pv_y + fixed(dy)) / 2
    }
    pv_view = v
    pv_lx = pan_x
    pv_ly = pan_y
    // frames a rebuild of this view takes, from what its steps cost last time
    var est = rb_est[14] + rb_est[15]
    for k in 0..7 { est += rb_est[7 + k] + rb_est[k] * view_floor }
    let n = fixed(est / RB_BUDGET + 1)
    let lim = CULL_O[view_zoom] - DRIFT[view_zoom]
    lead_x = clamp((pv_x * n) as s32, -lim, lim)
    lead_y = clamp((pv_y * n) as s32, -lim, lim)
}

const ZOOM_PPU: [3]fixed = [11.3137, 16.9706, 22.6274]

// ---- the camera

fn view_target() -> vec3 { return vec3(16.0, fixed(view_floor) * STOREY + 0.6, 12.0) }

// The view depths kept (near and far plane) and sorted into the ordering table. Panning does not
// move the camera, so the screen can show ground well nearer or farther than the target: the
// range is centred on the depth at the middle of the screen the shown cache was built for
// (clip_py: its pan; one pixel of pan is 1/tan 35° / ppu units of depth), and spans the screen
// plus the most it drifts before a rebuild (DRIFT, with some slack), wall tops (nearer), and the
// floors below seen through atriums (farther, about 5.2 units a storey). Zoomed in it is the
// fixed 25/50 it always was (13.65 buckets a unit); zoomed out it is wider. With a fixed range
// centred on the target, the near plane cut the ground off at the bottom of the screen (sky in a
// straight line) whenever the cursor was near the lot's near corner, at zoom 0 and 1 especially.
const CLIP_N: [3]fixed = [48.0, 34.0, 25.0]
const CLIP_F: [3]fixed = [70.0, 54.0, 50.0]
var clip_py: s32

// The pan the depth range is centred on: the build pan of the cache on screen.
fn shown_py() -> s32 {
    if c_have[cur] { return c_bpy[cur] }
    return pan_y
}

// Sets the stdlib camera for the current rotation, zoom, floor and pan.
fn set_camera() {
    cam_yaw = 0.7854 + fixed(view_rot) * 1.5708
    ppu = ZOOM_PPU[view_zoom]
    // vertical fov from pixels per unit: x_screen = 160 * fx * x / D
    __fx = ppu * (CAM_DIST / 160)
    __fy = __fx * 1.3333
    let sy = sin(cam_yaw)
    let cy = cos(cam_yaw)
    let sp = sin(CAM_PITCH)
    let cp = cos(CAM_PITCH)
    let fwd = vec3(sy * cp, sp, cy * cp)
    let pos = view_target() - fwd * CAM_DIST
    let dc = fixed(clip_py) * (1.4281 / ppu)
    camera_clip(CAM_DIST + dc - CLIP_N[view_zoom], CAM_DIST + dc + CLIP_F[view_zoom])
    camera_look(pos, cam_yaw, CAM_PITCH)
    vis_px = sy < 0.0
    vis_pz = cy < 0.0
    // which visible side face is on the screen's left (the light comes from the upper left)
    var nx = -cy
    if vis_px { nx = cy }
    xface_left = nx < 0.0
    // pan: shift the screen by whole pixels (x' = x + px/160 * w, y' = y - py/120 * w)
    let kx = fixed(pan_x) / 160
    let ky = fixed(pan_y) / 120
    __vp[0] = __vp[0] + __vp[3] * kx
    __vp[1] = __vp[1] - __vp[3] * ky
}

// Projects a world point: proj_x, proj_y (pixels), proj_w (view depth). False when behind.
var proj_x: s32
var proj_y: s32
var proj_w: fixed

fn project(p: vec3) -> bool {
    let v = vec4(p, 1.0)
    let w = dot(__vp[3], v)
    proj_w = w
    if w < 1.0 { return false }
    let x = dot(__vp[0], v)
    let y = dot(__vp[1], v)
    // (divide first: x * 160 overflows the fixed-point range for points ~110 px off centre)
    proj_x = 160 + ((x / w) * 160) as s32
    proj_y = 120 - ((y / w) * 120) as s32
    return true
}

// Ordering-table bucket of a view depth (as the stdlib computes it for a face).
fn depth_bucket(w: fixed) -> s32 {
    return clamp(((w - __cam_near) * (1024.0 / (__cam_far - __cam_near))) as s32, 0, 1023)
}

// ---- the mesh builder: world-space faces are batched into one RAM mesh and drawn with mesh()

struct BMesh {
    hdr: Mesh
    v: [2048]vec4
    f: [1600]Face
}

var bm: BMesh
var bm_nv: s32
var bm_nf: s32
var bm_bias: s32

fn mb_init() {
    bm.hdr.verts = 16
    bm.hdr.faces = 16 + 2048 * 16
}

fn mb_flush() {
    if bm_nf > 0 {
        bm.hdr.nverts = bm_nv as u16
        bm.hdr.nfaces = bm_nf as u16
        depth_bias(bm_bias)
        mesh(&bm.hdr)
        depth_bias(0)
    }
    bm_nv = 0
    bm_nf = 0
}

// ---- sorting (round R). There is no depth buffer: the ordering table sorts what is drawn, by
// default (the stdlib) each face by its own average view depth. Seen from above at 35 degrees,
// height reads as nearness, so per-face sorting put a tall wall's middle in front of the wardrobe
// standing against it, a long wall's middle in front of (or behind) the chair at its end, a
// fountain's rim over the planter in front of it. The camera is grid-aligned and turns in
// 90-degree steps, so the painter's order is known instead: things are drawn by where they stand
// on the floor along the view direction, each as a unit with one ordering-table key:
// - the floor of the viewed floor and the ground around it in the farthest bucket (LAYER_FLOOR),
//   what lies flat on it (door thresholds, the curb) in the next (LAYER_FLAT);
// - a piece of wall, railing or facade at the bucket of the middle of its base (the tile edge it
//   stands on, so it sorts between the tiles on either side), its faces in a fixed order (stdlib
//   FACE_KEYED: mb_key). Runs of them are cut every RUN_LEN tiles (one tile zoomed in);
// - an object at the view depth of the middle of its footprint on the floor, its own faces kept
//   in order but squeezed around that (stdlib depth_key) to within OBJ_BAND buckets: tiles lie
//   7.9 buckets apart along the view zoomed in (5 at zoom 0), so neighbours never interleave;
// - people (people_draw.akr) at their feet, pulled a little toward the camera.
// The floors below the viewed one keep their layers by bias (B_SLAB, B_FLOOR) in their own
// ordering table, with the same keys inside each.
const OBJ_BAND = 3
const LAYER_FLOOR = 1023
const LAYER_FLAT = 1022

// The view depth of a point (on the floor, for a sort key).
fn view_w(x: fixed, y: fixed, z: fixed) -> fixed { return dot(__vp[3], vec4(x, y, z, 1.0)) }

// The faces made next go into ordering-table bucket mb_key (-1: each by its own depth). Within a
// bucket the faces made later are drawn first.
var mb_key: s32 = -1
fn key_at(x: fixed, y: fixed, z: fixed) { mb_key = depth_bucket_of(view_w(x, y, z)) }

// The batch holds one object: sorted at the middle of its footprint on the floor (c), squeezed so
// that its faces stay within OBJ_BAND buckets of that (r: the radius around its mesh).
fn mb_flush_object(c: vec3, r: fixed) {
    if bm_nf == 0 { return }
    let spread = r * 0.82 * (1024.0 / (__cam_far - __cam_near))     // its own depths, buckets each way
    depth_key(view_w(c.x, c.y, c.z), max(1, (spread / OBJ_BAND) as s32 + 1))
    mb_flush()
    depth_key_off()
}

fn mb_set_bias(b: s32) {
    if b != bm_bias {
        mb_flush()
        bm_bias = b
    }
}

// Makes room for nv vertices and nf faces.
fn mb_need(nv: s32, nf: s32) {
    if bm_nv + nv > 2048 || bm_nf + nf > 1600 { mb_flush() }
}

fn mb_v(x: fixed, y: fixed, z: fixed) -> s32 {
    let i = bm_nv
    bm.v[i] = vec4(x, y, z, 1.0)
    bm_nv = i + 1
    return i
}

// A face (quad when i3 >= 0). look: flags | tex << 8 | pal << 16 (see surf_*); uv: 4 packed u|v<<8.
var mb_uv: [4]u16
var mb_flags: s32                // FACE_* bits of the next faces
var mb_tex: s32                  // texture byte (slot | 0x10 for 4-bit)
var mb_pal: s32
var mb_blend: s32

fn mb_face(i0: s32, i1: s32, i2: s32, i3: s32, c: u32) {
    if mb_cull && mb_outside(i0, i1, i2, i3) {
        // wholly beyond one side of the cache's margin: dropped, with its corners when they
        // were the last ones added (as mb_hquad and friends do)
        if i3 >= 0 && i0 == bm_nv - 4 && i3 == bm_nv - 1 { bm_nv = i0 }
        else if i3 < 0 && i0 == bm_nv - 3 && i2 == bm_nv - 1 { bm_nv = i0 }
        return
    }
    var col = c
    if mb_ghost { col = ghost_col(col) }
    // the 36-byte Face written as nine words (flags, blend, tex, palette | indices | colours | uvs)
    let w = (&bm.f[bm_nf]) as *u32
    bm_nf += 1
    var fl = (mb_flags | FACE_DOUBLE) as u32
    var i3w = i3
    if i3 >= 0 { fl = fl | FACE_QUAD } else { i3w = 0 }
    var c3 = col
    if mb_key >= 0 {
        fl = fl | FACE_KEYED
        c3 = mb_key as u32
    }
    w[0] = fl | ((mb_blend as u32) << 8) | ((mb_tex as u32) << 16) | ((mb_pal as u32) << 24)
    w[1] = (i0 as u32) | ((i1 as u32) << 16)
    w[2] = (i2 as u32) | ((i3w as u32) << 16)
    w[3] = col
    w[4] = col
    w[5] = col
    w[6] = c3
    w[7] = (mb_uv[0] as u32) | ((mb_uv[1] as u32) << 16)
    w[8] = (mb_uv[2] as u32) | ((mb_uv[3] as u32) << 16)
}

// ---- culling to the cache's margin (only while the cache is built: mb_cull). cl_p are the four
// edges of the margin rectangle as planes in world space (a point is beyond one when its dot
// product with it is negative), from the build's camera.
var mb_cull: bool
var cl_p: [4]vec4
var cl_s: [4]vec4                // the screen's own edges (no margin), for sphere_outside
var cl_t: fixed                  // 1 / CULL_S of the zoom (see sphere_outside)

fn cull_setup() {
    cull_rect(0, 0, 320, 240)
    cl_s[0] = __vp[0] - __vp[3] * __scr_k[0]
    cl_s[1] = __vp[3] * __scr_k[1] - __vp[0]
    cl_s[2] = __vp[3] * __scr_k[2] - __vp[1]
    cl_s[3] = __vp[1] - __vp[3] * __scr_k[3]
    let m = CULL_S[view_zoom]
    cl_t = 1.0 / fixed(m)
    cull_rect(-m, -m, 320 + m, 240 + m)
    cl_p[0] = __vp[0] - __vp[3] * __scr_k[0]
    cl_p[1] = __vp[3] * __scr_k[1] - __vp[0]
    cl_p[2] = __vp[3] * __scr_k[2] - __vp[1]
    cl_p[3] = __vp[1] - __vp[3] * __scr_k[3]
}

fn cull_outcode(v: vec4) -> s32 {
    var o = 0
    if dot(cl_p[0], v) < 0.0 { o = 1 }
    if dot(cl_p[1], v) < 0.0 { o = o | 2 }
    if dot(cl_p[2], v) < 0.0 { o = o | 4 }
    if dot(cl_p[3], v) < 0.0 { o = o | 8 }
    return o
}

fn mb_outside(i0: s32, i1: s32, i2: s32, i3: s32) -> bool {
    var o = cull_outcode(bm.v[i0])
    if o == 0 { return false }
    o = o & cull_outcode(bm.v[i1])
    if o == 0 { return false }
    o = o & cull_outcode(bm.v[i2])
    if o == 0 || i3 < 0 { return o != 0 }
    return o & cull_outcode(bm.v[i3]) != 0
}

// Is a sphere (centre c, radius r in world units) wholly more than m pixels beyond one side of
// the screen (m: 0 up to the margin CULL_S), in the build's camera?
fn sphere_outside(c: vec3, r: fixed, m: s32) -> bool {
    let v = vec4(c, 1.0)
    let t = fixed(m) * cl_t
    for k in 0..4 {
        // the plane m pixels out, between the screen's edge and the margin's (both are linear
        // in clip space); it is not unit length: scale r by its gain
        let p = cl_s[k] + (cl_p[k] - cl_s[k]) * t
        let g = abs(p.x) + abs(p.y) + abs(p.z)
        if dot(p, v) < -(g * r) { return true }
    }
    return false
}

// The floors below are drawn at 5/8 of their colour (then lightened, see draw_lower).
var mb_ghost: bool
fn ghost_col(c: u32) -> u32 { return ((c >> 1) & 0x7F7F7F) + ((c >> 3) & 0x1F1F1F) }

// A flat colour through a solid palette cell (slot 6): index idx of palette pal. The face colour
// (mb_face's col) is the tint: TINT keeps the colour, shade(TINT, k) darkens a side.
fn look_solid(pal: s32, idx: s32) {
    mb_flags = FACE_TEXTURED
    mb_tex = ART_SOLID_SLOT | 0x10
    mb_pal = pal
    let uv = (ART_SOLID_U + idx * 8 + 2) | ((ART_SOLID_V + 2) << 8)
    mb_uv[0] = uv as u16
    mb_uv[1] = (uv + 3) as u16
    mb_uv[2] = (uv + 0x300) as u16
    mb_uv[3] = (uv + 0x303) as u16
}
fn look_in(idx: s32) { look_solid(ART_PAL_FLAT_IN, idx) }      // lit like the interior
fn look_out(idx: s32) { look_solid(ART_PAL_FLAT_OUT, idx) }    // lit by the sky

// Flat untextured look.
fn look_flat() {
    mb_flags = 0
    mb_tex = 0
    mb_pal = 0
}

// Textured look from the surface atlas.
fn look_tex(pal: s32) {
    mb_flags = FACE_TEXTURED
    mb_tex = SURF_SLOT | 0x10
    mb_pal = pal
}

fn uvp(u: s32, v: s32) -> u16 { return (min(u, 255) | (min(v, 255) << 8)) as u16 }

// Texture rectangle for the next vertical quads (corners: bottom-left, bottom-right, top-left,
// top-right).
fn uv_vert(u: s32, v: s32, w: s32, h: s32) {
    mb_uv[0] = uvp(u, v + h)
    mb_uv[1] = uvp(u + w, v + h)
    mb_uv[2] = uvp(u, v)
    mb_uv[3] = uvp(u + w, v)
}

// ... for horizontal quads (corners: x0z0, x1z0, x0z1, x1z1).
fn uv_horiz(u: s32, v: s32, w: s32, h: s32) {
    mb_uv[0] = uvp(u, v)
    mb_uv[1] = uvp(u + w, v)
    mb_uv[2] = uvp(u, v + h)
    mb_uv[3] = uvp(u + w, v + h)
}

const TINT = 0x808080

// A horizontal quad (x0, z0)-(x1, z1) at height y.
fn mb_hquad(x0: fixed, z0: fixed, x1: fixed, z1: fixed, y: fixed, col: u32) {
    mb_need(4, 1)
    let i = bm_nv
    bm.v[i] = vec4(x0, y, z0, 1.0)
    bm.v[i + 1] = vec4(x1, y, z0, 1.0)
    bm.v[i + 2] = vec4(x0, y, z1, 1.0)
    bm.v[i + 3] = vec4(x1, y, z1, 1.0)
    bm_nv = i + 4
    mb_face(i, i + 1, i + 2, i + 3, col)
}

// A vertical quad along x (constant z) from x0 to x1, y0 to y1.
fn mb_vquad_x(x0: fixed, x1: fixed, z: fixed, y0: fixed, y1: fixed, col: u32) {
    mb_need(4, 1)
    let i = bm_nv
    bm.v[i] = vec4(x0, y0, z, 1.0)
    bm.v[i + 1] = vec4(x1, y0, z, 1.0)
    bm.v[i + 2] = vec4(x0, y1, z, 1.0)
    bm.v[i + 3] = vec4(x1, y1, z, 1.0)
    bm_nv = i + 4
    mb_face(i, i + 1, i + 2, i + 3, col)
}

// A vertical quad along z (constant x).
fn mb_vquad_z(x: fixed, z0: fixed, z1: fixed, y0: fixed, y1: fixed, col: u32) {
    mb_need(4, 1)
    let i = bm_nv
    bm.v[i] = vec4(x, y0, z0, 1.0)
    bm.v[i + 1] = vec4(x, y0, z1, 1.0)
    bm.v[i + 2] = vec4(x, y1, z0, 1.0)
    bm.v[i + 3] = vec4(x, y1, z1, 1.0)
    bm_nv = i + 4
    mb_face(i, i + 1, i + 2, i + 3, col)
}

// The three camera-facing faces of a box (top and two sides), shaded.
fn mb_box(x0: fixed, y0: fixed, z0: fixed, x1: fixed, y1: fixed, z1: fixed, col: u32) {
    look_flat()
    mb_hquad(x0, z0, x1, z1, y1, col)
    var sx = x0
    if vis_px { sx = x1 }
    var sz = z0
    if vis_pz { sz = z1 }
    mb_vquad_z(sx, z0, z1, y0, y1, shade(col, 200))
    mb_vquad_x(x0, x1, sz, y0, y1, shade(col, 168))
}

fn shade(c: u32, k: s32) -> u32 {
    let r = ((c & 255) as s32 * k) >> 8
    let g = (((c >> 8) & 255) as s32 * k) >> 8
    let b = (((c >> 16) & 255) as s32 * k) >> 8
    return rgb(r, g, b)
}

fn mix_col(a: u32, b: u32, t: s32) -> u32 { return clerp(a, b, fixed(t) / 256) }

// Tints of the two visible side faces of a box (lit from the upper left of the screen): faces of
// constant x (mb_vquad_z) and of constant z (mb_vquad_x).
const SIDE_LIT = 0x767676         // the left side
const SIDE_DIM = 0x606060         // the right side
fn tint_xface() -> u32 { if xface_left { return SIDE_LIT } return SIDE_DIM }
fn tint_zface() -> u32 { if xface_left { return SIDE_DIM } return SIDE_LIT }

// ---- the static cache

// ---- per-rebuild tables, so the scans below stay small (A13). The tile arrays (tfloor, tflag,
// troom: world.akr) are read four tiles at a time as words where that helps, as rooms.akr's
// floor_hash() does.
// What of the floors below the viewed one can be seen (compute_exposure): ex_m[g][z], bit x, is
// set when tile (x, z) of floor g < view_floor may show. The camera looks down at 35 degrees, so
// a floor slab above does not hide the tile straight below its own footprint but the one about
// 3 tiles further from the camera per storey: under the front edge of an overhanging floor (a
// gallery over the lobby, a balcony over the restaurant, the atrium seen at an angle) the floor
// below shows. A tile is hidden when the slab of one floor above covers the whole of its line
// of sight.
var ex_m: [6][24]u32
var ex_t: [6][24]u32             // the same seen from TALL_Y above the floor: tall objects' tops
const TALL_Y = 2.0               // (an object is drawn when its top reaches 1.5 and this shows)
var sol_m: [6][24]u32            // per floor: bit x, tile (x, z) has a solid floor (no void, no hole)
var rcls: [200]u8                // per room: RC_* bits
const RC_INDOOR = 1
const RC_CORR = 2                // a corridor (no wall between two of them)
var fl_x0: [6]s32                // per floor: the box around every room (x1 < x0: none); below the
var fl_x1: [6]s32                // viewed floor, only where it shows
var fl_z0: [6]s32
var fl_z1: [6]s32
var fl_void: [6]bool             // the floor has void tiles (railings)
var in_x0: [6]s32                // per floor: the box around the indoor rooms (walls, facades)
var in_x1: [6]s32
var in_z0: [6]s32
var in_z1: [6]s32
var fa_x0: [6]s32                // per floor: the indoor box before the floors above hide part of it
var fa_x1: [6]s32                // (facades: a covered tile can face an open one)
var fa_z0: [6]s32
var fa_z1: [6]s32
var vd_x0: [6]s32                // per floor: the box around the rooms with voids (railings)
var vd_x1: [6]s32
var vd_z0: [6]s32
var vd_z1: [6]s32
var ob_head: [6]s32              // per floor: the first object standing on it (-1: none) ...
var ob_next: [1200]s16           // ... and the next one on the same floor
var lifts: [16]s16               // elevator shafts (drawn on every floor they pass)
var nlifts: s32

const B01 = 0x01010101
const B7F = 0x7F7F7F7F
const B80 = 0x80808080
// Bit 7 of each byte of the result is set where that byte of w is not zero.
fn nzb(w: u32) -> u32 { return (((w & B7F) + B7F) | w) & B80 }
// ... where that byte of top-solid word t is <= g (the tile of floor g shows).
// The byte mask (as nzb) of the tiles of word k of row z of floor g that may show.
fn exw(g: s32, z: s32, k: s32) -> u32 {
    if g >= view_floor { return B80 }
    let b = ex_m[g][z] >> ((k * 4) as u32)
    return ((b & 1) << 7) | ((b & 2) << 14) | ((b & 4) << 21) | ((b & 8) << 28)
}
// The four bits (one per byte, low byte first) of a byte-mask word.
fn bits4(m: u32) -> u32 { return ((m >> 7) & 1) | ((m >> 14) & 2) | ((m >> 21) & 4) | ((m >> 28) & 8) }

fn box_reset(g: s32) {
    fl_x0[g] = GW
    fl_x1[g] = -1
    fl_z0[g] = GH
    fl_z1[g] = -1
    in_x0[g] = GW
    in_x1[g] = -1
    in_z0[g] = GH
    in_z1[g] = -1
    vd_x0[g] = GW
    vd_x1[g] = -1
    vd_z0[g] = GH
    vd_z1[g] = -1
    fl_void[g] = false
}

fn compute_tables() {
    for g in 0..NFL { box_reset(g) }
    // the rooms (their boxes are kept by rooms.akr's measure_floor())
    for r in 0..nrooms {
        var c = 0
        let rm = &rooms[r]
        if r > 0 && rm.used != 0 && rm.ntiles > 0 {
            let g = rm.floor as s32
            let x0 = rm.x0 as s32
            let x1 = rm.x1 as s32
            let z0 = rm.z0 as s32
            let z1 = rm.z1 as s32
            fl_x0[g] = min(fl_x0[g], x0)
            fl_x1[g] = max(fl_x1[g], x1)
            fl_z0[g] = min(fl_z0[g], z0)
            fl_z1[g] = max(fl_z1[g], z1)
            let k = rm.kind as s32
            if kind_indoor(k) {
                c = RC_INDOOR
                if kind_corr(k) { c = c | RC_CORR }
                in_x0[g] = min(in_x0[g], x0)
                in_x1[g] = max(in_x1[g], x1)
                in_z0[g] = min(in_z0[g], z0)
                in_z1[g] = max(in_z1[g], z1)
            }
            if rm.nvoid > 0 {
                fl_void[g] = true
                vd_x0[g] = min(vd_x0[g], x0)
                vd_x1[g] = max(vd_x1[g], x1)
                vd_z0[g] = min(vd_z0[g], z0)
                vd_z1[g] = max(vd_z1[g], z1)
            }
        }
        rcls[r] = c as u8
    }
    if rooms_dirty {
        // (never at draw time: update() measures the rooms first) the whole lot, to be safe
        for g in 0..NFL {
            fl_x0[g] = 0; fl_x1[g] = GW - 1; fl_z0[g] = 0; fl_z1[g] = GH - 1
            in_x0[g] = 0; in_x1[g] = GW - 1; in_z0[g] = 0; in_z1[g] = GH - 1
            vd_x0[g] = 0; vd_x1[g] = GW - 1; vd_z0[g] = 0; vd_z1[g] = GH - 1
            fl_void[g] = true
        }
    }
    // objects by floor (a list per floor, one pass); elevator shafts apart
    for g in 0..NFL { ob_head[g] = -1 }
    nlifts = 0
    let o0 = &objs[0]
    for i in 0..nobjs {
        let o = o0 + i
        if o.used == 0 { continue }
        let t = o.t as s32
        if t == OB_ELEVATOR || t == OB_GLASS_ELEVATOR {
            if nlifts < 16 { lifts[nlifts] = i as s16; nlifts += 1 }
            continue
        }
        let f = o.f as s32
        ob_next[i] = ob_head[f] as s16
        ob_head[f] = i
    }
}

fn compute_top_solid() { compute_exposure() }

// The line of sight from a tile toward the camera rises 0.99 units for each tile it moves along x
// and z (tan 35 deg x sqrt 2): it passes a storey (3.0) every 3.03 tiles, and the 2.75 walls of
// its own storey within 2.78.
const SIGHT_RISE = 0.99031
const WALL_TOP = 2.75

// Shifts a row of tile bits: bit x of the result is bit x + d of r (0 beyond the lot).
fn row_at(r: u32, d: s32) -> u32 {
    if d >= 32 || d <= -32 { return 0 }
    if d >= 0 { return r >> (d as u32) }
    return r << ((-d) as u32)
}

var in_mm: [6][24]u32            // per floor: bit x, tile (x, z) is indoors

// Which tiles of the floors below may show (ex_m). The line of sight from the centre of a tile
// is followed in whole-tile steps up to the viewed floor: it is stopped by the slab of a floor
// above where that floor is solid, and by the outside walls of a floor below (full-height
// facades) where it leaves that floor's rooms below the top of their walls (walls it enters a
// room through face away from the camera and are not drawn). The visible tiles are grown by one
// tile all round, for the rays from their corners.
fn compute_exposure() {
    let f = view_floor
    let tfw = (&tfloor[0]) as *u32
    let tgw = (&tflag[0]) as *u32
    // solid floors of the floors above the ground, and indoor tiles of the floors below (within
    // the boxes around their rooms)
    for h in 0..f + 1 {
        for z in 0..GH { sol_m[h][z] = 0; in_mm[h][z] = 0 }
        if fl_x1[h] < fl_x0[h] { continue }
        let k0 = fl_x0[h] >> 2
        let k1 = fl_x1[h] >> 2
        for z in fl_z0[h]..fl_z1[h] + 1 {
            var m: u32 = 0
            let i = h * 192 + z * 8
            for k in k0..k1 + 1 {
                let w = nzb(tfw[i + k]) & ~nzb(tgw[i + k] & 0x05050505)
                if w != 0 { m = m | (bits4(w) << ((k * 4) as u32)) }
            }
            sol_m[h][z] = m
        }
        if in_x1[h] < in_x0[h] { continue }
        let base = h * NT
        for z in in_z0[h]..in_z1[h] + 1 {
            var m: u32 = 0
            var t = base + z * GW + in_x0[h]
            var bit = (1 as u32) << (in_x0[h] as u32)
            for x in in_x0[h]..in_x1[h] + 1 {
                if rcls[troom[t] as s32] & RC_INDOOR != 0 { m = m | bit }
                t += 1
                bit = bit << 1
            }
            in_mm[h][z] = m
        }
    }
    for g in 0..NFL {
        fa_x0[g] = in_x0[g]
        fa_x1[g] = in_x1[g]
        fa_z0[g] = in_z0[g]
        fa_z1[g] = in_z1[g]
    }
}

// The tiles of floor g (below the viewed floor) seen along the line of sight from a point y0
// above their middle (out: a row of bits per z): the line is followed in whole-tile steps up to
// the viewed floor, stopped by a slab above where it crosses that floor solid, and by an outside
// wall where it leaves the rooms of its storey below the top of their walls; the result is
// grown by a tile all round (indoors from indoors, outdoors from outdoors: a facade stands
// between the two).
fn sight_mask(g: s32, y0: fixed, out: *u32) {
    let f = view_floor
    var sx = -1
    if vis_px { sx = 1 }
    var sz = -1
    if vis_pz { sz = 1 }
    var blk: [24]u32
    var pin: [24]u32
    for z in 0..GH {
        blk[z] = 0
        pin[z] = in_mm[g][z]
    }
    let n = f - g
    let top = fixed(3 * n)
    // walls: step k tiles along the line of sight (to just below the viewed floor's slab)
    var r_prev = 0
    var k = 1
    while y0 + fixed(k) * SIGHT_RISE < top {
        let dy = y0 + fixed(k) * SIGHT_RISE
        let r = (dy / STOREY) as s32
        // (a wall between the tiles of steps k - 1 and k is crossed half-way)
        let wall = r == r_prev && dy - SIGHT_RISE / 2 - fixed(r) * STOREY < WALL_TOP
        r_prev = r
        let rows = &in_mm[g + r][0]
        let d = k * sx
        let dz = k * sz
        for z in 0..GH {
            let zz = z + dz
            var c: u32 = 0
            if zz >= 0 && zz < GH && d < 32 && d > -32 {
                if d >= 0 { c = rows[zz] >> (d as u32) } else { c = rows[zz] << ((-d) as u32) }
            }
            if wall { blk[z] = blk[z] | (pin[z] & ~c) }
            pin[z] = c
        }
        k += 1
    }
    // slabs: floor h is crossed (3 (h - g) - y0) / SIGHT_RISE tiles on
    for h in g + 1..f + 1 {
        let o = ((fixed(3 * (h - g)) - y0) / SIGHT_RISE + 0.5) as s32
        for z in 0..GH {
            let zz = z + o * sz
            if zz >= 0 && zz < GH { blk[z] = blk[z] | row_at(sol_m[h][zz], o * sx) }
        }
    }
    var vin: [24]u32
    for z in 0..GH {
        let i = in_mm[g][z]
        let v = ~blk[z]
        let a = v & i
        let b = v & ~i
        vin[z] = a | (a << 1) | (a >> 1)
        pin[z] = b | (b << 1) | (b >> 1)
    }
    for z in 0..GH {
        var a = vin[z]
        var b = pin[z]
        if z > 0 { a = a | vin[z - 1]; b = b | pin[z - 1] }
        if z + 1 < GH { a = a | vin[z + 1]; b = b | pin[z + 1] }
        let i = in_mm[g][z]
        out[z] = (a & i) | (b & ~i)
    }
}

// The floor below g's share of compute_exposure (at the start of its build, a step of its own
// size): which of its tiles may show, and its boxes shrunk to them.
fn expose_floor(g: s32) {
    sight_mask(g, 0.0, &ex_m[g][0])
    sight_mask(g, TALL_Y, &ex_t[g][0])
    // its boxes shrink to what shows
    let tfw = (&tfloor[0]) as *u32
    if fl_x1[g] < fl_x0[g] { return }
    var cols: u32 = 0
    var z0 = GH
    var z1 = -1
    for z in fl_z0[g]..fl_z1[g] + 1 {
        var fk: u32 = 0
        let i = g * 192 + z * 8
        for k in 0..8 {
            let w = nzb(tfw[i + k])
            if w != 0 { fk = fk | (bits4(w) << ((k * 4) as u32)) }
        }
        let e = (ex_m[g][z] | ex_t[g][z]) & fk
        if e != 0 {
            cols = cols | e
            if z < z0 { z0 = z }
            z1 = z
        }
    }
    var x0 = GW
    var x1 = -1
    for x in 0..GW {
        if (cols >> (x as u32)) & 1 != 0 {
            if x < x0 { x0 = x }
            x1 = x
        }
    }
    // one tile more: a hidden tile's wall or facade can face a visible one
    if x1 >= x0 {
        x0 = max(x0 - 1, fl_x0[g])
        x1 = min(x1 + 1, fl_x1[g])
        z0 = max(z0 - 1, fl_z0[g])
        z1 = min(z1 + 1, fl_z1[g])
    }
    fl_x0[g] = x0
    fl_x1[g] = x1
    fl_z0[g] = z0
    fl_z1[g] = z1
    in_x0[g] = max(in_x0[g], x0)
    in_x1[g] = min(in_x1[g], x1)
    in_z0[g] = max(in_z0[g], z0)
    in_z1[g] = min(in_z1[g], z1)
    vd_x0[g] = max(vd_x0[g], x0)
    vd_x1[g] = min(vd_x1[g], x1)
    vd_z0[g] = max(vd_z0[g], z0)
    vd_z1[g] = min(vd_z1[g], z1)
}

// May floor g's content at (x, z) show when viewing view_floor (see ex_m)?
fn exposed(g: s32, x: s32, z: s32) -> bool {
    if !in_lot(x, z) { return g == 0 }
    if g >= view_floor { return true }
    return (ex_m[g][z] >> (x as u32)) & 1 != 0
}

// The same for something at least 1.5 tall, which shows over a slab's front edge sooner.
fn exposed_tall(g: s32, x: s32, z: s32) -> bool {
    if !in_lot(x, z) { return g == 0 }
    if g >= view_floor { return true }
    return ((ex_m[g][z] | ex_t[g][z]) >> (x as u32)) & 1 != 0
}

var lo_ot: [1024]u32             // the floors below the viewed one: drawn first, then faded
var have_lo: bool                // the buffer on screen has floors below
var no_haze: bool

// A cycle clock that keeps counting across overrun frames (FRAME counts every 500,000-cycle
// budget, presented or not), so cache_cycles is the true cost of a rebuild.
fn cycles_now() -> s32 { return (FRAME as s32) * 500000 - CYCLES as s32 }

// ---- the rebuild, in steps: the tables; for each floor below, then the viewed one: its floor
// surfaces, walls, objects (and facades below); between the two, the ground around and the lower
// floors' own ordering table. Steps run while the frame's share (RB_BUDGET) allows, judging each
// by what that kind of step cost last time (at least one step per frame); the rest wait for the
// next frames, with the old picture still up.
const RB_BUDGET = 100000
var rb_step: s32 = -1            // -1: no build in progress; else 0 tables, 1 floor phases, 2 done
var rb_g: s32                    // the floor being built
var rb_ph: s32                   // its phase: 0, 1 surfaces (two halves), 2, 3 walls (along z, x),
                                 // 4 objects, 5 facades (floors below), 6 the ground around
var rb_buf: s32                  // the buffer being built
var rb_ptr: *u32                 // its arena cursor between frames
var rb_ot: [1024]u32             // its ordering table between frames
var rb_work: s32                 // cycles it took so far (cache_cycles)
var rb_frame: s32                // cycles the rebuild took in the last frame it ran (tests)
var rb_obj: s32                  // the next object of the floor's list (-2: start, -1: the lifts)
var rb_sub: s32                  // the part of the walls (phases 2, 3)
const OBJ_CHUNK = 45000          // cycles of objects per step (their mesh() comes on top)

// Bakes the objects of floor g from rb_obj on, for about OBJ_CHUNK cycles. True when all are done.
fn objects_chunk(g: s32) -> bool {
    let t0 = cycles_now()
    if rb_obj == -2 { rb_obj = ob_head[g] }
    while rb_obj >= 0 {
        build_object(rb_obj, g)
        rb_obj = ob_next[rb_obj] as s32
        if rb_obj >= 0 && cycles_now() - t0 > OBJ_CHUNK { return false }
    }
    for k in 0..nlifts {
        let i = lifts[k] as s32
        let o = &objs[i]
        if g >= o.f as s32 && g <= o.f1 as s32 { build_object(i, g) }
    }
    rb_obj = -2
    return true
}
var rb_px: s32                   // pan it is built for
var rb_py: s32
var rb_est: [16]s32 = [80000, 80000, 80000, 80000, 80000, 80000, 80000, 80000, 80000, 80000, 80000, 80000,
    80000, 80000, 80000, 80000]  // what each kind of step costs (7 phases, below / viewed; tables)
const RB_TRACE = false

// A rebuild only because the view panned (same rotation and floor, nothing edited since the last
// build's tables) keeps those tables and the floors' exposure (rb_same).
var tables_stale = true
var tables_view: s32 = -1
var rb_same: bool

fn rebuild_start() {
    cache_dirty = false
    rb_obj = -2
    rb_sub = 0
    rb_step = 0
    let tv = view_rot | (view_floor << 2)
    rb_same = !tables_stale && tables_view == tv
    if rb_same { rb_step = 1 }
    tables_stale = false
    tables_view = tv
    rb_g = 0
    rb_ph = 0
    rb_buf = 1 - cur
    if !c_have[cur] { rb_buf = cur }
    rb_ptr = &cache_arena[rb_buf * ARENA_W]
    rb_px = pan_x + lead_x
    rb_py = pan_y + lead_y
    rb_work = 0
    // an empty table whose entries link to __ot's own (the packets' chains must end there)
    __ot_reset(&__ot[0])
    memcpy(&rb_ot[0] as *u8, &__ot[0] as *u8, 4096)
}

// True once the cache shows the current view (rotation, zoom, floor, pan). While a rebuild runs
// (a few to ~15 frames) the previous view is still on screen in its own camera; a transition
// that hides the switch should hold until this is true.
fn view_ready() -> bool { return rb_step < 0 && !cache_dirty }

// The kind of the next step (an index into rb_est).
fn rb_kind() -> s32 {
    if rb_step == 0 { return 14 + rb_ph }
    if rb_g < view_floor { return rb_ph }
    return 7 + rb_ph
}

fn rebuild_steps() {
    let t0 = cycles_now()
    // every step bakes in the camera of the pan the build started at (rb_px, rb_py): the view
    // may have panned since, and the buffer is shifted from that pan when it goes on screen
    // (baking later steps at the newer pan put their pieces out of place by the pan between)
    let save_px = pan_x
    let save_py = pan_y
    pan_x = rb_px
    pan_y = rb_py
    clip_py = rb_py
    set_camera()
    cull_setup()
    mb_cull = true
    memcpy(&__ot[0] as *u8, &rb_ot[0] as *u8, 4096)
    let save_ptr = __arena_ptr
    let save_end = __arena_end
    __arena_ptr = rb_ptr
    __arena_end = &cache_arena[rb_buf * ARENA_W] + ARENA_W
    mb_init()
    let f = view_floor
    var n = 0
    while rb_step < 2 {
        let k = rb_kind()
        let ts = cycles_now()
        if n > 0 && c_have[cur] && ts - t0 + rb_est[k] > RB_BUDGET { break }
        let p0 = __arena_ptr
        rebuild_step(f)
        // what the step made off the screen (at the build's pan) is marked to be passed over
        if __arena_ptr > p0 {
            cp_m = MARK_M
            cache_mark(p0, __arena_ptr, 0, 0)
        }
        let c = cycles_now() - ts
        rb_est[k] = max(c, rb_est[k] * 3 / 4)     // a decaying maximum: rather too careful
        n += 1
        if RB_TRACE { print("RB "); print_int(k); print(" "); print_int(c); println("") }
    }
    bm_bias = 0
    mb_key = -1
    rb_ptr = __arena_ptr
    __arena_ptr = save_ptr
    __arena_end = save_end
    mb_cull = false
    cull_rect(0, 0, 320, 240)
    pan_x = save_px
    pan_y = save_py
    clip_py = shown_py()
    set_camera()
    rb_frame = cycles_now() - t0
    rb_work += rb_frame
    if rb_step < 2 {
        memcpy(&rb_ot[0] as *u8, &__ot[0] as *u8, 4096)
        __ot_reset(&__ot[0])
        return
    }
    // finished: this buffer goes on screen
    let b = rb_buf
    memcpy(&cache_ots[b][0] as *u8, &__ot[0] as *u8, 4096)
    __ot_reset(&__ot[0])
    cache_full = rb_ptr >= &cache_arena[b * ARENA_W] + ARENA_W
    c_end[b] = rb_ptr
    c_px[b] = rb_px
    c_py[b] = rb_py
    c_bpx[b] = rb_px
    c_bpy[b] = rb_py
    c_lo[b] = f > 0
    c_rot[b] = view_rot
    c_zoom[b] = view_zoom
    c_floor[b] = f
    c_have[b] = true
    c_cull[b] = true             // (marked at its pan as it was made)
    c_mpx[b] = rb_px
    c_mpy[b] = rb_py
    cur = b
    rb_step = -1
    cache_cycles = rb_work
    cache_builds += 1
}

// One step of the build (see above).
fn rebuild_step(f: s32) {
    if rb_step == 0 {
        // the tables, then the exposure map (rb_ph 0, 1), each a step of its own
        if rb_ph == 0 { compute_tables(); rb_ph = 1; return }
        compute_top_solid()
        rb_ph = 0
        rb_step = 1
        return
    }
    let g = rb_g
    let below = g < f
    let lower = f - 1 - g
    mb_ghost = below
    match rb_ph {
        0, 1 => {
            if below && rb_ph == 0 && !rb_same { expose_floor(g) }
            if below { mb_set_bias(B_SLAB + lower * B_FLOOR) } else { mb_set_bias(B_SLAB) }
            lo_blocks = view_zoom == 0 || below
            if !below { mb_key = LAYER_FLOOR }      // the floor layer (the floors below: B_SLAB)
            if rb_ph == 0 { floor_surfaces(g, 0, 3) } else {
                floor_surfaces(g, 3, 6)
                if g > 0 { build_slab_edges(g) }
            }
            mb_key = -1
        }
        2, 3 => {
            // the walls, each direction in WALL_PARTS parts (a step each)
            if below { mb_set_bias(lower * B_FLOOR) } else { mb_set_bias(0) }
            if rb_ph == 2 { walls_z(g, rb_sub) } else { walls_x(g, rb_sub) }
            rb_sub = (rb_sub + 1) % WALL_PARTS
            if rb_sub != 0 {
                mb_flush()
                mb_ghost = false
                return
            }
        }
        4 => {
            // the objects, a chunk at a time (zoomed in they are many full meshes)
            if below { mb_set_bias(lower * B_FLOOR) } else { mb_set_bias(0) }
            if !objects_chunk(g) {
                mb_flush()
                mb_ghost = false
                return
            }
        }
        5 => {
            if below { mb_set_bias(lower * B_FLOOR) } else { mb_set_bias(0) }
            build_rails(g)
            if below { build_facades(g) }
        }
        else => {
            // the world around (with the floors below, or in the ground floor's floor layer)
            mb_ghost = f > 0
            mb_set_bias(B_SLAB + 6 * B_FLOOR)
            if f == 0 { mb_key = LAYER_FLOOR }
            build_surroundings()
            mb_key = -1
        }
    }
    mb_flush()
    mb_ghost = false
    // what comes next
    if rb_ph == 6 {
        if f > 0 {
            // the floors below get an ordering table of their own
            memcpy(&lo_snaps[rb_buf][0] as *u8, &__ot[0] as *u8, 4096)
            relink_lo(&lo_snaps[rb_buf][0])
            __ot_reset(&__ot[0])
            rb_g = f
            rb_ph = 0
        } else {
            rb_step = 2
        }
        return
    }
    rb_ph += 1
    if rb_ph == 6 {
        if below {
            rb_g += 1
            rb_ph = 0
            if rb_g == f { rb_ph = 6 }
        } else if f > 0 {
            rb_step = 2
        }
    }
}

// The lower pass was rendered into __ot; its chains end at __ot's entries. Point them at
// lo_ot's entries instead, so lo_ot (restored from the snapshot each frame) is a list of its own.
fn relink_lo(snap: *u32) {
    let ot0 = &__ot[0] as u32
    let ot1 = ot0 + 4096
    let lo0 = &lo_ot[0] as u32
    for b in 0..1024 {
        var w = snap[b]
        var nxt = w & 0xFFFFFF
        if nxt >= ot0 && nxt < ot1 {
            snap[b] = (w & 0xFF000000) | (nxt - ot0 + lo0)
            continue
        }
        while nxt != 0xFFFFFF {
            let q = nxt as *u32
            let n2 = q[0] & 0xFFFFFF
            if n2 >= ot0 && n2 < ot1 {
                q[0] = (q[0] & 0xFF000000) | (n2 - ot0 + lo0)
                break
            }
            nxt = n2
        }
    }
}

// Draws the floors below now, then ghosts them (the viewed floor draws on top later): they were
// baked at 5/8 of their colour (and the sky cleared darker, sky_col), so adding 3/8 of a light
// cool grey makes a 37% mix toward #C8CCD4. The atrium reads as architecture, not a dark pit.
// It is also the last of the world's drawing: a view swapped in by begin_world is put back.
var lo_tris: s32                 // triangles the floors below took this frame
const GHOST_ADD = 0x4F4C4B        // #C8CCD4 x 3/8 (0xBBGGRR)

fn draw_lower() {
    lo_tris = 0
    if have_lo {
        let before = GPU_STATUS & 0xFFFF
        GPU_DRAW = &lo_ot[1023] as u32
        lo_tris = ((GPU_STATUS & 0xFFFF) - before) as s32
        if !no_haze {
            let q = packet_alloc(6)
            if q != null {
                q[0] = (0x2C << 24) | 0xFFFFFF
                q[1] = GHOST_ADD | (1 << 24)
                q[2] = upos(0, 0)
                q[3] = upos(320, 0)
                q[4] = upos(0, 240)
                q[5] = upos(320, 240)
                GPU_DRAW = q as u32
            }
        }
    }
    view_restore()
}

// Moving the cache as the view pans: every packet of buffer b is moved by (dx, dy) pixels
// (render_pass.akr). The cache holds what lies near the screen too (CULL_S, CULL_O), but the GPU
// counts every polygon it is given against its 4,000 triangles, drawn or not, so the packets
// wholly more than MARK_M pixels off the screen are marked to be passed over (header type 0x0_
// instead of 0x2_). Marking costs more than moving, so it is done as a buffer is built (each
// step marks what it made, at the build's pan) and again whenever the view has panned MARK_M - 4
// pixels since; the frames between only move.
const MARK_M = 24
var c_mpx: [2]s32                // pan at the buffer's last marking
var c_mpy: [2]s32

fn cache_shift(b: s32, dx: s32, dy: s32) {
    let p = &cache_arena[b * ARENA_W]
    let dyw = (dy as u32) << 16
    if !c_cull[b] || abs(pan_x - c_mpx[b]) > MARK_M - 4 || abs(pan_y - c_mpy[b]) > MARK_M - 4 {
        cp_m = MARK_M
        cache_mark(p, c_end[b], dx, dyw)
        c_mpx[b] = pan_x
        c_mpy[b] = pan_y
        c_cull[b] = true
    } else if dx != 0 || dy != 0 {
        cache_move(p, c_end[b], dx, dyw)
    }
}

// While a rebuild for another view (rotation, zoom or floor) is in progress, the old picture
// stays up, and the world's moving parts (people, cars, glows) are drawn in its view: begin_world
// swaps that view in, draw_lower puts the real one back for the interface.
var vs_on: bool
var vs_rot: s32
var vs_zoom: s32
var vs_floor: s32
var vs_px: s32
var vs_py: s32

fn view_restore() {
    if !vs_on { return }
    vs_on = false
    view_rot = vs_rot
    view_zoom = vs_zoom
    view_floor = vs_floor
    pan_x = vs_px
    pan_y = vs_py
    set_camera()
}

// Called at the start of draw(): rebuilds (a few steps), shifts or restores the static geometry.
fn begin_world() {
    clip_py = shown_py()
    set_camera()
    // the cache holds what lies near the screen it was built for: rebuild after a long pan (a
    // build in progress is not restarted for panning, see DRIFT)
    pan_track()
    if cache_dirty { tables_stale = true }      // (an edit or a view change, not a pan)
    if rb_step < 0 && c_have[cur] && c_rot[cur] == view_rot && c_zoom[cur] == view_zoom && c_floor[cur] == view_floor {
        let d = DRIFT[view_zoom]
        if abs(pan_x + lead_x - c_bpx[cur]) > d || abs(pan_y + lead_y - c_bpy[cur]) > d { cache_dirty = true }
    }
    if cache_dirty { rebuild_start() }
    if rb_step >= 0 { rebuild_steps() }
    if clip_py != shown_py() {
        // (a build just finished: its depth range)
        clip_py = shown_py()
        set_camera()
    }
    let b = cur
    have_lo = false
    if !c_have[b] { return }
    let same = c_rot[b] == view_rot && c_zoom[b] == view_zoom && c_floor[b] == view_floor
    if same {
        drift_max = max(drift_max, max(abs(pan_x - c_bpx[b]), abs(pan_y - c_bpy[b])))
        if pan_x != c_px[b] || pan_y != c_py[b] || !c_cull[b] {
            cache_shift(b, pan_x - c_px[b], pan_y - c_py[b])
            c_px[b] = pan_x
            c_py[b] = pan_y
        }
    } else {
        // the new view is still being built: show the old one, as it was
        vs_on = true
        vs_rot = view_rot
        vs_zoom = view_zoom
        vs_floor = view_floor
        vs_px = pan_x
        vs_py = pan_y
        view_rot = c_rot[b]
        view_zoom = c_zoom[b]
        view_floor = c_floor[b]
        pan_x = c_px[b]
        pan_y = c_py[b]
        set_camera()
    }
    build_px = c_bpx[b]
    build_py = c_bpy[b]
    cache_end = c_end[b]
    memcpy(&__ot[0] as *u8, &cache_ots[b][0] as *u8, 4096)
    have_lo = c_lo[b]
    if have_lo { memcpy(&lo_ot[0] as *u8, &lo_snaps[b][0] as *u8, 4096) }
}

// ---- building the geometry

fn surf_col(fk: s32) -> u32 { return FLOORK_COL[fk] }

fn ground_col(gr: s32) -> u32 {
    match gr {
        0 => return rgb(96, 168, 80)
        1 => return rgb(236, 214, 150)
        2 => return rgb(70, 72, 82)
        3 => return rgb(196, 190, 176)
        else => return rgb(40, 130, 200)
    }
}

// Floor surfaces of floor g, merged into rectangles inside aligned 4x4 blocks.
var lo_blocks: bool              // use the low-detail blocks (zoomed out, floors below)

fn floor_key_at(g: s32, x: s32, z: s32) -> s32 {
    // -1: nothing to draw; otherwise a "surface code": floor key, or 100 + ground kind
    if !exposed(g, x, z) { return -1 }
    let t = tix(g, x, z)
    if tflag[t] & (TF_VOID | TF_HOLE) != 0 { return -1 }
    if tflag[t] & TF_WATER != 0 { return 200 }
    let fk = tfloor[t] as s32
    if fk != 0 { return fk - 1 }
    if g == 0 { return 100 + ground_at(x, z) }
    return -1
}

fn surf_code_col(code: s32, g: s32) -> u32 {
    if code == 200 { return lit_ext(rgb(70, 180, 235)) }
    if code >= 100 { return lit_ext(ground_col(code - 100)) }
    let k = FLOORK_KIND[code] as s32
    if k == KIND_DECK || (g == 0 && k == KIND_POOL) { return lit_ext(surf_col(code)) }
    return lit_int(surf_col(code))
}

// The art surface of a surface code (-1: none, flat colour).
fn surf_index(code: s32) -> s32 {
    if !ART_PRESENT { return -1 }
    if code == 200 { return 12 }
    if code >= 100 { return 13 + code - 100 }
    return code
}

// One floor rectangle of surface code c: tiles x0..x1, z0..z1 of block (bx, bz).
fn floor_rect(g: s32, y: fixed, c: s32, bx: s32, bz: s32, x0: s32, z0: s32, x1: s32, z1: s32) {
    var yy = y
    if c == 200 { yy = y - 0.15 }
    let si = surf_index(c)
    var col = TINT
    if si >= 0 && SURF_BLOCK[si] == 1 {
        look_tex(SURF_PAL[si] as s32)
        if lo_blocks { mb_tex = ART_FLOOR4_LO_SLOT | 0x10 }
        let u = SURF_U[si] as s32 + x0 * SURF_CELL
        let v = SURF_V[si] as s32 + z0 * SURF_CELL
        uv_horiz(u, v, (x1 - x0 + 1) * SURF_CELL - 1, (z1 - z0 + 1) * SURF_CELL - 1)
    } else {
        look_flat()
        col = surf_code_col(c, g)
    }
    mb_hquad(fixed(bx * 4 + x0), fixed(bz * 4 + z0), fixed(bx * 4 + x1 + 1), fixed(bz * 4 + z1 + 1), yy, col)
}

fn build_floor_surfaces(g: s32) {
    lo_blocks = view_zoom == 0 || g < view_floor
    floor_surfaces(g, 0, 6)
    if g > 0 { build_slab_edges(g) }
}

// The floor surfaces of block rows bz0..bz1-1 of floor g.
fn floor_surfaces(g: s32, bz0: s32, bz1: s32) {
    let y = fixed(g) * STOREY
    let base = g * NT
    let tfw = (&tfloor[0]) as *u32
    let tgw = (&tflag[0]) as *u32
    var rc: [4]s32
    var codes: [4]s32
    for bz in bz0..bz1 {
        if g > 0 && (bz * 4 > fl_z1[g] || bz * 4 + 3 < fl_z0[g]) { continue }
        for bx in 0..8 {
            if g > 0 && (bx * 4 > fl_x1[g] || bx * 4 + 3 < fl_x0[g]) { continue }
            // per row of the block (a word each): one plain surface code, -2 mixed, -1 nothing
            let w0 = g * 192 + bz * 32 + bx
            var any = false
            for r in 0..4 {
                let e = exw(g, bz * 4 + r, bx)
                if e == 0 { rc[r] = -1; continue }
                any = true
                let wf = tfw[w0 + r * 8]
                rc[r] = -2
                if e == B80 && tgw[w0 + r * 8] & 0x0D0D0D0D == 0 && wf == (wf & 255) * B01 {
                    if wf != 0 { rc[r] = (wf & 255) as s32 - 1 }
                    else if g == 0 { rc[r] = 100 + ground_at(0, bz * 4 + r) }
                    else { rc[r] = -1 }
                }
            }
            if !any { continue }
            // plain rows merge downward; mixed rows go tile by tile, merging equal neighbours
            var r = 0
            while r < 4 {
                let c = rc[r]
                if c >= 0 {
                    var e = r
                    while e < 3 && rc[e + 1] == c { e += 1 }
                    floor_rect(g, y, c, bx, bz, 0, r, 3, e)
                    r = e + 1
                    continue
                }
                if c == -2 {
                    let z = bz * 4 + r
                    for k in 0..4 {
                        let l = z * GW + bx * 4 + k
                        let t = base + l
                        var cc = -1
                        let fl = tflag[t] as s32
                        if exposed(g, bx * 4 + k, z) && fl & (TF_VOID | TF_HOLE) == 0 {
                            if fl & TF_WATER != 0 {
                                cc = 200
                            } else if tfloor[t] != 0 {
                                cc = tfloor[t] as s32 - 1
                            } else if g == 0 {
                                cc = 100 + ground_at(0, z)
                            }
                        }
                        codes[k] = cc
                    }
                    var k = 0
                    while k < 4 {
                        let cc = codes[k]
                        var e = k
                        while e < 3 && codes[e + 1] == cc { e += 1 }
                        if cc >= 0 { floor_rect(g, y, cc, bx, bz, k, r, e, r) }
                        k = e + 1
                    }
                }
                r += 1
            }
        }
    }
}


// The visible edge of the floor slab where an upper floor ends (its thickness).
fn build_slab_edges(g: s32) {
    let y = fixed(g) * STOREY
    look_out(ART_FLAT_SLAB)
    if fl_x1[g] < fl_x0[g] { return }
    for z in fl_z0[g]..fl_z1[g] + 1 {
        for x in fl_x0[g]..fl_x1[g] + 1 {
            let t = g * NT + z * GW + x
            if tfloor[t] == 0 || !exposed(g, x, z) { continue }
            // neighbour in the visible +x / +z direction (or -x / -z)
            var nx = x - 1
            if vis_px { nx = x + 1 }
            if !in_lot(nx, z) || tfloor[tix(g, nx, z)] == 0 {
                var ex = fixed(x)
                if vis_px { ex = fixed(x + 1) }
                mb_vquad_z(ex, fixed(z), fixed(z + 1), y - 0.25, y, tint_xface())
            }
            var nz = z - 1
            if vis_pz { nz = z + 1 }
            if !in_lot(x, nz) || tfloor[tix(g, x, nz)] == 0 {
                var ez = fixed(z)
                if vis_pz { ez = fixed(z + 1) }
                mb_vquad_x(fixed(x), fixed(x + 1), ez, y - 0.25, y, tint_zface())
            }
        }
    }
}

const GLASS_COL = 0xE0B890
const DOOR_COL = 0x30507A
const BEHIND = 6                 // a back wall stays full height only with no building this close behind

// Is any tile of floor g indoors in the wedge behind the outdoor tile (bx, bz), as seen from the
// camera: up to BEHIND steps away from it in x and z together (the camera looks diagonally, so a
// tall wall covers what lies behind it on both axes)?
fn built_behind(g: s32, bx: s32, bz: s32) -> bool {
    var sz = -1
    if !vis_pz { sz = 1 }
    // row by row (j steps in z), the x range of the wedge, against the floor's indoor rows (in_mm)
    for j in 0..BEHIND + 1 {
        let z = bz + sz * j
        if z < 0 || z >= GH { break }
        var x0 = bx
        var x1 = bx - (BEHIND - j)
        if !vis_px { x1 = bx + BEHIND - j }
        if x1 < x0 { let t = x0; x0 = x1; x1 = t }
        x0 = max(x0, 0)
        x1 = min(x1, GW - 1)
        if x1 < x0 { continue }
        var m = 0xFFFFFFFF << (x0 as u32)
        if x1 < 31 { m = m & ((0xFFFFFFFF as u32) >> ((31 - x1) as u32)) }
        if in_mm[g][z] & m != 0 { return true }
    }
    return false
}

// Walls of floor g. For each edge the camera sees one side, A; the other is B. A wall is drawn
// full height only on the building's real back edge: A indoors, B outdoors (or open air) and no
// indoor tile of the floor in the wedge behind B (otherwise it would stand in front of the rooms
// there). Every other wall is cut down to LOW_H, with a light face and a dark cap that outline
// the rooms; low walls merge into runs (lw_z / lw_x, one bit per edge). Doors in cut walls get
// jambs and a threshold. Only edges between two different rooms are looked at: rows of troom
// are compared four tiles at a time. (A wall stands between two rooms when one is indoors and
// they are not both corridors, as in world.akr wall_between().)
var lw_z: [33]u32                // low walls along z at line x (bit z)
var lw_x: [25]u32                // low walls along x at line z (bit x)

// Runs of walls, railings and facades are cut every RUN_LEN tiles (see the sorting notes at the
// top: each piece is sorted at the middle of its base).
const RUN_LEN: [3]s32 = [4, 2, 1]

// Full-height wall pieces and doors in cutaway walls found while walls_z / walls_x scan the
// edges, drawn after the scan.
var dw_n: s32
var dw_k: [256]u8                // 0 a full piece along z, 1 along x, 2 a low door along z, 3 along x
var dw_x: [256]u8
var dw_z: [256]u8
var dw_a: [256]bool              // the visible side is -x (along z) / -z (along x)
var dw_f: [256]u8                // the edge's feature (full pieces)

fn dw_add(k: s32, x: s32, z: s32, a: bool, feat: s32) {
    if dw_n >= 256 { return }
    dw_k[dw_n] = k as u8
    dw_x[dw_n] = x as u8
    dw_z[dw_n] = z as u8
    dw_a[dw_n] = a
    dw_f[dw_n] = feat as u8
    dw_n += 1
}

// Draws what dw_add() collected, each piece as a unit at the middle of its base (the thresholds
// of doors on the viewed floor go with what lies flat on the floor).
fn walls_flush(g: s32) {
    let y = fixed(g) * STOREY
    let flat = g == view_floor
    for i in 0..dw_n {
        let k = dw_k[i] as s32
        let x = dw_x[i] as s32
        let z = dw_z[i] as s32
        if k == 0 || k == 2 { key_at(fixed(x), y, fixed(z) + 0.5) } else { key_at(fixed(x) + 0.5, y, fixed(z)) }
        if k == 0 { wall_piece_z(g, x, z, dw_a[i], dw_f[i] as s32) }
        else if k == 1 { wall_piece_x(g, x, z, dw_a[i], dw_f[i] as s32) }
        else if k == 2 { low_door_z(y, x, z, dw_a[i]) }
        else { low_door_x(y, z, x, dw_a[i]) }
        if k >= 2 {
            if flat { mb_key = LAYER_FLAT }
            if k == 2 { door_threshold_z(y, x, z) } else { door_threshold_x(y, z, x) }
        }
    }
    mb_key = -1
    dw_n = 0
}

fn build_walls(g: s32) {
    walls_z(g, -1)
    walls_x(g, -1)
    build_rails(g)
}

// The walls along z (between x-1 and x) of floor g; then walls_x() the ones along x, the
// railings and (on the ground) the curb.
// (part 0..WALL_PARTS-1: the lines x of that part of the floor's box, a step each; -1: all)
const WALL_PARTS = 4
fn walls_z(g: s32, part: s32) {
    if in_x1[g] >= in_x0[g] {
        mb_flush()
        let run = RUN_LEN[view_zoom]
        dw_n = 0
        let y = fixed(g) * STOREY
        let trw = (&troom[0]) as *u32
        var xa = max(in_x0[g], 1)
        var xb = min(in_x1[g] + 1, GW - 1)
        if part >= 0 {
            let n = xb - xa + 1
            let a = xa
            xa = a + n * part / WALL_PARTS
            xb = a + n * (part + 1) / WALL_PARTS - 1
        }
        let za = max(in_z0[g], 1)
        let zb = min(in_z1[g] + 1, GH - 1)
        for x in xa..xb + 1 { lw_z[x] = 0 }
        for z in za..zb + 1 { lw_x[z] = 0 }
        let k0 = (xa - 1) >> 2
        let k1 = xb >> 2
        // edges along z (between x-1 and x), row by row
        for z in in_z0[g]..in_z1[g] + 1 {
            let w0 = g * 192 + z * 8
            var prev: u32 = 0
            if k0 > 0 { prev = trw[w0 + k0 - 1] >> 24 }
            for k in k0..k1 + 1 {
                let w = trw[w0 + k]
                let d = w ^ ((w << 8) | prev)       // byte j: room of x = 4k + j against x - 1
                prev = w >> 24
                if d == 0 { continue }
                for jb in 0..4 {
                    if (d >> ((jb * 8) as u32)) & 255 != 0 {
                        let x = k * 4 + jb
                        if x >= xa && x <= xb { wall_edge_z(g, y, x, z) }
                    }
                }
            }
        }
        // the low walls, merged into runs
        for x in xa..xb + 1 {
            let m = lw_z[x]
            if m == 0 { continue }
            var z = 0
            while z < GH {
                if (m >> (z as u32)) & 1 == 0 { z += 1; continue }
                var e = z + 1
                while e < GH && (m >> (e as u32)) & 1 != 0 && e % run != 0 { e += 1 }
                key_at(fixed(x), y, fixed(z + e) / 2)
                low_wall_z(y, x, z, e, !vis_px)
                z = e
            }
        }
        mb_key = -1
        walls_flush(g)
    }
}


// (part: the lines z of one part of the floor's box, as walls_z)
fn walls_x(g: s32, part: s32) {
    if in_x1[g] >= in_x0[g] {
        mb_flush()
        let run = RUN_LEN[view_zoom]
        dw_n = 0
        let y = fixed(g) * STOREY
        let trw = (&troom[0]) as *u32
        var za = max(in_z0[g], 1)
        var zb = min(in_z1[g] + 1, GH - 1)
        if part >= 0 {
            let n = zb - za + 1
            let a = za
            za = a + n * part / WALL_PARTS
            zb = a + n * (part + 1) / WALL_PARTS - 1
        }
        for z in za..zb + 1 { lw_x[z] = 0 }
        // edges along x (between z-1 and z): two rows compared
        let kx0 = in_x0[g] >> 2
        let kx1 = in_x1[g] >> 2
        for z in za..zb + 1 {
            let w0 = g * 192 + z * 8
            for k in kx0..kx1 + 1 {
                let d = trw[w0 + k] ^ trw[w0 + k - 8]
                if d == 0 { continue }
                for jb in 0..4 {
                    if (d >> ((jb * 8) as u32)) & 255 != 0 {
                        let x = k * 4 + jb
                        if x >= in_x0[g] && x <= in_x1[g] { wall_edge_x(g, y, x, z) }
                    }
                }
            }
        }
        for z in za..zb + 1 {
            let m = lw_x[z]
            if m == 0 { continue }
            var x = 0
            while x < GW {
                if (m >> (x as u32)) & 1 == 0 { x += 1; continue }
                var e = x + 1
                while e < GW && (m >> (e as u32)) & 1 != 0 && e % run != 0 { e += 1 }
                key_at(fixed(x + e) / 2, y, fixed(z))
                low_wall_x(y, z, x, e, !vis_pz)
                x = e
            }
        }
        mb_key = -1
        walls_flush(g)
    }
}

// The railings of floor g and (on the ground) the curb, which lies flat on it (LAYER_FLAT).
fn build_rails(g: s32) {
    if fl_void[g] && in_x1[g] >= in_x0[g] { build_railings(g) }
    if g == 0 {
        if view_floor == 0 { mb_key = LAYER_FLAT }
        build_curb()
        mb_key = -1
    }
}

// The edge between (x-1, z) and (x, z), whose rooms differ.
fn wall_edge_z(g: s32, y: fixed, x: s32, z: s32) {
    let base = g * NT
    let l = z * GW + x
    let cw = rcls[troom[base + l - 1] as s32] as s32
    let ce = rcls[troom[base + l] as s32] as s32
    if (cw | ce) & RC_INDOOR == 0 || (cw & ce & RC_CORR) != 0 { return }
    if !exposed(g, x - 1, z) && !exposed(g, x, z) { return }
    // A: the tile on the camera side
    var a = x
    var b = x - 1
    var ca = ce
    var cb = cw
    if !vis_px { a = x - 1; b = x; ca = cw; cb = ce }
    if g < view_floor && (ca & RC_INDOOR == 0 || !exposed(g, a, z)) {
        // a lower floor's outside wall (the facade shows it), or one hidden under the floor above
        return
    }
    let feat = edge_w[base + l] as s32
    if ca & RC_INDOOR != 0 && cb & RC_INDOOR == 0 && !built_behind(g, b, z) {
        dw_add(0, x, z, a < x, feat)
    } else if feat != EF_DOOR {
        lw_z[x] = lw_z[x] | ((1 as u32) << (z as u32))
    } else {
        dw_add(2, x, z, a < x, 0)
    }
}

// The edge between (x, z-1) and (x, z), whose rooms differ.
fn wall_edge_x(g: s32, y: fixed, x: s32, z: s32) {
    let base = g * NT
    let l = z * GW + x
    let cn = rcls[troom[base + l - GW] as s32] as s32
    let cs = rcls[troom[base + l] as s32] as s32
    if (cn | cs) & RC_INDOOR == 0 || (cn & cs & RC_CORR) != 0 { return }
    if !exposed(g, x, z - 1) && !exposed(g, x, z) { return }
    var a = z
    var b = z - 1
    var ca = cs
    var cb = cn
    if !vis_pz { a = z - 1; b = z; ca = cn; cb = cs }
    if g < view_floor && (ca & RC_INDOOR == 0 || !exposed(g, x, a)) { return }
    let feat = edge_n[base + l] as s32
    if ca & RC_INDOOR != 0 && cb & RC_INDOOR == 0 && !built_behind(g, x, b) {
        dw_add(1, x, z, a < z, feat)
    } else if feat != EF_DOOR {
        lw_x[z] = lw_x[z] | ((1 as u32) << (x as u32))
    } else {
        dw_add(3, x, z, a < z, 0)
    }
}

// A low wall along z at line x from z0 to z1 (exclusive). a_left: the visible side is -x.
fn low_wall_z(y: fixed, x: s32, z0: s32, z1: s32, a_left: bool) {
    let lx = fixed(x)
    var fx = lx + WALL_T
    if a_left { fx = lx - WALL_T }
    look_in(ART_FLAT_WALL_FACE)
    mb_vquad_z(fx, fixed(z0), fixed(z1), y, y + LOW_H, tint_xface())
    look_in(ART_FLAT_CAP)
    mb_hquad(lx - WALL_T, fixed(z0), lx + WALL_T, fixed(z1), y + LOW_H, TINT)
}

fn low_wall_x(y: fixed, z: s32, x0: s32, x1: s32, a_up: bool) {
    let lz = fixed(z)
    var fz = lz + WALL_T
    if a_up { fz = lz - WALL_T }
    look_in(ART_FLAT_WALL_FACE)
    mb_vquad_x(fixed(x0), fixed(x1), fz, y, y + LOW_H, tint_zface())
    look_in(ART_FLAT_CAP)
    mb_hquad(fixed(x0), lz - WALL_T, fixed(x1), lz + WALL_T, y + LOW_H, TINT)
}

// A door in a cut wall: a light threshold across the wall and two slim jambs a little taller than
// the wall (their camera-facing sides), so the opening reads as a doorway.
const JAMB_W = 0.08
const JAMB_H = 0.10              // above the cut wall

fn door_threshold_z(y: fixed, x: s32, z: s32) {
    let lx = fixed(x)
    look_in(ART_FLAT_THRESHOLD)
    mb_hquad(lx - WALL_T, fixed(z) + JAMB_W, lx + WALL_T, fixed(z + 1) - JAMB_W, y + 0.012, TINT)
}

fn low_door_z(y: fixed, x: s32, z: s32, a_left: bool) {
    let lx = fixed(x)
    let z0 = fixed(z)
    let z1 = fixed(z + 1)
    var fx = lx + WALL_T
    if a_left { fx = lx - WALL_T }
    look_in(ART_FLAT_JAMB)
    let h = y + LOW_H + JAMB_H
    mb_vquad_z(fx, z0, z0 + JAMB_W, y, h, tint_xface())
    mb_vquad_z(fx, z1 - JAMB_W, z1, y, h, tint_xface())
}

fn door_threshold_x(y: fixed, z: s32, x: s32) {
    let lz = fixed(z)
    look_in(ART_FLAT_THRESHOLD)
    mb_hquad(fixed(x) + JAMB_W, lz - WALL_T, fixed(x + 1) - JAMB_W, lz + WALL_T, y + 0.012, TINT)
}

fn low_door_x(y: fixed, z: s32, x: s32, a_up: bool) {
    let lz = fixed(z)
    let x0 = fixed(x)
    let x1 = fixed(x + 1)
    var fz = lz + WALL_T
    if a_up { fz = lz - WALL_T }
    look_in(ART_FLAT_JAMB)
    let h = y + LOW_H + JAMB_H
    mb_vquad_x(x0, x0 + JAMB_W, fz, y, h, tint_zface())
    mb_vquad_x(x1 - JAMB_W, x1, fz, y, h, tint_zface())
}

// A full-height back wall piece (one tile edge) along z at line x.
fn wall_piece_z(g: s32, x: s32, z: s32, a_left: bool, feat: s32) {
    let y = fixed(g) * STOREY
    let lx = fixed(x)
    var fx = lx + WALL_T
    if a_left { fx = lx - WALL_T }
    let z0 = fixed(z)
    let z1 = fixed(z + 1)
    // (made cap, feature, face: one key, so they draw face, feature, cap)
    look_in(ART_FLAT_BACK_CAP)
    mb_hquad(lx - WALL_T, z0, lx + WALL_T, z1, y + FULL_H, TINT)
    var rot = 1
    if a_left { rot = 3 }
    wall_feature(feat, vec3(lx, y, z0 + 0.5), rot, a_left, true)
    wall_look()
    mb_vquad_z(fx, z0, z1, y, y + FULL_H, shade(TINT, 236))
}

fn wall_piece_x(g: s32, x: s32, z: s32, a_up: bool, feat: s32) {
    let y = fixed(g) * STOREY
    let lz = fixed(z)
    var fz = lz + WALL_T
    if a_up { fz = lz - WALL_T }
    let x0 = fixed(x)
    let x1 = fixed(x + 1)
    look_in(ART_FLAT_BACK_CAP)
    mb_hquad(x0, lz - WALL_T, x1, lz + WALL_T, y + FULL_H, TINT)
    var rot = 0
    if a_up { rot = 2 }
    wall_feature(feat, vec3(x0 + 0.5, y, lz), rot, a_up, false)
    wall_look()
    mb_vquad_x(x0, x1, fz, y, y + FULL_H, shade(TINT, 216))
}

fn wall_look() {
    if SW_WALL_OK {
        look_tex(SW_WALL_PAL + 1)
        uv_vert(SW_WALL_U, SW_WALL_V, SURF_CELL - 1, SW_CELL_H - 1)
    } else {
        look_flat()
    }
}

// A window or door on a full wall: the art's wall piece, facing the visible side.
fn wall_feature(feat: s32, c: vec3, rot: s32, neg: bool, along_z: bool) {
    if feat == EF_NONE { return }
    var t = OB_WINDOW
    if feat == EF_DOOR { t = OB_DOOR }
    let m = obj_mesh(t, false)
    if m != null {
        bake_mesh(m, c, rot)
        return
    }
    look_flat()
    var col = GLASS_COL
    if feat == EF_DOOR { col = DOOR_COL }
    var off = WALL_T + 0.02
    if neg { off = -off }
    if along_z {
        if feat == EF_WINDOW { mb_vquad_z(c.x + off, c.z - 0.32, c.z + 0.32, c.y + 0.9, c.y + 2.2, col) }
        else { mb_vquad_z(c.x + off, c.z - 0.35, c.z + 0.35, c.y, c.y + 2.1, col) }
    } else {
        if feat == EF_WINDOW { mb_vquad_x(c.x - 0.32, c.x + 0.32, c.z + off, c.y + 0.9, c.y + 2.2, col) }
        else { mb_vquad_x(c.x - 0.35, c.x + 0.35, c.z + off, c.y, c.y + 2.1, col) }
    }
}

// The outside of floor g's walls that face the camera (seen below the viewed floor). Plain cells
// merge into runs (the plain facade stretches sideways unnoticed); windows and doors are one cell.
// Rows of the floor are turned into bit masks first: indoor tiles, and tiles that show.
var fr_in: [24]u32               // bit x: (x, z) is indoors
var fr_ex: [24]u32               // bit x: (x, z) shows (nothing above covers it)
var fc_col: [32]u32              // faces of constant x: bit z

fn build_facades(g: s32) {
    if fa_x1[g] < fa_x0[g] { return }
    let y = fixed(g) * STOREY
    let base = g * NT
    let za = max(fa_z0[g] - 1, 0)
    let zb = min(fa_z1[g] + 1, GH - 1)
    let xa = max(fa_x0[g] - 1, 0)
    let xb = min(fa_x1[g] + 1, GW - 1)
    for z in za..zb + 1 {
        var m: u32 = 0
        var t = base + z * GW + xa
        for x in xa..xb + 1 {
            if rcls[troom[t] as s32] & RC_INDOOR != 0 { m = m | ((1 as u32) << (x as u32)) }
            t += 1
        }
        fr_in[z] = m
        var e: u32 = 0xFFFFFFFF
        if g < view_floor { e = ex_m[g][z] }
        fr_ex[z] = e
    }
    // outside the lot only the ground floor's walls show
    var edge_ex: u32 = 0
    if g == 0 { edge_ex = 1 }
    // faces of constant x (toward +x or -x): per row, indoor tiles whose neighbour is not
    for x in 0..GW { fc_col[x] = 0 }
    for z in fa_z0[g]..fa_z1[g] + 1 {
        let m = fr_in[z]
        var nb: u32 = 0
        if vis_px {
            nb = ~(m >> 1) & ((fr_ex[z] >> 1) | (edge_ex << 31))
        } else {
            nb = ~(m << 1) & ((fr_ex[z] << 1) | edge_ex)
        }
        var f = m & nb
        var x = 0
        while f != 0 {
            if f & 1 != 0 { fc_col[x] = fc_col[x] | ((1 as u32) << (z as u32)) }
            f = f >> 1
            x += 1
        }
    }
    for x in fa_x0[g]..fa_x1[g] + 1 {
        let m = fc_col[x]
        if m == 0 { continue }
        var ex = fixed(x) - WALL_T
        var dx = -1
        if vis_px { ex = fixed(x + 1) + WALL_T; dx = 1 }
        var run0 = -1
        for z in 0..GH + 1 {
            var on = false
            var feat = 0
            if z < GH && (m >> (z as u32)) & 1 != 0 {
                on = true
                feat = edge_feat(g, x, z, dx, 0)
            }
            if on && feat == EF_NONE {
                if run0 >= 0 && z % RUN_LEN[view_zoom] == 0 {
                    facade_z(y, ex, run0, z, EF_NONE)
                    run0 = -1
                }
                if run0 < 0 { run0 = z }
                continue
            }
            if run0 >= 0 {
                facade_z(y, ex, run0, z, EF_NONE)
                run0 = -1
            }
            if on { facade_z(y, ex, z, z + 1, feat) }
        }
    }
    // faces of constant z (toward +z or -z): a row against the next (or previous) one
    for z in fa_z0[g]..fa_z1[g] + 1 {
        var nz = z - 1
        var ez = fixed(z) - WALL_T
        var dz = -1
        if vis_pz { nz = z + 1; ez = fixed(z + 1) + WALL_T; dz = 1 }
        var nb: u32 = 0
        if nz < 0 || nz >= GH {
            if g == 0 { nb = 0xFFFFFFFF }
        } else {
            nb = ~fr_in[nz] & fr_ex[nz]
        }
        let m = fr_in[z] & nb
        if m == 0 { continue }
        var run0 = -1
        for x in 0..GW + 1 {
            var on = false
            var feat = 0
            if x < GW && (m >> (x as u32)) & 1 != 0 {
                on = true
                feat = edge_feat(g, x, z, 0, dz)
            }
            if on && feat == EF_NONE {
                if run0 >= 0 && x % RUN_LEN[view_zoom] == 0 {
                    facade_x(y, ez, run0, x, EF_NONE)
                    run0 = -1
                }
                if run0 < 0 { run0 = x }
                continue
            }
            if run0 >= 0 {
                facade_x(y, ez, run0, x, EF_NONE)
                run0 = -1
            }
            if on { facade_x(y, ez, x, x + 1, feat) }
        }
    }
}

// Facades are textured; their windows light up at night through the palette (lighting.akr).
fn facade_look(feat: s32) {
    if feat == EF_WINDOW {
        look_tex(SW_FACADE_PAL)
        uv_vert(SW_FACADE_U, SW_FACADE_V, SURF_CELL - 1, SW_CELL_H - 1)
    } else if feat == EF_DOOR {
        look_tex(SW_FACADE_GLASS_PAL)
        uv_vert(SW_FACADE_GLASS_U, SW_FACADE_GLASS_V, SURF_CELL - 1, SW_CELL_H - 1)
    } else {
        look_tex(SW_FACADE_PLAIN_PAL)
        uv_vert(SW_FACADE_PLAIN_U, SW_FACADE_PLAIN_V, SURF_CELL - 1, SW_CELL_H - 1)
    }
}

fn facade_z(y: fixed, ex: fixed, z0: s32, z1: s32, feat: s32) {
    facade_look(feat)
    key_at(ex, y, fixed(z0 + z1) / 2)
    mb_vquad_z(ex, fixed(z0), fixed(z1), y - 0.25, y + STOREY - 0.25, shade(tint_xface(), 270))
    mb_key = -1
}

fn facade_x(y: fixed, ez: fixed, x0: s32, x1: s32, feat: s32) {
    facade_look(feat)
    key_at(fixed(x0 + x1) / 2, y, ez)
    mb_vquad_x(fixed(x0), fixed(x1), ez, y - 0.25, y + STOREY - 0.25, shade(tint_zface(), 270))
    mb_key = -1
}

// Railings around void tiles (the edges of an atrium on this floor): where a void tile meets a
// tile with a floor. Rows become bit masks (void, floor, glass) first.
var rv_m: [24]u32                // bit x: void
var rf_m: [24]u32                // bit x: a floor people stand on
var rg_m: [24]u32                // bit x: glass railings
var rc_v: [32]u32                // per x: bit z, a rail on that side
var rc_g: [32]u32                // ... and it is glass

fn build_railings(g: s32) {
    if g == 0 { return }
    let y = fixed(g) * STOREY
    let z0 = max(vd_z0[g] - 1, 0)
    let z1 = min(vd_z1[g] + 1, GH - 1)
    let tfw = (&tfloor[0]) as *u32
    let tgw = (&tflag[0]) as *u32
    for z in z0..z1 + 1 {
        var v: u32 = 0
        var f: u32 = 0
        var gl: u32 = 0
        for k in 0..8 {
            let wf = tfw[g * 192 + z * 8 + k]
            let wg = tgw[g * 192 + z * 8 + k]
            let sh = (k * 4) as u32
            v = v | (bits4(nzb(wg & 0x01010101)) << sh)
            f = f | (bits4(nzb(wf) & ~nzb(wg & 0x0D0D0D0D)) << sh)
            gl = gl | (bits4(nzb(wg & 0x02020202)) << sh)
        }
        rv_m[z] = v
        rf_m[z] = f
        rg_m[z] = gl
    }
    // rails along z: on the -x side (dx -1) or the +x side (dx 1) of void tiles
    for side in 0..2 {
        let dx = side * 2 - 1
        for x in 0..GW { rc_v[x] = 0; rc_g[x] = 0 }
        for z in z0..z1 + 1 {
            var nb = rf_m[z] << 1
            if dx > 0 { nb = rf_m[z] >> 1 }
            var m = rv_m[z] & nb
            let gl = rg_m[z]
            var x = 0
            while m != 0 {
                if m & 1 != 0 {
                    rc_v[x] = rc_v[x] | ((1 as u32) << (z as u32))
                    if (gl >> (x as u32)) & 1 != 0 { rc_g[x] = rc_g[x] | ((1 as u32) << (z as u32)) }
                }
                m = m >> 1
                x += 1
            }
        }
        for x in 0..GW {
            let m = rc_v[x]
            if m == 0 { continue }
            var rx = fixed(x) - 0.04
            if dx > 0 { rx = fixed(x + 1) + 0.04 }
            var z = 0
            while z < GH {
                if (m >> (z as u32)) & 1 == 0 { z += 1; continue }
                let glass = (rc_g[x] >> (z as u32)) & 1
                var e = z + 1
                while e < GH && (m >> (e as u32)) & 1 != 0 && (rc_g[x] >> (e as u32)) & 1 == glass && e % RUN_LEN[view_zoom] != 0 { e += 1 }
                key_at(rx, y, fixed(z + e) / 2)
                rail_z(y, rx, z, e, glass != 0)
                mb_key = -1
                z = e
            }
        }
    }
    // rails along x: on the -z side (dz -1) or the +z side (dz 1) of void tiles
    for side in 0..2 {
        let dz = side * 2 - 1
        for z in z0..z1 + 1 {
            let nz = z + dz
            if nz < 0 || nz >= GH { continue }
            var nf: u32 = 0
            if nz >= z0 && nz <= z1 { nf = rf_m[nz] } else {
                for k in 0..8 {
                    let wf = tfw[g * 192 + nz * 8 + k]
                    let wg = tgw[g * 192 + nz * 8 + k]
                    nf = nf | (bits4(nzb(wf) & ~nzb(wg & 0x0D0D0D0D)) << ((k * 4) as u32))
                }
            }
            let m = rv_m[z] & nf
            if m == 0 { continue }
            var rz = fixed(z) - 0.04
            if dz > 0 { rz = fixed(z + 1) + 0.04 }
            let gl = rg_m[z]
            var x = 0
            while x < GW {
                if (m >> (x as u32)) & 1 == 0 { x += 1; continue }
                let glass = (gl >> (x as u32)) & 1
                var e = x + 1
                while e < GW && (m >> (e as u32)) & 1 != 0 && (gl >> (e as u32)) & 1 == glass && e % RUN_LEN[view_zoom] != 0 { e += 1 }
                key_at(fixed(x + e) / 2, y, rz)
                rail_x(y, rz, x, e, glass != 0)
                mb_key = -1
                x = e
            }
        }
    }
}

// A railing run along z from z0 to z1: a top rail and a post per tile (glass: one pane).
fn rail_z(y: fixed, x: fixed, z0: s32, z1: s32, glass: bool) {
    if glass {
        look_in(ART_FLAT_RAIL_GLASS)
        mb_vquad_z(x, fixed(z0), fixed(z1), y + 0.85, y + 1.0, TINT)
        mb_blend = 0
        mb_flags = FACE_TEXTURED | FACE_SEMI
        mb_vquad_z(x, fixed(z0), fixed(z1), y, y + 0.85, TINT)
        return
    }
    look_in(ART_FLAT_RAIL)
    mb_vquad_z(x, fixed(z0), fixed(z1), y + 0.85, y + 1.0, TINT)
    look_in(ART_FLAT_RAIL_POST)
    for z in z0..z1 { mb_vquad_z(x, fixed(z) + 0.45, fixed(z) + 0.55, y, y + 0.85, TINT) }
}

fn rail_x(y: fixed, z: fixed, x0: s32, x1: s32, glass: bool) {
    if glass {
        look_in(ART_FLAT_RAIL_GLASS)
        mb_vquad_x(fixed(x0), fixed(x1), z, y + 0.85, y + 1.0, TINT)
        mb_blend = 0
        mb_flags = FACE_TEXTURED | FACE_SEMI
        mb_vquad_x(fixed(x0), fixed(x1), z, y, y + 0.85, TINT)
        return
    }
    look_in(ART_FLAT_RAIL)
    mb_vquad_x(fixed(x0), fixed(x1), z, y + 0.85, y + 1.0, TINT)
    look_in(ART_FLAT_RAIL_POST)
    for x in x0..x1 { mb_vquad_x(fixed(x) + 0.45, fixed(x) + 0.55, z, y, y + 0.85, TINT) }
}

// ---- the world around the lot (A9): the ground kinds run on past the lot with the same textures
// (the quiet low-detail blocks, stretched 4x so few quads cover a wide ring), then flat colours of
// the same average far away. The road, sidewalk, grass, beach and sea continue without a seam.

const RING_X0 = -16
const RING_X1 = 48
const RING_Z0 = -12
const RING_Z1 = 40
const FAR = 72

// Ground bands along z: [z0, z1) and the art surface (si) / flat colour of each.
const NBAND = 6
const BAND_Z0: [6]s32 = [-40, -1, 1, 2, 18, 21]
const BAND_Z1: [6]s32 = [-1, 1, 2, 18, 21, 64]
const BAND_GR: [6]s32 = [-1, GR_ROAD, GR_WALK, GR_GRASS, GR_SAND, GR_SEA]
const BAND_FLAT: [6]s32 = [ART_FLAT_TOWN, ART_FLAT_ROAD, ART_FLAT_PAVEMENT, ART_FLAT_GRASS, ART_FLAT_SAND, ART_FLAT_SEA]

fn build_surroundings() {
    for k in 0..NBAND {
        let z0 = BAND_Z0[k]
        let z1 = BAND_Z1[k]
        let gr = BAND_GR[k]
        var y = 0.0
        if gr == GR_SEA { y = -0.15 }
        // the textured ring, in cells aligned to 16 tiles (4 tiles for the sidewalk's slabs)
        var step = 16
        if gr == GR_WALK { step = 4 }
        var zz = max(z0, RING_Z0)
        while zz < min(z1, RING_Z1) {
            let ze = min(min(z1, RING_Z1), (floor_div(zz, step) + 1) * step)
            var xx = RING_X0
            while xx < RING_X1 {
                let xe = xx + step
                // skip the lot (it draws its own ground)
                if !(xx >= 0 && xe <= GW && zz >= 0 && ze <= GH) {
                    ring_quad(gr, xx, zz, xe, ze, y, step)
                }
                xx = xe
            }
            zz = ze
        }
        // flat beyond the ring
        look_out(BAND_FLAT[k])
        var c = TINT
        if gr < 0 { c = shade(TINT, 232) }
        let fz0 = fixed(z0)
        let fz1 = fixed(z1)
        if z0 < RING_Z0 { mb_hquad(-40.0, fz0, fixed(FAR), fixed(min(z1, RING_Z0)), y, c) }
        if z1 > RING_Z1 { mb_hquad(-40.0, fixed(max(z0, RING_Z1)), fixed(FAR), fz1, y, c) }
        let rz0 = fixed(max(z0, RING_Z0))
        let rz1 = fixed(min(z1, RING_Z1))
        if rz0 < rz1 {
            mb_hquad(-40.0, rz0, fixed(RING_X0), rz1, y, c)
            mb_hquad(fixed(RING_X1), rz0, fixed(FAR), rz1, y, c)
        }
    }
}

fn floor_div(a: s32, b: s32) -> s32 {
    if a >= 0 { return a / b }
    return -((b - 1 - a) / b)
}

// One textured piece of the ring: [x0, x1) x [z0, z1) inside one step-sized cell.
fn ring_quad(gr: s32, x0: s32, z0: s32, x1: s32, z1: s32, y: fixed, step: s32) {
    var si = 13 + GR_WALK               // the town strip: paving, a little darker
    var c = TINT
    if gr >= 0 { si = 13 + gr } else { c = shade(TINT, 232) }
    look_tex(SURF_PAL[si] as s32)
    mb_tex = ART_FLOOR4_LO_SLOT | 0x10
    let k = 64 / step                   // texels per tile
    let u = SURF_U[si] as s32 + (x0 - floor_div(x0, step) * step) * k
    let v = SURF_V[si] as s32 + (z0 - floor_div(z0, step) * step) * k
    uv_horiz(u, v, (x1 - x0) * k - 1, (z1 - z0) * k - 1)
    mb_hquad(fixed(x0), fixed(z0), fixed(x1), fixed(z1), y, c)
}

// A low curb around the buildable land (x BUILD_X0..BUILD_X1, z LAND_Z0..LAND_Z1), where the
// ground on both sides is bare, so a new player sees where the hotel may go.
const CURB_W = 0.06
const CURB_H = 0.05

fn curb_free(x: s32, z: s32) -> bool {
    if !in_lot(x, z) { return true }
    let t = tix(0, x, z)
    return tfloor[t] == 0 && tobj[t] < 0
}

fn build_curb() {
    // lines along x at z = LAND_Z0 and z = LAND_Z1 + 1
    for side in 0..2 {
        var z = LAND_Z0
        if side == 1 { z = LAND_Z1 + 1 }
        var run0 = -1
        for x in BUILD_X0..BUILD_X1 + 2 {
            let on = x <= BUILD_X1 && curb_free(x, z - 1) && curb_free(x, z)
            if on && run0 < 0 { run0 = x }
            if !on && run0 >= 0 {
                curb_x(fixed(z), run0, x)
                run0 = -1
            }
        }
    }
    // lines along z at x = BUILD_X0 and x = BUILD_X1 + 1
    for side in 0..2 {
        var x = BUILD_X0
        if side == 1 { x = BUILD_X1 + 1 }
        var run0 = -1
        for z in LAND_Z0..LAND_Z1 + 2 {
            let on = z <= LAND_Z1 && curb_free(x - 1, z) && curb_free(x, z)
            if on && run0 < 0 { run0 = z }
            if !on && run0 >= 0 {
                curb_z(fixed(x), run0, z)
                run0 = -1
            }
        }
    }
}

fn curb_x(z: fixed, x0: s32, x1: s32) {
    look_out(ART_FLAT_CURB)
    mb_hquad(fixed(x0), z - CURB_W, fixed(x1), z + CURB_W, CURB_H, TINT)
    var fz = z - CURB_W
    if vis_pz { fz = z + CURB_W }
    look_out(ART_FLAT_CURB_SIDE)
    mb_vquad_x(fixed(x0), fixed(x1), fz, 0.0, CURB_H, TINT)
}

fn curb_z(x: fixed, z0: s32, z1: s32) {
    look_out(ART_FLAT_CURB)
    mb_hquad(x - CURB_W, fixed(z0), x + CURB_W, fixed(z1), CURB_H, TINT)
    var fx = x - CURB_W
    if vis_px { fx = x + CURB_W }
    look_out(ART_FLAT_CURB_SIDE)
    mb_vquad_z(fx, fixed(z0), fixed(z1), 0.0, CURB_H, TINT)
}
