// Copies the art textures into their slots (0, 1, 2, 3, 4, 5, 7, 8, 9, 10) and palettes 0..159.
fn art_load() {
    load_texture(0, ART_TEX0, len(ART_TEX0))
    load_texture(1, ART_TEX1, len(ART_TEX1))
    load_texture(2, ART_TEX2, len(ART_TEX2))
    load_texture(3, ART_TEX3, len(ART_TEX3))
    load_texture(4, ART_TEX4, len(ART_TEX4))
    load_texture(5, ART_TEX5, len(ART_TEX5))
    load_texture(7, ART_TEX7, len(ART_TEX7))
    load_texture(8, ART_TEX8, len(ART_TEX8))
    load_texture(9, ART_TEX9, len(ART_TEX9))
    load_texture(10, ART_TEX10, len(ART_TEX10))
    load_palette(0, ART_PAL, len(ART_PAL))
}

// Lamps, screens and signs glow at night (on) or not (off): swaps ART_GLOW_PALS.
fn art_lights(on: bool) {
    var src = ART_PAL_DAY
    if on { src = ART_PAL_NIGHT }
    for i in 0..ART_GLOW_COUNT {
        load_palette((ART_GLOW_PALS[i] as s32) * 16, src + i * 16, 16)
    }
}

// Animates the pool and sea palettes; call with a frame counter (a new frame every 8 ticks).
fn art_water(tick: s32) {
    let f = (tick >> 3) & 3
    for i in 0..ART_WATER_COUNT {
        load_palette((ART_WATER_PALS[i] as s32) * 16, ART_PAL_WATER + (i * 4 + f) * 16, 16)
    }
}
