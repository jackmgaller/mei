// Saving to the memory card (cart ID CHECK-IN, save 0). Only the essentials are stored, packed:
// the grid (run-length coded), rooms, objects, the staff roster, money, time, prices, rating and
// reviews. Everything else (room types, paths, elevators, scores) is recomputed on load; guests
// are not saved: the hotel reopens with its rooms clean and vacant.

const SAVE_VERSION = 3
const SAVE_MAGIC = 0x4E494B43     // "CKIN"

var sbuf: [32000]u8
var spos: s32
var save_meta: SaveMeta
var saving_t: s32                // frames since a write started (0: idle)
var save_ok_t: s32

fn put8(v: s32) {
    if spos < 32000 { sbuf[spos] = v as u8 }
    spos += 1
}
fn put16(v: s32) { put8(v & 255); put8((v >> 8) & 255) }
fn put32(v: s32) { put16(v & 0xFFFF); put16((v >> 16) & 0xFFFF) }
fn get8() -> s32 {
    let v = sbuf[spos] as s32
    spos += 1
    return v
}
fn get16() -> s32 {
    let lo = get8()
    return lo | (get8() << 8)
}
fn get32() -> s32 {
    let lo = get16()
    return lo | (get16() << 16)
}

// Run-length: (count 1..255, value) pairs.
fn put_rle(a: *u8, n: s32) {
    var i = 0
    while i < n {
        let v = a[i]
        var k = 1
        while i + k < n && k < 255 && a[i + k] == v { k += 1 }
        put8(k)
        put8(v as s32)
        i += k
    }
}

fn get_rle(a: *u8, n: s32) {
    var i = 0
    while i < n {
        let k = get8()
        let v = get8() as u8
        for j in 0..k {
            if i < n { a[i] = v }
            i += 1
        }
    }
}

fn save_pack() -> s32 {
    spos = 0
    put32(SAVE_MAGIC)
    put16(SAVE_VERSION)
    put32(day)
    put32(tod)
    put32(money)
    put32(loan)
    put8(stars)
    put8(reputation)
    put16(price_room)
    put16(price_suite)
    put8(view_rot)
    put8(view_zoom)
    put8(view_floor)
    for k in 0..NLG { put32(ledger[k]); put32(ledger_y[k]) }
    put8(reviews_n)
    for k in 0..reviews_n {
        put16(reviews[k].day as s32)
        put8(reviews[k].gtype as s32)
        put8(reviews[k].stars as s32)
        put8(reviews[k].quote as s32)
    }
    // the grid
    put_rle(&tfloor[0], NTT)
    put_rle(&troom[0], NTT)
    put_rle(&tflag[0], NTT)
    put_rle(&edge_n[0], NTT)
    put_rle(&edge_w[0], NTT)
    // rooms
    put16(nrooms)
    for r in 1..nrooms {
        let rm = &rooms[r]
        put8(rm.used as s32)
        if rm.used != 0 {
            put8(rm.kind as s32)
            put8(rm.fk as s32)
            put8(rm.floor as s32)
        }
    }
    // objects
    var n = 0
    for i in 0..nobjs { if objs[i].used != 0 { n += 1 } }
    put16(n)
    for i in 0..nobjs {
        let o = &objs[i]
        if o.used == 0 { continue }
        put8(o.t as s32)
        put8(o.f as s32 | ((o.rot as s32) << 4))
        put8(o.x as s32)
        put8(o.z as s32)
        put8((o.state & OS_BROKEN) as s32)
        put8(o.wear as s32)
        put8(o.stock as s32)
    }
    // staff
    var ns = 0
    for i in 0..npeople { if people[i].used != 0 && people[i].kind as s32 == P_STAFF { ns += 1 } }
    put8(ns)
    for i in 0..npeople {
        let p = &people[i]
        if p.used != 0 && p.kind as s32 == P_STAFF { put8(p.type as s32 | ((p.shift as s32) << 4)) }
    }
    put16(0xBEEF)
    return spos
}

fn save_game() {
    if card_busy() || saving_t > 0 {
        say("The memory card is busy...", RED)
        return
    }
    let n = save_pack()
    if n > 32000 {
        say("The hotel is too big to save!", RED)
        return
    }
    save_meta = *SAVE_ICON
    let t = nb()
    sappend(t, "Check-In! Day ")
    sint(t, day)
    sappend(t, " ")
    sint(t, stars)
    sappend(t, "*")
    card_set_title(&save_meta, t)
    let err = card_save(0, &sbuf[0], n, &save_meta)
    if err == CARD_OK {
        saving_t = 1
    } else if err == CARD_NO_CARD {
        say("No memory card in slot 1", RED)
    } else if err == CARD_FULL {
        say("The memory card is full", RED)
    } else {
        say("Couldn't save just now", RED)
    }
}

fn saving_update() {
    if saving_t > 0 {
        saving_t += 1
        if !card_busy() && saving_t > 30 {
            saving_t = 0
            save_ok_t = 120
            fx(FX_SAVE)
            say("Hotel saved", GREEN)
        }
    }
    if save_ok_t > 0 { save_ok_t -= 1 }
}

fn draw_saving() {
    if saving_t > 0 {
        panel_glass(222, 206, 94, 16)
        let dots = (saving_t / 12) % 4
        let b = nb()
        sappend(b, "Saving")
        for k in 0..dots { sappend(b, ".") }
        ftext(230, 207, b, CREAM, false)
    }
}

fn save_exists() -> bool {
    if TEST != 0 && !TEST_CARD { return false }
    return card_exists(0)
}

// Loads save 0 into the game (blocking: title screen only). False if there is none.
fn load_game() -> bool {
    let n = card_load(0, &sbuf[0], 32000)
    if n < 16 { return false }
    spos = 0
    if get32() != SAVE_MAGIC { return false }
    if get16() != SAVE_VERSION { return false }
    new_hotel_state()
    day = get32()
    tod = get32()
    money = get32()
    loan = get32()
    stars = get8()
    reputation = get8()
    price_room = get16()
    price_suite = get16()
    view_rot = get8() & 3
    view_zoom = min(get8(), 2)
    view_floor = min(get8(), NFL - 1)
    for k in 0..NLG { ledger[k] = get32(); ledger_y[k] = get32() }
    reviews_n = min(get8(), NREV)
    var sum = 0
    for k in 0..reviews_n {
        reviews[k].day = get16() as s16
        reviews[k].gtype = get8() as u8
        reviews[k].stars = get8() as u8
        reviews[k].quote = get8() as u8
        sum += reviews[k].stars as s32
    }
    reviews_avg10 = sum * 10 / max(reviews_n, 1)
    get_rle(&tfloor[0], NTT)
    get_rle(&troom[0], NTT)
    get_rle(&tflag[0], NTT)
    get_rle(&edge_n[0], NTT)
    get_rle(&edge_w[0], NTT)
    nrooms = get16()
    for r in 1..nrooms {
        let rm = &rooms[r]
        memset(rm as *u8, 0, sizeof(Room))
        rm.occupant = -1
        rm.used = get8() as u8
        if rm.used != 0 {
            rm.kind = get8() as u8
            rm.fk = get8() as u8
            rm.floor = get8() as u8
        }
    }
    // objects: the stairs holes are in the saved flags already; elevators re-span
    let no = get16()
    for k in 0..no {
        let t = get8()
        let fr = get8()
        let x = get8()
        let z = get8()
        let st = get8()
        let wear = get8()
        let stock = get8()
        let i = obj_add(t, fr & 15, x, z, fr >> 4)
        if i >= 0 {
            objs[i].state = st as u8
            objs[i].wear = wear as u8
            objs[i].stock = stock as u8
        }
    }
    let ns = get8()
    for k in 0..ns {
        let v = get8()
        hire(v & 15, v >> 4)
    }
    if get16() != 0xBEEF { return false }
    for f in 0..NFL { clean_edges(f) }
    elevators_respan()
    rooms_dirty = true
    cache_dirty = true
    for i in 0..nobjs { if objs[i].used != 0 && objs[i].state & OS_BROKEN != 0 { repair_job(i) } }
    return true
}
