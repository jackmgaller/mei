// Day and night: the light outside (sun, dawn, golden hour, dusk, moon) and inside (daylight,
// then warm lamps). Everything baked in the static cache is textured (flat colours through solid
// palette cells), so the time of day is applied to the art palettes only, a few per frame: the
// cache is never rebuilt because the clock moved. Colours that glow (window glass, lamp shades,
// screens: ART_PAL_EMIT) switch to their night versions while the lamps are on. Lamps get a
// small, soft additive glow after dark.
// Owner: workstream A (art and rendering). See CONTRACT.md and POLISH.md (A8, A12).

var light_ext: u32 = 0xFFFFFF    // per-channel multipliers 0..255 (0xBBGGRR)
var light_int: u32 = 0xFFFFFF
var relight_next: s32            // next palette to relight
var night_amt: s32               // 0 day .. 256 night (glows, sky)
var lamps_on: bool               // interior lamps and lit windows (dusk to dawn)

// Key times (minutes) and lights. Dawn is peach, the golden hour amber, dusk violet; the night
// outside is a dark blue, the night inside warm lamplight.
const LK_N = 9
const LK_MIN: [9]s32 = [0, 300, 360, 450, 1020, 1080, 1170, 1245, 1440]
//                         night     night     dawn      day       day       golden    dusk      night     night
const LK_EXT: [9]u32 = [0x78483A, 0x78483A, 0xA8C4F8, 0xFFFFFF, 0xFFFFFF, 0xA8D8FF, 0xC88C90, 0x78483A, 0x78483A]
const LK_INT: [9]u32 = [0xA7CDE4, 0xA7CDE4, 0xD8E4EC, 0xFAFEFF, 0xFAFEFF, 0xE8F6FF, 0xB8DCF8, 0xA7CDE4, 0xA7CDE4]
const LK_NIGHT: [9]s32 = [256, 256, 140, 0, 0, 40, 170, 256, 256]

fn lights_update() {
    let m = minute() % 1440
    var k = LK_N - 2
    for i in 0..LK_N - 1 {
        if m >= LK_MIN[i] && m < LK_MIN[i + 1] { k = i }
    }
    let t = fixed(m - LK_MIN[k]) / (LK_MIN[k + 1] - LK_MIN[k])
    light_ext = clerp(LK_EXT[k], LK_EXT[k + 1], t)
    light_int = clerp(LK_INT[k], LK_INT[k + 1], t)
    night_amt = LK_NIGHT[k] + ((LK_NIGHT[k + 1] - LK_NIGHT[k]) * (t * 256) as s32) / 256
    lamps_on = night_amt > 100
    night_glow = lamps_on
}

// Colour times light.
fn lit(c: u32, l: u32) -> u32 {
    let r = ((c & 255) * (l & 255)) >> 8
    let g = (((c >> 8) & 255) * ((l >> 8) & 255)) >> 8
    let b = (((c >> 16) & 255) * ((l >> 16) & 255)) >> 8
    return r | (g << 8) | (b << 16)
}

fn lit_ext(c: u32) -> u32 { return lit(c, light_ext) }
fn lit_int(c: u32) -> u32 { return lit(c, light_int) }

// Per palette (0..127): its index in ART_GLOW_PALS (the night versions), or -1.
var glow_of: [128]s8
var glow_ready: bool

fn glow_table() {
    for p in 0..128 { glow_of[p] = -1 }
    for i in 0..ART_GLOW_COUNT { glow_of[ART_GLOW_PALS[i] as s32] = i as s8 }
    glow_ready = true
}

// Relights `count` art palettes (round robin) from their stored colours: exterior ones with the
// sky, interior ones with the lamps; glowing colours use their night version while lamps are on.
fn relight_some(count: s32) {
    if !ART_PRESENT { return }
    if !glow_ready { glow_table() }
    let pm = VRAM_PALETTE as *u16
    let base: *u16 = ART_PAL_OBJ
    let night: *u16 = ART_PAL_NIGHT
    for n in 0..count {
        let p = relight_next
        relight_next += 1
        if relight_next >= ART_PAL_OBJ_COUNT { relight_next = 0 }
        let cls = ART_PAL_CLASS[p] as s32
        if cls == 2 { continue }                // water: water_frame()
        var l = light_int
        if cls == 1 { l = light_ext }
        let lr = l & 255
        let lg = (l >> 8) & 255
        let lb = (l >> 16) & 255
        var emit: u32 = 0
        let gi = glow_of[p] as s32
        if lamps_on && gi >= 0 { emit = ART_PAL_EMIT[p] as u32 }
        let src = base + p * 16
        let dst = pm + p * 16
        for i in 0..16 {
            if (emit >> (i as u32)) & 1 != 0 {
                dst[i] = night[gi * 16 + i]
                continue
            }
            let c = src[i] as u32
            let r = ((c & 31) * lr) >> 8
            let g = (((c >> 5) & 31) * lg) >> 8
            let b = (((c >> 10) & 31) * lb) >> 8
            dst[i] = (r | (g << 5) | (b << 10)) as u16
        }
    }
}

fn lighting_frame() {
    lights_update()
    relight_some(12)
    if ART_PRESENT && tick_count % 8 == 0 { water_frame() }
}

// The pool and the sea ripple (palette frames), dimmed with the outside light.
fn water_frame() {
    let f = (tick_count >> 3) & 3
    let pm = VRAM_PALETTE as *u16
    let base: *u16 = ART_PAL_WATER
    let l = light_ext
    let lr = l & 255
    let lg = (l >> 8) & 255
    let lb = (l >> 16) & 255
    for w in 0..ART_WATER_COUNT {
        let src = base + (w * 4 + f) * 16
        let dst = pm + (ART_WATER_PALS[w] as s32) * 16
        for i in 0..16 {
            let c = src[i] as u32
            let r = ((c & 31) * lr) >> 8
            let g = (((c >> 5) & 31) * lg) >> 8
            let b = (((c >> 10) & 31) * lb) >> 8
            dst[i] = (r | (g << 5) | (b << 10)) as u16
        }
    }
}

// The sky behind everything: the day blue in the outside light, deepening at night. Viewing an
// upper floor, the floors below are ghosted (render.akr draw_lower), and so is the sky.
fn sky_col() -> u32 {
    var c = clerp(lit(rgb(168, 204, 232), light_ext), rgb(14, 20, 46), fixed(night_amt) / 384)
    if c_lo[cur] && !no_haze { c = ghost_col(c) }
    return c
}

// Small, soft warm glows around the lamps on the viewed floor while they are on. (Also the marks
// over broken objects, see draw_broken: both run over the objects every frame.)
fn draw_glows() {
    draw_broken()
    if !lamps_on { return }
    let a = min((night_amt - 100) * 2, 256)
    let col = lit(rgb(92, 70, 40), (a as u32) * 0x010101)
    for i in 0..nobjs {
        let o = &objs[i]
        if o.used == 0 || o.f as s32 != view_floor || o.state & OS_BROKEN != 0 { continue }
        let t = o.t as s32
        var h = 0.0
        var big = false
        if t == OB_FLOOR_LAMP { h = 1.4 }
        if t == OB_NIGHTSTAND { h = 0.7 }
        if t == OB_CHANDELIER { h = 1.2; big = true }
        if t == OB_JUKEBOX || t == OB_VENDING || t == OB_ARCADE { h = 1.0 }
        if t == OB_BAR_SHELF { h = 1.4 }
        if h == 0.0 { continue }
        var c = obj_centre(i)
        c.y = c.y + h
        if !project(c) { continue }
        var r = (ppu * 0.8) as s32
        if big { r = r * 2 }
        if proj_x < -r || proj_x > 320 + r || proj_y < -r || proj_y > 240 + r { continue }
        glow_quad(proj_x, proj_y, r, col, depth_bucket(proj_w) - 4, false)
    }
}

fn glow_quad(cx: s32, cy: s32, r: s32, col: u32, bucket: s32, lower: bool) {
    let q = packet_alloc(10)
    if q == null { return }
    let info = ((SLOT_HUD as u32) << 16) | (1 << 20) | ((PAL_GLOW as u32) << 24)
    q[1] = col | (1 << 24)
    q[2] = upos(cx - r, cy - r)
    q[3] = (UV_GLOW_U as u32) | ((UV_GLOW_V as u32) << 8) | info
    q[4] = upos(cx + r, cy - r)
    q[5] = ((UV_GLOW_U + 31) as u32) | ((UV_GLOW_V as u32) << 8)
    q[6] = upos(cx - r, cy + r)
    q[7] = (UV_GLOW_U as u32) | (((UV_GLOW_V + 31) as u32) << 8)
    q[8] = upos(cx + r, cy + r)
    q[9] = ((UV_GLOW_U + 31) as u32) | (((UV_GLOW_V + 31) as u32) << 8)
    lo_insert(q, 0x2E, bucket, lower)
}

// A broken object on the viewed floor gets a small problem badge over it, drawn every frame from
// objs[i].state (breaking and repairing no longer rebuild the static cache): a red diamond with a
// white "!", outlined, bobbing a pixel. It goes on the interface list, under the HUD and panels.
var brk_t: s32

fn draw_broken() {
    brk_t += 1
    let bob = (brk_t >> 5) & 1
    for i in 0..nobjs {
        let o = &objs[i]
        if o.used == 0 || o.state & OS_BROKEN == 0 || o.f as s32 != view_floor { continue }
        let t = o.t as s32
        obj_bounds(t)
        var c = obj_centre(i)
        c.y = c.y + ob_ytop[t] + 0.2
        if !project(c) { continue }
        let x = proj_x
        let y = proj_y - 6 - bob
        if x < -8 || x > 328 || y < -8 || y > 248 { continue }
        broken_badge(x, y)
    }
}

fn broken_badge(x: s32, y: s32) {
    // (diamond corners in strip order: top, left, right, bottom)
    ui_quad(x, y - 7, x - 7, y, x + 7, y, x, y + 7, ST_SHADOW, -1)
    ui_quad(x, y - 6, x - 6, y, x + 6, y, x, y + 6, ST_BAD, -1)
    ui_rect(x - 1, y - 4, 2, 5, WHITE, -1)
    ui_rect(x - 1, y + 2, 2, 2, WHITE, -1)
}
