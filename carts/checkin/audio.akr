// Check-In! sound: music, sound effects and ambience.
//
// Music: a small sequencer plays three scores with ADPCM instruments (samples, instruments
// and scores come from tools/gen_checkin_audio.py, in audio_data.akr and audio/bank.adp):
// the title theme, a bossa nova by day and a swing ballad by night. A score is a form (a
// list of sections); each section has parts (bass, drums, comping, lead) and each part a
// few variants, one picked at random each pass (never the same twice running), so the
// music keeps changing. Through the evening (18:00-21:00) the day tune grows quieter and
// the reverb longer and wetter; once it is late enough the band finishes the section,
// plays a short ending and the night tune starts. Dawn (5:00-7:00) goes back the same way.
//
// Channels: music 0-5 and 8-11 (ten voices; a re-struck note reuses its own voice, else a
// free one, else the quietest, with sounding bass and trumpet notes protected). Effects use
// 6, 7, 12-15, where 14 and 15 also carry up to two ambience beds. An effect takes a free
// channel, else replaces the lowest-priority sound playing (the oldest among equals) but
// never a more important one; each effect has an instance limit (a footstep at most twice,
// a click once: a repeat restarts it), and the same effect twice within three frames plays
// once. Ambience sprinkles (clinks, waves, distant dings) only take free channels. Star
// fanfares duck the music. The reverb is the hall preset, shorter and drier by day; music
// and most hotel sounds are sent to it, UI sounds stay dry.
//
// API
//   audio_init()                       once, at start-up
//   audio_update(hour, minute)         every frame, with the game clock
//   music(m: Music)                    Music.Off, Music.Title or Music.Hotel (day/night by the clock)
//   sfx(id: Sfx)                       a sound effect, centred
//   sfx_at(id: Sfx, pan, vol)          pan -128 (left) .. 128 (right), vol 0..256 (distance)
//   ambience(kind: Ambience, level)    0..256; stays until changed. The two loudest play.
//   ambience_off()                     all ambience levels to 0
//   music_volume(v), sfx_volume(v)     0..256 (settings); ambience follows sfx_volume
//   audio_seed(s)                      test hook: a fixed sequence of random choices

import "audio_data.akr"

enum Sfx {
    Click, Select, Back, Error, Place, Demolish, BuildRoom, MoneyIn, MoneyOut, StarGained, StarLost,
    ReviewPosted, Notification, DeskBell, ElevatorDing, ElevatorDoors, DoorOpen, DoorClose, Footstep,
    LuggageRoll, PhoneRing, CashRegister, RoomServiceCart, PoolSplash, CorkPop, Tab, Modem, Save, Hire, Break
}

// Sea: surf and gulls (beach and pool); Night: a quiet hallway at night
enum Ambience { Lobby, Restaurant, Bar, Kitchen, Laundry, Sea, Night }

enum Music { Off, Title, Hotel }

const AU_NV = 10
const AU_MCH: [10]s32 = [0, 1, 2, 3, 4, 5, 8, 9, 10, 11]
const AU_NS = 6
const AU_SCH: [6]s32 = [6, 7, 12, 13, 14, 15]
const AU_FULL = 32767
const AU_SONG_TITLE = 0
const AU_SONG_DAY = 1
const AU_SONG_NIGHT = 2
// 256 sin(2 pi i / 64)
const AU_SIN: [64]s32 = [0, 25, 50, 74, 98, 121, 142, 162, 181, 198, 213, 226, 237, 245, 251, 255,
    256, 255, 251, 245, 237, 226, 213, 198, 181, 162, 142, 121, 98, 74, 50, 25,
    0, -25, -50, -74, -98, -121, -142, -162, -181, -198, -213, -226, -237, -245, -251, -255,
    -256, -255, -251, -245, -237, -226, -213, -198, -181, -162, -142, -121, -98, -74, -50, -25]

var au_rng: u32 = 0x2468ACE1
var au_frame: s32
var au_wet_trim: s32 = 256       // test hook: scales the reverb return (0: dry)

// ---- music state
var au_mode: Music
var au_song: s32 = -1            // playing score, -1 none
var au_want: s32 = -1            // score that should play
var au_ending: bool              // playing the current score's ending
var au_fpos: s32                 // position in MUS_FORM
var au_t: s32                    // frames into the section
var au_len: s32
var au_np: s32                   // parts in the section
var au_pev: [6]s32               // per part: next event
var au_pbeg: [6]s32
var au_pend: [6]s32
var au_poff: [6]s32              // frame offset of the current repeat
var au_pper: [6]s32              // repeat period (0: none)
var au_plast: [MUS_NPSLOT]s32    // per part slot: the variant played last (-1: none yet)
var au_night: s32                // 0 day .. 256 night
var au_is_night: bool
var au_gain: s32                 // 0..256 fade in and out
var au_gtarget: s32
var au_level: s32 = 256          // music_volume
var au_sfx_level: s32 = 256      // sfx_volume
var au_duck: s32                 // frames of ducking left
var au_duckg: s32 = 256
var au_g: s32                    // gain the voices use this frame
var au_wet_reg: s32 = -1
var au_dec_reg: s32 = -1

// ---- music voices
var mv_on: [10]bool
var mv_inst: [10]s32             // MUS_INST row
var mv_note: [10]s32
var mv_lvl: [10]s32              // envelope 0..AU_FULL
var mv_state: [10]s32            // 2 sounding, 3 released, 4 cut (a mono instrument's next note)
var mv_age: [10]s32
var mv_hold: [10]s32             // frames before the decay
var mv_rel: [10]s32              // age at which the release starts, -1 none
var mv_vol: [10]s32
var mv_pan: [10]s32              // 0 left .. 256 right
var mv_ph: [10]s32               // tremolo phase (cycles x 65536)
var mv_out: [10]s32              // level written last frame (for stealing)

// ---- effect voices (AU_SCH)
var as_spec: [6]s32              // SND_SPEC row, -1 none
var as_pri: [6]s32
var as_start: [6]s32
var as_lvl: [6]s32
var as_dec: [6]s32
var as_hold: [6]s32
var as_vl: [6]s32
var as_vr: [6]s32
var as_bed: [6]bool              // carries an ambience bed
var as_last: [SND_NSFX]s32       // frame each effect last started

// ---- ambience
var am_tgt: [SND_NAMB]s32
var am_cur: [SND_NAMB]s32
var am_slot: [SND_NAMB]s32       // AU_SCH index of its bed, -1 none
var am_timer: [SND_NAMB]s32

fn au_reg(ch: s32) -> *u32 {
    if ch < 8 { return (AUDIO_BASE + ch * 32) as *u32 }
    return (AUDIO_HI_BASE + (ch - 8) * 32) as *u32
}

fn au_rand(n: s32) -> s32 {
    au_rng = au_rng * 1664525 + 1013904223
    return (((au_rng >> 16) * (n as u32)) >> 16) as s32
}

// Starts sample smp (SND_SAMP row) on channel ch at volume 0: play_sample() without the masks.
fn au_play(ch: s32, smp: s32, pitch: s32, flags: s32) {
    let s = smp * 3
    var f = flags | SND_ADPCM | 1
    var loop = SND_SAMP[s + 2]
    if loop >= 0 { f = f | SND_LOOP } else { loop = 0 }
    let r = au_reg(ch)
    r[0] = (SND_BANK as u32) + (SND_SAMP[s] as u32)
    r[1] = SND_SAMP[s + 1] as u32
    r[2] = loop as u32
    r[3] = pitch as u32
    r[4] = 0
    r[5] = f as u32
}

// ================================================================ music: sequencer

fn au_begin(sec: s32) {
    au_t = 0
    let r = sec * 3
    au_len = MUS_SECT[r]
    let pb = MUS_SECT[r + 1]
    au_np = MUS_SECT[r + 2]
    for p in 0..au_np {
        let ps = pb + p
        let n = MUS_PSLOT[ps * 2 + 1]
        var v = 0
        if n > 1 && au_plast[ps] >= 0 {
            v = au_rand(n - 1)
            if v >= au_plast[ps] { v += 1 }
        }
        au_plast[ps] = v
        let vr = (MUS_PSLOT[ps * 2] + v) * 3
        au_pbeg[p] = MUS_VAR[vr]
        au_pev[p] = MUS_VAR[vr]
        au_pend[p] = MUS_VAR[vr] + MUS_VAR[vr + 1]
        au_pper[p] = MUS_VAR[vr + 2]
        au_poff[p] = 0
    }
}

fn au_start_song(s: s32) {
    au_song = s
    au_ending = false
    for k in 0..MUS_NPSLOT { au_plast[k] = -1 }
    au_fpos = MUS_SONG[s * 8]
    au_begin(MUS_FORM[au_fpos])
}

// The section is over: the next one in the form, or the ending and the next score.
fn au_next() {
    if au_ending {
        au_ending = false
        if au_want < 0 {
            au_song = -1
            return
        }
        au_start_song(au_want)
        return
    }
    if au_want != au_song {
        au_ending = true
        au_begin(MUS_SONG[au_song * 8 + 3])
        return
    }
    let s = au_song * 8
    au_fpos += 1
    if au_fpos >= MUS_SONG[s] + MUS_SONG[s + 1] { au_fpos = MUS_SONG[s + 2] }
    au_begin(MUS_FORM[au_fpos])
}

fn au_part(p: s32) {
    var e = au_pev[p]
    while true {
        if e >= au_pend[p] {
            let per = au_pper[p]
            if per == 0 { break }
            let off = au_poff[p] + per
            if off > au_t { break }
            au_poff[p] = off
            e = au_pbeg[p]
            continue
        }
        let w = MUS_EV[e * 2]
        if (w & 0xFFFF) + au_poff[p] > au_t { break }
        au_note(MUS_EV[e * 2 + 1], w >> 16)
        e += 1
    }
    au_pev[p] = e
}

fn au_seq() {
    if au_song < 0 {
        if au_want >= 0 && au_mode != Music.Off { au_start_song(au_want) }
        return
    }
    for p in 0..au_np { au_part(p) }
    au_t += 1
    if au_t >= au_len {
        au_next()
    } else if !au_ending && au_want != au_song && MUS_SONG[au_song * 8 + 5] != 0 && au_t % MUS_SONG[au_song * 8 + 4] == 0 {
        au_next()                // the title may stop at any bar line
    }
}

// ================================================================ music: voices

// Plays one event: packed = inst | note << 5 | velocity << 12 | pan << 19; dur in frames.
fn au_note(packed: s32, dur: s32) {
    let inst = (packed & 31) * 16
    let note = (packed >> 5) & 127
    let lo = MUS_INST[inst + 9]
    if note < lo || note > MUS_INST[inst + 10] { return }
    let nm = (MUS_INST[inst + 8] + note - lo) * 3
    let smp = MUS_NMAP[nm]
    if smp < 0 { return }
    if MUS_INST[inst + 11] != 0 {
        // a mono instrument (bass, trumpet): its previous note fades out fast
        for i in 0..AU_NV {
            if mv_on[i] && mv_inst[i] == inst { mv_state[i] = 4 }
        }
    }
    // the same note still ringing (a re-plucked string), else a free voice, else the
    // quietest; sounding notes of protected instruments count louder
    var v = -1
    var free = -1
    var quiet = 0
    var best = 1 << 30
    for i in 0..AU_NV {
        if mv_on[i] {
            if mv_inst[i] == inst && mv_note[i] == note { v = i }
            var q = mv_out[i]
            if mv_state[i] == 2 { q += 24 + MUS_INST[mv_inst[i] + 13] * 40 }
            if q < best {
                best = q
                quiet = i
            }
        } else if free < 0 {
            free = i
        }
    }
    if v < 0 {
        if free >= 0 { v = free } else { v = quiet }
    }
    var flags = 0
    if MUS_INST[inst + 4] != 0 { flags = SND_REVERB }
    au_play(AU_MCH[v], smp, MUS_NMAP[nm + 1], flags)
    mv_on[v] = true
    mv_inst[v] = inst
    mv_note[v] = note
    mv_lvl[v] = AU_FULL
    mv_state[v] = 2
    mv_age[v] = 0
    mv_hold[v] = MUS_NMAP[nm + 2]
    mv_vol[v] = ((packed >> 12) & 127) * MUS_INST[inst + 3] >> 7
    mv_pan[v] = ((packed >> 19) & 127) * 2 + 1
    mv_ph[v] = au_frame << 12
    mv_out[v] = 0
    if dur > 0 { mv_rel[v] = dur } else { mv_rel[v] = -1 }
}

fn au_voice(i: s32) {
    let inst = mv_inst[i]
    let age = mv_age[i] + 1
    mv_age[i] = age
    var l = mv_lvl[i]
    var st = mv_state[i]
    if st == 2 && mv_rel[i] >= 0 && age >= mv_rel[i] { st = 3 }
    if st == 2 {
        if age > mv_hold[i] && MUS_INST[inst] == 1 { l = l * MUS_INST[inst + 1] >> 16 }
    } else if st == 3 {
        l = l * MUS_INST[inst + 2] >> 16
    } else {
        l = l * MUS_INST[inst + 12] >> 16
    }
    mv_lvl[i] = l
    mv_state[i] = st
    var v = mv_vol[i] * l >> 15
    var pan = mv_pan[i]
    let kind = MUS_INST[inst + 5]
    if kind != 0 {
        let ph = mv_ph[i] + MUS_INST[inst + 7]
        mv_ph[i] = ph
        let s = AU_SIN[(ph >> 10) & 63]
        let depth = MUS_INST[inst + 6]
        if kind == 1 {
            v = v * (256 - (depth * (256 - s) >> 9)) >> 8
        } else {
            pan = clamp(pan + (depth * s >> 9), 0, 256)
        }
    }
    let ch = AU_MCH[i]
    if v < 4 {
        mv_on[i] = false
        stop(ch)
        return
    }
    mv_out[i] = v
    v = v * au_g >> 8
    let left = clamp(v * min(256, (256 - pan) * 2) >> 8, 0, 255)
    let right = clamp(v * min(256, pan * 2) >> 8, 0, 255)
    au_reg(ch)[4] = (left as u32) | ((right as u32) << 8)
}

fn au_stop_music() {
    for i in 0..AU_NV {
        mv_on[i] = false
        stop(AU_MCH[i])
    }
    au_song = -1
    au_want = -1
    au_ending = false
}

// ================================================================ effects

fn au_busy(i: s32) -> bool { return (sound_active() >> (AU_SCH[i] as u32)) & 1 != 0 }

// Starts SND_SPEC row k. A sprinkle (ambience) only takes a free channel.
fn au_spec(k: s32, pan: s32, vol: s32, sprinkle: bool) {
    let r = k * 12
    var pri = SND_SPEC[r + 3]
    var v = -1
    var count = 0
    var oldest = -1
    for i in 0..AU_NS {
        if as_spec[i] == k && !as_bed[i] && au_busy(i) {
            count += 1
            if oldest < 0 || as_start[i] < as_start[oldest] { oldest = i }
        }
    }
    if count >= SND_SPEC[r + 9] {
        v = oldest                 // at its limit: restart the oldest instance
    } else {
        for i in 0..AU_NS {
            if v < 0 && !as_bed[i] && !au_busy(i) { v = i }
        }
        if v < 0 {
            if sprinkle { return }
            // steal the lowest priority, the oldest among equals, never a more important one
            for i in 0..AU_NS {
                if !as_bed[i] {
                    if v < 0 || as_pri[i] < as_pri[v] || (as_pri[i] == as_pri[v] && as_start[i] < as_start[v]) { v = i }
                }
            }
            if v < 0 || as_pri[v] > pri { return }
        }
    }
    var smp = SND_SPEC[r]
    let alt = SND_SPEC[r + 1]
    if alt > 1 { smp += au_rand(alt) }
    var pitch = SND_SPEC[r + 5]
    let j = SND_SPEC[r + 6]
    if j > 0 { pitch += au_rand(2 * j + 1) - j }
    var flags = 0
    if SND_SPEC[r + 4] != 0 { flags = SND_REVERB }
    let ch = AU_SCH[v]
    au_play(ch, smp, pitch, flags)
    let base = (SND_SPEC[r + 2] * clamp(vol, 0, 256) >> 8) * au_sfx_level >> 8
    let p = clamp(pan, -128, 128)
    as_vl[v] = base * min(256, (128 - p) * 2) >> 8
    as_vr[v] = base * min(256, (128 + p) * 2) >> 8
    au_reg(ch)[4] = (as_vl[v] as u32) | ((as_vr[v] as u32) << 8)
    if sprinkle { pri = 0 }
    as_spec[v] = k
    as_pri[v] = pri
    as_start[v] = au_frame
    as_lvl[v] = AU_FULL
    as_dec[v] = SND_SPEC[r + 7]
    as_hold[v] = SND_SPEC[r + 8]
    if SND_SPEC[r + 10] > au_duck { au_duck = SND_SPEC[r + 10] }
}

fn sfx_at(id: Sfx, pan: s32, vol: s32) {
    let k = id as s32
    if au_frame - as_last[k] < 3 { return }       // the same sound twice in a few frames: once
    as_last[k] = au_frame
    au_spec(k, pan, vol, false)
}

fn sfx(id: Sfx) { sfx_at(id, 0, 256) }

fn au_sfx_frame() {
    let active = sound_active()
    for i in 0..AU_NS {
        if as_spec[i] >= 0 && !as_bed[i] {
            let ch = AU_SCH[i]
            if (active >> (ch as u32)) & 1 == 0 {
                as_spec[i] = -1
            } else if as_dec[i] < 65536 && au_frame - as_start[i] > as_hold[i] {
                let l = as_lvl[i] * as_dec[i] >> 16
                as_lvl[i] = l
                if l < 200 {
                    stop(ch)
                    as_spec[i] = -1
                } else {
                    au_reg(ch)[4] = ((as_vl[i] * l >> 15) as u32) | (((as_vr[i] * l >> 15) as u32) << 8)
                }
            }
        }
    }
}

// ================================================================ ambience

fn ambience(kind: Ambience, level: s32) { am_tgt[kind as s32] = clamp(level, 0, 256) }

fn ambience_off() {
    for k in 0..SND_NAMB { am_tgt[k] = 0 }
}

fn au_amb_frame() {
    // the two loudest requests get a bed
    var a = -1
    var b = -1
    for k in 0..SND_NAMB {
        let t = am_tgt[k]
        if t > 0 {
            if a < 0 || t > am_tgt[a] {
                b = a
                a = k
            } else if b < 0 || t > am_tgt[b] {
                b = k
            }
        }
    }
    for k in 0..SND_NAMB {
        let want = k == a || k == b
        var goal = 0
        if want { goal = am_tgt[k] }
        var c = am_cur[k]
        if c < goal { c = min(goal, c + 3) } else if c > goal { c = max(goal, c - 3) }
        am_cur[k] = c
        let r = k * 8
        var slot = am_slot[k]
        if slot < 0 && want {
            // channel 14 or 15, once no bed and no effect is using it
            for j in 4..6 {
                if slot < 0 && !as_bed[j] && !au_busy(j) { slot = j }
            }
            if slot >= 0 {
                au_play(AU_SCH[slot], SND_AMB[r], SND_AMB[r + 1], 0)
                as_bed[slot] = true
                as_spec[slot] = -1
                am_slot[k] = slot
                am_timer[k] = SND_AMB[r + 5] + au_rand(SND_AMB[r + 6] - SND_AMB[r + 5] + 1)
            }
        }
        if slot >= 0 {
            let ch = AU_SCH[slot]
            if c == 0 && !want {
                stop(ch)
                as_bed[slot] = false
                am_slot[k] = -1
            } else {
                let v = (SND_AMB[r + 2] * c >> 8) * au_sfx_level >> 8
                au_reg(ch)[4] = (v as u32) | ((v as u32) << 8)
                am_timer[k] -= 1
                if am_timer[k] <= 0 && c > 8 {
                    am_timer[k] = SND_AMB[r + 5] + au_rand(SND_AMB[r + 6] - SND_AMB[r + 5] + 1)
                    let sp = SND_SPR[SND_AMB[r + 3] + au_rand(SND_AMB[r + 4])]
                    au_spec(sp, au_rand(161) - 80, c * (150 + au_rand(107)) >> 8, true)
                }
            }
        }
    }
}

// ================================================================ control

fn audio_init() {
    for c in 0..16 { stop(c) }
    for i in 0..AU_NV { mv_on[i] = false }
    for i in 0..AU_NS {
        as_spec[i] = -1
        as_bed[i] = false
    }
    for k in 0..SND_NSFX { as_last[k] = -1000 }
    for k in 0..SND_NAMB {
        am_slot[k] = -1
        am_tgt[k] = 0
        am_cur[k] = 0
    }
    au_rng = rand() | 1
    au_song = -1
    au_want = -1
    au_mode = Music.Off
    au_gain = 0
    au_gtarget = 0
    au_wet_reg = -1
    au_dec_reg = -1
    reverb(REVERB_HALL, 0, 0)
}

// Test hook: a fixed random sequence (the variants the music picks).
fn audio_seed(s: u32) { au_rng = s | 1 }

fn music(m: Music) {
    au_mode = m
    if m == Music.Off {
        au_gtarget = 0
    } else {
        au_gtarget = 256
    }
}

fn music_volume(v: s32) { au_level = clamp(v, 0, 256) }
fn sfx_volume(v: s32) { au_sfx_level = clamp(v, 0, 256) }

// 0 by day, 256 at night, ramps through the evening (18:00-21:00) and the dawn (5:00-7:00).
fn au_night_amount(hour: s32, minute: s32) -> s32 {
    let t = (hour % 24) * 60 + minute
    if t >= 1080 && t < 1260 { return (t - 1080) * 256 / 180 }
    if t >= 1260 || t < 300 { return 256 }
    if t < 420 { return 256 - (t - 300) * 256 / 120 }
    return 0
}

fn audio_update(hour: s32, minute: s32) {
    au_frame += 1
    au_night = au_night_amount(hour, minute)
    if !au_is_night && au_night >= 160 { au_is_night = true }
    if au_is_night && au_night <= 96 { au_is_night = false }

    // which score, and the fades
    match au_mode {
        Off => au_want = au_song
        Title => au_want = AU_SONG_TITLE
        Hotel => {
            if au_is_night { au_want = AU_SONG_NIGHT } else { au_want = AU_SONG_DAY }
        }
    }
    if au_song < 0 && au_mode != Music.Off { au_gain = 64 }
    if au_gain < au_gtarget { au_gain = min(au_gtarget, au_gain + 4) }
    else if au_gain > au_gtarget { au_gain = max(au_gtarget, au_gain - 4) }
    if au_mode == Music.Off && au_gain == 0 && au_song >= 0 { au_stop_music() }
    if au_duck > 0 {
        au_duck -= 1
        au_duckg = max(150, au_duckg - 16)
    } else if au_duckg < 256 {
        au_duckg = min(256, au_duckg + 3)
    }
    var g = au_gain * au_level >> 8
    g = g * au_duckg >> 8
    if au_song >= 0 {
        g = g * MUS_SONG[au_song * 8 + 6] >> 8
        if au_song == AU_SONG_DAY { g = g * (256 - (au_night * 48 >> 8)) >> 8 }   // dusk: a little quieter
    }
    au_g = g

    au_seq()
    let active = sound_active()
    for i in 0..AU_NV {
        if mv_on[i] {
            if (active >> (AU_MCH[i] as u32)) & 1 == 0 { mv_on[i] = false } else { au_voice(i) }
        }
    }
    au_sfx_frame()
    au_amb_frame()

    // the reverb: longer and wetter toward night
    let wet = (104 + (au_night * 40 >> 8)) * au_wet_trim >> 8
    if wet != au_wet_reg {
        au_wet_reg = wet
        REVERB_VOL = (wet as u32) | ((wet as u32) << 8)
    }
    let dec = 222 + (au_night * 33 >> 8)
    if dec != au_dec_reg {
        au_dec_reg = dec
        REVERB_DECAY = dec as u32
    }
}
