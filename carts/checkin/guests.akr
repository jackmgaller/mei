// Guests: arrival, check-in at reception, a stay driven by needs and tastes, check-out and a
// review. Families and honeymooners come as two: the companion follows the leader around.

const GS_ARRIVE = 1          // walking to the reception desk
const GS_QUEUE = 2           // waiting to be served at reception
const GS_CHECKIN = 3
const GS_IDLE = 4            // deciding what to do
const GS_GOTO = 5            // walking to an object to use it
const GS_USE = 6
const GS_WAIT_FOOD = 7       // at a table or the phone, waiting for a waiter
const GS_LEAVE = 8
const GS_FOLLOW = 9          // a companion
const GS_CHECKOUT = 10
const GS_WAIT_SERVE = 11     // at a bar or spa, waiting for the staff member
const GS_SWIM = 12

// complaint and praise bits (each maps to a review quote)
const CP_RECEPTION = 1
const CP_NOROOM = 2
const CP_PRICE = 4
const CP_DIRTY = 8
const CP_NOISE = 16
const CP_HUNGRY = 32
const CP_NOFOOD = 64
const CP_NOFUN = 128
const CP_SLOW = 256
const CP_BROKEN = 512
const CP_NOWIFI = 1024
const CP_NOPOOL = 2048
const CP_NOSPA = 4096
const CP_NOSUITE = 8192
const CP_LOST = 16384
const CP_TIRED = 32768

const PR_ROOM = 1
const PR_FOOD = 2
const PR_VIEW = 4
const PR_POOL = 8
const PR_BAR = 16
const PR_SERVICE = 32
const PR_SPA = 64
const PR_WIFI = 128
const PR_ROCK = 256
const PR_BATH = 512              // a bath in their own en-suite
const CP_SHAREDBATH = 65536      // queued for a shared bathroom (or found it dirty)

// special activities (Person.act beyond the USE_* kinds)
const ACT_SWIM = 200
const ACT_SWIM_OUT = 201
const ACT_BROWSE = 202           // standing by something to look at it (or chatting by it)
const ACT_WAIT_BATH = 203        // waiting outside a busy shared bathroom
const ACT_BED_SIT = 205          // sitting on the edge of the bed
const ACT_WINDOW = 206           // looking out of the window
const ACT_NAP = 207              // a nap on the bed by day

var checkins_today: s32
var guests_served: s32

fn guest_count() -> s32 {
    var n = 0
    for i in 0..npeople { if people[i].used != 0 && people[i].kind as s32 == P_GUEST { n += 1 } }
    return n
}

// The reception desk guests go to: any staffed one in a valid lobby, else any at all.
fn find_reception() -> s32 {
    var any = -1
    for i in 0..nobjs {
        let o = &objs[i]
        if o.used == 0 || o.t as s32 != OB_RECEPTION_DESK { continue }
        let r = o.room as s32
        if r == 0 || rooms[r].rtype as s32 != RT_LOBBY { continue }
        if desk_staffed(i) { return i }
        any = i
    }
    return any
}

fn desk_staffed(oi: s32) -> bool {
    let s = objs[oi].staff as s32
    if s < 0 { return false }
    return people[s].used != 0 && people[s].state as s32 == SS_AT_STATION && people[s].obj as s32 == oi
}

// The tile a person stands on to use object oi (spot k).
fn spot_tile(oi: s32, k: s32) -> s32 {
    let o = &objs[oi]
    let t = o.t as s32
    local_to_grid(t, o.x as s32, o.z as s32, o.rot as s32, OBJ_SPOT[(t * 5 + k) * 2] as s32, OBJ_SPOT[(t * 5 + k) * 2 + 1] as s32)
    return tix(o.f as s32, lg_x, lg_z)
}

fn staff_tile(oi: s32) -> s32 {
    let o = &objs[oi]
    let t = o.t as s32
    local_to_grid(t, o.x as s32, o.z as s32, o.rot as s32, OBJ_STAFF_X[t] as s32, OBJ_STAFF_Z[t] as s32)
    return tix(o.f as s32, lg_x, lg_z)
}

fn spawn_guest() {
    if find_reception() < 0 { return }
    let gt = pick_guest_type()
    let e = street_spot()
    let i = person_new(P_GUEST, gt, 0, ptile_x(e), ptile_z(e))
    if i < 0 { return }
    let p = &people[i]
    p.state = GS_ARRIVE as u8
    p.budget = (GT_BUDGET[gt] as s32 * (85 + rnd(40)) / 100) as s16
    p.nights = (GT_NIGHTS[gt] as s32 + rnd(2)) as u8
    p.speed = 0.050 + fixed(rnd(14)) / 1000
    p.mood = ECO_MOOD0 as s16
    p.x += fixed(rnd(5) - 2) / 8
    fade_in(i)
    go_to(i, -1)
    // families bring a kid, honeymooners come as a pair
    if gt == GT_FAMILY || gt == GT_HONEYMOON {
        let j = person_new(P_GUEST, gt, 0, ptile_x(e), ptile_z(e))
        if j >= 0 {
            let c = &people[j]
            c.state = GS_FOLLOW as u8
            c.party = i as s16
            c.look = (p.look as s32 ^ 1) as u8
            c.speed = p.speed * 1.08
            c.x = p.x + 0.3
            c.z = p.z + 0.2
            p.party = j as s16
            fade_in(j)
        }
    }
    arrivals_today += 1
}

fn guest_leave(i: s32) {
    let p = &people[i]
    release_obj(i)
    if p.qslot >= 0 { queue_leave(i) }
    p.state = GS_LEAVE as u8
    p.act = 0
    p.pose = POSE_STAND as u8
    p.sox = 0.0
    p.soz = 0.0
    go_to(i, street_spot())
}

// Use spots taken per object (bit k: spot k), so a table for two seats two.
var spot_mask: [1200]u8

fn release_obj(i: s32) {
    let p = &people[i]
    if p.obj >= 0 {
        let oi = p.obj as s32
        let o = &objs[oi]
        if p.spot >= 0 { spot_mask[oi] = spot_mask[oi] & ~((1 << (p.spot as s32 & 7)) as u8) }
        if o.user as s32 == i { o.user = -1 }
        p.obj = -1
    }
    if p.seat >= 0 {
        let so = p.seat as s32
        if p.sspot >= 0 { spot_mask[so] = spot_mask[so] & ~((1 << (p.sspot as s32 & 7)) as u8) }
        p.seat = -1
    }
    p.spot = -1
    p.sspot = -1
    p.sox = 0.0
    p.soz = 0.0
    p.sy = 0.0
    p.hide = 0
    p.gest = GEST_NONE as u8
}

// Takes spot s of object oi as a seat (the bed or sofa while watching TV).
fn claim_seat(i: s32, oi: s32, s: s32) {
    let p = &people[i]
    spot_mask[oi] = spot_mask[oi] | ((1 << s) as u8)
    p.seat = oi as s16
    p.sspot = s as s8
}

// Is a guest using object oi right now (R: a TV's screen flickers while someone watches)?
fn obj_in_use(oi: s32) -> bool {
    let u = objs[oi].user as s32
    if u < 0 || u >= MAXP { return false }
    let p = &people[u]
    return p.used != 0 && p.obj as s32 == oi && p.state as s32 == GS_USE
}

// A free use spot of object oi (-1: none).
fn free_spot(oi: s32) -> s32 {
    let o = &objs[oi]
    let n = max(OBJ_NSPOT[o.t as s32] as s32, 1)
    let m = spot_mask[oi] as s32
    let k0 = rnd(n)
    for k in 0..n {
        let s = (k0 + k) % n
        if m & (1 << s) == 0 { return s }
    }
    return -1
}

fn claim_spot(i: s32, oi: s32, s: s32) {
    let p = &people[i]
    spot_mask[oi] = spot_mask[oi] | ((1 << s) as u8)
    objs[oi].user = i as s16
    p.obj = oi as s16
    p.spot = s as s8
}

// ---- the reception queue: a line of slots from the desk spot out into the lobby

const QMAX = 8
var q_desk: [4]s16               // desks with a computed line (-1: none)
var q_x: [4][8]fixed
var q_z: [4][8]fixed
var q_t: [4][8]s16
var q_len: [4]s8                 // slots in the line

fn reception_queues_reset() {
    for k in 0..4 { q_desk[k] = -1 }
    // anyone in a line re-joins the line of their desk
    for i in 0..npeople {
        let p = &people[i]
        if p.used != 0 && p.qslot >= 0 && p.qdesk >= 0 {
            if objs[p.qdesk as s32].used == 0 || objs[p.qdesk as s32].t as s32 != OB_RECEPTION_DESK { p.qslot = -1; p.qdesk = -1 }
        }
    }
}

// The line of desk d (computing it the first time): slot 0 at the desk spot, then a path of
// tiles leading back from it (turning where something is in the way, keeping off doorways),
// with a slot every 0.85 tiles along it.
var ql_t: [16]s32
fn queue_line(d: s32) -> s32 {
    for k in 0..4 { if q_desk[k] as s32 == d { return k } }
    var k = -1
    for j in 0..4 { if q_desk[j] < 0 { k = j; break } }
    if k < 0 { k = 0 }
    q_desk[k] = d as s16
    let o = &objs[d]
    let f = o.f as s32
    let r = o.room as s32
    let s0 = spot_tile(d, 0)
    // "back" from the desk, in grid steps
    obj_local_pt(d, 0.0, 0.0)
    let x0 = lp_x
    let z0 = lp_z
    obj_local_pt(d, 0.0, 1.0)
    var dx = (lp_x - x0) as s32
    var dz = (lp_z - z0) as s32
    // the tile path
    var n = 1
    ql_t[0] = s0
    var cur = s0
    while n < 12 {
        var nxt = -1
        for a in 0..3 {
            var sx = dx
            var sz = dz
            if a == 1 { sx = -dz; sz = dx }
            if a == 2 { sx = dz; sz = -dx }
            let x = ptile_x(cur) + sx
            let z = ptile_z(cur) + sz
            if !in_lot(x, z) { continue }
            let t = tix(f, x, z)
            if troom[t] as s32 != r || pass[t] as s32 & PB_WALK == 0 || !near_open(cur, t) || door_tile(t) { continue }
            var dup = false
            for m in 0..n { if ql_t[m] == t { dup = true } }
            if dup { continue }
            nxt = t
            dx = sx
            dz = sz
            break
        }
        if nxt < 0 { break }
        ql_t[n] = nxt
        cur = nxt
        n += 1
    }
    // slots along it
    var m = 0
    var dist = 0.0
    var seg = 0
    while m < QMAX && seg < n {
        // point at `dist` along segment seg (from tile seg to tile seg + 1)
        let a = ql_t[seg]
        var px = tile_cx(a)
        var pz = tile_cz(a)
        var t = a
        if seg + 1 < n {
            let b = ql_t[seg + 1]
            px = px + (tile_cx(b) - px) * dist
            pz = pz + (tile_cz(b) - pz) * dist
            if dist >= 0.5 { t = b }
        } else if dist > 0.0 {
            break
        }
        q_x[k][m] = px
        q_z[k][m] = pz
        q_t[k][m] = t as s16
        m += 1
        dist = dist + 0.85
        while dist >= 1.0 {
            dist = dist - 1.0
            seg += 1
        }
    }
    q_len[k] = max(m, 1) as s8
    return k
}

// A tile with a doorway on one of its edges (people shouldn't stand there).
fn door_tile(t: s32) -> bool {
    let x = ptile_x(t)
    let z = ptile_z(t)
    if edge_n[t] as s32 == EF_DOOR || edge_w[t] as s32 == EF_DOOR { return true }
    if z + 1 < GH && edge_n[t + GW] as s32 == EF_DOOR { return true }
    if x + 1 < GW && edge_w[t + 1] as s32 == EF_DOOR { return true }
    return false
}

// Joins desk d's line at the back and walks to that slot.
fn queue_join(i: s32, d: s32) {
    let p = &people[i]
    var n = 0
    for j in 0..npeople {
        let q = &people[j]
        if j != i && q.used != 0 && q.qdesk as s32 == d && q.qslot >= 0 { n = max(n, q.qslot as s32 + 1) }
    }
    p.qdesk = d as s16
    p.qslot = n as s8
    queue_goto(i)
}

// In the line: face the desk at the front, else the one ahead.
fn queue_face(i: s32) {
    let p = &people[i]
    let d = p.qdesk as s32
    if d < 0 { return }
    let s = p.qslot as s32
    if s <= 0 { face_obj(i, d); return }
    let k = queue_line(d)
    let a = min(s - 1, q_len[k] as s32 - 1)
    p.dir = dir_toward(p.x, p.z, q_x[k][a], q_z[k][a]) as u8
    p.hold = 0
}

fn queue_goto(i: s32) {
    let p = &people[i]
    let k = queue_line(p.qdesk as s32)
    let s = p.qslot as s32
    let len = q_len[k] as s32
    if s < len {
        go_to_pt(i, q_t[k][s] as s32, q_x[k][s], q_z[k][s])
    } else {
        // past the end of the line: stand behind it, spread out
        let e = len - 1
        let t = q_t[k][e] as s32
        go_to_pt(i, t, q_x[k][e] + fixed((s - e) % 3 - 1) * 0.3, q_z[k][e] + fixed(s - e) * 0.1)
    }
}

// Leaves the line: everyone behind steps up one slot.
fn queue_leave(i: s32) {
    let p = &people[i]
    let d = p.qdesk as s32
    let s = p.qslot as s32
    p.qslot = -1
    p.qdesk = -1
    if d < 0 { return }
    for j in 0..npeople {
        let q = &people[j]
        if q.used == 0 || q.qdesk as s32 != d || q.qslot as s32 <= s { continue }
        q.qslot -= 1
        if q.mode as s32 == M_WALK || q.mode as s32 == M_STAND { queue_goto(j) }
    }
}

// The first time a thing goes wrong (or right) counts fully, repeats only a little.
fn complain(i: s32, bit: u32, m: s32) {
    let p = &people[i]
    if p.complaints & bit == 0 { p.mood -= m as s16 } else { p.mood -= (m / 6) as s16 }
    p.complaints = p.complaints | bit
}

fn praise(i: s32, bit: u32, m: s32) {
    let p = &people[i]
    if p.praise & bit == 0 { p.mood += m as s16 } else { p.mood += (m / 6) as s16 }
    p.praise = p.praise | bit
}

// ---- per tick

fn guest_tick(i: s32) {
    let p = &people[i]
    match p.state as s32 {
        1 => {   // arrive: join the line at reception
            if p.qslot < 0 {
                let d = find_reception()
                if d < 0 { complain(i, CP_RECEPTION, 30); guest_leave(i); return }
                queue_join(i, d)
                p.timer = 0
            }
            if p.arrived != 0 {
                p.arrived = 0
                p.state = GS_QUEUE as u8
                p.obj = p.qdesk
                queue_face(i)
            }
            p.timer += 1
            if p.wait > 900 { complain(i, CP_LOST, 20); guest_leave(i) }
        }
        2 => {   // in the line: the front one is served when the desk is staffed and free
            p.timer += 1
            let d = p.qdesk as s32
            if d < 0 || objs[d].used == 0 { p.state = GS_ARRIVE as u8; p.qslot = -1; return }
            let o = &objs[d]
            if p.arrived != 0 {
                p.arrived = 0
                queue_face(i)
            }
            if p.qslot == 0 && p.goal < 0 && desk_staffed(d) && o.user < 0 {
                o.user = i as s16
                p.obj = d as s16
                p.state = GS_CHECKIN as u8
                note_wait(p.timer as s32)
                p.timer = 0
                p.pose = POSE_USE as u8
                fx_at(FX_BELL, p.f as s32)
            } else if p.timer > 2400 {
                p.obj = -1
                complain(i, CP_RECEPTION, 40)
                guest_leave(i)
            }
        }
        3 => {   // being checked in
            p.timer += 1
            if p.timer > 100 {
                let d = p.obj as s32
                objs[d].user = -1
                p.obj = -1
                p.pose = POSE_STAND as u8
                queue_leave(i)
                let r = assign_room(i)
                if r < 0 {
                    complain(i, CP_NOROOM, 50)
                    guest_leave(i)
                    return
                }
                p.room = r as s16
                p.timer = 0
                checkins_today += 1
                luggage_job(i)
                p.state = GS_IDLE as u8
                // first, up to the room to unpack
                plan_set(i, USE_DRESS, 0, 0)
                go_room(i)
            }
        }
        4 => {
            // (a short pause after a decision that found nothing to do)
            if p.ht > 0 { p.ht -= 1; return }
            guest_decide(i)
            if p.state as s32 == GS_IDLE { p.ht = 40 }
        }
        5 => {   // walking to an object
            if p.arrived != 0 {
                p.arrived = 0
                start_use(i)
            } else if p.wait > 600 {
                release_obj(i)
                complain(i, CP_LOST, 5)
                p.state = GS_IDLE as u8
            }
        }
        6 => {   // using
            p.timer -= 1
            if p.act as s32 == USE_SLEEP {
                // sleep until morning; noise wakes light sleepers, who sit up in bed a while
                let h = hour()
                if h >= 9 && h < 21 { p.timer = 0 }
                if tod % (MIN_FRAMES * 30) == 0 && p.room >= 0 && rooms[p.room as s32].noise > 5 && is_night_time() {
                    if !security_near(p.room as s32) && (i + tod / (MIN_FRAMES * 30)) % 3 == 0 {
                        complain(i, CP_NOISE, 12)
                        p.pose = POSE_SIT as u8
                        p.ht = (MIN_FRAMES * 12) as s16
                    }
                }
                if p.ht > 0 {
                    p.ht -= 1
                    if p.ht == 0 { p.pose = POSE_LIE as u8 }
                }
            }
            let a = p.act as s32
            if a == ACT_BROWSE && (tick_count + i * 7) % 90 == 0 { browse_look(i) }
            if a == ACT_WAIT_BATH && (tick_count + i) % 30 == 0 && bath_free(p.wroom as s32, p.want as s32) { p.timer = 0 }
            if p.seat >= 0 && objs[p.seat as s32].used == 0 { p.timer = 0 }
            if p.timer <= 0 { finish_use(i) }
        }
        7 => {   // waiting for food
            p.timer += 1
            if p.timer > 2400 {
                cancel_order(i)
                complain(i, CP_HUNGRY, 20)
                release_obj(i)
                p.state = GS_IDLE as u8
            }
        }
        8 => {   // leaving: out to the street, then fade away
            if p.leaving == 0 && (p.arrived != 0 || p.wait > 1200) {
                write_review(i)
                p.leaving = 1
                let c = p.party as s32
                if c >= 0 && people[c].used != 0 && people[c].party as s32 == i { people[c].leaving = 1 }
            }
            if p.leaving != 0 && people_vis[i].fade == 255 {
                let c = p.party as s32
                if c >= 0 && people[c].used != 0 && people[c].party as s32 == i { person_free(c) }
                person_free(i)
            }
        }
        9 => companion_tick(i)
        10 => {  // check-out: through the line at the desk
            if p.arrived != 0 {
                p.arrived = 0
                queue_face(i)
            }
            p.timer += 1
            if p.goal < 0 && p.qslot <= 0 {
                // at the desk a moment
                p.ht += 1
                p.pose = POSE_USE as u8
                if p.ht > 40 {
                    pay_bill(i)
                    guest_leave(i)
                }
            } else if p.wait > 900 || p.timer > 3000 {
                pay_bill(i)
                guest_leave(i)
            }
        }
        11 => {  // waiting for a bartender / therapist
            p.timer += 1
            let o = p.obj as s32
            if o >= 0 && station_served(o) {
                p.state = GS_USE as u8
                p.timer = use_time(p.act as s32)
                note_wait(p.timer as s32)
            } else if p.timer > 1200 {
                complain(i, CP_SLOW, 10)
                release_obj(i)
                p.state = GS_IDLE as u8
            }
        }
        12 => {  // swimming (then a hop back out onto the deck)
            if p.mode as s32 == M_HOP { return }
            if p.act as s32 == 201 {
                if p.mode as s32 == M_STAND {
                    p.act = 0
                    p.pose = POSE_STAND as u8
                    p.needs[N_FUN] = 255
                    praise(i, PR_POOL, 10)
                    p.state = GS_IDLE as u8
                }
                return
            }
            p.timer -= 1
            if p.timer <= 0 {
                p.act = 201
                script_move(i, M_HOP, tile_cx(p.sfrom as s32), tile_cz(p.sfrom as s32), 14)
            }
        }
        else => {}
    }
}

fn companion_tick(i: s32) {
    let p = &people[i]
    let l = p.party as s32
    if l < 0 || people[l].used == 0 {
        p.leaving = 1
        if people_vis[i].fade == 255 { person_free(i) }
        return
    }
    let lp = &people[l]
    if lp.leaving != 0 { p.leaving = 1 }
    let lm = lp.mode as s32
    let m = p.mode as s32
    if m == M_WAIT_ELEV || m == M_BOARD || m == M_RIDE || m == M_ALIGHT || m == M_STAIRS || m == M_HOP { return }
    // the leader on another floor or on the way there: follow to where they're going
    if lp.f != p.f || lm == M_RIDE || lm == M_BOARD || lm == M_STAIRS {
        var t = lp.goal as s32
        if lm == M_STAIRS { t = lp.sto as s32 }
        if t < 0 { t = lp.tile as s32 }
        if p.goal as s32 != t { go_to(i, t) }
        // hopelessly lost: slip back in beside the leader (fading in)
        if p.wait > 600 && lp.f != p.f && lm == M_WALK {
            place_at(i, lp.tile as s32)
            fade_in(i)
            p.wait = 0
        }
        return
    }
    // the leader using something with a second spot: take it (sit together, sleep together; on
    // the bed or sofa they watch TV from)
    let ls = lp.state as s32
    var lo = lp.obj as s32
    if lp.seat >= 0 && lp.sspot >= 0 { lo = lp.seat as s32 }
    let busy = lo >= 0 && (ls == GS_USE || ls == GS_WAIT_FOOD || ls == GS_WAIT_SERVE) && objs[lo].used != 0
    if busy && lp.hide == 0 {
        if p.obj as s32 != lo {
            let s = free_spot(lo)
            if s >= 0 {
                release_obj(i)
                claim_spot(i, lo, s)
                go_to(i, spot_tile(lo, s))
                p.act = lp.act
            }
        }
        if p.obj as s32 == lo {
            if p.goal < 0 && p.arrived != 0 {
                p.arrived = 0
                face_obj(i, lo)
                p.pose = lp.pose
                settle(i, lo, p.spot as s32, p.act as s32, lp.pose as s32 == POSE_LIE)
                if lp.seat >= 0 { p.dir = lp.dir; p.hold = 0 }
            }
            if p.goal < 0 { p.pose = lp.pose }
            return
        }
    }
    // the leader in the bathroom, or busy with something for one in the room: wait on the bed
    if (lp.hide != 0 || busy) && lp.room >= 0 && lp.f == p.f && r_grp[room_at(p.f as s32, p.x as s32, p.z as s32)] as s32 == lp.room as s32 {
        if p.obj >= 0 && p.act as s32 == ACT_BED_SIT {
            if p.goal < 0 && p.arrived != 0 {
                p.arrived = 0
                p.pose = POSE_SIT as u8
                settle(i, p.obj as s32, p.spot as s32, ACT_BED_SIT, false)
                face_front(i, p.obj as s32)
            }
            return
        }
        if p.obj < 0 && companion_bed(i, lp.room as s32) { return }
    }
    if p.obj >= 0 {
        release_obj(i)
        p.pose = POSE_STAND as u8
    }
    // walk beside the leader: a little to their side (or just behind, where that's a wall)
    formation(i, l)
}

// Moves companion i to its place beside leader l.
fn formation(i: s32, l: s32) {
    let p = &people[i]
    let lp = &people[l]
    var hx = lp.vx
    var hz = lp.vz
    let sp = alen(hx, hz)
    if sp < 0.005 {
        match lp.dir as s32 {
            0 => { hx = 1.0; hz = 0.0 }
            1 => { hx = 0.0; hz = 1.0 }
            2 => { hx = -1.0; hz = 0.0 }
            else => { hx = 0.0; hz = -1.0 }
        }
    } else {
        hx = hx / sp
        hz = hz / sp
    }
    // to the left of the leader (their lane keeps right), a step behind when walking
    var back = 0.1
    if sp >= 0.005 { back = 0.3 }
    let lt = lp.tile as s32
    var x = lp.x - hz * 0.42 - hx * back
    var z = lp.z + hx * 0.42 - hz * back
    var t = tix(lp.f as s32, clamp(x as s32, 0, GW - 1), clamp(z as s32, 0, GH - 1))
    if t != lt && !near_open(lt, t) {
        x = lp.x - hx * 0.55
        z = lp.z - hz * 0.55
        t = tix(lp.f as s32, clamp(x as s32, 0, GW - 1), clamp(z as s32, 0, GH - 1))
        if t != lt && !near_open(lt, t) {
            x = clamp(lp.x - hz * 0.3, fixed(ptile_x(lt)) + 0.12, fixed(ptile_x(lt)) + 0.88)
            z = clamp(lp.z + hx * 0.3, fixed(ptile_z(lt)) + 0.12, fixed(ptile_z(lt)) + 0.88)
            t = lt
        }
    }
    // (a little slack: a companion doesn't shuffle after every small step of the leader's)
    let d = alen(x - p.x, z - p.z)
    if p.goal >= 0 && p.goal as s32 == t {
        go_to_pt(i, t, x, z)
    } else if d > 0.3 || (p.goal >= 0 && p.goal as s32 != t) || (lp.cs > 0.01 && d > 0.15) {
        go_to_pt(i, t, x, z)
    }
    if p.goal < 0 {
        p.pose = POSE_STAND as u8
        // standing beside them a while: face the same way
        if p.hold > 30 && p.dir != lp.dir && p.cs == 0.0 { p.dir = lp.dir; p.hold = 0 }
    }
}

// ---- rooms

fn assign_room(i: s32) -> s32 {
    let p = &people[i]
    let gt = p.type as s32
    var best = -1
    var bscore = -999
    for r in 1..nrooms {
        let rm = &rooms[r]
        if rm.used == 0 || rm.flags & RF_VALID == 0 || rm.occupant >= 0 { continue }
        let t = rm.rtype as s32
        if t != RT_GUEST && t != RT_SUITE { continue }
        if rm.state as s32 == RS_DIRTY { continue }
        let price = room_price(r)
        var sc = rm.quality as s32 + rm.view as s32
        // their own bathroom (with a tub, for honeymooners); business travellers hate sharing
        let bk = r_bath[r] as s32
        if bk >= BATH_ENSUITE { sc += 15 }
        if bk == BATH_ENSUITE_TUB && gt == GT_HONEYMOON { sc += 20 }
        if bk == BATH_SHARED && gt == GT_BUSINESS { sc -= 25 }
        if t == RT_SUITE {
            if gt == GT_HONEYMOON || gt == GT_ROCKSTAR { sc += 100 } else { sc -= 60 }
        }
        if gt == GT_ROCKSTAR && rm.flags & RF_PENTHOUSE != 0 { sc += 100 }
        if price > p.budget as s32 * 3 / 2 { sc -= 200 }
        if sc > bscore {
            bscore = sc
            best = r
        }
    }
    if best < 0 {
        // a dirty room is better than none: take it and complain
        for r in 1..nrooms {
            let rm = &rooms[r]
            if rm.used == 0 || rm.flags & RF_VALID == 0 || rm.occupant >= 0 { continue }
            let t = rm.rtype as s32
            if t == RT_GUEST || t == RT_SUITE {
                best = r
                complain(i, CP_DIRTY, 15)
                break
            }
        }
    }
    if best < 0 { return -1 }
    let rm = &rooms[best]
    let price = room_price(best)
    if price > p.budget as s32 * 3 / 2 {
        complain(i, CP_PRICE, 30)
        return -1
    }
    if price > p.budget as s32 { complain(i, CP_PRICE, 10) }
    if (gt == GT_HONEYMOON || gt == GT_ROCKSTAR) && rm.rtype as s32 != RT_SUITE { complain(i, CP_NOSUITE, 20) }
    if gt == GT_ROCKSTAR && rm.flags & RF_PENTHOUSE == 0 { complain(i, CP_NOSUITE, 10) }
    if rm.state as s32 == RS_DIRTY { complain(i, CP_DIRTY, 10) }
    rm.occupant = i as s16
    rm.state = RS_OCCUPIED as u8
    if rm.quality > 60 { praise(i, PR_ROOM, 8) }
    if r_bath[best] as s32 == BATH_SHARED && gt != GT_FAMILY { complain(i, CP_SHAREDBATH, 5) }
    if rm.view >= 20 { praise(i, PR_VIEW, 10) }
    // checkout after the planned nights
    p.timer = 0
    p.shift = ((day + p.nights as s32) & 255) as u8
    return best
}

// The guest's bed spot (their room's first bed).
fn room_obj(r: s32, use: s32) -> s32 {
    var any = -1
    for i in 0..nobjs {
        let o = &objs[i]
        if o.used == 0 || o.room as s32 != r || OBJ_USE[o.t as s32] as s32 != use { continue }
        if o.state & OS_BROKEN != 0 { any = i; continue }
        return i
    }
    return any
}

// Back to the room: the next thing planned, else something to do there.
fn go_room(i: s32) {
    let p = &people[i]
    if p.room < 0 { return }
    if p.nplan > 0 && plan_next(i) { return }
    room_activity(i)
}

// A moment's look round the room by the bed (when nothing else is there to do).
fn look_around(i: s32) {
    let p = &people[i]
    let b = room_obj(p.room as s32, USE_SLEEP)
    if b < 0 { return }
    p.state = GS_GOTO as u8
    p.act = USE_NONE as u8
    p.obj = -1
    go_to(i, spot_tile(b, 0))
}

fn checkout_due(p: *Person) -> bool {
    return (day & 255) == p.shift as s32 && hour() >= 10
}

// ---- deciding

var dec_n: [16]s32               // stats: decisions by outcome (tests)

fn guest_decide(i: s32) {
    let p = &people[i]
    dec_n[0] += 1
    if p.room < 0 { guest_leave(i); return }
    if checkout_due(p) || (day & 255) == ((p.shift as s32 + 1) & 255) {
        start_checkout(i)
        return
    }
    // a routine under way (unpacking, the morning wash, getting ready for bed)
    if p.nplan > 0 && plan_next(i) { return }
    let h = hour()
    // bedtime: wash up first, then bed
    if (h >= 22 || h < 6) && p.needs[N_SLEEP] < 200 {
        if p.rbits & RB_BEDTIME == 0 {
            p.rbits = p.rbits | RB_BEDTIME
            plan_set(i, USE_WASH, USE_SLEEP, 0)
            if plan_next(i) { return }
        }
        if try_use(i, USE_SLEEP, true) { return }
    }
    // mealtimes: breakfast, lunch and dinner in the restaurant (room service if it's full)
    let meal = (h >= 7 && h < 10) || (h >= 12 && h < 14) || (h >= 18 && h < 21)
    if meal && p.needs[N_HUNGER] < 215 && kitchen_open() {
        dec_n[1] += 1
        if try_use(i, USE_EAT, false) { dec_n[2] += 1; return }
        if p.needs[N_HUNGER] < 150 && try_use(i, USE_PHONE, true) { dec_n[3] += 1; return }
    }
    // evenings at the bar (grown-ups, when they aren't starving or exhausted)
    if h >= 19 && h < 24 && p.type as s32 != GT_FAMILY && p.needs[N_HUNGER] > 80 && p.needs[N_SLEEP] > 80 && p.needs[N_FUN] < 235 && rnd(3) != 0 {
        dec_n[4] += 1
        if try_drink(i) { dec_n[5] += 1; return }
        if rnd(2) == 0 && try_browse(i) { return }
    }
    // the lowest need (hunger only counts between meals when it's bad)
    var need = -1
    var low = 150
    for k in 0..4 {
        var v = p.needs[k] as s32
        if k == N_HUNGER && !meal { v = v + 60 }
        if v < low {
            low = v
            need = k
        }
    }
    if need == N_SLEEP && h >= 8 && h < 20 && low > 60 { need = N_FUN }
    if need == N_SLEEP { if try_use(i, USE_SLEEP, true) { return } }
    if need == N_HUNGER { if want_food(i) { return } }
    if need == N_HYGIENE {
        if want_wash(i) { return }
        complain(i, CP_BROKEN, 5)
    }
    if need == N_FUN || need < 0 {
        if want_fun(i) { return }
    }
    // nothing pressing: by day, out and about where people can see them (the lobby, the pool,
    // the gardens); otherwise back to the room for a while
    p.timer = (300 + rnd(600)) as s16
    if h >= 9 && h < 22 {
        let r = rnd(10)
        if r < 4 && try_browse(i) { return }
        if r < 7 && try_use(i, USE_SIT, false) { return }
        if r < 8 && h < 19 && try_use(i, USE_LOUNGE, false) { return }
        if r < 9 && try_browse(i) { return }
    } else if rnd(3) == 0 {
        if try_use(i, USE_SIT, false) { return }
    }
    dec_n[6] += 1
    go_room(i)
}

// Wandering over to look at something: a fountain, a tree, the piano, a palm by the pool (the
// bar's jukebox in the evening), and standing there a few minutes. True if off they go.
fn try_browse(i: s32) -> bool {
    let p = &people[i]
    if nobjs == 0 { return false }
    let h = hour()
    for tries in 0..10 {
        let k = rnd(nobjs)
        let o = &objs[k]
        if o.used == 0 { continue }
        let t = o.t as s32
        if t != OB_FOUNTAIN && t != OB_INDOOR_TREE && t != OB_PLANT && t != OB_PIANO && t != OB_PALM &&
           t != OB_JUKEBOX && t != OB_UMBRELLA && t != OB_ARCADE && t != OB_WAITING_SOFA { continue }
        let r = o.room as s32
        if r <= 0 || rooms[r].flags & RF_VALID == 0 { continue }
        let rt = rooms[r].rtype as s32
        var ok = rt == RT_LOBBY || rt == RT_OUTDOOR || rt == RT_POOL || rt == RT_CORRIDOR
        if rt == RT_BAR { ok = h >= 18 || h < 2 }
        if rt == RT_RESTAURANT { ok = !(h >= 12 && h < 14) && !(h >= 18 && h < 21) }
        if (rt == RT_OUTDOOR || rt == RT_POOL) && (h < 9 || h >= 20) { ok = false }
        if !ok { continue }
        // a free tile beside it
        let w = obj_gw(t, o.rot as s32)
        let d = obj_gd(t, o.rot as s32)
        let f = o.f as s32
        var x = o.x as s32
        var z = o.z as s32
        match rnd(4) {
            0 => { x = x + rnd(w); z = z - 1 }
            1 => { x = x + rnd(w); z = z + d }
            2 => { x = x - 1; z = z + rnd(d) }
            else => { x = x + w; z = z + rnd(d) }
        }
        if !in_lot(x, z) { continue }
        let tt = tix(f, x, z)
        let pb = pass[tt] as s32
        if pb & PB_WALK == 0 || pb & (PB_STAFF | PB_PRIVATE) != 0 || !idle_tile_free(tt) { continue }
        if troom[tt] as s32 != r { continue }
        p.act = ACT_BROWSE as u8
        p.obj = k as s16
        p.spot = -1
        p.state = GS_GOTO as u8
        go_to_pt(i, tt, tile_cx(tt) + fixed(rnd(7) - 3) / 20, tile_cz(tt) + fixed(rnd(7) - 3) / 20)
        return true
    }
    return false
}

fn want_food(i: s32) -> bool {
    let p = &people[i]
    let starving = p.needs[N_HUNGER] < 50
    // breakfast and dinner at the restaurant, otherwise room service, the bar, a snack
    if kitchen_open() {
        if try_use(i, USE_EAT, false) { return true }
        if try_use(i, USE_PHONE, true) { return true }
    }
    if try_use(i, USE_MINIBAR, true) { return true }
    if try_drink(i) { return true }
    if try_use(i, USE_SNACK, false) { return true }
    // nothing open: wait for the morning, grumbling if it gets bad
    if starving { complain(i, CP_NOFOOD, 12) }
    p.needs[N_HUNGER] = max(p.needs[N_HUNGER] as s32, 110) as u8
    return false
}

fn want_fun(i: s32) -> bool {
    let p = &people[i]
    let gt = p.type as s32
    let h = hour()
    match gt {
        0 => {   // business: work online, the gym, a drink in the evening
            if rnd(2) == 0 {
                if try_use(i, USE_MODEM, true) { return true }
                complain(i, CP_NOWIFI, 6)
            }
            if try_use(i, USE_MEET, false) { return true }
            if h >= 18 && try_drink(i) { return true }
            if try_use(i, USE_GYM, false) { return true }
        }
        1 => {   // family: the pool, games, TV
            if h >= 9 && h < 19 {
                if try_swim(i) { return true }
                if try_use(i, USE_LOUNGE, false) { return true }
                complain(i, CP_NOPOOL, 8)
            }
            if try_use(i, USE_PLAY, false) { return true }
        }
        2 => {   // honeymooners: their jacuzzi, the spa, the pool, the bar
            if try_use(i, USE_HOTTUB, true) { return true }
            if try_use(i, USE_MASSAGE, false) || try_use(i, USE_HOTTUB, false) || try_use(i, USE_SAUNA, false) { return true }
            if rnd(2) == 0 { complain(i, CP_NOSPA, 8) }
            if h >= 9 && h < 19 && try_use(i, USE_LOUNGE, false) { return true }
            if h >= 19 && try_drink(i) { return true }
        }
        else => {  // rock star: the bar, music, and the minibar
            if try_drink(i) { return true }
            if try_use(i, USE_MUSIC, false) { return true }
            if try_use(i, USE_MINIBAR, true) { return true }
        }
    }
    if p.last as s32 != USE_TV && tv_watch(i) { return true }
    if try_use(i, USE_MUSIC, false) { return true }
    if try_use(i, USE_LOUNGE, false) { return true }
    complain(i, CP_NOFUN, 6)
    p.needs[N_FUN] = 160
    return false
}

// Rooms where each kind of use is found (guests don't eat in the kitchen).
fn use_room_ok(use: s32, rt: s32) -> bool {
    match use {
        6 => return rt == RT_RESTAURANT || rt == RT_OUTDOOR || rt == RT_POOL || rt == RT_BAR
        7 => return rt == RT_BAR || rt == RT_POOL || rt == RT_OUTDOOR || rt == RT_LOBBY
        12, 13 => return rt == RT_SPA
        33 => return rt == RT_SPA || rt == RT_POOL || rt == RT_OUTDOOR
        2, 3, 4, 5 => return rt == RT_BATHROOM
        14 => return rt == RT_GYM
        15 => return rt == RT_CONFERENCE
        11 => return rt == RT_POOL || rt == RT_OUTDOOR
        else => return rt != RT_KITCHEN && rt != RT_LAUNDRY && rt != RT_STORAGE && rt != RT_STAFF && rt != RT_SERVICE
    }
}

// Finds the nearest free object for a use and walks there. own: only in the guest's room.
fn try_use(i: s32, use: s32, own: bool) -> bool { return try_use_in(i, use, own, -1, use) }

// A drink: at the bar (a stool), else at a table in a bar (the bartender brings it).
fn try_drink(i: s32) -> bool {
    if try_use(i, USE_DRINK, false) { return true }
    return try_use_in(i, USE_EAT, false, RT_BAR, USE_DRINK)
}

// try_use, only in rooms of type `rt` (-1: any), doing `act` there.
fn try_use_in(i: s32, use: s32, own: bool, rt_only: s32, act: s32) -> bool {
    let p = &people[i]
    var best = -1
    var bd = 0x7FFFFFFF
    let px = p.x as s32
    let pz = p.z as s32
    for k in 0..nobjs {
        let o = &objs[k]
        if o.used == 0 { continue }
        let t = o.t as s32
        if OBJ_USE[t] as s32 != use { continue }
        if spot_mask[k] as s32 + 1 >= (1 << max(OBJ_NSPOT[t] as s32, 1)) { continue }
        // a bar counter's spot with a stool on it is the stool's seat
        if t == OB_BAR_COUNTER && tobj[spot_tile(k, 0)] >= 0 { continue }
        if o.state & OS_BROKEN != 0 { continue }
        let r = o.room as s32
        if own {
            // their room, or its en-suite
            if r_grp[r] as s32 != p.room as s32 { continue }
        } else {
            let rt = rooms[r].rtype as s32
            if r == 0 || rooms[r].flags & RF_VALID == 0 { continue }
            if rt == RT_GUEST || rt == RT_SUITE || r_host[r] != 0 { continue }
            if !use_room_ok(use, rt) { continue }
            if rt_only >= 0 && rt != rt_only { continue }
        }
        let d = abs(o.x as s32 - px) + abs(o.z as s32 - pz) + abs(o.f as s32 - p.f as s32) * 24
        if d < bd {
            bd = d
            best = k
        }
    }
    if best < 0 {
        // only a broken one around?
        return false
    }
    let s = free_spot(best)
    if s < 0 { return false }
    claim_spot(i, best, s)
    p.act = act as u8
    p.state = GS_GOTO as u8
    go_to(i, spot_tile(best, s))
    return true
}

fn try_swim(i: s32) -> bool {
    let p = &people[i]
    // a deck tile next to pool water, in a valid pool
    for r in 1..nrooms {
        let rm = &rooms[r]
        if rm.used == 0 || rm.rtype as s32 != RT_POOL { continue }
        let f = rm.floor as s32
        var tries = 0
        while tries < 12 {
            tries += 1
            let x = rm.x0 as s32 + rnd(rm.x1 as s32 - rm.x0 as s32 + 1)
            let z = rm.z0 as s32 + rnd(rm.z1 as s32 - rm.z0 as s32 + 1)
            if tflag[tix(f, x, z)] & TF_WATER == 0 { continue }
            // a walkable neighbour
            for d in 0..4 {
                var nx = x
                var nz = z
                if d == 0 { nx = x + 1 }
                if d == 1 { nx = x - 1 }
                if d == 2 { nz = z + 1 }
                if d == 3 { nz = z - 1 }
                if walkable(f, nx, nz) && room_at(f, nx, nz) == r {
                    p.act = 200
                    p.obj = -1
                    p.sto = tix(f, x, z) as s16
                    p.state = GS_GOTO as u8
                    go_to(i, tix(f, nx, nz))
                    return true
                }
            }
        }
    }
    return false
}

fn kitchen_open() -> bool {
    // a cook at a stove and a waiter on shift
    var cook = false
    for k in 0..nobjs {
        let o = &objs[k]
        if o.used != 0 && o.t as s32 == OB_STOVE && station_served(k) { cook = true }
    }
    return cook && waiters_on_duty() > 0
}

fn use_time(use: s32) -> s16 {
    let m = MIN_FRAMES
    match use {
        1 => return (m * 600) as s16
        2 => return (m * 5) as s16
        3 => return (m * 3) as s16
        4 => return (m * 15) as s16
        5 => return (m * 30) as s16
        6 => return (m * 35) as s16
        7 => return (m * 25) as s16
        8 => return (m * 60) as s16
        9 => return (m * 80) as s16
        10 => return (m * 45) as s16
        11 => return (m * 90) as s16
        12 => return (m * 50) as s16
        13 => return (m * 25) as s16
        14 => return (m * 40) as s16
        15 => return (m * 120) as s16
        16 => return (m * 30) as s16
        17 => return (m * 2) as s16
        18 => return (m * 5) as s16
        30 => return (m * 30) as s16
        32 => return (m * 4) as s16
        33 => return (m * 35) as s16
        34 => return (m * 30) as s16
        else => return (m * 10) as s16
    }
}

fn start_use(i: s32) {
    let p = &people[i]
    let use = p.act as s32
    if use == 200 {
        // hop into the pool
        p.sfrom = p.tile
        p.state = GS_SWIM as u8
        p.timer = (MIN_FRAMES * 40) as s16
        script_move(i, M_HOP, tile_cx(p.sto as s32), tile_cz(p.sto as s32), 14)
        p.dir = dir_toward(p.x, p.z, p.ex, p.ez) as u8
        p.hold = 0
        fx_at(FX_SPLASH, p.f as s32)
        return
    }
    if use == ACT_BROWSE {
        // having a look at something (or people-watching, chatting), a few minutes
        let oi = p.obj as s32
        if oi >= 0 && objs[oi].used != 0 { face_obj(i, oi); p.seat = oi as s16; p.sspot = -1 }
        p.obj = -1
        p.state = GS_USE as u8
        p.pose = POSE_STAND as u8
        p.timer = (MIN_FRAMES * (6 + rnd(12))) as s16
        return
    }
    if use == ACT_WAIT_BATH {
        // outside a busy shared bathroom, facing its door, until something's free (a few minutes)
        p.state = GS_USE as u8
        p.pose = POSE_STAND as u8
        let b = p.wroom as s32
        if b > 0 {
            p.dir = dir_toward(p.x, p.z, fixed(rooms[b].x0 as s32 + rooms[b].x1 as s32 + 1) / 2, fixed(rooms[b].z0 as s32 + rooms[b].z1 as s32 + 1) / 2) as u8
            p.hold = 0
        }
        p.timer = (MIN_FRAMES * (4 + rnd(4))) as s16
        return
    }
    if use == ACT_WINDOW {
        // looking out of the window a while (p.sfrom: the window's side, 0..3)
        p.state = GS_USE as u8
        p.pose = POSE_STAND as u8
        p.dir = p.sfrom as u8
        p.hold = 0
        p.timer = (MIN_FRAMES * (4 + rnd(6))) as s16
        return
    }
    if use == USE_NONE {
        // arrived at the room with nothing to do there: a short look round
        p.state = GS_USE as u8
        p.act = USE_NONE as u8
        p.timer = (MIN_FRAMES * 4) as s16
        if p.room >= 0 && rooms[p.room as s32].state as s32 == RS_DIRTY { complain(i, CP_DIRTY, 3) }
        return
    }
    let oi = p.obj as s32
    if oi < 0 || objs[oi].used == 0 || objs[oi].state & OS_BROKEN != 0 {
        if oi >= 0 { complain(i, CP_BROKEN, 10) }
        release_obj(i)
        p.state = GS_IDLE as u8
        return
    }
    if p.room >= 0 && objs[oi].room as s32 == p.room as s32 && rooms[p.room as s32].state as s32 == RS_DIRTY && use != USE_SLEEP {
        complain(i, CP_DIRTY, 3)
    }
    let orm = objs[oi].room as s32
    if orm > 0 && rooms[orm].rtype as s32 == RT_BATHROOM && r_host[orm] == 0 && rooms[orm].state as s32 == RS_DIRTY { complain(i, CP_SHAREDBATH, 3) }
    // face the object (or, on a seat, away from it), and settle onto it
    face_obj(i, oi)
    p.pose = POSE_USE as u8
    if use == USE_SLEEP || use == USE_LOUNGE || use == USE_MASSAGE || use == USE_BATH || use == ACT_NAP { p.pose = POSE_LIE as u8 }
    if use == USE_SIT || use == USE_EAT || use == USE_DRINK || use == USE_WORK || use == USE_MODEM || use == USE_TV ||
       use == USE_MEET || use == USE_PHONE || use == ACT_BED_SIT { p.pose = POSE_SIT as u8 }
    if use == USE_HOTTUB || use == USE_SAUNA { p.pose = POSE_SWIM as u8 }
    if use == USE_DRINK && objs[oi].t as s32 == OB_BAR_COUNTER { p.pose = POSE_STAND as u8 }
    if use == USE_SIT || use == ACT_BED_SIT { face_front(i, oi) }
    // out of sight in the shower or on the toilet; a bob at the wardrobe or the sink, a nod at the desk
    if use == USE_SHOWER || use == USE_TOILET { p.hide = 1 }
    if use == USE_DRESS || use == USE_WASH { p.gest = GEST_BOB as u8 }
    if use == USE_WORK || use == USE_MODEM { p.gest = GEST_NOD as u8 }
    if use == USE_TV && p.seat >= 0 && objs[p.seat as s32].used != 0 {
        // on the bed or the sofa, facing the screen
        let so = p.seat as s32
        settle(i, so, max(p.sspot as s32, 0), USE_SIT, false)
        let c = obj_centre(oi)
        p.dir = dir_toward(p.x + p.sox, p.z + p.soz, c.x, c.z) as u8
        p.hold = 0
    } else {
        settle(i, oi, max(p.spot as s32, 0), use, p.pose as s32 == POSE_LIE)
    }
    p.timer = use_time(use)
    if use == ACT_NAP { p.timer = (MIN_FRAMES * (25 + rnd(30))) as s16 }
    if use == ACT_BED_SIT { p.timer = (MIN_FRAMES * (8 + rnd(14))) as s16 }
    if use == USE_DRESS { p.timer = (MIN_FRAMES * (5 + rnd(6))) as s16 }
    if use == USE_TV { p.timer = (MIN_FRAMES * (30 + rnd(40))) as s16 }
    if use == USE_SLEEP && p.room >= 0 {
        let h = hour()
        if h >= 20 || h < 6 {
            // until morning (some are early birds, some lie in)
            var mins = 6 * 60 + 15 + (i * 37 + day * 11) % 135 - minute()
            if mins < 0 { mins += DAY_MIN }
            p.timer = min(mins * MIN_FRAMES, 32000) as s16
        }
        // a stripped bed?
        if objs[oi].state & OS_DIRTY != 0 { complain(i, CP_DIRTY, 10) }
    }
    if use == USE_EAT {
        p.state = GS_WAIT_FOOD as u8
        p.timer = 0
        place_order(i, oi)
        return
    }
    if use == USE_PHONE {
        fx_at(FX_PHONE, p.f as s32)
        p.state = GS_WAIT_FOOD as u8
        p.timer = 0
        place_order(i, oi)
        return
    }
    if use == USE_DRINK || use == USE_MASSAGE {
        p.state = GS_WAIT_SERVE as u8
        p.timer = 0
        return
    }
    if use == USE_MODEM { fx_at(FX_MODEM, p.f as s32) }
    p.state = GS_USE as u8
}

// Where a person using spot s of object oi sits or lies: people_vis (ox, oz) eases there.
// Lying: along the middle of the bed (lounger, massage bed) column beside the spot. Sitting: part
// of the way from the spot onto the object (a sofa seat, a chair at a table).
fn seat_for(i: s32, oi: s32, s: s32, use: s32) {
    let p = &people[i]
    let o = &objs[oi]
    let t = o.t as s32
    let lx = OBJ_SPOT[(t * 5 + s) * 2] as s32
    let lz = OBJ_SPOT[(t * 5 + s) * 2 + 1] as s32
    let w = OBJ_W[t] as s32
    let d = OBJ_D[t] as s32
    let u = clamp(lx, 0, w - 1)
    let v = clamp(lz, 0, d - 1)
    var su = fixed(lx)
    var sv = fixed(lz)
    var pull = 0.0
    var lie = p.pose as s32 == POSE_LIE
    match use {
        1, 5, 11, 12 => lie = true
        30 => pull = 0.62
        6 => pull = 0.28
        33, 13 => pull = 0.7
        7 => { if t == OB_BAR_COUNTER { pull = 0.1 } else if OBJ_USE[t] as s32 == USE_EAT { pull = 0.28 } }
        9, 10, 31, 8 => pull = 0.2
        else => pull = 0.0
    }
    if lie {
        su = fixed(u)
        sv = fixed(d - 1) / 2
    } else {
        su = su + (fixed(u) - su) * pull
        sv = sv + (fixed(v) - sv) * pull
    }
    obj_local_pt(oi, su, sv)
    p.sox = lp_x - p.x
    p.soz = lp_z - p.z
}

// Faces the way object oi faces (sitting on it).
fn face_front(i: s32, oi: s32) {
    let p = &people[i]
    obj_local_pt(oi, 0.0, 0.0)
    let x0 = lp_x
    let z0 = lp_z
    obj_local_pt(oi, 0.0, 1.0)
    p.dir = dir_toward(x0, z0, lp_x, lp_z) as u8
    p.hold = 0
}

fn face_obj(i: s32, oi: s32) {
    let p = &people[i]
    p.hold = 0
    let c = obj_centre(oi)
    let dx = c.x - p.x
    let dz = c.z - p.z
    if abs(dx) > abs(dz) {
        if dx > 0.0 { p.dir = 0 } else { p.dir = 2 }
    } else {
        if dz > 0.0 { p.dir = 1 } else { p.dir = 3 }
    }
}

// Is someone serving at a station object (bar counter, massage bed, stove...)?
fn station_served(oi: s32) -> bool {
    let o = &objs[oi]
    if obj_flag(o.t as s32, F_STATION) { return desk_staffed(oi) }
    // bar stools: any staffed counter in the same room
    let r = o.room as s32
    for k in 0..nobjs {
        let c = &objs[k]
        if c.used != 0 && c.room as s32 == r && c.t as s32 == OB_BAR_COUNTER && desk_staffed(k) { return true }
    }
    return false
}

fn finish_use(i: s32) {
    let p = &people[i]
    let use = p.act as s32
    let oi = p.obj as s32
    let gt = p.type as s32
    let seat0 = p.seat as s32
    match use {
        1 => {
            p.needs[N_SLEEP] = 255
            p.needs[N_HYGIENE] = sat_sub(p.needs[N_HYGIENE], 40)
            // a good night's sleep in a clean, quiet room
            if hour() >= 6 && hour() < 11 && p.complaints & (CP_NOISE | CP_DIRTY) == 0 { praise(i, PR_ROOM, 5) }
            // up: the bathroom, then dressed
            p.rbits = p.rbits & ~RB_BEDTIME
            if hour() >= 5 && hour() < 12 { plan_set(i, USE_TOILET, USE_SHOWER, USE_DRESS) }
        }
        2 => p.needs[N_HYGIENE] = sat_add(p.needs[N_HYGIENE], 50)
        3 => p.needs[N_HYGIENE] = sat_add(p.needs[N_HYGIENE], 40)
        4 => p.needs[N_HYGIENE] = 255
        5 => {
            p.needs[N_HYGIENE] = 255
            p.needs[N_FUN] = sat_add(p.needs[N_FUN], 40)
            if oi >= 0 && r_host[objs[oi].room as s32] != 0 { praise(i, PR_BATH, 6) }
        }
        36 => p.needs[N_FUN] = sat_add(p.needs[N_FUN], 10)
        205 => p.needs[N_FUN] = sat_add(p.needs[N_FUN], 25)
        206 => p.needs[N_FUN] = sat_add(p.needs[N_FUN], 30)
        207 => p.needs[N_SLEEP] = sat_add(p.needs[N_SLEEP], 80)
        6 => {
            p.needs[N_HUNGER] = 255
            praise(i, PR_FOOD, 6)
        }
        7 => {
            p.needs[N_FUN] = sat_add(p.needs[N_FUN], 110)
            p.needs[N_HUNGER] = sat_add(p.needs[N_HUNGER], 40)
            earn_from(i, LG_BAR, ECO_DRINK)
            if gt == GT_ROCKSTAR { praise(i, PR_ROCK, 15) } else { praise(i, PR_BAR, 6) }
        }
        8, 16, 30, 34 => p.needs[N_FUN] = sat_add(p.needs[N_FUN], 100)
        202 => p.needs[N_FUN] = sat_add(p.needs[N_FUN], 45)
        9 => p.needs[N_FUN] = sat_add(p.needs[N_FUN], 70)
        10 => {
            p.needs[N_FUN] = sat_add(p.needs[N_FUN], 120)
            if gt == GT_BUSINESS { praise(i, PR_WIFI, 10) }
        }
        11 => {
            p.needs[N_FUN] = sat_add(p.needs[N_FUN], 140)
            praise(i, PR_POOL, 5)
        }
        12 => {
            p.needs[N_FUN] = 255
            p.needs[N_HYGIENE] = sat_add(p.needs[N_HYGIENE], 50)
            earn_from(i, LG_SPA, ECO_MASSAGE)
            praise(i, PR_SPA, 15)
        }
        13, 33 => {
            p.needs[N_FUN] = sat_add(p.needs[N_FUN], 150)
            earn_from(i, LG_SPA, ECO_HOTTUB)
            praise(i, PR_SPA, 6)
        }
        14 => {
            p.needs[N_FUN] = sat_add(p.needs[N_FUN], 100)
            p.needs[N_HYGIENE] = sat_sub(p.needs[N_HYGIENE], 60)
        }
        15 => {
            p.needs[N_FUN] = sat_add(p.needs[N_FUN], 90)
            earn_from(i, LG_OTHER, ECO_MEETING)
        }
        17 => {
            p.needs[N_HUNGER] = sat_add(p.needs[N_HUNGER], 80)
            earn_from(i, LG_FOOD, ECO_SNACK)
        }
        18 => {
            p.needs[N_HUNGER] = sat_add(p.needs[N_HUNGER], 30)
            p.needs[N_SLEEP] = sat_add(p.needs[N_SLEEP], 40)
        }
        32 => {
            p.needs[N_HUNGER] = sat_add(p.needs[N_HUNGER], 60)
            earn_from(i, LG_FOOD, ECO_MINIBAR)
            // rock stars trash the minibar
            if gt == GT_ROCKSTAR && oi >= 0 && rnd(3) == 0 { break_obj(oi) }
        }
        else => {}
    }
    if oi >= 0 { wear_obj(oi, i) }
    if oi >= 0 && use >= USE_TOILET && use <= USE_BATH { bath_used(oi) }
    if use == USE_TV && gt == GT_ROCKSTAR && oi >= 0 && rnd(4) == 0 && !security_near(p.room as s32) {
        break_obj(oi)
        praise(i, PR_ROCK, 10)
    }
    release_obj(i)
    p.pose = POSE_STAND as u8
    p.state = GS_IDLE as u8
    p.last = use as u8
    p.act = 0
    // the companion gets up too
    let c = p.party as s32
    var so = oi
    if seat0 >= 0 { so = seat0 }
    if c >= 0 && people[c].used != 0 && people[c].party as s32 == i && (people[c].obj as s32 == oi || (so >= 0 && people[c].obj as s32 == so)) {
        release_obj(c)
        people[c].pose = POSE_STAND as u8
    }
}

fn sat_add(v: u8, k: s32) -> u8 { return min(v as s32 + k, 255) as u8 }
fn sat_sub(v: u8, k: s32) -> u8 { return max(v as s32 - k, 0) as u8 }

fn earn_from(i: s32, cat: s32, v: s32) {
    let p = &people[i]
    earn(cat, v)
    p.spent += v as s16
}

// Wear: things break now and then; badly kept ones sooner.
fn wear_obj(oi: s32, i: s32) {
    let o = &objs[oi]
    let w = o.wear as s32 + 4 + rnd(8)
    if w >= 255 {
        o.wear = 255
        break_obj(oi)
    } else {
        o.wear = w as u8
    }
}

fn break_obj(oi: s32) {
    let o = &objs[oi]
    if o.state & OS_BROKEN != 0 { return }
    o.state = o.state | OS_BROKEN
    fx_at(FX_BREAK, o.f as s32)
    repair_job(oi)
}

fn start_checkout(i: s32) {
    let p = &people[i]
    release_obj(i)
    let d = find_reception()
    p.state = GS_CHECKOUT as u8
    p.act = 0
    p.pose = POSE_STAND as u8
    p.timer = 0
    p.ht = 0
    if d < 0 {
        pay_bill(i)
        guest_leave(i)
        return
    }
    queue_join(i, d)
}

fn pay_bill(i: s32) {
    let p = &people[i]
    if p.room < 0 { return }
    let rm = &rooms[p.room as s32]
    let price = room_price(p.room as s32)
    let nights = max(p.nights as s32, 1)
    earn_from(i, LG_ROOMS, price * nights)
    fx_at(FX_CASH, p.f as s32)
    // value for money
    if price > p.budget as s32 { p.mood -= ((price - p.budget as s32) / 4) as s16 }
    rm.occupant = -1
    rm.state = RS_DIRTY as u8
    // the beds need fresh linen
    for k in 0..nobjs {
        let o = &objs[k]
        if o.used != 0 && o.room as s32 == p.room as s32 && OBJ_USE[o.t as s32] as s32 == USE_SLEEP { o.state = o.state | OS_DIRTY }
    }
    clean_job(p.room as s32)
    p.room = -1
    guests_served += 1
}

// ---- in the room, and the bathroom

// Plans: a short routine done in order (USE_* kinds, 0 = none), e.g. unpack on arrival, toilet,
// shower and dress in the morning, wash before bed.
fn plan_set(i: s32, a: s32, b: s32, c: s32) {
    let p = &people[i]
    p.nplan = 0
    if a != 0 { p.plan[p.nplan as s32] = a as u8; p.nplan += 1 }
    if b != 0 { p.plan[p.nplan as s32] = b as u8; p.nplan += 1 }
    if c != 0 { p.plan[p.nplan as s32] = c as u8; p.nplan += 1 }
}

// Starts the next planned thing that can be done (dropping those that can't). True if off they go.
fn plan_next(i: s32) -> bool {
    let p = &people[i]
    while p.nplan > 0 {
        let u = p.plan[0] as s32
        for k in 0..3 { p.plan[k] = p.plan[k + 1] }
        p.nplan -= 1
        if plan_try(i, u) { return true }
    }
    return false
}

fn plan_try(i: s32, u: s32) -> bool {
    if u >= USE_TOILET && u <= USE_BATH { return bath_use(i, u) }
    if u == USE_TV { return tv_watch(i) }
    return try_use(i, u, true)
}

// Something to do in the room: the TV from the bed or sofa, the desk, a chair, the window, a nap,
// the minibar, the bathroom, or just sitting on the bed. Off they go (always: at worst a short
// look round the room).
fn room_activity(i: s32) {
    let p = &people[i]
    if p.room < 0 { return }
    let gt = p.type as s32
    let h = hour()
    var w: [8]s32
    w[0] = 30                                        // TV
    if gt == GT_FAMILY { w[0] = 45 }
    if gt == GT_BUSINESS { w[0] = 18 }
    if h >= 20 { w[0] += 15 }
    w[1] = 8                                         // the desk
    if gt == GT_BUSINESS { w[1] = 30 }
    w[2] = 14                                        // a sofa, an armchair or a chair
    w[3] = 7                                         // the window
    w[4] = 0                                         // a nap
    if p.needs[N_SLEEP] < 170 { w[4] = 30 }
    w[5] = 0                                         // the minibar
    if p.needs[N_HUNGER] < 160 { w[5] = 12 }
    w[6] = 10                                        // sitting on the bed
    w[7] = 0                                         // the toilet
    if p.needs[N_HYGIENE] < 230 { w[7] = 8 }
    // not the same again straight away
    let last = p.last as s32
    if last == USE_TV { w[0] = w[0] / 4 }
    if last == USE_WORK { w[1] = w[1] / 4 }
    if last == USE_SIT { w[2] = w[2] / 4 }
    if last == ACT_WINDOW { w[3] = 0 }
    if last == ACT_NAP { w[4] = 0 }
    if last == ACT_BED_SIT { w[6] = w[6] / 4 }
    for tries in 0..4 {
        var tot = 0
        for k in 0..8 { tot += w[k] }
        if tot <= 0 { break }
        var r = rnd(tot)
        var k = 0
        while k < 7 && r >= w[k] { r -= w[k]; k += 1 }
        var ok = false
        match k {
            0 => ok = tv_watch(i)
            1 => ok = try_use(i, USE_WORK, true)
            2 => ok = try_use(i, USE_SIT, true)
            3 => ok = try_window(i)
            4 => ok = try_bed(i, ACT_NAP)
            5 => ok = try_use(i, USE_MINIBAR, true)
            6 => ok = try_bed(i, ACT_BED_SIT)
            else => ok = bath_try(i, USE_TOILET)
        }
        if ok { return }
        w[k] = 0
    }
    if try_bed(i, ACT_BED_SIT) { return }
    look_around(i)
}

// Watching TV: the room's TV, from a sofa or armchair if there is one, else from the bed.
fn tv_watch(i: s32) -> bool {
    let p = &people[i]
    if p.room < 0 { return false }
    let rm = p.room as s32
    var tv = -1
    var seat = -1
    var ss = -1
    var bed = -1
    var bs = -1
    for k in 0..nobjs {
        let o = &objs[k]
        if o.used == 0 || r_grp[o.room as s32] as s32 != rm || o.state & OS_BROKEN != 0 { continue }
        let u = OBJ_USE[o.t as s32] as s32
        if u == USE_TV && spot_mask[k] == 0 && tv < 0 { tv = k }
        if u == USE_SIT && o.t as s32 != OB_CHAIR && seat < 0 {
            let s = free_spot(k)
            if s >= 0 { seat = k; ss = s }
        }
        if u == USE_SLEEP && bed < 0 {
            let s = free_spot(k)
            if s >= 0 { bed = k; bs = s }
        }
    }
    if tv < 0 { return false }
    if seat < 0 { seat = bed; ss = bs }
    claim_spot(i, tv, 0)
    p.act = USE_TV as u8
    p.state = GS_GOTO as u8
    if seat >= 0 {
        claim_seat(i, seat, ss)
        go_to(i, spot_tile(seat, ss))
    } else {
        go_to(i, spot_tile(tv, 0))
    }
    return true
}

// On the bed: a nap (lying down) or a sit on its edge.
fn try_bed(i: s32, act: s32) -> bool {
    let p = &people[i]
    if p.room < 0 { return false }
    for k in 0..nobjs {
        let o = &objs[k]
        if o.used == 0 || o.room as s32 != p.room as s32 || OBJ_USE[o.t as s32] as s32 != USE_SLEEP || o.state & OS_BROKEN != 0 { continue }
        let s = free_spot(k)
        if s < 0 { continue }
        claim_spot(i, k, s)
        p.act = act as u8
        p.state = GS_GOTO as u8
        go_to(i, spot_tile(k, s))
        return true
    }
    return false
}

// A companion waits on the bed (sitting on its edge) while the leader is busy in room `r`.
fn companion_bed(i: s32, r: s32) -> bool {
    let p = &people[i]
    for k in 0..nobjs {
        let o = &objs[k]
        if o.used == 0 || o.room as s32 != r || OBJ_USE[o.t as s32] as s32 != USE_SLEEP { continue }
        let s = free_spot(k)
        if s < 0 { continue }
        claim_spot(i, k, s)
        p.act = ACT_BED_SIT as u8
        go_to(i, spot_tile(k, s))
        return true
    }
    return false
}

// To the window: a free tile of the room beside a window, facing out.
fn try_window(i: s32) -> bool {
    let p = &people[i]
    let r = p.room as s32
    if r < 0 || rooms[r].windows == 0 { return false }
    let rm = &rooms[r]
    let f = rm.floor as s32
    let w = rm.x1 as s32 - rm.x0 as s32 + 1
    let d = rm.z1 as s32 - rm.z0 as s32 + 1
    let n = w * d
    let k0 = rnd(n)
    for k in 0..n {
        let q = (k0 + k) % n
        let x = rm.x0 as s32 + q % w
        let z = rm.z0 as s32 + q / w
        let t = tix(f, x, z)
        if troom[t] as s32 != r || tobj[t] >= 0 || pass[t] as s32 & PB_WALK == 0 { continue }
        for dd in 0..4 {
            var dx = 0
            var dz = 0
            match dd {
                0 => dx = 1
                1 => dz = 1
                2 => dx = -1
                else => dz = -1
            }
            if edge_feat(f, x, z, dx, dz) != EF_WINDOW { continue }
            p.act = ACT_WINDOW as u8
            p.obj = -1
            p.sfrom = dd as s16
            p.state = GS_GOTO as u8
            go_to_pt(i, t, tile_cx(t) + fixed(dx) * 0.3, tile_cz(t) + fixed(dz) * 0.3)
            return true
        }
    }
    return false
}

// Seats a person using spot s of object oi: on a bed (lying, or sitting on its foot end), else as
// seat_for does.
const BED_SIT_Y = 0.12
const BED_HEAD_V = -0.12
fn settle(i: s32, oi: s32, s: s32, use: s32, lie: bool) {
    let p = &people[i]
    let t = objs[oi].t as s32
    if OBJ_USE[t] as s32 != USE_SLEEP {
        seat_for(i, oi, s, use)
        return
    }
    let lx = OBJ_SPOT[(t * 5 + s) * 2] as s32
    let u = clamp(lx, 0, OBJ_W[t] as s32 - 1)
    let d = OBJ_D[t] as s32
    if lie {
        // the head on the pillow (the bed's back end), the blanket over the rest
        obj_local_pt(oi, fixed(u), BED_HEAD_V)
        p.sy = 0.0
    } else {
        obj_local_pt(oi, fixed(u), fixed(d - 1) + 0.18)
        p.sy = BED_SIT_Y
    }
    p.sox = lp_x - p.x
    p.soz = lp_z - p.z
}

// The bathroom: an en-suite, the fixtures in the room of an old save, or a shared one.
fn bath_try(i: s32, use: s32) -> bool {
    let p = &people[i]
    let r = p.room as s32
    if r < 0 { return false }
    let bk = r_bath[r] as s32
    if bk >= BATH_ENSUITE { return try_use(i, use, true) }
    if bk == BATH_SHARED { return try_use_in(i, use, false, RT_BATHROOM, use) }
    return false
}

// A wash when hygiene is low: a bath (honeymooners love their tub), a shower, at least the sink;
// with everything shared taken, wait outside.
fn want_wash(i: s32) -> bool {
    let p = &people[i]
    let r = p.room as s32
    if r >= 0 && r_bath[r] as s32 == BATH_ENSUITE_TUB && (p.type as s32 == GT_HONEYMOON || rnd(3) == 0) && bath_try(i, USE_BATH) { return true }
    if bath_try(i, USE_SHOWER) || bath_try(i, USE_BATH) || bath_try(i, USE_WASH) { return true }
    return bath_queue(i, USE_SHOWER)
}

// One fixture (from a plan): that one, a bath for a shower, or wait for a shared one.
fn bath_use(i: s32, use: s32) -> bool {
    if bath_try(i, use) { return true }
    if use == USE_SHOWER && bath_try(i, USE_BATH) { return true }
    return bath_queue(i, use)
}

// Shared bathrooms are busy: wait by the door of the nearest one on this floor with that fixture.
fn bath_queue(i: s32, use: s32) -> bool {
    let p = &people[i]
    let r = p.room as s32
    if r < 0 || r_bath[r] as s32 != BATH_SHARED { return false }
    var best = -1
    var bd = 0x7FFFFFFF
    for b in 1..nrooms {
        let rm = &rooms[b]
        if rm.used == 0 || rm.rtype as s32 != RT_BATHROOM || r_host[b] != 0 || rm.floor != p.f { continue }
        if !bath_has(b, use) { continue }
        let d = abs(rm.x0 as s32 - p.x as s32) + abs(rm.z0 as s32 - p.z as s32)
        if d < bd { bd = d; best = b }
    }
    if best < 0 { return false }
    var t = bath_door_out(best)
    if t < 0 { return false }
    // spread out round the door: the k-th one waiting takes the k-th open tile beside it
    var n = 0
    for j in 0..npeople { if j != i && people[j].used != 0 && people[j].act as s32 == ACT_WAIT_BATH && people[j].wroom as s32 == best { n += 1 } }
    let f = p.f as s32
    let x0 = ptile_x(t)
    let z0 = ptile_z(t)
    var k = n % 5
    for dd in 0..4 {
        if k == 0 { break }
        var x = x0
        var z = z0
        match dd {
            0 => x = x0 + 1
            1 => x = x0 - 1
            2 => z = z0 + 1
            else => z = z0 - 1
        }
        if !in_lot(x, z) || !walkable(f, x, z) || room_at(f, x, z) == best || !bath_public(room_at(f, x, z)) || !near_open(t, tix(f, x, z)) { continue }
        k -= 1
        if k == 0 { t = tix(f, x, z) }
    }
    complain(i, CP_SHAREDBATH, 8)
    p.act = ACT_WAIT_BATH as u8
    p.obj = -1
    p.want = use as u8
    p.wroom = best as s16
    p.state = GS_GOTO as u8
    go_to_pt(i, t, tile_cx(t) + fixed(rnd(9) - 4) / 14, tile_cz(t) + fixed(rnd(9) - 4) / 14)
    return true
}

fn bath_has(b: s32, use: s32) -> bool {
    if use == USE_TOILET { return rcount[b][OB_TOILET] > 0 }
    if use == USE_WASH { return rcount[b][OB_SINK] > 0 }
    if use == USE_BATH { return rcount[b][OB_BATHTUB] > 0 }
    return rcount[b][OB_SHOWER] > 0 || rcount[b][OB_BATHTUB] > 0
}

// A free, working fixture for `use` in bathroom b?
fn bath_free(b: s32, use: s32) -> bool {
    if b <= 0 { return true }
    for k in 0..nobjs {
        let o = &objs[k]
        if o.used == 0 || o.room as s32 != b || o.state & OS_BROKEN != 0 || spot_mask[k] != 0 { continue }
        let u = OBJ_USE[o.t as s32] as s32
        if u == use || (use == USE_SHOWER && u == USE_BATH) { return true }
    }
    return false
}

// The public tile outside a door of bathroom b (-1: none).
fn bath_door_out(b: s32) -> s32 {
    let rm = &rooms[b]
    let f = rm.floor as s32
    for z in rm.z0 as s32..rm.z1 as s32 + 1 {
        for x in rm.x0 as s32..rm.x1 as s32 + 1 {
            if room_at(f, x, z) != b { continue }
            for dd in 0..4 {
                var dx = 0
                var dz = 0
                match dd {
                    0 => dx = 1
                    1 => dz = 1
                    2 => dx = -1
                    else => dz = -1
                }
                if edge_feat(f, x, z, dx, dz) != EF_DOOR || !in_lot(x + dx, z + dz) { continue }
                let o = room_at(f, x + dx, z + dz)
                if o == b || !bath_public(o) || !walkable(f, x + dx, z + dz) { continue }
                return tix(f, x + dx, z + dz)
            }
        }
    }
    return -1
}

// After a bathroom fixture was used: it wants a wipe; a shared bathroom wants cleaning every few
// uses (an en-suite is cleaned with its bedroom).
var bath_uses: [200]u8
fn bath_used(oi: s32) {
    let o = &objs[oi]
    o.state = o.state | OS_DIRTY
    let b = o.room as s32
    if b <= 0 || rooms[b].rtype as s32 != RT_BATHROOM || r_host[b] != 0 { return }
    bath_uses[b] = min(bath_uses[b] as s32 + 1, 255) as u8
    if bath_uses[b] as s32 >= ECO_BATH_DIRTY_USES && rooms[b].state as s32 != RS_DIRTY {
        rooms[b].state = RS_DIRTY as u8
        clean_job(b)
    }
}

// Browsing a while: turn to chat with someone standing about nearby, else look back at the thing
// (p.seat) or glance round.
fn browse_look(i: s32) {
    let p = &people[i]
    p.gest = GEST_NONE as u8
    for j in 0..npeople {
        let q = &people[j]
        if j == i || q.used == 0 || q.f != p.f || q.mode as s32 != M_STAND { continue }
        if abs(q.x - p.x) > 1.6 || abs(q.z - p.z) > 1.6 { continue }
        if q.kind as s32 == P_GUEST && (q.state as s32 == GS_USE || q.state as s32 == GS_FOLLOW) && q.pose as s32 == POSE_STAND {
            p.dir = dir_toward(p.x, p.z, q.x, q.z) as u8
            p.hold = 0
            p.gest = GEST_BOB as u8
            return
        }
    }
    let oi = p.seat as s32
    if oi >= 0 && objs[oi].used != 0 && rnd(3) != 0 { face_obj(i, oi); return }
    p.dir = ((p.dir as s32 + 1 + rnd(2) * 2) & 3) as u8
    p.hold = 0
}

// ---- reviews

fn write_review(i: s32) {
    let p = &people[i]
    if p.state as s32 == GS_FOLLOW { return }
    if p.spent == 0 && p.complaints & CP_RECEPTION == 0 { return }
    var s10 = ECO_REVIEW_BASE + p.mood as s32 / 3
    // needs left unmet sour the stay
    for k in 0..4 { if p.needs[k] < 60 { s10 -= 4 } }
    let st = clamp((s10 + 5) / 10, 1, 5)
    if TEST != 0 {
        print("review: mood ")
        print_int(p.mood as s32)
        print(" cp ")
        print_hex(p.complaints)
        print(" pr ")
        print_hex(p.praise)
        print(" needs")
        for k in 0..4 { print(" "); print_int(p.needs[k] as s32) }
        print(" -> ")
        print_int(st)
        println("")
    }
    var q = RV_OK
    let c = p.complaints
    let pr = p.praise
    if c & CP_RECEPTION != 0 { q = RV_NO_RECEPTION }
    else if c & CP_NOROOM != 0 { q = RV_NO_ROOM }
    else if c & CP_DIRTY != 0 { q = RV_DIRTY }
    else if c & CP_NOISE != 0 { q = RV_NOISY }
    else if c & CP_BROKEN != 0 { q = RV_BROKEN }
    else if c & CP_HUNGRY != 0 { q = RV_HUNGRY }
    else if c & CP_NOFOOD != 0 { q = RV_NO_FOOD }
    else if c & CP_PRICE != 0 { q = RV_TOO_PRICEY }
    else if c & CP_NOSUITE != 0 { q = RV_NO_SUITE }
    else if c & CP_SHAREDBATH != 0 && p.mood < 20 { q = RV_SHARED_BATH }
    else if c & CP_NOWIFI != 0 { q = RV_NO_WIFI }
    else if c & CP_NOPOOL != 0 { q = RV_NO_POOL }
    else if c & CP_NOSPA != 0 { q = RV_NO_SPA }
    else if c & CP_SLOW != 0 { q = RV_SLOW }
    else if c & CP_LOST != 0 { q = RV_LOST }
    else if c & CP_NOFUN != 0 { q = RV_NO_FUN }
    if st >= 4 || q == RV_OK {
        if pr & PR_ROCK != 0 { q = RV_ROCK_TRASH }
        else if pr & PR_VIEW != 0 { q = RV_GREAT_VIEW }
        else if pr & PR_SPA != 0 { q = RV_GREAT_SPA }
        else if pr & PR_BATH != 0 && rnd(2) == 0 { q = RV_GREAT_BATH }
        else if pr & PR_FOOD != 0 { q = RV_GREAT_FOOD }
        else if pr & PR_POOL != 0 { q = RV_GREAT_POOL }
        else if pr & PR_SERVICE != 0 { q = RV_GREAT_SERVICE }
        else if pr & PR_WIFI != 0 { q = RV_GREAT_WIFI }
        else if pr & PR_BAR != 0 { q = RV_GREAT_BAR }
        else if pr & PR_ROOM != 0 { q = RV_GREAT_ROOM }
    }
    add_review(p.type as s32, st, q)
}

// ---- needs

fn guest_minute(i: s32) {
    let p = &people[i]
    let h = hour()
    // tired slowly by day, faster late at night
    var every = 4
    if h >= 21 || h < 6 { every = 2 }
    if p.act as s32 != USE_SLEEP && (tod / MIN_FRAMES + i) % every == 0 { p.needs[N_SLEEP] = sat_sub(p.needs[N_SLEEP], 1) }
    if rnd(3) != 0 && p.act as s32 != USE_SLEEP { p.needs[N_HUNGER] = sat_sub(p.needs[N_HUNGER], 1) }
    if rnd(3) == 0 { p.needs[N_HYGIENE] = sat_sub(p.needs[N_HYGIENE], 1) }
    if p.act as s32 != USE_SLEEP && (tod / MIN_FRAMES + i) % 3 != 0 { p.needs[N_FUN] = sat_sub(p.needs[N_FUN], 1) }
    // grand spaces lift the mood: standing under an atrium
    if p.f as s32 + 1 < NFL && p.state as s32 != GS_LEAVE {
        let t = p.tile as s32 + NT
        if t < NTT && tflag[t] & TF_VOID != 0 && p.praise & PR_VIEW == 0 { praise(i, PR_VIEW, 6) }
    }
}
