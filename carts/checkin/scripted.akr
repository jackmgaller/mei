}

fn rooms_after_update() {}

// A suite: 6 x 4 at (x0, z0), door on the north edge at x0 + 3.
fn s_suite(f: s32, x0: s32, z0: s32, fk: s32) {
    s_room(f, fk, x0, z0, x0 + 5, z0 + 3)
    s_door(f, x0 + 3, z0, 0, -1)
    s_obj(OB_BED_KING, f, x0 + 4, z0 + 2, 2)
    s_obj(OB_WARDROBE, f, x0, z0 + 3, 1)
    s_obj(OB_BATHTUB, f, x0, z0 + 1, 0)
    s_obj(OB_TOILET, f, x0, z0, 1)
    s_obj(OB_SINK, f, x0 + 5, z0, 3)
    s_obj(OB_TV, f, x0 + 2, z0, 0)
    s_obj(OB_PHONE, f, x0 + 2, z0 + 3, 2)
    s_obj(OB_LOUNGE_CHAIR, f, x0 + 3, z0 + 3, 2)
}

