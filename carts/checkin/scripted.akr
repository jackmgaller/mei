}

// Checks n guests straight into free rooms (a busy hotel, for tests and the demo).
fn s_fill_guests(n: s32) {
    for k in 0..n {
        let gt = pick_guest_type()
        var r = -1
        for rr in 1..nrooms {
            let rm = &rooms[rr]
            if rm.used != 0 && rm.flags & RF_VALID != 0 && rm.occupant < 0 && (rm.rtype as s32 == RT_GUEST || rm.rtype as s32 == RT_SUITE) { r = rr; break }
        }
        if r < 0 { return }
        let b = room_obj(r, USE_SLEEP)
        if b < 0 { continue }
        let t = spot_tile(b, 0)
        let i = person_new(P_GUEST, gt, ptile_f(t), ptile_x(t), ptile_z(t))
        if i < 0 { return }
        let p = &people[i]
        p.budget = 400
        p.nights = (1 + rnd(3)) as u8
        p.room = r as s16
        p.mood = 20
        p.state = GS_IDLE as u8
        p.shift = ((day + p.nights as s32) & 255) as u8
        rooms[r].occupant = i as s16
        rooms[r].state = RS_OCCUPIED as u8
        for q in 0..4 { p.needs[q] = (60 + rnd(190)) as u8 }
    }
}

fn s_north_suite(x0: s32) {
    s_room(5, FK_WOOD, x0, 6, x0 + 7, 9)
    s_door(5, x0 + 3, 9, 0, 1)
    s_obj(OB_BED_KING, 5, x0, 6, 0)
    s_obj(OB_WARDROBE, 5, x0 + 2, 6, 0)
    s_obj(OB_TV, 5, x0 + 3, 6, 0)
    s_obj(OB_PHONE, 5, x0 + 4, 6, 0)
    s_obj(OB_SINK, 5, x0 + 5, 6, 0)
    s_obj(OB_TOILET, 5, x0 + 6, 6, 0)
    s_obj(OB_BATHTUB, 5, x0 + 7, 6, 2)
    s_obj(OB_LOUNGE_CHAIR, 5, x0 + 7, 9, 3)
    s_window(5, x0 + 1, 6, 0, -1)
    s_window(5, x0 + 5, 6, 0, -1)
}
