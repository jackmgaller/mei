    s_room(0, FK_WOOD, 20, 2, 27, 9)                  // bar
    s_door(0, 23, 9, 0, 1)
    s_obj(OB_BAR_COUNTER, 0, 21, 4, 2)
    s_obj(OB_BAR_COUNTER, 0, 22, 4, 2)
    s_obj(OB_BAR_COUNTER, 0, 23, 4, 2)
    s_obj(OB_BAR_STOOL, 0, 21, 3, 0)
    s_obj(OB_BAR_STOOL, 0, 22, 3, 0)
    s_obj(OB_BAR_STOOL, 0, 23, 3, 0)
    s_obj(OB_BAR_SHELF, 0, 21, 6, 2)
    s_obj(OB_JUKEBOX, 0, 20, 9, 1)
    s_obj(OB_TABLE_2, 0, 25, 4, 0)
    s_obj(OB_TABLE_2, 0, 25, 7, 0)
    s_obj(OB_ARCADE, 0, 27, 2, 0)
    s_obj(OB_FLOOR_LAMP, 0, 27, 5, 0)
    s_room(0, FK_TILE, 4, 12, 9, 15)                  // kitchen
    s_door(0, 6, 12, 0, -1)
    s_obj(OB_STOVE, 0, 4, 15, 2)
    s_obj(OB_FRIDGE, 0, 5, 15, 2)
    s_obj(OB_STOVE, 0, 6, 15, 2)
    s_obj(OB_PREP_COUNTER, 0, 7, 14, 2)
    s_obj(OB_STORAGE_SHELF, 0, 9, 15, 2)
    s_obj(OB_STORAGE_SHELF, 0, 4, 12, 0)
    s_obj(OB_KITCHEN_SINK, 0, 9, 12, 0)
    s_room(0, FK_CONCRETE, 10, 12, 13, 15)            // laundry
