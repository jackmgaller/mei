    hire(ROLE_RECEPTIONIST, 0)
    hire(ROLE_RECEPTIONIST, 0)
    hire(ROLE_RECEPTIONIST, 1)
    for k in 0..5 { hire(ROLE_HOUSEKEEPER, 0) }
    hire(ROLE_HOUSEKEEPER, 1)
    hire(ROLE_COOK, 0)
    hire(ROLE_COOK, 0)
    hire(ROLE_COOK, 1)
    hire(ROLE_WAITER, 0)
    hire(ROLE_WAITER, 0)
    hire(ROLE_WAITER, 1)
    hire(ROLE_BARTENDER, 0)
    hire(ROLE_BARTENDER, 1)
    hire(ROLE_THERAPIST, 0)
    hire(ROLE_BELLHOP, 0)
    hire(ROLE_BELLHOP, 0)
    hire(ROLE_MAINTENANCE, 0)
    hire(ROLE_MAINTENANCE, 1)
    hire(ROLE_SECURITY, 1)
}

// Checks n guests straight into free rooms (a busy hotel, for tests and the demo).
fn s_fill_guests(n: s32) {
    for k in 0..n {
        let gt = pick_guest_type()
        var r = -1
        for rr in 1..nrooms {
            let rm = &rooms[rr]
            if rm.used != 0 && rm.flags & RF_VALID != 0 && rm.occupant < 0 && (rm.rtype as s32 == RT_GUEST || rm.rtype as s32 == RT_SUITE) { r = rr; break }
        }
        if r < 0 { return }
        let b = room_obj(r, USE_SLEEP)
        if b < 0 { continue }
        let t = spot_tile(b, 0)
        let i = person_new(P_GUEST, gt, ptile_f(t), ptile_x(t), ptile_z(t))
        if i < 0 { return }
        let p = &people[i]
        p.budget = 400
        p.nights = (1 + rnd(3)) as u8
        p.room = r as s16
        p.mood = 20
        p.state = GS_IDLE as u8
        p.shift = ((day + p.nights as s32) & 255) as u8
        rooms[r].occupant = i as s16
        rooms[r].state = RS_OCCUPIED as u8
        for q in 0..4 { p.needs[q] = (60 + rnd(190)) as u8 }
    }
}


// The demo hotel grown the way a player would for the third star (balance tests: see
// tests/scen_sim.akr 427): room service phones in every room, and a pool deck by the bar.
fn s_upgrade_demo() {
    // a phone by the door of every south room
    for f in 0..2 {
        for k in 0..6 {
            tp_set(4 + k * 4, 11, 4, false, k == 5)
            tp_obj(OB_PHONE, f, 3, 0, 3, 0, 0)
        }
    }
    s_room(0, FK_DECK, 28, 3, 30, 12)
    s_room(0, FK_POOL_WATER, 29, 5, 30, 7)
    s_door(0, 27, 5, 1, 0)
    s_obj(OB_LOUNGER, 0, 28, 9, 0)
    s_obj(OB_LOUNGER, 0, 30, 9, 2)
    s_obj(OB_UMBRELLA, 0, 29, 11, 0)
    s_obj(OB_PALM, 0, 30, 3, 0)
    rooms_refresh_all = true                      // (the edits are on G and F1, whatever the view)
    rooms_update()
    rooms_finish()
}
