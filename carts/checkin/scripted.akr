    s_obj(OB_TABLE_2, 0, 7, 3, 0)
    s_obj(OB_TABLE_2, 0, 7, 7, 0)
    s_obj(OB_TABLE_2, 0, 5, 3, 0)
    s_obj(OB_PLANT, 0, 9, 2, 0)
