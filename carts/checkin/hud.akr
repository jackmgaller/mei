// The HUD: a slim top bar and the cursor are all that is on screen by default. Everything else
// comes on demand or when something needs attention: the tool strip (only with a tool), the info
// card (A on a room, person or object; B or moving away closes it), toasts, first-time hints,
// the first-goal card, the overlay picker (SELECT held), and small effects in the world (dust
// puffs, money popups, "room complete!" labels). Also the debug counters.
// Owner: workstream B (UI). See CONTRACT.md.

const BAR_H = 14

// ---- the top bar

var hud_money: s32               // money shown (counts toward the real value)
var hud_delta: s32               // the latest change, shown for a moment
var hud_delta_t: s32
var hud_last: s32
var speed_flash: s32
var hud_speed: s32 = -1

fn hud_update() {
    if hud_speed != speed {
        if hud_speed >= 0 { speed_flash = 30 }
        hud_speed = speed
    }
    if speed_flash > 0 { speed_flash -= 1 }
    // a change of the real value shows as "+$120" / "-$1,200" for a moment
    if money != hud_last {
        let ch = money - hud_last
        if abs(ch) >= 20 && abs(ch) < 1000000 && screen == Screen.Play {
            if hud_delta_t > 0 && sgn(ch) == sgn(hud_delta) { hud_delta += ch } else { hud_delta = ch }
            hud_delta_t = 90
        }
        hud_last = money
    }
    // the shown value counts toward the real one
    let d = money - hud_money
    if abs(d) < 8 || abs(d) > 1000000 { hud_money = money } else { hud_money += d / 4 }
    if hud_delta_t > 0 { hud_delta_t -= 1 }
}

// A small speed glyph: two bars (paused) or 1, 2 or 3 play triangles.
fn speed_glyph(x: s32, y: s32, c: u32) -> s32 {
    if speed == 0 {
        ui_rect(x, y, 2, 7, c, -1)
        ui_rect(x + 4, y, 2, 7, c, -1)
        return x + 7
    }
    var n = 1
    if speed == 2 { n = 2 }
    if speed >= 4 { n = 3 }
    var xx = x
    for k in 0..n {
        ui_tri(xx, y, xx, y + 7, xx + 4, y + 3, c, -1)
        ui_rect(xx, y + 3, 5, 1, c, -1)
        xx += 5
    }
    return xx + 1
}

fn draw_top_bar() {
    ui_rect(0, 0, 320, BAR_H - 1, ST_HUD_BAR, -1)
    ui_rect(0, BAR_H - 1, 320, 1, ST_HUD_LINE, -1)
    // money (and its latest change)
    var mx = ftext(5, 3, money_s(hud_money), ST_GOLD, false)
    if hud_delta_t > 0 {
        let b = nb()
        if hud_delta > 0 { sappend(b, "+") }
        smoney(b, hud_delta)
        var c = ST_OK
        if hud_delta < 0 { c = ST_BAD }
        if hud_delta_t < 20 { c = clerp(ST_HUD_BAR, c, fixed(hud_delta_t) / 20) }
        mx = ftext(mx + 5, 3, b, c, false)
    }
    // stars: only the lit ones
    var sx = 112
    if stars == 0 {
        ftext(sx, 3, "unrated", DIM, false)
    } else {
        for i in 0..stars { sx = glyph(sx, 3, 15) }
    }
    // the clock and the speed
    let clk = fmt_clock()
    let cw = text_w(clk, false)
    ftext(246 - cw, 3, clk, ST_TEXT, false)
    var sc = ST_TEXT
    if speed_flash > 0 {
        ui_rect(250, 1, 22, 11, ST_CURSOR, (speed_flash / 4) % 2)
        sc = ST_CURSOR
    }
    if speed == 0 { sc = ST_CURSOR }
    speed_glyph(253, 3, sc)
    // the floor badge (slides when the floor changes)
    draw_floor_badge()
}

fn floor_label(f: s32) -> *u8 {
    let b = nb()
    if f == 0 { sappend(b, "G") } else {
        sappend(b, "F")
        sint(b, f)
    }
    return b
}

fn draw_floor_badge() {
    let x = 296
    ui_rect(x - 4, 1, 26, 11, ST_PANEL, -1)
    if tr_badge_t > 0 {
        // the old label slides out, the new one in
        let k = 12 - tr_badge_t
        var d = 1
        if view_floor < tr_floor_from { d = -1 }
        let off = k * 10 / 12
        if 10 - off > 2 { ftext_c(x + 9, 3 - off * d, floor_label(tr_floor_from), ST_TEXT_DIM, false) }
        ftext_c(x + 9, 3 + (10 - off) * d, floor_label(view_floor), ST_CURSOR, false)
        ui_rect(x - 4, 0, 26, 1, ST_HUD_BAR, -1)
        ui_rect(x - 4, BAR_H - 1, 26, 3, ST_HUD_LINE, -1)
        return
    }
    ftext_c(x + 9, 3, floor_label(view_floor), ST_TEXT, false)
}

fn draw_hud() {
    draw_top_bar()
    if screen != Screen.Play { return }
    draw_toasts()
    if !menu_open {
        draw_tool_strip()
        draw_goal_card()
    }
    draw_hint()
    if held_in(SELECT) && sel_held > 10 { draw_overlay_picker() }
}

// ---- the tool strip: one line with button glyphs, only while a tool is in use

fn strip_text() -> *u8 {
    let h = nb()
    match tool {
        Paint => {
            if tool_rt >= 0 {
                sappend(h, room_type_name(tool_rt))
                sappend(h, " \x17 ")
                sappend(h, finish_name(tool_arg))
            } else {
                sappend(h, str_of(FLOORK_NAME_OFF[tool_arg] as s32))
            }
            sappend(h, "   \x01 hold and drag   \x02 done")
        }
        Object => {
            sappend(h, obj_name(tool_arg))
            sappend(h, "   \x01 place   \x04 turn   \x02 done")
        }
        Door => sappend(h, "Door   \x01 on a wall   \x04 other wall   \x02 done")
        Window => sappend(h, "Window   \x01 on an outside wall   \x02 done")
        Void => sappend(h, "Void   \x01 drag on an upper floor   \x02 done")
        VoidGlass => sappend(h, "Glass void   \x01 drag on an upper floor   \x02 done")
        Demolish => sappend(h, "Demolish   \x01 an object, or drag over floors   \x02 done")
        Copy => sappend(h, "Copy   \x01 a room, or hold and drag over rooms   \x02 done")
        Paste => sappend(h, "Paste   \x01 paste   \x04 turn   \x05 \x06 floor   \x02 done")
        Inspect => {}
    }
    return h
}

fn draw_tool_strip() {
    if tool == Tool.Inspect { return }
    let h = strip_text()
    let w = text_w(h, false) + 12
    panel_glass(160 - w / 2, 226, w, 13)
    ftext(160 - w / 2 + 6, 228, h, ST_TEXT, false)
}

// ---- toasts: slide in under the top bar, at most two, then fade

struct Toast { s: *u8, c: u32, t: s32 }
var toasts: [2]Toast
var toast_buf: [2][96]u8
var toast_slot: s32

const TOAST_T = 170

fn toast(s: *u8, c: u32) {
    // the same message again just restarts it
    for k in 0..2 {
        if toasts[k].t > 0 && toasts[k].c == c && str_eq(toasts[k].s, s) {
            toasts[k].t = max(toasts[k].t, TOAST_T - 6)
            if c == RED { cu_shake = 8 }
            return
        }
    }
    // the newest goes on top: move the other down
    toasts[1] = toasts[0]
    toast_slot = 1 - toast_slot
    let b = &toast_buf[toast_slot][0]
    b[0] = 0
    sappend(b, s)
    toasts[0].s = b
    toasts[0].c = c
    toasts[0].t = TOAST_T
    if c == RED { cu_shake = 8 }
}

fn str_eq(a: *u8, b: *u8) -> bool {
    var k = 0
    while a[k] != 0 && a[k] == b[k] { k += 1 }
    return a[k] == b[k]
}

fn toasts_update() {
    for k in 0..2 { if toasts[k].t > 0 { toasts[k].t -= 1 } }
    if toasts[0].t == 0 && toasts[1].t > 0 {
        toasts[0] = toasts[1]
        toasts[1].t = 0
    }
}

fn draw_toasts() {
    var y = BAR_H + 4
    for k in 0..2 {
        let tt = toasts[k]
        if tt.t <= 0 { continue }
        let age = TOAST_T - tt.t
        let w = text_w(tt.s, false) + 14
        var yy = y
        if age < 6 { yy -= (6 - age) * 3 }
        var c = tt.c
        if c == CREAM || c == WHITE || c == SOFT || c == AQUA { c = ST_TEXT }
        if tt.t < 16 { c = clerp(ST_PANEL, c, fixed(tt.t) / 16) }
        if tt.t >= 10 || k > 0 {
            panel(160 - w / 2, yy, w, 14)
            // a coloured mark at the left: what kind of message
            var mc = ST_TEXT_DIM
            if tt.c == RED { mc = ST_BAD }
            if tt.c == GOLD { mc = ST_GOLD }
            if tt.c == GREEN { mc = ST_OK }
            ui_rect(160 - w / 2 + 3, yy + 4, 3, 6, mc, -1)
            ftext(160 - w / 2 + 9, yy + 3, tt.s, c, false)
        }
        y += 17
    }
}

// ---- first-time hints (once per session each)

const HINT_ROOMS = 1
const HINT_PAINT = 2
const HINT_OBJECT = 4
const HINT_DOOR = 8
const HINT_INFO = 16

var hints_seen: s32
var hint_buf: [96]u8
var hint_t: s32

fn hint_once(id: s32, s: *u8) {
    if hints_seen & id != 0 { return }
    hints_seen = hints_seen | id
    hint_show(s)
}

fn hint_show(s: *u8) {
    hint_buf[0] = 0
    sappend(&hint_buf[0], s)
    hint_t = 300
}

fn draw_hint() {
    if hint_t <= 0 { return }
    hint_t -= 1
    let s = &hint_buf[0]
    let w = text_w(s, false) + 22
    var y = 210
    if tool == Tool.Inspect { y = 224 }
    if menu_open { y = DRAWER_Y - 17 }
    var c = ST_TEXT
    if hint_t < 16 { c = clerp(ST_PANEL, c, fixed(hint_t) / 16) }
    if hint_t < 6 { return }
    panel(160 - w / 2, y, w, 13)
    ftext(160 - w / 2 + 4, y + 2, "?", ST_CURSOR, false)
    ftext(160 - w / 2 + 14, y + 2, s, c, false)
}

// ---- the first-goal card (a new hotel, until the first lobby is complete)

var first_flow: bool

fn draw_goal_card() {
    if !first_flow { return }
    if count_type(RT_LOBBY) > 0 {
        first_flow = false
        return
    }
    if tool != Tool.Inspect || info_kind != 0 { return }
    let x = 6
    let y = 182
    panel(x, y, 132, 36)
    ftext(x + 5, y + 3, "First: build a Lobby", ST_GOLD, false)
    ftext(x + 5, y + 14, "\x03 Rooms \x16 Lobby, then", ST_TEXT, false)
    ftext(x + 5, y + 24, "hold \x01 and drag on the lot", ST_TEXT, false)
    // an arrow on the ground where guests come in from the street
    draw_entrance_arrow()
}

fn draw_entrance_arrow() {
    if view_floor != 0 { return }
    let bob = fixed((tick_count / 12) % 4) * 0.12
    if !project(vec3(16.5, 0.05, 2.3 + bob)) { return }
    let ax = proj_x
    let ay = proj_y
    if !project(vec3(16.5, 0.05, 1.5 + bob)) { return }
    let bx = proj_x
    let by = proj_y
    // a chevron pointing from the road into the lot
    let dx = ax - bx
    let dy = ay - by
    ui_tri(ax + dx / 2, ay + dy / 2, bx + dy, by - dx, bx - dy, by + dx, ST_SHADOW, -1)
    ui_tri(ax + dx / 2, ay + dy / 2 - 1, bx + dy, by - dx - 1, bx - dy, by + dx - 1, ST_CURSOR, -1)
    ftext_c(bx, by + 6, "Entrance", ST_TEXT, false)
}

// ---- the overlay picker (SELECT held): d-pad picks a view

var sel_held: s32

fn draw_overlay_picker() {
    let x = 160
    let y = 180
    panel(x - 62, y - 34, 124, 68)
    ftext_c(x, y - 31, "Show", ST_TEXT_DIM, false)
    ov_choice(x, y - 18, "\x13 Rooms", OV_ROOMS)
    ov_choice(x + 30, y - 4, "Noise \x16", OV_NOISE)
    ov_choice(x - 30, y - 4, "\x15 Moods", OV_MOOD)
    ov_choice(x, y + 10, "\x14 Staff", OV_STAFF)
    ftext_c(x, y + 22, "release: speed", ST_TEXT_DIM, false)
}

fn ov_choice(cx: s32, y: s32, s: *u8, ov: s32) {
    var c = ST_TEXT
    if overlay == ov {
        c = ST_CURSOR
        let w = text_w(s, false)
        ui_sel(cx - w / 2 - 3, y - 2, w + 6, 12)
    }
    ftext_c(cx, y, s, c, false)
}

// ---- the info card (A in inspect mode): a person, an object or a room, until B or moving away

var info_kind: s32               // 0 none, 1 room, 2 person, 3 object
var info_id: s32
var info_tx: s32                 // the cursor tile it was opened on
var info_tz: s32
var info_open: bool              // (legacy name: true while a card is shown)

fn inspect_press() {
    if info_kind != 0 {
        info_close()
        fx(FX_BACK)
        return
    }
    let pi = person_on_tile(cur_tx, cur_tz)
    let oi = tobj[tix(view_floor, cur_tx, cur_tz)] as s32
    let r = room_at(view_floor, cur_tx, cur_tz)
    if pi >= 0 {
        info_kind = 2
        info_id = pi
    } else if oi >= 0 {
        info_kind = 3
        info_id = oi
    } else if r != 0 {
        info_kind = 1
        info_id = r
    } else {
        sfx_at(Sfx.Click, 0, 90)
        return
    }
    info_tx = cur_tx
    info_tz = cur_tz
    info_open = true
    fx(FX_OK)
}

fn info_close() {
    info_kind = 0
    info_open = false
}

// The person nearest the centre of tile (x, z), within it.
fn person_on_tile(x: s32, z: s32) -> s32 {
    var best = -1
    var bd = 0.75
    let cx = fixed(x) + 0.5
    let cz = fixed(z) + 0.5
    for i in 0..npeople {
        let p = &people[i]
        if p.used == 0 || p.f as s32 != view_floor || p.mode as s32 == M_HIDDEN || p.mode as s32 == M_RIDE { continue }
        let d = abs(p.x - cx) + abs(p.z - cz)
        if d < bd { bd = d; best = i }
    }
    return best
}

// Closes the card when what it shows is gone or the cursor has moved away from it.
fn info_update() {
    if info_kind == 0 { return }
    if tool != Tool.Inspect || menu_open { info_close(); return }
    if info_kind == 1 {
        if rooms[info_id].used == 0 || room_at(view_floor, cur_tx, cur_tz) != info_id { info_close() }
    } else if info_kind == 2 {
        if people[info_id].used == 0 || people[info_id].f as s32 != view_floor { info_close(); return }
        if cur_tx != info_tx || cur_tz != info_tz { info_close() }
    } else {
        if objs[info_id].used == 0 || tobj[tix(view_floor, cur_tx, cur_tz)] as s32 != info_id { info_close() }
    }
}

const CARD_W = 150

// The card goes on the side of the screen away from the cursor.
fn card_x() -> s32 {
    set_camera()
    if project(vec3(cu_vx, fixed(view_floor) * STOREY, cu_vz)) && proj_x < 160 { return 320 - 6 - CARD_W }
    return 6
}

var card_dy: s32                 // the card moves down to make room for toasts

fn draw_info() {
    let x = card_x()
    var want = 0
    for k in 0..2 { if toasts[k].t > 0 { want += 17 } }
    if card_dy < want { card_dy = min(card_dy + 4, want) }
    if card_dy > want { card_dy = max(card_dy - 2, want) }
    let y = BAR_H + 4 + card_dy
    if tool == Tool.Object {
        // furnishing: the checklist of the room under the cursor, compact
        let r = room_at(view_floor, cur_tx, cur_tz)
        if r != 0 { draw_checklist(r, x, y, true) }
        return
    }
    match info_kind {
        1 => draw_room_card(info_id, x, y)
        2 => draw_person_info(info_id, x, y)
        3 => draw_object_info(info_id, x, y)
        else => {}
    }
}

fn draw_room_card(r: s32, x: s32, y: s32) {
    let rm = &rooms[r]
    let bt = room_target(r)
    let nreq = RT_NREQ[bt] as s32
    let done = rm.flags & RF_VALID != 0 && rm.rtype as s32 != RT_OUTDOOR && room_why(r) != WHY_NO_DOOR
    var h = 28
    if !done && nreq > 0 { h += 4 + nreq * 10 }
    let nb_rows = bath_rows(r, x, 0, false)
    if nb_rows > 0 {
        if done || nreq == 0 { h += 4 }
        h += nb_rows * 10
    }
    h += 12
    panel(x, y, CARD_W, h)
    ftext_r(x + CARD_W - 5, y + h - 12, "\x04 copy room", ST_TEXT_DIM, false)
    var title = "Empty room"
    if rm.rtype as s32 != RT_NONE && (done || rm.rtype as s32 != RT_OUTDOOR) { title = room_type_name(rm.rtype as s32) }
    else if bt != RT_NONE { title = room_type_name(bt) }
    ftext(x + 5, y + 3, title, WHITE, false)
    if done { glyph(x + CARD_W - 12, y + 3, 17) }
    let s = nb()
    let unfinished = !done && bt != RT_NONE && rm.rtype as s32 != RT_CORRIDOR && rm.rtype as s32 != RT_SERVICE
    if unfinished { sappend(s, "Unfinished  \x17  ") }
    sint(s, (rm.ntiles - rm.nvoid) as s32)
    sappend(s, " tiles")
    if !unfinished {
        sappend(s, "  \x17  quality ")
        sint(s, rm.quality as s32)
    }
    ftext(x + 5, y + 14, s, ST_TEXT_DIM, false)
    var ry = y + 30
    if !done && nreq > 0 {
        ui_div(x + 4, y + 26, CARD_W - 8)
        checklist_rows(r, bt, x, y + 30)
        ry += nreq * 10
    } else if nb_rows > 0 {
        ui_div(x + 4, y + 26, CARD_W - 8)
    }
    bath_rows(r, x, ry, true)
}

// ---- bathrooms (C's rooms.akr: room_bath, bath_host, room_why): what a bedroom has, and what a
// bathroom is for. A row with a check, a cross or a dot, and maybe a dim second line.

var bath_sub: *u8

// Room r's bathroom row into b: 0 none, 1 fine (check), 2 missing (cross), 3 worth knowing (dot).
fn bath_row(r: s32, b: *u8) -> s32 {
    bath_sub = ""
    let rt = room_target(r)
    if rt == RT_BATHROOM {
        let h = bath_host(r)
        if h != 0 {
            sappend(b, "En-suite of a ")
            sappend(b, room_type_name(room_target(h)))
            return 1
        }
        if room_why(r) == WHY_NO_DOOR {
            sappend(b, "No door yet")
            bath_sub = "Its door into a bedroom"
            return 2
        }
        sappend(b, "Shared by this floor")
        return 3
    }
    let need = RT_BATH_NEED[rt] as s32
    if need == 0 { return 0 }
    let k = room_bath(r)
    if k == BATH_ENSUITE_TUB {
        sappend(b, "En-suite with a tub")
        return 1
    }
    if k == BATH_ENSUITE {
        if need == 2 {
            sappend(b, "En-suite needs a bathtub")
            return 2
        }
        sappend(b, "En-suite")
        return 1
    }
    if k == BATH_SHARED && need == 1 {
        sappend(b, "Shared bathroom")
        bath_sub = "An en-suite rates higher"
        return 3
    }
    sappend(b, "En-suite: none")
    if room_why(r) == WHY_FIXTURES { bath_sub = "Fixtures go in a Bathroom" }
    else if need == 2 { bath_sub = "A Bathroom with a tub" }
    else { bath_sub = "A Bathroom, door into here" }
    return 2
}

// Draws (or only counts, draw false) room r's bathroom rows from y; returns how many.
fn bath_rows(r: s32, x: s32, y: s32, draw: bool) -> s32 {
    let b = nb()
    let k = bath_row(r, b)
    if k == 0 { return 0 }
    var n = 1
    if bath_sub[0] != 0 { n = 2 }
    if !draw { return n }
    if k == 1 { glyph(x + 5, y + 1, 17) }
    if k == 2 { glyph(x + 6, y + 1, 18) }
    if k == 3 { ui_rect(x + 7, y + 4, 3, 3, ST_TEXT_DIM, -1) }
    var c = ST_TEXT
    if k == 1 { c = ST_TEXT_DIM }
    ftext(x + 15, y, b, c, false)
    if n == 2 { ftext(x + 15, y + 10, bath_sub, ST_TEXT_DIM, false) }
    return n
}

// One requirement as text: "2x Table for two or Table for four" (shortened to fit the card).
fn req_text(rt: s32, k: s32) -> *u8 {
    let t0 = RT_REQ_ALT[(rt * 7 + k) * 3] as s32
    let t1 = RT_REQ_ALT[(rt * 7 + k) * 3 + 1] as s32
    let n = nb()
    let cnt = RT_REQ_CNT[rt * 7 + k] as s32
    if cnt > 1 {
        sint(n, cnt)
        sappend(n, "\x18 ")
    }
    sappend(n, obj_name(t0))
    if t1 != 255 {
        let m = nb()
        sappend(m, n)
        sappend(m, " or ")
        sappend(m, obj_name(t1))
        if text_w(m, false) <= CARD_W - 20 { return m }
        sappend(n, " or similar")
    }
    return n
}

// The rows of a room's checklist from y: a check or a cross, the count and the name.
fn checklist_rows(r: s32, rt: s32, x: s32, y: s32) {
    let nreq = RT_NREQ[rt] as s32
    for k in 0..nreq {
        let yy = y + k * 10
        let ok = req_ok(r, rt, k)
        if ok { glyph(x + 5, yy + 1, 17) } else { glyph(x + 6, yy + 1, 18) }
        var c = ST_TEXT
        if ok { c = ST_TEXT_DIM }
        ftext(x + 15, yy, req_text(rt, k), c, false)
    }
}

// The compact checklist while furnishing; turns green and fades out once the room is done.
fn draw_checklist(r: s32, x: s32, y: s32, compact: bool) {
    let rm = &rooms[r]
    let bt = room_target(r)
    let nreq = RT_NREQ[bt] as s32
    if bt == RT_NONE || nreq == 0 { return }
    let done = rm.flags & RF_VALID != 0 && rm.rtype as s32 != RT_OUTDOOR
    if done {
        if celebrate_room != r || celebrate_t <= 0 || guide_t > 0 { return }
        panel(x, y, CARD_W, 15)
        let b = nb()
        sappend(b, "\x11 ")
        sappend(b, room_type_name(rm.rtype as s32))
        sappend(b, " complete")
        ftext(x + 5, y + 3, b, ST_OK, false)
        return
    }
    let nbr = bath_rows(r, x, 0, false)
    panel(x, y, CARD_W, 17 + (nreq + nbr) * 10)
    let b = nb()
    sappend(b, room_type_name(bt))
    sappend(b, " needs")
    ftext(x + 5, y + 3, b, ST_GOLD, false)
    checklist_rows(r, bt, x, y + 14)
    bath_rows(r, x, y + 14 + nreq * 10, true)
}

// ---- rooms that just became complete: a ding, a label over the room, a toast

var room_was_valid: [200]bool
var celebrate_room: s32
var celebrate_t: s32
var watch_ready: bool

fn rooms_watch() {
    for r in 1..200 {
        let ok = r < nrooms && rooms[r].used != 0 && rooms[r].flags & RF_VALID != 0
        var real = ok
        if ok {
            let t = rooms[r].rtype as s32
            if t == RT_CORRIDOR || t == RT_SERVICE || t == RT_OUTDOOR { real = false }
        }
        if real && !room_was_valid[r] && watch_ready && screen == Screen.Play && !cp_quiet {
            celebrate_room = r
            celebrate_t = 120
            fx(FX_NOTIFY)
            // (while furnishing, the checklist card says so itself)
            if tool != Tool.Object && guide_room == 0 {
                let b = nb()
                sappend(b, room_type_name(rooms[r].rtype as s32))
                sappend(b, " complete!")
                toast(b, GREEN)
            }
            let rm = &rooms[r]
            let cx = (fixed(rm.x0 as s32) + fixed(rm.x1 as s32 + 1)) / 2
            let cz = (fixed(rm.z0 as s32) + fixed(rm.z1 as s32 + 1)) / 2
            popup_text(cx, fixed(rm.floor as s32) * STOREY + 1.2, cz, room_type_name(rooms[r].rtype as s32), ST_OK)
        }
        room_was_valid[r] = real
    }
    watch_ready = true
    cp_quiet = false
}

// ---- effects in the world: dust puffs and floating labels (projected every frame)

struct Fx { x: fixed, y: fixed, z: fixed, t: s32, kind: s32, v: s32, s: *u8, c: u32, size: fixed }
const NFXQ = 12
var fxq: [12]Fx
var fx_next: s32

fn fx_alloc() -> *Fx {
    let e = &fxq[fx_next]
    fx_next = (fx_next + 1) % NFXQ
    return e
}

// A puff of dust at floor level, about `size` tiles across.
fn puff(x: fixed, y: fixed, z: fixed, size: fixed) {
    let e = fx_alloc()
    e.x = x
    e.y = y
    e.z = z
    e.t = 16
    e.kind = 1
    e.size = size
}

fn popup_money(x: fixed, y: fixed, z: fixed, v: s32) {
    if v == 0 { return }
    let e = fx_alloc()
    e.x = x
    e.y = y
    e.z = z
    e.t = 50
    e.kind = 2
    e.v = v
}

fn popup_text(x: fixed, y: fixed, z: fixed, s: *u8, c: u32) {
    let e = fx_alloc()
    e.x = x
    e.y = y
    e.z = z
    e.t = 90
    e.kind = 3
    e.s = s
    e.c = c
}

fn draw_effects() {
    set_camera()
    for k in 0..NFXQ {
        let e = &fxq[k]
        if e.t <= 0 { continue }
        e.t -= 1
        if e.y < fixed(view_floor) * STOREY - 0.5 || e.y > fixed(view_floor + 1) * STOREY + 1.0 { continue }
        if !project(vec3(e.x, e.y, e.z)) { continue }
        if e.kind == 1 {
            // ten specks drifting out and up, shrinking
            let age = 16 - e.t
            let r = (ppu * e.size / 2) as s32 + age * 2 + 2
            let c = clerp(ST_DUST, ST_DUST_DARK, fixed(age) / 16)
            for i in 0..10 {
                let a = fixed(i) * 0.6283 + 0.3
                let rr = r - (i % 3) * 2
                let px = proj_x + (cos(a) * rr) as s32
                let py = proj_y + (sin(a) * rr * 4 / 7) as s32 - age / 2 - (i % 2) * 2
                let s = max(3 - age / 5, 1)
                ui_rect(px, py, s, s, ST_SHADOW, 2)
                ui_rect(px - 1, py - 1, s, s, c, -1)
            }
        } else if e.kind == 2 {
            let age = 50 - e.t
            let b = nb()
            if e.v > 0 { sappend(b, "+") }
            smoney(b, e.v)
            var c = ST_GOLD
            if e.v > 0 { c = ST_OK }
            if e.t < 12 { c = clerp(ST_HUD_BAR, c, fixed(e.t) / 12) }
            let rise = min(age, 20) + age / 4
            ftext_c(proj_x, proj_y - 10 - rise, b, c, false)
        } else {
            let age = 90 - e.t
            var c = e.c
            if e.t < 20 { c = clerp(ST_HUD_BAR, c, fixed(e.t) / 20) }
            let w = text_w(e.s, true) + 12
            var yy = proj_y - 20 - min(age, 10)
            if age < 6 { yy += (6 - age) * 2 }
            panel_glass(proj_x - w / 2, yy - 2, w, 18)
            ftext_c(proj_x, yy, e.s, c, true)
        }
    }
    if celebrate_t > 0 { celebrate_t -= 1 }
}

// ---- the next goal (pause menu and hints)

var goal_text: *u8

fn goal_update() {
    if tick_count % 60 != 0 { return }
    goal_text = null
    if count_type(RT_LOBBY) > 0 && staff_of(ROLE_RECEPTIONIST, -1) == 0 {
        goal_text = "hire a receptionist (START > Staff)"
        return
    }
    if stars < 5 {
        if tier_ok(stars + 1) { goal_text = "another star at the 6:00 rating!" } else { goal_text = tier_missing[stars + 1] }
    }
}

fn money_s(v: s32) -> *u8 { return smoney(nb(), v) }

// CPU and triangle counters (test builds).
fn draw_debug() {
    let b = nb()
    sappend(b, "CPU ")
    sint(b, cpu_used())
    sappend(b, " TRI ")
    sint(b, tris_drawn() + ui_tris)
    sappend(b, " C ")
    sint(b, cache_cycles)
    ui_rect(0, 200, 200, 11, ST_HUD_BAR, -1)
    ftext(2, 201, b, ST_GOLD, false)
}
