// The world: the lot grid, floors, rooms and the walls between them.
//
// The lot is GW x GH tiles; floor 0 is the ground, floors 1..5 above it. Every tile of every
// floor has a floor key (0 = nothing: open air, or bare terrain on the ground floor), a room
// (0 = none) and flags. Walls are not stored: an edge gets a wall where two tiles belong to
// different rooms and the rules below say so (wall_kind). Doors and windows are stored per
// edge. Tile index: t = floor * NT + z * GW + x.

const GW = 32
const GH = 24
const NT = 768               // tiles per floor
const NFL = 6                // floors: ground + 5
const NTT = 4608             // NFL * NT
const STOREY = 3.0           // floor-to-floor height (world units = tiles)

// the lot (CONTRACT.md): road, sidewalk, buildable land, beach, sea
const ROAD_Z = 0
const WALK_Z = 1
const LAND_Z0 = 2
const LAND_Z1 = 17           // last row where rooms may stand
const BEACH_Z1 = 20          // last sand row (decks and pools may go there)
const SEA_Z = 21
const BUILD_X0 = 4
const BUILD_X1 = 27

// tile flags
const TF_VOID = 1            // open to the floor below (atrium)
const TF_GLASS = 2           // a void's edges get glass railings instead of metal ones
const TF_HOLE = 4            // stair opening (from the stairs below)
const TF_WATER = 8           // pool water (not walkable)
const TF_SHAFT = 16          // elevator shaft passes through

// floor kinds (FLOORK_KIND)
const KIND_ROOM = 0
const KIND_CORR = 1
const KIND_SERVICE = 2
const KIND_DECK = 3
const KIND_POOL = 4

// edge features (edge_n: the edge on the -z side of a tile, edge_w: the -x side)
const EF_NONE = 0
const EF_DOOR = 1
const EF_WINDOW = 2

var tfloor: [4608]u8         // floor key + 1 (0: none)
var troom: [4608]u8          // room index (0: none)
var tflag: [4608]u8
var tobj: [4608]s16          // object standing on the tile (-1: none)
var edge_n: [4608]u8
var edge_w: [4608]u8

// ---- rooms

const MAXROOM = 200

struct Room {
    used: u8
    kind: u8                 // KIND_*
    fk: u8                   // floor key
    floor: u8
    rtype: u8                // detected room type (RT_*)
    x0: u8
    z0: u8
    x1: u8
    z1: u8
    pad: u8
    ntiles: s16
    nvoid: s16               // void tiles
    nwater: s16
    quality: s16             // 0..100 from bonus items, size, windows
    noise: s16               // noise heard from neighbours
    view: s16                // atrium / sea view bonus
    flags: u16               // RF_*
    occupant: s16            // guest staying here (-1 none)
    state: u8                // RS_* (clean, dirty, ...)
    nbeds: u8
    windows: u8
    missing: u8              // requirements still missing for the best-matching type
    best: u8                 // best-matching type while incomplete
    price: u16
}

const RF_VALID = 1           // all requirements met
const RF_STAFFED = 2         // its stations are staffed now
const RF_BROKEN = 4          // an essential object is broken
const RF_PENTHOUSE = 8       // a suite on the top floor

const RS_CLEAN = 0
const RS_DIRTY = 1
const RS_OCCUPIED = 2

var rooms: [200]Room
var nrooms: s32 = 1          // room 0 is "none"

fn tix(f: s32, x: s32, z: s32) -> s32 { return f * NT + z * GW + x }
fn in_lot(x: s32, z: s32) -> bool { return x >= 0 && x < GW && z >= 0 && z < GH }

fn room_at(f: s32, x: s32, z: s32) -> s32 {
    if !in_lot(x, z) { return 0 }
    return troom[tix(f, x, z)] as s32
}

fn room_kind(r: s32) -> s32 {
    if r <= 0 { return -1 }
    return rooms[r].kind as s32
}

// Indoor: a room with walls around it, or a corridor.
fn kind_indoor(k: s32) -> bool { return k >= 0 && k <= KIND_SERVICE }
fn kind_corr(k: s32) -> bool { return k == KIND_CORR || k == KIND_SERVICE }

fn indoor(f: s32, x: s32, z: s32) -> bool { return kind_indoor(room_kind(room_at(f, x, z))) }

// Has a floor surface people can stand on (not void, not water, not a stair hole).
fn tile_floor(f: s32, x: s32, z: s32) -> bool {
    if !in_lot(x, z) { return false }
    let t = tix(f, x, z)
    if f == 0 { return tflag[t] & (TF_WATER | TF_HOLE) == 0 && z < SEA_Z }
    return tfloor[t] != 0 && tflag[t] & (TF_VOID | TF_HOLE | TF_WATER) == 0
}

// What stands on the edge between tile a (x, z) and its neighbour b at (x + dx, z + dz):
// 0 nothing, 1 a wall.
fn wall_between(f: s32, x: s32, z: s32, dx: s32, dz: s32) -> bool {
    let ra = room_at(f, x, z)
    let rb = room_at(f, x + dx, z + dz)
    if ra == rb { return false }
    let ka = room_kind(ra)
    let kb = room_kind(rb)
    let ia = kind_indoor(ka)
    let ib = kind_indoor(kb)
    if !ia && !ib { return false }
    if ia && ib { return !(kind_corr(ka) && kind_corr(kb)) }
    return true
}

// The feature on an edge (door/window), for the edge between (x, z) and (x+dx, z+dz).
fn edge_feat(f: s32, x: s32, z: s32, dx: s32, dz: s32) -> s32 {
    if dx == 1 { if !in_lot(x + 1, z) { return 0 } return edge_w[tix(f, x + 1, z)] as s32 }
    if dx == -1 { if !in_lot(x, z) { return 0 } return edge_w[tix(f, x, z)] as s32 }
    if dz == 1 { if !in_lot(x, z + 1) { return 0 } return edge_n[tix(f, x, z + 1)] as s32 }
    if !in_lot(x, z) { return 0 }
    return edge_n[tix(f, x, z)] as s32
}

fn set_edge_feat(f: s32, x: s32, z: s32, dx: s32, dz: s32, v: s32) {
    if dx == 1 { if in_lot(x + 1, z) { edge_w[tix(f, x + 1, z)] = v as u8 } return }
    if dx == -1 { if in_lot(x, z) { edge_w[tix(f, x, z)] = v as u8 } return }
    if dz == 1 { if in_lot(x, z + 1) { edge_n[tix(f, x, z + 1)] = v as u8 } return }
    if in_lot(x, z) { edge_n[tix(f, x, z)] = v as u8 }
}

// Can a person step from (x, z) to the neighbour (x+dx, z+dz) on floor f (ignoring objects)?
fn edge_open(f: s32, x: s32, z: s32, dx: s32, dz: s32) -> bool {
    if !wall_between(f, x, z, dx, dz) { return true }
    return edge_feat(f, x, z, dx, dz) == EF_DOOR
}

// Removes doors and windows from edges that no longer have a wall.
fn clean_edges(f: s32) {
    let b = f * NT
    for t in 0..NT {
        let g = b + t
        if edge_n[g] == 0 && edge_w[g] == 0 { continue }
        let x = t & 31
        let z = t >> 5
        if edge_n[g] != 0 && !wall_between(f, x, z, 0, -1) { edge_n[g] = 0 }
        if edge_w[g] != 0 && !wall_between(f, x, z, -1, 0) { edge_w[g] = 0 }
    }
}

// ---- the lot's ground

const GR_GRASS = 0
const GR_SAND = 1
const GR_ROAD = 2
const GR_WALK = 3
const GR_SEA = 4

fn ground_at(x: s32, z: s32) -> s32 {
    if z <= ROAD_Z { return GR_ROAD }
    if z == WALK_Z { return GR_WALK }
    if z >= SEA_Z { return GR_SEA }
    if z > LAND_Z1 { return GR_SAND }
    // a sandy path from the sidewalk down to the beach on the east side
    return GR_GRASS
}

// Where may this floor key be painted? (the rules of the Rooms tab)
fn paint_ok(f: s32, x: s32, z: s32, fk: s32) -> bool {
    if !in_lot(x, z) { return false }
    let kind = FLOORK_KIND[fk] as s32
    let t = tix(f, x, z)
    if kind == KIND_POOL {
        // water goes on existing rooms or decks (not corridors)
        let r = troom[t] as s32
        if r == 0 { return false }
        let k = rooms[r].kind as s32
        return (k == KIND_ROOM || k == KIND_DECK) && tobj[t] < 0 && tflag[t] & (TF_VOID | TF_HOLE) == 0
    }
    if f == 0 {
        if kind == KIND_DECK { return z >= LAND_Z0 && z <= BEACH_Z1 && x >= 1 && x < GW - 1 }
        return z >= LAND_Z0 && z <= LAND_Z1 && x >= BUILD_X0 && x <= BUILD_X1
    }
    if kind == KIND_DECK { return false }
    if x < BUILD_X0 || x > BUILD_X1 || z < LAND_Z0 || z > LAND_Z1 { return false }
    // upper floors stand on indoor tiles of the floor below
    return indoor(f - 1, x, z)
}

// The highest floor with any room (for the elevator span, the skyline...).
fn top_floor() -> s32 {
    var top = 0
    for r in 1..nrooms {
        if rooms[r].used != 0 && kind_indoor(rooms[r].kind as s32) { top = max(top, rooms[r].floor as s32) }
    }
    return top
}

fn world_reset() {
    memset(&tfloor[0], 0, NTT)
    memset(&troom[0], 0, NTT)
    memset(&tflag[0], 0, NTT)
    memset(&edge_n[0], 0, NTT)
    memset(&edge_w[0], 0, NTT)
    for i in 0..NTT { tobj[i] = -1 }
    memset(&rooms[0] as *u8, 0, sizeof(Room) * MAXROOM)
    nrooms = 1
    legacy_baths = false
}

fn room_alloc() -> s32 {
    for r in 1..nrooms {
        if rooms[r].used == 0 {
            memset(&rooms[r] as *u8, 0, sizeof(Room))
            rooms[r].occupant = -1
            return r
        }
    }
    if nrooms >= MAXROOM { return 0 }
    let r = nrooms
    nrooms += 1
    memset(&rooms[r] as *u8, 0, sizeof(Room))
    rooms[r].occupant = -1
    return r
}

// Recounts a room's tiles and bounding box; frees it when it has none left.
fn room_measure(r: s32) {
    let rm = &rooms[r]
    let f = rm.floor as s32
    var n = 0
    var nv = 0
    var nw = 0
    var x0 = 99
    var z0 = 99
    var x1 = -1
    var z1 = -1
    let base = f * NT
    for z in 0..GH {
        for x in 0..GW {
            let t = base + z * GW + x
            if troom[t] as s32 == r {
                n += 1
                if tflag[t] & TF_VOID != 0 { nv += 1 }
                if tflag[t] & TF_WATER != 0 { nw += 1 }
                x0 = min(x0, x)
                z0 = min(z0, z)
                x1 = max(x1, x)
                z1 = max(z1, z)
            }
        }
    }
    rm.ntiles = n as s16
    rm.nvoid = nv as s16
    rm.nwater = nw as s16
    if n == 0 {
        rm.used = 0
        return
    }
    rm.x0 = x0 as u8
    rm.z0 = z0 as u8
    rm.x1 = x1 as u8
    rm.z1 = z1 as u8
}

// Floor surface index (art surface) of a tile.
fn tile_surface(f: s32, x: s32, z: s32) -> s32 {
    let t = tix(f, x, z)
    if tflag[t] & TF_WATER != 0 { return FK_POOL_WATER }
    let fk = tfloor[t] as s32 - 1
    return fk
}
