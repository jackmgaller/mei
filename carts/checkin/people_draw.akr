// Drawing people (billboard sprites, shadows, carried props) and the elevator cars. The
// simulation (people.akr, transport.akr) moves them; this file only reads their state, and the
// visual state it keeps for us in sim_vis.akr: people_vis (walk phase, fade, seat offset) and
// elev_vis (door opening), when it writes them.
// Owner: workstream A (art and rendering). See CONTRACT.md.
//
// People are drawn 1:1, never scaled (crisp at every zoom): the 16x24 frames at zoom 1 and 2, the
// 12x16 ones at zoom 0. Each has a soft shadow, and sorts from a point half a tile in front of its
// feet, so the furniture in front does not slice it.

// ---- people

const SKIN: [4]u32 = [0x90B8F0, 0x6890D0, 0x507098, 0xA8D0FF]

fn person_col(p: *Person) -> u32 {
    if p.kind as s32 == P_STAFF { return ROLE_COL[p.type as s32] }
    if p.kind as s32 == P_VISITOR { return rgb(90, 120, 60) }
    match p.type as s32 {
        0 => return rgb(70, 80, 110)            // business: grey suit
        1 => return rgb(240, 160, 60)           // family: bright tees
        2 => return rgb(250, 250, 255)          // honeymooners: white
        else => return rgb(30, 20, 30)          // rock star: black leather
    }
}

var people_drawn: s32

var vis_anim: bool               // the simulation writes people_vis[].anim (walk by distance)

fn draw_people() {
    people_drawn = 0
    sprite_dirs()
    let vf = view_floor
    for i in 0..npeople {
        let p = &people[i]
        if p.used == 0 || p.mode as s32 == M_HIDDEN || p.mode as s32 == M_RIDE { continue }
        if people_vis[i].anim != 0 { vis_anim = true }
        if people_vis[i].fade >= FADE_GONE { continue }
        let f = p.f as s32
        if f > vf { continue }
        let tx = clamp(p.x as s32, 0, GW - 1)
        let tz = clamp(p.z as s32, 0, GH - 1)
        if f < vf && !exposed(f, tx, tz) { continue }
        draw_person(p, i, f < vf)
    }
}

const FADE_GONE = 224            // people_vis fade: from here on not drawn
const FADE_HALF = 64             // from here on drawn half transparent
const PULL = 6                   // ordering-table buckets: half a tile toward the camera

// Screen-relative sprite directions of the four world facings (0 +x, 1 +z, 2 -x, 3 -z), worked out
// once per frame from the camera: toward/away from the viewer and screen left/right.
var spr_dir: [4]u8

fn sprite_dirs() {
    let c = vec3(16.0, 0.0, 12.0)
    if !project(c) { return }
    let cx = proj_x
    for d in 0..4 {
        var dx = 0.0
        var dz = 0.0
        match d {
            0 => dx = 1.0
            1 => dz = 1.0
            2 => dx = -1.0
            else => dz = -1.0
        }
        if !project(vec3(16.0 + dx, 0.0, 12.0 + dz)) { continue }
        let right = proj_x > cx
        var toward = false
        if d == 0 { toward = vis_px }
        if d == 1 { toward = vis_pz }
        if d == 2 { toward = !vis_px }
        if d == 3 { toward = !vis_pz }
        var a = ART_DIR_BACK_LEFT
        if toward && right { a = ART_DIR_FRONT_RIGHT }
        if toward && !right { a = ART_DIR_FRONT_LEFT }
        if !toward && right { a = ART_DIR_BACK_RIGHT }
        spr_dir[d] = a as u8
    }
}

const STAFF_PK: [9]u8 = [ART_STAFF_RECEPTIONIST, ART_STAFF_HOUSEKEEPER, ART_STAFF_COOK, ART_STAFF_WAITER,
    ART_STAFF_BARTENDER, ART_STAFF_SPA_THERAPIST, ART_STAFF_BELLHOP, ART_STAFF_MAINTENANCE, ART_STAFF_SECURITY]

// The art's person kind (sprite sheet) of a person.
fn person_kind(p: *Person) -> s32 {
    let ty = p.type as s32
    let lk = p.look as s32
    if p.kind as s32 == P_STAFF {
        if ty == ROLE_RECEPTIONIST && lk & 1 != 0 { return ART_PK_RECEPTIONIST_F }
        return STAFF_PK[ty] as s32
    }
    if p.kind as s32 == P_VISITOR { return ART_STAFF_MAINTENANCE }
    match ty {
        1 => {
            if lk & 1 != 0 { return ART_GUEST_CHILD + (lk >> 1) % ART_GUEST_CHILD_N }
            return ART_GUEST_FAMILY + (lk >> 1) % ART_GUEST_FAMILY_N
        }
        2 => return ART_GUEST_HONEYMOONER + lk % ART_GUEST_HONEYMOONER_N
        3 => return ART_GUEST_ROCKSTAR + lk % ART_GUEST_ROCKSTAR_N
        else => return ART_GUEST_BUSINESS + lk % ART_GUEST_BUSINESS_N
    }
}

// A textured screen quad (16x24-ish cell at u, v) in the world's ordering table.
fn sprite_quad(x0: s32, y0: s32, x1: s32, y1: s32, u: s32, v: s32, w: s32, h: s32, slot: s32, pal: s32,
               col: u32, bucket: s32, lower: bool, mode: s32) {
    let q = packet_alloc(10)
    if q == null { return }
    var ty: u32 = 0x26
    var c = col
    if mode >= 0 { ty = 0x2E; c = col | ((mode as u32) << 24) }
    q[1] = c
    q[2] = upos(x0, y0)
    q[3] = (u as u32) | ((v as u32) << 8) | ((slot as u32) << 16) | (1 << 20) | ((pal as u32) << 24)
    q[4] = upos(x1, y0)
    q[5] = ((u + w) as u32) | ((v as u32) << 8)
    q[6] = upos(x0, y1)
    q[7] = (u as u32) | (((v + h) as u32) << 8)
    q[8] = upos(x1, y1)
    q[9] = ((u + w) as u32) | (((v + h) as u32) << 8)
    lo_insert(q, ty, bucket, lower)
}

fn draw_person(p: *Person, i: s32, lower: bool) {
    let v = &people_vis[i]
    let base = vec3(p.x + v.ox, fixed(p.f as s32) * STOREY + p.y, p.z + v.oz)
    if !project(base) { return }
    let fx = proj_x
    let fy = proj_y
    if fx < -20 || fx > 340 || fy < -10 || fy > 280 { return }
    var bucket = depth_bucket(proj_w) - PULL
    if lower { bucket += B_FLOOR * (view_floor - p.f as s32) - B_FLOOR }
    if ART_PRESENT {
        draw_sprite(p, i, fx, fy, bucket, lower)
        return
    }
    let k = ppu * 0.82
    var h = (k * 1.55) as s32
    let ty = p.type as s32
    if p.kind as s32 == P_GUEST && ty == 1 && p.look & 1 != 0 { h = h * 3 / 4 }   // kids
    let w = max(h * 2 / 5, 3)
    var top = fy - h
    let pose = p.pose as s32
    var lift = 0
    if pose == POSE_SIT { top += h / 4 }
    if pose == POSE_SWIM { top += h / 2 }
    if pose == POSE_WALK && (tick_count / 6 + p.look as s32) % 2 == 0 { lift = 1 }
    let body = person_col(p)
    let head_h = max(h / 4, 2)
    let x0 = fx - w / 2
    // body (and legs)
    var by1 = fy - lift
    if pose == POSE_SWIM { by1 = fy - h / 4 }
    world_quad(x0, top + head_h, x0 + w, by1, body, bucket, lower)
    // head
    let hw = max(w * 3 / 4, 2)
    world_quad(fx - hw / 2, top - lift, fx - hw / 2 + hw, top + head_h - lift + 1, SKIN[p.look as s32 & 3], bucket - 1, lower)
    if p.carry != 0 {
        world_quad(fx + w / 2 - 1, top + head_h + 1, fx + w / 2 + w / 2 + 1, top + head_h + w / 2 + 2, carry_col(p.carry as s32), bucket - 2, lower)
    }
    people_drawn += 1
}

fn draw_sprite(p: *Person, i: s32, fx: s32, fy: s32, bucket: s32, lower: bool) {
    let k = person_kind(p)
    let pose = p.pose as s32
    var fr = ART_FR_STAND
    if pose == POSE_WALK || p.mode as s32 == M_STAIRS {
        // the walk cycle follows the distance walked when the simulation keeps it (people_vis
        // anim, 256 a cycle), so feet do not slide and a paused game stands still
        if vis_anim { fr = ART_FR_WALK1 + ((people_vis[i].anim as s32 >> 6) & 3) }
        else { fr = ART_FR_WALK1 + ((tick_count / 7 + p.look as s32) & 3) }
    } else if pose == POSE_SIT || pose == POSE_LIE {
        fr = ART_FR_SIT
    } else if pose == POSE_USE {
        fr = ART_FR_USE
    } else if pose == POSE_SWIM {
        fr = ART_FR_SWIM
    } else if p.carry != 0 {
        fr = ART_FR_CARRY
    }
    var d = spr_dir[p.dir as s32 & 3] as s32
    if pose == POSE_LIE && (people_vis[i].ox != 0.0 || people_vis[i].oz != 0.0) {
        // asleep in bed (moved onto it by people_vis ox, oz): the head on the pillow, the bed's
        // blanket over the rest (A17)
        if d >= ART_DIR_BACK_LEFT { d = d - 2 }
        draw_sleeper(p, i, k, d, bucket, lower)
        return
    }
    // 1:1: the 16x24 frames, or the 12x16 ones zoomed out
    var w = ART_PERSON_W
    var h = ART_PERSON_H
    var u = ART_PERSON_U[k] as s32 + fr * ART_PERSON_W
    var v = ART_PERSON_V[k] as s32 + d * ART_PERSON_H
    if view_zoom == 0 {
        w = ART_MINI_W
        h = ART_MINI_H
        u = ART_PERSON_MU[k] as s32 + fr * ART_MINI_W
        v = ART_PERSON_MV[k] as s32 + d * ART_MINI_H
    }
    let x0 = fx - w / 2
    let y1 = fy + 1
    let y0 = y1 - h
    // light: outdoors with the sky, indoors with the lamps; the floors below are ghosted
    var l = light_int
    let tx = clamp(p.x as s32, 0, GW - 1)
    let tz = clamp(p.z as s32, 0, GH - 1)
    if !indoor(p.f as s32, tx, tz) { l = light_ext }
    var col = lit(TINT, l)
    if lower { col = ghost_col(col) }
    // fading in or out (elevators, arriving, leaving): half transparent
    var mode = -1
    if people_vis[i].fade >= FADE_HALF { mode = 0 }
    if pose != POSE_SWIM && !lower {
        // a soft shadow (subtracted) under the feet
        let sw = w * 3 / 4
        let sh = max(sw / 3, 3)
        sprite_quad(fx - sw / 2, fy - sh / 2, fx - sw / 2 + sw, fy - sh / 2 + sh, ART_PROP_SHADOW_U + 2, ART_PROP_SHADOW_V + 6, 12, 4,
            ART_PROP_SLOT, ART_PAL_PROPS, 0x2C2C2C, bucket + 2, lower, 2)
    }
    sprite_quad(x0, y0, x0 + w, y1, u, v, w, h, ART_PERSON_SLOT[k] as s32, ART_PERSON_PAL[k] as s32, col, bucket, lower, mode)
    if p.carry != 0 && pose != POSE_SIT && view_zoom > 0 {
        // carried things at half size (every other texel of the 16x16 prop: still crisp)
        var pu = ART_PROP_LINEN_U
        var pv = ART_PROP_LINEN_V
        let c = p.carry as s32
        if c == IT_MEAL || c == IT_CRATE { pu = ART_PROP_TRAY_U; pv = ART_PROP_TRAY_V }
        if c == IT_TOOLS { pu = ART_PROP_TOOLBOX_U; pv = ART_PROP_TOOLBOX_V }
        if c == IT_BAGS { pu = ART_PROP_LUGGAGE_U; pv = ART_PROP_LUGGAGE_V }
        let py = fy - h / 2
        var px = fx - 4
        if d == ART_DIR_FRONT_RIGHT || d == ART_DIR_BACK_RIGHT { px = fx + 3 - 4 } else { px = fx - 3 - 4 }
        var pb = bucket - 1
        if d >= ART_DIR_BACK_LEFT { pb = bucket + 1 }
        sprite_quad(px, py - 4, px + 8, py + 4, pu, pv, 16, 16, ART_PROP_SLOT, ART_PAL_PROPS, col, pb, lower, mode)
    }
    people_drawn += 1
}

// The head (and hair or hat) of person kind k, facing d, resting on a bed top.
fn draw_sleeper(p: *Person, i: s32, k: s32, d: s32, bucket: s32, lower: bool) {
    let v = &people_vis[i]
    if !project(vec3(p.x + v.ox, fixed(p.f as s32) * STOREY + 0.56, p.z + v.oz)) { return }
    let child = k >= ART_GUEST_CHILD && k < ART_GUEST_CHILD + ART_GUEST_CHILD_N
    var w = ART_PERSON_W
    var r0 = 0
    var rh = 10
    if child { r0 = 6 }
    var u = ART_PERSON_U[k] as s32 + ART_FR_STAND * ART_PERSON_W
    var vv = ART_PERSON_V[k] as s32 + d * ART_PERSON_H
    if view_zoom == 0 {
        w = ART_MINI_W
        r0 = r0 * 2 / 3
        rh = 7
        u = ART_PERSON_MU[k] as s32 + ART_FR_STAND * ART_MINI_W
        vv = ART_PERSON_MV[k] as s32 + d * ART_MINI_H
    }
    var col = lit(TINT, light_int)
    if lower { col = ghost_col(col) }
    let x0 = proj_x - w / 2
    sprite_quad(x0, proj_y - rh, x0 + w, proj_y, u, vv + r0, w, rh, ART_PERSON_SLOT[k] as s32, ART_PERSON_PAL[k] as s32,
        col, bucket - 2, lower, -1)
    people_drawn += 1
}

fn carry_col(c: s32) -> u32 {
    match c {
        1 => return rgb(170, 160, 140)          // dirty linen
        2 => return rgb(250, 250, 255)          // clean linen
        3 => return rgb(200, 150, 90)           // food crate
        4 => return rgb(255, 210, 120)          // a meal
        5 => return rgb(150, 70, 50)            // luggage
        else => return rgb(140, 140, 160)       // toolbox
    }
}

// A flat screen-space quad in the world's ordering table (or the lower floors' one).
fn world_quad(x0: s32, y0: s32, x1: s32, y1: s32, c: u32, bucket: s32, lower: bool) {
    let q = packet_alloc(6)
    if q == null { return }
    q[1] = c
    q[2] = upos(x0, y0)
    q[3] = upos(x1, y0)
    q[4] = upos(x0, y1)
    q[5] = upos(x1, y1)
    lo_insert(q, 0x24, bucket, lower)
}

fn lo_insert(q: *u32, type: u32, bucket: s32, lower: bool) {
    let b = clamp(bucket, 0, 1023)
    if lower {
        q[0] = (type << 24) | (lo_ot[b] & 0xFFFFFF)
        lo_ot[b] = (lo_ot[b] & 0xFF000000) | (q as u32)
    } else {
        ot_insert(q, type, b)
    }
}

// ---- elevator cars (A10)
//
// A glass shaft shows its car: the art's textured cab (glass_elevator_cab), moving smoothly with
// e.pos. A walled shaft shows nothing of it until its doors open: then the opening between the
// sliding doors shows the lit car inside, widening from the middle as they part. How far the
// doors are open comes from elev_vis[k].door_t when the simulation writes it, else from the
// car's door timer.
var vis_doors: bool              // the simulation writes elev_vis[].door_t
const DOOR_X = 0.48              // half the width of a shaft's door opening (local x)
const DOOR_Y = 2.20              // its height
const DOOR_Z = 0.985             // just in front of the shaft's door face (local z)

// How far car k's doors are open (0 shut .. 1.0 open).
fn elev_open(k: s32) -> fixed {
    let t = elev_vis[k].door_t as s32
    if t != 0 { vis_doors = true }
    if vis_doors { return fixed(clamp(t, 0, DOOR_T)) / DOOR_T }
    let e = &elevs[k]
    if e.door <= 0 { return 0.0 }
    return fixed(clamp(min(DOOR_T - e.door, e.door), 0, 12)) / 12
}

fn draw_elevators() {
    bm_bias = -2
    var lower_cabs = false
    for k in 0..nelevs {
        let e = &elevs[k]
        let o = &objs[e.obj as s32]
        let fl = elev_floor(k)
        if fl > view_floor { continue }
        let glass = o.t as s32 == OB_GLASS_ELEVATOR
        if fl < view_floor {
            if glass && exposed(fl, o.x as s32, o.z as s32) { lower_cabs = true }
            continue
        }
        var c = obj_centre(e.obj as s32)
        c.y = e.pos * STOREY
        if glass {
            if e.pos > fixed(view_floor) + 0.3 { continue }
            let m = obj_mesh_art(ART_OBJ_GLASS_ELEVATOR_CAB)
            if m != null { bake_mesh(m, c, o.rot as s32) }
            continue
        }
        let a = elev_open(k)
        if a <= 0.0 { continue }
        // (sorted well in front: the shaft's face is taller, so its centre is nearer the camera)
        bm_bias = -8
        door_gap(c, o.rot as s32, DOOR_X * a)
        mb_flush()
        bm_bias = -2
    }
    mb_flush()
    // glass cars seen through an atrium below: into the lower floors' table, ghosted like them
    if lower_cabs && have_lo {
        memcpy(&elev_ot_save[0] as *u8, &__ot[0] as *u8, 4096)
        memcpy(&__ot[0] as *u8, &lo_ot[0] as *u8, 4096)
        mb_ghost = true
        for k in 0..nelevs {
            let e = &elevs[k]
            let o = &objs[e.obj as s32]
            let fl = elev_floor(k)
            if fl >= view_floor || o.t as s32 != OB_GLASS_ELEVATOR || !exposed(fl, o.x as s32, o.z as s32) { continue }
            var c = obj_centre(e.obj as s32)
            c.y = e.pos * STOREY
            bm_bias = (view_floor - 1 - fl) * B_FLOOR - 2
            let m = obj_mesh_art(ART_OBJ_GLASS_ELEVATOR_CAB)
            if m != null { bake_mesh(m, c, o.rot as s32) }
            mb_flush()
        }
        mb_ghost = false
        memcpy(&lo_ot[0] as *u8, &__ot[0] as *u8, 4096)
        memcpy(&__ot[0] as *u8, &elev_ot_save[0] as *u8, 4096)
    }
    bm_bias = 0
}

var elev_ot_save: [1024]u32

fn obj_mesh_art(a: s32) -> *Mesh {
    if !ART_PRESENT { return null }
    return ART_MESH[a]
}

// The lit inside of a car between doors parted by half-width hw, on the shaft's front (local +z),
// if that side faces the camera.
fn door_gap(c: vec3, rot: s32, hw: fixed) {
    // the front's normal in the world, and whether the camera sees it
    var nx = 0
    var nz = 1
    match rot & 3 {
        0 => {}
        1 => { nx = 1; nz = 0 }
        2 => { nz = -1 }
        else => { nx = -1; nz = 0 }
    }
    if nx > 0 && !vis_px { return }
    if nx < 0 && vis_px { return }
    if nz > 0 && !vis_pz { return }
    if nz < 0 && vis_pz { return }
    // the car's back wall, its floor and its ceiling light
    let y0 = c.y + 0.02
    let y1 = c.y + DOOR_Y
    if nx == 0 {
        let z = c.z + fixed(nz) * DOOR_Z
        look_in(ART_FLAT_CAB_SIDE)
        mb_vquad_x(c.x - hw, c.x + hw, z, y0 + 0.12, y1 - 0.14, TINT)
        look_in(ART_FLAT_CAB_DARK)
        mb_vquad_x(c.x - hw, c.x + hw, z, y0, y0 + 0.12, TINT)
        look_in(ART_FLAT_CAB)
        mb_vquad_x(c.x - hw, c.x + hw, z, y1 - 0.14, y1, TINT)
    } else {
        let x = c.x + fixed(nx) * DOOR_Z
        look_in(ART_FLAT_CAB_SIDE)
        mb_vquad_z(x, c.z - hw, c.z + hw, y0 + 0.12, y1 - 0.14, TINT)
        look_in(ART_FLAT_CAB_DARK)
        mb_vquad_z(x, c.z - hw, c.z + hw, y0, y0 + 0.12, TINT)
        look_in(ART_FLAT_CAB)
        mb_vquad_z(x, c.z - hw, c.z + hw, y1 - 0.14, y1, TINT)
    }
}
