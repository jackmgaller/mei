// The menus and the fight's overlays (D's; the brochure by mx-menus). The menus are the expo's
// brochure: a pale catalogue page (BG1: a technical grid with a big faint "2000") under a navy
// masthead, white printed cards with navy rules, spec sheets, lanyards, booth numbers, a press
// pass and rubber stamps, set in Figtree, Sofia Sans Condensed and Gelasio (ui_art.akr).
//
// The print layer: in the menus BG0 (the HUD's frame in a fight) holds the brochure's coloured
// panels behind the mechs, the "photographs" of the catalogue: 8 x 8 tiles over a 15-shade ramp
// (ui_print.tiles in ATLAS_2) in palettes 197-199, each ramp written from a maker's colour when
// it is drawn. Priorities in the menus: BG1 and BG0 1 (BG0 wins the tie), the mechs (PL) 2, the
// interface (PH) 4. The interface list is drawn after the mechs, so whatever must sit behind a
// mech is on BG0.
//
// Screens: the title (the hangar, the show's logo with a shine, a press pass on its lanyard that
// says PRESS START, the exhibitors), mode select (the visitor guide's floor map and its index
// tabs), the character select (the exhibitor catalogue: a spec sheet per side with the mech on a
// turntable in its photograph, the 5 x 2 grid of roster.akr below), the VS screen (the
// programme's next demonstration), pause (a translucent clipboard), results (the UAPC's judging
// sheet), the unlock (a press release) and the memory card's messages. The arcade's (mx-ladder,
// at the end): the difficulty select (the trial's grades), the schedule page between fights
// (the day's programme), the final's reveal and the magazine cover.

const PAGE_SKY: [3]u32 = [0xF6EEE6, 0xEADCCC, 0xD6C0A8]   // 0xBBGGRR: white into pale blue
const PAGE_SKY_Y: [3]s32 = [0, 120, 240]
const PAGE_PRIO: u32 = 0x42001111   // PH 4, PL 2, BG0 1 (wins the tie with BG1), BG1 1, BG2 0
const PAPER: u32 = 0xF8F4F0         // the brochure's paper, rgb(240, 244, 248)
const PAPER2: u32 = 0xEADFD6
const DEEP: u32 = 0x200C06          // the darkest shade of a ramp

// ---- the backgrounds

// The menus' page: the hall's planes off, the brochure's pattern on BG1, the print layer on BG0.
fn menus_page() {
    stage_hide()
    hud_show(false)
    line_off(TITLE_LC)                  // the title's shade
    layer_offset(0, 0, 0, 0)
    atlas_load(ATLAS_3, UI_PAGE_TILES, UI_PAGE_TILES_BYTES)
    load_palette(PAL_PAGE * 16, &UI_PAL[5 * 16], 16)
    plane(BG1, ATLAS_3, MAP_BG1, 64, 32, 0, PAL_PAGE)
    map_load(BG1, UI_PAGE_MAP)
    plane_window(BG1, 0, 0, 320, 240)
    line_off(2)
    sky_gradient(&PAGE_SKY[0], &PAGE_SKY_Y[0], 3)
    print_on()
    PLN_PRIO = PAGE_PRIO
    sfx_page()                          // a new page of the brochure
}

// The menus' sounds timed to what they draw, once a frame (game.akr's update): the rubber
// stamps landing on the judging sheet (APPROVED, drawn from st_t 13), the press release
// (UNLOCKED, down on st_t 36), the schedule page (the last win's APPROVED, down on st_t 16) and
// the cover (the grade's, on st_t 30). READY is stamped as the pick is made (game.akr).
fn menus_sfx() {
    if st == St.Results && st_t == 13 && fight_get().winner != 2 { sfx_stamp() }
    if st == St.Unlock && st_t == 36 { sfx_stamp() }
    if st == St.Sched && st_t == 16 && ladder > 0 { sfx_stamp() }     // the last win's APPROVED
    if st == St.Cover && st_t == 30 { sfx_stamp() }                    // the grade's stamp
}

// The hangar (the title's attract and the fight).
fn menus_hangar() {
    hud_show(false)
    line_off(TITLE_LC)                  // the title's shade (draw_title() turns it on each frame)
    stage_show()
}

private fn page_scroll() { plane_scroll(BG1, tick / 3, tick / 5) }

// ---- the print layer (BG0 in the menus)

// BG0 on with the print tiles (hud_show(true) puts the HUD's frame back for a fight).
private fn print_on() {
    atlas_load(ATLAS_2, UI_PRINT_TILES, UI_PRINT_TILES_BYTES)
    plane(BG0, ATLAS_2, MAP_BG0, 64, 32, 0, PAL_PRINT)
    plane_scroll(BG0, 0, 0)
    print_clear()
}

private fn print_clear() { map_fill(BG0, 0, 0, 40, 30, 0) }

// Ramp k (0-2) from colour c: shades 1-8 from the paper into c, 9-15 from c into the dark.
private fn print_ramp(k: s32, c: u32) {
    let p = palette_ptr((PAL_PRINT + k) * 16)
    for i in 1..16 {
        var col = c
        if i < 8 { col = col_mix(PAPER, c, fixed(i) / 8) }
        else if i > 8 { col = col_mix(c, DEEP, fixed(i - 8) / 9) }
        p[i] = rgb15(col) as u16
    }
}

// Whole tiles (tx, ty, tw, th) in ramp k, shade s0 at the top row to s1 at the bottom, in half
// shades (the dither tiles between).
private fn print_grad(tx: s32, ty: s32, tw: s32, th: s32, k: s32, s0: s32, s1: s32) {
    for r in 0..th {
        let l = 2 * s0 + 2 * (s1 - s0) * r / max(th - 1, 1)
        var t = PT_SOLID + l / 2
        if l % 2 == 1 { t = PT_DITHER + l / 2 }
        map_fill(BG0, tx, ty + r, tw, 1, tile(t, k, 0))
    }
}

private fn print_fill(tx: s32, ty: s32, tw: s32, th: s32, k: s32, t: s32) {
    map_fill(BG0, tx, ty, tw, th, tile(t, k, 0))
}

// A catalogue photograph in ramp k: a studio sweep, light at the top, and a dotted floor.
private fn print_photo(tx: s32, ty: s32, tw: s32, th: s32, k: s32) {
    print_grad(tx, ty, tw, th - 3, k, 1, 5)
    print_fill(tx, ty + th - 3, tw, 1, k, PT_DITHER + 6)
    print_grad(tx, ty + th - 2, tw, 2, k, 8, 9)
}

// ---- the mechs in the menus

// Mech m, posed by mv, standing at screen (sx, feet_y), as tall as a camera dist metres away
// makes it, facing +x (facing 1) or -x, turned further by yaw (a turntable). One camera each.
private fn menu_mech_at(m: Mech, mv: Mv, sx: s32, feet_y: s32, dist: fixed, facing: s32, yaw: fixed) {
    let n = max(anim_len(m, mv), 1)
    menu_mech_f(m, mv, fixed(tick % n), sx, feet_y, dist, facing, yaw)
}

// The same at frame f of the move.
private fn menu_mech_f(m: Mech, mv: Mv, f: fixed, sx: s32, feet_y: s32, dist: fixed, facing: s32, yaw: fixed) {
    camera_look(vec3(0.0, 6.0, -dist), 0.0, -0.04)
    let p = project_point(vec3(0.0, 0.0, 0.0))
    camera_pan(sx - p.x, feet_y - p.y)
    var a = -HALF_PI
    if facing < 0 { a = HALF_PI }
    anim_draw(m, mv, f, mat4_rotate_y(a + yaw))
}

// Side s's mech (p_mech), grey when it is the UAPC's test unit (mx-ladder).
private fn side_mech_at(s: s32, mv: Mv, sx: s32, feet_y: s32, dist: fixed, facing: s32, yaw: fixed) {
    anim_grey = p_grey[s]
    menu_mech_at(p_mech[s], mv, sx, feet_y, dist, facing, yaw)
    anim_grey = false
}

// The turntable's slow swing.
private fn turntable(phase: s32) -> fixed { return sin(frame_angle(tick + phase, 0.021)) * 0.42 }

// ---- the brochure's furniture

// The masthead: a navy band with the page's title and a cyan section tab.
private fn masthead(title: *u8, tab: *u8) {
    rect_grad(0, 0, 320, 21, C_NAVY, C_GLASS, BLEND_NONE)
    rect_blend(0, 21, 320, 1, C_CYAN, BLEND_NONE)
    rect_blend(0, 22, 320, 1, C_WHITE, BLEND_NONE)
    txt(FONT_HEAD, 8, 3, title, C_WHITE, ALIGN_LEFT)
    let w = txt_w(FONT_HEAD, tab) + 16
    quad_fill(318 - w, 3, 318, 3, 312 - w, 18, 312, 18, C_CYAN, BLEND_NONE)
    txt(FONT_HEAD, 315 - w / 2 - 3, 3, tab, C_INK, ALIGN_CENTRE)
    if txt_w(FONT_HEAD, title) + 24 < 306 - w - txt_w(FONT_MICRO, "MECH EXPO 2000") {
        txt(FONT_MICRO, 306 - w, 6, "MECH EXPO 2000", C_SKY, ALIGN_RIGHT)
    }
}

// The footer: the buttons on the left, the brochure's page number on the right.
private fn footer(s: *u8, page: *u8) {
    rect_blend(0, 227, 320, 13, C_NAVY, BLEND_NONE)
    rect_blend(0, 227, 320, 1, C_CYAN, BLEND_NONE)
    txt(FONT_MICRO, 8, 229, s, C_WHITE, ALIGN_LEFT)
    txt(FONT_MICRO, 312, 229, page, C_SKY, ALIGN_RIGHT)
}

// A sheet of the brochure's paper with a drop shadow.
private fn paper(x: s32, y: s32, w: s32, h: s32) {
    rect_blend(x + 3, y + 3, w, h, 0x402010, BLEND_SUB)
    rect_grad(x, y, w, h, PAPER, PAPER2, BLEND_NONE)
}

// The colour a player's things are in: 1P red, 2P blue.
private fn side_colour(s: s32) -> u32 {
    if s == 0 { return C_RED }
    return C_BLUE
}

// ---- the title

// The hall behind the logo's band (rows TITLE_SHADE_Y0 to Y1 - 1) is shaded on the title: BG1
// there is half-blended with the hangar's dark roof (the backdrop under it), so the hanging
// makers' banners recede behind the logo and its lines, by colour math on a line channel
// (channel TITLE_LC, its table in LT_FREE). Below the band the hall is untouched.
const TITLE_LC = 3
const TITLE_SHADE_Y0 = 22
const TITLE_SHADE_Y1 = 114

private fn title_shade() {
    let tbl = LT_FREE as *u32
    let m = (4 | BLEND_HALF as u32) << (BG1 * 4) as u32
    for y in 0..240 {
        var v: u32 = 0
        if y >= TITLE_SHADE_Y0 && y < TITLE_SHADE_Y1 { v = m }
        tbl[y] = v
    }
    line_channel(TITLE_LC, LC_MATH, 1, LT_FREE)
}

fn draw_title() {
    let t = tick
    title_shade()
    // the logo on a glass band, a shine across its chrome now and then
    rect_blend(0, 22, 320, 92, 0x200804, BLEND_HALF)     // a darker glass under it: the banners recede
    rect_grad(0, 22, 320, 92, 0x301008, 0x100400, BLEND_HALF)
    rect_blend(0, 22, 320, 1, C_CYAN, BLEND_NONE)
    rect_blend(0, 113, 320, 1, C_CYAN, BLEND_NONE)
    let lx = 160 - UI_LOGO[2] / 2
    ui_sprite(&UI_LOGO[0], PAL_LOGO, lx, 36, 0x808080, BLEND_NONE)
    ui_shine(lx + 4, 38, 232, 34, t, 150)
    txt(FONT_MICRO, 8, 25, "EXPO HALL 1 // DEMO HANGAR", C_SKY, ALIGN_LEFT)
    // the Y drawn on its own, closer: FONT_MICRO has no kerning and its Y stands apart from an O
    let ox = 312 - txt_w(FONT_MICRO, "OKOHAMA 2000.10.12")
    txt(FONT_MICRO, 312, 25, "OKOHAMA 2000.10.12", C_SKY, ALIGN_RIGHT)
    txt(FONT_MICRO, ox + 3, 25, "Y", C_SKY, ALIGN_RIGHT)
    barcode(8, 102, 16, 7, C_SILVER)
    txt(FONT_MICRO, 312, 101, "ADMIT ONE // MEDIA", C_SILVER, ALIGN_RIGHT)
    // the press pass, hung from the band on its lanyard, swaying a little
    let sw = (sin(frame_angle(t, 0.045)) * 3.0) as s32
    let px = 160 + sw
    ui_strap(132, 113, px - 5, 147, 6, C_RED)
    ui_strap(188, 113, px + 5, 147, 6, C_RED)
    draw_pass(px - 58, 150, (t / 24) & 1 == 0 || st_t < 30)
    // the exhibitors
    rect_blend(0, 214, 320, 26, C_GLASS, BLEND_HALF)
    rect_blend(0, 214, 320, 1, C_CYAN, BLEND_NONE)
    txt(FONT_MICRO, 8, 216, "EXHIBITORS", C_SKY, ALIGN_LEFT)
    txt(FONT_MICRO, 8, 226, "FIVE MAKERS", C_SILVER, ALIGN_LEFT)
    for k in 0..MAKERS_N { ui_emblem(k, 98 + k * 28, 215, true, 0x808080) }
    txt(FONT_MICRO, 312, 216, "ONE CONTRACT", C_SKY, ALIGN_RIGHT)
    txt(FONT_MICRO, 312, 226, "DEMO HANGAR 1", C_SILVER, ALIGN_RIGHT)
}

// The press pass (116 x 60): a navy MEDIA header with the lanyard's slot, PRESS START, a
// holographic seal, a barcode and the pass's number.
private fn draw_pass(x: s32, y: s32, lit: bool) {
    let w = 116
    let h = 60
    paper(x, y, w, h)
    rect_grad(x, y, w, 15, C_NAVY, C_GLASS, BLEND_NONE)
    rect_blend(x + w / 2 - 9, y + 3, 18, 4, 0x200C06, BLEND_NONE)          // the slot
    ui_chrome(x + w / 2 - 6, y - 4, 12, 8)                                   // the clip
    txt(FONT_HEAD, x + 6, y + 1, "MEDIA", C_WHITE, ALIGN_LEFT)
    txt(FONT_MICRO, x + w - 5, y + 3, "ALL AREAS", C_CYAN, ALIGN_RIGHT)
    var col = C_INK
    if lit { col = C_RED }
    txt(FONT_HEAD, x + 46, y + 22, "PRESS START", col, ALIGN_CENTRE)
    // the seal
    rect_grad4(x + w - 22, y + 20, 16, 16, 0xF0D830, 0xC040F0, 0xFFFFFF, 0x19C4F0, BLEND_NONE)
    rect_outline(x + w - 22, y + 20, 16, 16, C_SILVER, BLEND_NONE)
    ui_shine(x + w - 22, y + 20, 16, 16, tick, 60)
    rect_blend(x + 6, y + 39, w - 12, 1, C_SILVER, BLEND_NONE)
    barcode(x + 6, y + 43, 11, 10, C_INK)
    txt(FONT_MICRO, x + w - 6, y + 42, "NO. 2000-1012", C_STEEL, ALIGN_RIGHT)
    txt(FONT_MICRO, x + w - 6, y + 50, "MECH EXPO 2000", C_NAVY, ALIGN_RIGHT)
}

// ---- mode select: the visitor guide's floor map and its index tabs

const MODE_NAMES: [3]*u8 = ["ARCADE", "VERSUS", "TRAINING"]
const MODE_INFO: [3]*u8 = [
    "THREE DEMONSTRATIONS\nAGAINST RIVAL MAKERS,\nFOR THE UAPC'S CONTRACT",
    "1P AGAINST 2P,\nOR AGAINST THE CPU",
    "A DUMMY, THE MOVE\nLIST AND THE HIT BOXES",
]
const MODE_CODES: [3]*u8 = ["HALL A", "HALL B", "HALL C"]
const MODE_LETTERS: [3]*u8 = ["A", "B", "C"]
const MODE_COLS: [3]u32 = [0x281EC8, 0xD86A3A, 0x19A0D8]     // red, blue, amber
// the halls on the map: x, y, w, h
const HALLS: [3][4]s32 = [[20, 50, 56, 52], [84, 50, 56, 52], [20, 108, 56, 40]]

var mode_slide: [3]s32               // each tab's pull, in 1/16 px

fn draw_mode() {
    page_scroll()
    masthead("VISITOR GUIDE", "FLOOR MAP")
    print_clear()
    // the map: the three halls either side of the central aisle, the booths, the stage
    paper(8, 30, 144, 190)
    txt(FONT_MICRO, 14, 33, "EXPO HALL 1 // FLOOR PLAN", C_STEEL, ALIGN_LEFT)
    rect_outline(16, 46, 128, 154, C_NAVY, BLEND_NONE)
    rect_outline(17, 47, 126, 152, C_NAVY, BLEND_NONE)
    // the way from the entrance up the aisle to the chosen hall, under the halls
    let hy = HALLS[mode_sel][1] + HALLS[mode_sel][3] / 2
    let dash = (tick / 3) % 6
    var y = 194 - dash
    while y > hy {
        rect_blend(79, y, 2, 3, MODE_COLS[mode_sel], BLEND_NONE)
        y -= 6
    }
    var ax = 76
    var dx = -5
    if HALLS[mode_sel][0] > 80 {
        ax = 83
        dx = 5
    }
    for i in 0..3 {
        let hx = HALLS[i][0]
        let hy2 = HALLS[i][1]
        let hw = HALLS[i][2]
        let hh = HALLS[i][3]
        let on = i == mode_sel
        if on {
            rect_blend(hx, hy2, hw, hh, MODE_COLS[i], BLEND_NONE)
            if (tick >> 4) & 1 == 0 { rect_outline(hx - 2, hy2 - 2, hw + 4, hh + 4, MODE_COLS[i], BLEND_NONE) }
        } else {
            rect_blend(hx, hy2, hw, hh, 0xE6D8CC, BLEND_NONE)
            rect_outline(hx, hy2, hw, hh, C_STEEL, BLEND_NONE)
        }
        var tc = C_NAVY
        if on { tc = C_WHITE }
        txt(FONT_TITLE, hx + hw / 2, hy2 + hh / 2 - 16, MODE_LETTERS[i], tc, ALIGN_CENTRE)
        txt(FONT_MICRO, hx + hw / 2, hy2 + hh / 2 + 6, MODE_NAMES[i], tc, ALIGN_CENTRE)
    }
    tri_fill(ax, hy - 4, ax, hy + 4, ax + dx, hy, C_INK, BLEND_NONE)
    // the makers' booths
    rect_outline(84, 108, 56, 40, C_STEEL, BLEND_NONE)
    for b in 0..MAKERS_N {
        var bx = 88 + b * 17
        var by = 112
        if b >= 3 {
            bx = 96 + (b - 3) * 17
            by = 130
        }
        rect_blend(bx, by, 14, 14, MAKERS[b].colour, BLEND_NONE)
        rect_outline(bx, by, 14, 14, C_INK, BLEND_NONE)
    }
    // the stage and the press room
    rect_blend(20, 154, 56, 30, 0xD0C4BA, BLEND_NONE)
    txt(FONT_MICRO, 48, 164, "MAIN STAGE", C_NAVY, ALIGN_CENTRE)
    rect_blend(84, 154, 56, 30, 0xD0C4BA, BLEND_NONE)
    txt(FONT_MICRO, 112, 164, "PRESS ROOM", C_NAVY, ALIGN_CENTRE)
    // the entrance
    rect_blend(68, 198, 24, 3, PAPER, BLEND_NONE)
    txt(FONT_MICRO, 80, 204, "ENTRANCE", C_NAVY, ALIGN_CENTRE)
    // the index tabs
    for i in 0..3 {
        var target = 0
        if i == mode_sel { target = 10 * 16 }
        mode_slide[i] += (target - mode_slide[i]) / 3
        let x = 170 - mode_slide[i] / 16
        let y = 32 + i * 64
        let on = i == mode_sel
        paper(x, y, 140, 58)
        rect_blend(x + 140, y + 8 + i * 14, 8, 22, MODE_COLS[i], BLEND_NONE)     // the tab
        txt(FONT_MICRO, x + 144, y + 14 + i * 14, MODE_LETTERS[i], C_WHITE, ALIGN_CENTRE)
        rect_blend(x, y, 4, 58, MODE_COLS[i], BLEND_NONE)
        var tc = C_INK
        if !on { tc = C_STEEL }
        txt(FONT_HEAD, x + 10, y + 4, MODE_NAMES[i], tc, ALIGN_LEFT)
        txt(FONT_MICRO, x + 134, y + 6, MODE_CODES[i], C_NAVY, ALIGN_RIGHT)
        rect_blend(x + 10, y + 20, 124, 1, C_SILVER, BLEND_NONE)
        txt(FONT_MICRO, x + 10, y + 23, MODE_INFO[i], tc, ALIGN_LEFT)
        if on {
            quad_fill(x - 12, y + 22, x - 4, y + 29, x - 12, y + 36, x - 4, y + 29, MODE_COLS[i], BLEND_NONE)
            ui_shine(x + 4, y, 136, 20, tick, 120)
        }
    }
    footer("UP/DOWN CHOOSE  //  A ENTER  //  B BACK", "P. 02")
}

// ---- character select: the exhibitor catalogue

// Who plays side s: 1P, 2P, CPU or DUMMY.
fn who_label(s: s32) -> *u8 {
    if s == 0 { return "1P" }
    if game == Game.Training { return "DUMMY" }
    if game == Game.Versus && sel_human2 { return "2P" }
    if st == St.Fight || st == St.Results || st == St.Vs {
        if !p_cpu { return "2P" }
    }
    return "CPU"
}

// The grid of roster.akr's ten slots: cards 48 x 34, base mechs on top, echoes below.
const SEL_GX = 32
const SEL_GY = 154
const SEL_CW = 48
const SEL_CH = 34
const SEL_PX = 52
const SEL_PY = 37
const STAT_NAMES: [4]*u8 = ["POWER", "SPEED", "REACH", "ARMOUR"]

fn draw_select() {
    page_scroll()
    masthead("EXHIBITOR CATALOGUE", MODE_NAMES[game as s32])
    print_clear()
    draw_sheet(0, 4)
    if game == Game.Arcade { draw_schedule(164) } else { draw_sheet(1, 164) }
    draw_grid()
    if game == Game.Versus && !sel_human2 && !sel_done[1] && (tick >> 4) & 1 == 0 {
        footer("ARROWS CHOOSE  //  A CONFIRM  //  B BACK", "2P: PRESS A TO JOIN")
    } else {
        footer("ARROWS CHOOSE  //  A CONFIRM  //  B BACK", "P. 07")
    }
}

// Side s's catalogue page (152 x 124 from (x0, 24)): the name bar, the photograph (BG0, the
// mech on its turntable) and the spec sheet. 1P's photograph is on the left, 2P's on the right.
private fn draw_sheet(s: s32, x0: s32) {
    let c = sel_cur[s]
    let r = &ROSTER[c]
    let known = slot_known(c)
    let mk = slot_maker(c)
    let has_maker = known && mk != null
    var col = C_STEEL
    var ink = C_WHITE
    if has_maker {
        col = mk.colour
        ink = mk.ink
    }
    let pc = side_colour(s)
    var px = x0 + 4                     // the photograph: 64 x 104, whole tiles
    var ix = x0 + 70                    // the spec sheet: 82 x 108
    if s == 1 {
        px = x0 + 84
        ix = x0
    }
    // the name bar
    rect_blend(x0, 24, 152, 15, col, BLEND_NONE)
    rect_blend(x0, 38, 152, 1, 0x200C06, BLEND_SUB)
    let who = who_label(s)
    let tw = max(txt_w(FONT_LABEL, who) + 6, 14)
    var name = "? ? ?"
    if known {
        name = r.name
        if txt_w(FONT_HEAD, name) > 140 - tw { name = r.short }
        if txt_w(FONT_HEAD, name) > 140 - tw { name = r.card }
    }
    if s == 0 {
        txt(FONT_HEAD, x0 + 4, 24, name, ink, ALIGN_LEFT)
        tag(x0 + 146 - tw, 26, tw, who, pc, C_WHITE)
    } else {
        txt(FONT_HEAD, x0 + 148, 24, name, ink, ALIGN_RIGHT)
        tag(x0 + 2, 26, tw, who, pc, C_WHITE)
    }
    // the photograph
    print_ramp(s, col)
    print_photo(px / 8, 5, 8, 13, s)
    let ok = slot_ok(c)
    if ok {
        var mv = Mv.idle
        if sel_done[s] { mv = Mv.win }
        var fc = 1
        if s == 1 { fc = -1 }
        menu_mech_at(slot_mech(c), mv, px + 32, 137, 33.0, fc, turntable(s * 90))
    } else {
        txt_sh(FONT_TITLE, px + 32, 70, "?", C_WHITE, col, 2, ALIGN_CENTRE)
        if known { ui_stamp(&UI_STAMP_IN_TRANSIT[0], px + 32, 112, C_RED) }
        else { ui_stamp(&UI_STAMP_CLASSIFIED[0], px + 32, 112, C_RED) }
    }
    // the caption: the unit's height (and width, where it matters), or the figure's number
    if !known {
        let fb = sb()
        str_append(fb, 64, "FIG. ")
        str_append_int(fb, 64, c + 1, 2, true)
        txt(FONT_MICRO, px + 3, 134, fb, C_WHITE, ALIGN_LEFT)
    }
    // the spec sheet
    paper(ix, 40, 82, 108)
    if known {
        draw_specs(c, ix, has_maker)
    } else {
        txt(FONT_MICRO, ix + 3, 41, "MAKER: ?", C_STEEL, ALIGN_LEFT)
        txt(FONT_HEAD, ix + 3, 52, "? ? ?", C_INK, ALIGN_LEFT)
        rect_blend(ix + 4, 77, 74, 1, C_SILVER, BLEND_NONE)
        draw_hint(c, ix + 4, 81)
    }
    if sel_done[s] { ui_stamp(&UI_STAMP_READY[0], px + 32, 120, pc) }
    if ok && sel_moved[s] > sel_done_t[s] { ui_shine(ix, 24, 152, 15, tick - sel_moved[s], 1000) }
}

// The spec sheet's rows for a known slot.
private fn draw_specs(c: s32, ix: s32, has_maker: bool) {
    let r = &ROSTER[c]
    var col = C_NAVY
    if has_maker {
        let mk = &MAKERS[r.maker]
        col = mk.colour
        ui_power_icon(mk.src, ix + 4, 49)
        txt(FONT_MICRO, ix + 24, 45, mk.short, C_INK, ALIGN_LEFT)
        txt(FONT_MICRO, ix + 24, 55, SRC_NAMES[mk.src], C_STEEL, ALIGN_LEFT)
    }
    if slot_has_mech(c) {
        // mx-ladder: the arcade cleared with it, by difficulty
        txt(FONT_MICRO, ix + 4, 65, "CLEARED", C_STEEL, ALIGN_LEFT)
        for d in 0..DIFF_N { medal_seal(d, ix + 47 + d * 10, 66, slot_medal(c, d), true) }
    }
    rect_blend(ix + 4, 77, 74, 1, C_SILVER, BLEND_NONE)
    for k in 0..4 {
        let y = 81 + k * 10
        txt(FONT_MICRO, ix + 4, y - 1, STAT_NAMES[k], C_STEEL, ALIGN_LEFT)
        ui_pips(ix + 44, y + 1, ((r.stats >> ((3 - k) * 4)) & 15) as s32, col)
    }
    rect_blend(ix + 4, 122, 74, 1, C_SILVER, BLEND_NONE)
    if !slot_has_mech(c) {
        txt_lines(FONT_MICRO, ix + 4, 126, "IN TRANSIT:\nON SHOW LATER", 9, C_RED, ALIGN_LEFT)
    } else {
        txt_lines(FONT_MICRO, ix + 4, 126, r.blurb, 9, C_INK, ALIGN_LEFT)
    }
}

// How a locked slot unlocks (or only "CLASSIFIED", with the hints off).
private fn draw_hint(c: s32, x: s32, y: s32) {
    if !SHOW_UNLOCK_HINTS {
        txt(FONT_HEAD, x + 37, y + 14, "CLASSIFIED", C_RED, ALIGN_CENTRE)
        return
    }
    txt(FONT_MICRO, x, y, "TO UNLOCK:", C_STEEL, ALIGN_LEFT)
    txt_lines(FONT_MICRO, x, y + 10, ROSTER[c].hint, 9, C_INK, ALIGN_LEFT)
    if ROSTER[c].rule == RULE_BASES {
        let b = sb()
        str_append_int(b, 64, bases_cleared(), 0, false)
        str_append(b, 64, " OF ")
        str_append_int(b, 64, bases_in_game(), 0, false)
        str_append(b, 64, " CLEARED")
        txt(FONT_MICRO, x, y + 44, b, C_NAVY, ALIGN_LEFT)
    }
}

// The arcade's right-hand page: the trial's programme (mx-ladder): its grade, the rivals drawn
// by lot when the run starts, the final withheld.
private fn draw_schedule(x0: s32) {
    let d = &DIFFS[clamp(diff_sel, 0, DIFF_N - 1)]
    rect_blend(x0, 24, 152, 15, C_NAVY, BLEND_NONE)
    txt(FONT_HEAD, x0 + 148, 24, "PROGRAMME", C_WHITE, ALIGN_RIGHT)
    tag(x0 + 2, 26, 22, "CPU", C_STEEL, C_WHITE)
    paper(x0, 40, 152, 108)
    medal_seal(diff_sel, x0 + 5, 43, true, false)
    txt(FONT_LABEL, x0 + 22, 42, d.name, C_INK, ALIGN_LEFT)
    txt(FONT_MICRO, x0 + 146, 43, d.grade, C_STEEL, ALIGN_RIGHT)
    for n in 0..LADDER_N {
        let y = 58 + n * 22
        rect_blend(x0 + 5, y, 142, 19, 0xE6DCD2, BLEND_NONE)
        let b = sb()
        if ladder_final(n) {
            str_append(b, 64, "FINAL DAY")
            let fw = txt_w(FONT_LABEL, "FINAL") + 6
            tag(x0 + 142 - fw, y + 4, fw, "FINAL", C_RED, C_WHITE)
            txt(FONT_MICRO, x0 + 8, y + 9, "DETAILS WITHHELD", C_INK, ALIGN_LEFT)
        } else {
            str_append(b, 64, "DAY ")
            str_append_int(b, 64, n + 1, 0, false)
            txt(FONT_MICRO, x0 + 8, y + 9, "A RIVAL MAKER, DRAWN BY LOT", C_INK, ALIGN_LEFT)
        }
        txt(FONT_MICRO, x0 + 8, y, b, C_NAVY, ALIGN_LEFT)
    }
    rect_blend(x0 + 5, 124, 142, 1, C_SILVER, BLEND_NONE)
    ui_sprite(&UI_UAPC[0], PAL_LOGO, x0 + 6, 126, 0x808080, BLEND_NONE)
    txt(FONT_MICRO, x0 + 34, 127, "THE PRIZE:", C_STEEL, ALIGN_LEFT)
    txt(FONT_MICRO, x0 + 34, 136, "THE UAPC'S CONTRACT", C_INK, ALIGN_LEFT)
}

// The ten cards and the cursors.
private fn draw_grid() {
    for i in 0..ROSTER_N { draw_card(i, SEL_GX + (i % ROSTER_COLS) * SEL_PX, SEL_GY + (i / ROSTER_COLS) * SEL_PY) }
    for s in 0..2 {
        if s == 1 && game == Game.Arcade { continue }
        let c = sel_cur[s]
        let x = SEL_GX + (c % ROSTER_COLS) * SEL_PX
        let y = SEL_GY + (c / ROSTER_COLS) * SEL_PY
        let col = side_colour(s)
        var k = 3
        if s == 1 && sel_cur[0] == c && game != Game.Arcade { k = 1 }
        rect_outline(x - k, y - k, SEL_CW + 2 * k, SEL_CH + 2 * k, col, BLEND_NONE)
        if sel_done[s] || (tick >> 3) & 1 == 0 {
            rect_outline(x - k + 1, y - k + 1, SEL_CW + 2 * k - 2, SEL_CH + 2 * k - 2, col, BLEND_NONE)
        }
        ui_shine(x, y, SEL_CW, SEL_CH, tick - sel_moved[s], 90)
        if s == 0 { tag(x - 6, y - 7, 14, "1P", col, C_WHITE) }
        else { tag(x + SEL_CW - 10, y - 7, 14, who_tag(1), col, C_WHITE) }
    }
}

// 2P's short tag on the grid.
private fn who_tag(s: s32) -> *u8 {
    let w = who_label(s)
    if w[0] == 'D' { return "DM" }
    if w[0] == 'C' { return "CP" }
    return w
}

private fn draw_card(i: s32, x: s32, y: s32) {
    let r = &ROSTER[i]
    if slot_known(i) && r.maker >= 0 {
        let mk = &MAKERS[r.maker]
        let has = slot_has_mech(i)
        rect_blend(x + 2, y + 2, SEL_CW, SEL_CH, 0x402010, BLEND_SUB)
        rect_grad(x, y, SEL_CW, SEL_CH, PAPER, PAPER2, BLEND_NONE)
        rect_blend(x, y, SEL_CW, 3, mk.colour, BLEND_NONE)
        var tint = 0x808080
        var tc = C_INK
        if !has {
            tint = 0x484848
            tc = C_STEEL
        }
        ui_slot_emblem(i, x + 12, y + 3, true, tint)
        txt(FONT_MICRO, x + SEL_CW / 2, y + 24, r.card, tc, ALIGN_CENTRE)
        // mx-ladder: the difficulties cleared with it, award stickers on the card's corner
        for d in 0..DIFF_N {
            if slot_medal(i, d) { medal_seal(d, x + 19 + d * 10, y - 3, true, true) }
        }
    } else {
        // locked: a quiet tile, so the mechs on show stand out
        rect_blend(x, y, SEL_CW, SEL_CH, C_GLASS, BLEND_NONE)
        rect_outline(x, y, SEL_CW, SEL_CH, 0x6A4A2E, BLEND_NONE)
        txt(FONT_HEAD, x + SEL_CW / 2, y + 9, "?", C_STEEL, ALIGN_CENTRE)
    }
}

// ---- VS: the programme's next demonstration

const VS_TIMES: [3]*u8 = ["11:00", "14:00", "16:30"]   // the arcade's fights; the last is the final's

// The programme's time of fight n (the final always the last slot).
fn ladder_time(n: s32) -> *u8 {
    if ladder_final(n) { return VS_TIMES[2] }
    return VS_TIMES[clamp(n, 0, 1)]
}

fn draw_vs() {
    page_scroll()
    let t = st_t
    masthead("PROGRAMME", "NEXT DEMONSTRATION")
    print_clear()
    // the two booths' backdrops open out from their middle rows
    let rows = min(1 + t, 10)
    for s in 0..2 {
        print_ramp(s, unit_colour(s))
        var tx = 1
        if s == 1 { tx = 25 }
        print_grad(tx, 14 - rows, 14, rows, s, 1, 4)
        print_grad(tx, 14, 14, rows, s, 4, 9)
    }
    let k = min(t, 16)
    let off = (16 - k) * 12
    if t > 4 {
        side_mech_at(0, Mv.intro, 64, 184, 25.0, 1, 0.3)
        side_mech_at(1, Mv.intro, 256, 184, 25.0, -1, -0.3)
    }
    // the programme card
    let cy = 30 + off / 4
    paper(118, cy, 84, 150)
    rect_blend(118, cy, 84, 14, C_NAVY, BLEND_NONE)
    txt(FONT_MICRO, 160, cy + 2, "MAIN STAGE", C_WHITE, ALIGN_CENTRE)
    var when = VS_TIMES[0]
    if game == Game.Arcade { when = ladder_time(ladder) }
    txt(FONT_HEAD, 160, cy + 16, when, C_INK, ALIGN_CENTRE)
    let b = sb()
    if game == Game.Arcade {
        str_append(b, 64, "DEMONSTRATION ")
        str_append_int(b, 64, ladder + 1, 0, false)
        str_append(b, 64, "/")
        str_append_int(b, 64, LADDER_N, 0, false)
    } else if game == Game.Versus {
        str_append(b, 64, "OPEN DEMONSTRATION")
    } else {
        str_append(b, 64, "FREE PRACTICE")
    }
    txt(FONT_MICRO, 160, cy + 32, b, C_NAVY, ALIGN_CENTRE)
    rect_blend(124, cy + 43, 72, 1, C_SILVER, BLEND_NONE)
    if t > 16 {
        let sc = 2 + max(0, 24 - t) / 4
        txt_sh(FONT_TITLE, 160, cy + 52 - sc, "VS", C_RED, C_INK, sc, ALIGN_CENTRE)
        ui_shine(130, cy + 48, 60, 30, t - 24, 100)
    }
    rect_blend(124, cy + 86, 72, 1, C_SILVER, BLEND_NONE)
    ui_sprite(&UI_UAPC[0], PAL_LOGO, 148, cy + 92, 0x808080, BLEND_NONE)
    txt(FONT_MICRO, 160, cy + 118, "UAPC DEFENCE", C_INK, ALIGN_CENTRE)
    txt(FONT_MICRO, 160, cy + 126, "TRIAL // LIVE", C_INK, ALIGN_CENTRE)
    if (tick >> 4) & 1 == 0 { rect_blend(127, cy + 138, 5, 5, C_RED, BLEND_NONE) }
    txt(FONT_MICRO, 135, cy + 136, "ON AIR", C_RED, ALIGN_LEFT)
    // the booths' badges slide in
    draw_badge(0, 6 - off, 188)
    draw_badge(1, 174 + off, 188)
    // the announcer's line
    rect_blend(0, 227, 320, 13, C_NAVY, BLEND_NONE)
    rect_blend(0, 227, 320, 1, C_CYAN, BLEND_NONE)
    txt(FONT_SERIF, 160, 227, "Next up, live on the main stage...", C_WHITE, ALIGN_CENTRE)
}

// An exhibitor's badge for side s (140 x 32).
private fn draw_badge(s: s32, x: s32, y: s32) {
    let m = p_mech[s]
    paper(x, y, 140, 36)
    rect_blend(x, y, 4, 36, unit_colour(s), BLEND_NONE)
    unit_emblem24(s, x + 8, y + 6)
    if p_grey[s] { txt(FONT_HEAD, x + 36, y + 1, TEST_SHORT, C_INK, ALIGN_LEFT) }
    else { txt(FONT_HEAD, x + 36, y + 1, mech_short(m), C_INK, ALIGN_LEFT) }
    txt(FONT_MICRO, x + 36, y + 16, unit_maker_short(s), C_STEEL, ALIGN_LEFT)
    txt(FONT_MICRO, x + 36, y + 25, unit_booth(s), C_NAVY, ALIGN_LEFT)
    let who = who_label(s)
    let tw = max(txt_w(FONT_LABEL, who) + 6, 14)
    tag(x + 134 - tw, y + 26, tw, who, side_colour(s), C_WHITE)
}

// ---- the fight's overlays

fn draw_fight_overlay() {
    let f = fight_get()
    let training = game == Game.Training
    hud_draw(f, training, who_label(0), who_label(1))
    let t = f.phase_t
    match f.phase {
        // the round calls in the trial's own words (mx-ladder): a round is a test of the
        // demonstration, read out like a procurement minute
        Intro => {
            let b = sb()
            let sub = sb2()
            if f.wins[0] == 1 && f.wins[1] == 1 {
                str_append(b, 64, "DECIDING TEST")
                str_append(sub, 64, "FINAL ROUND // UNITS TO THEIR MARKS")
            } else {
                str_append(b, 64, "TEST ")
                str_append_int(b, 64, f.round, 0, false)
                str_append(sub, 64, "ROUND ")
                str_append_int(sub, 64, f.round, 0, false)
                str_append(sub, 64, " // UNITS TO THEIR MARKS")
            }
            if !training { hud_banner(b, sub, t, C_WHITE) }
        }
        Fight => {
            if t < 50 && !training { hud_banner("COMMENCE", null, t, C_YELLOW) }
        }
        Ko => {
            if f.ringout >= 0 { hud_banner("OUT OF BOUNDS", "UNIT LEFT THE TEST AREA", t, C_TANGERINE) }
            else if f.timer <= 0 { hud_banner("TIME EXPIRED", "THE JUDGES CONSULT THE DATA", t, C_TANGERINE) }
            else { hud_banner("CONCLUDED", "UNIT NO LONGER OPERATIONAL", t, C_WHITE) }
        }
        RoundOver => {
            if f.round_winner == 0 || f.round_winner == 1 {
                let b = sb()
                str_append(b, 64, "TEST SCORED FOR ")
                str_append(b, 64, who_label(f.round_winner))
                hud_banner(unit_short(f, f.round_winner), b, t, C_WHITE)
            } else {
                hud_banner("NO RESULT", "THE TEST WILL BE REPEATED", t, C_WHITE)
            }
        }
        MatchOver => {
            if f.winner == 0 || f.winner == 1 {
                hud_banner(unit_short(f, f.winner), "MEETS THE REQUIREMENTS", t, C_YELLOW)
            } else {
                hud_banner("INCONCLUSIVE", "BOTH UNITS TO BE RE-TESTED", t, C_WHITE)
            }
        }
    }
    if training {
        let b = sb()
        str_append(b, 64, "TRAINING // DUMMY ")
        str_append(b, 64, DUMMY_NAMES[train.dummy as s32])
        overlay_label(b)
    } else if cam_angled && f.phase == Phase.Fight {
        overlay_label("CAMERA // ANGLED")
    }
}

// A small label under the timer, on a dark pill (the hall behind it is busy).
private fn overlay_label(s: *u8) {
    let w = txt_w(FONT_LABEL, s) + 10
    rect_blend(160 - w / 2, 38, w, 11, 0x2A1006, BLEND_NONE)
    txt(FONT_LABEL, 160, 37, s, C_SILVER, ALIGN_CENTRE)
}

const DUMMY_NAMES: [5]*u8 = ["STAND", "CROUCH", "JUMP", "BLOCK ALL", "CPU"]


// ---- pause: a translucent clipboard over the fight

fn draw_pause() {
    rect_blend(0, 0, 320, 240, 0x301008, BLEND_HALF)
    if pause_page == 1 {
        draw_move_list()
        return
    }
    var items: [8]s32
    let n = pause_items(&items[0])
    let h = 48 + n * 15
    let y0 = 124 - h / 2
    clipboard(76, y0, 168, h)
    txt(FONT_HEAD, 90, y0 + 12, "DEMO ON HOLD", C_INK, ALIGN_LEFT)
    txt(FONT_MICRO, 230, y0 + 15, "PAUSE", C_STEEL, ALIGN_RIGHT)
    rect_blend(90, y0 + 29, 140, 1, C_SILVER, BLEND_NONE)
    for i in 0..n {
        let y = y0 + 33 + i * 15
        let on = i == pause_sel
        if on {
            rect_blend(86, y - 1, 148, 13, C_NAVY, BLEND_NONE)
            ui_shine(86, y - 1, 148, 13, tick, 80)
        }
        var col = C_INK
        if on { col = C_WHITE }
        let it = items[i]
        var name = "RESUME"
        var val: *u8 = null
        if it == PZ_CAMERA {
            name = "CAMERA"
            if cam_angled { val = "ANGLED" } else { val = "SIDE-ON" }
        } else if it == PZ_DUMMY {
            name = "DUMMY"
            val = DUMMY_NAMES[train.dummy as s32]
        } else if it == PZ_REFILL {
            name = "REFILL"
            if train.refill_health { val = "ON" } else { val = "OFF" }
        } else if it == PZ_BOXES {
            name = "HIT BOXES"
            if show_boxes { val = "SHOW" } else { val = "HIDE" }
        } else if it == PZ_MOVES {
            name = "MOVE LIST"
        } else if it == PZ_SELECT {
            name = "CHARACTER SELECT"
        } else if it == PZ_QUIT {
            name = "QUIT TO TITLE"
        }
        ui_check(91, y + 1, on, col)
        txt(FONT_LABEL, 106, y - 1, name, col, ALIGN_LEFT)
        if val != null {
            var vc = C_NAVY
            if on { vc = C_CYAN }
            txt(FONT_LABEL, 230, y - 1, val, vc, ALIGN_RIGHT)
        }
    }
}

// The clipboard: smoky translucent acrylic with cyan edges, a chrome clip, a sheet of paper.
private fn clipboard(x: s32, y: s32, w: s32, h: s32) {
    rect_blend(x, y, w, h, 0x7A4420, BLEND_HALF)
    rect_blend(x, y, w, h, 0x281408, BLEND_QUARTER)
    rect_outline(x, y, w, h, C_CYAN, BLEND_NONE)
    rect_blend(x + 1, y + 1, w - 2, 1, 0xFFFFFF, BLEND_QUARTER)
    paper(x + 8, y + 8, w - 16, h - 14)
    let cx = x + w / 2
    rect_blend(cx - 24, y - 5, 48, 12, 0x402010, BLEND_SUB)
    ui_chrome(cx - 26, y - 7, 52, 12)
    rect_blend(cx - 8, y - 3, 16, 3, 0x6A5444, BLEND_NONE)
    ui_shine(cx - 26, y - 7, 52, 12, tick, 110)
}

private fn draw_move_list() {
    let m = p_mech[0]
    let ml = fight_moves(m)
    clipboard(24, 12, 272, 220)
    rect_blend(32, 20, 4, 205, mech_colour(m), BLEND_NONE)
    txt(FONT_HEAD, 42, 22, "MOVE LIST", C_INK, ALIGN_LEFT)
    ui_power_icon(mech_src(m), 268, 22)
    txt(FONT_MICRO, 262, 21, mech_name(m), C_INK, ALIGN_RIGHT)
    txt(FONT_MICRO, 262, 29, mech_maker(m), C_STEEL, ALIGN_RIGHT)
    rect_blend(42, 40, 242, 1, C_SILVER, BLEND_NONE)
    if ml.n == 0 {
        txt(FONT_LABEL, 160, 110, "THE MOVE LIST IS NOT IN YET", C_STEEL, ALIGN_CENTRE)
    }
    for i in 0..min(ml.n, MOVES_MAX) {
        let y = 43 + i * 11
        if i % 2 == 0 { rect_blend(42, y, 242, 11, 0xE8DCD2, BLEND_NONE) }
        txt(FONT_LABEL, 46, y - 1, ml.e[i].name, C_INK, ALIGN_LEFT)
        txt(FONT_LABEL, 280, y - 1, ml.e[i].input, C_NAVY, ALIGN_RIGHT)
    }
    txt(FONT_MICRO, 284, 220, "B BACK", C_STEEL, ALIGN_RIGHT)
}

// ---- results: the UAPC's judging sheet

fn draw_results() {
    page_scroll()
    let f = fight_get()
    var w = f.winner
    if w < 0 || w > 1 { w = 0 }
    let wm = f.f[w].mech
    masthead("JUDGING SHEET", MODE_NAMES[game as s32])
    print_clear()
    // the winner's photograph
    var pcol = C_STEEL
    if f.winner != 2 { pcol = unit_colour(w) }
    print_ramp(0, pcol)
    print_photo(1, 4, 14, 23, 0)
    if f.winner == 0 || f.winner == 1 {
        side_mech_at(w, Mv.win, 64, 204, 19.0, 1, turntable(0) / 2)
        tag(10, 36, 34, "WINNER", side_colour(w), C_WHITE)
        tag(48, 36, 18, who_label(w), C_INK, C_WHITE)
    }
    // the sheet
    let x = 128
    paper(x, 28, 184, 196)
    ui_sprite(&UI_UAPC[0], PAL_LOGO, x + 6, 32, 0x808080, BLEND_NONE)
    txt(FONT_MICRO, x + 34, 31, "UAPC DEFENCE TRIAL", C_STEEL, ALIGN_LEFT)
    txt(FONT_HEAD, x + 34, 39, "DEMO REPORT", C_INK, ALIGN_LEFT)
    rect_blend(x + 6, 58, 172, 1, C_NAVY, BLEND_NONE)
    if f.winner == 2 {
        sheet_row(x, 62, "UNIT", "NO DECISION", C_INK)
        sheet_row(x, 72, "MAKERS", "BOTH TO BE RE-TESTED", C_INK)
    } else {
        sheet_row(x, 62, "UNIT", unit_name(w), C_INK)
        sheet_row(x, 72, "MAKER", unit_maker(w), C_INK)
        sheet_row(x, 82, "BOOTH", unit_booth(w), C_INK)
    }
    let b = sb()
    str_append_int(b, 64, f.wins[0], 0, false)
    str_append(b, 64, " - ")
    str_append_int(b, 64, f.wins[1], 0, false)
    sheet_row(x, 92, "ROUNDS", b, C_INK)
    let hb = sb()
    str_append_int(hb, 64, max(f.f[w].health, 0) * 100 / max(f.f[w].health_max, 1), 0, false)
    str_append(hb, 64, " %")
    sheet_row(x, 102, "INTEGRITY", hb, C_INK)
    rect_blend(x + 6, 113, 172, 1, C_SILVER, BLEND_NONE)
    if f.winner != 2 && st_t > 12 {
        ui_stamp(&UI_STAMP_APPROVED[0], x + 138, 101, C_RED)
    }
    // what next
    if game == Game.Arcade {
        if !won {
            txt(FONT_MICRO, x + 92, 117, "THE EXHIBITOR MAY", C_STEEL, ALIGN_CENTRE)
            txt(FONT_HEAD, x + 92, 125, "REQUEST ANOTHER", C_RED, ALIGN_CENTRE)
            txt(FONT_HEAD, x + 92, 139, "DEMONSTRATION?", C_RED, ALIGN_CENTRE)
            txt(FONT_MICRO, x + 92, 157, "A  SAME UNIT, SAME OPPONENT", C_INK, ALIGN_CENTRE)
            txt(FONT_MICRO, x + 92, 167, "B  WITHDRAW FROM THE TRIAL", C_INK, ALIGN_CENTRE)
        } else if !cleared {
            txt(FONT_MICRO, x + 92, 120, "NEXT ON THE PROGRAMME", C_STEEL, ALIGN_CENTRE)
            if ladder_final(ladder + 1) {
                txt(FONT_HEAD, x + 92, 129, "THE FINAL", C_NAVY, ALIGN_CENTRE)
                txt(FONT_MICRO, x + 92, 146, "DETAILS WITHHELD", C_RED, ALIGN_CENTRE)
            } else {
                txt(FONT_HEAD, x + 92, 129, ladder_unit_name(ladder + 1), C_NAVY, ALIGN_CENTRE)
                txt(FONT_MICRO, x + 92, 146, ladder_maker_name(ladder + 1), C_STEEL, ALIGN_CENTRE)
            }
            txt(FONT_MICRO, x + 92, 158, "A  CONTINUE", C_INK, ALIGN_CENTRE)
        } else {
            txt(FONT_HEAD, x + 92, 120, "TRIAL COMPLETE", C_NAVY, ALIGN_CENTRE)
            txt(FONT_MICRO, x + 92, 138, "CONTRACT SHORTLISTED", C_INK, ALIGN_CENTRE)
            txt(FONT_MICRO, x + 92, 148, "A  CONTINUE", C_INK, ALIGN_CENTRE)
        }
    } else {
        const ITEMS: [3]*u8 = ["REMATCH", "CHARACTER SELECT", "TITLE"]
        txt(FONT_MICRO, x + 8, 117, "THE JUDGES REQUEST:", C_STEEL, ALIGN_LEFT)
        for i in 0..3 {
            let y = 128 + i * 14
            var col = C_INK
            if i == res_sel {
                rect_blend(x + 6, y - 1, 172, 13, C_NAVY, BLEND_NONE)
                col = C_WHITE
            }
            ui_check(x + 10, y + 1, i == res_sel, col)
            txt(FONT_LABEL, x + 24, y - 1, ITEMS[i], col, ALIGN_LEFT)
        }
    }
    // the judges' signatures
    rect_blend(x + 8, 196, 70, 1, C_STEEL, BLEND_NONE)
    rect_blend(x + 106, 196, 70, 1, C_STEEL, BLEND_NONE)
    txt(FONT_SERIF, x + 12, 182, "T. Okada", C_NAVY, ALIGN_LEFT)
    txt(FONT_SERIF, x + 110, 182, "R. Hale", C_NAVY, ALIGN_LEFT)
    txt(FONT_MICRO, x + 8, 198, "CHIEF JUDGE", C_STEEL, ALIGN_LEFT)
    txt(FONT_MICRO, x + 106, 198, "UAPC OBSERVER", C_STEEL, ALIGN_LEFT)
    draw_save_status(x + 92, 209)
    footer("UAPC DEFENCE TRIAL  //  RESULTS FILED", "P. 12")
}

private fn sheet_row(x: s32, y: s32, k: *u8, v: *u8, col: u32) {
    txt(FONT_MICRO, x + 8, y, k, C_STEEL, ALIGN_LEFT)
    txt(FONT_MICRO, x + 56, y, v, col, ALIGN_LEFT)
}

// The memory card's message, a dark chip centred on x: saving, saved, or why not.
private fn draw_save_status(x: s32, y: s32) {
    var msg: *u8 = null
    var col = C_CYAN
    if save_writing {
        if (tick >> 3) & 1 == 0 { msg = "SAVING TO MEMORY CARD..." } else { msg = "SAVING TO MEMORY CARD" }
    } else if save_result != -1 && save_shown < 240 {
        if save_result == CARD_OK {
            msg = "SAVED TO MEMORY CARD"
        } else if save_result == CARD_NO_CARD {
            msg = "NO MEMORY CARD // NOT SAVED"
            col = C_TANGERINE
        } else if save_result == CARD_FULL {
            msg = "MEMORY CARD FULL // NOT SAVED"
            col = C_TANGERINE
        } else {
            msg = "MEMORY CARD ERROR // NOT SAVED"
            col = C_TANGERINE
        }
    }
    if msg == null { return }
    let w = txt_w(FONT_MICRO, msg) + 24
    let x0 = x - w / 2
    rect_blend(x0, y, w, 13, C_GLASS, BLEND_NONE)
    rect_blend(x0, y, w, 1, col, BLEND_NONE)
    // the card: a small chip with a notch
    rect_blend(x0 + 5, y + 2, 9, 9, C_SILVER, BLEND_NONE)
    rect_blend(x0 + 11, y + 2, 3, 3, C_GLASS, BLEND_NONE)
    rect_blend(x0 + 7, y + 7, 5, 2, col, BLEND_NONE)
    txt(FONT_MICRO, x0 + 18, y + 1, msg, col, ALIGN_LEFT)
}

// ---- the unlock: a press release

fn draw_unlock() {
    page_scroll()
    var s = unlock_slot
    if s < 0 || !slot_has_mech(s) { s = ROSTER_COLS }
    let m = slot_mech(s)
    let mk = mech_maker_of(m)
    let t = st_t
    masthead("PRESS RELEASE", "NEW EXHIBITOR")
    print_clear()
    print_ramp(0, mk.colour)
    print_grad(4, 3, 32, 21, 0, 12, 5)              // a spotlit stage: dark above, the unit lit
    print_fill(4, 24, 32, 1, 0, PT_DITHER + 6)
    print_grad(4, 25, 32, 2, 0, 8, 9)
    menu_mech_at(m, Mv.intro, 160, 210, 21.0, -1, turntable(0) / 2)
    if (t >> 2) & 1 == 0 || t > 40 {
        txt_sh(FONT_HEAD, 160, 28, "NEW DEMO UNIT REGISTERED", C_WHITE, C_INK, 1, ALIGN_CENTRE)
    }
    txt_sh(FONT_TITLE, 160, 44, mech_name(m), C_WHITE, C_INK, 2, ALIGN_CENTRE)
    // the release's fact box
    paper(232, 80, 80, 76)
    ui_slot_emblem(s, 238, 84, false, 0x808080)
    ui_power_icon(mk.src, 290, 92)
    txt(FONT_MICRO, 237, 118, mk.short, C_INK, ALIGN_LEFT)
    txt(FONT_MICRO, 237, 127, mk.booth_full, C_NAVY, ALIGN_LEFT)
    txt(FONT_MICRO, 237, 136, mech_power(m), C_STEEL, ALIGN_LEFT)
    txt(FONT_MICRO, 237, 145, ROSTER[s].model, C_STEEL, ALIGN_LEFT)
    if t > 30 {
        // the stamp comes down
        let k = max(0, 36 - t)
        let r = &UI_STAMP_UNLOCKED[0]
        let sw = r[2] + k * 8
        let shh = r[3] + k * 3
        menu_sprite(r, 72 - sw / 2, 120 - shh / 2, sw, shh, col_tint(C_RED), BLEND_NONE)
    }
    rect_blend(0, 214, 320, 26, C_NAVY, BLEND_NONE)
    rect_blend(0, 214, 320, 1, C_CYAN, BLEND_NONE)
    txt(FONT_SERIF, 160, 214, "...joins the show floor. On sale to the UAPC.", C_WHITE, ALIGN_CENTRE)
    if t > 90 && !save_writing { txt(FONT_MICRO, 312, 229, "PRESS A", C_CYAN, ALIGN_RIGHT) }
    draw_save_status(84, 196)
}

// ---- the stage select (mx-stages): the venue guide, a card a stage (stage_select.akr)

fn draw_stage_select() {
    page_scroll()
    masthead("VENUE GUIDE", "STAGE")
    print_clear()
    let n = STAGES_N
    let cw = ((312 / n) / 8) * 8 - 8       // whole tiles, for the photograph
    for i in 0..n {
        let s = stage_row(i)
        let x = 8 + i * (cw + 8)
        let on = i == stage_sel
        // the name bar in the venue's colour
        rect_blend(x, 32, cw, 15, s.colour, BLEND_NONE)
        rect_blend(x, 46, cw, 1, 0x200C06, BLEND_SUB)
        var name = s.name
        if txt_w(FONT_HEAD, name) > cw - 8 { name = s.short }
        txt(FONT_HEAD, x + 4, 32, name, C_WHITE, ALIGN_LEFT)
        // the photograph (the print layer): the venue's colour, its floor and edges over it
        let k = min(i, 2)
        print_ramp(k, s.colour)
        print_photo(x / 8, 6, cw / 8, 10, k)
        stage_diagram(s, x + 8, 52, cw - 16, 72)
        // the sheet
        paper(x, 128, cw, 80)
        txt(FONT_MICRO, x + 6, 130, s.venue, C_STEEL, ALIGN_LEFT)
        rect_blend(x + 6, 142, cw - 12, 1, C_SILVER, BLEND_NONE)
        txt(FONT_MICRO, x + 6, 146, "EDGES", C_STEEL, ALIGN_LEFT)
        let eb = sb()
        str_append(eb, 64, edge_name(s, 0))
        str_append(eb, 64, "  //  ")
        str_append(eb, 64, edge_name(s, 1))
        txt(FONT_MICRO, x + cw - 6, 146, eb, C_NAVY, ALIGN_RIGHT)
        txt_lines(FONT_MICRO, x + 6, 160, s.blurb, 9, C_INK, ALIGN_LEFT)
        if stage_open(s, 0) || stage_open(s, 1) {
            let tw = txt_w(FONT_LABEL, "RING-OUTS") + 6
            tag(x + cw - 6 - tw, 190, tw, "RING-OUTS", C_RED, C_WHITE)
        }
        if on {
            rect_outline(x - 3, 29, cw + 6, 182, C_RED, BLEND_NONE)
            if stage_done_t > 0 || (tick >> 3) & 1 == 0 { rect_outline(x - 2, 30, cw + 4, 180, C_RED, BLEND_NONE) }
            tag(x - 6, 25, 14, "1P", C_RED, C_WHITE)
            ui_shine(x, 32, cw, 15, tick - stage_moved, 90)
            if stage_done_t > 0 { ui_stamp(&UI_STAMP_READY[0], x + cw / 2, 84, C_RED) }
        }
    }
    footer("LEFT/RIGHT CHOOSE  //  A CONFIRM  //  B BACK", "P. 08")
}

// "WALL" or "OPEN" for side k of a stage (0: the left).
private fn edge_name(s: *Stage, k: s32) -> *u8 {
    if stage_open(s, k) { return "OPEN" }
    return "WALL"
}

// A side elevation of a stage in (x, y, w, h): the floor, a wall as a pillar, an open edge as the
// floor's end with its hazard line and the drop.
private fn stage_diagram(s: *Stage, x: s32, y: s32, w: s32, h: s32) {
    let fy = y + h - 18
    var x0 = x + 8
    var x1 = x + w - 8
    if stage_open(s, 0) { x0 += 14 }
    if stage_open(s, 1) { x1 -= 14 }
    rect_blend(x0, fy, x1 - x0, 3, C_INK, BLEND_NONE)
    rect_blend(x0, fy + 3, x1 - x0, 6, 0x6A4A2E, BLEND_NONE)
    // the start marks
    let mid = (x0 + x1) / 2
    rect_blend(mid - 22, fy - 7, 3, 7, C_RED, BLEND_NONE)
    rect_blend(mid + 19, fy - 7, 3, 7, C_BLUE, BLEND_NONE)
    for k in 0..2 {
        var ex = x0
        var d = -1
        if k == 1 {
            ex = x1
            d = 1
        }
        if stage_open(s, k) {
            // the hazard line at the lip, and the drop
            for j in 0..3 {
                var c = C_INK
                if j % 2 == 0 { c = C_YELLOW }
                rect_blend(ex - d * (2 + j * 4) - 1, fy - 2, 2, 2, c, BLEND_NONE)
            }
            let ax = ex + d * 8
            rect_blend(ax - 1, fy - 2, 2, 14, C_WHITE, BLEND_NONE)
            tri_fill(ax - 4, fy + 12, ax + 4, fy + 12, ax, fy + 17, C_WHITE, BLEND_NONE)
        } else {
            var px = ex
            if k == 0 { px = ex - 5 }
            rect_blend(px, y + 10, 5, fy - y - 7, C_INK, BLEND_NONE)
            rect_blend(px, y + 10, 5, 2, C_SILVER, BLEND_NONE)
        }
    }
}

// ---- the arcade's run (mx-ladder; ladder.akr)

var diff_slide: [3]s32              // each grade card's pull, in 1/16 px

// The difficulty select: the trial's three grades, a card each with its APPROVED seal in its ink
// (bronze, silver, gold: the seals a clear earns on the select's cards), and how many units
// carry it.
fn draw_diff() {
    page_scroll()
    masthead("TRIAL GRADES", "ARCADE")
    print_clear()
    for i in 0..DIFF_N {
        let d = &DIFFS[i]
        let on = i == diff_sel
        var target = 0
        if on { target = 8 * 16 }
        diff_slide[i] += (target - diff_slide[i]) / 3
        let x = 14 + diff_slide[i] / 16
        let y = 28 + i * 64
        let w = 290
        paper(x, y, w, 58)
        rect_blend(x, y, 6, 58, d.ink, BLEND_NONE)
        var tc = C_INK
        var gc = C_NAVY
        if !on {
            tc = C_STEEL
            gc = C_STEEL
        }
        medal_seal(i, x + 13, y + 9, true, false)
        txt(FONT_TITLE, x + 31, y + 2, d.name, tc, ALIGN_LEFT)
        txt(FONT_HEAD, x + 14, y + 34, d.grade, gc, ALIGN_LEFT)
        rect_blend(x + 150, y + 8, 1, 42, C_SILVER, BLEND_NONE)
        txt_lines(FONT_MICRO, x + 157, y + 8, d.blurb, 9, tc, ALIGN_LEFT)
        // how many units carry this grade's stamp
        var n = 0
        var of = 0
        for s in 0..ROSTER_N {
            if !slot_has_mech(s) { continue }
            of += 1
            if slot_medal(s, i) { n += 1 }
        }
        let b = sb()
        str_append(b, 64, "STAMPED: ")
        str_append_int(b, 64, n, 0, false)
        str_append(b, 64, " OF ")
        str_append_int(b, 64, of, 0, false)
        str_append(b, 64, " UNITS")
        txt(FONT_MICRO, x + 157, y + 38, b, C_STEEL, ALIGN_LEFT)
        if on {
            rect_outline(x - 2, y - 2, w + 4, 62, C_NAVY, BLEND_NONE)
            if (tick >> 3) & 1 == 0 { rect_outline(x - 1, y - 1, w + 2, 60, C_NAVY, BLEND_NONE) }
            tri_fill(x - 12, y + 21, x - 12, y + 37, x - 5, y + 29, C_NAVY, BLEND_NONE)
            ui_shine(x, y, w, 30, tick, 120)
        }
    }
    footer("UP/DOWN CHOOSE  //  A ENTER  //  B BACK", "P. 03")
}

// The schedule page between fights: your exhibit on the left (its photograph, the mech on a
// turntable), the day's programme on the right: each demonstration's day, time and venue, the
// rival's maker and unit; those already won stamped APPROVED (the last one coming down), the
// next highlighted, the final's details withheld until its reveal.
fn draw_sched() {
    page_scroll()
    let t = st_t
    let tb = sb2()
    if ladder_final(ladder) {
        str_append(tb, 64, "FINAL DAY")
    } else {
        str_append(tb, 64, "DAY ")
        str_append_int(tb, 64, ladder + 1, 0, false)
    }
    masthead("TODAY'S PROGRAMME", tb)
    print_clear()
    // your exhibit
    let me = p_mech[0]
    let mk = mech_maker_of(me)
    print_ramp(0, mk.colour)
    print_photo(1, 4, 13, 14, 0)
    menu_mech_at(me, Mv.idle, 60, 140, 30.0, 1, turntable(0))
    tag(10, 36, txt_w(FONT_LABEL, "YOUR EXHIBIT") + 6, "YOUR EXHIBIT", C_RED, C_WHITE)
    paper(8, 150, 104, 70)
    rect_blend(8, 150, 104, 3, mk.colour, BLEND_NONE)
    txt(FONT_HEAD, 13, 154, mech_short(me), C_INK, ALIGN_LEFT)
    txt(FONT_MICRO, 13, 170, mk.short, C_STEEL, ALIGN_LEFT)
    txt(FONT_MICRO, 13, 179, mk.booth_full, C_NAVY, ALIGN_LEFT)
    rect_blend(13, 191, 94, 1, C_SILVER, BLEND_NONE)
    let d = &DIFFS[run.diff]
    medal_seal(run.diff, 13, 196, true, false)
    txt(FONT_LABEL, 30, 194, d.name, C_INK, ALIGN_LEFT)
    txt(FONT_MICRO, 30, 205, d.grade, C_STEEL, ALIGN_LEFT)
    // the programme
    let x = 120
    paper(x, 28, 192, 194)
    ui_sprite(&UI_UAPC[0], PAL_LOGO, x + 6, 31, 0x808080, BLEND_NONE)
    txt(FONT_MICRO, x + 34, 30, "UAPC DEFENCE TRIAL", C_STEEL, ALIGN_LEFT)
    txt(FONT_HEAD, x + 34, 40, "PROGRAMME", C_INK, ALIGN_LEFT)
    rect_blend(x + 6, 57, 180, 1, C_NAVY, BLEND_NONE)
    for n in 0..LADDER_N {
        let y = 62 + n * 52
        let next = n == ladder
        let fin = ladder_final(n)
        var ink = C_INK
        var sub = C_STEEL
        if next {
            rect_blend(x + 3, y - 2, 186, 49, C_NAVY, BLEND_NONE)
            ui_shine(x + 3, y - 2, 186, 49, t, 140)
            ink = C_WHITE
            sub = C_SKY
        } else if n % 2 == 1 {
            rect_blend(x + 3, y - 2, 186, 49, 0xE6DCD2, BLEND_NONE)
        }
        // day, time, venue
        let b = sb()
        if fin {
            str_append(b, 64, "FINAL DAY")
        } else {
            str_append(b, 64, "DAY ")
            str_append_int(b, 64, n + 1, 0, false)
        }
        str_append(b, 64, "  //  ")
        str_append(b, 64, ladder_time(n))
        str_append(b, 64, "  //  ")
        var sti = LADDER_STAGES[len(LADDER_STAGES) - 1]
        if !fin { sti = LADDER_STAGES[clamp(n, 0, len(LADDER_STAGES) - 2)] }
        str_append(b, 64, stage_row(sti).short)
        txt(FONT_MICRO, x + 8, y, b, sub, ALIGN_LEFT)
        if fin && n >= ladder {
            // the final: withheld until its reveal
            txt(FONT_TITLE, x + 20, y + 10, "?", ink, ALIGN_CENTRE)
            txt(FONT_MICRO, x + 38, y + 11, "OPPONENT TO BE ANNOUNCED", sub, ALIGN_LEFT)
            txt(FONT_HEAD, x + 38, y + 20, "THE FINAL", ink, ALIGN_LEFT)
            ui_stamp(&UI_STAMP_CLASSIFIED[0], x + 152, y + 33, C_RED)
        } else {
            ladder_emblem24(n, x + 8, y + 12, 0x808080)
            txt(FONT_MICRO, x + 38, y + 11, ladder_maker_name(n), sub, ALIGN_LEFT)
            txt(FONT_HEAD, x + 38, y + 20, ladder_unit_name(n), ink, ALIGN_LEFT)
        }
        if next {
            let tw = txt_w(FONT_LABEL, "NEXT") + 6
            if (tick >> 4) & 1 == 0 || t < 30 { tag(x + 180 - tw, y + 1, tw, "NEXT", C_RED, C_WHITE) }
        }
        if n < ladder {
            // won: APPROVED, the latest coming down as the page opens
            let r = &UI_STAMP_APPROVED[0]
            var k = 0
            if n == ladder - 1 { k = max(0, 16 - t) }
            if n < ladder - 1 || t > 8 {
                let sw = r[2] + k * 6
                let shh = r[3] + k * 2
                menu_sprite(r, x + 150 - sw / 2, y + 33 - shh / 2, sw, shh, col_tint(C_RED), BLEND_NONE)
            }
        }
    }
    if t > SCHED_WAIT && ((tick >> 4) & 1 == 0) {
        footer("A  PROCEED TO THE MAIN STAGE", "P. 09")
    } else {
        footer("", "P. 09")
    }
}

// The final's reveal: the stage goes dark, the trial's announcement is typed out a line at a
// time, the opponent stands in silhouette (the GPU's fog toward the dark), then the lights come
// up on it: your echo, the original "defending its title", or the UAPC's own test unit.
fn draw_reveal() {
    let t = st_t
    let fin = run.fin
    let foe = run.foe[ladder]
    // the dark hall and two spotlights coming up on the stage, on the print layer (BG0) so the
    // unit stands in front of them
    print_ramp(0, 0x5A2810)
    print_grad(0, 0, 40, 30, 0, 15, 13)
    let lit = clamp((t - 20) / 10, 0, 3)
    if lit > 0 {
        let sh = 14 - 2 * lit                       // the cones' shade: 12, 10, 8
        for ty in 0..26 {
            let a0 = 5 + (15 - 5) * ty / 25         // the left cone's middle, in tiles
            let b0 = 34 - (34 - 24) * ty / 25       // the right one's
            let hw = 1 + 4 * ty / 25
            spot_span(a0 - hw, a0 + hw, ty, sh)
            spot_span(b0 - hw, b0 + hw, ty, sh)
            let o0 = max(a0 - hw, b0 - hw)
            let o1 = min(a0 + hw, b0 + hw)
            if o1 >= o0 { spot_span(o0, o1, ty, sh - 2) }
        }
        spot_span(13, 26, 26, sh - 2)               // the pool of light on the floor
    }
    if t > 150 && t < 170 {
        let k = (170 - t) * 12
        rect_blend(0, 0, 320, 240, rgb(k, k, k), BLEND_ADD)
    }
    // the unit: a silhouette, then lit
    if t > 50 {
        var mv = Mv.idle
        var f = fixed(tick % max(anim_len(foe, Mv.idle), 1))
        if t >= 150 {
            mv = Mv.intro
            f = fixed(min(t - 150, anim_len(foe, Mv.intro) - 1))
        }
        if t < 185 {
            var k = 1.0
            if t > 150 { k = fixed(185 - t) / 35 }
            gpu_fog(0x100604, 0.0, 22.0 / max(k, 0.02))
        }
        anim_grey = run.grey[ladder]
        menu_mech_f(foe, mv, f, 160, 198, 24.0, -1, -0.2)
        anim_grey = false
    }
    // the announcement
    txt(FONT_MICRO, 160, 6, "UAPC DEFENCE TRIAL  //  THE FINAL DEMONSTRATION", C_SKY, ALIGN_CENTRE)
    var l0 = ""
    var l1 = ""
    var l2 = ""
    let mk = ladder_maker_name(ladder)
    if fin == FIN_TEST {
        l0 = "THE UAPC WILL NOW EVALUATE"
        l1 = "YOUR PRODUCT AGAINST"
        l2 = "ITS OWN TEST UNIT"
    } else if fin == FIN_ORIGINAL {
        l0 = mk
        l1 = "DEFENDS ITS TITLE"
    } else {
        l0 = mk
        l1 = "PRESENTS ITS COMPETING PRODUCT"
    }
    reveal_line(l0, 26, t - 20, C_WHITE)
    reveal_line(l1, 42, t - 20 - strlen(l0) / 2, C_WHITE)
    reveal_line(l2, 58, t - 20 - (strlen(l0) + strlen(l1)) / 2, C_WHITE)
    // the nameplate, once lit
    if t > 175 {
        let s = min(t - 175, 10)
        rect_blend(0, 196, 320, 28, C_GLASS, BLEND_NONE)
        rect_blend(0, 196, 320, 1, C_CYAN, BLEND_NONE)
        rect_blend(0, 223, 320, 1, C_CYAN, BLEND_NONE)
        ladder_emblem24(ladder, 10, 198, 0x808080)
        var nm = ladder_unit_name(ladder)
        if txt_w(FONT_TITLE, nm) > 270 { nm = mech_short(foe) }
        txt_sh(FONT_TITLE, 42 - (10 - s) * 6, 195, nm, C_WHITE, C_INK, 2, ALIGN_LEFT)
        let b = sb()
        if fin == FIN_TEST {
            str_append(b, 64, "SPECIFICATION: YOURS.  BUILDER: NOT DISCLOSED.")
        } else {
            str_append(b, 64, "MODEL ")
            str_append(b, 64, mech_model(foe))
            if fin == FIN_ORIGINAL {
                str_append(b, 64, "  //  THE ORIGINAL")
            } else {
                str_append(b, 64, "  //  ITS ANSWER TO THE ")
                str_append(b, 64, mech_name(p_mech[0]))
            }
        }
        txt(FONT_MICRO, 316, 226, b, C_SKY, ALIGN_RIGHT)
    }
    if t > 190 && (tick >> 4) & 1 == 0 { txt(FONT_MICRO, 316, 6, "A", C_CYAN, ALIGN_RIGHT) }
}

// A row of a spotlight on the print layer: tiles x0..x1 of row ty in shade sh, the ends dithered
// into the dark.
private fn spot_span(x0: s32, x1: s32, ty: s32, sh: s32) {
    print_fill(x0, ty, 1, 1, 0, PT_DITHER + sh)
    if x1 > x0 { print_fill(x1, ty, 1, 1, 0, PT_DITHER + sh) }
    if x1 - x0 > 1 { print_fill(x0 + 1, ty, x1 - x0 - 1, 1, 0, PT_SOLID + sh) }
}

// A line of the announcement typed in, two letters a frame from t = 0, centred on the whole
// line so the letters do not shift as they come.
private fn reveal_line(s: *u8, y: s32, t: s32, col: u32) {
    if t <= 0 || s[0] == 0 { return }
    let n = min(t * 2, strlen(s))
    var buf: [64]u8
    var i = 0
    while i < n && i < 63 {
        buf[i] = s[i]
        i += 1
    }
    buf[i] = 0
    let w = txt_w(FONT_HEAD, s)
    txt_sh(FONT_HEAD, 160 - w / 2, y, &buf[0], col, C_INK, 1, ALIGN_LEFT)
}

// The ending: a magazine cover (mx-ladder; cover.akr picks its words and holds its poses). The
// winner frozen in one held frame of its win move on its maker's colour, the masthead over it,
// the headline and three cover lines picked for the run, the grade's stamp, the barcode.
const MAG_NAME = "PROCUREMENT"          // the masthead (the owner picks: README.md, "The arcade")
const MAG_NAME2 = "TODAY"
const COVER_TICKS: [3]u32 = [C_CYAN, C_TANGERINE, C_SILVER]   // the cover lines' colour ticks

fn draw_cover() {
    let t = st_t
    let me = run.me
    let mk = mech_maker_of(me)
    print_clear()
    print_ramp(0, mk.colour)
    print_grad(0, 0, 40, 30, 0, COVER_SKY[me][0], COVER_SKY[me][1])
    // the unit, a photograph: one held frame of its win move (cover.akr's COVER_POSE), its feet
    // below the bottom edge as a cover photograph has them
    menu_mech_f(me, Mv.win, fixed(COVER_POSE[me]), 226, COVER_FEET[me], COVER_DIST[me], 1, COVER_YAW[me])
    // the masthead
    txt_sh(FONT_MAST, 6, 1, MAG_NAME, C_WHITE, C_INK, 2, ALIGN_LEFT)
    let tx = 10 + txt_w(FONT_MAST, MAG_NAME)
    quad_fill(tx + 6, 14, tx + 58, 14, tx + 2, 30, tx + 54, 30, C_RED, BLEND_NONE)
    txt(FONT_HEAD, tx + 29, 14, MAG_NAME2, C_WHITE, ALIGN_CENTRE)
    rect_blend(0, 44, 320, 11, C_INK, BLEND_HALF)
    txt(FONT_MICRO, 6, 45, "THE DEFENCE TRADE WEEKLY", C_WHITE, ALIGN_LEFT)
    txt(FONT_MICRO, 314, 45, "ISSUE 41  //  OCTOBER 2000", C_WHITE, ALIGN_RIGHT)
    // the headline (cover.akr's pick), on a panel as wide as its words
    let hd = &COVER_HEADS[clamp(cover_head, 0, len(COVER_HEADS) - 1)]
    let l0 = cover_l0(sb())
    let l1 = cover_fill(sb2(), hd.l1)
    let pw = max(max(txt_w(FONT_TITLE, hd.h0), txt_w(FONT_TITLE, hd.h1)), txt_w(FONT_LABEL, l1)) + 20
    let hy = 152
    rect_blend(0, hy - 2, pw, 82, C_INK, BLEND_HALF)
    rect_blend(0, hy - 2, 4, 82, C_YELLOW, BLEND_NONE)
    txt_sh(FONT_TITLE, 10, hy, hd.h0, C_YELLOW, C_INK, 2, ALIGN_LEFT)
    txt_sh(FONT_TITLE, 10, hy + 24, hd.h1, C_YELLOW, C_INK, 2, ALIGN_LEFT)
    txt_sh(FONT_HEAD, 10, hy + 52, l0, C_WHITE, C_INK, 1, ALIGN_LEFT)
    txt_sh(FONT_LABEL, 10, hy + 67, l1, C_WHITE, C_INK, 1, ALIGN_LEFT)
    // the cover lines
    var ty = 62
    for i in 0..3 {
        let c = cover_tease[i]
        if c == null { continue }
        ty = teaser(ty, c.a, cover_fill(sb2(), c.b), COVER_TICKS[i])
    }
    // the sticker: the grade it was cleared on, stamped
    let d = &DIFFS[run.diff]
    let gx = 266
    let gy = 60
    paper(gx - 48, gy, 96, 46)
    txt(FONT_MICRO, gx, gy + 2, "UAPC GRADE", C_STEEL, ALIGN_CENTRE)
    let gb = sb2()
    str_append(gb, 64, "CLEARED: ")
    str_append(gb, 64, d.name)
    txt(FONT_MICRO, gx, gy + 36, gb, C_INK, ALIGN_CENTRE)
    if t > 20 {
        let k = max(0, 30 - t)
        let r = &UI_STAMP_APPROVED[0]
        let sw = r[2] + k * 5
        let shh = r[3] + k * 2
        menu_sprite(r, gx - sw / 2, gy + 24 - shh / 2, sw, shh, col_tint(col_mix(d.ink, C_INK, 0.3)), BLEND_NONE)
    }
    // the barcode
    rect_blend(262, 206, 52, 28, C_WHITE, BLEND_NONE)
    barcode(265, 209, 12, 16, C_INK)
    txt(FONT_MICRO, 288, 225, "2000-10", C_INK, ALIGN_CENTRE)
    if t > COVER_WAIT && !save_writing && (tick >> 4) & 1 == 0 { txt_sh(FONT_MICRO, 314, 192, "PRESS A", C_WHITE, C_INK, 1, ALIGN_RIGHT) }
    draw_save_status(160, 58)
}

// A cover line on the left: a colour tick, a line and a smaller one under it; returns the next y.
private fn teaser(y: s32, a: *u8, b: *u8, col: u32) -> s32 {
    rect_blend(6, y + 1, 3, 19, col, BLEND_NONE)
    txt_sh(FONT_LABEL, 12, y - 1, a, C_WHITE, C_INK, 1, ALIGN_LEFT)
    txt_sh(FONT_MICRO, 12, y + 10, b, col, C_INK, 1, ALIGN_LEFT)
    return y + 27
}
