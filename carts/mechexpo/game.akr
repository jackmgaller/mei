// Mech Expo 2000: the game's flow (D's). mechexpo.akr is the entry point; tests import this
// file with their own input (the weak hooks below).
//
//   title -> mode select (Arcade, Versus, Training) -> character select -> VS -> the fight
//   (C's fight.akr: round intro, COMMENCE, the KO, rounds, time up) -> results -> back; START
//   pauses.
//
// Arcade (mx-ladder, ladder.akr): the difficulty select, the character select, then LADDER_N
// fights against the CPU: the company fights, then the final. Before each the schedule page (the
// day's programme); before the final its reveal; after the final's win the magazine cover, then
// the unlock screen if the clear unlocked a mech (saved to the memory card, save.akr), then the
// title. A loss offers a continue (the same fight again) as often as wanted, or the title.
// Versus: 1P against 2P (pad 2 joins on the character select with A or START), or the CPU.
// Training: 1P against a dummy (C's fight_training options) with the move list and the boxes.
//
// The parts other agents deliver (README.md, "Folders and owners"):
import "fight.akr"           // C: the fight (moves.akr imports A's anim.akr)
import "anim.akr"            // A: the mechs' animation and drawing (imports B's assets.akr)
import "music.akr"           // E
import "sfx.akr"             // E
// D's:
import "planes.akr"
import "depth.akr"
import "stage_art.akr"
import "ui_art.akr"
import "ui.akr"
import "save.akr"
import "roster.akr"         // mx-menus: the makers and the select's ten slots
import "camera.akr"
import "stage.akr"
import "hud.akr"
import "fx.akr"
import "menus.akr"
import "beam_hud.akr"       // mx-beam: the chemical meter
import "beam_fx.akr"        // mx-beam: Beam's effects
import "tank_fx.akr"        // mx-tank: Tank's reactor glow, armour sparks and HUD meter
import "twins_fx.akr"       // mx-twins-fight: the Twins' partner, the swap's flash, the fusion meter
import "stage_select.akr"   // mx-stages: the stage select (stages.akr: the stages)
import "shadow_fx.akr"      // mx-shadow-fight: Shadow's bolt, mines, curse, afterimages, the siphon
import "seraph_fx.akr"      // mx-seraph-fx: Seraph's bolt, mark, ward, glide, column, its HUD mark and sounds
import "gamma_fx.akr"       // mx-gamma-fx: Gamma's lamp, ray, heat, vent, rod, flare, daze, shield, Ground Zero, its HUD heat and sounds
import "ladder.akr"         // mx-ladder: the arcade's run, its difficulties and the test unit
import "cover.akr"          // mx-ladder: the magazine cover's pose and words

// Input, replaced by the tests.
weak fn input_pad(n: s32) -> u32 {
    if n == 0 { return PAD1 }
    return PAD2
}
weak fn input_stick(n: s32) -> vec2 {
    if n == 0 { return stick() }
    return stick2()
}
weak fn test_init() {}
weak fn test_hook() {}

enum St { Title, Mode, Select, Vs, Fight, Results, Unlock, Stage, Diff, Sched, Reveal, Cover }
enum Game { Arcade, Versus, Training }

const VS_FRAMES = 150
const RESULTS_WAIT = 150           // frames into the match's end before the results
const CPU_LEVEL_VS = 2
const SCHED_WAIT = 30              // frames before the schedule page takes A
const REVEAL_FRAMES = 330          // the final's reveal, unless A skips it (after REVEAL_WAIT)
const REVEAL_WAIT = 60
const COVER_WAIT = 120             // frames before the cover takes A

var st: St
var st_t: s32
var tick: s32
var game: Game
var pad_now: [2]u32
var pad_prev: [2]u32
var stk: [2]vec2
var rep: [2]KeyRepeat

// the character select
var sel_cur: [2]s32                // the roster slot under each cursor (roster.akr: 0-4 top, 5-9 below)
var sel_done: [2]bool
var sel_human2: bool               // pad 2 joined
var sel_mech: [2]Mech
var sel_moved: [2]s32              // the tick each cursor last moved (the menus' slides)
var sel_done_t: [2]s32             // the tick each pick was made

// the match
var p_mech: [2]Mech
var p_cpu: bool                    // side 1 is the CPU (or the dummy)
var ladder: s32                    // arcade: the fight on the ladder (0 .. LADDER_N - 1)
var diff_sel: s32                  // the difficulty select's cursor (DIFF_*)
var cont_n: s32                    // arcade continues used
var won: bool                      // the results: side 0 won the match
var cleared: bool                  // the arcade ladder is cleared
var unlocked_now: bool
var unlock_slot: s32               // the roster slot unlocked now (the unlock screen)

// the pause
var paused: bool
var pause_sel: s32
var pause_page: s32                // 0 the menu, 1 the move list
var train: TrainOpts
var show_boxes: bool
var mode_sel: s32
var res_sel: s32
// CPU cycles of the last frame's parts (for measuring against the budget)
var prof_fight: s32                // fight_tick
var prof_mechs: s32                // both anim_draw calls
var prof_fx: s32                   // the trails and the effects' sprites
var prof_hud: s32                  // the HUD and the overlays

fn held(n: s32, b: u32) -> bool { return pad_now[n] & b != 0 }
fn pressed(n: s32, b: u32) -> bool { return pad_now[n] & ~pad_prev[n] & b != 0 }
fn any_pressed(b: u32) -> bool { return pressed(0, b) || pressed(1, b) }
fn ok_pressed(n: s32) -> bool { return pressed(n, A) || pressed(n, START) }

// The menu directions with key repeat (the d-pad or the stick).
fn dirs(n: s32) -> u32 {
    var h = pad_now[n] & (UP | DOWN | LEFT | RIGHT)
    if stk[n].x < -0.5 { h |= LEFT }
    if stk[n].x > 0.5 { h |= RIGHT }
    if stk[n].y < -0.5 { h |= UP }
    if stk[n].y > 0.5 { h |= DOWN }
    return key_repeat(&rep[n], h)
}

fn init() {
    planes_on()
    render_depth(true)
    render_perspective(true)
    camera_clip(0.5, 300.0)
    assets_load()
    ui_boot()
    stage_boot()
    save_boot()
    train = TrainOpts { dummy: Dummy.Stand, refill_health: true, refill_meter: true }
    enter_title()
    test_init()
}

fn enter(s: St) {
    st = s
    st_t = 0
}

fn enter_title() {
    enter(St.Title)
    paused = false
    p_grey[0] = false
    p_grey[1] = false
    music_menu()
    // the attract view: the hangar with the two mechs in it
    p_mech[0] = Mech.Hero
    p_mech[1] = Mech.Hero
    if echo_unlocked() { p_mech[1] = Mech.Doubleblade }
    fight_stage(ST_HANGAR)
    fight_init(p_mech[0], p_mech[1], FightMode.Versus, 0)
    menus_hangar()
    cam_reset(-9.0, 9.0)
}

fn enter_mode() {
    enter(St.Mode)
    menus_page()
}

fn enter_select() {
    enter(St.Select)
    menus_page()
    for s in 0..2 { sel_done[s] = false }
    sel_cur[0] = 0
    sel_cur[1] = 0
    if slot_ok(ROSTER_COLS) { sel_cur[1] = ROSTER_COLS }      // the Hero's echo, when unlocked
    sel_human2 = false
}

fn enter_vs() {
    enter(St.Vs)
    menus_page()
    p_grey[0] = false
    p_grey[1] = false
    if game == Game.Arcade {
        p_mech[1] = run.foe[ladder]
        p_grey[1] = run.grey[ladder]
    }
}

// ---- the arcade's run (mx-ladder)

fn enter_diff() {
    enter(St.Diff)
    menus_page()
    diff_sel = clamp((save.diff & 255) as s32, 0, DIFF_N - 1)
}

// 1P's pick made: a new run, its company fights drawn from the tick it starts on (scenarios
// replay it exactly).
fn arcade_start() {
    ladder_make(p_mech[0], diff_sel, (tick as u32) * 7919 + (p_mech[0] as u32))
    ladder = 0
    cont_n = 0
    enter_sched()
}

fn enter_sched() {
    enter(St.Sched)
    menus_page()
}

fn enter_reveal() {
    enter(St.Reveal)
    menus_page()
    p_mech[1] = run.foe[ladder]
    p_grey[1] = run.grey[ladder]
}

fn enter_cover() {
    enter(St.Cover)
    menus_page()
    music_fanfare()                     // "Contract Awarded" (music.akr), the menu loop after it
}

fn update_diff() {
    let d = dirs(0)
    if d & UP != 0 && diff_sel > 0 {
        diff_sel -= 1
        sfx_menu_move()
    }
    if d & DOWN != 0 && diff_sel < DIFF_N - 1 {
        diff_sel += 1
        sfx_menu_move()
    }
    if st_t > 10 && ok_pressed(0) {
        sfx_menu_ok()
        save.diff = (save.diff & ~(255 as u32)) | diff_sel as u32   // the cursor's start next time (saved with the next clear)
        enter_select()
    } else if pressed(0, B) {
        sfx_menu_back()
        enter_mode()
    }
}

fn update_sched() {
    if st_t > SCHED_WAIT && any_pressed(A | START) {
        sfx_menu_ok()
        if ladder_final(ladder) { enter_reveal() } else { enter_vs() }
    }
}

fn update_reveal() {
    if st_t >= REVEAL_FRAMES || (st_t > REVEAL_WAIT && any_pressed(A | START)) {
        if st_t < REVEAL_FRAMES { sfx_menu_ok() }
        enter_vs()
    }
}

fn update_cover() {
    if st_t > COVER_WAIT && any_pressed(A | START) && !save_writing {
        sfx_menu_ok()
        music_menu()                        // the fanfare cut short, if it still plays
        if unlocked_now {
            enter(St.Unlock)
            sfx_unlock()
        } else {
            enter_title()
        }
    }
}

fn enter_fight() {
    enter(St.Fight)
    paused = false
    pause_page = 0
    var fm = FightMode.Versus
    var lvl = CPU_LEVEL_VS
    match game {
        Arcade => {
            fm = FightMode.Arcade
            lvl = ladder_level(ladder)
        }
        Versus => { if p_cpu { fm = FightMode.VsCpu } }
        Training => {
            fm = FightMode.Training
            lvl = 1
        }
    }
    fight_stage(stage_pick())
    fight_init(p_mech[0], p_mech[1], fm, lvl)
    if game == Game.Training { fight_training(&train) }
    menus_hangar()
    hud_show(true)
    let f = fight_get()
    hud_reset(f)
    fx_reset()
    cam_reset(f.f[0].x, f.f[1].x)
    music_fight()
    snd_ko_t = -1
    for s in 0..2 { snd_hidden[s] = false }
}

fn leave_fight() {
    hud_show(false)
    fx_reset()
    music_duck(false)
    sfx_stop_fight()
}

fn enter_results() {
    let f = fight_get()
    leave_fight()
    enter(St.Results)
    menus_page()
    won = f.winner == 0
    res_sel = 0
    cleared = false
    unlocked_now = false
    if game == Game.Arcade && won && ladder_final(ladder) {
        cleared = true
        save.clears += 1
        unlock_slot = ladder_cleared()              // marks the clear and its difficulty; what it unlocks
        unlocked_now = unlock_slot >= 0
        cover_pick()                                // the cover's words (kept in the save: the next differs)
        save_write()
    }
    music_menu()
}

fn update() {
    for n in 0..2 {
        pad_prev[n] = pad_now[n]
        pad_now[n] = input_pad(n)
        stk[n] = input_stick(n)
    }
    test_hook()
    save_tick()
    tick += 1
    st_t += 1
    match st {
        Title => update_title()
        Mode => update_mode()
        Select => update_select()
        Vs => {
            if st_t >= VS_FRAMES || (st_t > 20 && any_pressed(A | START)) { enter_fight() }
        }
        Fight => update_fight()
        Stage => update_stage_select()
        Diff => update_diff()
        Sched => update_sched()
        Reveal => update_reveal()
        Cover => update_cover()
        Results => update_results()
        Unlock => {
            if st_t > 90 && any_pressed(A | START) && !save_writing {
                enter_results_after_unlock()
            }
        }
    }
    menus_sfx()
    music_tick()
    sfx_tick()
}

fn update_title() {
    let f = fight_get()
    // the attract: the camera drifts between the two mechs
    let sway = sin(frame_angle(tick, 0.004)) * 6.0
    cam_follow(f.f[0].x + sway - 5.0, 0.0, f.f[1].x + sway + 5.0, 0.0, 0.0)
    if st_t > 20 && any_pressed(START | A) {
        sfx_pass()
        mode_sel = 0
        enter_mode()
    }
}

fn update_mode() {
    let d = dirs(0)
    if d & UP != 0 && mode_sel > 0 {
        mode_sel -= 1
        sfx_menu_move()
    }
    if d & DOWN != 0 && mode_sel < 2 {
        mode_sel += 1
        sfx_menu_move()
    }
    if ok_pressed(0) {
        sfx_menu_ok()
        game = mode_sel as Game
        ladder = 0
        cont_n = 0
        if game == Game.Arcade { enter_diff() } else { enter_select() }
    } else if pressed(0, B) {
        sfx_menu_back()
        enter_title()
    }
}

fn update_select() {
    // pad 2 joins in Versus
    if game == Game.Versus && !sel_human2 && !sel_done[1] && (pressed(1, A) || pressed(1, START)) {
        sel_human2 = true
        sfx_menu_ok()
        return
    }
    // who moves the second cursor: pad 2 when it joined, else 1P once its own pick is made
    for n in 0..2 {
        var side = n
        if n == 0 && sel_done[0] && !sel_human2 { side = 1 }
        if n == 1 && !sel_human2 { continue }
        if sel_done[side] {
            if pressed(n, B) {
                sel_done[side] = false
                sfx_menu_back()
            }
            continue
        }
        // the 5 x 2 grid: left and right along a row, up and down between a base and its echo
        let d = dirs(n)
        let c = sel_cur[side]
        let col = c % ROSTER_COLS
        var to = c
        if d & LEFT != 0 && col > 0 { to = c - 1 }
        if d & RIGHT != 0 && col < ROSTER_COLS - 1 { to = c + 1 }
        if d & UP != 0 && c >= ROSTER_COLS { to = c - ROSTER_COLS }
        if d & DOWN != 0 && c < ROSTER_COLS { to = c + ROSTER_COLS }
        if to != c {
            sel_cur[side] = to
            sel_moved[side] = tick
            sfx_shutter()                       // the catalogue's new photograph
        }
        if ok_pressed(n) {
            if slot_ok(sel_cur[side]) {
                sel_done[side] = true
                sel_done_t[side] = tick
                sel_mech[side] = slot_mech(sel_cur[side])
                sfx_stamp()                     // READY
            } else {
                sfx_menu_back()
            }
        } else if pressed(n, B) {
            sfx_menu_back()
            if side == 1 && n == 0 {
                sel_done[0] = false            // 1P steps back to its own pick
            } else if side == 0 {
                if game == Game.Arcade { enter_diff() } else { enter_mode() }
                return
            }
        }
    }
    // the arcade needs only 1P's pick
    let need2 = game != Game.Arcade
    if sel_done[0] && (!need2 || sel_done[1]) {
        if st_t > 0 && sel_wait() > 30 {
            p_mech[0] = sel_mech[0]
            p_mech[1] = sel_mech[1]
            p_grey[0] = false
            p_grey[1] = false
            p_cpu = game != Game.Versus || !sel_human2
            ladder = 0
            if game == Game.Arcade { arcade_start() } else { enter_stage_select() }
        }
    } else {
        sel_ready_t = 0
    }
}

var sel_ready_t: s32
fn sel_wait() -> s32 {
    sel_ready_t += 1
    return sel_ready_t
}

fn update_fight() {
    let f = fight_get()
    if paused {
        update_pause()
        return
    }
    if pressed(0, START) || (!p_cpu && pressed(1, START)) {
        paused = true
        pause_sel = 0
        pause_page = 0
        music_duck(true)
        sfx_menu_ok()
        return
    }
    if pressed(0, SELECT) { cam_angled = !cam_angled }
    let ph0 = f.phase
    let round0 = f.round
    var p2 = pad_now[1]
    var s2 = stk[1]
    if p_cpu {
        p2 = 0
        s2 = vec2(0.0, 0.0)
    }
    let c0 = cycle_count()
    fight_tick(pad_now[0], p2, stk[0], s2)
    prof_fight = cycle_count() - c0
    if f.round != round0 || (f.phase == Phase.Intro && ph0 != Phase.Intro) {
        sfx_round()
        music_fight()
    }
    let ev = fight_events()
    for i in 0..ev.n {
        let e = &ev.e[i]
        sound_event(e, f)
        fx_event(e, f)
    }
    sound_poll(f)
    fx_update(f)
    hud_update(f)
    twins_cam_follow(f)                 // cam_follow() over both fighters (and a split Twins' partner)
    if f.phase == Phase.MatchOver && f.phase_t >= RESULTS_WAIT && game != Game.Training {
        enter_results()
    }
}

// The fight's events to E's sound effects.
fn sound_event(e: *Event, f: *Fight) {
    let side = clamp(e.side, 0, 1)
    match e.kind {
        Hit => {
            sfx_pan(e.x)
            sfx_hit(e.power)
        }
        Block => {
            sfx_pan(e.x)
            sfx_block()
        }
        Chip => {
            sfx_pan(e.x)
            sfx_chip()
        }
        Swing => {
            let b = &f.f[ev_body(e, f)]
            sfx_pan(e.x)
            sfx_attack(b.body, b.mv)
        }
        Parry => {
            sfx_block()
            var rb: vec4
            if gamma_ray(1 - side, &rb) {
                sfx_pan(e.x)
                sfx_gamma(GSX_CUT)              // a Parry caught Gamma's ray: cut
            }
        }
        Clash => {
            sfx_pan(e.x)
            sfx_clash(f.shot[0].lvl > 0 || f.shot[1].lvl > 0)     // an orb fizzles (Beam's, or Gamma's placeholder's; the rod never clashes)
        }
        Grab => {
            sfx_pan(e.x)
            if e.power == 1 && tank_holding(clamp(e.side, 0, 3)) { sfx_tank_lift() } else { sfx_grab() }
        }
        Throw => {
            let t = &f.f[clamp(e.side, 0, 3)]
            sfx_pan(e.x)
            sfx_throw_by(t.mech, t.mv)
        }
        Break => sfx_break()
        Land => {
            sfx_pan(e.x)
            if e.power >= 2 { sfx_knockdown() } else { sfx_land() }
        }
        Step => {
            sfx_pan(e.x)
            sfx_step_of(f.f[ev_body(e, f)].body)
        }
        MeterFull => sfx_meter_full()
        Super => {
            sfx_pan(f.f[side].x)
            sfx_super(f.f[side].mech)
        }
        Ko => {
            sfx_ko()
            snd_ko_t = 0                    // the smoulder, a moment later (sound_poll)
            snd_ko_x = e.x
        }
        TimeUp => sfx_round()
        Shot => {
            sfx_pan(e.x)
            sfx_shot(f.f[side].mech, e.power)
        }
        Armour => {
            sfx_pan(e.x)
            if f.f[1 - side].mech == Mech.Gamma && f.f[1 - side].mv == Mv.sp_d {
                sfx_gamma(GSX_LEAD)             // Lead Shielding's dull clang
            } else {
                sfx_armour(e.power)
            }
        }
        Mark => {
            sfx_pan(e.x)
            sfx_mark(e.power > 0)
        }
        Reflect => {
            sfx_pan(e.x)
            sfx_reflect()
        }
        Column => {
            sfx_pan(e.x)
            sfx_column_lock()
        }
        Vent => {
            sfx_pan(e.x)
            sfx_gamma(GSX_VENT)
        }
        Burn => {
            sfx_pan(e.x)
            sfx_gamma(GSX_BURN)
        }
        Curse, Mine, Snare, MineGone => {
            sfx_pan(e.x)
            match e.kind {
                Curse => sfx_shadow(0)
                Mine => sfx_shadow(1)
                Snare => sfx_shadow(2)
                else => sfx_shadow(if_else(e.power > 0, 3, 4))
            }
        }
        else => {}
    }
}

// The body an event at the fighter's x came from: the side's leader, or a split Twins' twin B.
fn ev_body(e: *Event, f: *Fight) -> s32 {
    let s = clamp(e.side, 0, 1)
    if twins_on(s) && f.f[s + 2].x == e.x && f.f[s].x != e.x { return s + 2 }
    return s
}

// The sounds that follow the fight's state rather than its events, once a fight frame: the
// mechs' own (Beam's charge hum and reaction, Tank's treads, the Twins' coupling), the Void
// Step and the KO's smoulder. Loops are held here every frame they should sound (sfx.akr).
var snd_hidden: [2]bool
var snd_ko_t: s32 = -1              // frames since the KO, or -1
var snd_ko_x: fixed
const SND_SMOULDER_AT = 45          // the beaten mech starts smouldering this long after the KO

fn sound_poll(f: *Fight) {
    beam_sfx(f)
    tank_sfx(f)
    twins_sfx(f)
    seraph_sfx(f)
    gamma_sfx(f)
    for s in 0..2 {
        let fi = &f.f[s]
        let hidden = (anim_marks(fi.body, fi.mv, fi.frame as s32) & MARK_HIDE) != 0
        if hidden != snd_hidden[s] {
            sfx_pan(fi.x)
            sfx_void(!hidden)
        }
        snd_hidden[s] = hidden
    }
    if f.phase == Phase.Intro { snd_ko_t = -1 }
    if snd_ko_t >= 0 {
        snd_ko_t += 1
        if snd_ko_t == SND_SMOULDER_AT {
            sfx_pan(snd_ko_x)
            sfx_smoulder()
        }
    }
}

// ---- pause

// The pause menu's entries for this game.
const PZ_RESUME = 0
const PZ_CAMERA = 1
const PZ_DUMMY = 2
const PZ_REFILL = 3
const PZ_BOXES = 4
const PZ_MOVES = 5
const PZ_SELECT = 6
const PZ_QUIT = 7

fn pause_items(out: *s32) -> s32 {
    var n = 0
    out[n] = PZ_RESUME
    n += 1
    out[n] = PZ_CAMERA
    n += 1
    if game == Game.Training {
        out[n] = PZ_DUMMY
        n += 1
        out[n] = PZ_REFILL
        n += 1
        out[n] = PZ_BOXES
        n += 1
    }
    out[n] = PZ_MOVES
    n += 1
    out[n] = PZ_SELECT
    n += 1
    out[n] = PZ_QUIT
    n += 1
    return n
}

fn update_pause() {
    if pause_page == 1 {
        if any_pressed(B | START | A) {
            pause_page = 0
            sfx_menu_back()
        }
        return
    }
    var items: [8]s32
    let n = pause_items(&items[0])
    let d = dirs(0)
    if d & UP != 0 && pause_sel > 0 {
        pause_sel -= 1
        sfx_menu_move()
    }
    if d & DOWN != 0 && pause_sel < n - 1 {
        pause_sel += 1
        sfx_menu_move()
    }
    let it = items[pause_sel]
    let lr = d & (LEFT | RIGHT) != 0
    if pressed(0, START) || pressed(0, B) {
        unpause()
        return
    }
    if it == PZ_CAMERA && (lr || pressed(0, A)) {
        cam_angled = !cam_angled
        sfx_menu_move()
    } else if it == PZ_DUMMY && (lr || pressed(0, A)) {
        var k = train.dummy as s32
        if d & LEFT != 0 { k = (k + 4) % 5 } else { k = (k + 1) % 5 }
        train.dummy = k as Dummy
        fight_training(&train)
        sfx_menu_move()
    } else if it == PZ_REFILL && (lr || pressed(0, A)) {
        train.refill_health = !train.refill_health
        train.refill_meter = train.refill_health
        fight_training(&train)
        sfx_menu_move()
    } else if it == PZ_BOXES && (lr || pressed(0, A)) {
        show_boxes = !show_boxes
        sfx_menu_move()
    } else if pressed(0, A) {
        if it == PZ_RESUME {
            unpause()
        } else if it == PZ_MOVES {
            pause_page = 1
            sfx_menu_ok()
        } else if it == PZ_SELECT {
            sfx_menu_back()
            leave_fight()
            enter_select()
        } else if it == PZ_QUIT {
            sfx_menu_back()
            leave_fight()
            enter_title()
        }
    }
}

fn unpause() {
    paused = false
    music_duck(false)
    sfx_menu_back()
}

// ---- results

fn update_results() {
    if st_t < 40 { return }
    match game {
        Arcade => {
            if won && !cleared {
                if any_pressed(A | START) {
                    sfx_menu_ok()
                    ladder += 1
                    enter_sched()
                }
            } else if won {
                if any_pressed(A | START) && !save_writing {
                    sfx_menu_ok()
                    enter_cover()
                }
            } else {
                // another demonstration? As often as wanted: the same fight again
                if pressed(0, A) || pressed(0, START) {
                    sfx_menu_ok()
                    cont_n += 1
                    enter_vs()
                } else if pressed(0, B) {
                    sfx_menu_back()
                    enter_title()
                }
            }
        }
        else => {
            let d = dirs(0)
            if d & UP != 0 && res_sel > 0 {
                res_sel -= 1
                sfx_menu_move()
            }
            if d & DOWN != 0 && res_sel < 2 {
                res_sel += 1
                sfx_menu_move()
            }
            if pressed(0, A) || pressed(0, START) {
                sfx_menu_ok()
                if res_sel == 0 { enter_vs() }
                else if res_sel == 1 { enter_select() }
                else { enter_title() }
            }
        }
    }
}

fn enter_results_after_unlock() {
    sfx_menu_ok()
    enter_title()
}

// ---- drawing

fn draw() {
    gpu_fog_off()                       // only the final's reveal fogs (its silhouette)
    match st {
        Title => {
            draw_hangar(false)
            draw_title()
        }
        Mode => draw_mode()
        Select => draw_select()
        Vs => draw_vs()
        Fight => {
            draw_hangar(true)
            let c0 = cycle_count()
            draw_fight_overlay()
            prof_hud = cycle_count() - c0
            if paused { draw_pause() }
        }
        Results => draw_results()
        Unlock => draw_unlock()
        Stage => draw_stage_select()
        Diff => draw_diff()
        Sched => draw_sched()
        Reveal => draw_reveal()
        Cover => draw_cover()
    }
}

// The hangar, the mechs and the effects, from the camera.
fn draw_hangar(fighting: bool) {
    let f = fight_get()
    cam_apply(tick)
    stage_frame()
    stage_props()
    let c0 = cycle_count()
    for s in 0..2 {
        let fi = &f.f[s]
        anim_grey = p_grey[s]               // the UAPC's test unit (mx-ladder)
        if fighting {
            twins_draw_body(fi.body, fi.mv, fi.frame, anim_place(vec2(fi.x, fi.y), fi.facing))
        } else {
            let n = max(anim_len(fi.mech, Mv.idle), 1)
            anim_draw(fi.mech, Mv.idle, fixed((tick + s * 17) % n), anim_place(vec2(fi.x, fi.y), fi.facing))
        }
    }
    anim_grey = false
    if fighting { twins_fx_partners(f) }   // a split Twins' twin B
    prof_mechs = cycle_count() - c0
    if fighting {
        let c1 = cycle_count()
        fx_draw_trails(f)
        fx_draw_sprites(f)
        tank_fx_draw(f)
        twins_fx_draw(f)
        shadow_fx_draw(f)
        seraph_fx_draw(f)
        gamma_fx_draw(f)
        fx_offset()
        shadow_fx_offset(f)             // Total Eclipse keeps the stage dark
        seraph_fx_offset(f)             // Judgement brightens it to white-gold
        gamma_fx_offset(f)              // Ground Zero tints it green-white
        prof_fx = cycle_count() - c1
        if show_boxes && game == Game.Training {
            for s in 0..2 {
                let fi = &f.f[s]
                anim_draw_boxes(fi.body, fi.mv, fi.frame as s32, vec2(fi.x, fi.y), fi.facing)
            }
            twins_fx_boxes(f)
        }
    }
    stage_props_end()
}
