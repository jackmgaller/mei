// Mech Expo 2000's stages as data (mx-stages). A stage is a row of STAGES: its edges, its floor,
// its art for the plane chip, its props, its music and its timed events. The pitch: "Stages are
// expo venues. Variety comes from edges and events, not big layouts" - a new stage is a new row
// (and its art), not engine work. README.md, "Stages", describes the format.
//
// Who reads what: the fight (fight.akr, fighter.akr, twins.akr) reads the half-width and the
// edges, through stage_now() (the fight's own stage, fight.stage, set before fight_init() by
// fight_stage(), so a fight's stage is part of its state and stays deterministic); the camera
// (camera.akr) its edges; the stage's drawing (stage.akr) its art and props; the game (game.akr)
// its name, its music and the ladder's stages.

import "stage_art.akr"          // the hangar's art (tools/gen_mechexpo_stage.py)

// What ends the stage on one side.
enum Edge {
    Wall,                       // a wall: nothing passes it (corner pressure)
    Open,                       // an open edge: a mech stops at its lip as at a wall, but a mech
                                // knocked down, launched or thrown past it falls: rung out
}

// The stages, by row.
const ST_HANGAR = 0
const STAGES_N = 1

// The plane chip's art for a stage (the generators write the constants it is filled from).
struct StageArt {
    hall_tiles: *u8             // BG1 (ATLAS_1): the parallax behind the fight, 64 x 32 entries
    hall_bytes: s32
    hall_map: *u16
    hall_pal: *u16
    hall_pals: s32              // palettes from PAL_HALL (244-249)
    hall_w: s32                 // the art's width in pixels
    hall_h: s32                 // its rows: row hall_h - 1 sits on the floor line at z = hall_z
    hall_z: fixed
    bands: s32                  // parallax bands: first art row and depth behind hall_z of each
    band_y: *s32
    band_z: *fixed
    floor_tiles: *u8            // BG2 (ATLAS_0): the floor, a Mode 7 plane, 128 x 128 entries
    floor_bytes: s32
    floor_map: *u16
    floor_pal: *u16
    floor_pals: s32             // palettes from PAL_FLOOR (240-243)
    floor_s: fixed              // texels a metre
    floor_c: fixed              // the texel of world 0
    floor_out: u32              // outside the map: PLANE_WRAP, or PLANE_TRANSPARENT_OUT
    floor_far: fixed            // the floor's rows out to this view depth
    sky: *u32                   // the backdrop: 4 colours (0xBBGGRR), top to the hall's line
    sky_dy: *s32                // at these rows above the hall's line
    prio: u32                   // PLN_PRIO in a fight
}

// A polygon prop (B's models, assets.akr): drawn at (x, 0, z) turned by yaw, when the camera's
// view (cam_x +- its reach) comes within `near` metres of x.
struct StageProp {
    mesh: *Mesh
    x: fixed
    z: fixed
    yaw: fixed
    near: fixed
}

// A timed event (none yet; the shape is for the pitch's later stages, nothing runs them):
// the city's falling building (StEv.Fall: at frame `at` of a round, a building falls across
// x0..x1 for `len` frames, hitting what is under it with `power`, and leaves rubble there) and
// the carrier's tilt (StEv.Tilt: from frame `at`, the deck tilts to `amount` radians over `len`
// frames, and mechs slide toward the low side). `every` repeats it (0: once a round).
enum StEv { Fall, Tilt }
struct StageEvent {
    kind: StEv
    at: s32                     // frames into the round
    every: s32
    len: s32
    x0: fixed
    x1: fixed
    amount: fixed
    power: s32
}

const ST_PROPS_MAX = 6
const ST_EVENTS_MAX = 4

struct Stage {
    name: *u8                   // the stage select's and the VS screen's name
    venue: *u8                  // a line under it
    blurb: *u8                  // the stage select's two short lines
    colour: u32                 // the stage select's photograph (0xBBGGRR)
    half: fixed                 // the edges are at x = -half and +half
    edge: [2]Edge               // [0] the -x side, [1] the +x side
    tilt: fixed                 // the floor's slope across x in radians (0: flat; every stage is
                                // flat for now, the carrier's deck will not be)
    art: StageArt
    nprops: s32
    props: [ST_PROPS_MAX]StageProp
    music: s32                  // the fight's track: 0 the fight track (music_fight())
    nevents: s32
    events: [ST_EVENTS_MAX]StageEvent
}

const HANGAR_SKY: [4]u32 = [0x0A0806, 0x221810, 0x3A2C20, 0x4A3A2C]   // the roof's dark
const HANGAR_SKY_DY: [4]s32 = [-420, -260, -200, -160]                // rows above the hall's line

const STAGES: [1]Stage = [
    // the demo hangar: walls at x = +-36, the expo's banner towers behind the fight
    Stage { name: "DEMO HANGAR", venue: "EXPO HALL 1 // TRIAL HALL 2", blurb: "WALLS ON BOTH SIDES\nFOR CORNER PRESSURE",
            colour: 0x8A6A50, half: 36.0, edge: [Edge.Wall, Edge.Wall],
            art: StageArt { hall_tiles: STAGE_HALL_TILES, hall_bytes: HALL_TILES_BYTES,
                            hall_map: STAGE_HALL_MAP, hall_pal: STAGE_HALL_PAL, hall_pals: HALL_PALS,
                            hall_w: HALL_W, hall_h: HALL_H, hall_z: HALL_Z, bands: HALL_BANDS,
                            band_y: HALL_BAND_Y, band_z: HALL_BAND_Z,
                            floor_tiles: STAGE_FLOOR_TILES, floor_bytes: FLOOR_TILES_BYTES,
                            floor_map: STAGE_FLOOR_MAP, floor_pal: STAGE_FLOOR_PAL,
                            floor_pals: FLOOR_PALS, floor_s: FLOOR_S, floor_c: FLOOR_C,
                            floor_out: 0, floor_far: 260.0,
                            sky: HANGAR_SKY, sky_dy: HANGAR_SKY_DY, prio: 0x42001133 },
            nprops: 4, props: [
                StageProp { mesh: ASSET_HANGAR_WALL_R, x: 36.0, near: 9.0 },
                StageProp { mesh: ASSET_HANGAR_WALL_L, x: -36.0, near: 9.0 },
                StageProp { mesh: ASSET_EXPO_BANNER, x: -21.0, z: 15.0, near: 8.0 },
                StageProp { mesh: ASSET_EXPO_BANNER, x: 23.0, z: 19.0, near: 8.0 },
                StageProp {}, StageProp {}],
            music: 0, nevents: 0, events: [StageEvent {}, StageEvent {}, StageEvent {}, StageEvent {}] },
]

// The arcade's stage for each fight on the ladder.
const LADDER_STAGES: [2]s32 = [ST_HANGAR, ST_HANGAR]

fn stage_row(id: s32) -> *Stage { return &STAGES[clamp(id, 0, STAGES_N - 1)] }

// Whether side k (0: -x, 1: +x) of a stage is open.
fn stage_open(s: *Stage, k: s32) -> bool { return s.edge[k] == Edge.Open }
