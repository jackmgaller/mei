// What the HUD and the menus share (D's): the colours, the fonts (ui_art.akr, made by
// tools/gen_mechexpo_ui.py from the OFL fonts in tools/fonts/), text and panel helpers, the
// sprites in slots 9 and 10, and the mechs' names and makers.

// 0xBBGGRR
const C_WHITE: u32 = 0xFFFFFF
const C_INK: u32 = 0x40200C        // navy ink, rgb(12, 32, 64)
const C_NAVY: u32 = 0x9A3C1E       // UAPC blue, rgb(30, 60, 154)
const C_BLUE: u32 = 0xD86A3A       // rgb(58, 106, 216)
const C_SKY: u32 = 0xFFC8A8        // rgb(168, 200, 255)
const C_CYAN: u32 = 0xF0D830       // rgb(48, 216, 240)
const C_SILVER: u32 = 0xE2D4C8     // rgb(200, 212, 226)
const C_STEEL: u32 = 0x9C7C6A      // rgb(106, 124, 156)
const C_YELLOW: u32 = 0x19C4F0     // rgb(240, 196, 25)
const C_RED: u32 = 0x281EC8        // Momentum red, rgb(200, 30, 40)
const C_VIOLET: u32 = 0xE85A9A     // Umbral violet, rgb(154, 90, 232)
const C_MAGENTA: u32 = 0xC040F0    // rgb(240, 64, 192)
const C_TANGERINE: u32 = 0x208CFF  // rgb(255, 140, 32)
const C_GLASS: u32 = 0x5A2810      // dark glass, rgb(16, 40, 90)

var ui_buf: [64]u8

fn ui_boot() {
    load_texture(SLOT_FONTS, UI_FONTS_TEX, UI_FONTS_BYTES)
    load_texture(SLOT_SPRITES, UI_SPRITES_TEX, UI_SPRITES_BYTES)
    load_texture(SLOT_FX, UI_FX_TEX, UI_FX_BYTES)
    load_palette(PAL_HUD * 16, &UI_PAL[0], 16 * 5)       // 250-254
    load_texture(SLOT_MENU, UI_MENU_TEX, UI_MENU_BYTES)  // mx-menus: slot 12
    load_palette(PAL_POWER * 16, &UI_PAL[6 * 16], 16)    // 196
}

fn sb() -> *u8 {
    ui_buf[0] = 0
    return &ui_buf[0]
}

// ---- text

// Text in a font (FONT_TITLE, FONT_HEAD, FONT_LABEL, FONT_NUM), aligned to x. Returns the x
// after it.
fn txt(f: *Font, x: s32, y: s32, s: *u8, col: u32, align: s32) -> s32 {
    font_use(f)
    let r = font_text_align(x, y, s, col, align)
    font_use(null)
    return r
}

// With a drop shadow d pixels down and right.
fn txt_sh(f: *Font, x: s32, y: s32, s: *u8, col: u32, sh: u32, d: s32, align: s32) -> s32 {
    font_use(f)
    font_text_align(x + d, y + d, s, sh, align)
    let r = font_text_align(x, y, s, col, align)
    font_use(null)
    return r
}

fn txt_w(f: *Font, s: *u8) -> s32 {
    font_use(f)
    let w = text_width(s)
    font_use(null)
    return w
}

// ---- sprites

fn ui_sprite(r: *s32, pal: s32, x: s32, y: s32, tint: u32, mode: s32) {
    sprite_ex(tex_page(SLOT_SPRITES, pal, true), r[0], r[1], r[2], r[3], x, y, r[2], r[3], tint, mode)
}

fn ui_sprite_sz(r: *s32, pal: s32, x: s32, y: s32, w: s32, h: s32, tint: u32, mode: s32) {
    sprite_ex(tex_page(SLOT_SPRITES, pal, true), r[0], r[1], r[2], r[3], x, y, w, h, tint, mode)
}

// An effect sprite (white, tinted) centred on (cx, cy), w x h; a negative w mirrors it.
fn fx_sprite(r: *s32, cx: s32, cy: s32, w: s32, h: s32, col: u32, mode: s32) {
    var tw = r[2]
    var u = r[0]
    var x = cx - w / 2
    var ww = w
    if w < 0 {
        ww = -w
        x = cx - ww / 2
        tw = -r[2]
    }
    sprite_ex(tex_page(SLOT_FX, PAL_FX, true), u, r[1], tw, r[3], x, cy - h / 2, ww, h, col_tint(col), mode)
}

// ---- panels: the brochure's translucent panels and catalogue rules

fn panel_glass(x: s32, y: s32, w: s32, h: s32) {
    rect_blend(x, y, w, h, C_GLASS, BLEND_HALF)
    rect_blend(x, y, w, 1, C_CYAN, BLEND_NONE)
    rect_blend(x, y + h - 1, w / 3, 1, C_CYAN, BLEND_HALF)
}

// A white catalogue card: a half-white panel with a navy rule and a corner tab.
fn panel_card(x: s32, y: s32, w: s32, h: s32) {
    rect_blend(x + 3, y + 3, w, h, 0x402010, BLEND_SUB)
    rect_blend(x, y, w, h, 0xFFFFFF, BLEND_HALF)
    rect_blend(x, y, w, 2, C_NAVY, BLEND_NONE)
    rect_blend(x, y + h - 1, w, 1, C_STEEL, BLEND_NONE)
    rect_blend(x + w - 18, y, 18, 6, C_CYAN, BLEND_NONE)
}

// The same card, opaque (the pause menu and the move list, over the fight).
fn panel_solid(x: s32, y: s32, w: s32, h: s32) {
    rect_blend(x + 3, y + 3, w, h, 0x402010, BLEND_SUB)
    rect_grad(x, y, w, h, 0xFAF4EE, 0xE6D8CA, BLEND_NONE)
    rect_blend(x, y, w, 2, C_NAVY, BLEND_NONE)
    rect_blend(x, y + h - 1, w, 1, C_STEEL, BLEND_NONE)
    rect_blend(x + w - 18, y, 18, 6, C_CYAN, BLEND_NONE)
}

// A slanted tag with a label in it.
fn tag(x: s32, y: s32, w: s32, s: *u8, bg: u32, fg: u32) {
    quad_fill(x + 4, y, x + w + 4, y, x, y + 11, x + w, y + 11, bg, BLEND_NONE)
    txt(FONT_LABEL, x + w / 2 + 2, y - 1, s, fg, ALIGN_CENTRE)
}

// A barcode, for the look.
fn barcode(x: s32, y: s32, n: s32, h: s32, col: u32) {
    for i in 0..n {
        let w = 1 + ((i * 7 + i / 3) % 3)
        rect_blend(x + i * 4, y, w, h, col, BLEND_NONE)
    }
}

// ---- the mechs: names, makers and colours from the roster (roster.akr)

fn mech_name(m: Mech) -> *u8 { return ROSTER[mech_slot(m)].name }
fn mech_short(m: Mech) -> *u8 { return ROSTER[mech_slot(m)].short }
fn mech_model(m: Mech) -> *u8 { return ROSTER[mech_slot(m)].model }
fn mech_maker(m: Mech) -> *u8 { return mech_maker_of(m).name }
fn mech_maker_short(m: Mech) -> *u8 { return mech_maker_of(m).short }
fn mech_src(m: Mech) -> s32 { return mech_maker_of(m).src }
fn mech_power(m: Mech) -> *u8 { return SRC_NAMES[mech_src(m)] }
fn mech_booth(m: Mech) -> *u8 { return mech_maker_of(m).booth_full }
fn mech_colour(m: Mech) -> u32 { return mech_maker_of(m).colour }
fn mech_kinetic(m: Mech) -> bool { return mech_src(m) == SRC_KINETIC }
fn mech_emblem(m: Mech) -> *s32 { return mech_maker_of(m).emblem }

// ---- the brochure's pieces (mx-menus)

// A power source's meter icon (16 x 16) at (x, y): SRC_KINETIC ... SRC_FUSION.
fn ui_power_icon(src: s32, x: s32, y: s32) {
    match src {
        0 => ui_sprite(&UI_ICON_KINETIC[0], PAL_EMBLEM, x, y, 0x808080, BLEND_NONE)
        1 => ui_sprite(&UI_ICON_CHEMICAL[0], PAL_POWER, x, y, 0x808080, BLEND_NONE)
        2 => ui_sprite(&UI_ICON_NUCLEAR[0], PAL_POWER, x, y, 0x808080, BLEND_NONE)
        3 => ui_sprite(&UI_ICON_ANTIMATTER[0], PAL_EMBLEM, x, y, 0x808080, BLEND_NONE)
        else => ui_sprite(&UI_ICON_FUSION[0], PAL_POWER, x, y, 0x808080, BLEND_NONE)
    }
}

// Maker k's emblem at (x, y): 32 x 32, or 24 x 24 when small; tint 0x808080 as it is.
fn ui_emblem(k: s32, x: s32, y: s32, small: bool, tint: u32) {
    let mk = &MAKERS[k]
    if small { ui_sprite(mk.emblem24, mk.pal, x, y, tint, BLEND_NONE) }
    else { ui_sprite(mk.emblem, mk.pal, x, y, tint, BLEND_NONE) }
}

// Slot 12's white art (stamps, the strap), tinted.
fn menu_sprite(r: *s32, x: s32, y: s32, w: s32, h: s32, tint: u32, mode: s32) {
    sprite_ex(tex_page(SLOT_MENU, PAL_FX, true), r[0], r[1], r[2], r[3], x, y, w, h, tint, mode)
}

// A rubber stamp (UI_STAMP_*) centred on (cx, cy) in ink col.
fn ui_stamp(r: *s32, cx: s32, cy: s32, col: u32) {
    menu_sprite(r, cx - r[2] / 2, cy - r[3] / 2, r[2], r[3], col_tint(col), BLEND_NONE)
}

// A woven lanyard strap from (x0, y0) down to (x1, y1), w pixels wide, in colour col.
fn ui_strap(x0: s32, y0: s32, x1: s32, y1: s32, w: s32, col: u32) {
    let len = max(abs(y1 - y0), 1)
    let page = tex_page(SLOT_MENU, PAL_FX, true)
    var xs: [4]s32
    var ys: [4]s32
    var a0 = 0
    while a0 < len {
        let a1 = min(a0 + UI_STRAP[3], len)
        let xa = x0 + (x1 - x0) * a0 / len
        let xb = x0 + (x1 - x0) * a1 / len
        xs[0] = xa - w / 2
        xs[1] = xa + w - w / 2
        xs[2] = xb - w / 2
        xs[3] = xb + w - w / 2
        ys[0] = y0 + (y1 - y0) * a0 / len
        ys[1] = ys[0]
        ys[2] = y0 + (y1 - y0) * a1 / len
        ys[3] = ys[2]
        sprite_corners(page, UI_STRAP[0], UI_STRAP[1], UI_STRAP[2], a1 - a0, &xs[0], &ys[0], col_tint(col), BLEND_NONE)
        a0 = a1
    }
}

// Brushed chrome, lit from above.
fn ui_chrome(x: s32, y: s32, w: s32, h: s32) {
    let h2 = h / 2
    rect_grad(x, y, w, h2, 0xF8F0EA, 0xB09888, BLEND_NONE)
    rect_grad(x, y + h2, w, h - h2, 0x6A5444, 0xE6D8CC, BLEND_NONE)
}

// A shine sweeping across (x, y, w, h) once every `period` frames (t: a frame count).
fn ui_shine(x: s32, y: s32, w: s32, h: s32, t: s32, period: s32) {
    let sl = h / 2
    let span = w - sl - 16
    let ph = t % period
    const DUR = 26
    if span <= 0 || ph >= DUR { return }
    let p = x + span * ph / DUR
    quad_fill(p + sl, y, p + sl + 9, y, p, y + h, p + 9, y + h, 0x606060, BLEND_ADD)
    quad_fill(p + sl + 12, y, p + sl + 15, y, p + 12, y + h, p + 15, y + h, 0x383838, BLEND_ADD)
}

// Five slanted pips, n of them lit in col (a spec sheet's rating).
fn ui_pips(x: s32, y: s32, n: s32, col: u32) {
    for i in 0..5 {
        var c = 0xD8CCC0
        if i < n { c = col }
        let px = x + i * 8
        quad_fill(px + 2, y, px + 8, y, px, y + 5, px + 6, y + 5, c, BLEND_NONE)
    }
}

// A tick in a check box (x, y the box's corner, 9 x 9).
fn ui_check(x: s32, y: s32, on: bool, col: u32) {
    rect_outline(x, y, 9, 9, C_STEEL, BLEND_NONE)
    if on {
        line_ex(x + 1, y + 4, x + 4, y + 7, 2, col, col, BLEND_NONE)
        line_ex(x + 4, y + 7, x + 9, y, 2, col, col, BLEND_NONE)
    }
}

// Lines of text (split at '\n') step pixels apart: the brochure's small print sits closer than
// the font's own line.
fn txt_lines(f: *Font, x: s32, y: s32, s: *u8, step: s32, col: u32, align: s32) {
    var line: [64]u8
    var i = 0
    var n = 0
    var yy = y
    while true {
        let ch = s[i]
        if ch == 0 || ch == '\n' {
            line[n] = 0
            txt(f, x, yy, &line[0], col, align)
            if ch == 0 { return }
            yy += step
            n = 0
        } else if n < 63 {
            line[n] = ch
            n += 1
        }
        i += 1
    }
}

// A slanted tag as wide as its label needs; returns the width.
fn tag_fit(x: s32, y: s32, s: *u8, bg: u32, fg: u32) -> s32 {
    let w = max(txt_w(FONT_LABEL, s) + 6, 14)
    tag(x, y, w, s, bg, fg)
    return w
}
