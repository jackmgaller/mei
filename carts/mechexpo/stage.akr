// The stage (D's): the current fight's stage (stages.akr: a row of STAGES, its art and props)
// on the plane chip and in polygons.
//
//   backdrop  the stage's sky (the hangar's dark roof), a gradient on line channel 0, placed by
//             the hall's line
//   BG2       the floor, a Mode 7 plane (plane_floor) at the art's texels a metre
//   BG1       the hall behind the fight (the hangar's trusses, banners, booths and crowd), its
//             bottom row on the floor line at z = hall_z, in parallax bands (channel 2)
//   PL        the mechs, the walls and props (B's models), the effects, with the depth test
//   BG0       the HUD's frame (hud.akr), in front of the mechs
//   PH        the interface list: the HUD's fills and text, the menus
//
// Priorities (PLN_PRIO, the stage's art.prio): the hangar BG2 0, BG1 1, PL 2, BG0 3, PH 4. The
// plane chip costs no CPU or GPU beyond the tables: about 14,000 cycles for the floor's rows, 300
// for the hall's scroll table.
//
// VRAM: ATLAS_0 the floor, ATLAS_1 the hall, ATLAS_2 the HUD frame, ATLAS_3 the menus' page;
// MAP_BG2, MAP_BG1, MAP_BG0; line tables LT_BACKDROP (channel 0), LT_BG1 (2), LT_AFFINE (7) and
// the backdrop's long table at ST_SKY_TAB (VRAM_FREE). Palettes 240-243 the floor, 244-249 the
// hall (244 lent to the menus' page). One stage's art is loaded at a time (stage_show()).

const ST_SKY_TAB = 0x582000       // 1,024 words in the free VRAM: row i is hall-line-relative i - ST_SKY_ZERO
const ST_SKY_ZERO = 700

var st_line: s32                  // the hall's floor line this frame (screen row)
var st_floor_top: s32             // the floor's first row
var st_cycles: s32
var st_hall_loaded: bool
var st_loaded: s32 = -1           // the stage whose floor and sky are loaded

fn stage_boot() {
    stage_load(stage_now())
}

// The stage's floor atlas, its palettes and the backdrop's long table (the sky darkens upward),
// once each time the stage changes.
private fn stage_load(s: *Stage) {
    let id = fight.stage
    if id == st_loaded { return }
    st_loaded = id
    let a = &s.art
    let t = ST_SKY_TAB as *u32
    for i in 0..1024 {
        let d = i - ST_SKY_ZERO
        var c = a.sky[0]
        if d >= a.sky_dy[3] {
            c = a.sky[3]
        } else if d > a.sky_dy[0] {
            var k = 0
            while d >= a.sky_dy[k + 1] { k += 1 }
            let f = fixed(d - a.sky_dy[k]) / (a.sky_dy[k + 1] - a.sky_dy[k])
            c = clerp(a.sky[k], a.sky[k + 1], f)
        }
        t[i] = c
    }
    atlas_load(ATLAS_0, a.floor_tiles, a.floor_bytes as u32)
    load_palette(PAL_FLOOR * 16, a.floor_pal, a.floor_pals * 16)
}

// The stage's planes on (entering a fight, or the title's attract view).
fn stage_show() {
    let s = stage_now()
    let a = &s.art
    stage_load(s)
    atlas_load(ATLAS_1, a.hall_tiles, a.hall_bytes as u32)
    load_palette(PAL_HALL * 16, a.hall_pal, a.hall_pals * 16)
    plane(BG1, ATLAS_1, MAP_BG1, 64, 32, 0, PAL_HALL)
    map_load(BG1, a.hall_map)
    plane(BG2, ATLAS_0, MAP_BG2, FLOOR_N, FLOOR_N, a.floor_out, PAL_FLOOR)
    map_load(BG2, a.floor_map)
    plane_window(BG1, 0, 0, 320, 240)
    PLN_PRIO = a.prio
    st_hall_loaded = true
}

// The planes for this frame, after cam_apply(): the hall's line and parallax, the floor.
fn stage_frame() {
    let c0 = cycle_count()
    let a = &stage_now().art
    // the hall's floor line: the lower of its two ends on screen (the angled view slopes it a
    // few pixels; the barrier covers the floor's far edge either way)
    let pl = project_point(vec3(cam_x - 40.0, 0.0, a.hall_z))
    let pr = project_point(vec3(cam_x + 40.0, 0.0, a.hall_z))
    let line = max(pl.y, pr.y)
    st_line = line
    // the backdrop: channel 0 at the long table's rows for this line
    let h = clamp(line, 240 - 1024 + ST_SKY_ZERO, ST_SKY_ZERO)
    line_channel(0, LC_BD_COLOR, 1, (ST_SKY_TAB + (ST_SKY_ZERO - h) * 4) as u32)
    // the hall: one vertical scroll; each band's x from where world x = 0 falls at its depth
    let sy = (a.hall_h - 1 - line) as u32 & 0xFFFF
    let tbl = LT_BG1 as *u32
    var y = 0
    for b in 0..a.bands {
        let p = project_point(vec3(0.0, 0.0, a.hall_z + a.band_z[b]))
        let sx = (a.hall_w / 2 - p.x) as u32 & 0xFFFF
        let w = sx | (sy << 16)
        var y1 = 240
        if b + 1 < a.bands { y1 = clamp(line - (a.hall_h - 1) + a.band_y[b + 1], 0, 240) }
        while y < y1 {
            tbl[y] = w
            y += 1
        }
    }
    plane_scroll(BG1, 0, sy as s32)
    line_channel(2, lc_scroll(BG1), 1, LT_BG1)
    // the floor
    st_floor_top = plane_floor(0.0, a.floor_s, a.floor_c, a.floor_c, a.floor_far)
    st_cycles = cycle_count() - c0
}

// The stage's polygon props (B's models, assets.akr), each only when the view comes within its
// `near` metres of it: the hangar's walls at x = +-36 and the expo's lightbox banner towers in
// the midground, behind the fight plane.
fn stage_props() {
    let s = stage_now()
    let reach = cam_w * 0.75 + 4.0
    for i in 0..s.nprops {
        let p = &s.props[i]
        if abs(p.x - cam_x) < reach + p.near { mesh_at(p.mesh, vec3(p.x, 0.0, p.z), p.yaw) }
    }
}

// The planes off (the menus set their own).
fn stage_hide() {
    plane_show(BG1, false)
    plane_show(BG2, false)
    line_off(2)
    line_off(7)
}
