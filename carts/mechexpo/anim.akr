// Mech Expo 2000: the animation runtime (A's; the Animation Kit, docs/ANIMKIT.md).
//
// Poses and draws the mechs from the data the kit exports (anim_data.akr, generated by
// tools/mei_anim.py export from anims/MECH/MOVE.anim.json), and gives the fight each move's
// boxes, root motion and marks. Every move is baked frame by frame at export: per frame, each
// part's matrix relative to the root, the boxes (already in fight-local metres), the marks and
// the root motion. Drawing a mech is one matrix product and one mesh_xf() a part; the fight's
// collision reads rectangles. Everything here is fixed point and the same on every run.
//
// Coordinates (README.md, "Coordinates"): fight-local x is forward (the way the mech faces), y
// up, the origin the root on the floor under the pelvis. Boxes and root motion are fight-local
// metres; the fight flips x by the facing. A mech's model faces -Z; anim_place() turns it to
// face +x or -x in the world.
import "anim_data.akr"

// Beam: Raikō's zoner, Tank: Heartland's grappler (appended). Twins: Binary Mechanica's combined
// form and the mech the player picks; TwinA and TwinB: the split form's two bodies, for the
// animations and the drawing only (never in the roster, never a fighter's mech; MOVES.md, "The Twins")
enum Mech { Hero, Doubleblade, Beam, Tank, Twins, TwinA, TwinB }

// The move list (README.md, "Interfaces"): the same names for both mechs.
enum Mv {
    idle, walk_f, walk_b, crouch, jump, land, block, hit_high, hit_low, hit_air, knockdown,
    getup, ko, win, intro, atk_n, atk_f, atk_d, atk_air, sp_n, sp_f, sp_u, sp_d, grab,
    grab_whiff, throw, thrown, grab_break, super,
    thrown_vault,      // the victim of the Double-blade Hero's Vault Throw (added last: the numbering stays)
    thrown_slam,       // the victim of Tank's Atomic Clinch and Chain Reaction (added last)
    combine,           // the Twins: split into combined (L); the bodies swap on its release frame
    split              // the Twins: combined into split (L)
}

// The rigs' parts (models/NAME/NAME.rig.json), one numbering for both mechs. A mech without a
// part (the Hero's weapon_l) draws nothing there; anim_part() still gives the joint's matrix
// (the empty hand's mount).
enum Part {
    pelvis, torso, head, pauldron_r, upper_arm_r, forearm_r, hand_r, weapon_r, pauldron_l,
    upper_arm_l, forearm_l, hand_l, weapon_l, thigh_r, shin_r, foot_r, thigh_l, shin_l, foot_l
}

// Box kinds.
const BOX_HIT: u8 = 0          // what the move hits with: the active frames have one
const BOX_HURT: u8 = 1         // where the mech can be hit
const BOX_PUSH: u8 = 2         // keeps the mechs apart on the ground

// anim_marks() bits, set per frame by the animator.
const MARK_CANCEL: u32 = 1     // the cancel window: the fight may cancel into another move
const MARK_INVULN: u32 = 2     // nothing hits
const MARK_ARMOUR: u32 = 4     // hits land but do not interrupt
const MARK_FLASH: u32 = 8      // the super's flash (the scene freezes and flashes)
const MARK_STEP: u32 = 16      // a foot comes down this frame (a step sound, a little shake)
const MARK_RELEASE: u32 = 32   // the wave leaves / the throw slams (the fight acts on it)
const MARK_RIPOSTE: u32 = 64   // the first frame of the Parry's riposte section (sp_d)
const MARK_PARRY: u32 = 128    // the Parry's stance frames
const MARK_NOPUSH: u32 = 256   // no push box and no hurt: passes through (the Void Step)
const MARK_HIDE: u32 = 512     // not drawn this frame (anim_draw draws nothing): the Void Step's gone frames
const MARK_CHARGE: u32 = 1024  // the frame a held button holds (Beam's Volt Orb charges here while B is held)

const ANIM_MAX_BOXES = 16

// A rectangle in fight-local metres: x0 < x1 (x0 behind, x1 ahead), y0 < y1. The exported
// data holds these records as they are (20 bytes).
struct Box {
    kind: u8           // BOX_HIT, BOX_HURT, BOX_PUSH
    hit: u8            // which hit of a multi-hit move a hit box belongs to (0, 1, ...)
    part: u8           // the Part it follows
    x0: fixed
    y0: fixed
    x1: fixed
    y1: fixed
}

struct Boxes {
    n: s32
    b: [ANIM_MAX_BOXES]Box
}

// ---- the exported data's layout (tools/animkit/export.py writes it)

// A part's matrix relative to the root, one frame: the rotation's rows (4.12 fixed point, the
// tenth entry padding) and the translation.
struct PartXf {
    r: [10]fixed16
    t: [3]fixed
}

const ANIM_LOOP = 1            // AnimMove.flags: frame f means f mod len
const ANIM_AIR = 2             // an airborne move (the kit's floor check skips it)
const ANIM_STANDIN = 4         // no file yet: the mech's _body.anim.json stands in

// A move: its length, and where its sections start in AK_BLOB (bytes): len * len(Part) PartXf,
// len + 1 u16 (each frame's first box; the last is the count), the Box records, len u32 marks,
// len (dx, dy) raw fixed root motions.
struct AnimMove {
    len: s32
    flags: s32
    frames: u32
    box_first: u32
    boxes: u32
    marks: u32
    root: u32
}

var anim_cpu: s32              // CPU cycles the last anim_draw() took (the tests read it)

private fn mv_of(m: Mech, mv: Mv) -> *AnimMove {
    return &AK_MOVES[(m as s32) * len(Mv) + (mv as s32)]
}

// Frame f of the move: wrapped for a loop, else clamped to the move.
private fn frame_of(a: *AnimMove, f: s32) -> s32 {
    if (a.flags & ANIM_LOOP) != 0 {
        let r = f % a.len
        if r < 0 { return r + a.len }
        return r
    }
    return clamp(f, 0, a.len - 1)
}

private fn xf_of(a: *AnimMove, fr: s32, p: s32) -> *PartXf {
    return ((AK_BLOB as u32 + a.frames) as *PartXf) + (fr * len(Part) + p)
}

private fn xf_mat(x: *PartXf) -> mat4 {
    var m: mat4
    m[0] = vec4(x.r[0], x.r[1], x.r[2], x.t[0])
    m[1] = vec4(x.r[3], x.r[4], x.r[5], x.t[1])
    m[2] = vec4(x.r[6], x.r[7], x.r[8], x.t[2])
    m[3] = vec4(0.0, 0.0, 0.0, 1.0)
    return m
}

// Between two frames' matrices (t 0..1): entry by entry, close enough for one frame's turn.
private fn xf_lerp(x: *PartXf, y: *PartXf, t: fixed) -> mat4 {
    var m = xf_mat(x)
    if t == 0.0 { return m }
    let n = xf_mat(y)
    for i in 0..3 { m[i] = m[i] + (n[i] - m[i]) * t }
    return m
}

// ---- the API

// The move's length in frames (60 a second).
fn anim_len(m: Mech, mv: Mv) -> s32 {
    return mv_of(m, mv).len
}

// Whether the move loops (idle, walks, block): frame f means f mod anim_len.
fn anim_loops(m: Mech, mv: Mv) -> bool {
    return (mv_of(m, mv).flags & ANIM_LOOP) != 0
}

// Whether the move has no animation of its own yet (the mech's _body.anim.json stands in).
fn anim_standin(m: Mech, mv: Mv) -> bool {
    return (mv_of(m, mv).flags & ANIM_STANDIN) != 0
}

// The hit, hurt and push boxes at frame f (wrapped or clamped as anim_len says), into out.
fn anim_boxes(m: Mech, mv: Mv, f: s32, out: *Boxes) {
    let a = mv_of(m, mv)
    let fr = frame_of(a, f)
    let first = (AK_BLOB as u32 + a.box_first) as *u16
    let b0 = first[fr] as s32
    let n = min(first[fr + 1] as s32 - b0, ANIM_MAX_BOXES)
    let src = ((AK_BLOB as u32 + a.boxes) as *Box) + b0
    for i in 0..n { out.b[i] = src[i] }
    out.n = n
}

// The root's motion over frame f (from f to f + 1), fight-local metres.
fn anim_root(m: Mech, mv: Mv, f: s32) -> vec2 {
    let a = mv_of(m, mv)
    let r = (AK_BLOB as u32 + a.root) as *s32
    let fr = frame_of(a, f)
    return vec2(from_bits(r[fr * 2]), from_bits(r[fr * 2 + 1]))
}

// The MARK_* bits of frame f.
fn anim_marks(m: Mech, mv: Mv, f: s32) -> u32 {
    let a = mv_of(m, mv)
    return ((AK_BLOB as u32 + a.marks) as *u32)[frame_of(a, f)]
}

// The world matrix of a mech's root at fight position pos (x across the stage, y up; z = 0),
// facing +x (facing > 0) or -x: turned about Y, not mirrored.
fn anim_place(pos: vec2, facing: s32) -> mat4 {
    var a = -HALF_PI
    if facing < 0 { a = HALF_PI }
    return mat4_translate(vec3(pos.x, pos.y, 0.0)) * mat4_rotate_y(a)
}

// A part's matrix relative to the root at frame f (fractional: between two frames).
private fn pose_part(a: *AnimMove, f: fixed, p: s32) -> mat4 {
    let fi = f as s32
    let t = f - fixed(fi)
    return xf_lerp(xf_of(a, frame_of(a, fi), p), xf_of(a, frame_of(a, fi + 1), p), t)
}

// Poses the mech at frame f (fractional: between frames, for hitstop and blends) and draws
// it, its root at root (anim_place()).
fn anim_draw(m: Mech, mv: Mv, f: fixed, root: mat4) {
    let c0 = cycle_count()
    let a = mv_of(m, mv)
    let fi = f as s32
    let t = f - fixed(fi)
    if (anim_marks(m, mv, fi) & MARK_HIDE) != 0 {
        anim_cpu = cycle_count() - c0
        return
    }
    let x0 = xf_of(a, frame_of(a, fi), 0)
    let x1 = xf_of(a, frame_of(a, fi + 1), 0)
    let meshes = &AK_MESH[(m as s32) * len(Part)]
    for p in 0..len(Part) {
        let mesh = meshes[p]
        if mesh != null { mesh_xf(mesh, root * xf_lerp(x0 + p, x1 + p, t)) }
    }
    anim_cpu = cycle_count() - c0
}

// A part's matrix at frame f (its joint's frame, as anim_draw() poses it): sword trails,
// sparks. The weapon's +Y runs along the blade.
fn anim_part(m: Mech, mv: Mv, f: fixed, root: mat4, part: Part) -> mat4 {
    return root * pose_part(mv_of(m, mv), f, part as s32)
}

// ---- seeing the boxes (training mode, the kit's previews)

const BOX_COL_HIT: u32 = 0x3030FF      // 0xBBGGRR: red
const BOX_COL_HURT: u32 = 0xFFC040     // light blue
const BOX_COL_PUSH: u32 = 0x30E0F0     // yellow

private fn box_line(a: vec3, b: vec3, col: u32) {
    let p = project_point(a)
    let q = project_point(b)
    if p.z < 0 || q.z < 0 { return }
    line(p.x, p.y, q.x, q.y, col)
}

// Outlines the boxes of frame f in the world, for a mech at fight position pos facing +x
// (facing > 0) or -x. Drawn over the scene (the interface list): call after the camera is set.
fn anim_draw_boxes(m: Mech, mv: Mv, f: s32, pos: vec2, facing: s32) {
    var bx: Boxes
    anim_boxes(m, mv, f, &bx)
    var s = 1.0
    if facing < 0 { s = -1.0 }
    for i in 0..bx.n {
        let b = &bx.b[i]
        var col = BOX_COL_HURT
        if b.kind == BOX_HIT { col = BOX_COL_HIT }
        if b.kind == BOX_PUSH { col = BOX_COL_PUSH }
        let xa = pos.x + b.x0 * s
        let xb = pos.x + b.x1 * s
        let ya = pos.y + b.y0
        let yb = pos.y + b.y1
        box_line(vec3(xa, ya, 0.0), vec3(xb, ya, 0.0), col)
        box_line(vec3(xb, ya, 0.0), vec3(xb, yb, 0.0), col)
        box_line(vec3(xb, yb, 0.0), vec3(xa, yb, 0.0), col)
        box_line(vec3(xa, yb, 0.0), vec3(xa, ya, 0.0), col)
    }
}
