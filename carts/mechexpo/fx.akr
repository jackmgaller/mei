    FxPre { kind: Pk.Streak, blend: BLEND_ADD, flags: PF_FLOOR, life: 14, life_rnd: 14, speed_rnd: 0.65,
            s0: 0.32, s1: 0.2, grav: 0.02, drag: 0.95, c0: 0x90F4FF, c1: 0x0040F0 },
