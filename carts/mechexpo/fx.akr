// The fight's effects (D's; the particle system is mx-fx's), from the fight's events and state;
// the fight never draws, and nothing here changes the fight.
//
//   particles  a pool of FXP_MAX particles, each with a velocity, gravity, drag, a size and a
//              colour over its life, spin (the shards' frames), a blend mode and a way of being
//              drawn (Pk): sprites from texture slot 11 (fx_art.akr, tools/gen_mechexpo_fx.py)
//              on the interface list at the particle's projected point, sized in metres, or
//              streaks (untextured Gouraud lines along the velocity, for sparks). Emitted in
//              bursts from the events (fx_event) and by the emitters below (fx_update): presets
//              (Pre, PRES) say how each kind of particle moves and looks, fx_spray() fires n of
//              one in a cone. Fixed-point, a fixed pool (a new particle takes the oldest slot
//              when it is full), about 300 CPU cycles a particle a frame to move and draw.
//   hits       by weight (Event.power): light, medium, heavy and crushing differ in the flare,
//              the number and speed of the sparks (which fly, fall and skid on the floor), metal
//              shards (heavy and crushing), smoke and a ring; blocks a blue-white shield hexagon
//              with sparks skidding off it; chip a small hot spray; grabs a clank; throws and
//              knockdowns a dust and debris burst along the floor; landings and steps dust; the
//              KO a big burst, then sparks and smoke from the beaten mech until the next round
//   supers     the charge-up during the super's flash, by the mech's power source (FX_POWERS:
//              kinetic streaks and chevrons, the antimatter implosion and dark core, rows for
//              chemical, nuclear and fusion ready for the mechs that bring them); a reactor glow
//              and motes while a meter is full
//   trails     each weapon's sweep during an attack: the blade's base and tip (anim_part) kept
//              for the last TRAIL_N frames, drawn as a strip of additive Gouraud quads in the
//              world (a mesh in RAM, depth-tested), bright at the edge and fading to nothing at
//              the hilt and toward the oldest; the blade's tip sheds motes
//   shots      the Hero's wave (fight.shot[]): a crescent of light and its glow, trailing motes
//              and kicking dust, and a burst where it ends
//   vanishing  the Void Step and the Antimatter Rend: a dark flicker as the mech sinks, a burst
//              where it goes, and motes falling into the place it reappears
//   flash      the colour offset: white over everything as a super starts, a heavy hit lands
//              or a round is won, then the hall and the floor darkened (tinted by the power
//              source) for the rest of the super's freeze
// Screen shake is the camera's (camera.akr), from fight.shake.
//
// For the other mechs' files: fx_spray(), fx_spawn() and fx_burst_at() are public, and a
// power source's charge-up is a row of FX_POWERS (fx_power_index() maps Power to the row).

import "fx_art.akr"

private const TRAIL_N = 8                  // samples a weapon
private const TRAILS = 4                   // two fighters, two weapons each
const FXP_MAX = 80                        // the particle pool
const FXP_FRAME = 52                       // spawns a frame at most (the rest are dropped)
const FX_Z: fixed = -1.2                   // particles' depth: a little in front of the mechs
private const PXK: fixed = 207.8           // screen pixels a metre at view depth 1 (120 x 1.732)

// How a particle is drawn.
enum Pk: u8 { Dot, Glow, Streak, Shard, Smoke, Dust, Flare, Ring, Floor, Hex, Star, Chevron, Speed, Bubble, Bolt, Burst }

const PF_FLOOR: u8 = 1        // bounces and skids on the floor
const PF_FLICKER: u8 = 2      // blinks
const PF_FLIP: u8 = 4         // mirrored: faces -x (chevrons, speed streaks)
const PF_BACK: u8 = 8         // drawn first, under the rest (smoke, dust)
const PF_STILL: u8 = 16       // keeps its first colour (no fade over life)

struct Pt {
    x: fixed
    y: fixed
    z: fixed
    vx: fixed                  // metres a frame
    vy: fixed
    age: fixed                 // 0 at birth .. 1.0 at death
    dt: fixed                  // age a frame
    s0: fixed                  // metres across at birth
    s1: fixed                  // ... at death
    grav: fixed                // metres a frame a frame, down
    drag: fixed                // the share of its speed kept each frame
    c0: u32                    // colour at birth (sprites: a tint, 0x808080 the sprite as it is,
    c1: u32                    // brighter overdrives it; streaks: the colour drawn), and at death
    kind: Pk
    blend: s8                  // BLEND_*
    flags: u8
    rot: u8                    // the shard's frame (0-7), the smoke's variant
    spin: s8                   // frames turned a frame
}

// The particle presets: how each kind moves and looks; fx_spawn() varies life and size.
struct FxPre {
    kind: Pk
    blend: s32
    flags: u8
    life: s32                  // frames
    life_rnd: s32              // up to this many more
    speed_rnd: fixed           // fx_spray: up to this share slower
    s0: fixed
    s1: fixed
    grav: fixed
    drag: fixed
    c0: u32
    c1: u32
    spin: s32
}

enum Pre {
    Spark, Ember, Shard, Flare, Glow, Ring, Smoke, Dust, Puff, Pebble, Floor, Shield, ShieldSpark,
    Chip, Clank, Mote, Void, VoidMote, Steam, Arc, Bubble, Chevron, Speed, Star, Implode, Scrape, Burst
}

// 0xBBGGRR. Sprite colours are tints (0x80 a channel: as drawn; up to 0xFF: twice as bright).
const PRES: [len(Pre)]FxPre = [
