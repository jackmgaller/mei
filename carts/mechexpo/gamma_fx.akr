// Mech Expo 2000: Gamma's effects, its HUD heat gauge and its polled sounds (mx-gamma-fx; MOVES.md,
// "For the effects and sound (Gamma)"). fx.akr is mx-fx's; Gamma's own drawing is here, called
// with a line each from game.akr (gamma_fx_draw, gamma_fx_offset, gamma_sfx), fx.akr
// (gamma_fx_rod, gamma_fx_rod_fire) and hud.akr (gamma_heat_hud). Additive sprites and Gouraud
// triangles on the interface list (fx.akr's effect sprites, slot 10, and its particles, slot 11:
// the dome, the trefoil, the spike, the jet and the static are Gamma's), Heartland's reactor green
// and white-green. Driven by the fight's events (Vent, Burn, Daze, and the shared Shot, Throw,
// Armour, Parry, Swing) and state (Fighter.heat, Fx.ray_t, Fx.dazed, Fx.daze_drop, Shot.pierce,
// Gamma's move, frame and boxes); nothing here changes the fight.
//
//   the lamp          the normals: a white flash at the lens (the Lamp Jab, the Down Flash), a
//                     white cone from the lens over the Glare Lance's box, fading at 10 m; the
//                     Scorch Sweep's bright spot running along the floor, a scorched streak behind
//   the Atomic Ray    the warm-up (the lens brightening, the shroud's slots lighting from the fist
//                     outward); the ray from the lens to its box's end or the first body it
//                     touches: a white-green core 0.6 m thick in a green halo 2 m thick whose
//                     edge flickers and flares on each tick, streaks running outward, burning
//                     motes falling off; at the contact a glow, a spark star and sparks (a shield
//                     hexagon on a block, sparks thrown up and down off a lead shield, gold off a
//                     Wing Ward); the lens brighter with the heat; the shut-off's dimming lens and
//                     steam
//   the heat          on the gun, for both players: the shroud's slots dull red from 30, orange
//                     from 60, yellow-white from 85; heat haze over the shroud from 45, smoke from
//                     60, a wisp of steam a frame from 85
//   the vent          a white blast of steam out of the shroud both ways along the barrel, the
//                     lamp flickering out, the hatch flaring, then a column of steam rising and
//                     thinning; the shroud from white through orange to dark over the 50 frames
//   a burn, a cut     a shot burnt up in the ray (Burn): a green-white flash 3 m across and a puff
//                     of sparks; the ray cut (a strong shot through it, a Parry): a white snap,
//                     sparks scattering, the lens flickering
//   the Rod Shot      a white-hot spike in an orange glow with a long thin trail (6 m); the bore's
//                     flash and smoke on firing; a spark where it passes through a shot, a flare,
//                     shards and a ring where it pierces armour (Tank's, a braced Lead Shielding)
//   the Geiger Flare  a fan of white light up and ahead from the lens, bright for 2 frames then
//                     thinning, green flecks in it; the daze (Fx.dazed): trefoils and green spots
//                     swimming round the head, a green glow on the chest flickering like a Geiger
//                     counter's count with static over it, green ticks crackling off the body; in
//                     the air (Fx.daze_drop) a green streak along the drop
//   Lead Shielding    a spark at the shield's edge as it clangs into place; on an absorb a dull
//                     white dent-flash on the plate and grey sparks (tank_fx.akr's ring too)
//   Point Blank       the lamp blazing white through the other's chest, light streaming out of
//                     its back; the blast: a white flash and a green ring
//   Ground Zero       the hatch flaring white-green through the flash, the stage tinted toward
//                     green-white (gamma_fx_offset) to the blast's end; the blast: a dome of light
//                     8 m in radius growing in 3 frames, a white flash at the impact, a green
//                     shockwave ring and a dust ring out along the floor both ways, the reactor
//                     flaring white
//   the reactor       tank_fx.akr's (the hatch's glow by the nuclear meter, for any nuclear mech)
//   the HUD           the heat bar under Gamma's meter gauge (green, amber from 60, red and
//                     flashing from 85, white while venting), HEAT flashing from 85, VENT
//
// The ray's frames come from its hit box in the data (sp_n's), or, while the data has none (phase
// 1's placeholder Volt Orb), from Fx.ray_t up to the charge frame, the stand-in's 2.5 to 16 m.

const GMX_GLOW: u32 = 0x6EFF8C          // 0xBBGGRR: the reactor's green (the concept's #8cff6e)
const GMX_CORE: u32 = 0xE0FFF0          // white-green: the ray's core
const GMX_HALO: u32 = 0x40FF60          // Tank's reactor green
const GMX_DEEP: u32 = 0x206028          // a dark green: the glows' rims, a mote's end
const GMX_WHITE: u32 = 0xFFFFFF
const GMX_RED: u32 = 0x2030A0           // the shroud's heat: dull red
const GMX_ORANGE: u32 = 0x2080FF        // orange
const GMX_YELLOW: u32 = 0x80E0FF        // yellow-white
const GMX_STEAM: u32 = 0x707070         // steam (added: half of 0xE0E0E0)

// anchors in the parts' frames (MOVES.md, "For the effects and sound (Gamma)")
const GMX_LENS = vec4(0.0, 0.8, -4.4, 1.0)          // the lens (weapon_r): Beam's muzzle
const GMX_BORE = vec4(0.0, 0.3, -4.86, 1.0)         // the Rod Shot's bore under it (weapon_r)
const GMX_SLOT0 = vec4(0.0, 0.8, -1.2, 1.0)         // the shroud's slots: by the receiver,
const GMX_SLOT1 = vec4(0.0, 0.8, -2.35, 1.0)        // its middle,
const GMX_SLOT2 = vec4(0.0, 0.8, -3.3, 1.0)         // by the lamp's bell (weapon_r)
const GMX_AXIS = vec4(0.0, 0.0, -1.0, 0.0)          // the barrel's direction (weapon_r)
const GMX_SHIELD = vec4(0.8, -0.1, 0.0, 1.0)        // the shield's face (weapon_l)
const GMX_SHIELD_EDGE = vec4(0.8, 1.2, 0.0, 1.0)    // its top lip
const GMX_HATCH = vec4(0.0, 2.1, -1.5, 1.0)         // the reactor hatch (torso; tank_fx.akr's)

const GFX_RAY_X0: fixed = 2.5           // the stand-in ray's box from the root (phase 1's)
const GFX_RAY_X1: fixed = 16.0
const GFX_VENT_LEN = 50                 // the vent's frames
const GFX_GZ_LEN = 20                   // the blast drawn: its 8 active frames and 12 fading
const GFX_SCORCH = 12                   // the Scorch Sweep's streak: points kept

var gfx_on: bool                        // a Gamma in this fight (gamma_fx_draw sets it)
var gfx_tick: s32                       // the fight's tick last seen (events and spawns once a tick)
var gfx_frame: s32
var gfx_rng: u32 = 0x6A3C51D7
var gfx_pmv: [2]Mv                      // Gamma's move and frame last tick (frame crossings)
var gfx_pt: [2]s32
var gfx_hot: [2]s32                     // frames of the current move with a hit box so far (the draw's)
var gfx_ray_was: [2]bool                // the ray last tick (the draw's)
var gfx_ray_t: [2]s32                   // ticks the ray has been drawn this time
var gfx_off_t: [2]s32                   // ticks since the ray went out (the lens dimming)
var gfx_end: [2]fixed                   // the ray's end last tick (world x) and its height
var gfx_ray_y: [2]fixed
var gfx_vent_t: [2]s32 = [-1, -1]       // ticks since the Vent event, or -1
var gfx_cut_t: [2]s32 = [99, 99]        // ticks since the ray was cut
var gfx_gz_t: [2]s32 = [-1, -1]         // ticks since Ground Zero's blast came out, or -1
var gfx_gz_x: [2]fixed
var gfx_lead_t: [2]s32 = [99, 99]       // ticks since the shield absorbed a hit
var gfx_shot_on: [2]bool                // each side's shot last tick
var gfx_shot_x: [2]fixed
var gfx_shot_half: [2]fixed
var gfx_shot_str: [2]s32
var gfx_rod_on: [2]bool                 // a side's rod last tick: where, and the shot it is passing
var gfx_rod_x: [2]fixed
var gfx_rod_y: [2]fixed
var gfx_rod_by: [2]bool                 // ... whether it has passed the other side's shot yet
var gfx_armd: [4]bool                   // each body armoured last tick (a rod through it pierces)
var gfx_scx: [GFX_SCORCH]fixed          // the Scorch Sweep's streak on the floor
var gfx_sct: [GFX_SCORCH]s32
var gfx_sc_next: s32

// The data, read once: Gamma's sp_n hit-box frames and charge frame, its super's first hit-box
// frame.
var gfx_found: bool
var gfx_ray0: s32 = -1                  // sp_n's first frame with a hit box (-1: none: phase 1)
var gfx_charge: s32 = -1                // sp_n's charge frame

// What was drawn, for the tests (scenarios 240-249): frames or bursts of each effect since the
// fight started (GFXS_*), the HUD's gauge this frame by side, the stage's tint (0..256).
const GFXS_LAMP = 0                     // frames of the lamp's flash (the jab, the Down Flash)
const GFXS_CONE = 1                     // frames of the Glare Lance's cone
const GFXS_SCORCH = 2                   // frames of the Scorch Sweep's spot
const GFXS_WARM = 3                     // frames of the ray's warm-up
const GFXS_RAY = 4                      // frames of the ray drawn
const GFXS_CONTACT = 5                  // ... of them ending on a body
const GFXS_BLOCKED = 6                  // ... on a guard
const GFXS_LEADRAY = 7                  // ... on a braced lead shield
const GFXS_WARDRAY = 8                  // ... on a Wing Ward
const GFXS_HEAT = 9                     // frames of the shroud's glow (heat 30 and over)
const GFXS_STEAM = 10                   // wisps of steam (heat 85 and over)
const GFXS_VENT = 11                    // frames of the vent drawn
const GFXS_BURN = 12                    // Burn events' bursts
const GFXS_CUT = 13                     // the ray cut
const GFXS_ROD = 14                     // frames of a rod drawn
const GFXS_BORE = 15                    // the bore's flash
const GFXS_PASS = 16                    // a rod through a shot
const GFXS_PIERCE = 17                  // a rod through armour
const GFXS_FLARE = 18                   // frames of the Geiger Flare's fan
const GFXS_DAZE = 19                    // frames of a daze drawn (a body each)
const GFXS_DROP = 20                    // frames of a daze's drop streak
const GFXS_DAZED = 21                   // Daze events' bursts
const GFXS_CLANG = 22                   // the shield's clang into place
const GFXS_DENT = 23                    // absorbs on the shield
const GFXS_BLAZE = 24                   // frames of Point Blank's lamp through the chest
const GFXS_BLAST = 25                   // Point Blank's blast
const GFXS_HATCH = 26                   // frames of the hatch's flare in Ground Zero's flash
const GFXS_DOME = 27                    // frames of Ground Zero's dome
const GFXS_GZ = 28                      // Ground Zero's blasts
const GFXS_N = 29
var gfx_seen: [GFXS_N]s32
var gfx_hud_bar: [2]s32 = [-1, -1]      // the heat bar drawn (pixels; -1 none)
var gfx_hud_col: [2]u32                 // its colour
var gfx_hud_label: [2]s32               // 0 none, 1 HEAT, 2 VENT
var gfx_tint: s32                       // the stage's tint applied this frame (0..256)
var gfx_cycles: s32                     // CPU cycles of the last gamma_fx_draw (the tests read it)

// ---- small helpers

private fn gfx_u() -> u32 {
    var s = gfx_rng
    s ^= s << 13
    s ^= s >> 17
    s ^= s << 5
    gfx_rng = s
    return s
}
private fn gfx_sf() -> fixed { return from_bits((gfx_u() >> 15) as s32) - 1.0 }    // -1 .. 1
private fn gfx_f() -> fixed { return from_bits((gfx_u() >> 16) as s32) }           // 0 .. 1

private fn gfx_glow(p: vec3, size: fixed, w_k: fixed, col: u32) {
    let q = project_point(p)
    if q.z < 0 { return }
    let d = fx_px(p, size)
    if d <= 0 { return }
    fx_sprite(&FX_GLOW[0], q.x, q.y, (fixed(d) * w_k) as s32, d, col, BLEND_ADD)
}

// A sprite of the particle sheet (slot 11) at p, size metres across, its height h_k of that.
private fn gfx_psp(r: *s32, p: vec3, size: fixed, h_k: fixed, col: u32, flip: bool) {
    let q = project_point(p)
    if q.z < 0 { return }
    let d = fx_px(p, size)
    if d <= 0 { return }
    fx_psprite_ex(r, q.x, q.y, d, max((fixed(d) * h_k) as s32, 1), col, BLEND_ADD, flip)
}

// A point in part's frame of body fi this frame.
private fn gfx_pt_of(fi: *Fighter, root: mat4, part: Part, lp: vec4) -> vec3 {
    return (anim_part(fi.body, fi.mv, fi.frame, root, part) * lp) as vec3
}

// Gamma's projector (weapon_r) this frame, side s: its matrix (gfx_moves sets it once a frame) and
// a point in its frame.
var gfx_wm: [2]mat4
private fn gfx_w(s: s32, lp: vec4) -> vec3 { return (gfx_wm[s] * lp) as vec3 }

private fn gfx_mote(x: fixed, y: fixed, vx: fixed, vy: fixed, life: s32, c0: u32, c1: u32) -> *Pt {
    fx_c0 = c0
    fx_c1 = c1
    let p = fx_spawn(Pre.Mote, x, y, vx, vy)
    p.dt = 1.0 / life
    fx_c0 = 0
    fx_c1 = 0
    return p
}

private fn gfx_steam(x: fixed, y: fixed, vx: fixed, vy: fixed, s1: fixed, life: s32) {
    fx_c0 = GMX_STEAM
    fx_c1 = 0x101210
    let p = fx_spawn(Pre.Steam, x, y, vx, vy)
    p.s1 = s1
    p.dt = 1.0 / life
    fx_c0 = 0
    fx_c1 = 0
}

// Whether side s reached frame k (from 0) of move mv this tick.
private fn gfx_at(s: s32, fi: *Fighter, mv: Mv, k: s32) -> bool {
    if fi.mv != mv || fx[s].t < k { return false }
    return gfx_pmv[s] != mv || gfx_pt[s] < k
}

// A hit box of body i this frame (world: x0, y0, x1, y1), the one reaching furthest ahead.
private fn gfx_hitbox(i: s32, out: *vec4) -> bool {
    let b = &fbox[i]
    var found = false
    var best = -999.0
    for k in 0..b.n {
        if b.b[k].kind != BOX_HIT { continue }
        let w = world_box(i, &b.b[k])
        let far = if_fixed(fight.f[i].facing > 0, w.z, -w.x)
        if far > best {
            best = far
            out[0] = w
            found = true
        }
    }
    return found
}

private fn if_fixed(c: bool, a: fixed, b: fixed) -> fixed {
    if c { return a }
    return b
}

private fn gfx_find() {
    if gfx_found { return }
    gfx_found = true
    var b: Boxes
    let n = mv_len(Mech.Gamma, Mv.sp_n)
    for k in 0..n {
        mv_boxes(Mech.Gamma, Mv.sp_n, k, &b)
        for q in 0..b.n {
            if b.b[q].kind == BOX_HIT && gfx_ray0 < 0 { gfx_ray0 = k }
        }
    }
    gfx_charge = find_mark(Mech.Gamma, Mv.sp_n, MARK_CHARGE)
}

// Whether side s's Atomic Ray is on this frame, and its box's x range (world, x0 < x1). The ray
// is on while its hit box is out; in phase 1's data (no box) while Fx.ray_t counts, up to the
// charge frame.
fn gamma_ray(s: s32, out: *vec4) -> bool {
    let fi = &fight.f[s]
    if fi.mech != Mech.Gamma || fi.mv != Mv.sp_n { return false }
    gfx_find()
    if gfx_ray0 >= 0 { return gfx_hitbox(s, out) }
    if fx[s].ray_t <= 0 || (gfx_charge >= 0 && cur_frame(s) > gfx_charge) { return false }
    let ft = fixed(fi.facing)
    let a = fi.x + ft * GFX_RAY_X0
    let b = fi.x + ft * GFX_RAY_X1
    out[0] = vec4(min(a, b), fi.y + 6.0, max(a, b), fi.y + 8.0)
    return true
}

// Whether body j is braced behind a lead shield (a Gamma's Lead Shielding).
private fn gfx_braced(j: s32) -> bool {
    let o = &fight.f[j]
    if o.mech != Mech.Gamma || o.mv != Mv.sp_d { return false }
    let t = fx[j].t
    return t >= 4 && t <= 30
}

// Whether body j would let a rod pierce its armour now (Tank's armour, a braced lead shield).
private fn gfx_armoured(j: s32) -> bool {
    if j >= 2 && !twins_on(j - 2) { return false }
    return (cur_marks(j) & MARK_ARMOUR) != 0 || gfx_braced(j)
}

// Where side s's ray ends (world x) along [x0, x1]: the nearest hurt box of the other side's
// bodies across y0..y1, or the box's far end. Sets *hit to the body touched (-1 none).
private fn gfx_ray_end(s: s32, box: vec4, hit: *s32) -> fixed {
    let fi = &fight.f[s]
    let dir = fi.facing
    var end = box.z
    if dir < 0 { end = box.x }
    hit[0] = -1
    for k in 0..2 {
        let j = (1 - s) + k * 2
        if k == 1 && !twins_on(1 - s) { continue }
        if !hittable(j) { continue }
        let bj = &fbox[j]
        for q in 0..bj.n {
            if bj.b[q].kind != BOX_HURT { continue }
            let u = world_box(j, &bj.b[q])
            if u.w <= box.y || u.y >= box.w || u.z <= box.x || u.x >= box.z { continue }
            if dir > 0 && u.x < end {
                end = max(u.x, box.x)
                hit[0] = j
            }
            if dir < 0 && u.z > end {
                end = min(u.z, box.z)
                hit[0] = j
            }
        }
    }
    return end
}

// ---- the shots (fx.akr's shot loop hands each shot with `pierce` here first): the Rod Shot,
// and a rod a Wing Ward sent back (drawn as light, gold)

fn gamma_fx_rod(sh: *Shot) {
    gfx_seen[GFXS_ROD] += 1
    let y = (sh.y0 + sh.y1) / 2
    let p = vec3(sh.x, y, -0.6)
    let q = project_point(p)
    if q.z < 0 { return }
    let px = fx_px(p, 1.0)
    let back = -fixed(sgn(sh.vx))
    var hot = GMX_ORANGE
    var core = 0xC0F0FF
    var trail = 0x1060E0
    if sh.refl {
        hot = 0x40C0FF                          // Seraph's light: gold, white-gold
        core = 0xDCF8FF
        trail = 0x2080C0
    }
    // the trail: a long thin streak 6 m behind it, hot at the rod, and a white thread inside it
    let tp = vec3(sh.x + back * 6.0, y, -0.6)
    let tq = project_point(tp)
    if tq.z >= 0 {
        let tw = if_s32(back < 0.0, abs(tq.x - q.x), -abs(tq.x - q.x))
        fx_sprite(&FX_STREAK[0], (q.x + tq.x) / 2, q.y, tw, max(px * 3 / 4, 3), trail, BLEND_ADD)
        line_ex(q.x, q.y, tq.x, tq.y, 2, core, 0, BLEND_ADD)
    }
    // the glow, then the spike, its tip white-hot
    let flick = (sh.t & 1) as s32
    let tip = q.x - (back * fixed(px) * 0.9) as s32
    fx_sprite(&FX_GLOW[0], q.x, q.y, px * 4, px * 2 + flick, hot, BLEND_ADD)
    fx_psprite_ex(&FXP_SPIKE[0], q.x, q.y, px * 3, max(px * 3 / 4, 4), GMX_WHITE, BLEND_ADD, back > 0.0)
    fx_psprite_ex(&FXP_SPIKE[0], q.x, q.y, px * 3, max(px * 3 / 4, 4), core, BLEND_ADD, back > 0.0)
    fx_sprite(&FX_SPARK[0], tip, q.y, px * 2 + flick, px * 2 + flick, GMX_WHITE, BLEND_ADD)
}

private fn if_s32(c: bool, a: s32, b: s32) -> s32 {
    if c { return a }
    return b
}

// The Shot event of a rod (fx.akr's fx_event): the bore's flash and its smoke, at Gamma's bore.
fn gamma_fx_rod_fire(s: s32, f: *Fight) {
    let fi = &f.f[clamp(s, 0, 1)]
    let root = anim_place(vec2(fi.x, fi.y), fi.facing)
    let b = gfx_pt_of(fi, root, Part.weapon_r, GMX_BORE)
    let fl = fx_burst_at(Pre.Flare, b.x, b.y, GMX_WHITE, GMX_ORANGE)
    fl.s0 = 5.0
    fl.s1 = 2.5
    let g = fx_burst_at(Pre.Glow, b.x, b.y, 0x60C0FF, 0x102040)
    g.s0 = 1.5
    g.s1 = 3.5
    fx_c0 = 0xA0E0FF
    fx_c1 = 0x0840C0
    fx_spray(Pre.Spark, 5, b.x, b.y, if_s32(fi.facing > 0, 0, 16), 3, 0.42)
    let sm = fx_spawn(Pre.Smoke, b.x, b.y, -fixed(fi.facing) * 0.02, 0.04)
    sm.s1 = 3.5
    gfx_seen[GFXS_BORE] += 1
}

// ---- once a frame in a fight (after the mechs, with fx.akr's effects)

fn gamma_fx_draw(f: *Fight) {
    let c0 = cycle_count()
    gfx_draw(f)
    gfx_cycles = cycle_count() - c0
}

private fn gfx_draw(f: *Fight) {
    gfx_on = f.f[0].mech == Mech.Gamma || f.f[1].mech == Mech.Gamma
    if !gfx_on { return }
    gfx_frame += 1
    let tick = f.ticks != gfx_tick
    if tick {
        gfx_tick = f.ticks
        let ev = fight_events()
        for k in 0..ev.n { gamma_fx_event(&ev.e[k], f) }
    }
    // the daze, on every dazed body (a split Twins' partner too)
    for i in 0..4 {
        if i >= 2 && !twins_on(i - 2) { continue }
        if fx[i].dazed || fx[i].daze_drop > 0 { gfx_daze(f, i, tick) }
    }
    // the scorched streak
    for k in 0..GFX_SCORCH {
        if gfx_sct[k] <= 0 { continue }
        let a = fixed(gfx_sct[k]) / 12
        gfx_glow(vec3(gfx_scx[k], 0.08, -0.4), 2.6, 1.0, col_scale(0x0828A0, a * 0.7))
        if tick { gfx_sct[k] -= 1 }
    }
    for s in 0..2 {
        let fi = &f.f[s]
        if fi.mech != Mech.Gamma {
            gfx_vent_t[s] = -1
            gfx_gz_t[s] = -1
            continue
        }
        gfx_moves(f, s, tick)
        if tick {
            gfx_pmv[s] = fi.mv
            gfx_pt[s] = fx[s].t
        }
    }
    if tick {
        // what the rods did this tick; then each body's armour and each shot, for the next
        for s in 0..2 { gfx_rods(f, s) }
        for i in 0..4 { gfx_armd[i] = gfx_armoured(i) }
        for s in 0..2 {
            let sh = &f.shot[s]
            gfx_shot_on[s] = sh.on
            gfx_shot_x[s] = sh.x
            gfx_shot_half[s] = sh.half
            gfx_shot_str[s] = sh.str
        }
    }
}

// A fight event's effects (once each: gamma_fx_draw calls it for the tick's events; the tests
// call it to stand in for the fight's).
fn gamma_fx_event(e: *Event, f: *Fight) {
    let side = clamp(e.side, 0, 1)
    match e.kind {
        Vent => {
            gfx_vent_t[side] = 0
            let fi = &f.f[side]
            let root = anim_place(vec2(fi.x, fi.y), fi.facing)
            let m = gfx_pt_of(fi, root, Part.weapon_r, GMX_SLOT1)
            let g = fx_burst_at(Pre.Glow, m.x, m.y, GMX_WHITE, 0x404040)
            g.s0 = 3.0
            g.s1 = 7.0
            let r = fx_burst_at(Pre.Ring, m.x, m.y, 0xC0C0C0, 0x202020)
            r.s1 = 8.0
        }
        Burn => {
            // the shot burnt up: a green-white flash 3 m across, a puff of sparks
            let g = fx_burst_at(Pre.Glow, e.x, e.y, GMX_CORE, GMX_DEEP)
            g.s0 = 3.0
            g.s1 = 4.0
            g.dt = 1.0 / 8
            let fl = fx_burst_at(Pre.Flare, e.x, e.y, GMX_WHITE, GMX_GLOW)
            fl.s0 = 4.0 + fixed(clamp(e.power, 1, 3))
            fx_c0 = GMX_CORE
            fx_c1 = 0x10A020
            fx_spray(Pre.Spark, 8, e.x, e.y, 8, 16, 0.28)
            let sm = fx_spawn(Pre.Smoke, e.x, e.y, 0.0, 0.03)
            sm.s1 = 3.0
            gfx_seen[GFXS_BURN] += 1
        }
        Daze => {
            let st = fx_burst_at(Pre.Star, e.x, e.y, GMX_WHITE, GMX_GLOW)
            st.s0 = 7.0
            let r = fx_burst_at(Pre.Ring, e.x, e.y, GMX_GLOW, GMX_DEEP)
            r.s1 = 7.0
            fx_c0 = GMX_GLOW
            fx_c1 = GMX_DEEP
            fx_spray(Pre.Spark, 6, e.x, e.y, 8, 16, 0.2)
            gfx_seen[GFXS_DAZED] += 1
        }
        Parry => {
            // a Parry caught the ray's tick: the ray is cut
            let g = 1 - side
            if f.f[g].mech == Mech.Gamma && f.f[g].mv == Mv.sp_n && gfx_ray_was[g] { gfx_cut(g, e.x, e.y) }
        }
        Armour => {
            // a hit absorbed: by a braced lead shield, the dent-flash on the plate
            for k in 0..2 {
                let d = (1 - side) + k * 2
                if k == 1 && !twins_on(1 - side) { continue }
                if !gfx_braced(d) { continue }
                let fi = &f.f[d]
                let root = anim_place(vec2(fi.x, fi.y), fi.facing)
                let p = gfx_pt_of(fi, root, Part.weapon_l, GMX_SHIELD)
                let st = fx_burst_at(Pre.Star, p.x, p.y, GMX_WHITE, 0x808880)
                st.s0 = 6.0
                let g = fx_burst_at(Pre.Glow, p.x, p.y, 0xC0C8C0, 0x303430)
                g.s0 = 2.4
                g.s1 = 4.0
                fx_c0 = 0xD0D8D0
                fx_c1 = 0x404840
                fx_spray(Pre.ShieldSpark, 8, p.x, p.y, if_s32(fi.facing > 0, 3, 13), 6, 0.26)
                if d < 2 { gfx_lead_t[d] = 0 }
                gfx_seen[GFXS_DENT] += 1
                break
            }
        }
        Throw => {
            // Point Blank's blast: a white flash and a green ring
            let fi = &f.f[side]
            if fi.mech == Mech.Gamma && fi.mv == Mv.throw {
                let root = anim_place(vec2(fi.x, fi.y), fi.facing)
                let p = gfx_pt_of(fi, root, Part.weapon_r, GMX_LENS)
                fx_flash_start(3)
                let fl = fx_burst_at(Pre.Flare, p.x, p.y, GMX_WHITE, GMX_GLOW)
                fl.s0 = 14.0
                fl.s1 = 8.0
                let r = fx_burst_at(Pre.Ring, p.x, p.y, GMX_GLOW, GMX_DEEP)
                r.s0 = 2.0
                r.s1 = 12.0
                r.dt = 1.0 / 14
                fx_c0 = GMX_CORE
                fx_c1 = 0x10A020
                fx_spray(Pre.Spark, 10, p.x, p.y, if_s32(fi.facing > 0, 2, 14), 6, 0.4)
                gfx_seen[GFXS_BLAST] += 1
            }
        }
        else => {}
    }
}

// The ray cut at (x, y): a white snap, sparks scattering, the lens flickering.
private fn gfx_cut(s: s32, x: fixed, y: fixed) {
    if gfx_cut_t[s] < 4 { return }                  // once
    gfx_cut_t[s] = 0
    let fl = fx_burst_at(Pre.Flare, x, y, GMX_WHITE, GMX_GLOW)
    fl.s0 = 9.0
    fl.s1 = 4.0
    let st = fx_burst_at(Pre.Star, x, y, GMX_WHITE, GMX_DEEP)
    st.s0 = 6.0
    fx_c0 = GMX_CORE
    fx_c1 = 0x10A020
    fx_spray(Pre.Spark, 12, x, y, 8, 16, 0.34)
    gfx_seen[GFXS_CUT] += 1
}

// Gamma's moves, side s.
private fn gfx_moves(f: *Fight, s: s32, tick: bool) {
    let fi = &f.f[s]
    let root = anim_place(vec2(fi.x, fi.y), fi.facing)
    gfx_wm[s] = anim_part(fi.body, fi.mv, fi.frame, root, Part.weapon_r)
    let dir = fixed(fi.facing)
    let live = tick && f.freeze <= 0                // the streams pause in hitstop
    let t = fx[s].t
    var hb: vec4
    let has_box = fi.mv != Mv.grab && gfx_hitbox(s, &hb)
    if tick {
        if fi.mv != gfx_pmv[s] { gfx_hot[s] = 0 }
        if has_box { gfx_hot[s] += 1 }
    }
    // the ray
    var rb: vec4
    let ray = gamma_ray(s, &rb)
    if ray {
        gfx_ray_draw(f, s, root, rb, tick, live)
    } else if tick && gfx_ray_was[s] {
        // the ray went out: cut by a strong shot through it?
        let o = 1 - s
        if gfx_shot_on[o] && gfx_shot_str[o] >= 2 && (gfx_shot_x[o] - gfx_end[s]) * dir <= 1.5
           && (gfx_shot_x[o] - fi.x) * dir >= 0.0 {
            gfx_cut(s, gfx_shot_x[o], gfx_ray_y[s])
        }
        gfx_off_t[s] = 0
    }
    if tick {
        gfx_ray_was[s] = ray
        if !ray { gfx_ray_t[s] = 0 }
        gfx_off_t[s] += 1
        gfx_cut_t[s] = min(gfx_cut_t[s] + 1, 99)
        gfx_lead_t[s] = min(gfx_lead_t[s] + 1, 99)
    }
    let lens = gfx_w(s, GMX_LENS)
    let lp = vec3(lens.x, lens.y, -1.0)
    // the warm-up: the lens brightening, the slots lighting from the fist outward
    var warm = t < gfx_ray0                         // before the ray's first box
    if gfx_ray0 < 0 { warm = fx[s].ray_t <= 0 && (gfx_charge < 0 || t <= gfx_charge) }
    if fi.mv == Mv.sp_n && !ray && gfx_ray_t[s] == 0 && gfx_vent_t[s] < 0 && warm {
        var n = gfx_ray0
        if n <= 0 { n = max(gfx_charge, 1) }
        let k = clamp(fixed(t + 1) / n, 0.0, 1.0)
        gfx_glow(lp, 0.6 + k * 1.6, 1.0, col_scale(GMX_GLOW, 0.3 + k * 0.7))
        gfx_glow(lp, 0.3 + k * 0.6, 1.0, col_scale(GMX_CORE, k))
        let slots: [3]vec4 = [GMX_SLOT0, GMX_SLOT1, GMX_SLOT2]
        for j in 0..3 {
            let kj = clamp(k * 3 - fixed(j), 0.0, 1.0)
            if kj > 0.0 {
                let sp = gfx_w(s, slots[j])
                gfx_glow(vec3(sp.x, sp.y, -1.0), 1.0, 1.4, col_scale(GMX_GLOW, kj * 0.7))
            }
        }
        gfx_seen[GFXS_WARM] += 1
    }
    // the shut-off: the lens dimming, steam puffing from the shroud
    if fi.mv == Mv.sp_n && !ray && gfx_vent_t[s] < 0 && gfx_off_t[s] < 10 && gfx_ray_t[s] == 0
       && (gfx_ray0 >= 0 && t > gfx_ray0 || fx[s].ray_t > 0) {
        let k = 1.0 - fixed(gfx_off_t[s]) / 10
        gfx_glow(lp, 1.0 + k * 1.4, 1.0, col_scale(GMX_GLOW, k * 0.8))
        if live && gfx_off_t[s] % 4 == 1 {
            let m = gfx_w(s, GMX_SLOT1)
            gfx_steam(m.x, m.y + 0.4, 0.0, 0.05, 3.0, 22)
        }
    }
    // the heat on the gun
    gfx_heat(f, s, root, live)
    // the vent
    if gfx_vent_t[s] >= 0 {
        if is_hurt(fi.mv) || gfx_vent_t[s] >= GFX_VENT_LEN {
            gfx_vent_t[s] = -1
        } else {
            gfx_vent(f, s, root, live)
            if tick { gfx_vent_t[s] += 1 }
        }
    }
    // the lamp: the normals
    if has_box && (fi.mv == Mv.atk_n || fi.mv == Mv.atk_air) {
        let k = 1.0 - fixed(min(gfx_hot[s] - 1, 4)) / 6
        gfx_psp(&FXP_FLARE[0], lp, 6.0 * k, 0.5, GMX_WHITE, false)
        gfx_glow(lp, 2.4 * k, 1.0, col_scale(GMX_CORE, k))
        gfx_seen[GFXS_LAMP] += 1
    }
    if has_box && fi.mv == Mv.atk_f {
        gfx_cone(lp, hb, dir, 1.0 - fixed(min(gfx_hot[s] - 1, 3)) / 6)
        gfx_glow(lp, 2.6, 1.0, GMX_CORE)
        gfx_psp(&FXP_FLARE[0], lp, 7.0, 0.5, GMX_WHITE, false)
        gfx_seen[GFXS_CONE] += 1
    }
    if has_box && fi.mv == Mv.atk_d {
        // the spot of light at the box's far end, on the floor
        let x = if_fixed(dir > 0.0, hb.z, hb.x) - dir * 0.6
        let p = vec3(x, 0.1, -0.5)
        gfx_glow(p, 3.0, 1.6, col_scale(GMX_YELLOW, 0.9))
        gfx_glow(vec3(x, 0.6, -0.6), 1.2, 1.0, GMX_WHITE)
        if live {
            gfx_scx[gfx_sc_next] = x
            gfx_sct[gfx_sc_next] = 12
            gfx_sc_next = (gfx_sc_next + 1) % GFX_SCORCH
            fx_c0 = GMX_YELLOW
            fx_c1 = 0x0020A0
            fx_spray(Pre.Ember, 2, x, 0.3, 8, 5, 0.12)
            fx_c0 = 0
            fx_c1 = 0
        }
        gfx_seen[GFXS_SCORCH] += 1
    }
    // the Geiger Flare: a fan of light up and ahead from the lens
    if has_box && fi.mv == Mv.sp_u {
        let ax = (gfx_wm[s] * GMX_AXIS) as vec3
        var k = 1.0
        if gfx_hot[s] > 2 { k = max(1.0 - fixed(gfx_hot[s] - 2) / 6, 0.35) }
        gfx_fan(lp, ax, k)
        if live {
            for j in 0..2 {
                let a = 2.0 + gfx_f() * 10.0
                gfx_mote(lp.x + ax.x * a + gfx_sf() * a / 3, lp.y + ax.y * a + gfx_sf(), ax.x * 0.1, ax.y * 0.1, 10, GMX_GLOW, GMX_DEEP)
            }
        }
        if tick && gfx_hot[s] == 1 {
            let fl = fx_burst_at(Pre.Flare, lp.x, lp.y, GMX_WHITE, GMX_GLOW)
            fl.s0 = 10.0
            fl.s1 = 5.0
        }
        gfx_seen[GFXS_FLARE] += 1
    }
    // Lead Shielding: a spark at the shield's edge as it clangs into place (frame 5)
    if fi.mv == Mv.sp_d && tick && gfx_at(s, fi, Mv.sp_d, 4) {
        let p = gfx_pt_of(fi, root, Part.weapon_l, GMX_SHIELD_EDGE)
        fx_burst_at(Pre.Clank, p.x, p.y, GMX_WHITE, 0x808880)
        fx_c0 = 0xFFFFF0
        fx_c1 = 0x406080
        fx_spray(Pre.Spark, 6, p.x, p.y, 8, 7, 0.22)
        gfx_seen[GFXS_CLANG] += 1
    }
    if gfx_lead_t[s] < 8 {
        // the dent-flash: the plate lit white, fading
        let p = gfx_pt_of(fi, root, Part.weapon_l, GMX_SHIELD)
        let k = 1.0 - fixed(gfx_lead_t[s]) / 8
        gfx_glow(vec3(p.x, p.y, -1.1), 3.2, 0.8, col_scale(0xD0D8D0, k))
    }
    // Point Blank: the lamp blazing through the other's chest
    if fi.mv == Mv.throw && t >= 5 && is_thrown(f.f[vic[s]].mv) {
        let pulse = fixed((gfx_frame * 5) % 7) / 20                     // 0 .. 0.3
        gfx_glow(lp, 4.5 + pulse * 2, 1.0, col_scale(GMX_GLOW, 0.8))
        gfx_glow(lp, 2.2 + pulse, 1.0, GMX_WHITE)
        gfx_psp(&FXP_FLARE[0], lp, 9.0 + pulse * 6, 0.5, GMX_CORE, false)
        // the light out of the other's back
        let bk = vec3(lp.x + dir * 3.5, lp.y, -1.0)
        let q0 = project_point(lp)
        let q1 = project_point(bk)
        if q0.z >= 0 && q1.z >= 0 {
            let px = fx_px(bk, 1.0)
            fx_sprite(&FX_STREAK[0], (q0.x + q1.x) / 2, q1.y, if_s32(dir > 0.0, abs(q1.x - q0.x) * 2, -abs(q1.x - q0.x) * 2),
                      px * 2, col_scale(GMX_CORE, 0.6 + pulse), BLEND_ADD)
        }
        if live && f.ticks % 3 == 0 {
            fx_c0 = GMX_CORE
            fx_c1 = 0x10A020
            fx_spray(Pre.Spark, 2, lp.x + dir * 2.0, lp.y, if_s32(dir > 0.0, 0, 16), 6, 0.3)
        }
        gfx_seen[GFXS_BLAZE] += 1
    }
    // Ground Zero
    gfx_ground_zero(f, s, root, has_box, tick)
}

// The shroud's heat: the slots' glow by Fighter.heat (white at the vent's start, then cooling
// through orange to dark), haze, smoke and steam.
private fn gfx_heat(f: *Fight, s: s32, root: mat4, live: bool) {
    let fi = &f.f[s]
    let h = clamp(fi.heat, 0, 100)
    let vt = gfx_vent_t[s]
    var col: u32 = 0
    var k = 0.0
    if vt >= 0 {
        if vt < 8 {
            col = GMX_WHITE
            k = 1.0
        } else if vt < 26 {
            col = clerp(GMX_WHITE, GMX_ORANGE, fixed(vt - 8) / 18)
            k = 1.0
        } else {
            col = GMX_ORANGE
            k = max(1.0 - fixed(vt - 26) / 24, 0.0)
        }
    } else if h >= 85 {
        col = GMX_YELLOW
        k = 0.85 + fixed(h - 85) / 100
    } else if h >= 60 {
        col = clerp(GMX_ORANGE, GMX_YELLOW, fixed(h - 60) / 25)
        k = 0.7 + fixed(h - 60) / 120
    } else if h >= 30 {
        col = clerp(GMX_RED, GMX_ORANGE, fixed(h - 30) / 30)
        k = 0.45 + fixed(h - 30) / 120
    }
    if k <= 0.0 { return }
    gfx_seen[GFXS_HEAT] += 1
    let flick = fixed((gfx_frame * 3 + s * 5) % 5) / 40              // 0 .. 0.1
    let slots: [3]vec4 = [GMX_SLOT0, GMX_SLOT1, GMX_SLOT2]
    var mid: vec3
    for j in 0..3 {
        let p = gfx_w(s, slots[j])
        if j == 1 { mid = p }
        gfx_glow(vec3(p.x, p.y, -1.0), 1.3, 1.5, col_scale(col, k * (0.85 + flick)))
    }
    if vt >= 0 { return }
    // heat haze over the shroud from 45, smoke from 60, a wisp of steam a frame from 85
    if h >= 45 {
        let a = fixed(h - 45) / 55
        let wob = frame_wave(gfx_frame + s * 7, 9)
        gfx_psp(&FXP_SMOKE0[0], vec3(mid.x + wob * 0.3, mid.y + 1.2, -1.0), 2.2, 0.8, col_scale(0x182018, a), false)
    }
    if live && h >= 60 && f.ticks % 7 == s {
        let sm = fx_spawn(Pre.Smoke, mid.x + gfx_sf() * 0.8, mid.y + 0.6, gfx_sf() / 60, 0.05)
        sm.s0 = 0.8
        sm.s1 = 3.0
        sm.dt = 1.0 / 30
    }
    if live && h >= 85 {
        let p = gfx_w(s, slots[(f.ticks % 3) as s32])
        gfx_steam(p.x, p.y + 0.4, gfx_sf() / 40, 0.07, 1.6, 14)
        gfx_seen[GFXS_STEAM] += 1
    }
}

// The vent, frame vt of its 50: the blast of steam both ways along the barrel, the lamp
// flickering out, the hatch flaring, then a column of steam rising and thinning.
private fn gfx_vent(f: *Fight, s: s32, root: mat4, live: bool) {
    let fi = &f.f[s]
    let vt = gfx_vent_t[s]
    gfx_seen[GFXS_VENT] += 1
    let m = gfx_wm[s]
    let mid = (m * GMX_SLOT1) as vec3
    let ax = (m * GMX_AXIS) as vec3
    if vt < 9 {
        // the blast: jets out of the shroud both ways along the barrel
        let k = 1.0 - fixed(vt) / 12
        for j in 0..2 {
            let sg = 1.0 - fixed(j) * 2.0
            let p = vec3(mid.x + ax.x * sg * 2.4, mid.y + ax.y * sg * 2.4 + 0.3, -1.1)
            gfx_psp(&FXP_JET[0], p, 4.8 + fixed(vt) * 0.4, 0.5, col_scale(0xD0D0D0, k), ax.x * sg < 0.0)
        }
        gfx_glow(vec3(mid.x, mid.y, -1.1), 4.0, 0.8, col_scale(GMX_WHITE, k * 0.6))
        if live {
            for j in 0..2 {
                let sg = 1.0 - fixed(j) * 2.0
                gfx_steam(mid.x + ax.x * sg * 1.0, mid.y, ax.x * sg * 0.3 + gfx_sf() / 30, ax.y * sg * 0.3 + 0.03, 5.0, 22)
            }
        }
    } else if live && vt % if_s32(vt < 30, 2, 4) == 0 {
        // the column rising and thinning
        let k = 1.0 - fixed(vt - 9) / 41
        gfx_steam(mid.x + gfx_sf() * 0.6, mid.y + 0.8, gfx_sf() / 50, 0.12 + k * 0.06, 3.0 + k * 3.0, 30)
    }
    // the lamp flickering out over its first 16 frames
    if vt < 16 && ((gfx_frame + vt) % 3 != 0 || vt < 3) {
        let lp = (m * GMX_LENS) as vec3
        let k = 1.0 - fixed(vt) / 16
        gfx_glow(vec3(lp.x, lp.y, -1.0), 2.4 * k, 1.0, col_scale(GMX_GLOW, k))
    }
    // the hatch flaring
    if vt < 24 {
        let hp = gfx_pt_of(fi, root, Part.torso, GMX_HATCH)
        let k = 1.0 - fixed(vt) / 24
        gfx_glow(vec3(hp.x, hp.y, -1.4), 2.5 + k * 2.0, 1.0, col_scale(GMX_CORE, k))
        if live && vt % 3 == 0 { gfx_steam(hp.x, hp.y, -fixed(fi.facing) * 0.04, 0.06, 2.6, 18) }
    }
}

// The ray of side s, its box b: from the lens to its end (a body, or the box's far end).
private fn gfx_ray_draw(f: *Fight, s: s32, root: mat4, b: vec4, tick: bool, live: bool) {
    let fi = &f.f[s]
    let dir = fixed(fi.facing)
    let lens = gfx_w(s, GMX_LENS)
    var hit = -1
    let end = gfx_ray_end(s, b, &hit)
    let y = clamp(lens.y, b.y, b.w)
    let x0 = lens.x
    if tick {
        gfx_ray_t[s] += 1
        gfx_end[s] = end
        gfx_ray_y[s] = y
    }
    gfx_seen[GFXS_RAY] += 1
    let rt = max(fx[s].ray_t, gfx_ray_t[s])
    let tk = (rt - 1) % 6                           // frames since the last tick
    var flare = 0.0
    if tk < 2 { flare = 0.4 - fixed(tk) * 0.2 }
    let heat = fixed(clamp(fi.heat, 0, 100)) / 100
    var dim = 1.0
    if fx[s].pause > 0 { dim = 0.5 }                // a Parry froze it
    // the beam: its middle line projected once (the lens, where the taper starts, the end), each
    // band's edges offset from it on the screen; the halo, its edge flickering, then the core
    let len = abs(end - x0)
    var xm = end
    if hit < 0 && len > 1.4 { xm = end - dir * 1.4 }
    let pa = vec3(x0, y, -0.8)
    let pb = vec3(xm, y, -0.8)
    let qa = project_point(pa)
    let qb = project_point(pb)
    let qc = project_point(vec3(end, y, -0.8))
    if qa.z >= 0 && qb.z >= 0 && qc.z >= 0 {
        let ka = fixed(fx_px(pa, 8.0)) / 8                 // pixels a metre at each end
        let kb = fixed(fx_px(pb, 8.0)) / 8
        let wob = gfx_sf() * 0.12
        gfx_band(qa, qb, qc, ka, kb, 1.0 + wob + flare * 0.6, col_scale(GMX_HALO, (0.5 + flare) * dim))
        gfx_band(qa, qb, qc, ka, kb, 0.3 + flare * 0.15, col_scale(0xF0FFF8, (0.95 + flare / 2) * dim))
        // streaks running outward along it
        if len > 2.0 {
            for j in 0..2 {
                let u = fixed((gfx_frame * 9 + j * 50) % 100) / 100
                let sx = qa.x + ((qc.x - qa.x) as fixed * u) as s32
                let sy = qa.y + ((qc.y - qa.y) as fixed * u) as s32 + ((gfx_sf() * 0.25 * ka) as s32)
                let px = (ka + (kb - ka) * u) as s32
                fx_sprite(&FX_STREAK[0], sx, sy, (if_fixed(dir > 0.0, 3.2, -3.2) * fixed(px)) as s32, max(px / 3, 1),
                          col_scale(GMX_CORE, 1.0 - u * 0.6), BLEND_ADD)
            }
        }
    }
    // the lamp, brighter with the heat
    let lp = vec3(lens.x, lens.y, -1.0)
    gfx_glow(lp, 2.6 + heat * 1.6 + flare * 2.0, 1.0, col_scale(GMX_GLOW, 0.7 + heat * 0.3))
    gfx_glow(lp, 1.2 + heat * 0.8, 1.0, col_scale(GMX_CORE, 0.8 + heat * 0.2))
    gfx_psp(&FXP_FLARE[0], lp, 3.0 + heat * 3.0 + flare * 4.0, 0.5, col_scale(GMX_CORE, 0.6 + heat * 0.4), false)
    // burning motes falling off
    if live && f.ticks % 3 == 0 && len > 3.0 {
        let mx = x0 + dir * (1.0 + gfx_f() * (len - 1.0))
        let p = gfx_mote(mx, y + gfx_sf() * 0.5, dir * 0.02, -0.02, 22, GMX_GLOW, 0x0830A0)
        p.grav = 0.006
    }
    if hit < 0 { return }
    // the contact
    gfx_seen[GFXS_CONTACT] += 1
    let o = &f.f[hit]
    let cp = vec3(end, y, -1.0)
    let pulse = fixed((gfx_frame * 7 + s) % 5) / 10                   // 0 .. 0.4
    gfx_glow(cp, 2.6 + pulse + flare * 3.0, 1.0, col_scale(GMX_GLOW, 0.9 * dim))
    let q = project_point(cp)
    if q.z >= 0 {
        let px = fx_px(cp, 1.0)
        let d = (fixed(px) * (1.6 + pulse + flare * 2)) as s32
        fx_sprite(&FX_SPARK[0], q.x, q.y, if_s32((gfx_frame & 2) != 0, d, -d), d, col_scale(GMX_CORE, dim), BLEND_ADD)
    }
    let back = if_s32(dir > 0.0, 16, 0)
    if gfx_braced(hit) {
        // lead stops the ray: it splashes off the plate, up and down
        gfx_seen[GFXS_LEADRAY] += 1
        if live && f.ticks % 2 == 0 {
            fx_c0 = 0xE0F0E0
            fx_c1 = 0x305030
            fx_spray(Pre.ShieldSpark, 2, end, y, if_s32((f.ticks & 2) != 0, 8, 24), 2, 0.3)
        }
    } else if o.mech == Mech.Seraph && seraph_warding(hit) {
        // held off by the ward: gold and green sparks deflected up and down its face
        gfx_seen[GFXS_WARDRAY] += 1
        gfx_glow(cp, 3.4, 0.6, col_scale(0x60D0FF, 0.6))
        if live && f.ticks % 2 == 0 {
            if (f.ticks & 2) != 0 {
                fx_c0 = 0xC0F0FF
                fx_c1 = 0x2070A0
                fx_spray(Pre.ShieldSpark, 2, end, y, back + if_s32(back == 0, 5, -5), 2, 0.32)
            } else {
                fx_c0 = GMX_CORE
                fx_c1 = 0x10A020
                fx_spray(Pre.ShieldSpark, 2, end, y, back + if_s32(back == 0, -5, 5), 2, 0.32)
            }
        }
    } else {
        if o.mv == Mv.block {
            gfx_seen[GFXS_BLOCKED] += 1
            if tick && tk == 0 {
                let h = fx_burst_at(Pre.Shield, end, y, 0xF0FFE0, 0x208030)
                h.s0 = 4.0
                h.s1 = 4.6
                h.dt = 1.0 / 6
            }
        }
        if live && f.ticks % 2 == 0 {
            fx_c0 = GMX_CORE
            fx_c1 = 0x10A020
            fx_spray(Pre.Spark, 2, end, y, back, 6, 0.3)
        }
        if tick && tk == 0 {
            let bu = fx_burst_at(Pre.Burst, end, y, GMX_CORE, GMX_GLOW)
            bu.s0 = 2.4
            bu.s1 = 3.0
        }
    }
}

// A band of light along the beam's middle line (qa at the lens, qb where the taper starts, qc
// the end; ka, kb pixels a metre at qa and qb), half metres thick: col along its middle, nothing
// at its edges; from qb to qc fading to nothing (qb at qc: cut off sharp, at a body).
private fn gfx_band(qa: ivec4, qb: ivec4, qc: ivec4, ka: fixed, kb: fixed, half: fixed, col: u32) {
    let ha = (ka * half) as s32
    let hb = (kb * half) as s32
    tri_grad(qa.x, qa.y - ha, qb.x, qb.y - hb, qa.x, qa.y, 0, 0, col, BLEND_ADD)
    tri_grad(qb.x, qb.y - hb, qb.x, qb.y, qa.x, qa.y, 0, col, col, BLEND_ADD)
    tri_grad(qa.x, qa.y, qb.x, qb.y, qa.x, qa.y + ha, col, col, 0, BLEND_ADD)
    tri_grad(qb.x, qb.y, qb.x, qb.y + hb, qa.x, qa.y + ha, col, 0, 0, BLEND_ADD)
    if qb.x == qc.x { return }
    // the taper: from the middle's colour to nothing at the far end
    tri_grad(qb.x, qb.y - hb, qc.x, qc.y, qb.x, qb.y, 0, 0, col, BLEND_ADD)
    tri_grad(qb.x, qb.y, qc.x, qc.y, qb.x, qb.y + hb, col, 0, 0, BLEND_ADD)
}

// The Glare Lance's cone: from the lens over its hit box, white, fading out at 10 m from the lens.
private fn gfx_cone(lp: vec3, hb: vec4, dir: fixed, k: fixed) {
    let far = lp.x + dir * 10.0
    let h = max((hb.w - hb.y) / 2 + 0.6, 1.0)
    let cy = (hb.y + hb.w) / 2
    let a = project_point(lp)
    let b = project_point(vec3(far, cy + h, -0.8))
    let c = project_point(vec3(far, cy - h, -0.8))
    let m = project_point(vec3(lp.x + dir * 6.0, cy, -0.8))
    if a.z < 0 || b.z < 0 || c.z < 0 || m.z < 0 { return }
    let w = col_scale(0xFFFFFF, k)
    let e = col_scale(0x80A890, k)
    tri_grad(a.x, a.y, b.x, b.y, m.x, m.y, w, 0, e, BLEND_ADD)
    tri_grad(a.x, a.y, m.x, m.y, c.x, c.y, w, e, 0, BLEND_ADD)
    tri_grad(m.x, m.y, b.x, b.y, c.x, c.y, e, 0, 0, BLEND_ADD)
}

// The Geiger Flare's fan: white light from the lens along ax, 30 degrees each side, 10 m long,
// k its brightness.
private fn gfx_fan(lp: vec3, ax: vec3, k: fixed) {
    let len = 10.0
    let c = 0.866                                    // cos 30, sin 30: the fan's edges
    let sn = 0.5
    let ex = vec3(lp.x + (ax.x * c - ax.y * sn) * len, lp.y + (ax.x * sn + ax.y * c) * len, -0.8)
    let fx2 = vec3(lp.x + (ax.x * c + ax.y * sn) * len, lp.y + (-ax.x * sn + ax.y * c) * len, -0.8)
    let mid = vec3(lp.x + ax.x * len * 0.75, lp.y + ax.y * len * 0.75, -0.8)
    let a = project_point(lp)
    let b = project_point(ex)
    let d = project_point(fx2)
    let m = project_point(mid)
    if a.z < 0 || b.z < 0 || d.z < 0 || m.z < 0 { return }
    let w = col_scale(0xF0FFF8, 0.85 * k)
    let g = col_scale(0x50A060, k)
    tri_grad(a.x, a.y, b.x, b.y, m.x, m.y, w, 0, g, BLEND_ADD)
    tri_grad(a.x, a.y, m.x, m.y, d.x, d.y, w, g, 0, BLEND_ADD)
    tri_grad(m.x, m.y, b.x, b.y, d.x, d.y, g, 0, 0, BLEND_ADD)
    gfx_glow(vec3(lp.x, lp.y, -1.0), 3.0 + k * 2.0, 1.0, col_scale(GMX_WHITE, k))
}

// The daze on body i: trefoils and spots swimming round the head, the chest's flickering glow and
// static, green ticks crackling off it; in the air, the drop's streak.
private fn gfx_daze(f: *Fight, i: s32, tick: bool) {
    let fi = &f.f[i]
    let root = anim_place(vec2(fi.x, fi.y), fi.facing)
    let tor = gfx_pt_of(fi, root, Part.torso, vec4(0.0, 2.0, -1.0, 1.0))
    if fx[i].daze_drop > 0 && !fx[i].dazed {
        // the drop: a green streak along it, above the body
        let q0 = project_point(vec3(tor.x, tor.y + 1.0, -1.0))
        let q1 = project_point(vec3(tor.x, tor.y + 6.0, -1.0))
        if q0.z >= 0 && q1.z >= 0 {
            line_ex(q0.x, q0.y, q1.x, q1.y, 3, GMX_GLOW, 0, BLEND_ADD)
            line_ex(q0.x, q0.y, q1.x, q1.y, 1, GMX_CORE, 0, BLEND_ADD)
        }
        gfx_glow(vec3(tor.x, tor.y, -1.2), 3.0, 1.0, col_scale(GMX_GLOW, 0.5))
        gfx_seen[GFXS_DROP] += 1
        return
    }
    if !(fi.mv == Mv.hit_high || fi.mv == Mv.hit_low) { return }
    gfx_seen[GFXS_DAZE] += 1
    let hd = gfx_pt_of(fi, root, Part.head, vec4(0.0, 0.6, 0.0, 1.0))
    let hp = vec3(hd.x, hd.y + 1.0, -1.4)
    let a0 = frame_angle(gfx_frame + i * 11, 0.12)
    for j in 0..5 {
        let a = a0 + fixed(j) * TAU / 5
        let cx = cos(a)
        let sy = sin(a)
        let p = vec3(hp.x + cx * 1.7, hp.y + sy * 0.45, -1.4)
        var k = 0.55
        if sy < 0.0 { k = 1.0 }                     // the near side, brighter
        if j % 2 == 0 {
            gfx_psp(&FXP_TREFOIL[0], p, 1.1, 1.0, col_scale(GMX_GLOW, k), false)
        } else {
            gfx_glow(p, 0.8, 1.0, col_scale(GMX_CORE, k))
        }
    }
    // the chest: a Geiger count, flickering
    let r = (gfx_u() >> 24) as s32
    var c = 0.35
    if r < 90 { c = 0.9 }
    gfx_glow(vec3(tor.x, tor.y, -1.4), 3.4, 0.9, col_scale(GMX_GLOW, c))
    if (gfx_frame & 1) == 0 {
        gfx_psp(&FXP_STATIC0[0], vec3(tor.x, tor.y, -1.5), 3.2, 1.0, col_scale(GMX_CORE, c), (gfx_frame & 2) != 0)
    } else {
        gfx_psp(&FXP_STATIC1[0], vec3(tor.x, tor.y, -1.5), 3.2, 1.0, col_scale(GMX_CORE, c), (gfx_frame & 4) != 0)
    }
    if tick && f.freeze <= 0 && (gfx_u() & 3) == 0 {
        fx_c0 = GMX_CORE
        fx_c1 = 0x108020
        fx_spray(Pre.ShieldSpark, 2, tor.x + gfx_sf() * 1.5, tor.y + gfx_sf() * 3.0, (gfx_u() & 31) as s32, 4, 0.16)
    }
}

// Ground Zero, side s: the hatch flaring through the flash, the blast when its box comes out.
private fn gfx_ground_zero(f: *Fight, s: s32, root: mat4, has_box: bool, tick: bool) {
    let fi = &f.f[s]
    if fi.mv != Mv.super {
        if gfx_gz_t[s] >= 0 && tick { gfx_gz_t[s] += 1 }
        if gfx_gz_t[s] >= GFX_GZ_LEN + 12 { gfx_gz_t[s] = -1 }
        return
    }
    let hp = gfx_pt_of(fi, root, Part.torso, GMX_HATCH)
    let hq = vec3(hp.x, hp.y, -1.6)
    if f.flash_side == s && f.freeze > 0 {
        // the flash: the hatch flaring white-green, swelling
        let k = clamp(fixed(fx[s].t) / 30, 0.0, 1.0)
        let pulse = (frame_wave(gfx_frame, 10) + 1.0) / 2
        gfx_glow(hq, 2.0 + k * 3.0 + pulse, 1.0, col_scale(clerp(GMX_GLOW, GMX_WHITE, k), 0.8 + pulse * 0.2))
        gfx_psp(&FXP_TREFOIL[0], hq, 1.6 + k * 1.4, 1.0, col_scale(GMX_WHITE, 0.5 + k * 0.5), false)
        gfx_seen[GFXS_HATCH] += 1
    }
    if has_box && gfx_gz_t[s] < 0 && tick {
        // the blast comes out
        gfx_gz_t[s] = 0
        gfx_gz_x[s] = fi.x
        let lp = gfx_w(s, GMX_LENS)
        let ix = lp.x
        fx_flash_start(5)
        let fl = fx_burst_at(Pre.Flare, ix, 0.8, GMX_WHITE, GMX_GLOW)
        fl.s0 = 18.0
        fl.s1 = 10.0
        fl.dt = 1.0 / 10
        let r = fx_burst_at(Pre.Floor, fi.x, 0.05, GMX_GLOW, GMX_DEEP)
        r.s0 = 2.0
        r.s1 = 16.0
        r.dt = 1.0 / 12
        let r2 = fx_burst_at(Pre.Floor, fi.x, 0.05, GMX_WHITE, 0x204020)
        r2.s0 = 1.0
        r2.s1 = 20.0
        r2.dt = 1.0 / 18
        let r3 = fx_burst_at(Pre.Ring, fi.x, 5.0, GMX_CORE, GMX_DEEP)
        r3.s0 = 4.0
        r3.s1 = 22.0
        r3.dt = 1.0 / 14
        for k in 0..8 {
            var sd = 1.0
            if (k & 1) != 0 { sd = -1.0 }
            let p = fx_spawn(Pre.Dust, fi.x + sd * (0.8 + gfx_f() * 2.0), 0.5 + gfx_f(), sd * (0.32 + gfx_f() * 0.12), gfx_f() / 30)
            p.s1 = 9.0
        }
        fx_spray(Pre.Pebble, 6, ix, 0.5, 8, 6, 0.42)
        fx_c0 = GMX_CORE
        fx_c1 = 0x10A020
        fx_spray(Pre.Spark, 6, ix, 0.6, 8, 7, 0.45)
        gfx_seen[GFXS_GZ] += 1
    }
    if gfx_gz_t[s] >= 0 {
        let t = gfx_gz_t[s]
        if t < GFX_GZ_LEN {
            // the dome, 8 m in radius, grown in 3 frames; then fading
            let g = min(fixed(t + 1) / 3, 1.0)
            var k = 1.0
            if t >= 8 { k = 1.0 - fixed(t - 8) / (GFX_GZ_LEN - 8) }
            let rr = 8.0 * g
            let x = gfx_gz_x[s]
            gfx_psp(&FXP_DOME[0], vec3(x, rr / 2, -0.4), rr * 2, 0.5, col_scale(GMX_GLOW, k), false)
            gfx_glow(vec3(x, rr * 0.35, -0.5), rr * 1.4, 0.9, col_scale(0x205028, k))
            gfx_glow(vec3(x, 1.0, -0.6), 4.0 * k + 1.0, 1.6, col_scale(GMX_WHITE, k))
            // the reactor flaring white
            gfx_glow(hq, 3.5 * k + 1.0, 1.0, col_scale(GMX_WHITE, k))
            gfx_seen[GFXS_DOME] += 1
        }
        if tick { gfx_gz_t[s] += 1 }
    }
}

// The rods: a side's rod passing through the other side's shot (a spark where they cross), and
// where it ends against an armoured body (it pierced: a flare, shards, a ring).
private fn gfx_rods(f: *Fight, s: s32) {
    let sh = &f.shot[s]
    let o = &f.shot[1 - s]
    let rod = sh.on && sh.pierce
    if rod {
        let y = (sh.y0 + sh.y1) / 2
        if !gfx_rod_on[s] { gfx_rod_by[s] = false }
        // through the other's shot: crossed it since last tick (or touching it now)
        if gfx_rod_on[s] && !gfx_rod_by[s] && (o.on || gfx_shot_on[1 - s]) {
            let ox = if_fixed(o.on, o.x, gfx_shot_x[1 - s])
            let d0 = gfx_rod_x[s] - ox
            let d1 = sh.x - ox
            if (d0 > 0.0) != (d1 > 0.0) || abs(d1) < sh.half + gfx_shot_half[1 - s] {
                gfx_rod_by[s] = true
                let st = fx_burst_at(Pre.Star, ox, y, GMX_WHITE, GMX_ORANGE)
                st.s0 = 5.0
                let r = fx_burst_at(Pre.Ring, ox, y, 0x60C0FF, 0x102040)
                r.s1 = 4.0
                fx_c0 = 0xA0E0FF
                fx_c1 = 0x0840C0
                fx_spray(Pre.Spark, 5, ox, y, 8, 16, 0.24)
                gfx_seen[GFXS_PASS] += 1
            }
        }
        gfx_rod_x[s] = sh.x
        gfx_rod_y[s] = y
    } else if gfx_rod_on[s] {
        // it ended: against an armoured body, it pierced
        for k in 0..2 {
            let j = (1 - s) + k * 2
            if k == 1 && !twins_on(1 - s) { continue }
            if !gfx_armd[j] { continue }
            let b = &f.f[j]
            if abs(b.x - gfx_rod_x[s]) > 6.5 { continue }
            let x = gfx_rod_x[s]
            let y = gfx_rod_y[s]
            let dir = if_s32(gfx_rod_x[s] < b.x, 1, -1)
            let fl = fx_burst_at(Pre.Flare, x, y, GMX_WHITE, GMX_ORANGE)
            fl.s0 = 12.0
            fl.s1 = 6.0
            let r = fx_burst_at(Pre.Ring, x, y, GMX_YELLOW, 0x102060)
            r.s0 = 1.5
            r.s1 = 8.0
            fx_c0 = 0x406A4C
            if b.mech != Mech.Gamma { fx_c0 = 0x9C9690 }
            fx_c1 = fx_c0
            fx_spray(Pre.Shard, 3, x, y, if_s32(dir > 0, 2, 14), 4, 0.34)
            fx_c0 = 0xA0E0FF
            fx_c1 = 0x0840C0
            fx_spray(Pre.Spark, 10, x, y, if_s32(dir > 0, 0, 16), 3, 0.55)
            gfx_seen[GFXS_PIERCE] += 1
            break
        }
    }
    gfx_rod_on[s] = rod
}

// ---- the colour offset: the stage tinted toward green-white from Ground Zero's flash to its
// blast's end, fading over the next 12 frames (after fx_offset)

fn gamma_fx_offset(f: *Fight) {
    gfx_tint = 0
    if !gfx_on { return }
    if fx_flash > 0 { return }
    for s in 0..2 {
        let fi = &f.f[s]
        if fi.mech != Mech.Gamma { continue }
        var k = 0
        if fi.mv == Mv.super && (gfx_gz_t[s] < 0 || gfx_gz_t[s] < 8) {
            k = 256
        } else if gfx_gz_t[s] >= 8 && gfx_gz_t[s] < 20 {
            k = 256 * (20 - gfx_gz_t[s]) / 12
        }
        if k <= 0 { continue }
        layer_offset(stage_now().art.dark, 4 * k >> 8, 9 * k >> 8, 5 * k >> 8)     // BG1, BG2 and the backdrop
        gfx_tint = k
        return
    }
}

// ---- the HUD (hud.akr's hud_draw calls it after each side's meter, the Siphon and the mark)

fn gamma_heat_hud(f: *Fight, s: s32) {
    gfx_hud_bar[s] = -1
    gfx_hud_label[s] = 0
    let fi = &f.f[s]
    if fi.mech != Mech.Gamma { return }
    let x0 = meter_x(s)
    let w = HUD_METER_W
    let l = w - HUD_SLANT
    let y = HUD_METER_Y + HUD_METER_H + 5
    let h = clamp(fi.heat, 0, 100)
    let n = h * l / 100
    let venting = gfx_vent_t[s] >= 0
    var col: u32 = 0x40D050
    if venting {
        col = GMX_WHITE
    } else if h >= 85 {
        if (hud_tick >> 2) & 1 == 0 { col = 0x2020F0 } else { col = 0x8080FF }
    } else if h >= 60 {
        col = 0x10A8F0
    }
    span_quad(s, x0, w, y, 2, 0, l, 0x082008, 0x041004, BLEND_HALF)
    span_quad(s, x0, w, y, 2, 0, n, col, col, BLEND_NONE)
    gfx_hud_bar[s] = n
    gfx_hud_col[s] = col
    var lx = x0 + w + 4
    var al = ALIGN_LEFT
    if s == 1 {
        lx = x0 - 4
        al = ALIGN_RIGHT
    }
    if venting {
        gfx_hud_label[s] = 2
        txt(FONT_MICRO, lx, y - 3, "VENT", GMX_WHITE, al)
    } else if h >= 85 && (hud_tick >> 3) & 1 == 0 {
        gfx_hud_label[s] = 1
        txt(FONT_MICRO, lx, y - 3, "HEAT", 0x4040FF, al)
    }
}

// ---- the sounds that follow Gamma's state (game.akr's sound_poll, once a fight frame): the ray
// coming on, its hum (rising with the heat) and going off (or cut by a strong shot: a Parry's cut
// is game.akr's sound_event's), the heat's warning, the shield clanging into place, Point Blank's
// lamp, the daze's count.

var gsx_ray: [2]bool                    // the ray last frame
var gsx_vent_seen: [2]bool
var gsx_pmv: [2]Mv
var gsx_pt: [2]s32
var gsx_shot_on: [2]bool                // the other side's shot last frame
var gsx_shot_str: [2]s32

fn gamma_sfx(f: *Fight) {
    if !(f.f[0].mech == Mech.Gamma || f.f[1].mech == Mech.Gamma) { return }
    let ev = fight_events()
    for s in 0..2 {
        let fi = &f.f[s]
        if fi.mech != Mech.Gamma {
            gsx_ray[s] = false
            continue
        }
        // the other's super flash freezes the world, the hum with it
        let frozen = f.freeze > 0 && f.flash_side >= 0 && f.flash_side != s
        var vented = false
        for k in 0..ev.n {
            if ev.e[k].kind == Ev.Vent && ev.e[k].side == s { vented = true }
        }
        var rb: vec4
        let ray = gamma_ray(s, &rb)
        if ray && !gsx_ray[s] {
            sfx_pan(fi.x)
            sfx_gamma(GSX_RAY_ON)
        }
        if ray && !frozen {
            let heat = fixed(clamp(fi.heat, 0, 100))
            sfx_hold(s, SFX_RAY, 5, fi.x, 0.9 + heat / 200, 230)
            if fi.heat > 85 { sfx_hold(2 + s, SFX_HEAT, 5, fi.x, 1.0 + (heat - 85.0) / 30, 200) }
        }
        if !ray && gsx_ray[s] && !vented {
            sfx_pan(fi.x)
            let o = 1 - s
            if gsx_shot_on[o] && gsx_shot_str[o] >= 2 {
                sfx_gamma(GSX_CUT)
            } else if !is_hurt(fi.mv) {
                sfx_gamma(GSX_RAY_OFF)
            }
        }
        gsx_ray[s] = ray
        gsx_shot_on[1 - s] = f.shot[1 - s].on
        gsx_shot_str[1 - s] = f.shot[1 - s].str
        // Lead Shielding: the shield swung out, clanging into place on frame 5
        if fi.mv == Mv.sp_d && fx[s].t >= 4 && (gsx_pmv[s] != Mv.sp_d || gsx_pt[s] < 4) {
            sfx_pan(fi.x)
            sfx_gamma(GSX_SHIELD)
        }
        // Point Blank: the lamp's hum on the other's chest
        if fi.mv == Mv.throw && fx[s].t >= 5 && fx[s].t < 30 && is_thrown(f.f[vic[s]].mv) && !frozen {
            sfx_hold(s, SFX_RAY, 5, fi.x, 1.25, 256)
        }
        gsx_pmv[s] = fi.mv
        gsx_pt[s] = fx[s].t
    }
    // the daze: the Geiger count while a mech is dazed by a Gamma's flare (slot 4 + Gamma's side)
    for i in 0..4 {
        if i >= 2 && !twins_on(i - 2) { continue }
        if !fx[i].dazed { continue }
        let g = 1 - (i & 1)
        if f.f[g].mech != Mech.Gamma { continue }
        sfx_hold(4 + g, SFX_DAZE, 4, f.f[i].x, 1.0, 190)
    }
}
