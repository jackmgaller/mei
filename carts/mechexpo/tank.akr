    MoveEntry { name: "Block", input: "hold R" },
    MoveEntry { name: "Jump", input: "X (+ FWD or BACK)" },
    MoveEntry { name: "Chain", input: "A, FWD + A, DOWN + B" },
    MoveEntry { name: "Nuclear meter", input: "fills as Tank takes damage" },
    MoveEntry {}
] }
