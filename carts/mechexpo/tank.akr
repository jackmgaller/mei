    MoveEntry { name: "Body Drop", input: "A in the air" },
    MoveEntry { name: "Reactor Vent", input: "B (armour)" },
    MoveEntry { name: "Atomic Clinch", input: "FWD + B (command grab)" },
    MoveEntry { name: "Smokestack Uppercut", input: "UP + B (armour)" },
    MoveEntry { name: "Bulldozer", input: "DOWN + B" },
    MoveEntry { name: "Scrap Heave", input: "Y" },
    MoveEntry { name: "Break a grab", input: "Y when grabbed" },
