// Copies the textures, the swatch and the palettes into VRAM.
fn mx_pack_load() {
    memcpy((VRAM_TEXTURES + 0 * TEXTURE_SLOT_SIZE + 0) as *u8, MX_PACK_TEX0, 20608)
    load_palette(336, &MX_PACK_TEXPAL[0], 80)
    memcpy((VRAM_TEXTURES + 0 * TEXTURE_SLOT_SIZE) as *u8, MX_PACK_SWATCH, 8)
