embed MX_PACK_TEX0: u8 = "art/mx_pack.slot0.tex"
embed MX_PACK_TEX1: u8 = "art/mx_pack.slot1.tex"
embed MX_PACK_TEXPAL: u16 = "art/mx_pack.tpal"
embed MX_PACK_PALETTE: u16 = "art/mx_pack.pal"
embed MX_PACK_SWATCH: u8 = "art/mx_pack.swatch"

// Copies the textures, the swatch and the palettes into VRAM.
fn mx_pack_load() {
    memcpy((VRAM_TEXTURES + 0 * TEXTURE_SLOT_SIZE + 0) as *u8, MX_PACK_TEX0, 29824)
    memcpy((VRAM_TEXTURES + 1 * TEXTURE_SLOT_SIZE + 0) as *u8, MX_PACK_TEX1, 8320)
    load_palette(752, &MX_PACK_TEXPAL[0], 128)
    memcpy((VRAM_TEXTURES + 0 * TEXTURE_SLOT_SIZE) as *u8, MX_PACK_SWATCH, 8)
    load_palette(0, &MX_PACK_PALETTE[0], 16)
    load_palette(16, &MX_PACK_PALETTE[16], 16)
    load_palette(32, &MX_PACK_PALETTE[32], 16)
    load_palette(48, &MX_PACK_PALETTE[48], 16)
    load_palette(64, &MX_PACK_PALETTE[64], 16)
    load_palette(80, &MX_PACK_PALETTE[80], 16)
    load_palette(96, &MX_PACK_PALETTE[96], 16)
    load_palette(112, &MX_PACK_PALETTE[112], 16)
    load_palette(128, &MX_PACK_PALETTE[128], 16)
    load_palette(144, &MX_PACK_PALETTE[144], 16)
    load_palette(160, &MX_PACK_PALETTE[160], 16)
    load_palette(176, &MX_PACK_PALETTE[176], 16)
    load_palette(192, &MX_PACK_PALETTE[192], 16)
    load_palette(208, &MX_PACK_PALETTE[208], 16)
    load_palette(224, &MX_PACK_PALETTE[224], 16)
    load_palette(240, &MX_PACK_PALETTE[240], 16)
    load_palette(256, &MX_PACK_PALETTE[256], 16)
    load_palette(272, &MX_PACK_PALETTE[272], 16)
    load_palette(288, &MX_PACK_PALETTE[288], 16)
    load_palette(304, &MX_PACK_PALETTE[304], 16)
    load_palette(320, &MX_PACK_PALETTE[320], 16)
