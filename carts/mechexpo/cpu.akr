// Mech Expo 2000: the CPU and the training dummy (C's). The CPU reads the fight as a player
// would see it (the other mech's move, after a reaction time) and presses the pad; it never
// touches the fight's state. Its dice are its own generator, seeded by fight_init(), so a match
// replays exactly.
//
// Levels: 0 the training dummy's CPU (gentle), 1 the ladder's first fight, 2 the ladder's
// second fight and Versus against the CPU, 3 hard.

import "moves.akr"
import "fighter.akr"
import "fight.akr"

struct CpuLevel {
    react: s32              // frames before it reacts to what the other does
    think: s32              // frames between decisions in neutral
    block: s32              // per cent: blocks an attack it sees coming
    aa: s32                 // anti-airs a jump it sees
    punish: s32             // punishes a whiff it sees
    chain: s32              // continues a chain on contact
    brk: s32                // breaks a grab
    poke: s32               // pokes at its range, per decision
    grab: s32               // grabs a mech that blocks close up
    jump: s32               // jumps in from mid range, per decision
    guard: s32              // holds block a while in the other's range, per decision
    special: s32            // uses its specials in neutral (the Parry, the slide, the wave)
}

const CPU_LEVELS: [4]CpuLevel = [
    CpuLevel { react: 26, think: 14, block: 20, aa: 10, punish: 15, chain: 30, brk: 5, poke: 20, grab: 10, jump: 4, guard: 10, special: 3 },
    CpuLevel { react: 20, think: 11, block: 40, aa: 30, punish: 35, chain: 55, brk: 15, poke: 30, grab: 20, jump: 6, guard: 20, special: 6 },
    CpuLevel { react: 13, think: 8, block: 65, aa: 70, punish: 70, chain: 90, brk: 35, poke: 40, grab: 35, jump: 6, guard: 35, special: 10 },
    CpuLevel { react: 9, think: 6, block: 80, aa: 85, punish: 85, chain: 100, brk: 50, poke: 45, grab: 45, jump: 5, guard: 45, special: 12 },
]

struct Cpu {
    rng: u32
    hold: u32               // directions and R held until hold_t runs out
    hold_t: s32
    think_t: s32
    opp_mv: Mv              // the other's move as last seen, and whether its hit box was out
    opp_t: s32
    opp_active: bool
    decided: bool           // a reaction to the other's current move was already rolled
    punish_rolled: bool     // and the punish of its recovery
    react_block: bool
    chain_roll: bool        // this contact's chain was rolled
    chain_go: bool
    break_roll: bool
    blocks_seen: s32        // the other's recent blocks (grab bait)
    charge_want: s32        // Beam: frames to hold B on the Volt Orb's charge frame (0: a tap)
    mine_x: fixed           // the other's Rift Mine it has a plan for (mine_wary()), and the plan:
    mine_plan: s32          // MP_*, kept for mine_t frames
    mine_t: s32
    shot_seen: bool         // the other's shot on its way was reacted to (once, whatever it holds)
}

var cpu: [2]Cpu
var cpu_tip: [len(Mech)]fixed           // each mech's forward attack's reach, from the data
var cpu_lo0: [len(Mech)]fixed           // its down attack's hit boxes, nearest and furthest
var cpu_lo1: [len(Mech)]fixed           // (with root motion): what it can clear a mine with
var cpu_trav_f: [len(Mech)]fixed        // how far its forward special, down special and
var cpu_trav_d: [len(Mech)]fixed        // forward attack carry it
var cpu_trav_a: [len(Mech)]fixed

fn cpu_init(seed: s32) {
    cpu[0] = Cpu { rng: (seed as u32) * 2654435761 + 1 }
    cpu[1] = Cpu { rng: (seed as u32) * 40503 + 977 }
    // the reaches of the mechs in this fight (fight_init set them; the Twins' split body too)
    for i in 0..2 {
        let m = fight.f[i].mech
        cpu_tip[m] = reach_of(m, Mv.atk_f)
        cpu_moves_of(m)
        if m == Mech.Twins {
            cpu_tip[Mech.TwinA] = reach_of(Mech.TwinA, Mv.atk_f)
            cpu_moves_of(Mech.TwinA)
        }
    }
    if stage_has_open(stage_now()) { cpu_edge_init() }     // mx-stages: the open edge
}

// The furthest a move's hit boxes reach ahead of the root, with its root motion.
private fn reach_of(m: Mech, mv: Mv) -> fixed {
    var bx: Boxes
    var best = 0.0
    var step = 0.0
    let n = mv_len(m, mv)
    for f in 0..n {
        mv_boxes(m, mv, f, &bx)
        for k in 0..bx.n {
            if bx.b[k].kind == BOX_HIT { best = max(best, step + bx.b[k].x1) }
        }
        step += mv_root(m, mv, f).x
    }
    return best
}

// What the mine plans need of a mech's moves (cpu_init()).
private fn cpu_moves_of(m: Mech) {
    var bx: Boxes
    var lo0 = 1000.0
    var lo1 = 0.0
    var step = 0.0
    let n = mv_len(m, Mv.atk_d)
    for f in 0..n {
        mv_boxes(m, Mv.atk_d, f, &bx)
        for k in 0..bx.n {
            if bx.b[k].kind == BOX_HIT && bx.b[k].y0 < MINE_H {
                lo0 = min(lo0, step + bx.b[k].x0)
                lo1 = max(lo1, step + bx.b[k].x1)
            }
        }
        step += mv_root(m, Mv.atk_d, f).x
    }
    cpu_lo0[m] = lo0
    cpu_lo1[m] = lo1
    cpu_trav_f[m] = travel_of(m, Mv.sp_f)
    cpu_trav_d[m] = travel_of(m, Mv.sp_d)
    cpu_trav_a[m] = travel_of(m, Mv.atk_f)
}

// How far a move's root motion carries the mech forward.
private fn travel_of(m: Mech, mv: Mv) -> fixed {
    var d = 0.0
    let n = mv_len(m, mv)
    for f in 0..n { d += max(mv_root(m, mv, f).x, 0.0) }
    return d
}

private fn roll(c: *Cpu, pct: s32) -> bool {
    c.rng = c.rng * 1103515245 + 12345
    let r = ((c.rng >> 16) & 0x7FFF) as s32
    return r % 100 < pct
}

private fn rnd_n(c: *Cpu, n: s32) -> s32 {
    c.rng = c.rng * 1103515245 + 12345
    return ((c.rng >> 16) & 0x7FFF) as s32 % n
}

// The pad bit for a world direction (1: +x).
private fn dir_bit(world: s32) -> u32 {
    if world > 0 { return RIGHT }
    if world < 0 { return LEFT }
    return 0
}

// How far apart the mechs may be for a mech's forward attack to touch the other (its tip,
// plus the other's half width), a little short.
private fn tip(m: Mech) -> fixed { return cpu_tip[m] + 1.0 }

// The buttons the CPU playing side i presses this frame: what it thinks, kept off the other's
// Rift Mine.
fn cpu_pad(i: s32, level: s32) -> u32 {
    let p = cpu_think(i, level)
    if rift[other(i)].on { return mine_wary(i, &CPU_LEVELS[clamp(level, 0, 3)], p) }
    return p
}

private fn cpu_think(i: s32, level: s32) -> u32 {
    let lv = &CPU_LEVELS[clamp(level, 0, 3)]
    let c = &cpu[i]
    let j = other(i)
    let me = &fight.f[i]
    let op = &fight.f[j]
    let fwd = dir_bit(me.facing)
    let back = dir_bit(-me.facing)
    let dist = abs(op.x - me.x)
    if fight.phase != Phase.Fight { return 0 }

    // what the other is doing, as seen
    let ot = fx[j].t
    if op.mv != c.opp_mv || ot < c.opp_t {
        c.opp_mv = op.mv
        c.opp_active = false
        c.decided = false
        c.punish_rolled = false
        if op.mv == Mv.block { c.blocks_seen += 1 }
    }
    c.opp_t = ot
    if fx[j].had_hit { c.opp_active = true }
    let seen = ot >= lv.react
    if !fx[i].contact { c.chain_roll = false }

    // thrown: break, maybe
    if is_thrown(me.mv) {
        if !c.break_roll {
            c.break_roll = true
            if roll(c, lv.brk) { return Y }
        }
        return 0
    }
    c.break_roll = false

    // a chain on contact
    if fx[i].contact && is_attack(me.mv) {
        // on a hit the chain goes on; on a block the special at the end would be blocked too
        // (most are punishable), so it goes on half as often, and never into the super (mx-balance)
        let landed = is_hurt(op.mv)
        if !c.chain_roll {
            c.chain_roll = true
            c.chain_go = roll(c, if_else(landed, lv.chain, lv.chain / 2))
        }
        if c.chain_go && (cur_marks(i) & MARK_CANCEL) != 0 && fx[i].t % 2 == 0 {
            if me.mv == Mv.atk_n {
                if me.mech == Mech.Doubleblade && fx[i].chain == 0 { return A }
                return fwd | A
            }
            if me.mv == Mv.atk_f {
                if landed && super_wise(i) && roll(c, 30) { return A | B }
                if me.mech == Mech.Shadow { return B }                  // Shadow: the Hex Bolt (the curse)
                // not a dash onto the other's mine: the neutral special instead (mx-balance)
                if me.mech == Mech.Tank {
                    if mine_in_path(i, cpu_trav_d[me.body]) { return B }
                    return DOWN | B                                     // Tank: the Bulldozer
                }
                if mine_in_path(i, cpu_trav_f[me.body]) { return B }
                return fwd | B
            }
        }
        return 0
    }
    // Beam charging its orb: B held until the charge it chose
    if me.mech == Mech.Beam && me.mv == Mv.sp_n && c.charge_want > 0 && fx[i].t <= 12 && me.charge < c.charge_want {
        return B
    }
    // the Twins' Fusion Focus: B held for the frames it chose
    if me.mech == Mech.Twins && me.mv == Mv.sp_d && me.body == Mech.Twins && me.charge < c.charge_want { return B }
    // Shadow Sneak: B held while the shadow is still short of the other mech
    if me.mech == Mech.Shadow && me.mv == Mv.sp_f && dist > SH_SNEAK_STOP { return B }
    if !actionable(i) {
        c.hold = 0
        c.hold_t = 0
        // in the air: the air attack on the way down near the other
        if me.mv == Mv.jump && !fx[i].air_used && fx[i].vy < 0.0 && dist < 7.0 && me.y < 7.0 {
            if roll(c, 50) { return A }
        }
        return 0
    }
    // Shadow: a mech its mine snared is punished at once (once seen)
    if me.mech == Mech.Shadow && shadow_snared(j) && snare_t[j] <= SNARE_FRAMES - lv.react / 2 {
        return shadow_snare_punish(i, c, dist, fwd)
    }

    // reactions to the other's move, once it has been seen long enough
    let opp_attacking = is_attack(op.mv) || op.mv == Mv.grab
    let edged = stage_has_open(stage_now())        // a stage with an open edge (mx-stages)
    if edged && seen && !c.decided && edge_behind(i) < CPU_EDGE_DANGER && opp_attacking && !c.opp_active
        && dist < tip(op.body) + 2.0 && op.mv != Mv.grab {
        // at the lip: block what is coming more often (a knockdown there is a ring-out)
        c.decided = true
        if roll(c, min(lv.block + 25, 95)) { return hold(c, R, 24) }
    }
    if seen && !c.decided {
        // a jump coming in
        if (op.mv == Mv.jump || op.mv == Mv.atk_air) && dist < 13.0 {
            c.decided = true
            if roll(c, lv.aa) { return dir_bit(0) | UP | B }
            if roll(c, lv.block) { return hold(c, R, 30) }
        }
        // an attack starting in range
        if opp_attacking && !c.opp_active && dist < tip(op.body) + 2.0 && op.mv != Mv.grab {
            c.decided = true
            if me.mech == Mech.Tank && roll(c, lv.punish / 2) { return tank_armour_through(dist, fwd) }
            if roll(c, lv.block) { return hold(c, R, 24) }
        }
    }
    // a whiff, or a move left unsafe on block: punish the recovery
    if seen && !c.punish_rolled && is_attack(op.mv) && c.opp_active && !fx[j].had_hit && grounded(j) {
        c.punish_rolled = true
        if roll(c, lv.punish) {
            if me.mech == Mech.Tank { return tank_punish(dist, fwd) }
            if me.mech == Mech.Shadow { return shadow_punish(dist, fwd) }
            if super_wise(i) && dist < 12.0 && roll(c, 50) { return A | B }
            if dist < 6.0 { return A }
            if dist < tip(me.body) - 0.5 { return fwd | A }
            if dist < tip(me.body) + 3.0 { return fwd | B }
        }
    }
    // the wave on its way
    let s = &fight.shot[j]
    if s.on && abs(s.x - me.x) < 12.0 && sgn(me.x - s.x) == sgn(s.vx) {
        // (once a shot even while it holds a walk: walking into it was a blind spot, mx-balance)
        if !c.decided || c.hold_t == 0 || !c.shot_seen {
            c.decided = true
            c.shot_seen = true
            if s.y0 > WAVE_H { return shot_above(i, c, lv, s, fwd) }    // an orb or a bolt
            // the wave along the floor: blocked while it is far, jumped only once it is close
            // enough to pass under the jump (mx-balance)
            let tt = ((abs(s.x - me.x) - s.half - STATS[me.body].push) / abs(s.vx)) as s32
            if tt > 24 { return hold(c, R, min(tt - 20, 20)) }
            if me.mech == Mech.Doubleblade && roll(c, lv.aa) { return B }
            if tt >= 8 && roll(c, lv.aa / 2) { return fwd | X }
            return hold(c, R, 20)
        }
    } else {
        c.shot_seen = false
    }

    // keep holding what was decided
    if c.hold_t > 0 {
        c.hold_t -= 1
        return c.hold
    }
    c.think_t -= 1
    if c.think_t > 0 { return c.hold }
    c.think_t = lv.think + rnd_n(c, lv.think)

    if edged {
        let e = cpu_edge(i, c, lv, dist, fwd)
        if e != CPU_NO_IDEA { return e }
    }
    if me.mech == Mech.Beam { return beam_neutral(i, c, lv, dist, fwd, back) }
    if me.mech == Mech.Tank { return tank_neutral(i, c, lv, dist, fwd, back) }
    if me.mech == Mech.Twins { return twins_neutral(i, c, lv, dist, fwd, back) }
    if me.mech == Mech.Shadow { return shadow_neutral(i, c, lv, dist, fwd, back) }
    // neutral: footsies around the tip of its forward attack
    let range = tip(me.body)
    if dist < tip(op.body) + 2.0 && roll(c, lv.guard) { return hold(c, R, 18 + rnd_n(c, 24)) }
    if dist < tip(op.body) + 1.0 && roll(c, lv.special) {
        if me.mech == Mech.Hero { return DOWN | B }             // the Parry, on a read
        return DOWN | B                                         // the slide
    }
    if dist < 5.5 {
        if c.blocks_seen >= 2 && roll(c, lv.grab) { c.blocks_seen = 0; return Y }
        let r = rnd_n(c, 100)
        if r < 30 { return A }
        if r < 40 { return Y }
        if r < 55 { return fwd | A }
        if r < 75 { return hold(c, back, 12) }
        return hold(c, R, 10)
    }
    // the Double-blade Hero outside its reach but inside the Hero's: get in
    if me.mech == Mech.Doubleblade && dist >= range + 0.5 && dist < tip(op.body) + 3.0 {
        let r = rnd_n(c, 100)
        if r < lv.special * 2 { return B }                      // the Void Step past the tip
        if r < lv.special * 3 && dist < 10.5 { return DOWN | B } // the slide under it
        if r < lv.special * 3 + lv.jump * 2 { return fwd | X }
        return hold(c, fwd, 6 + rnd_n(c, 10))
    }
    if dist < range + 0.5 {
        let r = rnd_n(c, 100)
        if r < lv.poke { return fwd | A }
        if r < lv.poke + 10 { return DOWN | A }
        if r < lv.poke + 25 { return hold(c, back, 10) }
        if r < lv.poke + 35 { return hold(c, R, 12) }
        return hold(c, fwd, 8)
    }
    if dist < range + 6.0 && roll(c, lv.jump) { return fwd | X }
    if me.mech == Mech.Hero && dist > 14.0 && !fight.shot[i].on && roll(c, 25) { return B }
    if me.mech == Mech.Doubleblade && dist > 12.0 && roll(c, 12) { return B }
    if super_wise(i) && me.meter >= METER_BAR && dist < 14.0 && roll(c, 3) { return A | B }
    return hold(c, fwd, 10 + rnd_n(c, 20))
}

// Whether spending the super now is wise: always for kinetic; for antimatter only without
// falling deep into debt, unless it would win the round.
private fn super_wise(i: s32) -> bool {
    let me = &fight.f[i]
    if !me.super_ok { return false }
    if meter_power(me.mech) == Power.Kinetic { return true }
    return me.meter >= METER_BAR / 2 || fight.f[other(i)].health <= 320
}

private fn hold(c: *Cpu, pad: u32, n: s32) -> u32 {
    c.hold = pad & (LEFT | RIGHT | UP | DOWN | R)
    c.hold_t = n
    c.think_t = 0
    return pad
}

// The training dummy (side i): what fight_training() set.
fn dummy_pad(i: s32) -> u32 {
    match fight_opts.dummy {
        Stand => return 0
        Crouch => return DOWN
        Jump => {
            if fight.ticks % 2 == 0 { return X }
            return 0
        }
        Block => return R
        Cpu => return cpu_pad(i, 1)
    }
}

// ---- Beam (mx-beam): the zoner in neutral. Orbs at range (charged when far), the Arc Lance at a
// mech walking or jumping in, the prime when it is safe (far, nothing coming), the super from
// anywhere it reaches; up close a jab, a grab or a step back out.

private fn beam_neutral(i: s32, c: *Cpu, lv: *CpuLevel, dist: fixed, fwd: u32, back: u32) -> u32 {
    let me = &fight.f[i]
    let op = &fight.f[other(i)]
    let incoming = fight.shot[other(i)].on
    // the prime while the other is down: the safest moment there is
    let down = op.mv == Mv.knockdown || op.mv == Mv.getup || op.mv == Mv.hit_air
    if down && me.react == 0 && me.meter < METER_BAR && dist > 6.0 && me.curse == 0 && roll(c, lv.special * 6) { return DOWN | B }
    if dist < tip(op.body) + 2.0 && roll(c, lv.guard) { return hold(c, R, 18 + rnd_n(c, 24)) }
    if dist < 5.5 {
        if c.blocks_seen >= 2 && roll(c, lv.grab) { c.blocks_seen = 0; return Y }
        let r = rnd_n(c, 100)
        if r < 35 { return A }
        if r < 45 { return Y }
        if r < 55 { return fwd | A }
        if r < 85 { return hold(c, back, 16) }
        return hold(c, R, 10)
    }
    if dist > 12.0 && me.react == 0 && me.meter < METER_BAR && !incoming && !is_attack(op.mv)
        && me.curse == 0 && roll(c, lv.special * 4) {
        return DOWN | B
    }
    if super_wise(i) && dist < 28.0 && roll(c, 4) { return A | B }
    // the orb from outside the other's poke (its forward attack and its step), or while it is
    // down; inside it the 18-frame startup is a free hit (mx-balance)
    let safe = dist > tip(op.body) + 2.0 || down
    if dist > 7.0 && dist < 15.0 && (op.mv == Mv.walk_f || op.mv == Mv.jump) && roll(c, lv.poke) {
        return fwd | B
    }
    if dist > 8.0 && safe && !fight.shot[i].on && roll(c, 45) {
        c.charge_want = 0
        if dist > 20.0 && roll(c, 40) { c.charge_want = ORB_CHARGE_MAX }
        else if roll(c, 35) { c.charge_want = ORB_CHARGE_HALF + 4 }
        return B
    }
    if dist < tip(me.body) + 0.5 {
        let r = rnd_n(c, 100)
        if r < lv.poke { return fwd | A }
        if r < lv.poke + 10 { return DOWN | A }
        if r < lv.poke + 45 { return hold(c, back, 14) }
        return hold(c, R, 12)
    }
    if dist < 12.0 { return hold(c, back, 10 + rnd_n(c, 14)) }
    if dist > 22.0 { return hold(c, fwd, 8 + rnd_n(c, 10)) }
    return hold(c, 0, 8 + rnd_n(c, 8))
}

// ---- Tank's CPU (mx-tank): close the distance carefully, armour through pokes, clinch a mech
// that blocks, Chain Reaction on a mech standing still or blocking in reach

const TANK_CLINCH_SEP: fixed = 9.5      // the Atomic Clinch reaches a mech this far away
const TANK_CLOSE: fixed = 5.5

// The other is starting an attack: meet it with armour.
private fn tank_armour_through(dist: fixed, fwd: u32) -> u32 {
    if dist < TANK_CLOSE { return B }                   // the Reactor Vent
    return fwd | A                                      // the Piston Haymaker
}

private fn tank_punish(dist: fixed, fwd: u32) -> u32 {
    if dist < 6.0 { return A }
    if dist < 8.5 { return fwd | A }
    return DOWN | B                                     // the Bulldozer
}

private fn tank_neutral(i: s32, c: *Cpu, lv: *CpuLevel, dist: fixed, fwd: u32, back: u32) -> u32 {
    let j = other(i)
    let op = &fight.f[j]
    let standing = grounded(j) && !is_attack(op.mv) && op.mv != Mv.grab
    if super_wise(i) && dist < TANK_CLINCH_SEP - 2.0 && standing && roll(c, 30) { return A | B }
    if dist < TANK_CLOSE {
        if c.blocks_seen >= 1 && roll(c, lv.grab) {
            c.blocks_seen = 0
            if roll(c, 50) { return Y }
            return fwd | B
        }
        let r = rnd_n(c, 100)
        if r < 25 { return A }
        if r < 38 { return Y }
        if r < 48 { return B }
        if r < 58 { return fwd | A }
        if r < 64 { return DOWN | A }
        if r < 82 { return hold(c, R, 10 + rnd_n(c, 10)) }
        return hold(c, back, 8)
    }
    if dist < TANK_CLINCH_SEP {
        if c.blocks_seen >= 1 && standing && roll(c, lv.grab) {
            c.blocks_seen = 0
            return fwd | B
        }
        let r = rnd_n(c, 100)
        if r < lv.poke { return fwd | A }
        if r < lv.poke + lv.special && standing { return fwd | B }
        if r < lv.poke + lv.special + 25 { return hold(c, R, 12 + rnd_n(c, 12)) }
        return hold(c, fwd, 8 + rnd_n(c, 8))
    }
    // far: walk in behind the guard; now and then the Bulldozer from its reach
    if dist < 12.5 && roll(c, lv.special) { return DOWN | B }
    if dist < 16.0 && roll(c, lv.guard / 2) { return hold(c, R, 10) }
    if roll(c, lv.jump) { return fwd | X }
    return hold(c, fwd, 14 + rnd_n(c, 20))
}

// ---- the Twins' CPU (mx-twins-fight): switch forms when it is safe (the other knocked down, or
// far away and not attacking), combined to fill the meter and spend it, split to press a mech
// that is getting up close by; footsies around each form's forward attack, the Low Roll in

private fn twins_neutral(i: s32, c: *Cpu, lv: *CpuLevel, dist: fixed, fwd: u32, back: u32) -> u32 {
    let me = &fight.f[i]
    let j = other(i)
    let op = &fight.f[j]
    let split = me.body == Mech.TwinA
    let down = op.mv == Mv.knockdown || op.mv == Mv.getup || op.mv == Mv.hit_air
    let threat = is_attack(op.mv) || op.mv == Mv.grab || fight.shot[j].on
    // cursed by Shadow: combined, every gain is Shadow's; split, there is nothing to take. So
    // split it stays split until the curse runs out (unless a full bar wants spending), and
    // combined it splits only when that is safe: the other down, or far and not attacking (the
    // switch is open to a hit for its first frames) (mx-balance)
    let cursed = me.curse > 90
    let safe = (down && dist > 5.0) || (dist > 12.0 && !threat)
    if split {
        if !cursed || me.meter >= METER_BAR {
            if down && dist > 5.0 && roll(c, lv.special * 5) { return L }
            if dist > 14.0 && !threat && roll(c, lv.special * 3) { return L }
            if me.meter >= METER_BAR && dist > 9.0 && !threat && roll(c, 25) { return L }
        }
    } else {
        if super_wise(i) && dist < 13.0 && grounded(j) && !down && roll(c, 8) { return A | B }
        if cursed && safe && roll(c, lv.special * 4) { return L }
        if down && dist > 11.0 && me.meter < METER_BAR && me.curse == 0 && roll(c, lv.special * 4) {
            c.charge_want = 20 + rnd_n(c, 30)
            return DOWN | B
        }
        if down && dist < 10.0 && me.meter < METER_BAR / 2 && roll(c, lv.special * 3) { return L }
    }
    let range = tip(me.body)
    if dist < tip(op.body) + 2.0 && roll(c, lv.guard) { return hold(c, R, 16 + rnd_n(c, 20)) }
    if dist < 5.0 {
        if c.blocks_seen >= 2 && roll(c, lv.grab) { c.blocks_seen = 0; return Y }
        let r = rnd_n(c, 100)
        if r < 32 { return A }
        if r < 42 { return Y }
        if r < 55 { return fwd | A }
        if r < 63 { return B }                          // the Pulse Spin or the Binary Lariat
        if r < 80 { return hold(c, back, 12) }
        return hold(c, R, 10)
    }
    if dist < range + 0.5 {
        let r = rnd_n(c, 100)
        if r < lv.poke { return fwd | A }
        if r < lv.poke + 10 { return DOWN | A }
        if r < lv.poke + 25 { return hold(c, back, 10) }
        if r < lv.poke + 35 { return hold(c, R, 12) }
        return hold(c, fwd, 8)
    }
    // split, outside its reach but inside the other's: roll in under it
    if split && dist < tip(op.body) + 3.0 && roll(c, lv.special * 3) { return DOWN | B }
    if dist < range + 6.0 && roll(c, lv.jump) { return fwd | X }
    return hold(c, fwd, 10 + rnd_n(c, 16))
}

// ---- the open edge (mx-stages): on a stage with one (stages.akr), the CPU gets away from the
// lip when it is backed up to it (a knockdown or a throw there is a ring-out), and with the other
// mech backed up to it goes for a knockdown or a throw. Its dice are rolled only on such a
// stage, so the hangar's matches are unchanged.

const CPU_NO_IDEA: u32 = 0xFFFFFFFF
const CPU_EDGE_DANGER: fixed = 7.0     // backed up this close to an open edge: get out
const CPU_EDGE_CHANCE: fixed = 9.0     // the other this close to one: try to ring it out
const CPU_EDGE_ROOM: fixed = 18.0      // the other within this of one: walk it toward it
const CPU_EDGE_BACK: fixed = 11.0      // itself within this of one: walk away from it
var cpu_low: [len(Mech)]fixed          // each mech's down attack's reach, when it knocks down (else 0)

// How far side i's root is from the open edge behind it (the way it faces away from), or 1,000.
fn edge_behind(i: s32) -> fixed {
    let s = stage_now()
    let f = &fight.f[i]
    if f.facing < 0 && stage_open(s, 1) { return s.half - f.x }
    if f.facing > 0 && stage_open(s, 0) { return f.x + s.half }
    return 1000.0
}

// The reaches cpu_edge() needs, once a fight (fight_init(), through cpu_init()).
private fn cpu_edge_init() {
    for i in 0..2 {
        var m = fight.f[i].mech
        if m == Mech.Twins { m = Mech.TwinA }       // the rounds start split
        cpu_low[m] = 0.0
        if move_hit(m, Mv.atk_d).kd { cpu_low[m] = reach_of(m, Mv.atk_d) }
        if fight.f[i].mech == Mech.Twins && move_hit(Mech.Twins, Mv.atk_d).kd {
            cpu_low[Mech.Twins] = reach_of(Mech.Twins, Mv.atk_d)
        }
    }
}

// What side i does about an open edge at this decision, or CPU_NO_IDEA.
private fn cpu_edge(i: s32, c: *Cpu, lv: *CpuLevel, dist: fixed, fwd: u32) -> u32 {
    let me = &fight.f[i]
    let op = &fight.f[other(i)]
    // backed up to the edge with the other in reach: jump out over it, block, or throw it
    if edge_behind(i) < CPU_EDGE_DANGER && dist < tip(op.body) + 3.0 {
        let r = rnd_n(c, 100)
        if r < 25 && dist < 9.0 { return fwd | X }
        if r < 50 { return hold(c, R, 16) }
        if r < 70 && dist < 4.5 { return Y }
        if r < 85 { return hold(c, fwd, 10) }
        return CPU_NO_IDEA
    }
    // backed up toward the edge: take the space back
    let eo = edge_behind(other(i))
    if edge_behind(i) < CPU_EDGE_BACK && roll(c, 30) { return hold(c, fwd, 12) }
    // the other backed up to it: a throw up close, a knockdown when it is near the lip, and
    // pressure from further out
    if eo < CPU_EDGE_CHANCE {
        if dist < 4.5 && roll(c, lv.grab + 20) { return Y }
        if cpu_low[me.body] > 0.0 && dist < cpu_low[me.body] - 0.5 && eo < 4.5 && roll(c, lv.poke + 20) {
            return DOWN | A
        }
    }
    if eo < CPU_EDGE_ROOM && dist > 6.0 && roll(c, 45) { return hold(c, fwd, 12) }
    return CPU_NO_IDEA
}

// ---- Shadow's CPU (mx-shadow-fight): lay mines where the other must walk and stand behind
// them, keep a curse up with the bolt at mid range, sneak in to punish from far, grab a mech
// that blocks, punish a snared one at once

const SH_SNEAK_STOP: fixed = 4.5        // the Sneak's hold is let go this close (it erupts in reach)

private fn shadow_punish(dist: fixed, fwd: u32) -> u32 {
    if dist < 6.0 { return A }
    if dist < 10.0 { return fwd | A }
    if dist < 19.0 { return fwd | B }                   // the Sneak, held as far as it needs
    return 0
}

private fn shadow_snare_punish(i: s32, c: *Cpu, dist: fixed, fwd: u32) -> u32 {
    if dist < 4.5 && roll(c, 40) { return Y }           // Phantom Grip: the side swap too
    if dist < 6.0 { return A }                          // the chain follows on contact
    if dist < 10.5 { return fwd | A }
    if dist < 13.0 { return fwd | B }
    if !fight.shot[i].on { return B }                   // too far to hit: curse it
    return 0
}

private fn shadow_neutral(i: s32, c: *Cpu, lv: *CpuLevel, dist: fixed, fwd: u32, back: u32) -> u32 {
    let me = &fight.f[i]
    let j = other(i)
    let op = &fight.f[j]
    let mine = rift[i].on
    let threat = is_attack(op.mv) || op.mv == Mv.grab || fight.shot[j].on
    let down = op.mv == Mv.knockdown || op.mv == Mv.getup || op.mv == Mv.hit_air
    if super_wise(i) && dist < 10.0 && grounded(j) && !down && roll(c, 6) { return A | B }
    // a mine where the other must walk: laid in the open between them, or while it is down
    if !mine && ((down && dist > 4.0) || (dist > 8.0 && dist < 20.0 && !threat)) && roll(c, lv.special * 4) {
        return DOWN | B
    }
    // keep a curse up: the bolt at mid range when the curse is out or running out
    // (mx-balance: not inside the other's poke, where the bolt's 40 frames are a free hit, nor at a
    // mech with a stronger shot to answer it, the Hero's wave or Beam's charged orb: the bolt does
    // not win a projectile war, so against them the curse comes from the chain)
    let beaten = fires_shot(op.mech) && op.mech != Mech.Shadow
    let clear = dist > tip(op.body) + 2.0
    if !fight.shot[i].on && !beaten && clear && dist < 24.0 && op.curse < 60 && !down && roll(c, 30 + lv.special * 2) {
        return B
    }
    // in front of its mine: step back behind it, so the other has to cross it
    if mine && sgn(op.x - rift[i].x) == me.facing && abs(me.x - rift[i].x) < 3.0 && dist < 16.0 && roll(c, 50) {
        return hold(c, back, 10 + rnd_n(c, 10))
    }
    if dist < tip(op.body) + 2.0 && roll(c, lv.guard) { return hold(c, R, 16 + rnd_n(c, 20)) }
    if dist < 5.0 {
        if c.blocks_seen >= 1 && roll(c, lv.grab) { c.blocks_seen = 0; return Y }   // grabs beat block
        let r = rnd_n(c, 100)
        if r < 32 { return A }
        if r < 44 { return Y }
        if r < 56 { return fwd | A }
        if r < 62 && !mine { return DOWN | B }
        if r < 80 { return hold(c, back, 12) }
        return hold(c, R, 10)
    }
    let range = tip(me.body)
    if dist < range + 0.5 {
        let r = rnd_n(c, 100)
        if r < lv.poke { return fwd | A }
        if r < lv.poke + 8 { return DOWN | A }
        if r < lv.poke + 30 { return hold(c, back, 10) }
        if r < lv.poke + 40 { return hold(c, R, 12) }
        return hold(c, fwd, 8)
    }
    if dist < range + 6.0 && roll(c, lv.jump) { return fwd | X }
    // with a mine out it waits behind it; without, it walks in (and against a mech with a shot,
    // which it cannot outshoot, it waits only half the time: mx-balance)
    if mine && dist < 22.0 && (!fires_shot(op.mech) || roll(c, 50)) { return hold(c, 0, 8 + rnd_n(c, 8)) }
    return hold(c, fwd, 10 + rnd_n(c, 16))
}

// ---- the other's Rift Mine (mx-balance): a CPU sees the sigil on the floor as a player does and
// does not walk (or slide, roll or dash) onto it once it is about to arm. It clears it with its
// down attack when that reaches it (the Hero also with its wave, which runs along the floor),
// jumps over it, or waits behind it for the other to come; the plan is rolled once a mine and
// kept a while.

const MP_CLEAR = 0
const MP_JUMP = 1
const MP_WAIT = 2
const MINE_WARY: fixed = 0.8            // stops this far short of setting it off

// Whether moving go metres forward would set off the other's mine (armed, or about to be).
private fn mine_in_path(i: s32, go: fixed) -> bool {
    let m = &rift[other(i)]
    if !m.on || m.t < MINE_ARM - 20 { return false }
    let me = &fight.f[i]
    let gap = (m.x - me.x) * fixed(me.facing) - STATS[me.body].push - MINE_HALF
    return gap > -0.5 && gap < go + 0.5
}

private fn mine_wary(i: s32, lv: *CpuLevel, p: u32) -> u32 {
    let j = other(i)
    let m = &rift[j]
    if m.t < MINE_ARM - 20 || fight.phase != Phase.Fight || !actionable(i) { return p }
    let me = &fight.f[i]
    let c = &cpu[i]
    let fwd = dir_bit(me.facing)
    let ahead = (m.x - me.x) * fixed(me.facing)            // the mine's centre, ahead of the root
    let gap = ahead - STATS[me.body].push - MINE_HALF       // moving this far sets it off
    if gap < -0.5 { return p }                              // under or behind it
    // how far what it pressed would carry it toward the mine
    var go = -1.0
    if (p & (A | B | X | Y | R)) == 0 && (p & fwd) != 0 && (p & DOWN) == 0 { go = 0.0 }
    if (p & B) != 0 && (p & UP) == 0 {
        if (p & DOWN) != 0 { go = cpu_trav_d[me.body] }
        else if (p & fwd) != 0 { go = cpu_trav_f[me.body] }
    }
    if (p & A) != 0 && (p & fwd) != 0 && (p & DOWN) == 0 { go = cpu_trav_a[me.body] }
    if go < 0.0 || gap > go + MINE_WARY { return p }
    if c.mine_x != m.x || c.mine_t <= 0 {
        c.mine_x = m.x
        c.mine_t = 40 + rnd_n(c, 40)
        let r = rnd_n(c, 100)
        c.mine_plan = MP_WAIT
        if r < lv.special * 6 { c.mine_plan = MP_CLEAR }
        else if r < lv.special * 6 + lv.jump * 4 { c.mine_plan = MP_JUMP }
    }
    c.mine_t -= 1
    c.hold = c.hold & ~fwd
    let reach = cpu_lo0[me.body] < ahead + MINE_HALF - 0.2 && cpu_lo1[me.body] > ahead - MINE_HALF + 0.2
    if c.mine_plan == MP_CLEAR {
        if me.mech == Mech.Hero && !fight.shot[i].on && ahead > WAVE_X - 0.5 {
            c.mine_t = 0
            return B                                        // the wave runs along the floor
        }
        if reach {
            c.mine_t = 0
            return DOWN | A
        }
        if gap > 0.3 && go == 0.0 { return fwd }            // a step closer, until it reaches
    }
    if c.mine_plan == MP_JUMP && gap < 2.5 {
        c.mine_t = 0
        return fwd | X
    }
    return p & ~(fwd | A | B)
}

// ---- a shot above the floor coming (mx-balance): a Volt Orb or a Hex Bolt. Too high to jump
// (a jumping mech's hurt box still meets it), so it is blocked, or gone under or through: the
// Double-blade Hero's Void Step, Shadow Sneak, the split Twins' Low Roll; the Hero's wave beats a
// tapped orb and the bolt (the wave is the stronger).

private fn shot_above(i: s32, c: *Cpu, lv: *CpuLevel, s: *Shot, fwd: u32) -> u32 {
    let me = &fight.f[i]
    let far = abs(s.x - me.x)
    if me.mech == Mech.Doubleblade && roll(c, lv.aa) { return B }
    if me.mech == Mech.Shadow && abs(fight.f[other(i)].x - me.x) < 19.0 && roll(c, lv.aa) { return fwd | B }
    if me.mech == Mech.Hero && s.str < 2 && !fight.shot[i].on && far > 8.0 && roll(c, lv.aa) { return B }
    if me.mech == Mech.Beam && s.str < 2 && !fight.shot[i].on && far > 8.0 && roll(c, lv.aa) {
        c.charge_want = ORB_CHARGE_HALF + 4                 // a charged orb beats a bolt or a tap
        return B
    }
    // the roll passes under it if it starts close enough that the shot is past when it stands
    if me.body == Mech.TwinA && far > 4.0 && far < 6.0 + abs(s.vx) * 20 && roll(c, lv.aa) { return DOWN | B }
    return hold(c, R, 20)
}
