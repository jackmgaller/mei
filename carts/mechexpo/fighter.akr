// Mech Expo 2000: the fighters (C's). Input and its buffer, the state machine (moves, hit and
// block stun, jumps, knockdowns, throws), movement with the walls and the separation limit, and
// the collisions: hits, blocks, chip, grabs and breaks, the Parry, the wave. fight.akr runs it
// a frame at a time and owns the rounds. Everything is fixed-point and deterministic.

import "moves.akr"
import "meter.akr"
import "fight.akr"

// Relative directions (forward is toward the way the mech faces).
const D_N = 0
const D_F = 1
const D_B = 2
const D_D = 3
const D_U = 4

// Buffered buttons.
const BI_A = 0
const BI_B = 1
const BI_X = 2
const BI_Y = 3
const NBUF = 4
const BUF = 8                   // a press is kept this many frames
const NO_PRESS = 1000
const SUPER_WINDOW = 3          // A and B within this many frames: the super
const KARA = 3                  // a move this young may still become the super
const BREAK_WINDOW = 10         // frames after a catch in which the victim may break
const BREAK_EARLY = 3           // or this many frames before it
const SLIDE_FRICTION: fixed = 0.012
const BLOCK_STOP = 7
const COMBO_2 = 80              // per cent of damage for a combo's second hit
const COMBO_3 = 65              // and the third and later
const STICK_ON: fixed = 0.5

struct Fx {
    t: s32                      // frame of the current move
    stun: s32                   // hitstun or blockstun frames left
    stun_len: s32
    lag: s32                    // landing lag left
    pause: s32                  // frozen by a Parry
    air: bool                   // in the air under gravity
    vx: fixed
    vy: fixed
    slide: fixed                // the knockback slide, world metres a frame
    slide_by: s32               // who caused it (a wall passes it back to them), or -1
    hits: u32                   // hit indices of the current move that connected
    contact: bool               // the current move hit or was blocked (cancels)
    chain: s32                  // Double-blade: its second neutral attack used
    combo: s32                  // hits taken in the current combo
    air_used: bool              // the air attack of this jump
    riposte: bool               // the Parry caught something
    ko: bool                    // knocked out (lands in ko)
    break_t: s32                // the victim's break window left
    had_hit: bool               // the last frame had a hit box (swing and whiff events)
    // input
    pad: u32
    held_dir: s32               // the relative direction held now
    hx: s32                     // the horizontal direction held, world (-1, 0, 1)
    down: bool
    age: [NBUF]s32              // frames since each button's last press (NO_PRESS: none)
    dir: [NBUF]s32              // the direction held at that press
    sa: s32                     // frames since A and B were pressed, for the super (a move
    sb: s32                     // started by one of them does not use these up)
    calm: s32                   // training: frames since last hurt
    prev_x: fixed               // x at the start of the frame (the separation limit)
    l_age: s32                  // frames since L was pressed (the Twins switch forms on it)
}

// The bodies: 0 and 1 the two fighters, 2 and 3 their partners (the split Twins' twin B, of
// side 0 and side 1; twins.akr). A body's side is i & 1.
const BODIES = 4
var fx: [BODIES]Fx
var fbox: [BODIES]Boxes         // this frame's boxes, world-relative (fight-local, by facing)
var vic: [BODIES]s32            // the body a fighter's grab caught (its throw's victim)

// The other side's fighter (for a partner too: the fighter it faces).
fn other(i: s32) -> s32 { return 1 - (i & 1) }

fn sgn(v: fixed) -> s32 {
    if v > 0.0 { return 1 }
    if v < 0.0 { return -1 }
    return 0
}

fn fighter_reset(i: s32, x: fixed, facing: s32) {
    let f = &fight.f[i]
    f.x = x
    f.y = 0.0
    f.facing = facing
    f.body = f.mech
    f.mv = Mv.idle
    f.frame = 0.0
    f.flash = 0
    f.health = STATS[f.mech].health
    f.health_max = f.health
    f.react = 0
    f.charge = 0
    fx_clear(i)
    vic[i] = other(i)
}

fn fx_clear(i: s32) {
    fx[i] = Fx { slide_by: -1 }
    for b in 0..NBUF { fx[i].age[b] = NO_PRESS }
    fx[i].sa = NO_PRESS
    fx[i].sb = NO_PRESS
    fx[i].l_age = NO_PRESS
}

// ---- input

fn fighter_input(i: s32, pad_in: u32, st: vec2) {
    let f = &fight.f[i]
    let x = &fx[i]
    var pad = pad_in
    if st.x > STICK_ON { pad |= RIGHT }
    if st.x < -STICK_ON { pad |= LEFT }
    if st.y > STICK_ON { pad |= UP }
    if st.y < -STICK_ON { pad |= DOWN }
    fighter_pad(i, pad, pad & ~x.pad)
}

// The buttons held (pad) and pressed this frame: the partner gets its copy here (twins.akr).
fn fighter_pad(i: s32, pad: u32, pressed: u32) {
    let f = &fight.f[i]
    let x = &fx[i]
    x.pad = pad
    x.hx = 0
    if pad & RIGHT != 0 { x.hx += 1 }
    if pad & LEFT != 0 { x.hx -= 1 }
    x.down = pad & DOWN != 0
    var d = D_N
    if pad & UP != 0 { d = D_U }
    else if x.down { d = D_D }
    else if x.hx == f.facing { d = D_F }
    else if x.hx == -f.facing { d = D_B }
    x.held_dir = d
    let bits: [NBUF]u32 = [A, B, X, Y]
    for b in 0..NBUF {
        if pressed & bits[b] != 0 {
            x.age[b] = 0
            x.dir[b] = d
        }
    }
    if pressed & A != 0 { x.sa = 0 }
    if pressed & B != 0 { x.sb = 0 }
    if pressed & L != 0 { x.l_age = 0 }
}

// Once a frame outside the freezes: presses get older.
fn fighter_age_input(i: s32) {
    for b in 0..NBUF {
        if fx[i].age[b] < NO_PRESS { fx[i].age[b] += 1 }
    }
    if fx[i].sa < NO_PRESS { fx[i].sa += 1 }
    if fx[i].sb < NO_PRESS { fx[i].sb += 1 }
    if fx[i].l_age < NO_PRESS { fx[i].l_age += 1 }
}

private fn fresh(i: s32, b: s32) -> bool { return fx[i].age[b] <= BUF }
private fn consume(i: s32, b: s32) { fx[i].age[b] = NO_PRESS }

fn super_pressed(i: s32) -> bool {
    let x = &fx[i]
    return x.sa <= BUF && x.sb <= BUF && abs(x.sa - x.sb) <= SUPER_WINDOW
}

// ---- states

fn is_neutral(mv: Mv) -> bool {
    return mv == Mv.idle || mv == Mv.walk_f || mv == Mv.walk_b || mv == Mv.crouch || mv == Mv.block
}

fn grounded(i: s32) -> bool { return !fx[i].air && fight.f[i].y <= 0.0 }

// Hit and block stun, knockdowns, throws: the states nothing else may change.
fn is_hurt(mv: Mv) -> bool {
    return mv == Mv.hit_high || mv == Mv.hit_low || mv == Mv.hit_air || mv == Mv.knockdown
        || mv == Mv.getup || mv == Mv.ko || is_thrown(mv)
}

fn is_thrown(mv: Mv) -> bool { return mv == Mv.thrown || mv == Mv.thrown_vault || mv == Mv.thrown_slam }

fn actionable(i: s32) -> bool {
    let f = &fight.f[i]
    if !grounded(i) { return false }
    if f.mv == Mv.block { return fx[i].stun == 0 }
    return is_neutral(f.mv)
}

fn set_mv(i: s32, mv: Mv) {
    let f = &fight.f[i]
    let x = &fx[i]
    f.mv = mv
    f.charge = 0
    x.t = 0
    x.hits = 0
    x.contact = false
    x.riposte = false
    x.had_hit = false
}

fn to_neutral(i: s32) {
    let x = &fx[i]
    x.stun = 0
    x.combo = 0
    x.chain = 0
    if x.down { set_mv(i, Mv.crouch) } else { set_mv(i, Mv.idle) }
}

// The fighter's world box from a fight-local one.
fn world_box(i: s32, b: *Box) -> vec4 {
    let f = &fight.f[i]
    if f.facing > 0 { return vec4(f.x + b.x0, f.y + b.y0, f.x + b.x1, f.y + b.y1) }
    return vec4(f.x - b.x1, f.y + b.y0, f.x - b.x0, f.y + b.y1)
}

fn cur_frame(i: s32) -> s32 {
    let f = &fight.f[i]
    let n = mv_len(f.body, f.mv)
    // crouch and block: the get-down or the raise, then the last frame held (they are held
    // states, so the fight keeps them going like loops)
    if f.mv == Mv.crouch || f.mv == Mv.block { return min(fx[i].t, n - 1) }
    if mv_loops(f.body, f.mv) { return fx[i].t % n }
    return min(fx[i].t, n - 1)
}

fn cur_marks(i: s32) -> u32 {
    let f = &fight.f[i]
    return mv_marks(f.body, f.mv, cur_frame(i))
}

// The frame with a mark in a move (the Parry's riposte), or -1.
fn find_mark(m: Mech, mv: Mv, mark: u32) -> s32 {
    let n = mv_len(m, mv)
    for k in 0..n {
        if mv_marks(m, mv, k) & mark != 0 { return k }
    }
    return -1
}

private fn count_mark(m: Mech, mv: Mv, mark: u32) -> s32 {
    let n = mv_len(m, mv)
    var c = 0
    for k in 0..n {
        if mv_marks(m, mv, k) & mark != 0 { c += 1 }
    }
    return c
}

// ---- starting moves

fn start_super(i: s32) {
    let f = &fight.f[i]
    meter_spend(f)
    consume(i, BI_A)
    consume(i, BI_B)
    fx[i].sa = NO_PRESS
    fx[i].sb = NO_PRESS
    set_mv(i, Mv.super)
    let flash = count_mark(f.body, Mv.super, MARK_FLASH)
    if flash > 0 {
        fight.freeze = flash
        fight.flash_side = i
    }
    ev_add(Ev.Super, i, f.x, 6.0, 3)
}

// Starts the move a buffered press asks for, if allowed (mask: the moves it may be, for a cancel;
// 0xFFFFFFFF from neutral). Returns whether one started.
fn try_press(i: s32, mask: u32) -> bool {
    let f = &fight.f[i]
    let x = &fx[i]
    if (mask & SUPER_BIT) != 0 && super_pressed(i) && meter_can_super(f) && grounded(i) {
        start_super(i)
        return true
    }
    if fresh(i, BI_Y) && (mask & mv_bit(Mv.grab)) != 0 && grounded(i) && !(f.mech == Mech.Twins && twins_y_breaks(i)) {
        consume(i, BI_Y)
        set_mv(i, Mv.grab)
        return true
    }
    if fresh(i, BI_B) && grounded(i) {
        let mv = match x.dir[BI_B] { D_U => Mv.sp_u, D_D => Mv.sp_d, D_F => Mv.sp_f, else => Mv.sp_n }
        if (mask & mv_bit(mv)) != 0 {
            consume(i, BI_B)
            if mv == Mv.sp_n && fires_shot(f.mech) && fight.shot[i].on { return false }
            // the chemical prime: one reaction at a time
            if mv == Mv.sp_d && meter_power(f.mech) == Power.Chemical && f.react > 0 { return false }
            set_mv(i, mv)
            return true
        }
    }
    if fresh(i, BI_A) {
        if !grounded(i) {
            if !x.air_used && (mask & mv_bit(Mv.atk_air)) != 0 && fight.f[i].mv == Mv.jump {
                consume(i, BI_A)
                let keep_t = 0
                fight.f[i].mv = Mv.atk_air
                x.t = keep_t
                x.hits = 0
                x.contact = false
                x.air_used = true
                return true
            }
            return false
        }
        let mv = match x.dir[BI_A] { D_D => Mv.atk_d, D_F => Mv.atk_f, else => Mv.atk_n }
        if (mask & mv_bit(mv)) != 0 {
            if mv == Mv.atk_n && f.mv == Mv.atk_n {
                if x.chain > 0 { return false }
                x.chain = 1
            }
            consume(i, BI_A)
            set_mv(i, mv)
            return true
        }
    }
    if fresh(i, BI_X) && (mask & mv_bit(Mv.jump)) != 0 && grounded(i) {
        consume(i, BI_X)
        set_mv(i, Mv.jump)
        x.vx = fixed(x.hx) * STATS[f.body].jvx
        x.air_used = false
        return true
    }
    return false
}

const ANY: u32 = 0xFFFFFFFF

// ---- one frame of a fighter

fn fighter_tick(i: s32, live: bool) {
    let x = &fx[i]
    x.prev_x = fight.f[i].x
    if x.pause > 0 {
        x.pause -= 1
        return
    }
    advance(i)
    if live { decide(i) }
    let f = &fight.f[i]
    // the slide (knockback, pushback, a break)
    if x.slide != 0.0 && grounded(i) {
        f.x += x.slide
        if x.slide > 0.0 { x.slide = max(x.slide - SLIDE_FRICTION, 0.0) }
        else { x.slide = min(x.slide + SLIDE_FRICTION, 0.0) }
        if x.slide == 0.0 { x.slide_by = -1 }
    }
}

private fn advance(i: s32) {
    let f = &fight.f[i]
    let x = &fx[i]
    let s = &STATS[f.body]
    let mv = f.mv
    if mv == Mv.hit_high || mv == Mv.hit_low || (mv == Mv.block && x.stun > 0) {
        x.t += 1
        x.stun -= 1
        if x.stun <= 0 {
            x.stun = 0
            if mv != Mv.block { to_neutral(i) }
        }
        return
    }
    if mv == Mv.hit_air || mv == Mv.ko {
        x.t += 1
        if x.air {
            air_step(i)
            if !x.air {
                if x.ko { set_mv(i, Mv.ko); x.t = 0; f.mv = Mv.ko }
                else { set_mv(i, Mv.knockdown) }
                ev_add(Ev.Land, i & 1, f.x, 0.0, 2)
            }
        }
        return
    }
    if mv == Mv.jump || mv == Mv.atk_air {
        x.t += 1
        if mv == Mv.jump && !x.air && x.t == s.pre {
            x.air = true
            x.vy = s.jv
        }
        if x.air {
            air_step(i)
            if !x.air {
                let lag = if_else(mv == Mv.atk_air, s.land_air, s.land)
                set_mv(i, Mv.land)
                x.lag = lag
                x.vx = 0.0
                ev_add(Ev.Land, i & 1, f.x, 0.0, 0)
            }
        }
        return
    }
    if mv == Mv.land {
        x.t += 1
        x.lag -= 1
        if x.lag <= 0 { to_neutral(i) }
        return
    }
    if is_thrown(mv) { return }         // the thrower places it
    if mv_loops(f.body, mv) || mv == Mv.crouch || mv == Mv.block {
        x.t += 1                        // loops, and the held states (cur_frame() holds them)
        return
    }
    if f.mech == Mech.Shadow && shadow_advance(i) { return }   // Shadow Sneak's travel (shadow.akr)
    // a charge frame (Beam's Volt Orb) holds while B is held, up to ORB_CHARGE_MAX frames
    if (mv_marks(f.body, mv, x.t) & MARK_CHARGE) != 0 && (x.pad & B) != 0 && f.charge < ORB_CHARGE_MAX {
        f.charge += 1
        if f.mech == Mech.Twins { twins_focus(f) }    // the Twins' Fusion Focus fills the meter
        return
    }
    // a move: root motion, then the end
    let r = mv_root(f.body, mv, x.t)
    move_root(i, fixed(f.facing) * r.x, r.y)
    x.t += 1
    if mv == Mv.knockdown && x.t >= mv_len(f.body, mv) { set_mv(i, Mv.getup); return }
    if mv == Mv.sp_d && !x.riposte {
        let rip = find_mark(f.body, Mv.sp_d, MARK_RIPOSTE)
        if rip >= 0 && x.t >= rip { end_move(i); return }
    }
    if f.mech == Mech.Tank && !x.riposte && tank_cmd_grab(mv) {
        let rip = tank_slam_rip(mv)             // a missed command grab ends at its slam section
        if rip >= 0 && x.t >= rip { end_move(i); return }
    }
    if x.t >= mv_len(f.body, mv) { end_move(i) }
}

fn if_else(c: bool, a: s32, b: s32) -> s32 {
    if c { return a }
    return b
}

private fn end_move(i: s32) {
    let f = &fight.f[i]
    let x = &fx[i]
    if f.mv == Mv.grab {
        set_mv(i, Mv.grab_whiff)
        return
    }
    if f.y > 0.0 {                      // ended above the floor (the Rising Arc): fall
        f.mv = Mv.jump
        x.t = mv_len(f.body, Mv.jump) - 1
        x.air = true
        x.vx = 0.0
        x.vy = 0.0
        x.air_used = true
        return
    }
    f.y = 0.0
    to_neutral(i)
}

private fn air_step(i: s32) {
    let f = &fight.f[i]
    let x = &fx[i]
    f.x += x.vx
    f.y += x.vy
    x.vy -= STATS[f.body].grav
    if f.y <= 0.0 && x.vy < 0.0 {
        f.y = 0.0
        x.air = false
        x.vy = 0.0
        x.air_used = false
    }
}

// Root motion, which may push into the other mech but not through it (unless it has no push
// box: the Void Step).
private fn move_root(i: s32, dx: fixed, dy: fixed) {
    let f = &fight.f[i]
    let o = &fight.f[other(i)]
    var nx = f.x + dx
    f.y = max(f.y + dy, 0.0)
    if dx != 0.0 && grounded(other(i)) && (cur_marks(i) & MARK_NOPUSH) == 0 {
        if f.x <= o.x && nx > o.x - 0.5 { nx = max(f.x, o.x - 0.5) }
        if f.x >= o.x && nx < o.x + 0.5 { nx = min(f.x, o.x + 0.5) }
    }
    f.x = nx
}

fn face_other(i: s32) {
    let f = &fight.f[i]
    let o = &fight.f[other(i)]
    if o.x > f.x { f.facing = 1 }
    if o.x < f.x { f.facing = -1 }
}

private fn decide(i: s32) {
    let f = &fight.f[i]
    let x = &fx[i]
    let s = &STATS[f.body]
    if actionable(i) {
        face_other(i)
        // the direction of the presses is relative to the facing now
        if x.combo != 0 { x.combo = 0 }
        if f.mech == Mech.Twins && i < 2 && twins_switch(i) { return }   // L: combine or split
        if try_press(i, ANY) { return }
        if x.pad & R != 0 {
            if f.mv != Mv.block { set_mv(i, Mv.block) }
            return
        }
        if f.mv == Mv.block && x.stun == 0 {
            to_neutral(i)
        }
        var want = Mv.idle
        if x.down { want = Mv.crouch }
        else if x.hx == f.facing { want = Mv.walk_f }
        else if x.hx == -f.facing { want = Mv.walk_b }
        if f.mv != want { set_mv(i, want) }
        if want == Mv.walk_f { f.x += fixed(f.facing) * s.walk_f }
        if want == Mv.walk_b { f.x -= fixed(f.facing) * s.walk_b }
        if want == Mv.walk_f || want == Mv.walk_b {
            if cur_marks(i) & MARK_STEP != 0 { ev_add(Ev.Step, i & 1, f.x, 0.0, 0) }
        }
        return
    }
    // in a jump: the air attack (once a jump; try_press checks)
    if f.mv == Mv.jump && !grounded(i) {
        try_press(i, mv_bit(Mv.atk_air))
        return
    }
    // cancels: on contact, in the cancel window, into what the move allows
    if x.contact && is_attack(f.mv) && (cur_marks(i) & MARK_CANCEL) != 0 {
        let c = cancels(f.body, f.mv)
        if c != 0 && try_press(i, c) { return }
    }
    // a move started by A or B a moment ago becomes the super when the other button follows
    if x.t <= KARA && (f.mv == Mv.atk_n || f.mv == Mv.atk_f || f.mv == Mv.atk_d || is_special(f.mv))
        && super_pressed(i) && meter_can_super(f) && grounded(i) {
        start_super(i)
    }
}

// ---- the throw

fn throw_tick(i: s32) {
    let f = &fight.f[i]
    if tank_holding(i) {
        tank_slam_tick(i)
        return
    }
    if f.mv != Mv.throw { return }
    let j = vic[i]
    let o = &fight.f[j]
    let t = fx[i].t
    if !is_thrown(o.mv) { return }
    fx[j].t = t
    // the victim's break (the victim side's pad: a grabbed partner is broken by its leader's Y)
    if fx[j].break_t > 0 {
        fx[j].break_t -= 1
        if fresh(j & 1, BI_Y) {
            consume(j & 1, BI_Y)
            grab_break(i)
            return
        }
    }
    let rel = find_mark(f.body, Mv.throw, MARK_RELEASE)
    let ft = fixed(f.facing)
    if f.mech == Mech.Shadow {
        shadow_hold(i, j, t)                    // shadow.akr: Phantom Grip's side swap
    } else if f.mech == Mech.Twins {
        twins_hold(i, j, t)                     // twins.akr: the Tag Toss and the Binary Buster
    } else if f.mech == Mech.Tank {
        // Tank's Scrap Heave: held at its fists, lifted higher (MOVES.md)
        o.x = f.x + ft * 3.8
        o.y = clamp(fixed(t - 10) * 0.3, 0.0, 4.0)
    } else if f.mech != Mech.Doubleblade {
        // held in front at arm's length, lifted (the Hero's throw, Beam's Shock Grip)
        o.x = f.x + ft * 3.4
        o.y = min(fixed(t) * 0.1, 3.0)
    } else {
        // vaulted over the head to the other side
        var k = clamp(fixed(t - 6) / 22, 0.0, 1.0)
        o.x = f.x + ft * (3.4 - k * 8.4)
        o.y = 8.0 * k * (1.0 - k) * 4.0 / 4.0
    }
    if t == rel || (rel < 0 && t == 30) {
        let h = move_hit(f.body, Mv.throw)
        damage(j, meter_damage(o, h.dmg), true)
        meter_on_hit(f, true, false)
        o.mv = Mv.hit_air
        // from the thrown pose, lying flat: carry on from hit_air's last frame (also lying)
        fx[j].t = mv_len(o.body, Mv.hit_air) - 1
        fx[j].air = true
        fx[j].vy = h.launch
        if f.mech == Mech.Hero { fx[j].vx = ft * 0.30 } else if f.mech == Mech.Tank { fx[j].vx = ft * 0.34 } else { fx[j].vx = -ft * 0.08 }
        if f.mech == Mech.Beam { fx[j].vx = ft * 0.24 }        // the Shock Grip throws it off, about 9 m
        if f.mech == Mech.Twins { fx[j].vx = ft * twins_toss_vx(f.body) }
        if f.mech == Mech.Shadow { fx[j].vx = ft * GRIP_TOSS_VX }   // flung back where Shadow came from
        fight.freeze = h.stop
        fight.flash_side = -1
        o.flash = h.stop
        fight.shake = 0.6
        ev_add(Ev.Throw, i, o.x, o.y, h.power)
        if hp(j) <= 0 { knock_out(j) }
    }
}

fn grab_break(i: s32) {
    let j = vic[i]
    set_mv(i, Mv.grab_break)
    set_mv(j, Mv.grab_break)
    fight.f[j].y = 0.0
    fx[j].air = false
    fx[i].break_t = 0
    fx[j].break_t = 0
    let d = sgn(fight.f[j].x - fight.f[i].x)
    var dd = d
    if dd == 0 { dd = fight.f[i].facing }
    fx[i].slide = -fixed(dd) * 0.25
    fx[j].slide = fixed(dd) * 0.25
    fx[i].slide_by = -1
    fx[j].slide_by = -1
    ev_add(Ev.Break, i & 1, (fight.f[i].x + fight.f[j].x) / 2, 6.0, 1)
}

// ---- damage and KOs

// The health of body j's side (the split Twins' two bodies share one bar).
fn hp(j: s32) -> s32 { return fight.f[j & 1].health }

fn damage(j: s32, dmg: s32, can_ko: bool) {
    let o = &fight.f[j & 1]
    let before = o.health
    o.health -= dmg
    var floor = 0
    if !can_ko { floor = 1 }
    if fight.mode == FightMode.Training { floor = 1 }
    if o.health < floor { o.health = floor }
    meter_on_damage(o, before - o.health)
    fx[j & 1].calm = 0
}

fn knock_out(j: s32) {
    if fight.f[j & 1].mech == Mech.Twins { twins_ko(j) }      // both twins fall
    ko_body(j)
    ev_add(Ev.Ko, other(j), fight.f[j].x, 6.0, 3)
}

fn ko_body(j: s32) {
    fx[j].ko = true
    let o = &fight.f[j]
    if o.mv != Mv.hit_air {
        o.mv = Mv.hit_air
        fx[j].t = 0
        fx[j].air = true
        fx[j].vy = 0.4
        fx[j].vx = -fixed(o.facing) * 0.12
    }
}

// ---- collisions

const R_NONE = 0
const R_HIT = 1
const R_BLOCK = 2
const R_PARRY = 3
const R_GRAB = 4

fn overlap(a: vec4, b: vec4) -> bool {
    return a.x < b.z && b.x < a.z && a.y < b.w && b.y < a.w
}

fn hittable(j: s32) -> bool {
    let o = &fight.f[j]
    if is_hurt(o.mv) && o.mv != Mv.hit_high && o.mv != Mv.hit_low { return false }
    if o.mv == Mv.throw || o.mv == Mv.intro || o.mv == Mv.win || tank_holding(j) { return false }
    if cur_marks(j) & (MARK_INVULN | MARK_NOPUSH) != 0 { return false }
    return true
}

fn grabbable(j: s32) -> bool {
    let o = &fight.f[j]
    if !grounded(j) { return false }
    if cur_marks(j) & MARK_ARMOUR != 0 { return true }      // grabs break super armour
    if o.mv == Mv.block { return fx[j].stun == 0 }
    // a mech grabbing too: the first to catch wins, two at once break (collide())
    return o.mv == Mv.idle || o.mv == Mv.walk_f || o.mv == Mv.walk_b || o.mv == Mv.crouch
        || o.mv == Mv.grab
}

private fn parrying(j: s32) -> bool {
    return fight.f[j].mv == Mv.sp_d && !fx[j].riposte && (cur_marks(j) & MARK_PARRY) != 0
}

// Fills fbox with both fighters' boxes for this frame (and the partners', twins.akr).
fn load_boxes() {
    for i in 0..2 {
        let f = &fight.f[i]
        mv_boxes(f.body, f.mv, cur_frame(i), &fbox[i])
    }
    if twins_in_fight { twins_load_boxes() }
}

var c_hit: [BODIES]s32      // which box index of i's hit boxes connected
var c_pt: [BODIES]vec2      // the contact point

// What i's hit boxes do to body j this frame.
fn strike(i: s32, j: s32) -> s32 {
    let f = &fight.f[i]
    if fx[i].pause > 0 { return R_NONE }
    let bi = &fbox[i]
    let bj = &fbox[j]
    for k in 0..bi.n {
        let hb = &bi.b[k]
        if hb.kind != BOX_HIT { continue }
        if (fx[i].hits & ((1 as u32) << (hb.hit as u32))) != 0 { continue }
        let w = world_box(i, hb)
        let grabbing = f.mv == Mv.grab || tank_grab_box(i)
        if grabbing {
            if !(grabbable(j) || tank_super_catches(i, j)) || cur_marks(j) & (MARK_INVULN | MARK_NOPUSH) != 0 { continue }
            if tank_holding(j) || fight.f[j].mv == Mv.throw { continue }
        } else if !hittable(j) {
            continue
        }
        for q in 0..bj.n {
            let hu = &bj.b[q]
            if hu.kind != BOX_HURT { continue }
            let u = world_box(j, hu)
            if overlap(w, u) {
                c_hit[i] = hb.hit as s32
                c_pt[i] = vec2((max(w.x, u.x) + min(w.z, u.z)) / 2, (max(w.y, u.y) + min(w.w, u.w)) / 2)
                if grabbing { return R_GRAB }
                if parrying(j) && f.mv != Mv.super { return R_PARRY }
                if fight.f[j].mv == Mv.block { return R_BLOCK }
                return R_HIT
            }
        }
    }
    return R_NONE
}

fn collide() {
    load_boxes()
    if twins_in_fight {
        twins_collide()                         // twins.akr: up to four bodies
        return
    }
    let r0 = strike(0, 1)
    let r1 = strike(1, 0)
    if r0 == R_GRAB && r1 == R_GRAB {
        ev_add(Ev.Grab, 0, (fight.f[0].x + fight.f[1].x) / 2, 6.0, 0)
        vic[0] = 1
        grab_break(0)
        return
    }
    let h0 = move_hit(fight.f[0].body, fight.f[0].mv)
    let h1 = move_hit(fight.f[1].body, fight.f[1].mv)
    let mv0 = fight.f[0].mv
    let mv1 = fight.f[1].mv
    resolve(0, 1, r0, h0, mv0)
    resolve(1, 0, r1, h1, mv1)
}

// What body i's strike r (on body j) does.
fn resolve(i: s32, j: s32, r: s32, h0: Hit, mv: Mv) {
    if r == R_NONE { return }
    var h = h0
    if fight.f[i].mech == Mech.Shadow { h = shadow_hit_k(mv, c_hit[i], h0) }   // Total Eclipse's five hits
    fx[i].hits |= (1 as u32) << (c_hit[i] as u32)
    match r {
        R_GRAB => catch(i, j)
        R_PARRY => {
            fx[i].contact = true
            parry(j, i)
        }
        R_BLOCK => {
            fx[i].contact = true
            blocked(i, j, h, mv, c_pt[i], false)
        }
        else => {
            if tank_armoured(j, mv) {
                absorb(i, j, h, c_pt[i], false)  // super armour: no contact for the chain
            } else {
                fx[i].contact = true
                struck(i, j, h, c_pt[i], false)
            }
        }
    }
}

private fn catch(i: s32, j: s32) {
    let f = &fight.f[i]
    vic[i] = j
    fx[j].pause = 0                             // a snared mech (shadow.akr) is freed by the catch
    ev_add(Ev.Grab, i, (f.x + fight.f[j].x) / 2, 6.0, 1)
    if tank_grab_box(i) {
        tank_catch(i)                           // the command grabs: no break
        return
    }
    let early = fx[j & 1].age[BI_Y] <= BREAK_EARLY
    set_mv(i, Mv.throw)
    // the Vault Throw's victim has its own animation (flipped over the thrower's head)
    if f.mech == Mech.Doubleblade { set_mv(j, Mv.thrown_vault) } else { set_mv(j, Mv.thrown) }
    fight.f[j].facing = -f.facing
    fx[j].slide = 0.0
    fx[i].slide = 0.0
    fx[j].break_t = BREAK_WINDOW
    if early {
        consume(j & 1, BI_Y)
        grab_break(i)
    }
}

private fn parry(j: s32, i: s32) {
    // j parries i
    let o = &fight.f[j]
    let rip = find_mark(o.body, Mv.sp_d, MARK_RIPOSTE)
    fx[i].pause = PARRY_FREEZE
    fx[j].riposte = true
    if rip >= 0 { fx[j].t = rip }
    fight.freeze = 6
    fight.flash_side = -1
    ev_add(Ev.Parry, j, c_pt[i].x, c_pt[i].y, 1)
}

private fn combo_scale(dmg: s32, combo: s32) -> s32 {
    if combo == 1 { return dmg * COMBO_2 / 100 }
    if combo >= 2 { return dmg * COMBO_3 / 100 }
    return dmg
}

// i's hit h lands on j at p (shot: the wave).
fn struck(i: s32, j: s32, h: Hit, p: vec2, shot: bool) {
    let a = &fight.f[i]
    let d = &fight.f[j]
    let dx = &fx[j]
    let dmg = meter_damage(d, combo_scale(h.dmg, dx.combo))
    damage(j, dmg, true)
    meter_on_hit(&fight.f[i & 1], true, shot)
    var dir = sgn(d.x - a.x)
    if dir == 0 || shot { dir = sgn(p.x - a.x) }
    if dir == 0 { dir = a.facing }
    let crouching = d.mv == Mv.crouch || d.mv == Mv.atk_d || d.mv == Mv.hit_low
        || (d.mv == Mv.sp_d && d.mech == Mech.Doubleblade)
    let in_air = !grounded(j)
    dx.combo += 1
    dx.pause = 0
    if h.kd || in_air || hp(j) <= 0 {
        set_mv(j, Mv.hit_air)
        dx.air = true
        dx.vy = max(h.launch, 0.3)
        dx.vx = fixed(dir) * 0.12
        dx.slide = 0.0
        dx.stun = 0
    } else {
        if crouching { set_mv(j, Mv.hit_low) } else { set_mv(j, Mv.hit_high) }
        dx.stun = h.hitstun
        dx.stun_len = h.hitstun
        dx.slide = fixed(dir) * h.kb
        dx.slide_by = i
    }
    fight.freeze = max(fight.freeze, h.stop)
    fight.flash_side = -1
    d.flash = h.stop
    fight.shake = fixed(h.power + 1) * 0.15
    ev_add(Ev.Hit, i & 1, p.x, p.y, h.power)
    if hp(j) <= 0 { knock_out(j) }
}

fn blocked(i: s32, j: s32, h: Hit, mv: Mv, p: vec2, shot: bool) {
    let a = &fight.f[i]
    let d = &fight.f[j]
    let dx = &fx[j]
    meter_on_hit(&fight.f[i & 1], false, shot)
    var dir = sgn(d.x - a.x)
    if dir == 0 || shot { dir = sgn(p.x - a.x) }
    if dir == 0 { dir = a.facing }
    dx.t = 0
    dx.stun = h.blockstun
    dx.stun_len = h.blockstun
    dx.slide = fixed(dir) * h.kb * 0.8
    dx.slide_by = i
    if shot { dx.slide_by = -1 }
    fight.freeze = max(fight.freeze, BLOCK_STOP)
    fight.flash_side = -1
    fight.shake = 0.08
    d.flash = 0
    ev_add(Ev.Block, i & 1, p.x, p.y, h.power)
    if h.chip > 0 {
        damage(j, meter_damage(d, h.chip), mv == Mv.super)
        ev_add(Ev.Chip, i & 1, p.x, p.y, h.power)
        if hp(j) <= 0 { knock_out(j) }
    }
}

// ---- the shots: the Hero's wave, Beam's Volt Orb and Shadow's Hex Bolt (one each at a time)

// Whether a mech's neutral special fires a shot.
fn fires_shot(m: Mech) -> bool { return m == Mech.Hero || m == Mech.Beam || m == Mech.Shadow }

// Fires side i's shot (on its neutral special's release frame).
private fn shot_fire(i: s32) {
    let f = &fight.f[i]
    let s = &fight.shot[i]
    let ft = fixed(f.facing)
    s.on = true
    s.t = 0
    s.y = 0.0
    s.hex = false
    if f.mech == Mech.Shadow {
        shadow_bolt_fire(i, s)                  // the Hex Bolt (shadow.akr)
        return
    }
    if f.mech == Mech.Beam {
        let lvl = orb_level(f.charge)
        s.lvl = lvl
        s.str = lvl
        s.x = f.x + ft * ORB_X
        s.vx = ft * orb_speed(lvl)
        s.half = orb_half(lvl)
        s.y0 = ORB_Y0
        s.y1 = ORB_Y1
        s.life = ORB_LIFE
        ev_add(Ev.Shot, i, s.x, (ORB_Y0 + ORB_Y1) / 2, lvl)
        return
    }
    s.lvl = 0
    s.str = 2
    s.x = f.x + ft * WAVE_X
    s.vx = ft * WAVE_SPEED
    s.half = WAVE_HALF
    s.y0 = 0.0
    s.y1 = WAVE_H
    s.life = WAVE_LIFE
    ev_add(Ev.Shot, i, s.x, 0.0, 1)
}

// What a shot does when it lands.
private fn shot_hit(s: *Shot) -> Hit {
    if s.hex { return hex_hit() }
    if s.lvl > 0 { return orb_hit(s.lvl) }
    return move_hit(Mech.Hero, Mv.sp_n)
}

fn shots_tick() {
    for i in 0..2 {
        let f = &fight.f[i]
        let s = &fight.shot[i]
        // fired on the release frame of the neutral special
        if f.mv == Mv.sp_n && fires_shot(f.mech) && !s.on && fx[i].pause == 0
            && (cur_marks(i) & MARK_RELEASE) != 0 && fx[i].t > 0 {
            shot_fire(i)
            continue
        }
        if !s.on { continue }
        s.x += s.vx
        s.t += 1
        if s.t > s.life || s.x > FIGHT_WALL || s.x < -FIGHT_WALL { s.on = false }
    }
    // two shots that meet: the weaker goes, both if they are as strong (two waves both go)
    let s0 = &fight.shot[0]
    let s1 = &fight.shot[1]
    if s0.on && s1.on && abs(s0.x - s1.x) < s0.half + s1.half {
        var cy = 1.5
        if s0.lvl > 0 && s1.lvl > 0 { cy = (ORB_Y0 + ORB_Y1) / 2 }
        let cx = (s0.x + s1.x) / 2
        if s0.str <= s1.str { s0.on = false }
        if s1.str <= s0.str { s1.on = false }
        ev_add(Ev.Clash, 0, cx, cy, 1)
    }
    for i in 0..2 {
        if !fight.shot[i].on { continue }
        let j = other(i)
        // the leader first, then a split Twins' partner (twins.akr)
        if !shot_try(i, j) && twins_on(j) { shot_try(i, j + 2) }
    }
}

// Side i's shot against body j: whether it hit (or was blocked, parried, absorbed).
private fn shot_try(i: s32, j: s32) -> bool {
    let s = &fight.shot[i]
    if !hittable(j) { return false }
    let w = vec4(s.x - s.half, s.y0, s.x + s.half, s.y1)
    let bj = &fbox[j]
    for q in 0..bj.n {
        let hu = &bj.b[q]
        if hu.kind != BOX_HURT { continue }
        let u = world_box(j, hu)
        if overlap(w, u) {
            s.on = false
            var p = vec2(s.x, 1.5)
            if s.lvl > 0 { p = vec2(s.x, (s.y0 + s.y1) / 2) }
            let h = shot_hit(s)
            c_pt[i] = p
            if parrying(j) {
                fx[j].riposte = true
                let rip = find_mark(fight.f[j].body, Mv.sp_d, MARK_RIPOSTE)
                if rip >= 0 { fx[j].t = rip }
                fight.freeze = 6
                ev_add(Ev.Parry, j, p.x, p.y, 1)
            } else if fight.f[j].mv == Mv.block {
                blocked(i, j, h, Mv.sp_n, p, true)
            } else if tank_armoured(j, Mv.sp_n) {
                absorb(i, j, h, p, true)
                shadow_hexed(i, j, s)           // the Hex Bolt curses through armour
            } else {
                struck(i, j, h, p, true)
                shadow_hexed(i, j, s)
            }
            return true
        }
    }
    return false
}

// ---- the chemical reaction: Beam's Reaction Prime (sp_d) starts it on its release frame, unless
// a hit came first (the hit ends the move, so the frame never comes) or one is still running

fn react_tick() {
    for i in 0..2 {
        let f = &fight.f[i]
        if f.mv == Mv.sp_d && meter_power(f.mech) == Power.Chemical && fx[i].pause == 0
            && (cur_marks(i) & MARK_RELEASE) != 0 && fx[i].t > 0 && f.react == 0 {
            meter_react(f)
        }
    }
}

// ---- the walls, the separation limit and the push boxes

fn push_half(i: s32) -> fixed {
    let b = &fbox[i]
    for k in 0..b.n {
        if b.b[k].kind == BOX_PUSH { return (b.b[k].x1 - b.b[k].x0) / 2 }
    }
    return 0.0
}

fn bound() {
    load_boxes()
    let f0 = &fight.f[0]
    let f1 = &fight.f[1]
    let busy = f0.mv == Mv.throw || f1.mv == Mv.throw || tank_holding(0) || tank_holding(1)
    // push apart on the ground
    let p0 = push_half(0)
    let p1 = push_half(1)
    if !busy && grounded(0) && grounded(1) && p0 > 0.0 && p1 > 0.0 {
        let d = f1.x - f0.x
        let need = p0 + p1
        if abs(d) < need {
            var s = sgn(d)
            if s == 0 { s = sgn(fx[1].prev_x - fx[0].prev_x) }
            if s == 0 { s = f0.facing }
            let half = (need - abs(d)) / 2
            f0.x -= fixed(s) * half
            f1.x += fixed(s) * half
            // a mech against a wall stays; the other takes the whole push
            let w0 = wall_clamp(0)
            let w1 = wall_clamp(1)
            if w0 != 0.0 { f1.x += w0 }
            if w1 != 0.0 { f0.x += w1 }
        }
    }
    // the walls: a sliding defender stopped by one passes the rest to its attacker
    for i in 0..2 {
        let c = wall_clamp(i)
        if c != 0.0 { pass_back(i, c) }
    }
    // the separation limit
    let sep = abs(f1.x - f0.x)
    if sep > FIGHT_MAX_SEP {
        let excess = sep - FIGHT_MAX_SEP
        let s = sgn(f1.x - f0.x)                // f0 is on the -s side
        let out0 = (fx[0].prev_x - f0.x) * s    // how far each moved outward this frame
        let out1 = (f1.x - fx[1].prev_x) * s
        var g0 = 0.0
        var g1 = 0.0
        if out0 > 0.0 && out1 > 0.0 {
            g0 = min(out0, excess / 2)
            g1 = excess - g0
        } else if out0 > 0.0 {
            g0 = min(out0, excess)
            g1 = excess - g0
        } else {
            g1 = excess
        }
        f0.x += fixed(s) * g0
        f1.x -= fixed(s) * g1
        if fx[0].slide_by >= 0 && g0 > 0.0 { pass_back(0, fixed(s) * g0) }
        if fx[1].slide_by >= 0 && g1 > 0.0 { pass_back(1, -fixed(s) * g1) }
    }
    if twins_in_fight { twins_bound() }     // the partners: walls, leash, the other mech's push box
}

// Keeps i inside the walls; returns how far it was moved back (signed).
fn wall_clamp(i: s32) -> fixed {
    let f = &fight.f[i]
    let lim = FIGHT_WALL - STATS[f.body].push
    if f.x > lim { let c = lim - f.x; f.x = lim; return c }
    if f.x < -lim { let c = -lim - f.x; f.x = -lim; return c }
    return 0.0
}

// i was stopped by a wall or the limit by c (signed) while sliding from a hit: the attacker
// slides back instead.
private fn pass_back(i: s32, c: fixed) {
    let a = fx[i].slide_by
    if a < 0 || fx[i].slide == 0.0 { return }
    if !grounded(a) || fight.f[a].mv == Mv.throw { return }
    fx[a].slide = -fx[i].slide
    fx[a].slide_by = -1
    fx[i].slide = 0.0
    fx[i].slide_by = -1
    fight.f[a].x += c
}

// The frame D draws.
fn draw_frame(i: s32) -> fixed {
    let f = &fight.f[i]
    let x = &fx[i]
    let n = mv_len(f.body, f.mv)
    if (f.mv == Mv.hit_high || f.mv == Mv.hit_low) && x.stun_len > 0 {
        return min(fixed(x.t * n) / x.stun_len, fixed(n - 1))
    }
    if f.mv == Mv.block && x.stun > 0 { return fixed(n - 1) }
    return fixed(cur_frame(i))
}

// ---- Tank (mx-tank): super armour and the command grabs (MOVES.md, "Tank")

// Whether a hit from move mv on j is absorbed by super armour: j on an armour frame, on the
// ground, and the hit not a super's.
fn tank_armoured(j: s32, mv: Mv) -> bool {
    if mv == Mv.super || !grounded(j) { return false }
    return cur_marks(j) & MARK_ARMOUR != 0
}

// i's hit h is absorbed by j's armour at p: j takes the damage (unscaled) and keeps its move;
// both freeze for the hitstop; the attacker gets a blocked hit's meter and no chain.
fn absorb(i: s32, j: s32, h: Hit, p: vec2, shot: bool) {
    let a = &fight.f[i]
    let d = &fight.f[j]
    damage(j, meter_damage(d, h.dmg), true)
    meter_on_hit(&fight.f[i & 1], false, shot)
    fight.freeze = max(fight.freeze, h.stop)
    fight.flash_side = -1
    d.flash = h.stop
    fight.shake = fixed(h.power + 1) * 0.1
    ev_add(Ev.Armour, i & 1, p.x, p.y, h.power)
    if hp(j) <= 0 { knock_out(j) }
}

// Tank's command grabs: the Atomic Clinch and Chain Reaction.
fn tank_cmd_grab(mv: Mv) -> bool { return mv == Mv.sp_f || mv == Mv.super }

// The slam sections' frames, found in the data once: [0] the Clinch, [1] Chain Reaction.
var tank_found: bool
var tank_rip: [2]s32            // MARK_RIPOSTE: the section's first frame
var tank_rel: [2]s32            // MARK_RELEASE: the slam

fn tank_find() {
    if tank_found { return }
    tank_rip[0] = find_mark(Mech.Tank, Mv.sp_f, MARK_RIPOSTE)
    tank_rel[0] = find_mark(Mech.Tank, Mv.sp_f, MARK_RELEASE)
    tank_rip[1] = find_mark(Mech.Tank, Mv.super, MARK_RIPOSTE)
    tank_rel[1] = find_mark(Mech.Tank, Mv.super, MARK_RELEASE)
    tank_found = true
}

// The frame the move's slam section starts (MARK_RIPOSTE), or -1.
fn tank_slam_rip(mv: Mv) -> s32 {
    tank_find()
    if mv == Mv.sp_f { return tank_rip[0] }
    if mv == Mv.super { return tank_rip[1] }
    return -1
}

private fn tank_slam_rel(mv: Mv) -> s32 {
    tank_find()
    if mv == Mv.sp_f { return tank_rel[0] }
    if mv == Mv.super { return tank_rel[1] }
    return -1
}

// Whether i's hit boxes this frame are a command grab's catch.
fn tank_grab_box(i: s32) -> bool {
    let f = &fight.f[i]
    return f.mech == Mech.Tank && tank_cmd_grab(f.mv) && !fx[i].riposte
}

// Whether i is in a slam section, holding the other.
fn tank_holding(i: s32) -> bool {
    let f = &fight.f[i]
    return f.mech == Mech.Tank && tank_cmd_grab(f.mv) && fx[i].riposte
}

// Chain Reaction also catches a mech in hit- or blockstun on the ground.
fn tank_super_catches(i: s32, j: s32) -> bool {
    if fight.f[i].mech != Mech.Tank || fight.f[i].mv != Mv.super || !grounded(j) { return false }
    let o = &fight.f[j]
    return o.mv == Mv.hit_high || o.mv == Mv.hit_low || (o.mv == Mv.block && fx[j].stun > 0)
}

// A command grab caught: the animation jumps to the slam section, the other is held.
fn tank_catch(i: s32) {
    let j = vic[i]
    let f = &fight.f[i]
    let rip = tank_slam_rip(f.mv)          // (catch() reported the Grab)
    if rip >= 0 { fx[i].t = rip }
    fx[i].riposte = true
    fx[i].contact = true                    // a catch, not a whiff
    fx[i].slide = 0.0
    let combo = fx[j].combo
    set_mv(j, Mv.thrown_slam)
    fx[j].combo = combo                     // Chain Reaction after a chain is scaled
    fx[j].stun = 0
    fx[j].slide = 0.0
    fx[j].break_t = 0                       // no break
    fight.f[j].facing = -f.facing
}

// One frame of the slam: the other lifted overhead, held, slammed down in front (MOVES.md,
// "thrown_slam"); the damage on the slam.
fn tank_slam_tick(i: s32) {
    let f = &fight.f[i]
    let j = vic[i]
    let o = &fight.f[j]
    if o.mv != Mv.thrown_slam { return }
    let rip = tank_slam_rip(f.mv)
    let rel = tank_slam_rel(f.mv)
    let s = fx[i].t - rip
    fx[j].t = s
    let ft = fixed(f.facing)
    if s <= 14 {
        let k = fixed(s) / 14
        o.x = f.x + ft * (3.0 - 2.2 * k)
        o.y = 6.5 * k
    } else if s <= 24 {
        o.x = f.x + ft * 0.8
        o.y = 6.5
    } else {
        let k = clamp(fixed(s - 24) / 9, 0.0, 1.0)
        o.x = f.x + ft * (0.8 + 2.8 * k)
        o.y = 6.5 * (1.0 - k)
    }
    if fx[i].t == rel {
        let h = move_hit(Mech.Tank, f.mv)
        damage(j, meter_damage(o, combo_scale(h.dmg, fx[j].combo)), true)
        meter_on_hit(f, true, false)
        o.y = 0.0
        o.mv = Mv.hit_air
        fx[j].t = mv_len(o.body, Mv.hit_air) - 1
        fx[j].air = true
        fx[j].vy = h.launch
        fx[j].vx = ft * 0.06
        fight.freeze = h.stop
        fight.flash_side = -1
        o.flash = h.stop
        fight.shake = fixed(h.power) * 0.3
        ev_add(Ev.Throw, i, o.x, 0.0, h.power)
        if hp(j) <= 0 { knock_out(j) }
    }
}
