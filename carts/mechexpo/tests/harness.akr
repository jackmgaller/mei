// Mech Expo 2000's fight test cases (C's). Run one with tests/run.sh SCENARIO FRAMES OUT;
// tests/check.sh runs them all. tools/cart_scenario.sh writes the cart: the SCENARIO constant,
// this file and the fight (../fight.akr). The fighters are drawn as their boxes (hurt blue, hit
// red, push yellow), with health, meters, the timer and the moves as text.
//
//  0  play: you (pad 1) against the CPU (level 2), the Hero against the Double-blade Hero (not
//     in check.sh; build it with run.sh 0 1 OUT and play OUT.mei in mei)
//  1  a round won by KO: the Hero's Tip Thrust until the Double-blade Hero falls; the win counts
//     and round 2 starts
//  2  time up: one Guard Cut, then 60 seconds of nothing: the Hero wins on time
//  3  block and chip: a blocked Tip Thrust does nothing; a blocked Charge Slash and a blocked
//     wave chip
//  4  a grab beats block: the Hero grabs a blocking Double-blade Hero and throws it
//  5  grab breaks: Y pressed in the window breaks a grab; two grabs at once break each other
//  6  the Hero's chain: Guard Cut, Tip Thrust, Charge Slash, three hits, scaled damage
//  7  the Double-blade Hero's chain: Twin Cut twice, Cross Lunge, Charge Slash, four hits
//  8  the kinetic super: a full bar, A + B: the flash, the hit, the meter spent; and the
//     kinetic meter filling from hits
//  9  the antimatter super from zero: the debt, the extra damage taken in debt, the reactor
//     climbing back
// 10  CPU against CPU (level 2, the Hero against the Double-blade Hero): a whole match, twice;
//     both runs must give the same result frame for frame. Prints the rounds
// 11  the separation limit and the walls: walking apart stops at 36 m; at a wall the attacker
//     is pushed back instead of the defender
// 12  the Parry and the anti-air: the Hero parries a Twin Cut and ripostes; a Rising Arc knocks
//     a jumping Double-blade Hero down
// 13  the ladder's levels: the Hero at level 1 against the Hero at level 2, matches over several
//     seeds (a measurement: prints the wins; level 2 must win more)
// 14  the budget: CPU against CPU with both mechs drawn by anim.akr (the real models, depth
//     buffer and perspective on): CPU and GPU within their budgets, under 4,000 triangles; prints
//     the fight's own cost a frame
// 16  (a measurement, not in check.sh) CPU level 2 against level 2 over 30 matches, each
//     pairing and seeds: round lengths, KOs against time-ups, hits, blocks, supers, who wins
// 17  (a measurement, not in check.sh) frame advantage: every attack of both mechs on block and
//     on hit against a standing mech, from the engine itself (MOVES.md's tables)
// 18  the Vault Throw: the Double-blade Hero's victim plays thrown_vault, lands behind it
//     (the sides swap), knocked down
// 19  the air attack: a jumping Hero's Falling Cleave, pressed on the way down, hits a standing
//     Double-blade Hero, and the Hero lands with the air attack's landing; then the same against
//     a Double-blade Hero holding block (no damage)
// 100-108 Shadow's (mx-shadow-fight): the Hex Bolt and the Siphon, the curse's time, the Rift
//     Mine, Shadow Sneak, Eclipse Rise, Phantom Grip, Total Eclipse, throws with Tank and the
//     Twins, the CPU; listed with their code at the end (109 is in tests/shadow/harness.akr)
// 150-151 Seraph's (mx-seraph, phase 1: Shadow's moves on Seraph's body): against Shadow and
//     against the Hero; listed with their code at the end (152-157 are in tests/seraph/harness.akr)
// 40-49 Tank's (mx-tank): armour, its grabs and throws, the nuclear meter, its super, the CPU
//     and the budget; listed with their code at the end of this file
// 60-67 the Twins' (mx-twins-fight): combining and splitting, the partner, hits and throws on and
//     by both forms, the fusion meter, the super, the CPU; listed with their code at the end
//     (68 and 69 are in tests/twins/harness.akr)
// 15  training: the dummy blocking, standing (health refills after a moment, meter kept full),
//     the dummy's CPU, no clock, no KO; the move lists; a super cancelled from a chain, and A
//     then B two frames apart (the Guard Cut becomes the super)

import "depth.akr"

var frames: s32
var evc: [len(Ev)]s32           // events so far, by kind
var evc_side: [2][len(Ev)]s32
var done: bool
var mark: s32                   // a frame the scenario noted
var mark2: s32
var mark_h: s32
var stage: s32                  // the scenario's own steps
var next_at: s32                // the next scripted press, in frames
var tick_per_frame = 1

// scenario 10's checksums
var sum: u32
var sum_first: u32
var run_n: s32
var result_first: s32
var frames_first: s32
var rounds_ko: s32
var rounds_time: s32
var round_frames: s32
var round_start: s32
var ko_frames_total: s32

// scenario 13
var lad_match: s32
var lad_wins: [2]s32

// scenario 14
var peak_cpu: s32
var peak_gpu: s32
var peak_tris: s32
var late: s32
var assets_ready: bool
var fight_cyc: s32              // the fight_tick() cost, its peak
var peak_fight: s32

const MV_NAMES: [len(Mv)]*u8 = [
    "idle", "walk_f", "walk_b", "crouch", "jump", "land", "block", "hit_high", "hit_low",
    "hit_air", "knockdown", "getup", "ko", "win", "intro", "atk_n", "atk_f", "atk_d", "atk_air",
    "sp_n", "sp_f", "sp_u", "sp_d", "grab", "grab_whiff", "throw", "thrown", "grab_break", "super",
    "thrown_vault", "thrown_slam", "combine", "split",
]
const EV_NAMES: [len(Ev)]*u8 = [
    "Hit", "Block", "Chip", "Whiff", "Grab", "Throw", "Break", "Land", "Step", "MeterFull",
    "Super", "Ko", "TimeUp", "Shot", "Parry", "Clash", "Swing", "Armour", "RingOut", "Curse", "Mine",
    "Snare", "MineGone",
]

fn init() {
    if SCENARIO >= 30 && SCENARIO <= 39 { beam_init(); return }     // Beam's (mx-beam)
    match SCENARIO {
        0 => fight_init(Mech.Hero, Mech.Doubleblade, FightMode.VsCpu, 2)
        1, 2, 3, 4, 5, 6, 8, 11, 19 => fight_init(Mech.Hero, Mech.Doubleblade, FightMode.Versus, 0)
        7, 9, 18 => fight_init(Mech.Doubleblade, Mech.Hero, FightMode.Versus, 0)
        12 => fight_init(Mech.Doubleblade, Mech.Hero, FightMode.Versus, 0)
        10, 14 => fight_init(Mech.Hero, Mech.Doubleblade, FightMode.VsCpu, 2)
        13 => start_ladder_match()
        16 => start_stat_match()
        17 => fight_init(Mech.Hero, Mech.Hero, FightMode.Versus, 0)
        15 => {
            fight_init(Mech.Hero, Mech.Doubleblade, FightMode.Training, 0)
            train(Dummy.Block, true)
        }
        else => {}
    }
    if tk_scenario() {
        tk_init()
        return
    }
    if tw_scenario() {
        tw_init()
        return
    }
    if sh_scenario() {
        sh_init()
        return
    }
    if sr_scenario() {
        sr_restart()
        return
    }
    if SCENARIO == 10 || SCENARIO == 13 || SCENARIO == 16 { tick_per_frame = 40 }
    if SCENARIO >= 1 && SCENARIO <= 9 || SCENARIO == 11 || SCENARIO == 12 || SCENARIO == 18 || SCENARIO == 19 { skip_intro() }
    match SCENARIO {
        1 => place(-5.0, 5.0)
        2 => place(-3.0, 3.0)
        3 => place(-4.5, 4.5)
        4 => place(-2.0, 2.0)
        5 => place(-2.0, 2.0)
        6 => place(-3.0, 3.0)
        7 => place(-2.5, 2.5)
        8 => { place(-6.0, 6.0); fight.f[0].meter = METER_BAR }
        9 => place(-6.0, 6.0)
        12 => place(-2.5, 2.5)
        15 => place(-5.0, 5.0)
        18 => place(-2.0, 2.0)
        19 => place(-4.0, 4.0)
        else => {}
    }
}

private fn dbh() -> s32 { return STATS[Mech.Doubleblade].health }
private fn dmg(m: s32, mv: Mv) -> s32 { return move_hit(m as Mech, mv).dmg }
private fn chip(m: s32, mv: Mv) -> s32 { return move_hit(m as Mech, mv).chip }

private fn skip_intro() {
    fight.phase = Phase.Fight
    fight.phase_t = 0
    set_mv(0, Mv.idle)
    set_mv(1, Mv.idle)
}

private fn place(x0: fixed, x1: fixed) {
    fight.f[0].x = x0
    fight.f[1].x = x1
}

private fn dist() -> fixed { return abs(fight.f[1].x - fight.f[0].x) }

fn update() {
    if SCENARIO == 17 {
        frame_data()
        return
    }
    for k in 0..tick_per_frame {
        if done && SCENARIO != 0 { return }
        frames += 1
        var p1: u32 = 0
        var p2: u32 = 0
        if SCENARIO == 0 {
            p1 = PAD1
            p2 = PAD2
        } else {
            p1 = script1()
            p2 = script2()
        }
        let c0 = cycle_count()
        if SCENARIO == 0 {
            fight_tick(p1, p2, stick(), stick2())
        } else {
            fight_tick(p1, p2, vec2(0.0, 0.0), vec2(0.0, 0.0))
        }
        fight_cyc = cycle_count() - c0
        peak_fight = max(peak_fight, fight_cyc)
        let ev = fight_events()
        for e in 0..ev.n {
            let k2 = ev.e[e].kind
            evc[k2] += 1
            let s = ev.e[e].side
            if s == 0 || s == 1 { evc_side[s][k2] += 1 }
        }
        check()
    }
}

// ---- the scripts: what pad 1 and pad 2 press

private fn at(f: s32) -> bool { return frames == f }

private fn script1() -> u32 {
    if SCENARIO >= 30 && SCENARIO <= 39 { return beam_script(0) }
    if tk_scenario() { return tk_script(0) }
    if tw_scenario() { return tw_script(0) }
    if sh_scenario() { return sh_script(0) }
    if sr_scenario() { return sh_script(0) }
    let a = &fight.f[0]
    let fwd = if_u(a.facing > 0, RIGHT, LEFT)
    match SCENARIO {
        1 => {
            if !actionable(0) { return 0 }
            if dist() > 9.6 { return fwd }
            if frames % 2 == 0 { return fwd | A }
            return 0
        }
        2 => { if at(5) { return A } }
        3 => {
            if at(5) { return fwd | A }
            if at(70) { return fwd | B }
            if at(170) { return B }
        }
        4, 18 => { if at(5) { return Y } }
        19 => {
            if at(5) || at(125) { return fwd | X }
            // A once, on the way down
            if a.mv == Mv.jump && fx[0].air && fx[0].vy < 0.0 && (stage == 0 || stage == 2) {
                stage += 1
                return A
            }
        }
        5 => {
            if at(5) { return Y }
            if at(120) { return Y }
        }
        6, 7 => return chain_press(0)
        8 => { if at(5) { return A | B } }
        9 => { if at(5) { return A | B } }
        10, 14 => return cpu_pad(0, 2)
        11 => {
            if frames < 600 { return if_u(a.facing > 0, LEFT, RIGHT) }
            if frames >= 1300 && frames < 2000 { return RIGHT }
            if at(2100) { return A }
        }
        12 => {
            if at(10) { return A }
            if at(200) { return fwd | X }
        }
        13 => return cpu_pad(0, 1)
        16 => return cpu_pad(0, 2)
        15 => {
            if frames < 300 && actionable(0) && dist() > 5.0 { return fwd }
            if frames < 300 && actionable(0) && frames % 30 == 0 { return A }
            if at(310) { place(-3.0, 3.0) }
            if at(320) { return A }
            if at(330) { return A | B }
            if at(450) { return A }
            if at(452) { return B }     // a moment after A: the Guard Cut becomes the super
        }
        else => {}
    }
    return 0
}

private fn script2() -> u32 {
    if SCENARIO >= 30 && SCENARIO <= 39 { return beam_script(1) }
    if tk_scenario() { return tk_script(1) }
    if tw_scenario() { return tw_script(1) }
    if sh_scenario() { return sh_script(1) }
    if sr_scenario() { return sh_script(1) }
    let b = &fight.f[1]
    let fwd = if_u(b.facing > 0, RIGHT, LEFT)
    match SCENARIO {
        3, 4 => return R
        19 => { if frames >= 120 { return R } }
        5 => { if frames == mark + 3 && mark > 0 && stage == 1 { return Y }; if at(120) { return Y } }
        9 => { if at(330) { return A } }
        11 => {
            if frames < 600 { return if_u(b.facing > 0, LEFT, RIGHT) }
            if frames >= 700 && frames < 1300 { return RIGHT }
            if frames >= 1300 && frames < 2000 { return RIGHT }
            if frames >= 2000 { return R }
        }
        12 => {
            if at(8) { return DOWN | B }
            if fight.f[0].mv == Mv.jump && fight.f[0].y > 0.0 && dist() < 7.0 && stage == 2 {
                stage = 3
                return UP | B
            }
        }
        else => {}
    }
    return 0
}

private fn if_u(c: bool, a: u32, b: u32) -> u32 {
    if c { return a }
    return b
}

// The chains of scenarios 6 and 7: the next button pressed a few frames after each hit.
private fn chain_press(i: s32) -> u32 {
    let a = &fight.f[i]
    let fwd = if_u(a.facing > 0, RIGHT, LEFT)
    if at(5) { return A }
    if frames != next_at { return 0 }
    let hits = evc_side[i][Ev.Hit]
    if a.mech == Mech.Hero {
        if hits == 1 { return fwd | A }
        if hits == 2 { return fwd | B }
    } else {
        if hits == 1 { return A }
        if hits == 2 { return fwd | A }
        if hits == 3 { return fwd | B }
    }
    return 0
}

// ---- the checks

private fn ok(s: *u8) {
    print("OK ")
    println(s)
    done = true
}

private fn show_state() {
    for i in 0..2 {
        let f = &fight.f[i]
        print("  side ")
        print_int(i)
        print(": ")
        print(MV_NAMES[f.mv])
        print(" t ")
        print_int(fx[i].t)
        print(" x ")
        print_fixed(f.x)
        print(" y ")
        print_fixed(f.y)
        print(" health ")
        print_int(f.health)
        print(" meter ")
        print_int(f.meter)
        println("")
    }
}

private fn check() {
    if SCENARIO >= 30 && SCENARIO <= 39 { beam_check(); return }
    match SCENARIO {
        1 => check_ko()
        2 => check_time()
        3 => check_block()
        4 => check_grab()
        5 => check_break()
        6, 7 => check_chain()
        8 => check_kinetic()
        9 => check_antimatter()
        10 => check_determinism()
        11 => check_limits()
        12 => check_parry()
        13 => check_ladder()
        14 => check_budget()
        15 => check_training()
        16 => check_stats()
        18 => check_vault()
        19 => check_air()
        else => {
            if tk_scenario() { tk_check() }
            if tw_scenario() { tw_check() }
            if sh_scenario() { sh_check() }
            if sr_scenario() { sr_check() }
        }
    }
}

private fn check_ko() {
    if stage == 0 && evc[Ev.Ko] > 0 {
        stage = 1
        mark = frames
        print("KO after ")
        print_int(frames)
        print(" frames, ")
        print_int(evc_side[0][Ev.Hit])
        println(" hits")
        assert_eq(fight.f[1].health, 0, "the loser's health")
        assert(fight.phase == Phase.Ko, "not in the KO phase")
        assert_eq(fight.round_winner, 0, "the round's winner")
    }
    if stage == 1 && fight.phase == Phase.RoundOver {
        stage = 2
        assert_eq(fight.wins[0], 1, "the win was not counted")
        assert_eq(fight.wins[1], 0, "the loser got a win")
        assert(fight.f[0].mv == Mv.win, "the winner does not pose")
    }
    if stage == 2 && fight.phase == Phase.Intro {
        assert_eq(fight.round, 2, "round 2")
        assert_eq(fight.f[1].health, fight.f[1].health_max, "health refilled")
        assert_eq(fight.timer, ROUND_FRAMES, "the clock reset")
        ok("a round won by KO, round 2 starts")
    }
}

private fn check_time() {
    if at(40) {
        assert_eq(fight.f[1].health, dbh() - dmg(0, Mv.atk_n), "the Guard Cut landed")
    }
    if evc[Ev.TimeUp] > 0 && stage == 0 {
        stage = 1
        print("time up at frame ")
        print_int(frames)
        println("")
        assert_eq(fight.timer, 0, "the timer")
        assert_eq(fight.round_winner, 0, "the healthier mech wins on time")
        assert(frames >= ROUND_FRAMES && frames <= ROUND_FRAMES + 20, "the round lasted 60 s (and the hitstop)")
    }
    if stage == 1 && fight.phase == Phase.RoundOver {
        assert_eq(fight.wins[0], 1, "the time-up win counted")
        ok("time up: the Hero wins on health")
    }
}

private fn check_block() {
    let d = &fight.f[1]
    if at(60) {
        assert_eq(evc[Ev.Block], 1, "the Tip Thrust was not blocked")
        assert_eq(evc[Ev.Hit], 0, "a hit through the block")
        assert_eq(d.health, dbh(), "a normal attack chipped")
        assert(d.x > 4.5, "no pushback on block")
    }
    if at(160) {
        assert_eq(evc[Ev.Block], 2, "the Charge Slash was not blocked")
        assert_eq(evc[Ev.Chip], 1, "no chip from the Charge Slash")
        assert_eq(d.health, dbh() - chip(0, Mv.sp_f), "the Charge Slash's chip")
        mark_h = d.health
    }
    if at(400) {
        assert_eq(evc[Ev.Shot], 1, "no wave")
        assert_eq(evc[Ev.Block], 3, "the wave was not blocked")
        assert_eq(evc[Ev.Chip], 2, "no chip from the wave")
        assert_eq(d.health, dbh() - chip(0, Mv.sp_f) - chip(0, Mv.sp_n), "the wave's chip")
        assert_eq(fight.f[0].meter, 3 * KIN_BLOCKED, "kinetic meter from blocked hits")
        ok("block stops attacks; specials chip")
    }
}

private fn check_grab() {
    if at(100) { assert(fight.f[1].mv == Mv.knockdown, "the thrown mech is not down") }
    if at(150) {
        assert_eq(evc[Ev.Grab], 1, "no grab")
        assert_eq(evc[Ev.Throw], 1, "no throw")
        assert_eq(evc[Ev.Hit] + evc[Ev.Block], 0, "a strike?")
        assert_eq(fight.f[1].health, dbh() - dmg(0, Mv.throw), "the throw's damage")
        ok("a grab beats block")
    }
}

private fn check_air() {
    let a = &fight.f[0]
    if a.mv == Mv.atk_air { mark2 = 1 }
    if a.mv == Mv.land && mark2 == 1 && mark == 0 { mark = fx[0].lag }
    if at(100) {
        assert_eq(mark2, 1, "the air attack never came out")
        assert_eq(evc[Ev.Hit], 1, "the Falling Cleave did not hit")
        assert_eq(fight.f[1].health, dbh() - dmg(0, Mv.atk_air), "the Falling Cleave's damage")
        assert_eq(mark, STATS[Mech.Hero].land_air, "not the air attack's landing")
        assert(grounded(0), "the Hero did not land")
        place(-4.0, 4.0)
        mark2 = 0
        stage = 2
    }
    if at(240) {
        assert_eq(mark2, 1, "the second air attack never came out")
        assert_eq(evc[Ev.Block], 1, "the Falling Cleave was not blocked")
        assert_eq(evc[Ev.Hit], 1, "the blocked Falling Cleave hit")
        assert_eq(fight.f[1].health, dbh() - dmg(0, Mv.atk_air), "damage through the block")
        ok("the air attack hits on the way down, and is blocked")
    }
}

private fn check_vault() {
    if evc[Ev.Grab] == 1 && stage == 0 {
        stage = 1
        assert(fight.f[1].mv == Mv.thrown_vault, "the vault's victim does not play thrown_vault")
    }
    if fight.f[1].mv == Mv.knockdown { mark2 = 1 }
    if at(100) {
        assert_eq(evc[Ev.Throw], 1, "no throw")
        assert_eq(fight.f[1].health, 1000 - dmg(1, Mv.throw), "the Vault Throw's damage")
        assert(fight.f[1].x < fight.f[0].x, "the sides did not swap")
        assert_eq(mark2, 1, "the thrown mech was not knocked down")
        ok("the Vault Throw swaps sides")
    }
}

private fn check_break() {
    if stage == 0 && evc[Ev.Grab] == 1 {
        stage = 1
        mark = frames               // pad 2 presses Y three frames later
    }
    if at(100) {
        assert_eq(evc[Ev.Break], 1, "the grab was not broken")
        assert_eq(evc[Ev.Throw], 0, "thrown anyway")
        assert_eq(fight.f[1].health, dbh(), "damage from a broken grab")
        assert(dist() > 4.0, "the break did not push them apart")
        stage = 2
        place(-2.0, 2.0)
    }
    if at(118) { assert(actionable(0) && actionable(1), "not ready for the second test") }
    if at(200) {
        assert_eq(evc[Ev.Break], 2, "two grabs at once did not break")
        assert_eq(evc[Ev.Throw], 0, "thrown")
        assert_eq(fight.f[0].health + fight.f[1].health, 1000 + dbh(), "damage")
        ok("grab breaks: in the window, and two grabs at once")
    }
}

private fn check_chain() {
    let i = 0
    let ev = fight_events()
    for e in 0..ev.n {
        if ev.e[e].kind == Ev.Hit && ev.e[e].side == i { next_at = frames + 3 }
    }
    if at(200) {
        let d = &fight.f[1]
        let hits = evc_side[i][Ev.Hit]
        print("chain hits ")
        print_int(hits)
        print(", damage ")
        print_int(d.health_max - d.health)
        println("")
        if fight.f[0].mech == Mech.Hero {
            assert_eq(hits, 3, "the Hero's chain is three hits")
            assert_eq(d.health, dbh() - (dmg(0, Mv.atk_n) + dmg(0, Mv.atk_f) * 80 / 100 + dmg(0, Mv.sp_f) * 65 / 100), "scaled damage")
            assert_eq(fight.f[0].meter, 3 * KIN_HIT, "kinetic meter: three landed hits")
            ok("the Hero's chain: A, FWD + A, FWD + B")
        } else {
            assert_eq(hits, 4, "the Double-blade Hero's chain is four hits")
            assert_eq(d.health, 1000 - (dmg(1, Mv.atk_n) + dmg(1, Mv.atk_n) * 80 / 100 + dmg(1, Mv.atk_f) * 65 / 100 + dmg(1, Mv.sp_f) * 65 / 100), "scaled damage")
            ok("the Double-blade Hero's chain: A, A, FWD + A, FWD + B")
        }
    }
}

private fn check_kinetic() {
    if at(3) { assert(fight.f[0].super_ok, "a full kinetic bar is not ready") }
    if at(6) {
        assert_eq(evc[Ev.Super], 1, "no super")
        assert_eq(fight.f[0].meter, 0, "the bar was not spent")
        assert(fight.freeze > 30, "no super flash")
        assert_eq(fight.flash_side, 0, "the flash's side")
    }
    if at(30) {
        assert_eq(fight.f[1].x, 6.0, "the other moved during the flash")
    }
    if at(140) {
        assert_eq(evc_side[0][Ev.Hit], 1, "the super missed")
        assert_eq(fight.f[1].health, dbh() - dmg(0, Mv.super), "the super's damage")
        assert_eq(fight.f[0].meter, KIN_HIT, "the super's hit fills the meter again")
        assert(!fight.f[0].super_ok, "the super is ready again")
        ok("the kinetic super")
    }
}

private fn check_antimatter() {
    let a = &fight.f[0]
    if at(3) {
        assert_eq(a.meter, 3, "the reactor does not fill")
        assert(a.super_ok, "the antimatter super is not ready from zero")
    }
    if at(6) {
        assert_eq(evc[Ev.Super], 1, "no super")
        assert(a.meter < -METER_BAR + 10, "no debt")
        assert(a.debt, "the debt is not shown")
        assert(!a.super_ok, "a second super in debt")
    }
    if at(160) {
        assert_eq(fight.f[1].health, 1000 - 320, "the antimatter super's damage")
        mark_h = a.health
    }
    if at(320) {
        // the Hero hits the mech in debt (the scripts move them close)
        place(fight.f[0].x, fight.f[0].x + 5.0 * fixed(a.facing))
        assert(actionable(0) && actionable(1), "not ready for the debt hit")
    }
    if at(400) {
        assert_eq(evc_side[1][Ev.Hit], 1, "the Hero's Guard Cut missed")
        assert_eq(a.health, dbh() - dmg(0, Mv.atk_n) * 5 / 4, "damage in debt is a quarter more")
        assert(a.meter > -METER_BAR + 300, "the reactor does not climb")
        print("meter after 400 frames ")
        print_int(a.meter)
        println("")
        ok("the antimatter super, debt and its damage")
    }
}

// a running checksum of the fight's state
private fn sum_frame() {
    for i in 0..2 {
        let f = &fight.f[i]
        sum = sum * 31 + (bits(f.x) as u32)
        sum = sum * 31 + (bits(f.y) as u32)
        sum = sum * 31 + (f.health as u32) + ((f.mv as u32) << 16)
        sum = sum * 31 + (f.meter as u32)
    }
}

private fn check_determinism() {
    sum_frame()
    if fight.phase == Phase.Fight && fight.phase_t == 1 { round_start = frames }
    if fight.phase == Phase.Ko && fight.phase_t == 1 {
        let len = frames - round_start
        print("  round ")
        print_int(fight.round)
        print(": ")
        if fight.timer <= 0 { print("time up") } else { print("KO") }
        print(" after ")
        print_int(len / 60)
        print(" s, winner ")
        print_int(fight.round_winner)
        print(", health ")
        print_int(fight.f[0].health)
        print(" / ")
        print_int(fight.f[1].health)
        println("")
        if run_n == 0 {
            if fight.timer <= 0 { rounds_time += 1 } else { rounds_ko += 1 }
        }
    }
    if fight.phase == Phase.MatchOver {
        print("run ")
        print_int(run_n + 1)
        print(": winner ")
        print_int(fight.winner)
        print(" after ")
        print_int(frames)
        print(" frames, checksum ")
        print_hex(sum)
        println("")
        if run_n == 0 {
            sum_first = sum
            result_first = fight.winner
            frames_first = frames
            run_n = 1
            sum = 0
            frames = 0
            fight_init(Mech.Hero, Mech.Doubleblade, FightMode.VsCpu, 2)
            return
        }
        assert_eq(sum, sum_first, "the two runs differ")
        assert_eq(fight.winner, result_first, "the winner differs")
        assert_eq(frames, frames_first, "the length differs")
        print("rounds by KO ")
        print_int(rounds_ko)
        print(", by time ")
        print_int(rounds_time)
        println("")
        ok("CPU against CPU twice: the same match")
    }
}

private fn check_limits() {
    let a = &fight.f[0]
    let b = &fight.f[1]
    assert(dist() <= FIGHT_MAX_SEP, "further apart than the limit")
    assert(a.x >= -stage_now().half && b.x <= stage_now().half, "through a wall")
    if at(599) {
        assert_eq(dist(), FIGHT_MAX_SEP, "walking apart did not stop at the limit")
        print("apart at ")
        print_fixed(a.x)
        print(" and ")
        print_fixed(b.x)
        println("")
    }
    if at(1299) {
        assert_eq(dist(), FIGHT_MAX_SEP, "walking away alone did not stop at the limit")
    }
    if at(1999) {
        assert_eq(b.x, stage_now().half - STATS[b.mech].push, "not at the wall")
        assert(dist() < 4.0, "the Hero did not follow")
        mark_h = bits(a.x)
    }
    if at(2130) {
        assert_eq(evc[Ev.Block], 1, "the Guard Cut was not blocked")
        assert_eq(b.x, stage_now().half - STATS[b.mech].push, "the defender left the wall")
        assert(a.x < from_bits(mark_h) - 0.3, "the attacker was not pushed back")
        print("pushed back ")
        print_fixed(from_bits(mark_h) - a.x)
        println(" m at the wall")
        ok("the separation limit and the walls")
    }
}

private fn check_parry() {
    // side 0 the Double-blade Hero attacks; side 1 the Hero parries
    if stage == 0 && evc[Ev.Parry] > 0 {
        stage = 1
        assert(fx[0].pause > 0, "the parried attacker is not frozen")
    }
    if at(120) {
        assert_eq(evc[Ev.Parry], 1, "the Twin Cut was not parried")
        assert_eq(evc_side[1][Ev.Hit], 1, "the riposte missed")
        assert_eq(fight.f[0].health, dbh() - dmg(0, Mv.sp_d), "the riposte's damage")
        assert_eq(fight.f[1].health, 1000, "the parried hit did damage")
    }
    if at(190) {
        // the roles for the anti-air: the Double-blade Hero jumps in, the Hero rises
        place(-10.0, 0.0)
        stage = 2
        assert(actionable(0) && actionable(1), "not ready for the anti-air")
    }
    if stage >= 2 && fight.f[0].mv == Mv.knockdown { mark2 = 1 }
    if at(330) {
        assert_eq(evc_side[1][Ev.Hit], 2, "the Rising Arc missed")
        assert_eq(mark2, 1, "the jumper was not knocked down")
        ok("the Parry and the anti-air")
    }
}

private fn start_ladder_match() {
    fight_init(Mech.Hero, Mech.Hero, FightMode.VsCpu, 2)
    cpu_init(1000 + lad_match * 7919)
    tick_per_frame = 40
}

private fn check_ladder() {
    if fight.phase != Phase.MatchOver { return }
    let w = fight.winner
    if w == 0 || w == 1 { lad_wins[w] += 1 }
    lad_match += 1
    if lad_match < 6 {
        start_ladder_match()
        return
    }
    print("level 1 won ")
    print_int(lad_wins[0])
    print(", level 2 won ")
    print_int(lad_wins[1])
    println(" of 6 matches")
    assert(lad_wins[1] > lad_wins[0], "level 2 is not stronger than level 1")
    ok("the ladder's levels")
}

private fn check_budget() {
    if frames > 3 {
        if frame_ticks() > 1 { late += 1 }
        peak_cpu = max(peak_cpu, cpu_used())
        peak_gpu = max(peak_gpu, gpu_used())
        peak_tris = max(peak_tris, tris_drawn())
    }
    if frames == 1800 {
        print("peak cpu ")
        print_int(peak_cpu)
        print(", gpu ")
        print_int(peak_gpu)
        print(", triangles ")
        print_int(peak_tris)
        print(", late frames ")
        print_int(late)
        print(", the fight's peak ")
        print_int(peak_fight)
        println(" cycles")
        assert(peak_cpu <= CPU_BUDGET, "over the CPU budget")
        assert(peak_gpu <= GPU_BUDGET, "over the GPU budget")
        assert(peak_tris < 4000, "over 4,000 triangles")
        ok("the budget with two mechs drawn")
    }
}

private fn train(d: Dummy, meter: bool) {
    var o = TrainOpts { dummy: d, refill_health: true, refill_meter: meter }
    fight_training(&o)
}

private fn check_training() {
    let d = &fight.f[1]
    if at(290) {
        assert(evc[Ev.Block] >= 3, "the dummy did not block")
        assert_eq(evc[Ev.Hit], 0, "the blocking dummy was hit")
        assert_eq(fight.timer, ROUND_FRAMES, "the clock runs in training")
        assert_eq(fight.f[0].meter, METER_BAR, "the meter is not kept full")
        train(Dummy.Stand, true)
    }
    if at(340) { assert(d.health < d.health_max, "the standing dummy was not hit") }
    if at(440) { assert_eq(evc[Ev.Super], 1, "no super in training") }
    if at(600) {
        assert_eq(evc[Ev.Super], 2, "A then B two frames later is not the super")
        assert(d.health > 0, "a KO in training")
    }
    if at(700) {
        assert_eq(d.health, d.health_max, "the dummy's health did not refill")
        assert(fight.phase == Phase.Fight, "the training ended")
        train(Dummy.Cpu, false)
    }
    if at(1500) {
        assert(evc_side[1][Ev.Swing] + evc_side[1][Ev.Grab] + evc_side[1][Ev.Shot] > 0, "the dummy's CPU did nothing")
        assert_eq(fight_moves(Mech.Hero).n, 15, "the Hero's move list")
        assert_eq(fight_moves(Mech.Doubleblade).n, 15, "the Double-blade Hero's move list")
        ok("training: the dummy, refills, no clock, no KO")
    }
}

// ---- scenario 16: statistics

var st_rounds: s32
var st_ko: s32
var st_len: s32
var st_len_max: s32
var st_len_min = 100000
var st_r0: s32
var st_mwins: [2][2]s32         // [mech][won]
var st_ev: [len(Ev)]s32
var st_side_hits: [2]s32        // by mech
var st_super: [2]s32            // by mech
var st_x_wins: [2]s32           // the cross matches (Hero against Double-blade): wins by mech
var st_debt_t: s32              // frames the Double-blade Hero spent in debt
var st_db_t: s32                // frames it fought
var st_dmg: [2]s32              // damage dealt by mech (health lost by the other)
var st_prev_h: [2]s32
var st_hit_power: [4]s32

private fn stat_mechs() -> ivec4 {
    let k = lad_match % 3
    if k == 0 { return ivec4(0, 1, 0, 0) }
    if k == 1 { return ivec4(1, 0, 0, 0) }
    return ivec4(lad_match % 2, lad_match % 2, 0, 0)
}

private fn start_stat_match() {
    let m = stat_mechs()
    fight_init(m.x as Mech, m.y as Mech, FightMode.VsCpu, 2)
    cpu_init(77 + lad_match * 104729)
    for k in 0..len(Ev) { evc[k] = 0 }
}

private fn check_stats() {
    let ev = fight_events()
    for e in 0..ev.n {
        st_ev[ev.e[e].kind] += 1
        if ev.e[e].kind == Ev.Hit { st_side_hits[fight.f[ev.e[e].side].mech] += 1; st_hit_power[ev.e[e].power] += 1 }
        if ev.e[e].kind == Ev.Super { st_super[fight.f[ev.e[e].side].mech] += 1 }
    }
    if fight.phase == Phase.Fight && fight.phase_t == 1 {
        st_r0 = frames
        st_prev_h[0] = fight.f[0].health
        st_prev_h[1] = fight.f[1].health
    }
    if fight.phase == Phase.Fight || fight.phase == Phase.Ko {
        for i in 0..2 {
            let lost = st_prev_h[i] - fight.f[i].health
            if lost > 0 { st_dmg[fight.f[1 - i].mech] += lost }
            st_prev_h[i] = fight.f[i].health
            if fight.f[i].mech == Mech.Doubleblade && fight.phase == Phase.Fight {
                st_db_t += 1
                if fight.f[i].debt { st_debt_t += 1 }
            }
        }
    }
    if fight.phase == Phase.Ko && fight.phase_t == 1 {
        let n = frames - st_r0
        st_rounds += 1
        st_len += n
        st_len_max = max(st_len_max, n)
        st_len_min = min(st_len_min, n)
        if fight.timer > 0 { st_ko += 1 }
    }
    if fight.phase != Phase.MatchOver { return }
    if fight.winner == 0 || fight.winner == 1 {
        let w = fight.winner
        st_mwins[fight.f[w].mech][1] += 1
        st_mwins[fight.f[1 - w].mech][0] += 1
        if fight.f[0].mech != fight.f[1].mech { st_x_wins[fight.f[w].mech] += 1 }
    }
    lad_match += 1
    if lad_match < 30 {
        start_stat_match()
        return
    }
    print("rounds ")
    print_int(st_rounds)
    print(", by KO ")
    print_int(st_ko)
    print(", length avg ")
    print_int(st_len / st_rounds / 60)
    print(" s (")
    print_int(st_len_min / 60)
    print(" to ")
    print_int(st_len_max / 60)
    println(" s)")
    print("per round: hits ")
    print_int(st_ev[Ev.Hit] * 10 / st_rounds)
    print("/10, blocks ")
    print_int(st_ev[Ev.Block] * 10 / st_rounds)
    print("/10, throws ")
    print_int(st_ev[Ev.Throw] * 10 / st_rounds)
    print("/10, breaks ")
    print_int(st_ev[Ev.Break] * 10 / st_rounds)
    print("/10, supers ")
    print_int(st_ev[Ev.Super] * 10 / st_rounds)
    print("/10, whiffs ")
    print_int(st_ev[Ev.Whiff] * 10 / st_rounds)
    print("/10, parries ")
    print_int(st_ev[Ev.Parry] * 10 / st_rounds)
    println("/10")
    print("Hero matches won/lost ")
    print_int(st_mwins[0][1])
    print("/")
    print_int(st_mwins[0][0])
    print(", Double-blade ")
    print_int(st_mwins[1][1])
    print("/")
    print_int(st_mwins[1][0])
    print("; hits landed by Hero ")
    print_int(st_side_hits[0])
    print(", by Double-blade ")
    print_int(st_side_hits[1])
    println("")
    print("supers by Hero ")
    print_int(st_super[0])
    print(", by Double-blade ")
    print_int(st_super[1])
    print("; Hero against Double-blade: wins ")
    print_int(st_x_wins[0])
    print(" to ")
    print_int(st_x_wins[1])
    println("")
    print("damage dealt by Hero ")
    print_int(st_dmg[0])
    print(", by Double-blade ")
    print_int(st_dmg[1])
    print("; Double-blade in debt ")
    print_int(st_debt_t * 100 / max(st_db_t, 1))
    print(" % of its time")
    print("; hits light/medium/heavy/super ")
    for k in 0..4 { print_int(st_hit_power[k]); print(" ") }
    println("")
    ok("statistics")
}

// ---- scenario 17: frame advantage

const FD_MOVES: [9]Mv = [Mv.atk_n, Mv.atk_f, Mv.atk_d, Mv.sp_n, Mv.sp_f, Mv.sp_u, Mv.sp_d, Mv.super, Mv.atk_air]
const FD_DIST: [9]fixed = [4.0, 6.0, 4.0, 6.0, 7.0, 3.6, 4.0, 8.0, 4.0]
var fd_case: s32

private fn frame_data() {
    if done { return }
    let n = len(FD_MOVES)
    // the Twins twice: Twins the combined form, Twin A the split form (twin A alone)
    if fd_case >= len(Mech) * 2 * n {
        ok("frame data")
        return
    }
    let m = (fd_case / (2 * n)) as Mech
    let k = (fd_case / 2) % n
    let block = fd_case % 2 == 0
    let mv = FD_MOVES[k]
    fd_case += 1
    if m == Mech.TwinB { return }           // the partner, not a fighter
    if mv == Mv.atk_air { return }          // depends on the jump's height
    if m == Mech.Doubleblade && (mv == Mv.sp_n || mv == Mv.sp_d) && block { }
    var fm = m
    if m == Mech.TwinA { fm = Mech.Twins }
    fight_init(fm, Mech.Hero, FightMode.Versus, 0)
    skip_intro()
    if m == Mech.Twins { fight.f[0].body = Mech.Twins }
    place(-FD_DIST[k] / 2, FD_DIST[k] / 2)
    if mv == Mv.super {
        fight.f[0].meter = METER_BAR
        start_super(0)
    } else {
        set_mv(0, mv)
    }
    var t = 0
    var contact = -1
    var att_free = -1
    var def_free = -1
    var kd = false
    while t < 400 {
        t += 1
        var p2: u32 = 0
        if block { p2 = R }
        fight_tick(0, p2, vec2(0.0, 0.0), vec2(0.0, 0.0))
        let ev = fight_events()
        for e in 0..ev.n {
            let kind = ev.e[e].kind
            if (kind == Ev.Hit || kind == Ev.Block) && contact < 0 { contact = t }
        }
        if fight.f[1].mv == Mv.hit_air || fight.f[1].mv == Mv.knockdown { kd = true }
        if contact >= 0 && att_free < 0 && actionable(0) { att_free = t }
        let d_ok = actionable(1) && fight.f[1].mv != Mv.block
        let d_ok2 = fight.f[1].mv == Mv.block && fx[1].stun == 0
        if contact >= 0 && def_free < 0 && (d_ok || d_ok2) && t > contact { def_free = t }
        if contact < 0 && t > 200 { break }
        if att_free >= 0 && def_free >= 0 { break }
    }
    print(MECH_NAMES[m])
    print(" ")
    print(MV_NAMES[mv])
    print(if_s(block, " on block: ", " on hit: "))
    if contact < 0 { println("no contact"); return }
    if kd { print("knockdown, ") }
    print_int(def_free - att_free)
    print(" (contact on frame ")
    print_int(contact)
    print(", attacker free ")
    print_int(att_free)
    print(", defender ")
    print_int(def_free)
    print(", gap ")
    print_fixed(dist())
    println(" m)")
}

private fn if_s(c: bool, a: *u8, b: *u8) -> *u8 {
    if c { return a }
    return b
}

// ---- the view: the fighters as boxes

const PX: fixed = 6.0           // pixels a metre
const FLOOR_Y = 200

private fn sx(x: fixed, cx: fixed) -> s32 { return 160 + ((x - cx) * PX) as s32 }
private fn sy(y: fixed) -> s32 { return FLOOR_Y - (y * PX) as s32 }

private fn draw_box(i: s32, b: *Box, cx: fixed) {
    let w = world_box(i, b)
    let x0 = sx(w.x, cx)
    let x1 = sx(w.z, cx)
    let y1 = sy(w.y)
    let y0 = sy(w.w)
    var col = rgb(90, 170, 255)
    if b.kind == BOX_HIT { col = rgb(255, 60, 50) }
    if b.kind == BOX_PUSH { col = rgb(240, 220, 60) }
    if b.kind == BOX_HIT { rect_blend(x0, y0, max(x1 - x0, 1), max(y1 - y0, 1), rgb(120, 20, 20), BLEND_ADD) }
    rect_outline(x0, y0, max(x1 - x0, 1), max(y1 - y0, 1), col, BLEND_NONE)
}

fn draw() {
    if SCENARIO == 14 || SCENARIO == 39 || SCENARIO == 49 {
        draw_mechs()
        return
    }
    cls(rgb(24, 28, 40))
    let cx = (fight.f[0].x + fight.f[1].x) / 2
    rect(0, FLOOR_Y, 320, 240 - FLOOR_Y, rgb(50, 56, 70))
    for k in 0..2 {
        let wx = sx(if_f(k == 0, -stage_now().half, stage_now().half), cx)
        rect(wx - 1, 40, 3, FLOOR_Y - 40, rgb(110, 110, 130))
    }
    var bx: Boxes
    for i in 0..4 {
        if i >= 2 && !twins_on(i - 2) { continue }
        let f = &fight.f[i]
        mv_boxes(f.body, f.mv, cur_frame(i), &bx)
        for k in 0..bx.n { draw_box(i, &bx.b[k], cx) }
        // the root and the facing
        let rx = sx(f.x, cx)
        let ry = sy(f.y)
        rect(rx - 1, ry - 1, 3, 3, rgb(255, 255, 255))
        rect(rx, ry - 40, f.facing * 8, 2, rgb(255, 255, 255))
        if i >= 2 { continue }
        if rift[i].on {
            rect_blend(sx(rift[i].x - MINE_HALF, cx), sy(MINE_H), (MINE_HALF * 2 * PX) as s32, (MINE_H * PX) as s32,
                       rgb(200, 80, 255), BLEND_ADD)
        }
        let s = &fight.shot[i]
        if s.on {
            rect_blend(sx(s.x - WAVE_HALF, cx), sy(WAVE_H), (WAVE_HALF * 2 * PX) as s32, (WAVE_H * PX) as s32,
                       rgb(80, 200, 255), BLEND_ADD)
        }
    }
    hud()
}

private fn if_f(c: bool, a: fixed, b: fixed) -> fixed {
    if c { return a }
    return b
}

private fn hud() {
    for i in 0..2 {
        let f = &fight.f[i]
        let w = f.health * 120 / f.health_max
        var x = 10
        if i == 1 { x = 190 }
        rect(x, 10, 120, 8, rgb(60, 20, 20))
        if i == 0 { rect(x + 120 - w, 10, w, 8, rgb(240, 200, 40)) } else { rect(x, 10, w, 8, rgb(240, 200, 40)) }
        // the meter: debt in violet to the left of zero
        rect(x, 222, 120, 6, rgb(30, 30, 50))
        let m = f.meter * 60 / METER_BAR
        if f.meter >= 0 { rect(x + 60, 222, max(m, 0), 6, rgb(80, 200, 255)) }
        else { rect(x + 60 + m, 222, -m, 6, rgb(170, 60, 230)) }
        rect(x + 60, 220, 1, 10, rgb(255, 255, 255))
        if f.super_ok { text(x, 210, "SUPER", rgb(255, 255, 255)) }
        text(x, 22, MV_NAMES[f.mv], rgb(200, 200, 220))
        for k in 0..fight.wins[i] { rect(x + k * 10, 34, 6, 6, rgb(255, 80, 60)) }
    }
    text_int(152, 10, (fight.timer + 59) / 60, rgb(255, 255, 255))
    if fight.phase == Phase.Intro { text(136, 100, "READY", rgb(255, 255, 255)) }
    if fight.phase == Phase.Ko { text(148, 100, "KO", rgb(255, 80, 60)) }
    if fight.phase == Phase.MatchOver { text(124, 100, "MATCH OVER", rgb(255, 255, 255)) }
}

// ---- scenario 14: both mechs drawn by anim.akr

private fn draw_mechs() {
    if !assets_ready {
        assets_load()
        assets_ready = true
    }
    cls(rgb(40, 48, 64))
    render_depth(true)
    render_perspective(true)
    let cx = (fight.f[0].x + fight.f[1].x) / 2
    let sep = dist()
    let back = clamp(sep * 1.1 + 18.0, 30.0, 52.0)
    camera(vec3(cx, 7.0, -back), 0.0)
    for i in 0..2 {
        let f = &fight.f[i]
        anim_draw(f.mech, f.mv, f.frame, anim_place(vec2(f.x, f.y), f.facing))
    }
    hud()
}

// ---- Beam's scenarios (30-39, mx-beam; MOVES.md, "Beam")
//
// 30  the chemical meter: the prime's exposed frames (no meter), the reaction from its release
//     frame (+2 a frame for 300 frames: half a bar), a second prime during a reaction does
//     nothing, a second reaction after the first burns out fills the bar: the super is there
// 31  a spoiled prime: hit before its release frame, no reaction; Beam's own hits give no meter
// 32  the Volt Orb: a tap hits (70), a full charge is blocked (chip 24), a charged orb hits (90)
// 33  the Volt Orb against the Kinetic Wave: a tap loses (the wave goes on and hits Beam), a full
//     orb wins (it goes on and knocks the Hero down), a charged orb trades (both go)
// 34  Beam's chain: Arc Jab, Static Lance, Arc Lance, three hits, scaled damage
// 35  the Raikō Overload: from a full bar, its flash, a hit 20 m away; blocked, chip 75; under a
//     bar no super
// 36  the Shock Grip beats block and throws the other about 9 m; the Thunder Pillar knocks a
//     jumping Hero down
// 37  CPU against CPU (level 2): Beam against the Hero, the Double-blade Hero against Beam, Beam
//     against Beam; each match finishes; the first is run twice and must be the same. Prints the
//     rounds and what Beam did (orbs, primes, supers)
// 38  what beats the orb: the Double-blade Hero's Void Step passes through it, twice
// 39  the budget with Beam drawn (its stand-in guard pose; anim.akr): CPU against CPU, Beam
//     against the Hero for 900 frames, then against the Double-blade Hero for 900

var bm_shot_pow: s32            // the power (the orb's level) of the last Shot event
var bm_match: s32
var bm_orbs: s32
var bm_primes: s32
var bm_supers: s32
var bm_prev_react: [2]s32
var bm_seg: s32                 // scenario 39: which pairing
var bm_peak_cpu: s32
var bm_peak_gpu: s32
var bm_peak_tris: s32
var bm_late: s32

private fn beam_init() {
    match SCENARIO {
        37 => start_beam_match()
        38 => fight_init(Mech.Beam, Mech.Doubleblade, FightMode.Versus, 0)
        39 => fight_init(Mech.Beam, Mech.Hero, FightMode.VsCpu, 2)
        else => fight_init(Mech.Beam, Mech.Hero, FightMode.Versus, 0)
    }
    if SCENARIO == 37 { tick_per_frame = 40 }
    if SCENARIO != 37 && SCENARIO != 39 { skip_intro() }
    match SCENARIO {
        30 => place(-10.0, 10.0)
        31 => place(-2.5, 2.5)
        32 => place(-8.0, 8.0)
        33 => place(-12.0, 12.0)
        34 => place(-2.5, 2.5)
        35 => { place(-10.0, 10.0); fight.f[0].meter = METER_BAR }
        36 => place(-2.0, 2.0)
        38 => place(-8.0, 8.0)
        else => {}
    }
}

// The mechs of scenario 37's matches: 0 Beam-Hero, 1 Double-blade-Beam, 2 Beam-Beam, 3 the first again.
private fn start_beam_match() {
    let k = bm_match % 3
    var a = Mech.Beam
    var b = Mech.Hero
    if k == 1 { a = Mech.Doubleblade; b = Mech.Beam }
    if k == 2 { b = Mech.Beam }
    fight_init(a, b, FightMode.VsCpu, 2)
    sum = 0
    frames = 0
}

private fn beam_script(side: s32) -> u32 {
    let me = &fight.f[side]
    let fwd = if_u(me.facing > 0, RIGHT, LEFT)
    if side == 0 {
        match SCENARIO {
            30 => { if at(5) || at(100) || at(400) { return DOWN | B } }
            31 => {
                if at(5) { return DOWN | B }
                if at(100) { return A }
            }
            32 => {
                if at(5) { return B }
                if frames >= 160 && frames <= 260 { return B }
                if frames >= 345 && frames <= 380 { return B }
            }
            33 => {
                if at(5) { return B }
                if frames >= 200 && frames <= 300 { return B }
                if frames >= 450 && frames <= 490 { return B }
            }
            34 => return beam_chain_press()
            35 => { if at(5) || at(265) { return A | B } }
            36 => {
                if at(5) { return Y }
                if stage == 2 && fight.f[1].mv == Mv.jump && fight.f[1].y > 0.0 && dist() < 7.0 {
                    stage = 3
                    return UP | B
                }
            }
            37, 39 => return cpu_pad(0, 2)
            38 => { if at(5) || at(155) { return B } }
            else => {}
        }
        return 0
    }
    match SCENARIO {
        31 => { if at(10) { return A } }
        32 => { if frames >= 150 && frames <= 330 { return R } }
        33 => { if at(5) || at(240) || at(475) { return B } }
        35 => { if frames >= 250 { return R } }
        36 => {
            if frames < 60 { return R }
            if at(190) { return fwd | X }
        }
        38 => { if at(40) || at(190) { return B } }
        else => {}
    }
    return 0
}

// Scenario 34: the next button a few frames after each hit.
private fn beam_chain_press() -> u32 {
    let a = &fight.f[0]
    let fwd = if_u(a.facing > 0, RIGHT, LEFT)
    if at(5) { return A }
    if frames != next_at { return 0 }
    let hits = evc_side[0][Ev.Hit]
    if hits == 1 { return fwd | A }
    if hits == 2 { return fwd | B }
    return 0
}

private fn beam_check() {
    let ev = fight_events()
    for e in 0..ev.n {
        let k = ev.e[e].kind
        let s = ev.e[e].side
        if k == Ev.Shot { bm_shot_pow = ev.e[e].power }
        if k == Ev.Hit && s == 0 { next_at = frames + 3 }
        if (s == 0 || s == 1) && fight.f[s].mech == Mech.Beam {
            if k == Ev.Shot { bm_orbs += 1 }
            if k == Ev.Super { bm_supers += 1 }
        }
    }
    for i in 0..2 {
        if fight.f[i].react > bm_prev_react[i] && fight.f[i].mech == Mech.Beam { bm_primes += 1 }
        bm_prev_react[i] = fight.f[i].react
    }
    match SCENARIO {
        30 => check_chem()
        31 => check_spoil()
        32 => check_orb()
        33 => check_orb_wave()
        34 => check_beam_chain()
        35 => check_overload()
        36 => check_shock()
        37 => check_beam_cpu()
        38 => check_orb_beaten()
        39 => check_beam_budget()
        else => {}
    }
}

private fn check_chem() {
    let b = &fight.f[0]
    if at(20) {
        assert(b.mv == Mv.sp_d, "the prime did not start")
        assert_eq(b.react, 0, "a reaction before the release frame")
    }
    if at(34) {
        assert_eq(b.react, 0, "a reaction before the release frame")
        assert_eq(b.meter, 0, "meter during the exposed frames")
    }
    if at(35) {
        assert_eq(b.react, REACT_FRAMES - 1, "the reaction did not start on the release frame")
        assert_eq(b.meter, REACT_FILL, "the reaction's first frame")
    }
    if at(101) {
        assert(b.mv != Mv.sp_d, "a second prime during a reaction")
        assert_eq(b.meter, (101 - 34) * REACT_FILL, "the reaction's fill")
    }
    if at(334) {
        assert_eq(b.react, 0, "the reaction did not burn out after 300 frames")
        assert_eq(b.meter, REACT_FRAMES * REACT_FILL, "a reaction is not half a bar")
        assert(!b.super_ok, "the super with half a bar")
    }
    if at(340) { assert_eq(b.meter, REACT_FRAMES * REACT_FILL, "the meter moved without a reaction") }
    if at(430) { assert(b.react > 0, "the second prime after the burn-out did not react") }
    if at(740) {
        assert_eq(b.meter, METER_BAR, "two reactions are not a bar")
        assert(b.super_ok, "the super is not ready with a full bar")
        assert_eq(b.react, 0, "the second reaction did not burn out")
        print("meter after two reactions ")
        print_int(b.meter)
        println("")
        ok("the chemical meter: prime, react, burn out")
    }
}

private fn check_spoil() {
    let b = &fight.f[0]
    if at(80) {
        assert_eq(evc_side[1][Ev.Hit], 1, "the Guard Cut did not hit the priming Beam")
        assert_eq(b.health, 1000 - dmg(0, Mv.atk_n), "the Guard Cut's damage")
        assert_eq(b.react, 0, "a spoiled prime reacted")
        assert_eq(b.meter, 0, "meter from a spoiled prime")
    }
    if at(160) {
        assert_eq(evc_side[0][Ev.Hit], 1, "Beam's Arc Jab missed")
        assert_eq(b.meter, 0, "chemical meter from a landed hit")
        ok("a hit spoils the prime; hits give no chemical meter")
    }
}

private fn check_orb() {
    let h = &fight.f[1]
    if at(100) {
        assert_eq(evc_side[0][Ev.Shot], 1, "no orb")
        assert_eq(evc_side[0][Ev.Hit], 1, "the tapped orb missed")
        assert_eq(h.health, 1000 - orb_hit(1).dmg, "the tapped orb's damage")
    }
    if at(150) { place(-8.0, 8.0) }
    if at(330) {
        assert_eq(bm_shot_pow, 3, "100 frames of B is not a full orb")
        assert_eq(evc[Ev.Block], 1, "the full orb was not blocked")
        assert_eq(evc[Ev.Chip], 1, "no chip from the full orb")
        assert_eq(h.health, 1000 - orb_hit(1).dmg - orb_hit(3).chip, "the full orb's chip")
    }
    if at(340) { place(-8.0, 8.0) }
    if at(480) {
        assert_eq(bm_shot_pow, 2, "30 frames of B is not a charged orb")
        assert_eq(evc_side[0][Ev.Hit], 2, "the charged orb missed")
        assert_eq(h.health, 1000 - orb_hit(1).dmg - orb_hit(3).chip - orb_hit(2).dmg, "the charged orb's damage")
        print("Hero health after tap, full (blocked), charged ")
        print_int(h.health)
        println("")
        ok("the Volt Orb: tap, full charge, charged")
    }
}

private fn check_orb_wave() {
    let b = &fight.f[0]
    let h = &fight.f[1]
    if at(180) {
        assert_eq(evc[Ev.Clash], 1, "the tap and the wave did not meet")
        assert_eq(b.health, 1000 - dmg(0, Mv.sp_n), "the wave did not go on to hit Beam")
        assert_eq(h.health, 1000, "the tapped orb went on")
    }
    if at(200) { place(-12.0, 12.0) }
    if at(380) {
        assert_eq(evc[Ev.Clash], 2, "the full orb and the wave did not meet")
        assert_eq(h.health, 1000 - orb_hit(3).dmg, "the full orb did not go on to hit the Hero")
        assert_eq(b.health, 1000 - dmg(0, Mv.sp_n), "the wave went on past a full orb")
    }
    if at(440) { place(-12.0, 12.0) }
    if at(620) {
        assert_eq(evc[Ev.Clash], 3, "the charged orb and the wave did not meet")
        assert_eq(h.health, 1000 - orb_hit(3).dmg, "the charged orb went on")
        assert_eq(b.health, 1000 - dmg(0, Mv.sp_n), "the wave went on past a charged orb")
        assert(!fight.shot[0].on && !fight.shot[1].on, "a shot survived the trade")
        ok("orb against wave: a tap loses, a full orb wins, a charged orb trades")
    }
}

private fn check_beam_chain() {
    if at(200) {
        let d = &fight.f[1]
        let hits = evc_side[0][Ev.Hit]
        print("chain hits ")
        print_int(hits)
        print(", damage ")
        print_int(d.health_max - d.health)
        println("")
        assert_eq(hits, 3, "Beam's chain is three hits")
        assert_eq(d.health, 1000 - (dmg(2, Mv.atk_n) + dmg(2, Mv.atk_f) * 80 / 100 + dmg(2, Mv.sp_f) * 65 / 100), "scaled damage")
        assert_eq(fight.f[0].meter, 0, "chemical meter from hits")
        ok("Beam's chain: A, FWD + A, FWD + B")
    }
}

private fn check_overload() {
    let b = &fight.f[0]
    let h = &fight.f[1]
    if at(3) { assert(b.super_ok, "a full chemical bar is not ready") }
    if at(6) {
        assert_eq(evc[Ev.Super], 1, "no super")
        assert_eq(b.meter, 0, "the bar was not spent")
        assert(fight.freeze > 30, "no super flash")
        assert_eq(fight.flash_side, 0, "the flash's side")
    }
    if at(150) {
        assert_eq(evc_side[0][Ev.Hit], 1, "the Raiko Overload missed 20 m away")
        assert_eq(h.health, 1000 - dmg(2, Mv.super), "the super's damage")
        assert_eq(b.meter, 0, "meter from the super's hit")
    }
    if at(260) {
        place(-10.0, 10.0)
        b.meter = METER_BAR
        assert(actionable(0) && actionable(1), "not ready for the blocked super")
    }
    if at(420) {
        assert_eq(evc[Ev.Block], 1, "the super was not blocked")
        assert_eq(evc[Ev.Chip], 1, "no chip from the super")
        assert_eq(h.health, 1000 - dmg(2, Mv.super) - chip(2, Mv.super), "the super's chip")
        b.meter = METER_BAR / 2
    }
    if at(425) {
        assert(!b.super_ok, "the chemical super under a bar")
        ok("the Raiko Overload: across the hangar, chip, a bar")
    }
}

private fn check_shock() {
    let h = &fight.f[1]
    if fight.f[1].mv == Mv.knockdown { mark2 += 1 }
    if at(110) {
        assert_eq(evc[Ev.Grab], 1, "the Shock Grip did not catch a blocking Hero")
        assert_eq(evc[Ev.Throw], 1, "no throw")
        assert_eq(h.health, 1000 - dmg(2, Mv.throw), "the Shock Grip's damage")
        assert(mark2 > 0, "the thrown Hero was not knocked down")
        assert(dist() > 8.0, "the throw did not throw it about 9 m")
        print("thrown to ")
        print_fixed(dist())
        println(" m")
    }
    if at(180) {
        place(-2.0, 8.0)
        stage = 2
        mark2 = 0
        assert(actionable(0) && actionable(1), "not ready for the anti-air")
    }
    if at(330) {
        assert_eq(evc_side[0][Ev.Hit], 1, "the Thunder Pillar missed")
        assert(mark2 > 0, "the jumper was not knocked down")
        assert_eq(h.health, 1000 - dmg(2, Mv.throw) - dmg(2, Mv.sp_u), "the pillar's damage")
        ok("the Shock Grip and the Thunder Pillar")
    }
}

private fn check_beam_cpu() {
    sum_frame()
    if fight.phase == Phase.Fight && fight.phase_t == 1 { round_start = frames }
    if fight.phase == Phase.Ko && fight.phase_t == 1 {
        print("  round ")
        print_int(fight.round)
        print(": ")
        if fight.timer <= 0 { print("time up") } else { print("KO") }
        print(" after ")
        print_int((frames - round_start) / 60)
        print(" s, winner ")
        print_int(fight.round_winner)
        print(", health ")
        print_int(fight.f[0].health)
        print(" / ")
        print_int(fight.f[1].health)
        println("")
    }
    assert(frames < 4 * ROUND_FRAMES + 2000, "the match does not finish")
    if fight.phase != Phase.MatchOver { return }
    print("run ")
    print_int(bm_match + 1)
    print(" (")
    print(MECH_NAMES[fight.f[0].mech])
    print(" against ")
    print(MECH_NAMES[fight.f[1].mech])
    print("): winner ")
    print_int(fight.winner)
    print(" after ")
    print_int(frames)
    print(" frames, checksum ")
    print_hex(sum)
    print("; Beam's orbs ")
    print_int(bm_orbs)
    print(", primes ")
    print_int(bm_primes)
    print(", supers ")
    print_int(bm_supers)
    println("")
    if bm_match == 0 {
        sum_first = sum
        result_first = fight.winner
        frames_first = frames
    }
    if bm_match < 3 {
        assert(bm_orbs > 0, "Beam fired no orb")
        assert(bm_primes > 0, "Beam never primed")
    }
    bm_orbs = 0
    bm_primes = 0
    bm_supers = 0
    if bm_match == 3 {
        assert_eq(sum, sum_first, "the two runs differ")
        assert_eq(fight.winner, result_first, "the winner differs")
        assert_eq(frames, frames_first, "the length differs")
        ok("CPU against CPU with Beam: every match finishes, the same twice")
        return
    }
    bm_match += 1
    start_beam_match()
    // the replay of the first match starts from the same seed as fight_init gives it
}

private fn check_orb_beaten() {
    // the Void Step (no hurt box on its gone frames) passes through the orb, twice: from mid
    // range as the orb leaves, and from far as it arrives
    if at(120) {
        assert_eq(evc_side[0][Ev.Shot], 1, "no orb")
        assert_eq(evc_side[0][Ev.Hit], 0, "the orb hit the Void Step")
        assert_eq(fight.f[1].health, dbh(), "damage to the Void Step")
        assert(fight.f[1].x < fight.shot[0].x || !fight.shot[0].on, "the Void Step did not pass the orb")
    }
    if at(150) { place(-8.0, 8.0) }
    if at(330) {
        assert_eq(evc_side[0][Ev.Shot], 2, "no second orb")
        assert_eq(evc_side[0][Ev.Hit], 0, "the orb hit the Void Step")
        assert_eq(fight.f[1].health, dbh(), "damage to the Void Step")
        ok("the Void Step passes through the orb")
    }
}

const MECH_NAMES: [len(Mech)]*u8 = ["Hero", "Double-blade", "Beam", "Tank", "Twins", "Twin A", "Twin B", "Shadow", "Seraph"]

private fn check_beam_budget() {
    if frames > 3 && frames != 901 && frames != 902 {
        if frame_ticks() > 1 { bm_late += 1 }
        bm_peak_cpu = max(bm_peak_cpu, cpu_used())
        bm_peak_gpu = max(bm_peak_gpu, gpu_used())
        bm_peak_tris = max(bm_peak_tris, tris_drawn())
    }
    if frames == 900 || frames == 1800 {
        print("Beam against ")
        print(MECH_NAMES[fight.f[1].mech])
        print(": peak cpu ")
        print_int(bm_peak_cpu)
        print(", gpu ")
        print_int(bm_peak_gpu)
        print(", triangles ")
        print_int(bm_peak_tris)
        print(", late frames ")
        print_int(bm_late)
        print(", the fight's peak ")
        print_int(peak_fight)
        println(" cycles")
        assert(bm_peak_cpu <= CPU_BUDGET, "over the CPU budget")
        assert(bm_peak_gpu <= GPU_BUDGET, "over the GPU budget")
        assert(bm_peak_tris < 4000, "over 4,000 triangles")
        bm_peak_cpu = 0
        bm_peak_gpu = 0
        bm_peak_tris = 0
        bm_late = 0
        peak_fight = 0
        if frames == 900 {
            fight_init(Mech.Beam, Mech.Doubleblade, FightMode.VsCpu, 2)
        } else {
            ok("the budget with Beam drawn against each mech")
        }
    }
}

// ---- Tank's scenarios, 40-49 (mx-tank; MOVES.md, "Tank")
//
// 40  super armour absorbs a hit: the Double-blade Hero's Twin Cut lands on the Piston
//     Haymaker's armour (damage, the nuclear meter, no hitstun, no chain), and the Haymaker hits
// 41  armour broken: the Hero grabs Tank out of its armoured Haymaker; then the Hero's super
//     lands through the armour as a normal hit
// 42  the Atomic Clinch: it catches a blocking Hero from 9 m and cannot be broken (Y mashed);
//     it misses a mech in the air and Tank recovers
// 43  the nuclear meter: it fills from damage taken (a bar per 480) and carries into round 2
// 44  Chain Reaction: Rivet Jab, Piston Haymaker, the super catches the Hero in hitstun; the
//     scaled damage, the bar spent
// 45  Tank's Scrap Heave on the Hero, then on the Double-blade Hero
// 46  Tank thrown: by the Hero (thrown), then by the Double-blade Hero's Vault Throw
// 47  the Atomic Clinch on the Double-blade Hero (thrown_slam); the Smokestack Uppercut knocks
//     a jumping Hero down
// 48  CPU against CPU (level 2): Tank against the Hero, then against the Double-blade Hero; both
//     matches finish
// 49  the budget: CPU against CPU with Tank drawn against the Hero, then the Double-blade Hero

var tk_part: s32                // the scenario's second half has started
var tk_kd: s32                  // a knockdown was seen
var tk_matches: s32
var tk_peak_cpu: [2]s32
var tk_peak_gpu: [2]s32
var tk_peak_tris: [2]s32

private fn tk_scenario() -> bool { return SCENARIO >= 40 && SCENARIO <= 49 }

private fn tk_init() {
    match SCENARIO {
        40, 47 => fight_init(Mech.Tank, Mech.Doubleblade, FightMode.Versus, 0)
        41, 43, 46 => fight_init(Mech.Hero, Mech.Tank, FightMode.Versus, 0)
        42, 44, 45 => fight_init(Mech.Tank, Mech.Hero, FightMode.Versus, 0)
        48, 49 => fight_init(Mech.Tank, Mech.Hero, FightMode.VsCpu, 2)
        else => {}
    }
    if SCENARIO == 48 { tick_per_frame = 40 }
    if SCENARIO != 48 && SCENARIO != 49 { skip_intro() }
    match SCENARIO {
        40 => place(-3.0, 3.0)
        41 => place(-2.0, 2.0)
        42 => place(-4.5, 4.5)
        43 => place(-4.0, 4.0)
        44 => { place(-2.5, 2.5); fight.f[0].meter = METER_BAR }
        45, 46 => place(-2.0, 2.0)
        47 => place(-4.0, 4.0)
        else => {}
    }
}

// A fresh fight halfway through a scenario.
private fn tk_restart(a: Mech, b: Mech, x: fixed) {
    fight_init(a, b, FightMode.Versus, 0)
    skip_intro()
    place(-x, x)
    for k in 0..len(Ev) {
        evc[k] = 0
        evc_side[0][k] = 0
        evc_side[1][k] = 0
    }
    tk_kd = 0
}

private fn tk_script(i: s32) -> u32 {
    let a = &fight.f[i]
    let fwd = if_u(a.facing > 0, RIGHT, LEFT)
    match SCENARIO {
        40 => {
            if i == 0 && at(3) { return fwd | A }
            if i == 1 && at(5) { return A }
        }
        41 => {
            if i == 1 && at(5) { return fwd | A }
            if i == 0 && at(10) { return Y }
            if i == 1 && at(155) { return fwd | A }
            if i == 0 && at(160) { return A | B }
        }
        42 => {
            if i == 1 && frames < 150 {
                // blocking; once caught, mashing the break
                if a.mv == Mv.thrown_slam && frames % 2 == 0 { return Y }
                return R
            }
            if i == 0 && at(5) { return fwd | B }
            if i == 1 && at(200) { return X }
            if i == 0 && at(206) { return fwd | B }
        }
        43 => {
            if i == 0 && (at(5) || at(95)) { return fwd | A }
        }
        44 => {
            if i != 0 { return 0 }
            if at(5) { return A }
            if frames == next_at {
                let hits = evc_side[0][Ev.Hit]
                if hits == 1 { return fwd | A }
                if hits == 2 { return A | B }
            }
        }
        45 => {
            if i == 0 && (at(5) || at(155)) { return Y }
        }
        46 => {
            if i == 0 && (at(5) || at(155)) { return Y }
        }
        47 => {
            if i == 0 && at(5) { return fwd | B }
            // the anti-air: the Hero (side 1) jumps in at Tank, cleaving on the way down
            if i == 1 && at(205) { return fwd | X }
            // (the fight never starts an air attack: decide() only presses buttons on the ground,
            // so the jump-in has no Falling Cleave for the armour to take; see the report)
            if i == 0 && fight.f[1].mv == Mv.jump && fx[1].vy < 0.0 && fight.f[1].y < 6.0 && stage == 0 {
                stage = 1
                return UP | B
            }
        }
        48, 49 => return cpu_pad(i, 2)
        else => {}
    }
    return 0
}

private fn tk_check() {
    if fight.f[0].mv == Mv.knockdown || fight.f[1].mv == Mv.knockdown { tk_kd += 1 }
    match SCENARIO {
        40 => tk_check_armour()
        41 => tk_check_armour_break()
        42 => tk_check_clinch()
        43 => tk_check_nuclear()
        44 => tk_check_super()
        45 => tk_check_heave()
        46 => tk_check_thrown()
        47 => tk_check_slam_aa()
        48 => tk_check_cpu()
        49 => tk_check_budget()
        else => {}
    }
}

private fn tk_check_armour() {
    let t = &fight.f[0]
    let d = &fight.f[1]
    if stage == 0 && evc[Ev.Armour] > 0 {
        stage = 1
        assert(t.mv == Mv.atk_f, "the armour did not keep the Haymaker going")
        assert_eq(t.health, STATS[Mech.Tank].health - dmg(1, Mv.atk_n), "an absorbed hit's damage")
        assert_eq(t.meter, dmg(1, Mv.atk_n) * NUC_NUM / NUC_DEN, "the nuclear meter from the absorbed hit")
        assert(!fx[1].contact, "an absorbed hit counts for the chain")
        assert_eq(fx[0].stun, 0, "hitstun through armour")
    }
    if at(80) {
        assert_eq(evc[Ev.Armour], 1, "the Twin Cut was not absorbed")
        assert_eq(evc_side[1][Ev.Hit], 0, "the Twin Cut hit through the armour")
        assert_eq(evc_side[0][Ev.Hit], 1, "the Haymaker did not land after the armour")
        assert_eq(d.health, dbh() - dmg(3, Mv.atk_f), "the Haymaker's damage")
        show_state()
        ok("super armour absorbs the Twin Cut; the Haymaker lands")
    }
}

private fn tk_check_armour_break() {
    let t = &fight.f[1]
    if evc[Ev.Grab] == 1 && stage == 0 {
        stage = 1
        assert(t.mv == Mv.thrown, "the armoured Tank was not grabbed")
    }
    if at(140) {
        assert_eq(evc[Ev.Throw], 1, "no throw")
        assert_eq(evc[Ev.Armour], 0, "the grab was absorbed")
        assert_eq(t.health, STATS[Mech.Tank].health - dmg(0, Mv.throw), "the Hero's throw on Tank")
        assert_eq(t.meter, dmg(0, Mv.throw) * NUC_NUM / NUC_DEN, "the meter from the throw")
        assert(tk_kd > 0, "Tank was not knocked down")
    }
    if at(150) {
        assert(actionable(0) && actionable(1), "not ready for the super")
        place(-6.0, 6.0)
        fight.f[0].meter = METER_BAR
        mark_h = t.health
    }
    if at(300) {
        assert_eq(evc[Ev.Super], 1, "no super")
        assert_eq(evc[Ev.Armour], 0, "the super was absorbed")
        assert_eq(evc_side[0][Ev.Hit], 1, "the super did not hit through the armour")
        assert_eq(t.health, mark_h - dmg(0, Mv.super), "the super's damage")
        ok("armour broken by a grab and by the super")
    }
}

private fn tk_check_clinch() {
    let h = &fight.f[1]
    if evc[Ev.Grab] == 1 && stage == 0 {
        stage = 1
        assert(h.mv == Mv.thrown_slam, "the clinched mech does not play thrown_slam")
        assert(fx[1].break_t == 0, "a break window on the command grab")
        print("clinched from ")
        print_fixed(dist())
        println(" m")
    }
    if at(150) {
        assert_eq(evc[Ev.Grab], 1, "the Clinch did not catch the blocking Hero")
        assert_eq(evc[Ev.Break], 0, "the command grab was broken")
        assert_eq(evc[Ev.Throw], 1, "no slam")
        assert_eq(h.health, 1000 - dmg(3, Mv.sp_f), "the Clinch's damage")
        assert(tk_kd > 0, "not knocked down")
        place(-4.5, 4.5)
        tk_kd = 0
    }
    if at(199) { assert(actionable(0) && actionable(1), "not ready for the second Clinch") }
    if at(300) {
        assert_eq(evc[Ev.Grab], 1, "the Clinch caught a mech in the air")
        assert_eq(h.health, 1000 - dmg(3, Mv.sp_f), "damage from a missed Clinch")
        assert(actionable(0), "Tank did not recover from the missed Clinch")
        ok("the Atomic Clinch beats block, cannot be broken, misses a jump")
    }
}

private fn tk_check_nuclear() {
    let t = &fight.f[1]
    if at(60) {
        assert_eq(evc_side[0][Ev.Hit], 1, "the Tip Thrust missed")
        assert_eq(t.meter, dmg(0, Mv.atk_f) * NUC_NUM / NUC_DEN, "the nuclear meter from a hit")
        assert_eq(fight.f[0].meter, KIN_HIT, "the Hero's kinetic meter")
        print("meter after one Tip Thrust ")
        print_int(t.meter)
        println("")
    }
    if at(80) {
        t.health = 50
        place(-4.0, 4.0)
    }
    if stage == 0 && evc[Ev.Ko] > 0 { stage = 1 }
    if stage == 1 && fight.phase == Phase.Intro {
        assert_eq(fight.round, 2, "round 2")
        assert_eq(t.health, STATS[Mech.Tank].health, "health refilled")
        assert_eq(t.meter, (dmg(0, Mv.atk_f) + 50) * NUC_NUM / NUC_DEN, "the meter did not carry into round 2")
        print("meter after 170 damage, in round 2 ")
        print_int(t.meter)
        println("")
        ok("the nuclear meter fills from damage taken and carries over")
    }
}

private fn tk_check_super() {
    let ev = fight_events()
    for e in 0..ev.n {
        if ev.e[e].kind == Ev.Hit && ev.e[e].side == 0 { next_at = frames + 3 }
    }
    if evc[Ev.Super] == 1 && stage == 0 {
        stage = 1
        assert_eq(fight.f[0].meter, 0, "the bar was not spent")
    }
    if at(300) {
        let h = &fight.f[1]
        assert_eq(evc[Ev.Super], 1, "no super")
        assert_eq(evc[Ev.Grab], 1, "Chain Reaction did not catch the mech in hitstun")
        assert_eq(evc[Ev.Throw], 1, "no slam")
        assert_eq(h.health, 1000 - (dmg(3, Mv.atk_n) + dmg(3, Mv.atk_f) * 80 / 100 + dmg(3, Mv.super) * 65 / 100),
                  "the chain's scaled damage")
        assert_eq(fight_moves(Mech.Tank).n, 15, "Tank's move list")
        print("chain into Chain Reaction: damage ")
        print_int(1000 - h.health)
        println("")
        ok("Chain Reaction ends the chain")
    }
}

private fn tk_check_heave() {
    if at(140) {
        assert_eq(evc[Ev.Throw], 1, "no Scrap Heave on the Hero")
        assert_eq(fight.f[1].health, 1000 - dmg(3, Mv.throw), "the Scrap Heave's damage")
        assert(tk_kd > 0, "the Hero was not knocked down")
        assert(dist() > 8.0, "the Hero was not thrown forward")
        print("Hero thrown to ")
        print_fixed(dist())
        println(" m")
        tk_restart(Mech.Tank, Mech.Doubleblade, 2.0)
    }
    if at(290) {
        assert_eq(evc[Ev.Throw], 1, "no Scrap Heave on the Double-blade Hero")
        assert_eq(fight.f[1].health, dbh() - dmg(3, Mv.throw), "its damage")
        assert(tk_kd > 0, "not knocked down")
        ok("Tank's Scrap Heave on the Hero and the Double-blade Hero")
    }
}

private fn tk_check_thrown() {
    let t = &fight.f[1]
    if evc[Ev.Grab] == 1 && stage == 0 {
        stage = 1
        if tk_part == 0 { assert(t.mv == Mv.thrown, "Tank is not in thrown") }
        else { assert(t.mv == Mv.thrown_vault, "Tank is not in thrown_vault") }
    }
    if at(140) {
        assert_eq(evc[Ev.Throw], 1, "the Hero did not throw Tank")
        assert_eq(t.health, STATS[Mech.Tank].health - dmg(0, Mv.throw), "the Hero's throw on Tank")
        assert(tk_kd > 0, "Tank was not knocked down")
        tk_restart(Mech.Doubleblade, Mech.Tank, 2.0)
        tk_part = 1
        stage = 0
    }
    if at(290) {
        assert_eq(evc[Ev.Throw], 1, "the Double-blade Hero did not throw Tank")
        assert_eq(t.health, STATS[Mech.Tank].health - dmg(1, Mv.throw), "the Vault Throw on Tank")
        assert_eq(t.meter, dmg(1, Mv.throw) * NUC_NUM / NUC_DEN, "the meter from the throw")
        assert(t.x < fight.f[0].x, "the Vault Throw did not swap sides")
        assert(tk_kd > 0, "Tank was not knocked down")
        ok("Tank thrown by the Hero and vaulted by the Double-blade Hero")
    }
}

private fn tk_check_slam_aa() {
    if evc[Ev.Grab] == 1 && tk_part == 0 && mark == 0 {
        mark = 1
        assert(fight.f[1].mv == Mv.thrown_slam, "the Double-blade Hero is not in thrown_slam")
    }
    if at(150) {
        assert_eq(evc[Ev.Throw], 1, "no slam")
        assert_eq(fight.f[1].health, dbh() - dmg(3, Mv.sp_f), "the Clinch on the Double-blade Hero")
        assert(tk_kd > 0, "not knocked down")
        tk_restart(Mech.Tank, Mech.Hero, 4.5)
        tk_part = 1
        stage = 0
    }
    if at(330) {
        print("anti-air: absorbed ")
        print_int(evc[Ev.Armour])
        print(", Tank hits ")
        print_int(evc_side[0][Ev.Hit])
        print(", Hero hits ")
        print_int(evc_side[1][Ev.Hit])
        println("")
        assert_eq(evc_side[1][Ev.Hit], 0, "the jump-in hit through the uppercut")
        assert_eq(evc_side[0][Ev.Hit], 1, "the Smokestack Uppercut missed")
        assert(tk_kd > 0, "the jumper was not knocked down")
        ok("the Clinch on the Double-blade Hero; the Smokestack Uppercut")
    }
}

private fn tk_check_cpu() {
    if fight.phase == Phase.Fight && fight.phase_t == 1 { round_start = frames }
    if fight.phase == Phase.Ko && fight.phase_t == 1 {
        print("  round ")
        print_int(fight.round)
        print(": ")
        if fight.timer <= 0 { print("time up") } else { print("KO") }
        print(" after ")
        print_int((frames - round_start) / 60)
        print(" s, winner ")
        print_int(fight.round_winner)
        print(", health ")
        print_int(fight.f[0].health)
        print(" / ")
        print_int(fight.f[1].health)
        print(", Tank's meter ")
        print_int(fight.f[0].meter)
        println("")
    }
    if fight.phase == Phase.MatchOver {
        print("run ")
        print_int(tk_matches + 1)
        print(": Tank against ")
        print(if_s(fight.f[1].mech == Mech.Hero, "the Hero", "the Double-blade Hero"))
        print(", winner ")
        print_int(fight.winner)
        print(" after ")
        print_int(frames)
        print(" frames; hits ")
        print_int(evc_side[0][Ev.Hit])
        print(" / ")
        print_int(evc_side[1][Ev.Hit])
        print(", absorbed ")
        print_int(evc[Ev.Armour])
        print(", grabs ")
        print_int(evc_side[0][Ev.Grab])
        print(" / ")
        print_int(evc_side[1][Ev.Grab])
        print(", supers ")
        print_int(evc_side[0][Ev.Super])
        println("")
        tk_matches += 1
        if tk_matches == 1 {
            fight_init(Mech.Tank, Mech.Doubleblade, FightMode.VsCpu, 2)
            for k in 0..len(Ev) {
                evc[k] = 0
                evc_side[0][k] = 0
                evc_side[1][k] = 0
            }
            frames = 0
            return
        }
        ok("CPU against CPU: Tank's matches finish")
    }
}

private fn tk_check_budget() {
    let k = if_i(frames > 900, 1, 0)
    if frames > 3 && frames != 901 && frames != 902 {
        if frame_ticks() > 1 { late += 1 }
        tk_peak_cpu[k] = max(tk_peak_cpu[k], cpu_used())
        tk_peak_gpu[k] = max(tk_peak_gpu[k], gpu_used())
        tk_peak_tris[k] = max(tk_peak_tris[k], tris_drawn())
    }
    if frames == 900 { fight_init(Mech.Tank, Mech.Doubleblade, FightMode.VsCpu, 2) }
    if frames == 1800 {
        for m in 0..2 {
            print(if_s(m == 0, "Tank and the Hero: ", "Tank and the Double-blade Hero: "))
            print("peak cpu ")
            print_int(tk_peak_cpu[m])
            print(", gpu ")
            print_int(tk_peak_gpu[m])
            print(", triangles ")
            print_int(tk_peak_tris[m])
            println("")
            assert(tk_peak_cpu[m] <= CPU_BUDGET, "over the CPU budget")
            assert(tk_peak_gpu[m] <= GPU_BUDGET, "over the GPU budget")
            assert(tk_peak_tris[m] < 4000, "over 4,000 triangles")
        }
        print("late frames ")
        print_int(late)
        print(", the fight's peak ")
        print_int(peak_fight)
        println(" cycles")
        ok("the budget with Tank drawn")
    }
}

private fn if_i(c: bool, a: s32, b: s32) -> s32 {
    if c { return a }
    return b
}

// ---- the Twins' scenarios, 60-67 (mx-twins-fight; MOVES.md, "The Twins"); 68 and 69 need the
// whole game and are in tests/twins/harness.akr
//
// 60  combining and splitting on L: twin B slides in, the bodies swap on combine's frame 23 and
//     split's frame 12 (the release mark), twin B hops back to its spot; a hit on twin A before
//     the swap stops the combine (twin B stands back up)
// 61  the partner: twin B's jab starts exactly TW_DELAY frames after twin A's, its walk too; it
//     walks back to its spot; the leash holds it within 8 m; it never copies Y
// 62  a hit on the partner: the Hero's Guard Cut hits twin B only (twin A free), off the one
//     bar; with the twins overlapping, one hit lands on one twin; a KO through twin B fells both
// 63  throws on the Twins: the Hero throws twin A; grabs twin B and the player's Y breaks it;
//     throws the combined form
// 64  throws by the Twins: the Tag Toss (split, 100) and the Binary Buster (combined, 140)
// 65  the fusion meter: nothing split (not by time, not by hits); combined +1 a frame from the
//     swap, +60 for a hit, Fusion Focus +6 a frame held (50 frames at most); split again, it
//     stands still
// 66  the super: Fusion Burst from a full bar, combined (330); split, A + B is no super
// 67  CPU against CPU (level 2): the Twins against the Hero (twice: the same match), Tank
//     against the Twins, the Twins against the Twins; every match finishes; prints the rounds,
//     the form switches and the supers
// 70  (a measurement, not in check.sh) CPU level 2 against level 2: the Twins against each
//     other mech, 8 matches each (both sides, four seeds); prints the Twins' wins, their time
//     combined and their supers

var tw_part: s32
var tw_at: [4]s32               // frames something was first seen
var tw_swaps: s32
var tw_prev_body: [2]Mech
var tw_matches: s32
var tw_sum: u32
var tw_sum_first: u32
var tw_meter0: s32
var tw_live: s32                // frames of play (not frozen) combined: the fusion meter's regen
var tw_prev_freeze: s32

private fn tw_scenario() -> bool { return SCENARIO >= 60 && SCENARIO <= 67 || SCENARIO == 70 }

// scenario 70
var tw_m: s32                   // the match
var tw_wins: [4]s32             // the Twins' wins against each mech
var tw_comb: s32                // frames of play combined, all matches
var tw_play: s32
var tw_sup: s32

private fn tw_stat_start() {
    let foe = (tw_m / 8) as Mech
    if tw_m % 2 == 0 { fight_init(Mech.Twins, foe, FightMode.VsCpu, 2) }
    else { fight_init(foe, Mech.Twins, FightMode.VsCpu, 2) }
    cpu_init(91 + tw_m * 7919)
}

private fn tw_check_stats() {
    let ts = if_i(fight.f[0].mech == Mech.Twins, 0, 1)
    if fight.phase == Phase.Fight {
        tw_play += 1
        if fight.f[ts].body == Mech.Twins { tw_comb += 1 }
    }
    let ev = fight_events()
    for e in 0..ev.n {
        if ev.e[e].kind == Ev.Super && ev.e[e].side == ts { tw_sup += 1 }
    }
    if fight.phase != Phase.MatchOver { return }
    if fight.winner == ts { tw_wins[tw_m / 8] += 1 }
    tw_m += 1
    if tw_m < 32 {
        tw_stat_start()
        return
    }
    let names: [4]*u8 = ["Hero", "Double-blade", "Beam", "Tank"]
    for k in 0..4 {
        print("Twins against ")
        print(names[k])
        print(": ")
        print_int(tw_wins[k])
        println(" of 8")
    }
    print("combined ")
    print_int(tw_comb * 100 / max(tw_play, 1))
    print(" % of the time, supers ")
    print_int(tw_sup)
    println("")
    ok("the Twins' statistics")
}

// Puts the fighters at x0 and x1, each split Twins' partner on its spot.
private fn tw_place(x0: fixed, x1: fixed) {
    place(x0, x1)
    for s in 0..2 {
        if twins_on(s) {
            let f = &fight.f[s]
            fight.f[s + 2].x = f.x - fixed(f.facing) * TW_SPOT
        }
    }
}

private fn tw_combined(s: s32) { fight.f[s].body = Mech.Twins }

private fn tw_restart(a: Mech, b: Mech, x: fixed) {
    fight_init(a, b, FightMode.Versus, 0)
    tw_skip_intro()
    tw_place(-x, x)
    for k in 0..len(Ev) {
        evc[k] = 0
        evc_side[0][k] = 0
        evc_side[1][k] = 0
    }
    stage = 0
    for k in 0..4 { tw_at[k] = 0 }
}

private fn tw_skip_intro() {
    skip_intro()
    twins_copy_mv(Mv.idle)
}

private fn tw_init() {
    match SCENARIO {
        60, 61, 62, 65, 66 => fight_init(Mech.Twins, Mech.Hero, FightMode.Versus, 0)
        63 => fight_init(Mech.Twins, Mech.Hero, FightMode.Versus, 0)
        64 => fight_init(Mech.Twins, Mech.Hero, FightMode.Versus, 0)
        67 => {
            fight_init(Mech.Twins, Mech.Hero, FightMode.VsCpu, 2)
            tick_per_frame = 40
        }
        70 => {
            tw_stat_start()
            tick_per_frame = 40
        }
        else => {}
    }
    if SCENARIO != 67 && SCENARIO != 70 { tw_skip_intro() }
    match SCENARIO {
        60 => tw_place(-6.0, 6.0)
        61 => tw_place(-10.0, 10.0)
        62 => { tw_place(-6.0, 3.5); fight.f[2].x = -1.0 }
        63 => tw_place(-2.0, 2.0)
        64 => tw_place(-2.0, 2.0)
        65 => tw_place(-1.0, 1.7)
        66 => { tw_place(-6.0, 6.0); tw_combined(0); fight.f[0].meter = METER_BAR }
        else => {}
    }
    tw_prev_body[0] = fight.f[0].body
    tw_prev_body[1] = fight.f[1].body
}

private fn tw_script(i: s32) -> u32 {
    let a = &fight.f[i]
    let fwd = if_u(a.facing > 0, RIGHT, LEFT)
    if SCENARIO == 67 || SCENARIO == 70 { return cpu_pad(i, 2) }
    if i == 0 {
        match SCENARIO {
            60 => { if at(5) || at(60) || at(121) { return L } }
            61 => {
                if at(5) { return A }
                if frames >= 40 && frames < 100 { return fwd }
                if at(280) { return Y }
            }
            63 => { if at(163) { return Y } }
            64 => { if at(5) || at(155) { return Y } }
            65 => {
                if at(5) { return A }
                if at(50) { return L }
                if at(120) { return A }
                if at(200) { return DOWN | B }
                if frames > 200 && frames < 280 { return B }
                if at(330) { return L }
            }
            66 => {
                if at(5) || at(205) { return A | B }
            }
            else => {}
        }
    } else {
        match SCENARIO {
            60 => { if at(125) { return A } }
            62 => { if at(5) || at(85) || at(165) { return A } }
            63 => { if at(5) || at(155) || at(305) { return Y } }
            else => {}
        }
    }
    return 0
}

private fn tw_check() {
    // swaps of bodies seen
    for s in 0..2 {
        if fight.f[s].body != tw_prev_body[s] {
            tw_swaps += 1
            tw_prev_body[s] = fight.f[s].body
        }
    }
    match SCENARIO {
        60 => tw_check_switch()
        61 => tw_check_partner()
        62 => tw_check_hit_partner()
        63 => tw_check_thrown()
        64 => tw_check_throws()
        65 => tw_check_fusion()
        66 => tw_check_super()
        67 => tw_check_cpu()
        70 => tw_check_stats()
        else => {}
    }
}

private fn tw_check_switch() {
    let f = &fight.f[0]
    let p = &fight.f[2]
    if f.mv == Mv.combine {
        if tw_at[0] == 0 { tw_at[0] = frames }
        let t = fx[0].t
        if t < TW_COMBINE_SWAP {
            assert(f.body == Mech.TwinA && twins_on(0), "combined before the swap")
            // a hit on twin B stops the combine: twin A stands back up on the next frame
            assert(p.mv == Mv.combine || is_hurt(p.mv), "twin B is not combining")
            if p.mv == Mv.combine {
                assert_eq(fx[2].t, t, "the twins' combine frames apart")
                if t >= TW_RUN_IN { assert(abs(p.x - f.x) < 0.01, "twin B has not reached twin A") }
            }
        } else {
            assert(f.body == Mech.Twins && !twins_on(0), "not combined after the swap")
            if tw_at[1] == 0 {
                tw_at[1] = frames
                assert_eq(t, TW_COMBINE_SWAP, "combine's swap frame")
                print("combine: the bodies swap on frame ")
                print_int(t)
                println("")
            }
        }
    }
    if at(55) {
        assert(actionable(0) && f.body == Mech.Twins, "the combine did not end in the combined form")
        assert_eq(tw_swaps, 1, "swaps")
    }
    if f.mv == Mv.split && tw_at[2] == 0 { tw_at[2] = frames }
    if f.mv == Mv.split || p.mv == Mv.split && twins_on(0) {
        let t = fx[0].t
        if f.mv == Mv.split && t < TW_SPLIT_SWAP {
            assert(f.body == Mech.Twins, "split before the swap")
        } else if f.mv == Mv.split {
            assert(f.body == Mech.TwinA && twins_on(0), "not split after the swap")
            if tw_at[3] == 0 {
                tw_at[3] = frames
                assert_eq(t, TW_SPLIT_SWAP, "split's swap frame")
                assert(abs(p.x - f.x) < 0.01, "twin B does not start docked on the root")
                assert(p.mv == Mv.split && fx[2].t == t, "twin B is not in split")
                print("split: the bodies swap on frame ")
                print_int(t)
                println("")
            }
            if t >= TW_HOP_AT + TW_HOP {
                assert(abs(p.x - (f.x - fixed(f.facing) * TW_SPOT)) < 0.01, "twin B did not hop back to its spot")
            }
        }
    }
    if at(110) {
        assert(actionable(0) && actionable(2) && f.body == Mech.TwinA, "the split did not end split")
        assert_eq(tw_swaps, 2, "swaps")
        tw_place(-3.0, 3.0)
    }
    // the combine at 121, hit by the Hero's Guard Cut (pressed at 125: combine frames 11-13, twin A
    // leaping and twin B arriving under it)
    if at(200) {
        assert_eq(evc_side[1][Ev.Hit], 1, "the Guard Cut missed the combining twins")
        assert(f.body == Mech.TwinA && twins_on(0), "the combine went on through the hit")
        assert_eq(tw_swaps, 2, "a swap after the hit")
        assert(actionable(0) && actionable(2), "the twins did not recover")
        ok("combining and splitting on L; the swap frames; a hit stops the combine")
    }
}

private fn tw_check_partner() {
    let f = &fight.f[0]
    let p = &fight.f[2]
    if f.mv == Mv.atk_n && tw_at[0] == 0 { tw_at[0] = frames }
    if p.mv == Mv.atk_n && tw_at[1] == 0 { tw_at[1] = frames }
    if f.mv == Mv.walk_f && tw_at[2] == 0 { tw_at[2] = frames }
    if p.mv == Mv.walk_f && tw_at[3] == 0 { tw_at[3] = frames }
    if at(39) {
        assert(tw_at[0] > 0 && tw_at[1] > 0, "a jab missing")
        assert_eq(tw_at[1] - tw_at[0], TW_DELAY, "twin B's jab delay")
        mark = (p.x - f.x) as s32
    }
    if at(130) {
        assert_eq(tw_at[3] - tw_at[2], TW_DELAY, "twin B's walk delay")
        let d = abs(p.x - (f.x - fixed(f.facing) * TW_SPOT))
        assert(d <= TW_NEAR + 0.01, "twin B is not back near its spot")
        print("jab and walk delay ")
        print_int(tw_at[1] - tw_at[0])
        print(" frames; twin B ")
        print_fixed(d)
        println(" m from its spot after the walk")
        p.x = f.x - fixed(f.facing) * 14.0       // knocked far away
    }
    if at(131) {
        assert(abs(abs(p.x - f.x) - TW_LEASH) < 0.2, "the leash did not hold twin B")
    }
    if at(270) {
        let d = abs(p.x - (f.x - fixed(f.facing) * TW_SPOT))
        assert(d <= TW_NEAR + 0.01, "twin B did not walk back to its spot")
    }
    if frames > 280 && frames < 300 { assert(p.mv != Mv.grab, "twin B copied Y") }
    if at(300) {
        assert(evc_side[0][Ev.Swing] >= 2, "no swings")
        ok("the partner copies six frames late, walks back to its spot, keeps the leash, never grabs")
    }
}

private fn tw_check_hit_partner() {
    let f = &fight.f[0]
    let p = &fight.f[2]
    if at(25) {
        assert(p.mv == Mv.hit_high, "twin B was not the one hit")
        assert(!is_hurt(f.mv), "twin A was hit")
    }
    if at(40) {
        assert_eq(evc_side[1][Ev.Hit], 1, "the Guard Cut did not land")
        assert_eq(f.health, 1000 - dmg(0, Mv.atk_n), "the hit on twin B came off the bar")
        print("twin B hit; the bar ")
        print_int(f.health)
        println("")
    }
    if at(80) {
        assert(actionable(0) && actionable(2), "the twins are not ready")
        p.x = -3.0
        f.x = -3.0
        mark_h = f.health
    }
    if at(120) {
        assert_eq(evc_side[1][Ev.Hit], 2, "the second Guard Cut")
        assert_eq(f.health, mark_h - dmg(0, Mv.atk_n), "a hit on overlapping twins landed twice")
        print("overlapping twins: one hit, the bar ")
        print_int(f.health)
        println("")
    }
    if at(160) {
        tw_place(-6.0, 3.5)
        p.x = -1.0
        f.health = 30
    }
    if at(300) {
        assert(evc[Ev.Ko] == 1, "no KO through twin B")
        assert(fight.phase == Phase.Ko || fight.phase == Phase.RoundOver, "the round did not end")
        assert(f.mv == Mv.ko && p.mv == Mv.ko, "both twins did not fall")
        ok("a hit on the partner, one twin a hit, a KO through twin B fells both")
    }
}

private fn tw_check_thrown() {
    let f = &fight.f[0]
    let p = &fight.f[2]
    if at(140) {
        assert_eq(evc[Ev.Throw], 1, "the Hero did not throw twin A")
        assert_eq(f.health, 1000 - dmg(0, Mv.throw), "the throw's damage")
        print("twin A thrown, the bar ")
        print_int(f.health)
        println("")
        tw_restart(Mech.Twins, Mech.Hero, 2.0)
        fight.f[0].x = -6.0
        fight.f[2].x = -0.5
        frames = 150
    }
    if frames > 150 && frames < 200 && is_thrown(p.mv) && stage == 0 { stage = 1 }
    if frames > 155 && frames < 175 { assert(f.mv != Mv.grab, "twin A grabbed instead of breaking") }
    if at(260) {
        assert(stage == 1, "the Hero did not grab twin B")
        assert_eq(evc[Ev.Break], 1, "the player's Y did not break the grab on twin B")
        assert_eq(evc[Ev.Throw], 0, "twin B was thrown")
        assert_eq(fight.f[0].health, 1000, "damage from a broken grab")
        tw_restart(Mech.Twins, Mech.Hero, 2.0)
        tw_combined(0)
        frames = 300
    }
    if at(440) {
        assert_eq(evc[Ev.Throw], 1, "the Hero did not throw the combined form")
        assert_eq(fight.f[0].health, 1000 - dmg(0, Mv.throw), "the throw on the combined form")
        assert(fight.f[0].body == Mech.Twins, "the throw split the twins")
        ok("throws on the Twins: twin A thrown, a grab on twin B broken, the combined form thrown")
    }
}

private fn tw_check_throws() {
    let h = &fight.f[1]
    if at(140) {
        assert_eq(evc[Ev.Throw], 1, "no Tag Toss")
        assert_eq(h.health, 1000 - move_hit(Mech.TwinA, Mv.throw).dmg, "the Tag Toss's damage")
        print("Tag Toss: the Hero thrown to ")
        print_fixed(dist())
        println(" m")
        tw_restart(Mech.Twins, Mech.Hero, 2.0)
        tw_combined(0)
        frames = 150
    }
    if at(290) {
        assert_eq(evc[Ev.Throw], 1, "no Binary Buster")
        assert_eq(fight.f[1].health, 1000 - move_hit(Mech.Twins, Mv.throw).dmg, "the Binary Buster's damage")
        print("Binary Buster: the Hero thrown to ")
        print_fixed(dist())
        println(" m")
        ok("the Twins' throws, split and combined")
    }
}

private fn tw_check_fusion() {
    let f = &fight.f[0]
    if tw_prev_freeze == 0 && f.body == Mech.Twins && fight.phase == Phase.Fight { tw_live += 1 }
    tw_prev_freeze = fight.freeze
    if frames < 50 { assert_eq(f.meter, 0, "the meter filled split") }
    if at(45) { assert(evc_side[0][Ev.Hit] >= 2, "the split jabs did not land") }
    if f.body == Mech.Twins && tw_at[0] == 0 { tw_at[0] = frames }
    if at(110) {
        assert(tw_at[0] > 0, "no combine")
        assert_eq(f.meter, tw_live * FUS_REGEN, "the meter's fill combined")
        print("combined: meter ")
        print_int(f.meter)
        print(" after ")
        print_int(tw_live)
        println(" frames of play")
        tw_meter0 = f.meter
        mark = tw_live
    }
    if at(160) {
        assert_eq(evc_side[0][Ev.Hit] - mark2, 1, "the Coupler Jab missed")
        assert_eq(f.meter, tw_meter0 + (tw_live - mark) * FUS_REGEN + FUS_HIT, "a combined hit's meter")
    }
    if at(110) { mark2 = evc_side[0][Ev.Hit] }
    if at(199) {
        tw_meter0 = f.meter
        mark = tw_live
    }
    if at(300) {
        assert(f.mv != Mv.sp_d, "Fusion Focus is still held")
        assert_eq(f.meter, tw_meter0 + (tw_live - mark) * FUS_REGEN + ORB_CHARGE_MAX * FUS_FOCUS, "Fusion Focus's meter")
        print("Fusion Focus: +")
        print_int(ORB_CHARGE_MAX * FUS_FOCUS)
        println(" held for 50 frames")
    }
    if at(360) { tw_meter0 = f.meter }
    if at(460) {
        assert(f.body == Mech.TwinA, "not split")
        assert_eq(f.meter, tw_meter0, "the meter moved split")
        print("meter after ")
        print_int(frames)
        print(" frames: ")
        print_int(f.meter)
        println("")
        ok("the fusion meter fills only combined")
    }
}

private fn tw_check_super() {
    let h = &fight.f[1]
    if evc[Ev.Super] == 1 && stage == 0 {
        stage = 1
        assert(fight.f[0].meter <= FUS_REGEN, "the bar was not spent")
    }
    if at(190) {
        assert_eq(evc[Ev.Super], 1, "no Fusion Burst")
        assert_eq(evc_side[0][Ev.Hit], 1, "the Fusion Burst missed")
        assert_eq(h.health, 1000 - move_hit(Mech.Twins, Mv.super).dmg, "the Fusion Burst's damage")
        tw_restart(Mech.Twins, Mech.Hero, 6.0)
        fight.f[0].meter = METER_BAR
        frames = 200
    }
    if at(204) { assert(!fight.f[0].super_ok, "the split twins have a super") }
    if at(260) {
        assert_eq(evc[Ev.Super], 0, "a super split")
        assert_eq(fight.f[0].meter, METER_BAR, "the meter spent split")
        ok("Fusion Burst combined; no super split")
    }
}

private fn tw_check_cpu() {
    if fight.phase == Phase.Fight && fight.phase_t == 1 { round_start = frames }
    tw_sum = tw_sum * 31 + (fight.f[0].health as u32) * 7 + (fight.f[1].health as u32) + (fight.f[0].x as s32) as u32
    if fight.phase == Phase.Ko && fight.phase_t == 1 {
        print("  round ")
        print_int(fight.round)
        print(": ")
        if fight.timer <= 0 { print("time up") } else { print("KO") }
        print(" after ")
        print_int((frames - round_start) / 60)
        print(" s, winner ")
        print_int(fight.round_winner)
        print(", health ")
        print_int(fight.f[0].health)
        print(" / ")
        print_int(fight.f[1].health)
        println("")
    }
    if fight.phase == Phase.MatchOver {
        print("run ")
        print_int(tw_matches + 1)
        print(": ")
        print(MECH_NAMES[fight.f[0].mech])
        print(" against ")
        print(MECH_NAMES[fight.f[1].mech])
        print(", winner ")
        print_int(fight.winner)
        print(" after ")
        print_int(frames)
        print(" frames; hits ")
        print_int(evc_side[0][Ev.Hit])
        print(" / ")
        print_int(evc_side[1][Ev.Hit])
        print(", form switches ")
        print_int(tw_swaps)
        print(", supers ")
        print_int(evc_side[0][Ev.Super])
        print(" / ")
        print_int(evc_side[1][Ev.Super])
        println("")
        assert(tw_swaps > 0, "the CPU never switched forms")
        tw_matches += 1
        if tw_matches == 1 { tw_sum_first = tw_sum }
        if tw_matches == 2 { assert(tw_sum == tw_sum_first, "the same match played twice differs") }
        var a = Mech.Twins
        var b = Mech.Hero
        if tw_matches == 2 { a = Mech.Tank; b = Mech.Twins }
        if tw_matches == 3 { b = Mech.Twins }
        if tw_matches == 4 {
            ok("CPU against CPU: the Twins' matches finish")
            return
        }
        fight_init(a, b, FightMode.VsCpu, 2)
        for k in 0..len(Ev) {
            evc[k] = 0
            evc_side[0][k] = 0
            evc_side[1][k] = 0
        }
        tw_swaps = 0
        tw_sum = 0
        tw_prev_body[0] = fight.f[0].body
        tw_prev_body[1] = fight.f[1].body
        frames = 0
    }
}

// ---- Shadow's scenarios, 100-108 (mx-shadow-fight; MOVES.md, "Shadow"); 109 needs the whole
// game and is in tests/shadow/harness.akr
//
// 100 the Hex Bolt curses the Hero (its damage, the curse's length); the Siphon takes each kind
//     of gain: the Hero's kinetic hit, the Double-blade Hero's reactor, Beam's reaction, Tank's
//     nuclear damage-taken (Shadow gets half), the Twins' fusion (nothing split, all combined)
// 101 the curse runs out after 360 frames of play; a second bolt refreshes it (not stacked);
//     once it is out, the Hero's hits fill its own meter again
// 102 the Rift Mine: laid at Shadow's feet, inert until armed (45 frames), then a Hero standing
//     on it is snared (held, its presses ignored) and Shadow's Lunging Claw lands unscaled;
//     Shadow's own mine never snares Shadow; the Hero's Low Sweep destroys a mine; a mine fades
// 103 Shadow Sneak: tapped it travels 6 m, held 18 m and the strike lands; held at 14 m it stops
//     at the Hero's feet; it goes under Beam's Volt Orb; the Hero's wave hits the travelling shadow
// 104 Eclipse Rise against a jump: the Hero jumps in with a Falling Cleave, Shadow's anti-air
//     (invulnerable at the start) knocks it down and takes nothing
// 105 Phantom Grip: the sides swap; a cornered Shadow leaves the corner and puts the Hero in it;
//     against the far wall Shadow comes up at the wall and the Hero is moved in front of it
// 106 Total Eclipse from zero: five hits (294, scaled), the bar of debt, 25 % more damage taken
//     in debt; blocked, five blocks and 80 chip
// 107 throws on and by Shadow against Tank (Phantom Grip; Scrap Heave, Atomic Clinch, Chain
//     Reaction) and the Twins (Phantom Grip on both forms; the Tag Toss, the Binary Buster)
// 108 CPU against CPU (level 2): Shadow against each other mech, both sides; every match finishes;
//     prints the rounds, the curses, mines, snares and supers
// 110 on the rooftop (an open edge at +x): Phantom Grip with Shadow's back to the drop flings the
//     Hero over it (a ring-out); Shadow Sneak toward the drop stops at the lip; a mine laid at
//     the lip snares the Hero there, and a snare is not a launch (nobody falls)
// 111 (a measurement, not in check.sh) CPU level 2 against level 2: Shadow against each other
//     mech, 8 matches each (both sides, four seeds); prints Shadow's wins, curses, mines, snares

var sh_pad: [2]u32              // pressed next tick (the checks script the pads)
var sh_hold: [2]u32             // held until cleared
var sh_part: s32
var sh_x0: fixed
var sh_flag: bool
var sh_prev_mv: Mv
var sh_prev_t: s32
var sh_matches: s32
var sh_stat: [4]s32             // scenario 108: curses, mines, snares, Shadow's supers

private fn sh_scenario() -> bool { return SCENARIO >= 100 && SCENARIO <= 108 || SCENARIO == 110 || SCENARIO == 111 }

private fn sh_restart(a: Mech, b: Mech, x0: fixed, x1: fixed) {
    fight_init(a, b, FightMode.Versus, 0)
    tw_skip_intro()
    tw_place(x0, x1)
    for k in 0..len(Ev) {
        evc[k] = 0
        evc_side[0][k] = 0
        evc_side[1][k] = 0
    }
    sh_hold[0] = 0
    sh_hold[1] = 0
    sh_flag = false
    mark = frames
    mark2 = -1
}

private fn sh_init() {
    match SCENARIO {
        100, 102, 104, 105, 106 => sh_restart(Mech.Shadow, Mech.Hero, -4.0, 4.0)
        101 => sh_restart(Mech.Shadow, Mech.Hero, -8.0, 8.0)
        103 => sh_restart(Mech.Shadow, Mech.Hero, -12.0, 12.0)
        107 => sh_restart(Mech.Shadow, Mech.Tank, -1.9, 1.9)
        108 => {
            fight_init(Mech.Shadow, Mech.Hero, FightMode.VsCpu, 2)
            tick_per_frame = 40
        }
        111 => {
            sh_stat_start()
            tick_per_frame = 40
        }
        110 => {
            fight_stage(ST_ROOFTOP)
            sh_restart(Mech.Shadow, Mech.Hero, 0.0, -3.0)
            place(sh_lip() - 0.5, sh_lip() - 3.5)
            print("the rooftop: half ")
            print_fixed(stage_now().half)
            print(", the lip ")
            print_fixed(sh_lip())
            println("")
        }
        else => {}
    }
    if SCENARIO == 102 { place(-6.0, 6.0) }
    if SCENARIO == 105 { place(-2.0, 2.0) }
}

private fn sh_script(i: s32) -> u32 {
    if SCENARIO == 108 || SCENARIO == 111 { return cpu_pad(i, 2) }
    let p = sh_pad[i] | sh_hold[i]
    sh_pad[i] = 0
    return p
}

private fn sh_fwd(i: s32) -> u32 { return if_u(fight.f[i].facing > 0, RIGHT, LEFT) }

private fn sh_check() {
    match SCENARIO {
        100 => sh_check_siphon()
        101 => sh_check_curse()
        102 => sh_check_mine()
        103 => sh_check_sneak()
        104 => sh_check_rise()
        105 => sh_check_grip()
        106 => sh_check_eclipse()
        107 => sh_check_throws()
        108 => sh_check_cpu()
        110 => sh_check_roof()
        111 => sh_check_stats()
        else => {}
    }
    sh_prev_mv = fight.f[0].mv
    sh_prev_t = fx[0].t
}

private fn sh_check_siphon() {
    let s = &fight.f[0]
    let o = &fight.f[1]
    match stage {
        0 => {
            if at(5) { sh_pad[0] = B }
            if evc[Ev.Curse] > 0 {
                assert(o.curse >= CURSE_FRAMES - 1, "the bolt did not curse")
                assert_eq(o.health, 1000 - dmg(7, Mv.sp_n), "the bolt's damage")
                assert_eq(evc_side[0][Ev.Hit], 1, "the bolt's hit")
                print("the Hex Bolt cursed the Hero on frame ")
                print_int(frames)
                print(", curse ")
                print_int(o.curse)
                println("")
                stage = 1
                mark = frames
            }
        }
        1 => {
            // the cursed Hero's Guard Cut: its kinetic gain goes to Shadow
            if frames == mark + 30 { sh_pad[1] = A }
            if evc_side[1][Ev.Hit] > 0 {
                assert_eq(o.meter, 0, "the cursed Hero gained meter")
                assert_eq(o.siphoned, KIN_HIT, "the kinetic hit was not siphoned")
                print("siphoned: the Hero's kinetic hit, ")
                print_int(KIN_HIT)
                println("")
                sh_restart(Mech.Shadow, Mech.Doubleblade, -4.0, 4.0)
                fight.f[1].curse = CURSE_FRAMES
                stage = 2
            }
        }
        2 => {
            // the Double-blade Hero's reactor
            if frames == mark + 60 {
                assert_eq(o.meter, 0, "the cursed reactor filled")
                assert_eq(o.siphoned, 60, "the reactor's 60 frames were not siphoned")
                assert_eq(s.meter, 60 + 60 * SIPHON_ANTI_NUM / SIPHON_ANTI_DEN, "Shadow's own 60 and half the siphoned 60")
                println("siphoned: the Double-blade Hero's reactor, 60 in 60 frames")
                sh_restart(Mech.Shadow, Mech.Beam, -10.0, 10.0)
                fight.f[1].curse = CURSE_FRAMES
                stage = 3
            }
        }
        3 => {
            // Beam's reaction
            if frames == mark + 2 { sh_pad[1] = DOWN | B }
            if o.react > 0 && mark2 < mark { mark2 = frames }
            if mark2 > mark && frames == mark2 + 60 {
                assert_eq(o.meter, 0, "the cursed reaction filled Beam's meter")
                assert_eq(o.siphoned, (REACT_FRAMES - o.react) * REACT_FILL, "the reaction was not siphoned")
                print("siphoned: Beam's reaction, ")
                print_int(o.siphoned)
                println(" in 60 frames")
                sh_restart(Mech.Shadow, Mech.Tank, -2.5, 2.5)
                fight.f[1].curse = CURSE_FRAMES
                stage = 4
            }
        }
        4 => {
            // Tank's nuclear meter: Shadow gets a quarter, the cursed Tank keeps the rest
            if frames == mark + 2 { sh_pad[0] = A }
            if evc_side[0][Ev.Hit] > 0 {
                let n = dmg(7, Mv.atk_n) * NUC_NUM / NUC_DEN
                let g = n * SIPHON_NUC_NUM / SIPHON_NUC_DEN
                assert_eq(o.meter, n - g, "the cursed Tank kept more than Shadow left it")
                assert_eq(o.siphoned, n, "the nuclear gain was not siphoned")
                assert_eq(s.meter, (frames - mark) + ANTI_HIT + g, "Shadow's regen, its hit and a quarter of the nuclear gain")
                print("siphoned: Tank's nuclear gain ")
                print_int(n)
                print(", Shadow got ")
                print_int(g)
                print(", Tank kept ")
                print_int(n - g)
                println("")
                sh_restart(Mech.Shadow, Mech.Twins, -8.0, 8.0)
                fight.f[1].curse = CURSE_FRAMES
                stage = 5
            }
        }
        5 => {
            // the Twins: split, nothing to take; combined, the fusion regen
            if frames == mark + 60 {
                assert_eq(o.siphoned, 0, "the split Twins were siphoned")
                assert_eq(o.meter, 0, "the split Twins' meter moved")
                tw_combined(1)
            }
            if frames == mark + 120 {
                assert_eq(o.siphoned, 60 * FUS_REGEN, "the combined Twins' fusion regen was not siphoned")
                assert_eq(o.meter, 0, "the cursed combined Twins' meter filled")
                assert_eq(s.meter, 60 * FUS_REGEN + 120, "Shadow's own 120 and the siphoned regen")
                print("siphoned: the Twins, nothing split, ")
                print_int(60 * FUS_REGEN)
                println(" in 60 frames combined")
                ok("the Hex Bolt curses; the Siphon takes every kind of gain")
            }
        }
        else => {}
    }
}

private fn sh_check_curse() {
    let o = &fight.f[1]
    match stage {
        0 => {
            if at(5) { sh_pad[0] = B }
            if evc[Ev.Curse] == 1 { stage = 1 }
        }
        1 => {
            if o.curse <= 150 && !fight.shot[0].on && actionable(0) && !sh_flag {
                sh_pad[0] = B
                sh_flag = true
            }
            if evc[Ev.Curse] == 2 {
                assert(o.curse >= CURSE_FRAMES - 1 && o.curse <= CURSE_FRAMES, "the curse was not refreshed to 360 (or it stacked)")
                print("refreshed on frame ")
                print_int(frames)
                print(": curse ")
                print_int(o.curse)
                println("")
                mark = frames
                stage = 2
            }
        }
        2 => {
            if o.curse == 0 {
                let n = frames - mark
                print("the curse ran out ")
                print_int(n)
                println(" frames after the refresh")
                assert(n >= CURSE_FRAMES - 1 && n <= CURSE_FRAMES + 20, "the curse's length (360 frames of play)")
                mark2 = o.siphoned
                place(-3.0, 3.0)
                sh_pad[1] = A
                stage = 3
            }
        }
        3 => {
            if evc_side[1][Ev.Hit] > 0 {
                assert_eq(o.meter, KIN_HIT, "the Hero's own meter did not fill after the curse")
                assert_eq(o.siphoned, mark2, "siphoned after the curse ran out")
                ok("the curse runs out after 6 s, refreshes, never stacks")
            }
        }
        else => {}
    }
}

private fn sh_check_mine() {
    let s = &fight.f[0]
    let o = &fight.f[1]
    match stage {
        0 => {
            if at(5) { sh_pad[0] = DOWN | B }
            if evc[Ev.Mine] == 1 {
                assert(rift[0].on, "no mine")
                assert(rift[0].x == s.x, "the mine is not at Shadow's feet")
                print("mine laid on frame ")
                print_int(frames)
                println("")
                // Shadow steps away; the Hero stands on the mine while it arms
                s.x = rift[0].x - 5.0
                o.x = rift[0].x + 2.0
                mark = frames
                stage = 1
            }
        }
        1 => {
            if evc[Ev.Snare] > 0 {
                let n = frames - mark
                print("armed and set off ")
                print_int(n)
                println(" frames after it was laid")
                assert(n >= MINE_ARM - 1 && n <= MINE_ARM, "the mine set off before (or long after) arming")
                assert(o.mv == Mv.idle && fx[1].pause == SNARE_FRAMES, "the Hero is not held")
                assert(!rift[0].on, "the mine is still there")
                sh_pad[0] = sh_fwd(0) | A
                sh_pad[1] = A
                sh_x0 = o.x
                mark = frames
                stage = 2
            }
        }
        2 => {
            if evc_side[0][Ev.Hit] == 0 {
                assert(o.mv == Mv.idle && o.x == sh_x0, "the snared Hero moved or acted")
            } else {
                print("snared: the Lunging Claw landed ")
                print_int(frames - mark)
                println(" frames into the snare")
                assert(frames - mark <= SNARE_FRAMES, "the hit came after the snare")
                assert_eq(o.health, 1000 - dmg(7, Mv.atk_f), "the hit on a snared mech is scaled")
                sh_restart(Mech.Shadow, Mech.Hero, -6.0, 6.0)
                stage = 3
            }
        }
        3 => {
            // Shadow stands on its own mine while it arms and after
            if frames == mark + 2 { sh_pad[0] = DOWN | B }
            if rift[0].on && rift[0].t == MINE_ARM + 20 {
                assert_eq(evc[Ev.Snare], 0, "Shadow's own mine snared it")
                // the Hero's Low Sweep over the mine
                o.x = rift[0].x + 5.0
                sh_pad[1] = DOWN | A
                stage = 4
            }
        }
        4 => {
            if evc[Ev.MineGone] > 0 {
                assert(!rift[0].on, "the swept mine is still there")
                println("the Low Sweep destroyed the mine")
                rift[0] = Rift { on: true, x: 20.0, t: MINE_LIFE - 2 }
                mark = frames
                stage = 5
            }
        }
        5 => {
            if frames == mark + 30 {          // (the sweep's hitstop freezes the mines too)
                assert(!rift[0].on, "the mine did not fade")
                assert_eq(evc[Ev.MineGone], 2, "no fade event")
                ok("the Rift Mine arms, snares, ignores Shadow, is destroyed, fades")
            }
        }
        else => {}
    }
}

private fn sh_check_sneak() {
    let s = &fight.f[0]
    let o = &fight.f[1]
    let travel_end = s.mv == Mv.sp_f && fx[0].t == sneak_t1 + 1 && !sh_flag
    match stage {
        0 => {
            if frames == mark + 2 {
                sh_pad[0] = sh_fwd(0) | B
                sh_x0 = s.x
            }
            if s.mv == Mv.sp_f && fx[0].t >= sneak_t0 && fx[0].t <= sneak_t1 {
                assert((cur_marks(0) & MARK_HIDE) != 0, "Shadow is not hidden in the travel")
            }
            if travel_end {
                sh_flag = true
                print("tapped: the shadow travelled ")
                print_fixed(s.x - sh_x0)
                println(" m")
                assert(abs(s.x - sh_x0 - SNEAK_SPEED * (sneak_t1 - sneak_t0 + 1)) < 0.01, "the tapped Sneak's distance")
            }
            if sh_flag && s.mv != Mv.sp_f {
                sh_restart(Mech.Shadow, Mech.Hero, -12.0, 12.0)
                stage = 1
            }
        }
        1 => {
            if frames == mark + 2 {
                sh_hold[0] = sh_fwd(0) | B
                sh_x0 = s.x
            }
            if travel_end {
                sh_flag = true
                sh_hold[0] = 0
                print("held: the shadow travelled ")
                print_fixed(s.x - sh_x0)
                println(" m")
                assert_eq(s.charge, SNEAK_HOLD, "the hold's frames")
                assert(abs(s.x - sh_x0 - SNEAK_SPEED * (sneak_t1 - sneak_t0 + 1 + SNEAK_HOLD)) < 0.01, "the held Sneak's distance")
            }
            if sh_flag && s.mv != Mv.sp_f {
                assert_eq(evc_side[0][Ev.Hit], 1, "the held Sneak's strike missed")
                assert_eq(o.health, 1000 - dmg(7, Mv.sp_f), "the Sneak's damage")
                sh_restart(Mech.Shadow, Mech.Hero, -7.0, 7.0)
                stage = 2
            }
        }
        2 => {
            if frames == mark + 2 { sh_hold[0] = sh_fwd(0) | B }
            if travel_end {
                sh_flag = true
                sh_hold[0] = 0
                print("held at 14 m: stopped ")
                print_fixed(o.x - s.x)
                println(" m from the Hero")
                assert(s.x < o.x, "the shadow passed the Hero")
                assert(abs(o.x - s.x - STATS[Mech.Shadow].push - STATS[Mech.Hero].push) < 0.01, "it did not stop at the Hero's feet")
            }
            if sh_flag && s.mv != Mv.sp_f {
                sh_restart(Mech.Shadow, Mech.Beam, -10.0, 10.0)
                mark2 = 0
                stage = 3
            }
        }
        3 => {
            // under a tapped Volt Orb
            if frames == mark + 2 { sh_pad[1] = B }
            if frames == mark + 12 { sh_hold[0] = sh_fwd(0) | B }
            let sh = &fight.shot[1]
            if s.mv == Mv.sp_f && fx[0].t >= sneak_t0 && fx[0].t <= sneak_t1 && sh.on && sh.x < s.x { mark2 = 1 }
            if travel_end {
                sh_flag = true
                sh_hold[0] = 0
            }
            if sh_flag && s.mv != Mv.sp_f {
                assert_eq(mark2, 1, "the orb did not pass over the travelling shadow")
                assert_eq(evc_side[1][Ev.Hit], 0, "the orb hit the travelling shadow")
                println("the Sneak went under the Volt Orb")
                sh_restart(Mech.Shadow, Mech.Hero, -10.0, 10.0)
                stage = 4
            }
        }
        4 => {
            // into the Hero's wave: the low shadow is hit
            if frames == mark + 2 { sh_pad[1] = B }
            if frames == mark + 12 { sh_hold[0] = sh_fwd(0) | B }
            if evc_side[1][Ev.Hit] > 0 && !sh_flag {
                sh_flag = true
                sh_hold[0] = 0
                assert(sh_prev_mv == Mv.sp_f && sh_prev_t >= sneak_t0 && sh_prev_t <= sneak_t1 + 1,
                       "the wave did not hit the travelling shadow")
                println("the wave hit the travelling shadow")
                ok("Shadow Sneak: tapped, held, stopped at the feet, under the orb, hit by the wave")
            }
        }
        else => {}
    }
}

private fn sh_check_rise() {
    let o = &fight.f[1]
    if frames == mark + 2 { sh_pad[1] = sh_fwd(1) | X }
    // the Hero's Falling Cleave on the way down
    if o.mv == Mv.jump && fx[1].air && fx[1].vy < 0.0 && stage == 0 {
        stage = 1
        sh_pad[1] = A
    }
    if stage == 1 && fx[1].air && fx[1].vy < 0.0 && o.y < 6.0 {
        stage = 2
        sh_pad[0] = UP | B
    }
    if stage == 2 && fight.f[0].mv == Mv.sp_u && fx[0].t <= 9 {
        assert((cur_marks(0) & MARK_INVULN) != 0, "Eclipse Rise is not invulnerable at the start")
    }
    if stage == 2 && evc_side[0][Ev.Hit] > 0 {
        stage = 3
        assert(o.mv == Mv.hit_air, "the jumper was not knocked down")
        print("Eclipse Rise hit the jumping Hero at height ")
        print_fixed(o.y)
        print(", ")
        print_fixed(dist())
        println(" m away")
    }
    if stage == 3 && o.mv == Mv.knockdown {
        assert_eq(fight.f[0].health, 900, "Shadow was hit")
        assert_eq(o.health, 1000 - dmg(7, Mv.sp_u), "Eclipse Rise's damage")
        ok("Eclipse Rise beats a jump-in")
    }
}

private fn sh_check_grip() {
    let s = &fight.f[0]
    let o = &fight.f[1]
    if frames == mark + 2 { sh_pad[0] = Y }
    if evc[Ev.Throw] == 1 && !sh_flag {
        sh_flag = true
        assert(o.health == 1000 - dmg(7, Mv.throw), "Phantom Grip's damage")
        assert(o.facing == -s.facing, "the two do not face each other")
    }
    if !sh_flag || o.mv != Mv.knockdown { return }
    match stage {
        0 => {
            print("open floor: Shadow ")
            print_fixed(s.x)
            print(", the Hero lands at ")
            print_fixed(o.x)
            println("")
            assert(s.x > o.x, "the sides did not swap")
            assert(s.facing < 0, "Shadow does not face the Hero")
            sh_restart(Mech.Shadow, Mech.Hero, -(stage_now().half - STATS[Mech.Shadow].push), -31.0)
            stage = 1
        }
        1 => {
            print("cornered: Shadow out to ")
            print_fixed(s.x)
            print(", the Hero lands at ")
            print_fixed(o.x)
            println("")
            assert(s.x > o.x, "the sides did not swap in the corner")
            assert(o.x < -30.0 && s.x > -30.0, "Shadow did not leave the corner")
            sh_restart(Mech.Shadow, Mech.Hero, 31.0, 34.0)
            stage = 2
        }
        2 => {
            print("the far wall: Shadow comes up at ")
            print_fixed(s.x)
            print(", the Hero lands at ")
            print_fixed(o.x)
            println("")
            assert(s.x > o.x, "the sides did not swap at the far wall")
            ok("Phantom Grip swaps sides, out of a corner")
        }
        else => {}
    }
}

private fn sh_check_eclipse() {
    let s = &fight.f[0]
    let o = &fight.f[1]
    match stage {
        0 => {
            if frames == mark + 2 { sh_pad[0] = A | B }
            if evc[Ev.Super] == 1 && !sh_flag {
                sh_flag = true
                assert(s.meter <= -METER_BAR + 10, "the bar of debt")
            }
            if sh_flag && s.mv != Mv.super {
                let want = 70 + 70 * COMBO_2 / 100 + 70 * COMBO_3 / 100 * 2 + 120 * COMBO_3 / 100
                print("Total Eclipse: ")
                print_int(evc_side[0][Ev.Hit])
                print(" hits, ")
                print_int(1000 - o.health)
                print(" damage, Shadow's meter ")
                print_int(s.meter)
                println("")
                assert_eq(evc_side[0][Ev.Hit], 5, "five hits")
                assert_eq(1000 - o.health, want, "the five hits' scaled damage")
                assert(s.meter < 0, "not in debt")
                sh_flag = false
                stage = 1
            }
        }
        1 => {
            // in debt: the Hero's Guard Cut does a quarter more
            if actionable(1) && actionable(0) && !sh_flag {
                place(-3.0, 3.0)
                sh_pad[1] = A
                sh_flag = true
                mark_h = s.health
            }
            if sh_flag && evc_side[1][Ev.Hit] > 0 {
                assert_eq(mark_h - s.health, dmg(0, Mv.atk_n) * DEBT_DMG_NUM / DEBT_DMG_DEN, "the debt's extra damage")
                print("in debt Shadow took ")
                print_int(mark_h - s.health)
                println(" from a Guard Cut")
                sh_restart(Mech.Shadow, Mech.Hero, -4.0, 4.0)
                sh_hold[1] = R
                stage = 2
            }
        }
        2 => {
            if frames == mark + 2 { sh_pad[0] = A | B }
            if evc[Ev.Super] == 1 && !sh_flag { sh_flag = true }
            if sh_flag && s.mv != Mv.super {
                print("blocked: ")
                print_int(evc[Ev.Block])
                print(" blocks, chip ")
                print_int(1000 - o.health)
                println("")
                assert_eq(evc[Ev.Block], 5, "five blocks")
                assert_eq(1000 - o.health, 14 * 4 + 24, "the chip")
                ok("Total Eclipse: five hits, the debt; blocked, the chip")
            }
        }
        else => {}
    }
}

// Scenario 107's parts: who throws whom.
private fn sh_part_start(k: s32) {
    match k {
        0 => sh_restart(Mech.Shadow, Mech.Tank, -1.9, 1.9)
        1 => sh_restart(Mech.Tank, Mech.Shadow, -1.9, 1.9)
        2 => sh_restart(Mech.Tank, Mech.Shadow, -4.0, 4.0)
        3 => {
            sh_restart(Mech.Tank, Mech.Shadow, -3.0, 3.0)
            fight.f[0].meter = METER_BAR
        }
        4 => sh_restart(Mech.Shadow, Mech.Twins, -2.0, 2.0)
        5 => {
            sh_restart(Mech.Shadow, Mech.Twins, -2.0, 2.0)
            tw_combined(1)
        }
        6 => sh_restart(Mech.Twins, Mech.Shadow, -2.0, 2.0)
        7 => {
            sh_restart(Mech.Twins, Mech.Shadow, -2.0, 2.0)
            tw_combined(0)
        }
        else => {}
    }
}

const SH_THROW_NAMES: [8]*u8 = [
    "Phantom Grip on Tank", "Tank's Scrap Heave on Shadow", "Tank's Atomic Clinch on Shadow",
    "Tank's Chain Reaction on Shadow", "Phantom Grip on the split Twins", "Phantom Grip on the combined Twins",
    "the Tag Toss on Shadow", "the Binary Buster on Shadow",
]

private fn sh_check_throws() {
    let a = &fight.f[0]
    let d = &fight.f[1]
    if frames == mark + 2 {
        match sh_part {
            2 => sh_pad[0] = sh_fwd(0) | B
            3 => sh_pad[0] = A | B
            else => sh_pad[0] = Y
        }
    }
    if d.mv == Mv.thrown_slam { sh_flag = true }
    if evc[Ev.Throw] == 0 || frames < mark2 { return }
    if mark2 < 0 {
        mark2 = frames + 60          // let it land
        return
    }
    if frames != mark2 { return }
    var want = 0
    match sh_part {
        0, 4, 5 => want = dmg(7, Mv.throw)
        1 => want = dmg(3, Mv.throw)
        2 => want = dmg(3, Mv.sp_f)
        3 => want = dmg(3, Mv.super)
        6 => want = move_hit(Mech.TwinA, Mv.throw).dmg
        7 => want = move_hit(Mech.Twins, Mv.throw).dmg
        else => {}
    }
    print(SH_THROW_NAMES[sh_part])
    print(": ")
    print_int(d.health_max - d.health)
    print(" damage, the thrower at ")
    print_fixed(a.x)
    print(", the thrown at ")
    print_fixed(d.x)
    println("")
    assert_eq(d.health_max - d.health, want, "the throw's damage")
    assert(is_hurt(d.mv), "the thrown mech is not down")
    if sh_part == 0 || sh_part == 4 || sh_part == 5 { assert(a.x > d.x, "Phantom Grip did not swap sides") }
    if sh_part == 0 { assert_eq(d.meter, want * NUC_NUM / NUC_DEN, "Tank's nuclear meter from the throw") }
    if sh_part == 2 || sh_part == 3 { assert(sh_flag, "Shadow did not play thrown_slam") }
    sh_part += 1
    if sh_part == 8 {
        ok("throws on and by Shadow against Tank and the Twins")
        return
    }
    sh_part_start(sh_part)
}

private fn sh_check_cpu() {
    let s = if_i(fight.f[0].mech == Mech.Shadow, 0, 1)
    if fight.phase == Phase.Fight && fight.phase_t == 1 { round_start = frames }
    let ev = fight_events()
    for e in 0..ev.n {
        let k = &ev.e[e]
        if k.side != s { continue }
        if k.kind == Ev.Curse { sh_stat[0] += 1 }
        if k.kind == Ev.Mine { sh_stat[1] += 1 }
        if k.kind == Ev.Snare { sh_stat[2] += 1 }
        if k.kind == Ev.Super { sh_stat[3] += 1 }
    }
    if fight.phase == Phase.Ko && fight.phase_t == 1 {
        print("  round ")
        print_int(fight.round)
        print(": ")
        if fight.timer <= 0 { print("time up") } else { print("KO") }
        print(" after ")
        print_int((frames - round_start) / 60)
        print(" s, winner ")
        print_int(fight.round_winner)
        print(", health ")
        print_int(fight.f[0].health)
        print(" / ")
        print_int(fight.f[1].health)
        println("")
    }
    if fight.phase != Phase.MatchOver { return }
    print("run ")
    print_int(sh_matches + 1)
    print(": ")
    print(MECH_NAMES[fight.f[0].mech])
    print(" against ")
    print(MECH_NAMES[fight.f[1].mech])
    print(", winner ")
    print_int(fight.winner)
    print(" after ")
    print_int(frames)
    print(" frames; Shadow's curses ")
    print_int(sh_stat[0])
    print(", mines ")
    print_int(sh_stat[1])
    print(", snares ")
    print_int(sh_stat[2])
    print(", supers ")
    print_int(sh_stat[3])
    print(", meter siphoned ")
    print_int(fight.f[1 - s].siphoned)
    println("")
    sh_matches += 1
    if sh_matches == 5 {
        ok("CPU against CPU: Shadow's matches finish")
        return
    }
    let foes: [5]Mech = [Mech.Hero, Mech.Doubleblade, Mech.Beam, Mech.Tank, Mech.Twins]
    let foe = foes[sh_matches]
    if sh_matches % 2 == 1 { fight_init(foe, Mech.Shadow, FightMode.VsCpu, 2) }
    else { fight_init(Mech.Shadow, foe, FightMode.VsCpu, 2) }
    for k in 0..4 { sh_stat[k] = 0 }
    frames = 0
}

// Where Shadow stands at the rooftop's open edge (its lip).
private fn sh_lip() -> fixed { return stage_now().half - STATS[Mech.Shadow].push }

private fn sh_check_roof() {
    let s = &fight.f[0]
    let o = &fight.f[1]
    match stage {
        0 => {
            // Phantom Grip with its back to the drop: the Hero is flung over it
            if frames == mark + 2 { sh_pad[0] = Y }
            if evc[Ev.RingOut] > 0 {
                print("Phantom Grip at the edge: Shadow at ")
                print_fixed(s.x)
                print(", the Hero over the edge at ")
                print_fixed(o.x)
                println("")
                assert_eq(evc[Ev.Throw], 1, "no throw")
                assert_eq(fight.round_winner, 0, "the ring-out's winner")
                assert(!fx[0].out, "Shadow fell")
                sh_restart(Mech.Shadow, Mech.Hero, 12.0, -10.0)
                // the Sneak toward the drop (the Hero behind): it stops at the lip
                s.facing = 1
                set_mv(0, Mv.sp_f)
                sh_hold[0] = B
                stage = 1
            }
        }
        1 => {
            assert(!off_edge(0) && !fx[0].out, "the Sneak went over the edge")
            if s.mv != Mv.sp_f {
                print("the Sneak toward the drop stopped at ")
                print_fixed(s.x)
                print(" (the lip ")
                print_fixed(sh_lip())
                println(")")
                assert(abs(s.x - sh_lip()) < 0.01, "the Sneak did not stop at the lip")
                assert_eq(evc[Ev.RingOut], 0, "a ring-out")
                sh_restart(Mech.Shadow, Mech.Hero, sh_lip(), sh_lip() - 12.0)
                stage = 2
            }
        }
        2 => {
            // a mine at the lip, the Hero backing onto it
            if frames == mark + 2 { sh_pad[0] = DOWN | B }
            if evc[Ev.Mine] == 1 && !sh_flag {
                sh_flag = true
                s.x = sh_lip() - 20.0
            }
            if sh_flag && evc[Ev.Snare] == 0 && rift[0].t >= MINE_ARM { sh_hold[1] = RIGHT }
            if evc[Ev.Snare] > 0 && stage == 2 {
                sh_hold[1] = 0
                mark = frames
                stage = 3
            }
        }
        3 => {
            if frames == mark + SNARE_FRAMES + 20 {
                print("snared at the lip: the Hero at ")
                print_fixed(o.x)
                println("")
                assert(o.x > sh_lip() - 4.0, "the snare was not at the lip")
                assert(!fx[1].out && evc[Ev.RingOut] == 0, "the snare rang the Hero out")
                ok("Shadow on the rooftop: Phantom Grip rings out, the Sneak stops at the lip, a mine at the lip")
            }
        }
        else => {}
    }
}

// ---- scenario 111: Shadow's wins against each mech, CPU against CPU

const SH_FOES: [5]Mech = [Mech.Hero, Mech.Doubleblade, Mech.Beam, Mech.Tank, Mech.Twins]
var sh_m: s32
var sh_wins: [5]s32
var sh_tot: [4]s32

private fn sh_stat_start() {
    let foe = SH_FOES[sh_m / 8]
    if sh_m % 2 == 0 { fight_init(Mech.Shadow, foe, FightMode.VsCpu, 2) }
    else { fight_init(foe, Mech.Shadow, FightMode.VsCpu, 2) }
    cpu_init(91 + sh_m * 7919)
}

private fn sh_check_stats() {
    let s = if_i(fight.f[0].mech == Mech.Shadow, 0, 1)
    let ev = fight_events()
    for e in 0..ev.n {
        let k = &ev.e[e]
        if k.side != s { continue }
        if k.kind == Ev.Curse { sh_tot[0] += 1 }
        if k.kind == Ev.Mine { sh_tot[1] += 1 }
        if k.kind == Ev.Snare { sh_tot[2] += 1 }
        if k.kind == Ev.Super { sh_tot[3] += 1 }
    }
    if fight.phase != Phase.MatchOver { return }
    if fight.winner == s { sh_wins[sh_m / 8] += 1 }
    sh_m += 1
    if sh_m < 40 {
        sh_stat_start()
        return
    }
    for k in 0..5 {
        print("Shadow against ")
        print(MECH_NAMES[SH_FOES[k]])
        print(": ")
        print_int(sh_wins[k])
        println(" of 8")
    }
    print("curses ")
    print_int(sh_tot[0])
    print(", mines ")
    print_int(sh_tot[1])
    print(", snares ")
    print_int(sh_tot[2])
    print(", supers ")
    print_int(sh_tot[3])
    println(" in 40 matches")
    ok("Shadow's statistics")
}

// ---- Seraph's scenarios, 150-151 (mx-seraph; MOVES.md, "Seraph"): phase 1, Shadow's moves on
// Seraph's body, with its own numbers; 152-157 need the whole game (tests/seraph/harness.akr)
//
// 150 against Shadow: idle (1,000 health, the kinetic meter, 22 parts a frame, the walk slower than
//     Shadow's); the jab lands at 4 m (50 damage, the kinetic meter's 125) and misses at 6 m, where
//     Shadow's Claw Jab still reaches Seraph; the lunging straight lands at 9 m and misses just
//     past the fist's reach (where the talons would still reach by 2.5 m); Phantom Grip
//     (Shadow's throw, for now) swaps the sides; the super from a full bar:
//     Total Eclipse's five hits (for now), the bar spent, no debt (kinetic)
// 151 the same against the Hero

const SR_FOE: Mech = match SCENARIO { 151 => Mech.Hero, else => Mech.Shadow }

private fn sr_scenario() -> bool { return SCENARIO == 150 || SCENARIO == 151 }

private fn sr_restart() { sh_restart(Mech.Seraph, SR_FOE, -4.0, 4.0) }

// The furthest a move's hit boxes reach over its frames (fight-local x).
private fn sr_reach(m: Mech, mv: Mv) -> fixed {
    var bx: Boxes
    var r = -99.0
    for f in 0..mv_len(m, mv) {
        mv_boxes(m, mv, f, &bx)
        for k in 0..bx.n {
            if bx.b[k].kind == BOX_HIT { r = max(r, bx.b[k].x1) }
        }
    }
    return r
}

// One attack by side i from distance d: restarted there, the press two frames in. Whether it
// landed is read once the move is over.
private fn sr_try(d: fixed, i: s32, b: u32) {
    sr_restart()
    place(-d / 2, d / 2)
    mark = frames
    sh_flag = false
    if i == 0 { mark_h = fight.f[1].health } else { mark_h = fight.f[0].health }
    sh_x0 = 0.0
    sh_part = i
    sh_prev_t = 0
    mark2 = frames + 2
    sh_hold[0] = 0
    sh_hold[1] = 0
    sr_b = b
}

var sr_b: u32
var sr_far: fixed

// How far in front of its root a mech's hurt boxes reach in its guard (idle, frame 0).
private fn sr_front(m: Mech) -> fixed {
    var bx: Boxes
    var r = 0.0
    mv_boxes(m, Mv.idle, 0, &bx)
    for k in 0..bx.n {
        if bx.b[k].kind == BOX_HURT { r = max(r, bx.b[k].x1) }
    }
    return r
}

private fn sr_press() {
    if frames == mark2 { sh_pad[sh_part] = sr_b }
}

// The attack of the last sr_try is over (both idle again a while after): its hits.
private fn sr_over() -> bool { return frames > mark + 12 && actionable(0) && actionable(1) }

private fn sr_check() {
    let s = &fight.f[0]
    let o = &fight.f[1]
    sr_press()
    match stage {
        0 => {
            if frames == mark + 1 {
                assert(s.mech == Mech.Seraph && s.body == Mech.Seraph, "Seraph is not side 0")
                assert_eq(s.health, 1000, "Seraph's health")
                assert(meter_power(Mech.Seraph) == Power.Kinetic, "Seraph's meter is not kinetic")
                assert_eq(AK_NPART[Mech.Seraph], len(Part), "Seraph's frames do not hold its wings and halo")
                assert_eq(AK_NPART[Mech.Shadow], Part.wing_l as s32, "Shadow's frames hold parts it has not")
                let jab = sr_reach(Mech.Seraph, Mv.atk_n)
                let lunge = sr_reach(Mech.Seraph, Mv.atk_f)
                print("the fists reach ")
                print_fixed(jab)
                print(" (jab) and ")
                print_fixed(lunge)
                print(" (lunge); Shadow's talons ")
                print_fixed(sr_reach(Mech.Shadow, Mv.atk_n))
                print(" and ")
                print_fixed(sr_reach(Mech.Shadow, Mv.atk_f))
                println("")
                assert(jab < 3.3 && jab < sr_reach(Mech.Shadow, Mv.atk_n) - 2.0, "the jab reaches as far as a claw")
                assert(lunge < 6.9 && lunge < sr_reach(Mech.Shadow, Mv.atk_f) - 2.0, "the lunge reaches as far as a claw")
                sh_x0 = s.x
                sh_hold[0] = LEFT       // back, away from the other (side 0 faces +x)
            }
            if frames == mark + 61 {
                sh_hold[0] = 0
                let w = sh_x0 - s.x
                print("walked back 60 frames: ")
                print_fixed(w)
                println(" m")
                assert(abs(w - STATS[Mech.Seraph].walk_b * 60) < 0.2, "the walk back")
                assert(STATS[Mech.Seraph].walk_f < STATS[Mech.Shadow].walk_f, "the walk is not slower than Shadow's")
                sr_try(4.0, 0, A)
                stage = 1
            }
        }
        1 => {
            if sr_over() {
                assert_eq(evc_side[0][Ev.Hit], 1, "the jab did not land at 4 m")
                assert_eq(mark_h - o.health, dmg(Mech.Seraph as s32, Mv.atk_n), "the jab's damage")
                assert_eq(s.meter, KIN_HIT, "the kinetic meter's gain for a landed hit")
                println("the jab lands at 4 m")
                sr_try(6.0, 0, A)
                stage = 2
            }
        }
        2 => {
            if sr_over() {
                assert_eq(evc_side[0][Ev.Hit], 0, "the jab landed at 6 m: air in front of the fist")
                assert_eq(o.health, mark_h, "damage from a jab at 6 m")
                println("the jab misses at 6 m")
                if SR_FOE == Mech.Shadow {
                    sr_try(6.0, 1, A)
                    stage = 3
                } else {
                    sr_try(9.0, 0, RIGHT | A)
                    stage = 4
                }
            }
        }
        3 => {
            if sr_over() {
                assert_eq(evc_side[1][Ev.Hit], 1, "Shadow's Claw Jab did not reach Seraph at 6 m")
                println("Shadow's Claw Jab reaches Seraph at 6 m")
                sr_try(9.0, 0, RIGHT | A)
                stage = 4
            }
        }
        4 => {
            if sr_over() {
                assert_eq(evc_side[0][Ev.Hit], 1, "the lunging straight did not land at 9 m")
                assert_eq(mark_h - o.health, dmg(Mech.Seraph as s32, Mv.atk_f), "the lunge's damage")
                println("the lunging straight lands at 9 m")
                // just out of the fist's reach: the lunge's 2 m glide, the fist, and the front of
                // the other's hurt boxes in its guard (Shadow's claws are held out in front)
                sr_far = sr_reach(Mech.Seraph, Mv.atk_f) + 2.0 + sr_front(SR_FOE) + 0.3
                sr_try(sr_far, 0, RIGHT | A)
                stage = 5
            }
        }
        5 => {
            if sr_over() {
                assert_eq(evc_side[0][Ev.Hit], 0, "the lunging straight landed out of the fist's reach")
                print("the lunging straight misses at ")
                print_fixed(sr_far)
                print(" m, where Shadow's talons would reach ")
                print_fixed(sr_reach(Mech.Shadow, Mv.atk_f) + 2.0 + sr_front(SR_FOE))
                println(" m")
                assert(sr_reach(Mech.Shadow, Mv.atk_f) + 2.0 + sr_front(SR_FOE) > sr_far + 2.0, "the talons' reach")
                sr_try(4.0, 0, Y)
                stage = 6
            }
        }
        6 => {
            if evc[Ev.Throw] == 1 && !sh_flag {
                sh_flag = true
                assert_eq(mark_h - o.health, dmg(Mech.Seraph as s32, Mv.throw), "the throw's damage")
            }
            if sh_flag && o.mv == Mv.knockdown {
                assert(s.x > o.x, "the throw did not swap the sides")
                println("the throw (Phantom Grip, for now) swaps the sides")
                sr_try(4.0, 0, A | B)
                s.meter = METER_BAR
                stage = 7
            }
        }
        7 => {
            if evc[Ev.Super] == 1 && !sh_flag {
                sh_flag = true
                assert(s.meter >= 0 && s.meter < 10, "the super did not spend the bar (kinetic: no debt)")
            }
            if sh_flag && s.mv != Mv.super {
                print("the super: ")
                print_int(evc_side[0][Ev.Hit])
                print(" hits, ")
                print_int(mark_h - o.health)
                print(" damage, the meter after ")
                print_int(s.meter)
                println("")
                assert_eq(evc_side[0][Ev.Hit], 5, "five hits")
                let want = 70 + 70 * COMBO_2 / 100 + 70 * COMBO_3 / 100 * 2 + 120 * COMBO_3 / 100
                assert_eq(mark_h - o.health, want, "the five hits' scaled damage")
                assert(s.meter >= 0, "a kinetic super went into debt")
                if SR_FOE == Mech.Shadow { ok("Seraph against Shadow") } else { ok("Seraph against the Hero") }
            }
        }
        else => {}
    }
}
