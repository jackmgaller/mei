// Mech Expo 2000's fight test cases (C's). Run one with tests/run.sh SCENARIO FRAMES OUT;
// tests/check.sh runs them all. tools/cart_scenario.sh writes the cart: the SCENARIO constant,
// this file and the fight (../fight.akr). The fighters are drawn as their boxes (hurt blue, hit
// red, push yellow), with health, meters, the timer and the moves as text.
//
//  0  play: you (pad 1) against the CPU (level 2), the Hero against the Double-blade Hero (not
//     in check.sh; build it with run.sh 0 1 OUT and play OUT.mei in mei)
//  1  a round won by KO: the Hero's Tip Thrust until the Double-blade Hero falls; the win counts
//     and round 2 starts
//  2  time up: one Guard Cut, then 60 seconds of nothing: the Hero wins on time
//  3  block and chip: a blocked Tip Thrust does nothing; a blocked Charge Slash and a blocked
//     wave chip
//  4  a grab beats block: the Hero grabs a blocking Double-blade Hero and throws it
//  5  grab breaks: Y pressed in the window breaks a grab; two grabs at once break each other
//  6  the Hero's chain: Guard Cut, Tip Thrust, Charge Slash, three hits, scaled damage
//  7  the Double-blade Hero's chain: Twin Cut twice, Cross Lunge, Charge Slash, four hits
//  8  the kinetic super: a full bar, A + B: the flash, the hit, the meter spent; and the
//     kinetic meter filling from hits
//  9  the antimatter super from zero: the debt, the extra damage taken in debt, the reactor
//     climbing back
// 10  CPU against CPU (level 2, the Hero against the Double-blade Hero): a whole match, twice;
//     both runs must give the same result frame for frame. Prints the rounds
// 11  the separation limit and the walls: walking apart stops at 36 m; at a wall the attacker
//     is pushed back instead of the defender
// 12  the Parry and the anti-air: the Hero parries a Twin Cut and ripostes; a Rising Arc knocks
//     a jumping Double-blade Hero down
// 13  the ladder's levels: the Hero at level 1 against the Hero at level 2, matches over several
//     seeds (a measurement: prints the wins; level 2 must win more)
// 14  the budget: CPU against CPU with both mechs drawn by anim.akr (the real models, depth
//     buffer and perspective on): CPU and GPU within their budgets, under 4,000 triangles; prints
//     the fight's own cost a frame
// 16  (a measurement, not in check.sh) CPU level 2 against level 2 over 30 matches, each
//     pairing and seeds: round lengths, KOs against time-ups, hits, blocks, supers, who wins
// 17  (a measurement, not in check.sh) frame advantage: every attack of both mechs on block and
//     on hit against a standing mech, from the engine itself (MOVES.md's tables)
// 18  the Vault Throw: the Double-blade Hero's victim plays thrown_vault, lands behind it
//     (the sides swap), knocked down
// 15  training: the dummy blocking, standing (health refills after a moment, meter kept full),
//     the dummy's CPU, no clock, no KO; the move lists; a super cancelled from a chain, and A
//     then B two frames apart (the Guard Cut becomes the super)

import "depth.akr"

var frames: s32
var evc: [len(Ev)]s32           // events so far, by kind
var evc_side: [2][len(Ev)]s32
var done: bool
var mark: s32                   // a frame the scenario noted
var mark2: s32
var mark_h: s32
var stage: s32                  // the scenario's own steps
var next_at: s32                // the next scripted press, in frames
var tick_per_frame = 1

// scenario 10's checksums
var sum: u32
var sum_first: u32
var run_n: s32
var result_first: s32
var frames_first: s32
var rounds_ko: s32
var rounds_time: s32
var round_frames: s32
var round_start: s32
var ko_frames_total: s32

// scenario 13
var lad_match: s32
var lad_wins: [2]s32

// scenario 14
var peak_cpu: s32
var peak_gpu: s32
var peak_tris: s32
var late: s32
var assets_ready: bool
var fight_cyc: s32              // the fight_tick() cost, its peak
var peak_fight: s32

const MV_NAMES: [len(Mv)]*u8 = [
    "idle", "walk_f", "walk_b", "crouch", "jump", "land", "block", "hit_high", "hit_low",
    "hit_air", "knockdown", "getup", "ko", "win", "intro", "atk_n", "atk_f", "atk_d", "atk_air",
    "sp_n", "sp_f", "sp_u", "sp_d", "grab", "grab_whiff", "throw", "thrown", "grab_break", "super",
    "thrown_vault", "thrown_slam",
]
const EV_NAMES: [len(Ev)]*u8 = [
    "Hit", "Block", "Chip", "Whiff", "Grab", "Throw", "Break", "Land", "Step", "MeterFull",
    "Super", "Ko", "TimeUp", "Shot", "Parry", "Clash", "Swing",
]

fn init() {
    match SCENARIO {
        0 => fight_init(Mech.Hero, Mech.Doubleblade, FightMode.VsCpu, 2)
        1, 2, 3, 4, 5, 6, 8, 11 => fight_init(Mech.Hero, Mech.Doubleblade, FightMode.Versus, 0)
        7, 9, 18 => fight_init(Mech.Doubleblade, Mech.Hero, FightMode.Versus, 0)
        12 => fight_init(Mech.Doubleblade, Mech.Hero, FightMode.Versus, 0)
        10, 14 => fight_init(Mech.Hero, Mech.Doubleblade, FightMode.VsCpu, 2)
        13 => start_ladder_match()
        16 => start_stat_match()
        17 => fight_init(Mech.Hero, Mech.Hero, FightMode.Versus, 0)
        15 => {
            fight_init(Mech.Hero, Mech.Doubleblade, FightMode.Training, 0)
            train(Dummy.Block, true)
        }
        else => {}
    }
    if SCENARIO == 10 || SCENARIO == 13 || SCENARIO == 16 { tick_per_frame = 40 }
    if SCENARIO >= 1 && SCENARIO <= 9 || SCENARIO == 11 || SCENARIO == 12 || SCENARIO == 18 { skip_intro() }
    match SCENARIO {
        1 => place(-5.0, 5.0)
        2 => place(-3.0, 3.0)
        3 => place(-4.5, 4.5)
        4 => place(-2.0, 2.0)
        5 => place(-2.0, 2.0)
        6 => place(-3.0, 3.0)
        7 => place(-2.5, 2.5)
        8 => { place(-6.0, 6.0); fight.f[0].meter = METER_BAR }
        9 => place(-6.0, 6.0)
        12 => place(-2.5, 2.5)
        15 => place(-5.0, 5.0)
        18 => place(-2.0, 2.0)
        else => {}
    }
}

private fn dbh() -> s32 { return STATS[Mech.Doubleblade].health }
private fn dmg(m: s32, mv: Mv) -> s32 { return move_hit(m as Mech, mv).dmg }
private fn chip(m: s32, mv: Mv) -> s32 { return move_hit(m as Mech, mv).chip }

private fn skip_intro() {
    fight.phase = Phase.Fight
    fight.phase_t = 0
    set_mv(0, Mv.idle)
    set_mv(1, Mv.idle)
}

private fn place(x0: fixed, x1: fixed) {
    fight.f[0].x = x0
    fight.f[1].x = x1
}

private fn dist() -> fixed { return abs(fight.f[1].x - fight.f[0].x) }

fn update() {
    if SCENARIO == 17 {
        frame_data()
        return
    }
    for k in 0..tick_per_frame {
        if done && SCENARIO != 0 { return }
        frames += 1
        var p1: u32 = 0
        var p2: u32 = 0
        if SCENARIO == 0 {
            p1 = PAD1
            p2 = PAD2
        } else {
            p1 = script1()
            p2 = script2()
        }
        let c0 = cycle_count()
        if SCENARIO == 0 {
            fight_tick(p1, p2, stick(), stick2())
        } else {
            fight_tick(p1, p2, vec2(0.0, 0.0), vec2(0.0, 0.0))
        }
        fight_cyc = cycle_count() - c0
        peak_fight = max(peak_fight, fight_cyc)
        let ev = fight_events()
        for e in 0..ev.n {
            let k2 = ev.e[e].kind
            evc[k2] += 1
            let s = ev.e[e].side
            if s == 0 || s == 1 { evc_side[s][k2] += 1 }
        }
        check()
    }
}

// ---- the scripts: what pad 1 and pad 2 press

private fn at(f: s32) -> bool { return frames == f }

private fn script1() -> u32 {
    let a = &fight.f[0]
    let fwd = if_u(a.facing > 0, RIGHT, LEFT)
    match SCENARIO {
        1 => {
            if !actionable(0) { return 0 }
            if dist() > 9.6 { return fwd }
            if frames % 2 == 0 { return fwd | A }
            return 0
        }
        2 => { if at(5) { return A } }
        3 => {
            if at(5) { return fwd | A }
            if at(70) { return fwd | B }
            if at(170) { return B }
        }
        4, 18 => { if at(5) { return Y } }
        5 => {
            if at(5) { return Y }
            if at(120) { return Y }
        }
        6, 7 => return chain_press(0)
        8 => { if at(5) { return A | B } }
        9 => { if at(5) { return A | B } }
        10, 14 => return cpu_pad(0, 2)
        11 => {
            if frames < 600 { return if_u(a.facing > 0, LEFT, RIGHT) }
            if frames >= 1300 && frames < 2000 { return RIGHT }
            if at(2100) { return A }
        }
        12 => {
            if at(10) { return A }
            if at(200) { return fwd | X }
        }
        13 => return cpu_pad(0, 1)
        16 => return cpu_pad(0, 2)
        15 => {
            if frames < 300 && actionable(0) && dist() > 5.0 { return fwd }
            if frames < 300 && actionable(0) && frames % 30 == 0 { return A }
            if at(310) { place(-3.0, 3.0) }
            if at(320) { return A }
            if at(330) { return A | B }
            if at(450) { return A }
            if at(452) { return B }     // a moment after A: the Guard Cut becomes the super
        }
        else => {}
    }
    return 0
}

private fn script2() -> u32 {
    let b = &fight.f[1]
    let fwd = if_u(b.facing > 0, RIGHT, LEFT)
    match SCENARIO {
        3, 4 => return R
        5 => { if frames == mark + 3 && mark > 0 && stage == 1 { return Y }; if at(120) { return Y } }
        9 => { if at(330) { return A } }
        11 => {
            if frames < 600 { return if_u(b.facing > 0, LEFT, RIGHT) }
            if frames >= 700 && frames < 1300 { return RIGHT }
            if frames >= 1300 && frames < 2000 { return RIGHT }
            if frames >= 2000 { return R }
        }
        12 => {
            if at(8) { return DOWN | B }
            if fight.f[0].mv == Mv.jump && fight.f[0].y > 0.0 && dist() < 7.0 && stage == 2 {
                stage = 3
                return UP | B
            }
        }
        else => {}
    }
    return 0
}

private fn if_u(c: bool, a: u32, b: u32) -> u32 {
    if c { return a }
    return b
}

// The chains of scenarios 6 and 7: the next button pressed a few frames after each hit.
private fn chain_press(i: s32) -> u32 {
    let a = &fight.f[i]
    let fwd = if_u(a.facing > 0, RIGHT, LEFT)
    if at(5) { return A }
    if frames != next_at { return 0 }
    let hits = evc_side[i][Ev.Hit]
    if a.mech == Mech.Hero {
        if hits == 1 { return fwd | A }
        if hits == 2 { return fwd | B }
    } else {
        if hits == 1 { return A }
        if hits == 2 { return fwd | A }
        if hits == 3 { return fwd | B }
    }
    return 0
}

// ---- the checks

private fn ok(s: *u8) {
    print("OK ")
    println(s)
    done = true
}

private fn show_state() {
    for i in 0..2 {
        let f = &fight.f[i]
        print("  side ")
        print_int(i)
        print(": ")
        print(MV_NAMES[f.mv])
        print(" t ")
        print_int(fx[i].t)
        print(" x ")
        print_fixed(f.x)
        print(" y ")
        print_fixed(f.y)
        print(" health ")
        print_int(f.health)
        print(" meter ")
        print_int(f.meter)
        println("")
    }
}

private fn check() {
    match SCENARIO {
        1 => check_ko()
        2 => check_time()
        3 => check_block()
        4 => check_grab()
        5 => check_break()
        6, 7 => check_chain()
        8 => check_kinetic()
        9 => check_antimatter()
        10 => check_determinism()
        11 => check_limits()
        12 => check_parry()
        13 => check_ladder()
        14 => check_budget()
        15 => check_training()
        16 => check_stats()
        18 => check_vault()
        else => {}
    }
}

private fn check_ko() {
    if stage == 0 && evc[Ev.Ko] > 0 {
        stage = 1
        mark = frames
        print("KO after ")
        print_int(frames)
        print(" frames, ")
        print_int(evc_side[0][Ev.Hit])
        println(" hits")
        assert_eq(fight.f[1].health, 0, "the loser's health")
        assert(fight.phase == Phase.Ko, "not in the KO phase")
        assert_eq(fight.round_winner, 0, "the round's winner")
    }
    if stage == 1 && fight.phase == Phase.RoundOver {
        stage = 2
        assert_eq(fight.wins[0], 1, "the win was not counted")
        assert_eq(fight.wins[1], 0, "the loser got a win")
        assert(fight.f[0].mv == Mv.win, "the winner does not pose")
    }
    if stage == 2 && fight.phase == Phase.Intro {
        assert_eq(fight.round, 2, "round 2")
        assert_eq(fight.f[1].health, fight.f[1].health_max, "health refilled")
        assert_eq(fight.timer, ROUND_FRAMES, "the clock reset")
        ok("a round won by KO, round 2 starts")
    }
}

private fn check_time() {
    if at(40) {
        assert_eq(fight.f[1].health, dbh() - dmg(0, Mv.atk_n), "the Guard Cut landed")
    }
    if evc[Ev.TimeUp] > 0 && stage == 0 {
        stage = 1
        print("time up at frame ")
        print_int(frames)
        println("")
        assert_eq(fight.timer, 0, "the timer")
        assert_eq(fight.round_winner, 0, "the healthier mech wins on time")
        assert(frames >= ROUND_FRAMES && frames <= ROUND_FRAMES + 20, "the round lasted 60 s (and the hitstop)")
    }
    if stage == 1 && fight.phase == Phase.RoundOver {
        assert_eq(fight.wins[0], 1, "the time-up win counted")
        ok("time up: the Hero wins on health")
    }
}

private fn check_block() {
    let d = &fight.f[1]
    if at(60) {
        assert_eq(evc[Ev.Block], 1, "the Tip Thrust was not blocked")
        assert_eq(evc[Ev.Hit], 0, "a hit through the block")
        assert_eq(d.health, dbh(), "a normal attack chipped")
        assert(d.x > 4.5, "no pushback on block")
    }
    if at(160) {
        assert_eq(evc[Ev.Block], 2, "the Charge Slash was not blocked")
        assert_eq(evc[Ev.Chip], 1, "no chip from the Charge Slash")
        assert_eq(d.health, dbh() - chip(0, Mv.sp_f), "the Charge Slash's chip")
        mark_h = d.health
    }
    if at(400) {
        assert_eq(evc[Ev.Shot], 1, "no wave")
        assert_eq(evc[Ev.Block], 3, "the wave was not blocked")
        assert_eq(evc[Ev.Chip], 2, "no chip from the wave")
        assert_eq(d.health, dbh() - chip(0, Mv.sp_f) - chip(0, Mv.sp_n), "the wave's chip")
        assert_eq(fight.f[0].meter, 3 * KIN_BLOCKED, "kinetic meter from blocked hits")
        ok("block stops attacks; specials chip")
    }
}

private fn check_grab() {
    if at(100) { assert(fight.f[1].mv == Mv.knockdown, "the thrown mech is not down") }
    if at(150) {
        assert_eq(evc[Ev.Grab], 1, "no grab")
        assert_eq(evc[Ev.Throw], 1, "no throw")
        assert_eq(evc[Ev.Hit] + evc[Ev.Block], 0, "a strike?")
        assert_eq(fight.f[1].health, dbh() - dmg(0, Mv.throw), "the throw's damage")
        ok("a grab beats block")
    }
}

private fn check_vault() {
    if evc[Ev.Grab] == 1 && stage == 0 {
        stage = 1
        assert(fight.f[1].mv == Mv.thrown_vault, "the vault's victim does not play thrown_vault")
    }
    if fight.f[1].mv == Mv.knockdown { mark2 = 1 }
    if at(100) {
        assert_eq(evc[Ev.Throw], 1, "no throw")
        assert_eq(fight.f[1].health, 1000 - dmg(1, Mv.throw), "the Vault Throw's damage")
        assert(fight.f[1].x < fight.f[0].x, "the sides did not swap")
        assert_eq(mark2, 1, "the thrown mech was not knocked down")
        ok("the Vault Throw swaps sides")
    }
}

private fn check_break() {
    if stage == 0 && evc[Ev.Grab] == 1 {
        stage = 1
        mark = frames               // pad 2 presses Y three frames later
    }
    if at(100) {
        assert_eq(evc[Ev.Break], 1, "the grab was not broken")
        assert_eq(evc[Ev.Throw], 0, "thrown anyway")
        assert_eq(fight.f[1].health, dbh(), "damage from a broken grab")
        assert(dist() > 4.0, "the break did not push them apart")
        stage = 2
        place(-2.0, 2.0)
    }
    if at(118) { assert(actionable(0) && actionable(1), "not ready for the second test") }
    if at(200) {
        assert_eq(evc[Ev.Break], 2, "two grabs at once did not break")
        assert_eq(evc[Ev.Throw], 0, "thrown")
        assert_eq(fight.f[0].health + fight.f[1].health, 1000 + dbh(), "damage")
        ok("grab breaks: in the window, and two grabs at once")
    }
}

private fn check_chain() {
    let i = 0
    let ev = fight_events()
    for e in 0..ev.n {
        if ev.e[e].kind == Ev.Hit && ev.e[e].side == i { next_at = frames + 3 }
    }
    if at(200) {
        let d = &fight.f[1]
        let hits = evc_side[i][Ev.Hit]
        print("chain hits ")
        print_int(hits)
        print(", damage ")
        print_int(d.health_max - d.health)
        println("")
        if fight.f[0].mech == Mech.Hero {
            assert_eq(hits, 3, "the Hero's chain is three hits")
            assert_eq(d.health, dbh() - (dmg(0, Mv.atk_n) + dmg(0, Mv.atk_f) * 80 / 100 + dmg(0, Mv.sp_f) * 65 / 100), "scaled damage")
            assert_eq(fight.f[0].meter, 3 * KIN_HIT, "kinetic meter: three landed hits")
            ok("the Hero's chain: A, FWD + A, FWD + B")
        } else {
            assert_eq(hits, 4, "the Double-blade Hero's chain is four hits")
            assert_eq(d.health, 1000 - (dmg(1, Mv.atk_n) + dmg(1, Mv.atk_n) * 80 / 100 + dmg(1, Mv.atk_f) * 65 / 100 + dmg(1, Mv.sp_f) * 65 / 100), "scaled damage")
            ok("the Double-blade Hero's chain: A, A, FWD + A, FWD + B")
        }
    }
}

private fn check_kinetic() {
    if at(3) { assert(fight.f[0].super_ok, "a full kinetic bar is not ready") }
    if at(6) {
        assert_eq(evc[Ev.Super], 1, "no super")
        assert_eq(fight.f[0].meter, 0, "the bar was not spent")
        assert(fight.freeze > 30, "no super flash")
        assert_eq(fight.flash_side, 0, "the flash's side")
    }
    if at(30) {
        assert_eq(fight.f[1].x, 6.0, "the other moved during the flash")
    }
    if at(140) {
        assert_eq(evc_side[0][Ev.Hit], 1, "the super missed")
        assert_eq(fight.f[1].health, dbh() - dmg(0, Mv.super), "the super's damage")
        assert_eq(fight.f[0].meter, KIN_HIT, "the super's hit fills the meter again")
        assert(!fight.f[0].super_ok, "the super is ready again")
        ok("the kinetic super")
    }
}

private fn check_antimatter() {
    let a = &fight.f[0]
    if at(3) {
        assert_eq(a.meter, 3, "the reactor does not fill")
        assert(a.super_ok, "the antimatter super is not ready from zero")
    }
    if at(6) {
        assert_eq(evc[Ev.Super], 1, "no super")
        assert(a.meter < -METER_BAR + 10, "no debt")
        assert(a.debt, "the debt is not shown")
        assert(!a.super_ok, "a second super in debt")
    }
    if at(160) {
        assert_eq(fight.f[1].health, 1000 - 320, "the antimatter super's damage")
        mark_h = a.health
    }
    if at(320) {
        // the Hero hits the mech in debt (the scripts move them close)
        place(fight.f[0].x, fight.f[0].x + 5.0 * fixed(a.facing))
        assert(actionable(0) && actionable(1), "not ready for the debt hit")
    }
    if at(400) {
        assert_eq(evc_side[1][Ev.Hit], 1, "the Hero's Guard Cut missed")
        assert_eq(a.health, dbh() - dmg(0, Mv.atk_n) * 5 / 4, "damage in debt is a quarter more")
        assert(a.meter > -METER_BAR + 300, "the reactor does not climb")
        print("meter after 400 frames ")
        print_int(a.meter)
        println("")
        ok("the antimatter super, debt and its damage")
    }
}

// a running checksum of the fight's state
private fn sum_frame() {
    for i in 0..2 {
        let f = &fight.f[i]
        sum = sum * 31 + (bits(f.x) as u32)
        sum = sum * 31 + (bits(f.y) as u32)
        sum = sum * 31 + (f.health as u32) + ((f.mv as u32) << 16)
        sum = sum * 31 + (f.meter as u32)
    }
}

private fn check_determinism() {
    sum_frame()
    if fight.phase == Phase.Fight && fight.phase_t == 1 { round_start = frames }
    if fight.phase == Phase.Ko && fight.phase_t == 1 {
        let len = frames - round_start
        print("  round ")
        print_int(fight.round)
        print(": ")
        if fight.timer <= 0 { print("time up") } else { print("KO") }
        print(" after ")
        print_int(len / 60)
        print(" s, winner ")
        print_int(fight.round_winner)
        print(", health ")
        print_int(fight.f[0].health)
        print(" / ")
        print_int(fight.f[1].health)
        println("")
        if run_n == 0 {
            if fight.timer <= 0 { rounds_time += 1 } else { rounds_ko += 1 }
        }
    }
    if fight.phase == Phase.MatchOver {
        print("run ")
        print_int(run_n + 1)
        print(": winner ")
        print_int(fight.winner)
        print(" after ")
        print_int(frames)
        print(" frames, checksum ")
        print_hex(sum)
        println("")
        if run_n == 0 {
            sum_first = sum
            result_first = fight.winner
            frames_first = frames
            run_n = 1
            sum = 0
            frames = 0
            fight_init(Mech.Hero, Mech.Doubleblade, FightMode.VsCpu, 2)
            return
        }
        assert_eq(sum, sum_first, "the two runs differ")
        assert_eq(fight.winner, result_first, "the winner differs")
        assert_eq(frames, frames_first, "the length differs")
        print("rounds by KO ")
        print_int(rounds_ko)
        print(", by time ")
        print_int(rounds_time)
        println("")
        ok("CPU against CPU twice: the same match")
    }
}

private fn check_limits() {
    let a = &fight.f[0]
    let b = &fight.f[1]
    assert(dist() <= FIGHT_MAX_SEP, "further apart than the limit")
    assert(a.x >= -FIGHT_WALL && b.x <= FIGHT_WALL, "through a wall")
    if at(599) {
        assert_eq(dist(), FIGHT_MAX_SEP, "walking apart did not stop at the limit")
        print("apart at ")
        print_fixed(a.x)
        print(" and ")
        print_fixed(b.x)
        println("")
    }
    if at(1299) {
        assert_eq(dist(), FIGHT_MAX_SEP, "walking away alone did not stop at the limit")
    }
    if at(1999) {
        assert_eq(b.x, FIGHT_WALL - STATS[b.mech].push, "not at the wall")
        assert(dist() < 4.0, "the Hero did not follow")
        mark_h = bits(a.x)
    }
    if at(2130) {
        assert_eq(evc[Ev.Block], 1, "the Guard Cut was not blocked")
        assert_eq(b.x, FIGHT_WALL - STATS[b.mech].push, "the defender left the wall")
        assert(a.x < from_bits(mark_h) - 0.3, "the attacker was not pushed back")
        print("pushed back ")
        print_fixed(from_bits(mark_h) - a.x)
        println(" m at the wall")
        ok("the separation limit and the walls")
    }
}

private fn check_parry() {
    // side 0 the Double-blade Hero attacks; side 1 the Hero parries
    if stage == 0 && evc[Ev.Parry] > 0 {
        stage = 1
        assert(fx[0].pause > 0, "the parried attacker is not frozen")
    }
    if at(120) {
        assert_eq(evc[Ev.Parry], 1, "the Twin Cut was not parried")
        assert_eq(evc_side[1][Ev.Hit], 1, "the riposte missed")
        assert_eq(fight.f[0].health, dbh() - dmg(0, Mv.sp_d), "the riposte's damage")
        assert_eq(fight.f[1].health, 1000, "the parried hit did damage")
    }
    if at(190) {
        // the roles for the anti-air: the Double-blade Hero jumps in, the Hero rises
        place(-10.0, 0.0)
        stage = 2
        assert(actionable(0) && actionable(1), "not ready for the anti-air")
    }
    if stage >= 2 && fight.f[0].mv == Mv.knockdown { mark2 = 1 }
    if at(330) {
        assert_eq(evc_side[1][Ev.Hit], 2, "the Rising Arc missed")
        assert_eq(mark2, 1, "the jumper was not knocked down")
        ok("the Parry and the anti-air")
    }
}

private fn start_ladder_match() {
    fight_init(Mech.Hero, Mech.Hero, FightMode.VsCpu, 2)
    cpu_init(1000 + lad_match * 7919)
    tick_per_frame = 40
}

private fn check_ladder() {
    if fight.phase != Phase.MatchOver { return }
    let w = fight.winner
    if w == 0 || w == 1 { lad_wins[w] += 1 }
    lad_match += 1
    if lad_match < 6 {
        start_ladder_match()
        return
    }
    print("level 1 won ")
    print_int(lad_wins[0])
    print(", level 2 won ")
    print_int(lad_wins[1])
    println(" of 6 matches")
    assert(lad_wins[1] > lad_wins[0], "level 2 is not stronger than level 1")
    ok("the ladder's levels")
}

private fn check_budget() {
    if frames > 3 {
        if frame_ticks() > 1 { late += 1 }
        peak_cpu = max(peak_cpu, cpu_used())
        peak_gpu = max(peak_gpu, gpu_used())
        peak_tris = max(peak_tris, tris_drawn())
    }
    if frames == 1800 {
        print("peak cpu ")
        print_int(peak_cpu)
        print(", gpu ")
        print_int(peak_gpu)
        print(", triangles ")
        print_int(peak_tris)
        print(", late frames ")
        print_int(late)
        print(", the fight's peak ")
        print_int(peak_fight)
        println(" cycles")
        assert(peak_cpu <= CPU_BUDGET, "over the CPU budget")
        assert(peak_gpu <= GPU_BUDGET, "over the GPU budget")
        assert(peak_tris < 4000, "over 4,000 triangles")
        ok("the budget with two mechs drawn")
    }
}

private fn train(d: Dummy, meter: bool) {
    var o = TrainOpts { dummy: d, refill_health: true, refill_meter: meter }
    fight_training(&o)
}

private fn check_training() {
    let d = &fight.f[1]
    if at(290) {
        assert(evc[Ev.Block] >= 3, "the dummy did not block")
        assert_eq(evc[Ev.Hit], 0, "the blocking dummy was hit")
        assert_eq(fight.timer, ROUND_FRAMES, "the clock runs in training")
        assert_eq(fight.f[0].meter, METER_BAR, "the meter is not kept full")
        train(Dummy.Stand, true)
    }
    if at(340) { assert(d.health < d.health_max, "the standing dummy was not hit") }
    if at(440) { assert_eq(evc[Ev.Super], 1, "no super in training") }
    if at(600) {
        assert_eq(evc[Ev.Super], 2, "A then B two frames later is not the super")
        assert(d.health > 0, "a KO in training")
    }
    if at(700) {
        assert_eq(d.health, d.health_max, "the dummy's health did not refill")
        assert(fight.phase == Phase.Fight, "the training ended")
        train(Dummy.Cpu, false)
    }
    if at(1500) {
        assert(evc_side[1][Ev.Swing] + evc_side[1][Ev.Grab] + evc_side[1][Ev.Shot] > 0, "the dummy's CPU did nothing")
        assert_eq(fight_moves(Mech.Hero).n, 15, "the Hero's move list")
        assert_eq(fight_moves(Mech.Doubleblade).n, 15, "the Double-blade Hero's move list")
        ok("training: the dummy, refills, no clock, no KO")
    }
}

// ---- scenario 16: statistics

var st_rounds: s32
var st_ko: s32
var st_len: s32
var st_len_max: s32
var st_len_min = 100000
var st_r0: s32
var st_mwins: [2][2]s32         // [mech][won]
var st_ev: [len(Ev)]s32
var st_side_hits: [2]s32        // by mech
var st_super: [2]s32            // by mech
var st_x_wins: [2]s32           // the cross matches (Hero against Double-blade): wins by mech
var st_debt_t: s32              // frames the Double-blade Hero spent in debt
var st_db_t: s32                // frames it fought
var st_dmg: [2]s32              // damage dealt by mech (health lost by the other)
var st_prev_h: [2]s32
var st_hit_power: [4]s32

private fn stat_mechs() -> ivec4 {
    let k = lad_match % 3
    if k == 0 { return ivec4(0, 1, 0, 0) }
    if k == 1 { return ivec4(1, 0, 0, 0) }
    return ivec4(lad_match % 2, lad_match % 2, 0, 0)
}

private fn start_stat_match() {
    let m = stat_mechs()
    fight_init(m.x as Mech, m.y as Mech, FightMode.VsCpu, 2)
    cpu_init(77 + lad_match * 104729)
    for k in 0..len(Ev) { evc[k] = 0 }
}

private fn check_stats() {
    let ev = fight_events()
    for e in 0..ev.n {
        st_ev[ev.e[e].kind] += 1
        if ev.e[e].kind == Ev.Hit { st_side_hits[fight.f[ev.e[e].side].mech] += 1; st_hit_power[ev.e[e].power] += 1 }
        if ev.e[e].kind == Ev.Super { st_super[fight.f[ev.e[e].side].mech] += 1 }
    }
    if fight.phase == Phase.Fight && fight.phase_t == 1 {
        st_r0 = frames
        st_prev_h[0] = fight.f[0].health
        st_prev_h[1] = fight.f[1].health
    }
    if fight.phase == Phase.Fight || fight.phase == Phase.Ko {
        for i in 0..2 {
            let lost = st_prev_h[i] - fight.f[i].health
            if lost > 0 { st_dmg[fight.f[1 - i].mech] += lost }
            st_prev_h[i] = fight.f[i].health
            if fight.f[i].mech == Mech.Doubleblade && fight.phase == Phase.Fight {
                st_db_t += 1
                if fight.f[i].debt { st_debt_t += 1 }
            }
        }
    }
    if fight.phase == Phase.Ko && fight.phase_t == 1 {
        let n = frames - st_r0
        st_rounds += 1
        st_len += n
        st_len_max = max(st_len_max, n)
        st_len_min = min(st_len_min, n)
        if fight.timer > 0 { st_ko += 1 }
    }
    if fight.phase != Phase.MatchOver { return }
    if fight.winner == 0 || fight.winner == 1 {
        let w = fight.winner
        st_mwins[fight.f[w].mech][1] += 1
        st_mwins[fight.f[1 - w].mech][0] += 1
        if fight.f[0].mech != fight.f[1].mech { st_x_wins[fight.f[w].mech] += 1 }
    }
    lad_match += 1
    if lad_match < 30 {
        start_stat_match()
        return
    }
    print("rounds ")
    print_int(st_rounds)
    print(", by KO ")
    print_int(st_ko)
    print(", length avg ")
    print_int(st_len / st_rounds / 60)
    print(" s (")
    print_int(st_len_min / 60)
    print(" to ")
    print_int(st_len_max / 60)
    println(" s)")
    print("per round: hits ")
    print_int(st_ev[Ev.Hit] * 10 / st_rounds)
    print("/10, blocks ")
    print_int(st_ev[Ev.Block] * 10 / st_rounds)
    print("/10, throws ")
    print_int(st_ev[Ev.Throw] * 10 / st_rounds)
    print("/10, breaks ")
    print_int(st_ev[Ev.Break] * 10 / st_rounds)
    print("/10, supers ")
    print_int(st_ev[Ev.Super] * 10 / st_rounds)
    print("/10, whiffs ")
    print_int(st_ev[Ev.Whiff] * 10 / st_rounds)
    print("/10, parries ")
    print_int(st_ev[Ev.Parry] * 10 / st_rounds)
    println("/10")
    print("Hero matches won/lost ")
    print_int(st_mwins[0][1])
    print("/")
    print_int(st_mwins[0][0])
    print(", Double-blade ")
    print_int(st_mwins[1][1])
    print("/")
    print_int(st_mwins[1][0])
    print("; hits landed by Hero ")
    print_int(st_side_hits[0])
    print(", by Double-blade ")
    print_int(st_side_hits[1])
    println("")
    print("supers by Hero ")
    print_int(st_super[0])
    print(", by Double-blade ")
    print_int(st_super[1])
    print("; Hero against Double-blade: wins ")
    print_int(st_x_wins[0])
    print(" to ")
    print_int(st_x_wins[1])
    println("")
    print("damage dealt by Hero ")
    print_int(st_dmg[0])
    print(", by Double-blade ")
    print_int(st_dmg[1])
    print("; Double-blade in debt ")
    print_int(st_debt_t * 100 / max(st_db_t, 1))
    print(" % of its time")
    print("; hits light/medium/heavy/super ")
    for k in 0..4 { print_int(st_hit_power[k]); print(" ") }
    println("")
    ok("statistics")
}

// ---- scenario 17: frame advantage

const FD_MOVES: [9]Mv = [Mv.atk_n, Mv.atk_f, Mv.atk_d, Mv.sp_n, Mv.sp_f, Mv.sp_u, Mv.sp_d, Mv.super, Mv.atk_air]
const FD_DIST: [9]fixed = [4.0, 6.0, 4.0, 6.0, 7.0, 3.6, 4.0, 8.0, 4.0]
var fd_case: s32

private fn frame_data() {
    if done { return }
    let n = len(FD_MOVES)
    if fd_case >= 2 * 2 * n {
        ok("frame data")
        return
    }
    let m = (fd_case / (2 * n)) as Mech
    let k = (fd_case / 2) % n
    let block = fd_case % 2 == 0
    let mv = FD_MOVES[k]
    fd_case += 1
    if mv == Mv.atk_air { return }          // depends on the jump's height
    if m == Mech.Doubleblade && (mv == Mv.sp_n || mv == Mv.sp_d) && block { }
    fight_init(m, Mech.Hero, FightMode.Versus, 0)
    skip_intro()
    place(-FD_DIST[k] / 2, FD_DIST[k] / 2)
    if mv == Mv.super {
        fight.f[0].meter = METER_BAR
        start_super(0)
    } else {
        set_mv(0, mv)
    }
    var t = 0
    var contact = -1
    var att_free = -1
    var def_free = -1
    var kd = false
    while t < 400 {
        t += 1
        var p2: u32 = 0
        if block { p2 = R }
        fight_tick(0, p2, vec2(0.0, 0.0), vec2(0.0, 0.0))
        let ev = fight_events()
        for e in 0..ev.n {
            let kind = ev.e[e].kind
            if (kind == Ev.Hit || kind == Ev.Block) && contact < 0 { contact = t }
        }
        if fight.f[1].mv == Mv.hit_air || fight.f[1].mv == Mv.knockdown { kd = true }
        if contact >= 0 && att_free < 0 && actionable(0) { att_free = t }
        let d_ok = actionable(1) && fight.f[1].mv != Mv.block
        let d_ok2 = fight.f[1].mv == Mv.block && fx[1].stun == 0
        if contact >= 0 && def_free < 0 && (d_ok || d_ok2) && t > contact { def_free = t }
        if contact < 0 && t > 200 { break }
        if att_free >= 0 && def_free >= 0 { break }
    }
    print(if_s(m == Mech.Hero, "Hero ", "Double-blade "))
    print(MV_NAMES[mv])
    print(if_s(block, " on block: ", " on hit: "))
    if contact < 0 { println("no contact"); return }
    if kd { print("knockdown, ") }
    print_int(def_free - att_free)
    print(" (contact on frame ")
    print_int(contact)
    print(", attacker free ")
    print_int(att_free)
    print(", defender ")
    print_int(def_free)
    print(", gap ")
    print_fixed(dist())
    println(" m)")
}

private fn if_s(c: bool, a: *u8, b: *u8) -> *u8 {
    if c { return a }
    return b
}

// ---- the view: the fighters as boxes

const PX: fixed = 6.0           // pixels a metre
const FLOOR_Y = 200

private fn sx(x: fixed, cx: fixed) -> s32 { return 160 + ((x - cx) * PX) as s32 }
private fn sy(y: fixed) -> s32 { return FLOOR_Y - (y * PX) as s32 }

private fn draw_box(i: s32, b: *Box, cx: fixed) {
    let w = world_box(i, b)
    let x0 = sx(w.x, cx)
    let x1 = sx(w.z, cx)
    let y1 = sy(w.y)
    let y0 = sy(w.w)
    var col = rgb(90, 170, 255)
    if b.kind == BOX_HIT { col = rgb(255, 60, 50) }
    if b.kind == BOX_PUSH { col = rgb(240, 220, 60) }
    if b.kind == BOX_HIT { rect_blend(x0, y0, max(x1 - x0, 1), max(y1 - y0, 1), rgb(120, 20, 20), BLEND_ADD) }
    rect_outline(x0, y0, max(x1 - x0, 1), max(y1 - y0, 1), col, BLEND_NONE)
}

fn draw() {
    if SCENARIO == 14 {
        draw_mechs()
        return
    }
    cls(rgb(24, 28, 40))
    let cx = (fight.f[0].x + fight.f[1].x) / 2
    rect(0, FLOOR_Y, 320, 240 - FLOOR_Y, rgb(50, 56, 70))
    for k in 0..2 {
        let wx = sx(if_f(k == 0, -FIGHT_WALL, FIGHT_WALL), cx)
        rect(wx - 1, 40, 3, FLOOR_Y - 40, rgb(110, 110, 130))
    }
    var bx: Boxes
    for i in 0..2 {
        let f = &fight.f[i]
        mv_boxes(f.mech, f.mv, cur_frame(i), &bx)
        for k in 0..bx.n { draw_box(i, &bx.b[k], cx) }
        // the root and the facing
        let rx = sx(f.x, cx)
        let ry = sy(f.y)
        rect(rx - 1, ry - 1, 3, 3, rgb(255, 255, 255))
        rect(rx, ry - 40, f.facing * 8, 2, rgb(255, 255, 255))
        let s = &fight.shot[i]
        if s.on {
            rect_blend(sx(s.x - WAVE_HALF, cx), sy(WAVE_H), (WAVE_HALF * 2 * PX) as s32, (WAVE_H * PX) as s32,
                       rgb(80, 200, 255), BLEND_ADD)
        }
    }
    hud()
}

private fn if_f(c: bool, a: fixed, b: fixed) -> fixed {
    if c { return a }
    return b
}

private fn hud() {
    for i in 0..2 {
        let f = &fight.f[i]
        let w = f.health * 120 / f.health_max
        var x = 10
        if i == 1 { x = 190 }
        rect(x, 10, 120, 8, rgb(60, 20, 20))
        if i == 0 { rect(x + 120 - w, 10, w, 8, rgb(240, 200, 40)) } else { rect(x, 10, w, 8, rgb(240, 200, 40)) }
        // the meter: debt in violet to the left of zero
        rect(x, 222, 120, 6, rgb(30, 30, 50))
        let m = f.meter * 60 / METER_BAR
        if f.meter >= 0 { rect(x + 60, 222, max(m, 0), 6, rgb(80, 200, 255)) }
        else { rect(x + 60 + m, 222, -m, 6, rgb(170, 60, 230)) }
        rect(x + 60, 220, 1, 10, rgb(255, 255, 255))
        if f.super_ok { text(x, 210, "SUPER", rgb(255, 255, 255)) }
        text(x, 22, MV_NAMES[f.mv], rgb(200, 200, 220))
        for k in 0..fight.wins[i] { rect(x + k * 10, 34, 6, 6, rgb(255, 80, 60)) }
    }
    text_int(152, 10, (fight.timer + 59) / 60, rgb(255, 255, 255))
    if fight.phase == Phase.Intro { text(136, 100, "READY", rgb(255, 255, 255)) }
    if fight.phase == Phase.Ko { text(148, 100, "KO", rgb(255, 80, 60)) }
    if fight.phase == Phase.MatchOver { text(124, 100, "MATCH OVER", rgb(255, 255, 255)) }
}

// ---- scenario 14: both mechs drawn by anim.akr

private fn draw_mechs() {
    if !assets_ready {
        assets_load()
        assets_ready = true
    }
    cls(rgb(40, 48, 64))
    render_depth(true)
    render_perspective(true)
    let cx = (fight.f[0].x + fight.f[1].x) / 2
    let sep = dist()
    let back = clamp(sep * 1.1 + 18.0, 30.0, 52.0)
    camera(vec3(cx, 7.0, -back), 0.0)
    for i in 0..2 {
        let f = &fight.f[i]
        anim_draw(f.mech, f.mv, f.frame, anim_place(vec2(f.x, f.y), f.facing))
    }
    hud()
}
