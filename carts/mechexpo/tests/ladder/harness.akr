// Mech Expo 2000's arcade ladder scenarios (mx-ladder, 116-127): the whole game (../../game.akr)
// with scripted pads in place of its weak input hooks, as tests/menus/harness.akr does. Run one
// with tests/ladder/run.sh SCENARIO VIEW FRAMES OUT (tests/run.sh SCENARIO FRAMES OUT runs
// VIEW 0); it writes OUT.png, the screen at the last frame. tests/check.sh runs them all. Each
// run measures the CPU and GPU of every frame against the budgets and prints "OK ..." once its
// checks pass.
//
// 116 EASY's measurement: a scripted novice who walks in and mashes (A mostly, B, a jump now and
//     then, a grab now and then, never a block) against the novice CPU (EASY's company fights)
//     and against level 0 (EASY's final), with every mech against every mech. Prints the win
//     rates; the masher must win most fights at both levels
// 117 a full run on EASY with the Hero, nothing unlocked: the difficulty select, the select, the
//     schedule, two company fights (rivals drawn by lot: never Momentum, never Umbral, no maker
//     twice), a lost fight and a continue, the final's reveal, the Double-blade Hero, the cover,
//     the unlock (an EASY clear unlocks it), the title. The fights are real until a moment in,
//     then the harness ends each round (the loser's health to 0)
// 118 the same on NORMAL with Shadow: the final is the UAPC's grey test unit (Shadow has no echo)
// 119 the same on HARD with Tank (the test unit; the CPU levels 2, 3, 3)
// 120 the lot: every mech over 300 seeds: no own maker, no final's maker, no repeats, the Twins
//     drawn while locked, every rival drawn, the same seed the same programme
// 121 the save's migration: a version-1 save on the card (the MVP's: the Hero and Beam cleared,
//     the echo unlocked) loads as version 2 with NORMAL stamps for both and its unlocks kept.
//     VIEW 0: the character select with the stamps; VIEW 1: the catalogue's spec sheet with all
//     three stamps (the Hero cleared on every grade)
// 122 the difficulty select: Arcade leads to it, B goes back, the cursor starts on the saved
//     grade (NORMAL), UP to EASY, A: the run is on EASY
// 123 the schedule page: VIEW 0 day 1, VIEW 1 day 2 (day 1 stamped), VIEW 2 the final day
// 124 the final's reveal: VIEW 0 the Double-blade Hero in silhouette, VIEW 1 lit, VIEW 2 the
//     test unit (Beam's), VIEW 3 the original (as the Double-blade Hero)
// 125 the test unit in a fight: VIEW 0 Shadow against its grey copy, VIEW 1 the split Twins
//     against theirs (four bodies, two grey), each CPU against CPU for 600 frames on the rooftop
// 126 the cover: VIEW 0-5 a cover for each mech (the Hero's contract, the Double-blade Hero's
//     upset, Beam, Tank, the Twins and Shadow beating the test unit), each frozen in its held
//     pose with the fanfare playing; VIEW 6 another seed's cover; VIEW 7 after the fanfare (the
//     menu loop back). VIEW 0 also measures every headline and cover line against the layout,
//     and checks the pick (two seeds differ, a replay is the same, no headline twice running)
// 127 a continue: the second fight lost; VIEW 0 the results ask for another demonstration; VIEW 1
//     A gives the same fight again (the same opponent, level and stage); VIEW 2 B withdraws: the
//     title

var hf: s32                     // frames since the harness began
var pads: [2]u32
var peak_cpu: s32
var peak_gpu: s32
var peak_tris: s32
var late: s32
var done_ok: bool
var pk_cpu: [len(St)]s32        // the peaks by screen
var pk_gpu: [len(St)]s32
var pk_late: [len(St)]s32

fn input_pad(n: s32) -> u32 { return pads[n] }
fn input_stick(n: s32) -> vec2 { return vec2(0.0, 0.0) }

const SHOT_AT = match SCENARIO {
    121 => 60
    122 => 80
    123 => 60
    124 => match VIEW { 0 => 120, else => 240 }
    125 => 600
    126 => match VIEW { 7 => 400, else => 150 }
    127 => match VIEW { 0 => 60, 1 => 140, else => 120 }
    else => 0
}

fn test_init() {
    match SCENARIO {
        116 => {}
        117, 118, 119 => { save.unlocked = 0; save.medals = 0 }
        120 => lot_check()
        121 => {}                       // at frame 5, once the card is idle (test_hook)
        122 => {}
        123 => setup_sched()
        124 => setup_reveal()
        125 => setup_test_fight()
        126 => setup_cover()
        127 => setup_continue()
        else => {}
    }
}

private fn press(n: s32, f: s32, b: u32) {
    if hf == f { pads[n] |= b }
}

fn test_hook() {
    hf += 1
    pads[0] = 0
    pads[1] = 0
    if hf > 3 {
        let ft = frame_ticks()
        let k = st as s32
        if ft > 1 {
            late += 1
            pk_late[k] += 1
        }
        peak_cpu = max(peak_cpu, cpu_used())
        peak_gpu = max(peak_gpu, gpu_used())
        peak_tris = max(peak_tris, tris_drawn())
        pk_cpu[k] = max(pk_cpu[k], cpu_used())
        pk_gpu[k] = max(pk_gpu[k], gpu_used())
    }
    match SCENARIO {
        116 => measure()
        117, 118, 119 => full_run()
        121 => hook_121()
        122 => hook_122()
        125 => hook_125()
        127 => hook_127()
        else => {}
    }
    if SHOT_AT > 0 && hf == SHOT_AT && !done_ok {
        check_shot()
        report_ok()
    }
}

private fn report_ok() {
    print("OK ladder ")
    print_int(SCENARIO)
    print(".")
    print_int(VIEW)
    print(": peak cpu ")
    print_int(peak_cpu)
    print(", gpu ")
    print_int(peak_gpu)
    print(", late frames ")
    print_int(late)
    println("")
    assert(peak_cpu <= CPU_BUDGET, "over the CPU budget")
    assert(peak_gpu <= GPU_BUDGET, "over the GPU budget")
    done_ok = true
}

// The peaks of screen s, printed.
private fn report_screen(name: *u8, s: St) {
    let k = s as s32
    print("  ")
    print(name)
    print(": peak cpu ")
    print_int(pk_cpu[k])
    print(", gpu ")
    print_int(pk_gpu[k])
    print(", late frames ")
    print_int(pk_late[k])
    println("")
    assert(pk_cpu[k] <= CPU_BUDGET, "a screen over the CPU budget")
    assert(pk_gpu[k] <= GPU_BUDGET, "a screen over the GPU budget")
}

// ---- 116: EASY against a novice who mashes

var ms_rng: u32 = 0x1234567
var ms_match: s32
var ms_wins: [5][2]s32          // [the level's index in ms_levels()][0 the masher, 1 the CPU]
var ms_n: [5]s32
var ms_hits: [5]s32             // the masher's hits landed, at each level
var ms_ticks: s32
var ms_hold: u32                // the masher's held direction and how long
var ms_hold_t: s32
const MS_MECHS: [6]Mech = [Mech.Hero, Mech.Doubleblade, Mech.Beam, Mech.Tank, Mech.Twins, Mech.Shadow]
const MS_LEVELS = match VIEW { 0 => 2, else => 5 }    // VIEW 1 and 2 (not in check.sh): every level
const MS_FLAIL = VIEW == 2      // VIEW 2: a weaker player still: wanders both ways, presses less
const MS_MATCHES = 36 * MS_LEVELS               // every pairing (6 x 6) at each level

private fn ms_rand(n: s32) -> s32 {
    ms_rng = ms_rng * 1103515245 + 12345
    return ((ms_rng >> 16) & 0x7FFF) as s32 % n
}

// The CPU level of match k: EASY's two (the novice, 0), or with VIEW 1 every level (-1 to 3).
private fn ms_level(k: s32) -> s32 { return k % MS_LEVELS - 1 }

private fn ms_start() {
    let k = ms_match
    let a = MS_MECHS[(k / MS_LEVELS) % 6]
    let b = MS_MECHS[(k / (6 * MS_LEVELS)) % 6]
    fight_stage(ST_HANGAR)
    fight_init(a, b, FightMode.VsCpu, ms_level(k))
    ms_hold = 0
    ms_hold_t = 0
}

// The novice's pad: walks in, and mashes: a press every few frames, mostly A.
private fn masher() -> u32 {
    let f = &fight.f[0]
    let o = &fight.f[1]
    var fwd = RIGHT
    if o.x < f.x { fwd = LEFT }
    let d = abs(o.x - f.x)
    var p: u32 = 0
    if ms_hold_t > 0 {
        ms_hold_t -= 1
        p = ms_hold
    } else if d > 7.0 && !(MS_FLAIL && ms_rand(100) < 3) {
        p = fwd
    } else {
        let r = ms_rand(100)
        let back = if_u(fwd == RIGHT, LEFT, RIGHT)
        if MS_FLAIL {
            if r < 35 { ms_hold = fwd } else if r < 50 { ms_hold = DOWN } else if r < 65 { ms_hold = 0 } else { ms_hold = back }
            ms_hold_t = 10 + ms_rand(30)
        } else {
            if r < 55 { ms_hold = fwd } else if r < 70 { ms_hold = DOWN } else if r < 80 { ms_hold = 0 } else { ms_hold = back }
            ms_hold_t = 6 + ms_rand(14)
        }
        p = ms_hold
    }
    if ms_rand(100) < if_else(MS_FLAIL, 9, 22) {
        let r = ms_rand(100)
        if MS_FLAIL {
            if r < 45 { p |= A } else if r < 65 { p |= B } else if r < 90 { p |= X } else { p |= Y }
        } else {
            if r < 60 { p |= A } else if r < 82 { p |= B } else if r < 92 { p |= X } else { p |= Y }
        }
    }
    return p
}

private fn if_u(c: bool, a: u32, b: u32) -> u32 {
    if c { return a }
    return b
}

private fn measure() {
    if done_ok { return }
    if hf == 1 { ms_start() }
    for k in 0..200 {
        ms_ticks += 1
        let h1 = fight.f[1].health
        fight_tick(masher(), 0, vec2(0.0, 0.0), vec2(0.0, 0.0))
        let lv = ms_match % MS_LEVELS
        if fight.f[1].health < h1 { ms_hits[lv] += 1 }
        if fight.phase == Phase.MatchOver {
            let w = fight.winner
            if w == 0 || w == 1 { ms_wins[lv][w] += 1 }
            ms_n[lv] += 1
            ms_match += 1
            if ms_match >= MS_MATCHES {
                ms_report()
                return
            }
            ms_start()
        }
    }
}

private fn ms_report() {
    for lv in 0..MS_LEVELS {
        if lv == 0 { print("the novice CPU (EASY's company fights): ") }
        else if lv == 1 { print("level 0 (EASY's final): ") }
        else {
            print("level ")
            print_int(lv - 1)
            print(": ")
        }
        print("the masher won ")
        print_int(ms_wins[lv][0])
        print(" of ")
        print_int(ms_n[lv])
        print(" matches (")
        print_int(ms_wins[lv][0] * 100 / max(ms_n[lv], 1))
        print(" %), the CPU ")
        print_int(ms_wins[lv][1])
        print("; the masher's hits ")
        print_int(ms_hits[lv])
        println("")
    }
    print("ticks ")
    print_int(ms_ticks)
    println("")
    assert(ms_wins[0][0] * 100 >= ms_n[0] * 75, "the masher does not beat the novice CPU three times in four")
    assert(ms_wins[1][0] * 100 >= ms_n[1] * 55, "the masher does not beat EASY's final level most of the time")
    println("OK ladder 116: EASY is beatable by mashing")
    done_ok = true
}

// ---- 117-119: a whole run

const RUN_MECH = match SCENARIO { 117 => 0, 118 => 1, else => 3 }      // roster slots: Hero, Shadow, Tank
const RUN_DIFF = match SCENARIO { 117 => DIFF_EASY, 118 => DIFF_NORMAL, else => DIFF_HARD }
const RUN_LOSE = 1              // the fight on the ladder lost once (then continued)

var rn_fight: s32               // fights entered
var rn_lost: bool               // the RUN_LOSE fight was lost once
var rn_levels: [8]s32
var rn_seen_twins: bool
var rn_seen_grey: bool
var rn_cover: bool
var rn_unlock: bool
var rn_sched: s32
var rn_reveal: bool
var rn_done: bool
var rn_last_st: St

private fn full_run() {
    if rn_done { return }
    let t = st_t
    if st != rn_last_st {
        on_enter(st)
        rn_last_st = st
    }
    match st {
        Title => {
            if rn_fight == 0 && t == 25 { pads[0] = A }
            if rn_fight > 0 && rn_cover { finish_run() }
        }
        Mode => { if t == 10 { pads[0] = A } }                  // Arcade
        Diff => {
            if t >= 12 && t % 6 == 0 {
                if diff_sel < RUN_DIFF { pads[0] = DOWN }
                else if diff_sel > RUN_DIFF { pads[0] = UP }
                else { pads[0] = A }
            }
        }
        Select => {
            if t == 5 { sel_cur[0] = RUN_MECH }
            if t == 12 { pads[0] = A }
        }
        Sched => { if t == SCHED_WAIT + 2 { pads[0] = A } }
        Reveal => { if t == REVEAL_WAIT + 30 { pads[0] = A } }
        Vs => { if t == 22 { pads[0] = A } }
        Fight => {
            let f = fight_get()
            if f.phase == Phase.Fight && f.phase_t == 150 {
                // the round ends here: the CPU's unit down, or (once, on RUN_LOSE) the player's
                if ladder == RUN_LOSE && !rn_lost { fight.f[0].health = 0 } else { fight.f[1].health = 0 }
            }
        }
        Results => {
            if t == 45 {
                if !won {
                    assert(ladder == RUN_LOSE, "a fight lost that was meant to be won")
                    rn_lost = true
                }
                pads[0] = A
            }
            if cleared && t > 45 && !save_writing && t % 10 == 0 { pads[0] = A }
        }
        Cover => {
            rn_cover = true
            if t > COVER_WAIT && !save_writing && t % 10 == 1 { pads[0] = A }
        }
        Unlock => {
            rn_unlock = true
            if t == 95 { pads[0] = A }
        }
        else => {}
    }
}

private fn on_enter(s: St) {
    match s {
        Sched => rn_sched += 1
        Reveal => {
            rn_reveal = true
            assert(ladder_final(ladder), "a reveal before a company fight")
        }
        Fight => {
            let f = fight_get()
            rn_levels[rn_fight] = f.cpu_level
            assert_eq(f.cpu_level, ladder_level(ladder), "the fight's CPU level")
            assert(p_mech[1] == run.foe[ladder], "the fight's opponent is not the programme's")
            assert(p_grey[1] == run.grey[ladder], "the test unit's grey")
            if p_mech[1] == Mech.Twins && !slot_unlocked(4) { rn_seen_twins = true }
            if p_grey[1] { rn_seen_grey = true }
            assert_eq(f.stage, stage_pick(), "the fight's stage")
            if ladder_final(ladder) { assert_eq(f.stage, ST_ROOFTOP, "the final is not on the rooftop") }
            else { assert_eq(f.stage, ST_HANGAR, "a company fight off the hangar") }
            print("fight ")
            print_int(rn_fight + 1)
            print(" (programme ")
            print_int(ladder + 1)
            print("): ")
            print(ladder_maker_name(ladder))
            print(", ")
            print(ladder_unit_name(ladder))
            print(", CPU level ")
            print_int(f.cpu_level)
            println("")
            rn_fight += 1
        }
        else => {}
    }
}

private fn finish_run() {
    rn_done = true
    let me = slot_mech(RUN_MECH)
    let ms = mech_maker_k(me)
    // the programme as drawn
    assert(run.me == me, "the run's mech")
    assert_eq(run.diff, RUN_DIFF, "the run's difficulty")
    for i in 0..LADDER_N - 1 {
        assert(run.maker[i] != ms, "a company fight against your own maker")
        assert(run.maker[i] != run.maker[LADDER_N - 1], "a company fight against the final's maker")
        assert(!run.grey[i], "a test unit in a company fight")
        assert_eq(mech_slot(run.foe[i]), run.maker[i], "a company fight's mech is not its maker's base mech")
        for j in 0..i { assert(run.maker[i] != run.maker[j], "a maker drawn twice") }
    }
    if RUN_MECH == 0 {
        assert(run.foe[LADDER_N - 1] == Mech.Doubleblade && !run.grey[LADDER_N - 1], "the Hero's final is its echo")
        assert_eq(run.fin, FIN_ECHO, "the Hero's final kind")
    } else {
        assert(run.foe[LADDER_N - 1] == me && run.grey[LADDER_N - 1], "no echo: the final is the test unit")
        assert_eq(run.fin, FIN_TEST, "the final kind")
        assert(rn_seen_grey, "the test unit never fought")
    }
    assert_eq(rn_fight, LADDER_N + 1, "fights entered (the ladder and one continue)")
    assert(rn_lost, "the lost fight")
    assert_eq(rn_sched, LADDER_N, "the schedule page before each fight of the programme")
    assert(rn_reveal, "no reveal before the final")
    assert(rn_cover, "no cover")
    let d = &DIFFS[RUN_DIFF]
    for i in 0..LADDER_N { assert_eq(rn_levels[i + if_else(i > RUN_LOSE, 1, 0)], ladder_level(i), "a fight's level") }
    // the clear: its stamp, and the unlock on any difficulty
    assert(slot_medal(RUN_MECH, RUN_DIFF), "the clear's stamp")
    assert_eq(slot_medals(RUN_MECH), 1, "stamps on other grades")
    assert(slot_cleared(RUN_MECH), "the clear is not marked for the unlock rules")
    if RUN_MECH == 0 {
        assert(rn_unlock, "no unlock screen")
        assert(slot_ok(ROSTER_COLS), "the clear did not unlock the Double-blade Hero")
    } else {
        assert(!rn_unlock, "an unlock screen with nothing to unlock")
    }
    assert_eq(save_result, CARD_OK, "the save failed")
    print("the run on ")
    print(d.name)
    print(": levels ")
    for i in 0..LADDER_N + 1 {
        print_int(rn_levels[i])
        print(" ")
    }
    print("(the lost fight twice); the Twins drawn while locked: ")
    if rn_seen_twins { println("yes") } else { println("no") }
    report_screen("the schedule page", St.Sched)
    report_screen("the reveal", St.Reveal)
    report_screen("the fights", St.Fight)
    report_screen("the cover", St.Cover)
    assert_eq(pk_late[St.Sched as s32] + pk_late[St.Reveal as s32] + pk_late[St.Cover as s32], 0, "late frames on the new screens")
    if SCENARIO == 117 { assert(rn_seen_twins, "the Twins were not drawn while locked (117's seed)") }
    report_ok()
}

// ---- 120: the lot

var drawn: [8][5]s32                // 120: [mech][maker], how often drawn

private fn lot_check() {
    save.unlocked = 0
    var twins_locked = 0
    var runs = 0
    for mi in 0..6 {
        let me = MS_MECHS[mi]
        for sd in 0..300 {
            let seed = (sd as u32) * 7919 + 13
            ladder_make(me, DIFF_NORMAL, seed)
            runs += 1
            let ms = mech_maker_k(me)
            let fm = run.maker[LADDER_N - 1]
            for i in 0..LADDER_N - 1 {
                let k = run.maker[i]
                assert(k >= 0 && k < MAKERS_N, "a company fight's maker")
                assert(k != ms, "your own maker drawn")
                assert(k != fm, "the final's maker drawn")
                for j in 0..i { assert(run.maker[j] != k, "a maker drawn twice") }
                assert(!run.grey[i], "a test unit drawn")
                drawn[mi][k] += 1
                if run.foe[i] == Mech.Twins && !slot_unlocked(4) { twins_locked += 1 }
            }
            // the same seed, the same programme
            let a0 = run.foe[0]
            let a1 = run.foe[1]
            ladder_make(me, DIFF_HARD, seed)
            assert(run.foe[0] == a0 && run.foe[1] == a1, "the same seed drew another programme")
        }
        // every rival maker drawn
        ladder_make(me, DIFF_NORMAL, 1)
        let ms = mech_maker_k(me)
        let fm = run.maker[LADDER_N - 1]
        print(mech_name(me))
        print(": final ")
        print(ladder_unit_name(LADDER_N - 1))
        print("; rivals drawn")
        for k in 0..MAKERS_N {
            print(" ")
            print(MAKERS[k].short)
            print(" ")
            print_int(drawn[mi][k])
            if k != ms && k != fm { assert(drawn[mi][k] > 60, "a rival maker drawn too rarely") }
            else { assert_eq(drawn[mi][k], 0, "a maker drawn that may not be") }
        }
        println("")
    }
    assert(twins_locked > 0, "the Twins never drawn while locked")
    print("the Twins drawn while locked in ")
    print_int(twins_locked)
    print(" fights of ")
    print_int(runs)
    println(" runs")
    // the levels ramp to the final
    for d in 0..DIFF_N {
        run.diff = d
        for i in 0..LADDER_N - 1 { assert(ladder_level(i) <= ladder_level(i + 1), "the levels do not ramp") }
        print(DIFFS[d].name)
        print(" levels:")
        for i in 0..LADDER_N {
            print(" ")
            print_int(ladder_level(i))
        }
        println("")
    }
    println("OK ladder 120: the lot")
    done_ok = true
}

// ---- 121: the save's migration

private fn hook_121() {
    if hf == 5 {
        // the MVP's save: the Hero and Beam cleared, the Double-blade Hero unlocked, two clears
        var v1: [4]u32
        v1[0] = SAVE_MAGIC
        v1[1] = 1
        v1[2] = UNLOCK_ECHO | ((1 as u32) << CLEAR_SHIFT) | ((1 as u32) << (CLEAR_SHIFT + 2))
        v1[3] = 2
        assert_eq(card_save(SAVE_NUM, &v1[0], SAVE_V1_BYTES, &save_meta), CARD_OK, "writing the version-1 save")
    }
    if hf == 30 {
        assert(!card_busy(), "the card is still busy")
        save = MxSave {}
        save_boot()
        assert_eq(save.version as s32, 2, "the save's version")
        assert(slot_ok(ROSTER_COLS), "the echo's unlock was lost")
        assert(slot_cleared(0) && slot_cleared(2), "the clears were lost")
        assert_eq(save.clears as s32, 2, "the clear count")
        assert(slot_medal(0, DIFF_NORMAL) && slot_medal(2, DIFF_NORMAL), "the old clears are not NORMAL stamps")
        assert(!slot_medal(0, DIFF_EASY) && !slot_medal(0, DIFF_HARD), "stamps on other grades")
        assert(!slot_medal(1, DIFF_NORMAL) && !slot_medal(3, DIFF_NORMAL), "stamps for mechs that never cleared")
        assert_eq(save.diff as s32, DIFF_NORMAL, "the saved difficulty")
        println("the version-1 save: version 2, the Hero and Beam stamped NORMAL, the echo unlocked")
        if VIEW == 1 { save.medals |= medal_bit(0, DIFF_EASY) | medal_bit(0, DIFF_HARD) | medal_bit(5, DIFF_HARD) }
        game = Game.Arcade
        diff_sel = DIFF_NORMAL
        enter_select()
        if VIEW == 1 { sel_cur[0] = 0 } else { sel_cur[0] = 2 }
    }
}

// ---- 122: the difficulty select

private fn hook_122() {
    press(0, 25, START)                 // the title
    press(0, 35, A)                     // Arcade
    press(0, 50, B)                     // back to the mode select
    press(0, 58, A)                     // Arcade again
    press(0, 72, UP)                    // NORMAL (saved) to EASY
    if hf == 49 {
        assert(st == St.Diff, "Arcade did not lead to the difficulty select")
        assert_eq(diff_sel, DIFF_NORMAL, "the cursor did not start on the saved grade")
    }
    if hf == 53 { assert(st == St.Mode, "B did not go back") }
}

// ---- 123-126: screens set up directly

// A run for slot `slot` on difficulty d, at fight n.
private fn arcade_at(slot: s32, d: s32, n: s32, seed: u32) {
    game = Game.Arcade
    p_cpu = true
    p_mech[0] = slot_mech(slot)
    diff_sel = d
    ladder_make(p_mech[0], d, seed)
    ladder = n
}

private fn setup_sched() {
    save.unlocked = 0
    arcade_at(0, DIFF_NORMAL, VIEW, 5)
    enter_sched()
}

private fn setup_reveal() {
    save.unlocked = UNLOCK_ECHO
    match VIEW {
        0, 1 => arcade_at(0, DIFF_NORMAL, LADDER_N - 1, 5)
        2 => arcade_at(2, DIFF_HARD, LADDER_N - 1, 5)
        else => arcade_at(ROSTER_COLS, DIFF_EASY, LADDER_N - 1, 5)
    }
    enter_reveal()
}

private fn setup_test_fight() {
    save.unlocked = 0
    if VIEW == 0 { arcade_at(1, DIFF_HARD, LADDER_N - 1, 5) }
    else { arcade_at(4, DIFF_HARD, LADDER_N - 1, 5) }
    p_mech[1] = run.foe[ladder]
    p_grey[1] = run.grey[ladder]
    enter_fight()
}

private fn hook_125() {
    // CPU against CPU (both sides), the Twins kept split for four bodies on screen
    if st != St.Fight { return }
    fight.cpu_level = 2
    let p = cpu_pad(0, 2)
    if VIEW == 1 { pads[0] = p & ~L } else { pads[0] = p }
    fight.f[0].health = max(fight.f[0].health, 200)
    fight.f[1].health = max(fight.f[1].health, 200)
}

// 126's covers: VIEW 0-5 one per mech (the Hero's contract, the Double-blade Hero's upset, Beam,
// Tank, the combined Twins and Shadow beating the test unit), frozen in their held pose, with
// the fanfare playing; VIEW 6 the Hero with another seed (another cover); VIEW 7 the Hero's after
// the fanfare (the menu loop back). VIEW 0 also measures every pool line against the layout and
// checks the pick: two seeds, two covers; the same seed twice, not the same headline twice.
const COVER_SLOTS: [8]s32 = [0, ROSTER_COLS, 2, 3, 4, 1, 0, 0]
const COVER_SEEDS: [8]u32 = [5, 5, 5, 5, 5, 5, 77, 5]
const COVER_DIFFS: [8]s32 = [DIFF_EASY, DIFF_NORMAL, DIFF_HARD, DIFF_NORMAL, DIFF_HARD, DIFF_EASY, DIFF_NORMAL, DIFF_EASY]

private fn setup_cover() {
    save.unlocked = 0
    save.diff = DIFF_NORMAL as u32
    if VIEW == 1 { save.unlocked = UNLOCK_ECHO }
    if VIEW == 4 { save.unlocked = 0x10 }                    // the Twins unlocked
    if VIEW == 0 {
        cover_widths()
        cover_picks()
        save.diff = DIFF_NORMAL as u32
    }
    arcade_at(COVER_SLOTS[VIEW], COVER_DIFFS[VIEW], LADDER_N - 1, COVER_SEEDS[VIEW])
    cover_pick()
    print("cover ")
    print_int(VIEW)
    print(": ")
    print(COVER_HEADS[cover_head].h0)
    print(" ")
    print(COVER_HEADS[cover_head].h1)
    for i in 0..3 {
        print(" / ")
        print(cover_tease[i].a)
    }
    println("")
    enter_cover()
}

// Every headline with every unit's names, and every cover line, within the layout's widths.
private fn cover_widths() {
    var n = 0
    var buf: [64]u8
    var worst_l0 = 0
    for i in 0..len(COVER_HEADS) {
        let h = &COVER_HEADS[i]
        fits(txt_w(FONT_TITLE, h.h0), COVER_W_BIG, h.h0)
        fits(txt_w(FONT_TITLE, h.h1), COVER_W_BIG, h.h1)
        for s in 0..ROSTER_N {
            if !slot_has_mech(s) { continue }
            run.me = slot_mech(s)
            if h.maker != CO_ANY && h.maker != mech_maker_k(run.me) { continue }
            cover_head = i
            let l0 = cover_l0(&buf[0])
            worst_l0 = max(worst_l0, txt_w(FONT_HEAD, l0))
            fits(txt_w(FONT_HEAD, l0), COVER_W_SUB, l0)
            let l1 = cover_fill(&buf[0], h.l1)
            fits(txt_w(FONT_LABEL, l1), COVER_W_LINE, l1)
            n += 1
        }
    }
    var t = 0
    for i in 0..2 {
        t += tease_fits(&TEASE_TWINS[i]) + tease_fits(&TEASE_ECHOES[i]) + tease_fits(&TEASE_CLIENT[i])
    }
    for i in 0..len(TEASE_PRESS) { t += tease_fits(&TEASE_PRESS[i]) }
    print("cover lines: ")
    print_int(n)
    print(" headlines (with each unit's names) and ")
    print_int(t)
    print(" teasers fit; the widest unit line ")
    print_int(worst_l0)
    println(" px")
    assert_eq(too_wide, 0, "cover lines wider than the layout")
}

// A line w pixels wide against its limit: printed and failed when over.
private fn fits(w: s32, lim: s32, s: *u8) {
    if w <= lim { return }
    print("too wide (")
    print_int(w)
    print(" of ")
    print_int(lim)
    print(" px): ")
    println(s)
    too_wide += 1
}

var too_wide: s32

private fn tease_fits(c: *Tease) -> s32 {
    var buf: [64]u8
    fits(txt_w(FONT_LABEL, c.a), COVER_W_TEASE, c.a)
    let b = cover_fill(&buf[0], c.b)
    fits(txt_w(FONT_MICRO, b), COVER_W_TEASE, b)
    return 1
}

// Two seeds give two covers; the same seed twice in a row does not repeat its headline; a run
// replays its cover (the pick is the seed's and the last headline's alone).
private fn cover_picks() {
    save.diff = DIFF_NORMAL as u32
    arcade_at(0, DIFF_NORMAL, LADDER_N - 1, 5)
    cover_pick()
    let a = cover_head
    let a0 = cover_tease[2]
    save.diff = DIFF_NORMAL as u32
    arcade_at(0, DIFF_NORMAL, LADDER_N - 1, 77)
    cover_pick()
    assert(cover_head != a || cover_tease[2] != a0, "two seeds gave the same cover")
    save.diff = DIFF_NORMAL as u32
    arcade_at(0, DIFF_NORMAL, LADDER_N - 1, 5)
    cover_pick()
    assert_eq(cover_head, a, "the same seed and save gave another headline")
    cover_pick()
    assert(cover_head != a, "the same headline as the last clear's")
    assert_eq((save.diff & 255) as s32, DIFF_NORMAL, "the cover's pick moved the saved grade")
    println("cover picks: two seeds differ, a replay is the same, the last headline is not repeated")
}
// ---- 127: a continue

var ct_level: s32
var ct_stage: s32
var ct_foe: Mech

private fn setup_continue() {
    save.unlocked = 0
    arcade_at(0, DIFF_NORMAL, 1, 5)
    p_mech[1] = run.foe[1]
    fight_stage(stage_pick())
    fight_init(p_mech[0], p_mech[1], FightMode.Arcade, ladder_level(1))
    ct_level = fight.cpu_level
    ct_stage = fight.stage
    ct_foe = p_mech[1]
    fight.winner = 1
    fight.wins[1] = 2
    fight.f[0].health = 0
    fight.phase = Phase.MatchOver
    enter_results()
}

private fn hook_127() {
    if VIEW == 1 {
        press(0, 70, A)
        press(0, 100, A)                // past the VS screen
    } else if VIEW == 2 {
        press(0, 70, B)
    }
}

// ---- what the shot frame must show

private fn check_shot() {
    match SCENARIO {
        121 => {
            assert(st == St.Select, "not the character select")
            assert(slot_medal(0, DIFF_NORMAL), "the Hero's NORMAL stamp")
        }
        122 => {
            assert(st == St.Diff, "not the difficulty select")
            assert_eq(diff_sel, DIFF_EASY, "UP did not move to EASY")
        }
        123 => {
            assert(st == St.Sched, "not the schedule page")
            assert_eq(ladder, VIEW, "the programme's day")
        }
        124 => {
            assert(st == St.Reveal, "not the reveal")
            if VIEW == 2 { assert(run.grey[ladder] && run.fin == FIN_TEST, "Beam's final is not the test unit") }
            if VIEW == 3 { assert(run.fin == FIN_ORIGINAL && run.foe[ladder] == Mech.Hero, "the echo's final is not the Hero") }
        }
        125 => {
            assert(st == St.Fight, "not the fight")
            assert(p_grey[1] && !p_grey[0], "the test unit's side")
            if VIEW == 1 {
                assert(twins_on(0) && twins_on(1), "the Twins are not split on both sides")
            }
            print("the test unit's fight: peak triangles ")
            print_int(peak_tris)
            println("")
            assert(peak_tris < 4000, "over 4,000 triangles")
            report_screen("the fight", St.Fight)
        }
        126 => {
            assert(st == St.Cover, "not the cover")
            if VIEW == 7 {
                assert(!sound_playing(6) && !sound_playing(7), "the fanfare did not end")
                assert(sound_playing(3), "the menu loop did not come back after the fanfare")
            } else {
                assert(sound_playing(6) && sound_playing(7), "no fanfare on the cover")
                assert(!sound_playing(3), "the menu loop plays under the fanfare")
            }
        }
        127 => {
            if VIEW == 0 {
                assert(st == St.Results && !won, "not the lost fight's results")
            } else if VIEW == 1 {
                assert(st == St.Vs || st == St.Fight, "the continue did not lead back to the fight")
                assert_eq(ladder, 1, "the continue moved the ladder")
                assert_eq(cont_n, 1, "the continue was not counted")
                assert(p_mech[1] == ct_foe, "the continue's opponent")
                if st == St.Fight {
                    assert_eq(fight.cpu_level, ct_level, "the continue's level")
                    assert_eq(fight.stage, ct_stage, "the continue's stage")
                }
            } else {
                assert(st == St.Title, "B did not withdraw to the title")
            }
        }
        else => {}
    }
}
