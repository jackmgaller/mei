    Hazard { z: 850.0, x: -20.4, kind: HZ_MARKER }, Hazard { z: 850.0, x: 20.4, kind: HZ_MARKER },
    Hazard { z: 852.0, x: -7.0, kind: HZ_PINE },    // below crest 2
