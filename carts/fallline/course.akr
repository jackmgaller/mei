    Hazard { z: 1650.0, x: -20.4, kind: HZ_MARKER }, Hazard { z: 1650.0, x: 20.4, kind: HZ_MARKER },
]

// ---- the profile as a function

private var seg_hint: s32 = 1

// The profile segment that holds z: PROFILE[i].z <= z < PROFILE[i + 1].z, clamped to the ends.
fn course_seg(z: fixed) -> s32 {
    var i = seg_hint
    while i > 0 && z < PROFILE[i].z { i -= 1 }
    while i < PROFILE_N - 2 && z >= PROFILE[i + 1].z { i += 1 }
    seg_hint = i
    return i
}

// dy/dz of the segment that holds z (negative downhill; at a point, the segment below it).
fn course_grade(z: fixed) -> fixed {
    let i = course_seg(z)
    let a = PROFILE[i]
    let b = PROFILE[i + 1]
    return (b.y - a.y) / (b.z - a.z)
}

// The snow's height at z.
fn course_y(z: fixed) -> fixed {
    let i = course_seg(z)
    let a = PROFILE[i]
    let b = PROFILE[i + 1]
    return a.y + (z - a.z) * ((b.y - a.y) / (b.z - a.z))
}
