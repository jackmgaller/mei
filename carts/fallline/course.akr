    Hazard { z: 1050.0, x: -20.4, kind: HZ_MARKER }, Hazard { z: 1050.0, x: 20.4, kind: HZ_MARKER },
    Hazard { z: 1112.0, x: 9.5, kind: HZ_PINE },    // below crest 3
    Hazard { z: 1124.0, x: -11.0, kind: HZ_PINE },
    Hazard { z: 1150.0, x: -20.4, kind: HZ_MARKER }, Hazard { z: 1150.0, x: 20.4, kind: HZ_MARKER },
    Hazard { z: 1222.0, x: 14.0, kind: HZ_PINE },
    Hazard { z: 1250.0, x: -20.4, kind: HZ_MARKER }, Hazard { z: 1250.0, x: 20.4, kind: HZ_MARKER },
