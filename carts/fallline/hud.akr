// The interface: the run's HUD, the title, the countdown, the pause and the results. Y2K
// techno: big slanted segment numerals (quads on the interface list), tiny technical labels in
// the small font ("SYS.04 // VELOCITY"), smoked-blue glass panels with cyan rules, lime and
// magenta for ahead and behind.

const C_WHITE = 0xFFFFFF
const C_CYAN = 0xFFDC00         // rgb(0, 220, 255)
const C_BLUE = 0xFF5A28         // rgb(40, 90, 255)
const C_LIME = 0x1EFFAA         // rgb(170, 255, 30)
const C_MAGENTA = 0xAA28FF      // rgb(255, 40, 170)
const C_TANGERINE = 0x148CFF    // rgb(255, 140, 20)
const C_SILVER = 0xF0E4D7       // rgb(215, 228, 240)
const C_GLASS = 0x501E08        // rgb(8, 30, 80): panels, half-blended
const C_INK = 0x40140A          // rgb(10, 20, 64)

// Segments of 0-9: bit 0 top, 1 top right, 2 bottom right, 3 bottom, 4 bottom left, 5 top left,
// 6 middle.
const SEGS: [10]u8 = [0x3F, 0x06, 0x5B, 0x4F, 0x66, 0x6D, 0x7D, 0x07, 0x7F, 0x6F]

var sbuf: [48]u8

fn hud_init() {}

// ---- strings

// "m:ss.cc" from frames.
fn str_append_run_time(dst: *u8, cap: s32, frames: s32) -> *u8 {
    let cs = frames * 5 / 3
    str_append_int(dst, cap, cs / 6000, 0, false)
    str_append(dst, cap, ":")
    str_append_int(dst, cap, (cs / 100) % 60, 2, true)
    str_append(dst, cap, ".")
    return str_append_int(dst, cap, cs % 100, 2, true)
}

// "+s.cc" or "-s.cc" from frames.
fn str_append_delta(dst: *u8, cap: s32, frames: s32) -> *u8 {
    var f = frames
    if f < 0 {
        str_append(dst, cap, "-")
        f = -f
    } else {
        str_append(dst, cap, "+")
    }
    let cs = f * 5 / 3
    str_append_int(dst, cap, cs / 100, 0, false)
    str_append(dst, cap, ".")
    return str_append_int(dst, cap, cs % 100, 2, true)
}

fn sb() -> *u8 {
    sbuf[0] = 0
    return &sbuf[0]
}

// ---- segment numerals

// A slanted bar: (x0, y0)-(x1, y1) leaning right by a quarter of its height above yb.
private fn seg_bar(x0: s32, y0: s32, x1: s32, y1: s32, yb: s32, col: u32) {
    let s0 = (yb - y0) >> 2
    let s1 = (yb - y1) >> 2
    quad_fill(x0 + s0, y0, x1 + s0, y0, x0 + s1, y1, x1 + s1, y1, col, BLEND_NONE)
}

// One digit, w x h, bars t thick, top-left at (x, y).
fn seg_digit(x: s32, y: s32, d: s32, w: s32, h: s32, t: s32, col: u32) {
    let m = SEGS[d % 10] as s32
    let yb = y + h
    let hm = y + (h - t) / 2
    if m & 1 != 0 { seg_bar(x, y, x + w, y + t, yb, col) }
    if m & 2 != 0 { seg_bar(x + w - t, y, x + w, hm + t, yb, col) }
    if m & 4 != 0 { seg_bar(x + w - t, hm, x + w, yb, yb, col) }
    if m & 8 != 0 { seg_bar(x, yb - t, x + w, yb, yb, col) }
    if m & 16 != 0 { seg_bar(x, hm, x + t, yb, yb, col) }
    if m & 32 != 0 { seg_bar(x, y, x + t, hm + t, yb, col) }
    if m & 64 != 0 { seg_bar(x, hm, x + w, hm + t, yb, col) }
}

// A string of digits, ':', '.', '+' and '-' in segments; returns the x after it.
fn seg_text(x: s32, y: s32, s: *u8, w: s32, h: s32, t: s32, col: u32) -> s32 {
    let gap = max(t / 2 + 1, 2)
    var cx = x
    var p = s
    let yb = y + h
    while p[0] != 0 {
        let c = p[0] as s32
        p += 1
        if c >= '0' && c <= '9' {
            seg_digit(cx, y, c - '0', w, h, t, col)
            cx += w + gap
        } else if c == ':' {
            seg_bar(cx, y + h / 4, cx + t, y + h / 4 + t, yb, col)
            seg_bar(cx, yb - h / 4 - t, cx + t, yb - h / 4, yb, col)
            cx += t + gap
        } else if c == '.' {
            seg_bar(cx, yb - t, cx + t, yb, yb, col)
            cx += t + gap
        } else if c == '-' || c == '+' {
            let hm = y + (h - t) / 2
            seg_bar(cx, hm, cx + w * 2 / 3, hm + t, yb, col)
            if c == '+' {
                let xm = cx + w / 3 - t / 2
                seg_bar(xm, hm - w / 3 + t / 2, xm + t, hm + w / 3 + t / 2, yb, col)
            }
            cx += w * 2 / 3 + gap
        } else {
            cx += w / 2
        }
    }
    return cx
}

fn seg_width(s: *u8, w: s32, t: s32) -> s32 {
    let gap = max(t / 2 + 1, 2)
    var n = 0
    var p = s
    while p[0] != 0 {
        let c = p[0] as s32
        p += 1
        if c >= '0' && c <= '9' { n += w + gap }
        else if c == ':' || c == '.' { n += t + gap }
        else if c == '-' || c == '+' { n += w * 2 / 3 + gap }
        else { n += w / 2 }
    }
    return n - gap
}

// ---- wide letters: the 8x8 font stretched and slanted (sprite_corners)

fn wide_text(x: s32, y: s32, s: *u8, cw: s32, ch: s32, col: u32) -> s32 {
    let page = tex_page(FONT_SLOT, FONT_PALETTE, true)
    let tint = col_tint(col)
    let sk = ch / 4
    var xs: [4]s32
    var ys: [4]s32
    var cx = x
    var p = s
    while p[0] != 0 {
        let c = p[0] as s32
        p += 1
        if c > 32 && c < 127 {
            let g = c - 32
            xs[0] = cx + sk
            xs[1] = cx + cw + sk
            xs[2] = cx
            xs[3] = cx + cw
            ys[0] = y
            ys[1] = y
            ys[2] = y + ch
            ys[3] = y + ch
            sprite_corners(page, (g & 15) * 8, (g >> 4) * 8, 8, 8, &xs[0], &ys[0], tint, BLEND_NONE)
        }
        cx += cw
    }
    return cx
}

fn wide_centre(cx: s32, y: s32, s: *u8, cw: s32, ch: s32, col: u32, shadow: u32) {
    let w = strlen(s) * cw
    let x = cx - w / 2 - ch / 8
    if shadow != 0 { wide_text(x + 2, y + 2, s, cw, ch, shadow) }
    wide_text(x, y, s, cw, ch, col)
}

// ---- panels and labels

fn panel(x: s32, y: s32, w: s32, h: s32) {
    rect_blend(x, y, w, h, C_GLASS, BLEND_HALF)
    rect_blend(x, y, w, 1, C_CYAN, BLEND_NONE)
    rect_blend(x, y + h - 1, w / 3, 1, C_CYAN, BLEND_HALF)
}

fn label(x: s32, y: s32, s: *u8, col: u32) { font_text(x, y, s, col) }

fn label_right(x: s32, y: s32, s: *u8, col: u32) { font_text_align(x, y, s, col, ALIGN_RIGHT) }

fn label_centre(x: s32, y: s32, s: *u8, col: u32) { font_text_align(x, y, s, col, ALIGN_CENTRE) }

// ---- the run

fn draw_hud() {
    // velocity
    panel(6, 6, 116, 42)
    label(10, 9, "SYS.04 // VELOCITY", C_CYAN)
    let kmh = clamp((rider_speed() * 36 / 10) as s32, 0, 999)
    let b = sb()
    str_append_int(b, 48, kmh, 3, true)
    seg_text(12, 21, b, 15, 22, 4, C_WHITE)
    label(76, 34, "KM/H", C_SILVER)
    if rd.tuck { tag(96, 21, "TUCK", C_LIME) }
    else if rd.edge { tag(96, 21, "EDGE", C_TANGERINE) }

    // chrono
    panel(186, 6, 128, 42)
    label(190, 9, "SYS.01 // CHRONO", C_CYAN)
    var t = run_time()
    if st == St.Finish { t = finish_f }
    let tb = str_append_run_time(sb(), 48, t)
    let tw = seg_width(tb, 13, 4)
    seg_text(308 - tw, 21, tb, 13, 22, 4, C_WHITE)

    // messages under the chrono
    if msg_t > 0 && (msg_t > 30 || msg_t & 4 != 0) { draw_msg() }

    // gates
    panel(6, 204, 92, 30)
    label(10, 207, "SYS.07 // GATES", C_CYAN)
    let gb = sb()
    str_append_int(gb, 48, gates_clean, 2, true)
    let gx = seg_text(12, 218, gb, 8, 12, 2, C_WHITE)
    let gt = sb()
    str_append(gt, 48, "/")
    str_append_int(gt, 48, GATES_N, 0, false)
    label(gx + 2, 222, gt, C_SILVER)
    if gates_missed > 0 {
        let mb = sb()
        str_append(mb, 48, "MISS ")
        str_append_int(mb, 48, gates_missed, 0, false)
        label(56, 222, mb, C_MAGENTA)
    }

    // airtime
    if rd.air && rd.air_t > 12 {
        panel(222, 204, 92, 30)
        label(226, 207, "SYS.09 // AIRTIME", C_CYAN)
        let ab = sb()
        str_append_int(ab, 48, rd.air_t / 60, 0, false)
        str_append(ab, 48, ".")
        str_append_int(ab, 48, (rd.air_t % 60) * 10 / 60, 0, false)
        seg_text(240, 218, ab, 8, 12, 2, C_LIME)
        label(272, 222, "SEC", C_SILVER)
    }

    progress_bar()
}

private fn tag(x: s32, y: s32, s: *u8, col: u32) {
    rect_blend(x, y, 22, 10, col, BLEND_NONE)
    label(x + 2, y + 1, s, C_INK)
}

private fn draw_msg() {
    let b = sb()
    match msg {
        Clean => {
            panel(214, 52, 100, 22)
            label(218, 55, "GATE // CLEAN", C_LIME)
            str_append_int(b, 48, msg_v + 1, 2, true)
            str_append(b, 48, " OF ")
            str_append_int(b, 48, GATES_N, 0, false)
            label(218, 64, b, C_SILVER)
        }
        Miss => {
            panel(214, 52, 100, 22)
            label(218, 55, "GATE // MISSED", C_MAGENTA)
            label(218, 64, "PENALTY +2.00", C_WHITE)
        }
        Split => {
            panel(198, 52, 116, 30)
            str_append(b, 48, "SPLIT ")
            str_append_int(b, 48, split_n, 0, false)
            str_append(b, 48, " // DELTA")
            label(202, 55, b, C_CYAN)
            if best_before == 0 {
                let tb = str_append_run_time(sb(), 48, split_f[split_n - 1])
                seg_text(204, 65, tb, 8, 13, 2, C_WHITE)
            } else {
                var col = C_LIME
                if msg_v > 0 { col = C_MAGENTA }
                let db = str_append_delta(sb(), 48, msg_v)
                seg_text(204, 65, db, 8, 13, 2, col)
            }
        }
        Crash => {
            panel(214, 52, 100, 22)
            label(218, 55, "IMPACT // RECOVER", C_TANGERINE)
            label(218, 64, "MOMENTUM LOST", C_WHITE)
        }
        None => {}
    }
}

// The course as a line along the bottom: the sled, the ghost and the split lines on it.
private fn progress_bar() {
    let x0 = 104
    let w = 112
    let y = 226
    rect_blend(x0, y, w, 2, C_GLASS, BLEND_HALF)
    for i in 0..SPLITS_N {
        let sx = x0 + (SPLIT_Z[i] / FINISH_Z * w) as s32
        rect_blend(sx, y - 2, 1, 6, C_SILVER, BLEND_NONE)
    }
    rect_blend(x0 + w, y - 3, 2, 8, C_WHITE, BLEND_NONE)
    if !new_record && ghost_at(ghost_f) {
        let gx = x0 + (clamp(gh_pos.z, 0.0, FINISH_Z) / FINISH_Z * w) as s32
        rect_blend(gx - 1, y - 3, 3, 3, C_SILVER, BLEND_HALF)
    }
    let rx = x0 + (clamp(rd.z, 0.0, FINISH_Z) / FINISH_Z * w) as s32
    rect_blend(x0, y, rx - x0, 2, C_CYAN, BLEND_NONE)
    rect_blend(rx - 1, y + 2, 3, 3, C_CYAN, BLEND_NONE)
    label_centre(x0 + w / 2, 212, "SYS.02 // COURSE", C_CYAN)
}

// ---- the title

fn draw_title() {
    // the masthead
    rect_blend(0, 34, 320, 94, C_GLASS, BLEND_HALF)
    rect_blend(0, 34, 320, 1, C_CYAN, BLEND_NONE)
    rect_blend(0, 127, 320, 1, C_CYAN, BLEND_NONE)
    label(8, 38, "SYNERGEN // SYS.00", C_CYAN)
    label_right(312, 38, "TIME ATTACK // 01", C_CYAN)
    wide_centre(160, 52, "FALL LINE", 32, 34, C_WHITE, C_BLUE)
    label_centre(160, 92, "S Y N E R G E N   G L A C I E R   A R R A Y", C_SILVER)
    // a barcode and a rule, for the look
    for i in 0..24 {
        let w = 1 + ((i * 7) % 3)
        rect_blend(8 + i * 4, 108, w, 12, C_WHITE, BLEND_NONE)
    }
    rect_blend(112, 108, 200, 1, C_CYAN, BLEND_NONE)
    label(112, 111, "1.75 KM  //  20 GATES  //  3 CRESTS", C_WHITE)

    // the record
    panel(96, 150, 128, 34)
    label_centre(160, 153, "SYS.03 // COURSE RECORD", C_CYAN)
    if best_frames() != 0 {
        let b = str_append_run_time(sb(), 48, best_frames())
        let w = seg_width(b, 11, 3)
        seg_text(160 - w / 2, 165, b, 11, 15, 3, C_WHITE)
    } else {
        label_centre(160, 168, "NO RECORD // RUN FREE", C_SILVER)
    }

    if (tick / 20) & 1 == 0 || tick < 30 {
        wide_centre(160, 200, "PRESS START", 12, 12, C_WHITE, C_BLUE)
    }
    rect_blend(0, 219, 320, 13, C_GLASS, BLEND_HALF)
    label_centre(160, 221, "STICK CARVE  //  A TUCK  //  B HARD EDGE  //  START PAUSE", C_SILVER)
}

// ---- the countdown

fn draw_countdown() {
    let n = 3 - st_t / COUNT_STEP
    let k = st_t % COUNT_STEP
    if n > 0 {
        let b = sb()
        str_append_int(b, 48, n, 0, false)
        // grows in over the first frames of each count
        let h = 40 + 24 * min(k, 8) / 8
        let w = h * 5 / 8
        let t = h / 6
        seg_digit(160 - w / 2 + 2, 82 - h / 2 + 2, n, w, h, t, C_BLUE)
        seg_digit(160 - w / 2, 82 - h / 2, n, w, h, t, C_WHITE)
    }
    panel(96, 206, 128, 22)
    label_centre(160, 209, "SYS.00 // LAUNCH SEQUENCE", C_CYAN)
    label_centre(160, 218, "NO ENGINE. NO BRAKES.", C_WHITE)
    draw_hud_static()
}

// What the HUD shows before the run: the velocity and chrono at zero.
private fn draw_hud_static() {
    panel(6, 6, 116, 42)
    label(10, 9, "SYS.04 // VELOCITY", C_CYAN)
    seg_text(12, 21, "000", 15, 22, 4, C_WHITE)
    label(76, 34, "KM/H", C_SILVER)
    panel(186, 6, 128, 42)
    label(190, 9, "SYS.01 // CHRONO", C_CYAN)
    let tw = seg_width("0:00.00", 13, 4)
    seg_text(308 - tw, 21, "0:00.00", 13, 22, 4, C_WHITE)
}

// "GO" stays up into the first frames of the run.
fn draw_go() {
    if run_f < GO_SHOW { wide_centre(160, 66, "GO", 40, 40, C_LIME, C_INK) }
}

// The finish line: the banner over the HUD until the results.
fn draw_finish() {
    if st_t < 8 && st_t & 2 != 0 { return }
    wide_centre(160, 84, "FINISH", 30, 32, C_WHITE, C_BLUE)
    if new_record { label_centre(160, 122, "SYS.05 // NEW COURSE RECORD", C_LIME) }
    else { label_centre(160, 122, "SYS.05 // RUN COMPLETE", C_CYAN) }
}

// ---- pause

fn draw_pause() {
    rect_blend(0, 0, 320, 240, C_GLASS, BLEND_HALF)
    wide_centre(160, 90, "PAUSED", 24, 24, C_WHITE, C_BLUE)
    label_centre(160, 124, "SYS.00 // HOLD", C_CYAN)
    label_centre(160, 140, "START RESUME  //  SELECT QUIT", C_SILVER)
}

// ---- results

fn draw_results() {
    rect_blend(30, 30, 260, 182, C_GLASS, BLEND_HALF)
    rect_blend(30, 30, 260, 1, C_CYAN, BLEND_NONE)
    rect_blend(30, 211, 260, 1, C_CYAN, BLEND_NONE)
    label(36, 34, "SYS.05 // RUN COMPLETE", C_CYAN)
    label_right(284, 34, "SYNERGEN GLACIER ARRAY", C_CYAN)

    let tb = str_append_run_time(sb(), 48, finish_f)
    let tw = seg_width(tb, 20, 5)
    seg_text(160 - tw / 2, 48, tb, 20, 30, 5, C_WHITE)
    if new_record && (tick / 12) & 1 == 0 {
        rect_blend(108, 84, 104, 12, C_MAGENTA, BLEND_NONE)
        label_centre(160, 86, "NEW COURSE RECORD", C_WHITE)
    }

    // splits
    for i in 0..SPLITS_N {
        let y = 104 + i * 14
        let b = sb()
        str_append(b, 48, "SPLIT ")
        str_append_int(b, 48, i + 1, 0, false)
        label(44, y, b, C_CYAN)
        let sb2 = str_append_run_time(sb(), 48, split_f[i])
        label(110, y, sb2, C_WHITE)
        if best_before != 0 {
            let d = split_f[i] - best_splits[i]
            var col = C_LIME
            if d > 0 { col = C_MAGENTA }
            label(180, y, str_append_delta(sb(), 48, d), col)
        }
    }
    let y = 104 + SPLITS_N * 14
    label(44, y, "GATES", C_CYAN)
    let gb = sb()
    str_append_int(gb, 48, gates_clean, 0, false)
    str_append(gb, 48, " / ")
    str_append_int(gb, 48, GATES_N, 0, false)
    if gates_missed > 0 {
        str_append(gb, 48, "   PENALTY +")
        str_append_int(gb, 48, gates_missed * 2, 0, false)
        str_append(gb, 48, ".00")
    }
    label(110, y, gb, C_WHITE)
    label(44, y + 14, "BEST", C_CYAN)
    if best_frames() != 0 {
        label(110, y + 14, str_append_run_time(sb(), 48, best_frames()), C_WHITE)
        if !new_record && best_before != 0 {
            label(180, y + 14, str_append_delta(sb(), 48, finish_f - best_frames()), C_MAGENTA)
        }
    }
    label_centre(160, 198, "START RETRY  //  SELECT TITLE", C_SILVER)
    if card_saving || card_pending { label_right(284, 216, "WRITING MEMORY CARD", C_CYAN) }
}
