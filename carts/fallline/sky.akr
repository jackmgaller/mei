// Fall Line's sky (the slope engine's, README.md): a big sunny Y2K gradient on the backdrop
// (line channel 0), one band of distant ridges with Synergen's machinery on BG1 sitting on the
// horizon row (it moves with the pitch) and following eye.x a little, and below the horizon the
// valley haze the farthest snow fades into. slope.akr calls sky_init() and sky_frame().
//
// The gradient is made once, as a table of 1,024 lines relative to the horizon, in the spare
// VRAM at 0x44B000; each frame channel 0 is pointed at the 240 lines that fit this horizon, so
// a moving horizon costs nothing.

const SL_SKY_TAB = 0x44B000      // 1,024 words: line i is horizon-relative row i - SKY_ZERO
const SKY_ZERO = 600
const SKY_N = 6
const SKY_COLS: [6]u32 = [
    0xE07A12,       // deep cyan-blue, high up
    0xF0A82C,
    0xF8D070,       // cyan
    0xFFEEC0,       // pale
    0xFFFCF4,       // white at the horizon
    0xFAE6D2,       // the valley haze just below it (RIDGE_HAZE)
]
const SKY_DY: [6]s32 = [-230, -150, -80, -26, 0, 6]
const RIDGE_RATE: fixed = 0.6   // ridge pixels a metre of eye.x (they are far away)

var sky_turb: s32 = -1          // the turbines' rotor frame (0-2)

fn sky_init() {
    atlas_load(ATLAS_1, PLANE_RIDGE_TILES, 32768)
    load_palette(PAL_RIDGE * 16, PLANE_RIDGE_PAL, 16)
    plane(BG1, ATLAS_1, MAP_BG1, RIDGE_MAP_W, RIDGE_MAP_H, 0, PAL_RIDGE)
    map_load(BG1, PLANE_RIDGE_MAP)
    line_off(2)
    // the gradient table: colour stops at horizon-relative rows SKY_DY, linear between
    let t = SL_SKY_TAB as *u32
    for i in 0..1024 {
        let d = i - SKY_ZERO
        var c = SKY_COLS[0]
        if d >= SKY_DY[SKY_N - 1] {
            c = SKY_COLS[SKY_N - 1]
        } else if d > SKY_DY[0] {
            var k = 0
            while d >= SKY_DY[k + 1] { k += 1 }
            let f = fixed(d - SKY_DY[k]) / (SKY_DY[k + 1] - SKY_DY[k])
            c = clerp(SKY_COLS[k], SKY_COLS[k + 1], f)
        }
        t[i] = c
    }
}

// The sky for a horizon at screen row hrow (it may be off the screen), the ridges scrolled for
// eye.x. About 150 cycles.
fn sky_frame(hrow: s32, ex: fixed) {
    let h = clamp(hrow, 240 - 1024 + SKY_ZERO, SKY_ZERO)
    line_channel(0, LC_BD_COLOR, 1, (SL_SKY_TAB + (SKY_ZERO - h) * 4) as u32)
    plane_scroll(BG1, (ex * RIDGE_RATE) as s32, RIDGE_HZ - hrow)
    // the rotors turn: a frame every 8 ticks (three blades, so three frames make a turn of 120)
    let f = ((FRAME >> 3) % 3) as s32
    if f != sky_turb {
        sky_turb = f
        let idx = PLANE_RIDGE_ANIM
        let ent = PLANE_RIDGE_ANIM + RIDGE_TURBINES + f * RIDGE_TURBINES * 4
        let m = MAP_BG1 as *u16
        for t in 0..RIDGE_TURBINES {
            let i = idx[t] as s32
            m[i] = ent[t * 4]
            m[i + 1] = ent[t * 4 + 1]
            m[i + RIDGE_MAP_W] = ent[t * 4 + 2]
            m[i + RIDGE_MAP_W + 1] = ent[t * 4 + 3]
        }
    }
}
