// Fall Line's slope engine (README.md, "Slope engine (A) -> game (B)"): the snow is BG2, the
// affine plane, with real crests and run-outs, under a sky on the backdrop and ridges on BG1.
//
// The camera faces straight down the fall line: yaw 0, no roll, any pitch, any eye. Then every
// screen row is a plane through the eye that contains the x axis, and the snow (which does not
// vary with x) meets it along one line of constant z. So each row casts one ray in the side
// view (z, y) against the profile, takes the first hit and its view depth w, and the row is
// affine: u = S x + UOFF along it (U0, DUX from w), v = S s(z) at the hit (the arc length, so
// the texture does not stretch over a crest), DVX = 0. Crests occlude by themselves: the rows
// just above a crest's row hit the far slope. The rays are derived from the view-projection
// matrix camera_look() made, as plane_floor() does, so polygons sit exactly on the snow. Rows
// are cast bottom to top, and the hits only move downhill as the ray rises, so the search walks
// the profile once a frame (__sl_rows, about 100 cycles a row).
//
// Objects behind the snow: a depth proxy. The snow is also drawn as a few big flat quads (one
// per profile segment in view, as wide as the screen at their depth) into the low polygon layer
// (PL) with the depth test, and BG2 is in front of PL, so the quads never show but fill the
// depth buffer with the snow. Objects draw into PH (in front of BG2) with the depth test, so
// whatever lies behind the snow from the eye (beyond a crest, or the metre a model reaches below
// the snow) fails the test and the snow shows there: every crest on screen at once, and partial
// occlusion too. slope_layer() only drops what is wholly hidden.
//
// Level of detail: the map holds eight bands of the same snow, each with only the detail its
// distance can show. A row picks its band from its footprint, max(texels a pixel across the row,
// texels of v between rows), the second w^2 S / (F h) with h the eye's height over the row's
// segment; the thresholds differ by row mod 4, which dithers each handover over a few rows.
// The haze (the colour offset, by view depth) is a line table too.
//
// Line channels: 0 the sky (BD_COLOR), 3 the haze (PLN_OFS), 7 BG2 (U0, V0, DUX, DVX). 2 and 4
// are the slope engine's but unused. VRAM: atlases ATLAS_0 (snow) and ATLAS_1 (ridges), maps
// MAP_BG2 and MAP_BG1, tables LT_AFFINE, LT_FREE (haze) and SL_SKY_TAB (the sky gradient, in the
// spare 4 KB at 0x44B000); no texture slot. Palettes 240-248.

import "planes.akr"
import "depth.akr"
import "course.akr"
import "plane_art.akr"
import "sky.akr"

const SLOPE_FAR: fixed = 480.0      // view depth where the snow has faded into the haze (< 512)
const SLOPE_PROXY_COL: u32 = 0xFAEEE2
const SL_EXT_BACK: fixed = 1000.0    // the first segment extended uphill by this much
const SL_EXT_FWD: fixed = 1000.0     // the last one on downhill
const SL_LMAX = 70                   // points ahead of the eye at most
const LT_HAZE = LT_FREE              // the haze table (channel 3), 1 word a line
const SL_F: fixed = 207.85           // the focal length in pixels (60 degrees, both axes)

// Priorities: BG1 (ridges) 1, PL (the depth proxy) 2, BG2 (snow) 3, PH (objects, interface) 5,
// BG0 (a HUD plane, if the game uses one) 6.
const SL_PRIO: u32 = 0x52331166

// ---- the profile, extended at both ends

var sl_n: s32
var sl_z: [68]fixed
var sl_y: [68]fixed
var sl_s: [68]fixed                  // arc length from PROFILE[0]
var sl_g: [68]fixed                  // the grade of segment i (i to i + 1)
var sl_k: [68]fixed                  // its arc length a metre of z: sqrt(1 + g^2)
var sl_hint: s32 = 1

// ---- this frame

// A profile point ahead of the eye (point 0 is the snow under the eye), out to the first beyond
// SLOPE_FAR, with the segment from it to the next point. Row k's ray passes above a point while
// P + k Q > 0. __sl_rows reads it by offset, a lane group at a time.
struct SlPt {
    P: fixed         // +0 this point
    Q: fixed
    Pn: fixed        // +8 the next point's
    Qn: fixed
    W: fixed         // +16 view depth
    dW: fixed        // to the next point
    V: fixed         // v in texels, within a band's period (16 m)
    D: fixed         // texels of v to the next point
    G: fixed         // +32 S / (F h): h the eye's height over the segment
    z: fixed
    y: fixed
    pad: fixed
}

var sl_eye: vec3
var sl_hrow: s32                     // the horizon's screen row
var sl_top: s32 = 240                // the first row of snow
var sl_ln: s32
var sl_pt: [70]SlPt
var sl_lM: [70]fixed                 // the steepest sight line (dy/dz) over the points so far
var sl_c: [8]fixed                   // __sl_rows's constants: cU, FAR, the last point, -, kU, kD
var sl_cycles: s32                   // CPU cycles the last slope_frame took

// the proxy: a mesh in RAM, up to 70 points (140 vertices) and 69 quads
struct SlProxy {
    m: Mesh
    v: [140]vec4
    f: [69]Face
}
var sl_proxy: SlProxy

// The bands' thresholds, divided by a dither factor for each row mod 4: bands 1-5 by the v
// footprint (texels of v from one row to the next), 6 and 7 by DUX (texels a pixel along the
// row), among the rows where nothing across the run can show any more (band 5 and on).
const SL_TV: [5]fixed = [1.4, 3.0, 6.0, 12.0, 24.0]
const SL_TU: [2]fixed = [3.0, 9.0]
const SL_JITTER: [4]fixed = [0.80, 1.10, 0.92, 1.24]
var sl_thr: [32]fixed                // [row mod 4][Tv1..Tv5, Tu6, Tu7, -]
var sl_haze: [64]u32                 // PLN_OFS words by view depth / 8

// The haze colour offset at full haze (5-bit units), toward the valley haze's blue.
const SL_HAZE_R = -4
const SL_HAZE_G = -2
const SL_HAZE_B = 0
const SL_HAZE_NEAR: fixed = 60.0     // no haze nearer than this

// ---- setup

fn slope_init() {
    camera_clip(0.3, 500.0)
    render_depth(true)
    planes_on()
    // the profile and its extensions
    let n = PROFILE_N
    sl_n = n + 2
    for i in 0..n {
        sl_z[i + 1] = PROFILE[i].z
        sl_y[i + 1] = PROFILE[i].y
    }
    let g0 = (PROFILE[1].y - PROFILE[0].y) / (PROFILE[1].z - PROFILE[0].z)
    sl_z[0] = PROFILE[0].z - SL_EXT_BACK
    sl_y[0] = PROFILE[0].y - g0 * SL_EXT_BACK
    let gn = (PROFILE[n - 1].y - PROFILE[n - 2].y) / (PROFILE[n - 1].z - PROFILE[n - 2].z)
    sl_z[n + 1] = PROFILE[n - 1].z + SL_EXT_FWD
    sl_y[n + 1] = PROFILE[n - 1].y + gn * SL_EXT_FWD
    for i in 0..sl_n - 1 {
        sl_g[i] = (sl_y[i + 1] - sl_y[i]) / (sl_z[i + 1] - sl_z[i])
        sl_k[i] = sqrt(1.0 + sl_g[i] * sl_g[i])
    }
    sl_s[1] = 0.0
    sl_s[0] = -SL_EXT_BACK * sl_k[0]
    for i in 1..sl_n - 1 { sl_s[i + 1] = sl_s[i] + (sl_z[i + 1] - sl_z[i]) * sl_k[i] }

    // BG2: the snow, 16x16 tiles, a 128 x 128 map, tile 0 outside it
    atlas_load(ATLAS_0, PLANE_SNOW_TILES, 32768)
    load_palette(PAL_SNOW * 16, PLANE_SNOW_PAL, SNOW_BANDS * 16)
    plane(BG2, ATLAS_0, MAP_BG2, SNOW_MAP_W, SNOW_MAP_H, PLANE_16PX | PLANE_TILE0_OUT, PAL_SNOW)
    map_load(BG2, PLANE_SNOW_MAP)
    let t = LT_AFFINE as *fixed
    for y in 0..240 { t[y * 4 + 3] = 0.0 }   // DVX: always 0 (yaw 0)
    BG2_DUY = 0.0
    BG2_DVY = 0.0
    sky_init()
    PLN_PRIO = SL_PRIO
    // the haze: on the snow and on the high polygons (what stands in it), by row
    for i in 0..64 {
        let d = fixed(i * 8 + 4)
        var h = clamp((d - SL_HAZE_NEAR) / (SLOPE_FAR - SL_HAZE_NEAR), 0.0, 1.0)
        h = h * (2.0 - h)                          // eases out toward the far limit
        sl_haze[i] = sl_ofs(h)
    }
    slope_haze_objects(true)
    for p in 0..4 {
        for b in 0..5 { sl_thr[p * 8 + b] = SL_TV[b] / SL_JITTER[p] }
        for b in 0..2 { sl_thr[p * 8 + 5 + b] = SL_TU[b] / SL_JITTER[p] }
        sl_thr[p * 8 + 7] = 30000.0
    }
    // the proxy mesh's fixed parts
    sl_proxy.m.verts = 16
    sl_proxy.m.faces = (16 + 140 * 16) as u32
    sl_proxy.m.windows = 0
    for i in 0..69 {
        let f = &sl_proxy.f[i]
        f.flags = (FACE_QUAD | FACE_DOUBLE) as u8
        f.idx[0] = (i * 2) as u16
        f.idx[1] = (i * 2 + 1) as u16
        f.idx[2] = (i * 2 + 2) as u16
        f.idx[3] = (i * 2 + 3) as u16
        f.col[0] = SLOPE_PROXY_COL
    }
}

// The PLN_OFS word for haze h (0..1).
fn sl_ofs(h: fixed) -> u32 {
    let r = (h * SL_HAZE_R + 0.5) as s32
    let g = (h * SL_HAZE_G + 0.5) as s32
    let b = (h * SL_HAZE_B + 0.5) as s32
    return (r as u32 & 255) | ((g as u32 & 255) << 8) | ((b as u32 & 255) << 16)
}

// ---- the profile as a function

fn sl_seg(z: fixed) -> s32 {
    var i = sl_hint
    while i > 0 && z < sl_z[i] { i -= 1 }
    while i < sl_n - 2 && z >= sl_z[i + 1] { i += 1 }
    sl_hint = i
    return i
}

// The snow's height at z.
fn slope_y(z: fixed) -> fixed {
    let i = sl_seg(z)
    return sl_y[i] + (z - sl_z[i]) * sl_g[i]
}

// dy/dz at z (negative downhill; at a point, the segment below it).
fn slope_grade(z: fixed) -> fixed { return sl_g[sl_seg(z)] }

// The arc length along the snow from the profile's first point to z.
fn slope_s(z: fixed) -> fixed {
    let i = sl_seg(z)
    return sl_s[i] + (z - sl_z[i]) * sl_k[i]
}

// ---- every frame

// The camera (camera_look(eye, 0, pitch)) and every line table for this frame, and the depth
// proxy. Call it first in draw(): it leaves poly_upper(true) on, so what is drawn after it goes
// to PH. The pitch is clamped to -0.9..0.5 and the eye kept 0.3 m above the snow.
fn slope_frame(eye: vec3, pitch: fixed) {
    let c0 = CYCLES
    let p = clamp(pitch, -0.9, 0.5)
    var e = eye
    e.y = max(e.y, slope_y(e.z) + 0.3)
    sl_eye = e
    camera_look(e, 0.0, p)
    render_depth(true)
    poly_upper(false)
    sl_list()
    sl_rows()
    sky_frame(sl_hrow, e.x)
    sl_draw_proxy()
    poly_upper(true)
    sl_cycles = c0 - CYCLES
}

// CPU cycles the last slope_frame() took.
fn slope_cycles() -> s32 { return sl_cycles }
// The horizon's screen row this frame (off the screen when the camera looks far down or up).
fn slope_horizon() -> s32 { return sl_hrow }
// The first screen row of snow this frame (240: none).
fn slope_top() -> s32 { return sl_top }

// The points ahead of the eye with their row coefficients.
fn sl_list() {
    let a1y = __vp[1].y
    let a1z = __vp[1].z
    let a3y = __vp[3].y
    let a3z = __vp[3].z
    let a3w = __vp[3].w
    // row k's ray is (dz, dy) = (a1y - k a3y, -a1z + k a3z), along which w grows
    let ez = sl_eye.z
    let ey = sl_eye.y
    let i = sl_seg(ez)
    var n = 0
    var z = ez
    var y = sl_y[i] + (ez - sl_z[i]) * sl_g[i]
    var s = sl_s[i] + (ez - sl_z[i]) * sl_k[i]
    var sprev = s
    var j = i + 1
    var m = -10.0                    // (sight lines kept within -10..10: m dz stays in range)
    let gk = SNOW_S / SL_F
    while true {
        let q = &sl_pt[n]
        let dy0 = ey - y
        let dz0 = z - ez
        q.z = z
        q.y = y
        q.P = dy0 * a1y - dz0 * a1z
        q.Q = dz0 * a3z - dy0 * a3y
        let w = a3y * y + a3z * z + a3w
        q.W = w
        q.V = from_bits(bits(s) & 0xFFFFF) * SNOW_S       // (s mod 16 m) in texels
        // the eye's height over the segment from this point on
        let sg = j - 1
        let h = max((ey - y + sl_g[sg] * dz0) / sl_k[sg], 0.5)
        q.G = gk / h
        if n > 0 {
            let r = &sl_pt[n - 1]
            r.Pn = q.P
            r.Qn = q.Q
            r.dW = w - r.W
            r.D = (s - sprev) * SNOW_S
            if dz0 > 0.1 { m = clamp(max(m, -dy0 / dz0), -10.0, 10.0) }
        }
        sl_lM[n] = m
        sprev = s
        n += 1
        if w > SLOPE_FAR || j >= sl_n || n >= SL_LMAX { break }
        z = sl_z[j]
        y = sl_y[j]
        s = sl_s[j]
        j += 1
    }
    sl_ln = n
    // the horizon: the row whose ray is level (dy = 0)
    if a3z > 0.01 {
        sl_hrow = 120 - (a1z / a3z * 120) as s32
    } else {
        sl_hrow = -1000
    }
}

// Casts the rows: fills LT_AFFINE (U0, V0 with its band, DUX), LT_HAZE and sl_top, and points
// channels 3 and 7 at them.
var sl_top_prev: s32 = 0
fn sl_rows() {
    let a0x = __vp[0].x
    let a0w = __vp[0].w
    let kU = SNOW_S / a0x
    sl_c[0] = SNOW_UOFF - a0w * kU
    sl_c[1] = SLOPE_FAR
    sl_c[2] = from_bits(&sl_pt[sl_ln - 1] as s32)
    sl_c[4] = kU
    sl_c[5] = kU / 160
    let t239 = (LT_AFFINE + 239 * 16) as *fixed
    let top = __sl_rows(&sl_c[0], &sl_pt[0], t239, (LT_HAZE + 239 * 4) as *u32)
    sl_top = top
    // the haze table above the snow is clear (the rows from the last frame's top that are sky now)
    let hz = LT_HAZE as *u32
    for y in sl_top_prev..top { hz[y] = 0 }
    sl_top_prev = top
    let r = __bg_regs(BG2)
    r[5] = (r[5] & 0xFF00) | (top as u32)
    line_channel(7, LC_BG2_AFFINE, 4, LT_AFFINE)
    line_channel(3, LC_OFS, 1, LT_HAZE)
}

// The rows from 239 up. c: cU, FAR, the last point, -, kU, kD. Row y has k = (120 - y) / 120,
// stepped exactly as quotient and remainder. The segment's constants sit in vector registers
// (v4: P, Q, Pn, Qn; v6: W, dW, V, D; v2: kU, kD, G) and are reloaded only when the ray passes
// above the segment's far point; no next point, or a hit beyond FAR, ends the rows. At the hit
// (a fraction a along the segment) w = W + a dW, U0 = cU - w kU, DUX = w kD, V0 = (V + a D) mod
// the band's period, plus 256 texels a band: the band from the v footprint w^2 G against the
// row's thresholds (sl_thr, by y mod 4), and in the far bands from DUX; the haze word
// sl_haze[w / 8]. About 100 cycles a row. Returns the first row of snow (240: none).
asm fn __sl_rows(c: *fixed, pts: *SlPt, tbl: *fixed, hz: *u32) -> s32 {
    addi sp, sp, -24
    sw   r9, [sp+0]
    sw   r10, [sp+4]
    sw   r11, [sp+8]
    sw   r12, [sp+12]
    sw   r13, [sp+16]
    sw   r15, [sp+20]
    vld  v0, [{c}+0]            ; cU, FAR, last, -
    vld  v2, [{c}+16]           ; kU, kD, (G), -
    la   r12, {sl_haze}
    la   r10, {sl_thr}
    li   r13, 0xFFFFFF          ; the band's period in texels, as a mask: (256 << 16) - 1
    lui  r15, 0x4000            ; one band: 256 texels (1 << 24)
    li   r9, -64990             ; k for row 239: floor(-119 * 65536 / 120)
    addi r1, r0, 16             ; ... and its remainder
    addi r11, r0, 239           ; y
.seg:
    vld  v4, [{pts}+0]
    vld  v6, [{pts}+16]
    lw   r7, [{pts}+32]
    vset v2, r7, 2
.row:
    vscale v5, v4, r9
    vget r5, v4, 0
    vget r6, v5, 1
    add  r5, r5, r6             ; g at this point (> 0: the ray is above it)
    vget r6, v4, 2
    vget r7, v5, 3
    add  r6, r6, r7             ; g at the next point
    blt  r0, r6, .adv
    sub  r7, r5, r6
    fdiv r5, r5, r7             ; a: the hit's fraction along the segment
    vscale v7, v6, r5
    vget r6, v6, 0
    vget r7, v7, 1
    add  r6, r6, r7             ; w
    vget r7, v0, 1
    blt  r7, r6, .done          ; beyond FAR
    vscale v3, v2, r6           ; w kU, w kD, w G
    vget r7, v3, 0
    vget r8, v0, 0
    sub  r8, r8, r7
    sw   r8, [{tbl}+0]          ; U0
    vget r8, v3, 1
    sw   r8, [{tbl}+8]          ; DUX
    sari r7, r6, 19             ; w / 8 m
    shli r7, r7, 2
    add  r7, r7, r12
    lw   r7, [r7+0]
    sw   r7, [{hz}+0]           ; the haze
    vget r7, v3, 2
    fmul r7, r7, r6             ; the v footprint: w^2 G
    vget r6, v6, 2
    vget r8, v7, 3
    add  r6, r6, r8
    and  r6, r6, r13            ; V0 within the band
    andi r8, r11, 3
    shli r8, r8, 5
    add  r8, r8, r10            ; this row's thresholds
    lw   r5, [r8+16]
    bge  r7, r5, .far           ; nothing across the run shows: bands 5-7 by DUX
    lw   r5, [r8+0]
    blt  r7, r5, .band
    add  r6, r6, r15
    lw   r5, [r8+4]
    blt  r7, r5, .band
    add  r6, r6, r15
    lw   r5, [r8+8]
    blt  r7, r5, .band
    add  r6, r6, r15
    lw   r5, [r8+12]
    blt  r7, r5, .band
    add  r6, r6, r15
    jmp  .band
.far:
    lui  r5, 0x14000            ; band 5
    add  r6, r6, r5
    vget r7, v3, 1              ; DUX
    lw   r5, [r8+20]
    blt  r7, r5, .band
    add  r6, r6, r15
    lw   r5, [r8+24]
    blt  r7, r5, .band
    add  r6, r6, r15
.band:
    sw   r6, [{tbl}+4]          ; V0
    addi {tbl}, {tbl}, -16
    addi {hz}, {hz}, -4
    addi r11, r11, -1
    addi r9, r9, 546            ; k += 1 / 120: 65536 = 546 * 120 + 16
    addi r1, r1, 16
    slti r7, r1, 120
    bne  r7, r0, .k
    addi r1, r1, -120
    addi r9, r9, 1
.k:
    bge  r11, r0, .row
    jmp  .done
.adv:
    addi {pts}, {pts}, 48
    vget r7, v0, 2
    bne  {pts}, r7, .seg        ; past the last point: no hit
.done:
    addi r1, r11, 1
    lw   r9, [sp+0]
    lw   r10, [sp+4]
    lw   r11, [sp+8]
    lw   r12, [sp+12]
    lw   r13, [sp+16]
    lw   r15, [sp+20]
    addi sp, sp, 24
}

// The depth proxy: from just below the screen's bottom row to the far limit, quads as wide as
// the screen at their depth, into PL with the depth test.
fn sl_draw_proxy() {
    let a0x = __vp[0].x
    let kx = 1.15 / a0x
    let ex = sl_eye.x
    // the first point: the hit of a row 12 below the screen (k = -1.1)
    let k = -1.1
    var j = 0
    let last = sl_ln - 1
    var gj = sl_pt[0].P + k * sl_pt[0].Q
    var gn = sl_pt[1].P + k * sl_pt[1].Q
    while gn > 0.0 && j < last - 1 {
        j += 1
        gj = gn
        gn = sl_pt[j + 1].P + k * sl_pt[j + 1].Q
    }
    let a = gj / (gj - gn)
    let p0 = &sl_pt[j]
    let p1 = &sl_pt[j + 1]
    var z = p0.z + a * (p1.z - p0.z)
    var y = p0.y + a * (p1.y - p0.y)
    var w = p0.W + a * (p1.W - p0.W)
    var n = 0
    let far = SLOPE_FAR - 2.0
    while true {
        let hw = w * kx + 1.0
        sl_proxy.v[n * 2] = vec4(ex - hw, y, z, 1.0)
        sl_proxy.v[n * 2 + 1] = vec4(ex + hw, y, z, 1.0)
        n += 1
        j += 1
        if j > last || w >= far || n >= SL_LMAX { break }
        let q = &sl_pt[j]
        z = q.z
        y = q.y
        w = q.W
        if w > far {
            // cut the segment at the far limit
            let r = &sl_pt[j - 1]
            let f = (far - r.W) / (w - r.W)
            z = r.z + f * (z - r.z)
            y = r.y + f * (y - r.y)
            w = far
        }
    }
    if n < 2 { return }
    sl_proxy.m.nverts = (n * 2) as u16
    sl_proxy.m.nfaces = (n - 1) as u16
    mesh(&sl_proxy.m)
}

// ---- objects

// Whether an object at p (its centre, or its foot on the snow) with radius r (its top is taken
// to be p.y + r) shows: 0 hidden (behind the camera, beyond the haze or wholly behind a crest:
// don't draw it), 1 in front of every crest, 2 partly behind one (the depth proxy hides that
// part). Both 1 and 2 are drawn the same way, after slope_draw_layer().
fn slope_layer(p: vec3, r: fixed) -> s32 {
    let w = view_depth(p)
    if w < -r || w - r > SLOPE_FAR { return 0 }
    let dz = p.z - sl_eye.z
    if dz <= 0.5 || dz > SLOPE_FAR { return 1 }
    let dy = p.y - sl_eye.y
    // the steepest sight line over the profile's points between the eye and the object
    var m = -10.0
    for j in 1..sl_ln {
        if sl_pt[j].z >= p.z - r { break }
        m = sl_lM[j]
    }
    if m <= -10.0 { return 1 }
    if dy + r < m * dz { return 0 }
    if dy - r < m * dz { return 2 }
    return 1
}

// Whether the haze also tints the high polygons (PH: the objects, and the interface list, which
// planes_on() puts there) on the rows where far snow lies: on at the start. The haze is only
// on rows whose snow is beyond 60 m, so a HUD at the top of the screen is tinted (by at most
// -4 red, -2 green in 5-bit units) only when the camera looks far down the slope.
fn slope_haze_objects(on: bool) {
    var m = (1 << BG2) as u32
    if on { m = m | (1 << LAYER_PH) as u32 }
    PLN_MATH = (PLN_MATH & 0xC0FFFFFF) | (m << 24)
}

// Sets up the following mesh draws for slope_layer()'s answer: both visible layers draw into
// PH with the depth test on (the depth proxy hides what is behind the snow).
fn slope_draw_layer(_layer: s32) {
    render_depth(true)
    poly_upper(true)
}
