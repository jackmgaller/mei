// The sled's physics: gravity along the local grade, air drag, snow friction, carving, airtime
// off crests and the landing, the run's edges and the hazards. One step a frame (60 Hz).
//
// On the snow the sled is a speed along the surface (spd) and a heading (hd: 0 straight down the
// fall line, positive toward +x). Carving turns it on a radius and bleeds speed in proportion to
// how hard it carves. Off the snow it is a velocity (vx, vy, vz) under gravity: it leaves the
// snow wherever the ground falls away faster than its ballistic path (a crest), and on landing
// the part of its velocity into the snow is lost (the thump) and the rest goes on along it.

const GRAV = 9.8
const DT = 0.0166667            // one 60 Hz tick
const MU = 0.03                 // snow friction
const CD = 0.0032               // air drag (a = CD * v^2): about 28 m/s at grade 0.3
const CD_TUCK = 0.0021          // tucked: about 35 m/s at grade 0.3
const R_CARVE = 22.0            // turn radius at full carve
const R_EDGE = 9.0              // with B, the hard edge
const R_TUCK = 42.0             // tucked
const BLEED = 0.16              // speed lost a second per unit of carve, times the speed
const BLEED_EDGE = 0.85
const BLEED_TUCK = 0.10
const TURN_MAX = 2.2            // the fastest turn (rad/s), at low speed
const HD_MAX = 1.35             // the most the sled turns across the fall line (77 degrees)
const AIR_TURN = 0.5            // rad/s of heading change at full carve in the air
const EDGE_X = 19.0             // the sled's centre stays within x ±19
const SLED_R = 0.7              // the sled's collision radius
const DOWN_FRAMES = 60          // a knockdown lasts a second
const DOWN_KEEP = 0.35          // of the speed, when knocked down
const PUSH_SPEED = 6.0          // the push off at the start
const FINISH_DECEL = 7.0        // braking after the finish line

struct Rider {
    x: fixed
    y: fixed
    z: fixed
    px: fixed                   // last step's x and z (for gate and line crossings)
    pz: fixed
    spd: fixed                  // on the snow: speed along the surface
    hd: fixed                   // heading
    vx: fixed                   // velocity (kept up to date on the snow too)
    vy: fixed
    vz: fixed
    air: bool
    air_t: s32                  // frames in the air
    carve: fixed                // smoothed carve, -1..1
    tuck: bool
    edge: bool
    down: s32                   // knockdown frames left
    spin: fixed                 // the model's spin while knocked down
    thump: fixed                // the last landing's velocity into the snow (m/s)
    land_t: s32                 // frames since the last landing
    lean: fixed                 // smoothed bank for the model
    pitch: fixed                // the model's pitch (nose down negative)
    braking: bool               // past the finish: slows to a stop
    hits: s32                   // hazard hits this run
    edge_t: s32                 // frames since the last scrape on the run's edge
}

var rd: Rider

// Events of the last step, for the game to sound and score.
var ev_land: bool
var ev_hit: bool
var ev_scrape: bool

fn rider_reset(x: fixed, z: fixed) {
    rd = Rider {}
    rd.x = x
    rd.z = z
    rd.px = x
    rd.pz = z
    rd.y = course_y(z)
    rd.land_t = 999
    rd.edge_t = 999
}

// The push off at GO.
fn rider_push() { rd.spd = PUSH_SPEED }

// Speed in m/s along the direction of travel.
fn rider_speed() -> fixed {
    if rd.air { return length(vec3(rd.vx, rd.vy, rd.vz)) }
    return rd.spd
}

// Height of the sled above the snow under it.
fn rider_height() -> fixed { return rd.y - course_y(rd.z) }

// One step. c: carve input -1..1 (positive turns toward +x), tuck: A, edge: B.
fn phys_step(c_in: fixed, tuck: bool, edge: bool) {
    ev_land = false
    ev_hit = false
    ev_scrape = false
    rd.px = rd.x
    rd.pz = rd.z
    rd.land_t += 1
    rd.edge_t += 1

    var c = c_in
    var tk = tuck
    var eg = edge
    if rd.down > 0 || rd.braking {
        c = 0.0
        tk = false
        eg = false
    }
    rd.tuck = tk
    rd.edge = eg
    // the carve follows the input at 6 a second (so the d-pad eases in)
    let dc = clamp(c - rd.carve, -0.1, 0.1)
    rd.carve += dc

    if rd.air { air_step() } else { ground_step() }

    // the run's edges: a hard push back
    if rd.x > EDGE_X || rd.x < -EDGE_X {
        let side: fixed = if_neg(rd.x)
        rd.x = EDGE_X * side
        if rd.air {
            if rd.vx * side > 0.0 { rd.vx = -rd.vx * 0.3 }
        } else if sin(rd.hd) * side > 0.0 {
            rd.hd = -rd.hd * 0.4
            rd.spd = rd.spd * 0.93
            if rd.edge_t > 20 { ev_scrape = true }
            rd.edge_t = 0
        }
    }

    hazards_step()

    if rd.down > 0 {
        rd.down -= 1
        rd.spin += 0.31
    } else {
        rd.spin = 0.0
    }
    // the model's lean and pitch
    let lean_to = -rd.carve * if_air(0.15, 0.4)
    rd.lean += (lean_to - rd.lean) / 6
    var p_to: fixed
    if rd.air {
        let h = sqrt(rd.vx * rd.vx + rd.vz * rd.vz)
        p_to = atan2(rd.vy, h)
    } else {
        p_to = atan2(course_grade(rd.z) * cos(rd.hd), 1.0)
    }
    rd.pitch += (p_to - rd.pitch) / 4
}

private fn if_neg(x: fixed) -> fixed {
    if x < 0.0 { return -1.0 }
    return 1.0
}

private fn if_air(a: fixed, b: fixed) -> fixed {
    if rd.air { return a }
    return b
}

private fn ground_step() {
    let g = course_grade(rd.z)
    let ch = cos(rd.hd)
    let gc = g * ch                                 // grade along the heading
    let inv = 1.0 / sqrt(1.0 + gc * gc)             // cos of the slope along the heading
    let n_cos = 1.0 / sqrt(1.0 + g * g)             // cos of the fall line's slope (normal force)
    var cd = CD
    var radius = R_CARVE
    var bleed = BLEED
    if rd.tuck {
        cd = CD_TUCK
        radius = R_TUCK
        bleed = BLEED_TUCK
    }
    if rd.edge {
        radius = R_EDGE
        bleed = BLEED_EDGE
    }
    let s = rd.spd
    var a = -GRAV * gc * inv - MU * GRAV * n_cos - cd * s * s - bleed * abs(rd.carve) * s
    if rd.down > 0 { a -= 5.0 }                     // sliding on its side
    if rd.braking { a -= FINISH_DECEL }
    rd.spd = max(s + a * DT, 0.0)

    // turning: on a radius, but no faster than TURN_MAX
    if rd.down > 0 {
        rd.hd -= rd.hd / 20                         // swings back to the fall line
    } else {
        // (at a crawl it still pivots, and slips round toward the fall line, so it never stalls
        // across the slope)
        let w = clamp(rd.carve * max(rd.spd, 5.0) / radius, -TURN_MAX, TURN_MAX)
        rd.hd = clamp(rd.hd + w * DT, -HD_MAX, HD_MAX)
        if rd.spd < 3.0 { rd.hd -= rd.hd / 40 }
    }
    let hs = rd.spd * inv                           // horizontal part of the speed
    rd.vx = hs * sin(rd.hd)
    rd.vz = hs * cos(rd.hd)
    rd.vy = g * rd.vz
    rd.x += rd.vx * DT
    rd.z += rd.vz * DT
    let ground = course_y(rd.z)
    let ballistic = rd.y + rd.vy * DT - 0.5 * GRAV * DT * DT
    if ground < ballistic - 0.002 {
        rd.air = true                               // the snow fell away: off the crest
        rd.air_t = 0
        rd.y = ballistic
    } else {
        rd.y = ground
    }
}

private fn air_step() {
    rd.air_t += 1
    rd.vy -= GRAV * DT
    var cd = CD
    if rd.tuck { cd = CD_TUCK }
    let v = length(vec3(rd.vx, rd.vy, rd.vz))
    let k = 1.0 - cd * v * DT
    rd.vx = rd.vx * k
    rd.vy = rd.vy * k
    rd.vz = rd.vz * k
    // a little air control: the fins turn the flight a touch
    if rd.down == 0 {
        let t = rd.carve * AIR_TURN * DT
        let c = cos(t)
        let s = sin(t)
        let nx = rd.vx * c + rd.vz * s
        rd.vz = rd.vz * c - rd.vx * s
        rd.vx = nx
    }
    rd.hd = atan2(rd.vx, rd.vz)
    rd.x += rd.vx * DT
    rd.y += rd.vy * DT
    rd.z += rd.vz * DT
    let ground = course_y(rd.z)
    if rd.y <= ground { land(ground) }
}

// Back on the snow: the velocity into it is lost (the thump), the rest goes on along it.
private fn land(ground: fixed) {
    let g = course_grade(rd.z)
    let n = vec3(0.0, 1.0, -g) / sqrt(1.0 + g * g)
    let v = vec3(rd.vx, rd.vy, rd.vz)
    let vn = dot(v, n)
    let vt = v - n * vn
    rd.thump = max(-vn, 0.0)
    rd.spd = length(vt)
    // a hard landing costs a little more than the velocity into the snow
    rd.spd = rd.spd * (1.0 - clamp((rd.thump - 4.0) * 0.015, 0.0, 0.2))
    rd.hd = clamp(atan2(vt.x, vt.z), -HD_MAX, HD_MAX)
    rd.y = ground
    rd.air = false
    rd.land_t = 0
    ev_land = true
}

// Hazards near the sled: a hit knocks it down, takes most of its speed and pushes it clear.
private fn hazards_step() {
    if rd.down > 0 { return }
    let h = rider_height()
    for i in 0..HAZARDS_N {
        let hz = HAZARDS[i]
        let dz = hz.z - rd.z
        if dz > 3.0 || dz < -3.0 { continue }
        if h > HZ_HEIGHT[hz.kind] { continue }      // over it, in the air
        let dx = rd.x - hz.x
        let r = HZ_RADIUS[hz.kind] + SLED_R
        if dx * dx + dz * dz < r * r {
            hit_hazard(hz.x, r)
            return
        }
    }
}

fn hit_hazard(hx: fixed, r: fixed) {
    rd.down = DOWN_FRAMES
    rd.hits += 1
    ev_hit = true
    if rd.x < hx { rd.x = hx - r } else { rd.x = hx + r }
    rd.x = clamp(rd.x, -EDGE_X, EDGE_X)
    if rd.air {
        rd.vx = 0.0
        rd.vz = rd.vz * DOWN_KEEP
        rd.vy = min(rd.vy, 0.0)
    } else {
        rd.spd = rd.spd * DOWN_KEEP
    }
}
