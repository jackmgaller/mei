// Test scenarios for Fall Line (run with tests/run.sh SCENARIO FRAMES OUT; tests/check.sh runs
// them). The scenario number comes from the file tools/cart_scenario.sh writes, which defines
// SCENARIO and imports this and the game; this file replaces the game's weak input hooks.
//
// 1: a bot presses Start on the title and steers through the gates to the finish (tucking on
//    the straights): the run ends, no frame is late, under 4,000 triangles, CPU and GPU within
//    their budgets. Prints the time, gates, hits and the peaks (and where they were).
// 2: the title, Start, the countdown 3-2-1 and the run's start: the states in order, the sled
//    still until GO and moving after it.
// 3: a hazard: the sled sent straight at the pine at (1, 120) is knocked down and loses speed.
// 4: a missed gate: the sled passes gate 1 far outside its posts: one miss, +2.0 s.
// 5: pause: Start in the run freezes the world (sled, clock, ghost) until Start again.
// 6: the memory card: boots with the card scenario 1 wrote (--card1), finds the best run and
//    shows its ghost beside the bot.
// 7: (a measurement, not in check.sh) a d-pad player: full left or right when off the line by
//    more than a little, never tucking. Prints its time, like scenario 1.

const CHECK_START = 10          // the frame the bot presses Start on the title

var frames: s32
var late: s32
var peak_tris: s32
var peak_cpu: s32
var peak_gpu: s32
var at_tris: s32
var at_cpu: s32
var at_gpu: s32
var done: bool
var snap_x: fixed
var snap_z: fixed
var snap_spd: fixed
var snap_run: s32
var snap_tick: s32
var spd0: fixed
var max_thump: fixed
var max_speed: fixed

fn input_pad() -> u32 {
    let f = frames
    match SCENARIO {
        1, 2, 6, 7 => { if f == CHECK_START { return START } }
        5 => { if f == 100 || f == 170 { return START } }
        else => {}
    }
    if SCENARIO == 1 && st == St.Run && bot_tuck() { return A }
    if SCENARIO == 7 && st == St.Run {
        let c = bot_carve()
        if c > 0.4 { return RIGHT }
        if c < -0.4 { return LEFT }
    }
    return 0
}

fn input_stick() -> vec2 {
    if SCENARIO == 1 || SCENARIO == 5 || SCENARIO == 6 { return vec2(bot_carve(), 0.0) }
    return vec2(0.0, 0.0)
}

// ---- the bot: aims at the next gate's centre, around any hazard on the way

var bot_err: fixed

fn bot_carve() -> fixed {
    if st != St.Run { return 0.0 }
    var tx = 0.0
    var tz = FINISH_Z + 20.0
    if gate_next < GATES_N {
        tx = GATES[gate_next].x
        tz = GATES[gate_next].z
    }
    // the nearest hazard close to the straight line to the target: aim beside it instead
    var best_z = tz
    for i in 0..HAZARDS_N {
        let h = HAZARDS[i]
        if h.kind == HZ_MARKER { continue }
        if h.z <= rd.z + 1.0 || h.z >= best_z || h.z > rd.z + 60.0 { continue }
        let lx = rd.x + (tx - rd.x) * ((h.z - rd.z) / (tz - rd.z))
        let r = HZ_RADIUS[h.kind] + SLED_R + 1.6
        if abs(lx - h.x) < r {
            var side = 1.0
            if lx < h.x { side = -1.0 }
            if abs(lx - h.x) < 0.3 {            // dead on: pass on the side of the target
                if tx < h.x { side = -1.0 } else { side = 1.0 }
            }
            best_z = h.z
            tx = h.x + side * (r + 0.6)
            tz = h.z
        }
    }
    let want = atan2(tx - rd.x, tz - rd.z)
    bot_err = want - rd.hd
    return clamp(bot_err * 5.0, -1.0, 1.0)
}

fn bot_tuck() -> bool { return abs(bot_err) < 0.04 }

// ---- the checks

private fn report(label: *u8, n: s32, at: s32) {
    print(label)
    print_int(n)
    print(" at frame ")
    print_int(at)
    println("")
}

private fn print_time(label: *u8, f: s32) {
    var b: [24]u8
    str_append_run_time(str_copy(&b[0], 24, ""), 24, f)
    print(label)
    println(&b[0])
}

fn test_init() {
    match SCENARIO {
        3 => {
            enter_countdown()
            start_run()
            rider_reset(1.0, 100.0)
            rd.spd = 20.0
            gate_next = 1                       // (gate 1 is behind the sled)
            cam_reset()
        }
        4 => {
            enter_countdown()
            start_run()
            rider_reset(12.0, 55.0)
            rd.spd = 20.0
            cam_reset()
        }
        5 => {
            enter_countdown()
            start_run()
        }
        6 => {
            assert(best_frames() != 0, "no best run on the card")
            print_time("best on the card ", best_frames())
            assert(ghost_at(600), "no ghost")
        }
        else => {}
    }
}

fn test_hook() {
    frames += 1
    if frames > 3 && !paused {
        if frame_ticks() > 1 { late += 1 }
        if tris_drawn() > peak_tris { peak_tris = tris_drawn(); at_tris = frames - 1 }
        if cpu_used() > peak_cpu { peak_cpu = cpu_used(); at_cpu = frames - 1 }
        if gpu_used() > peak_gpu { peak_gpu = gpu_used(); at_gpu = frames - 1 }
    }
    if st == St.Run {
        if ev_land && rd.thump > max_thump { max_thump = rd.thump }
        if rider_speed() > max_speed { max_speed = rider_speed() }
    }
    match SCENARIO {
        1, 7 => check_full_run()
        2 => check_start()
        3 => check_hazard()
        4 => check_miss()
        5 => check_pause()
        6 => check_card()
        else => {}
    }
}

private fn check_full_run() {
    if done || st != St.Results { return }
    done = true
    print_time("run time ", finish_f)
    print("gates clean ")
    print_int(gates_clean)
    print(" missed ")
    print_int(gates_missed)
    print(" hazard hits ")
    print_int(rd.hits)
    print(" longest air ")
    print_int(air_peak)
    println(" frames")
    print("top speed ")
    print_fixed(max_speed)
    print(" m/s, hardest landing ")
    print_fixed(max_thump)
    println(" m/s into the snow")
    print_time("split 1 ", split_f[0])
    print_time("split 2 ", split_f[1])
    print_time("split 3 ", split_f[2])
    report("peak triangles ", peak_tris, at_tris)
    report("peak cpu ", peak_cpu, at_cpu)
    report("peak gpu ", peak_gpu, at_gpu)
    print("late frames ")
    print_int(late)
    println("")
    assert_eq(late, 0, "a frame was late")
    assert(peak_tris < 4000, "over 4,000 triangles")
    assert(peak_cpu <= CPU_BUDGET, "over the CPU budget")
    assert(peak_gpu <= GPU_BUDGET, "over the GPU budget")
    assert(finish_f > 50 * 60 && finish_f < 100 * 60, "the run's time is out of range")
    if SCENARIO == 1 { assert(new_record, "the first run is not the best") }
    println("OK the full run")
}

private fn check_start() {
    let f = frames
    if f == CHECK_START - 1 { assert(st == St.Title, "not on the title") }
    if f == CHECK_START + 2 {
        assert(st == St.Countdown, "Start did not start the countdown")
        spd0 = rd.z
    }
    if f == CHECK_START + 3 * COUNT_STEP - 2 {
        assert(st == St.Countdown, "the countdown ended early")
        assert_eq(rd.z, spd0, "the sled moved before GO")
    }
    if f == CHECK_START + 3 * COUNT_STEP + 2 { assert(st == St.Run, "no run after the countdown") }
    if f == CHECK_START + 3 * COUNT_STEP + 120 {
        assert(st == St.Run, "the run stopped")
        assert(rd.z > START_Z + 10.0, "the sled is not moving")
        assert(run_f > 100, "the clock is not running")
        print("after 2 s: z ")
        print_fixed(rd.z)
        print(" speed ")
        print_fixed(rider_speed())
        println(" m/s")
        println("OK title, countdown, run")
    }
}

private fn check_hazard() {
    if frames == 2 { spd0 = rider_speed() }
    if frames == 80 {
        print("speed before ")
        print_fixed(spd0)
        print(" after ")
        print_fixed(rider_speed())
        print(" hits ")
        print_int(rd.hits)
        println("")
        assert_eq(rd.hits, 1, "the sled did not hit the pine")
        assert(rider_speed() < spd0 * 0.6, "the hit did not take speed")
        println("OK hazard knockdown")
    }
}

private fn check_miss() {
    if frames == 120 {
        assert(gate_next >= 1, "the sled did not reach gate 1")
        assert_eq(gates_missed, 1, "gate 1 was not missed")
        assert_eq(pen_f, PENALTY, "no penalty")
        assert_eq(run_time(), run_f + 120, "the penalty is not in the time")
        println("OK missed gate +2.0 s")
    }
}

private fn check_pause() {
    if frames == 102 {
        assert(paused, "Start did not pause")
        snap_x = rd.x
        snap_z = rd.z
        snap_spd = rd.spd
        snap_run = run_f
        snap_tick = tick
    }
    if frames == 169 {
        assert(paused, "the pause ended by itself")
        assert_eq(rd.x, snap_x, "x moved while paused")
        assert_eq(rd.z, snap_z, "z moved while paused")
        assert_eq(rd.spd, snap_spd, "the speed changed while paused")
        assert_eq(run_f, snap_run, "the clock ran while paused")
        assert_eq(tick, snap_tick, "the animation ran while paused")
    }
    if frames == 174 {
        assert(!paused, "Start did not resume")
        assert(run_f > snap_run && rd.z > snap_z, "the run did not go on")
        println("OK pause freezes the world")
    }
}

private fn check_card() {
    if frames == CHECK_START + 3 * COUNT_STEP + 900 {
        assert(ghost_at(ghost_f), "the ghost is not running")
        print("ghost at z ")
        print_fixed(gh_pos.z)
        print(", sled at z ")
        print_fixed(rd.z)
        println("")
        println("OK the card's best run and ghost")
    }
}
