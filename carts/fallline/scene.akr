// Drawing the course's objects: gates, hazards and the finish arch, each stood on the snow at
// its (x, z) (models stand vertical, facing -Z; the gates and the arch face the sled, so they are
// turned half a turn). Each is culled by distance, then asked of the slope engine whether it
// shows and on which layer. The distances shrink when the last frame drew many triangles.

const FAR_GATE = 260.0
const FAR_HAZARD = 210.0
const FAR_MARKER = 130.0
const FAR_FINISH = 420.0
const TRI_SOFT = 3300           // over this, draw a little less far next frame

var obj_y_gate: [20]fixed       // the snow's height at each gate and hazard (made at boot)
var obj_y_haz: [64]fixed
var far_scale: fixed = 1.0      // 0.6..1.0 of the distances above

fn scene_init() {
    for i in 0..GATES_N { obj_y_gate[i] = course_y(GATES[i].z) }
    for i in 0..HAZARDS_N { obj_y_haz[i] = course_y(HAZARDS[i].z) }
}

private fn draw_obj(m: *Mesh, p: vec3, yaw: fixed, r: fixed) {
    let layer = slope_layer(p, r)
    if layer == 0 { return }
    slope_draw_layer(layer)
    mesh_at(m, p, yaw)
}

// Everything from cam_z - 2 to the cull distances ahead.
fn scene_draw(cam_z: fixed) {
    if tris_drawn() > TRI_SOFT { far_scale = max(far_scale - 0.05, 0.6) }
    else if far_scale < 1.0 { far_scale = min(far_scale + 0.01, 1.0) }
    let near = cam_z - 2.0
    let fg = cam_z + FAR_GATE * far_scale
    let fh = cam_z + FAR_HAZARD * far_scale
    let fm = cam_z + FAR_MARKER * far_scale
    for i in 0..HAZARDS_N {
        let h = HAZARDS[i]
        if h.z < near { continue }
        if h.kind == HZ_MARKER {
            if h.z > fm { continue }
            draw_obj(ASSET_MARKER, vec3(h.x, obj_y_haz[i], h.z), PI, 1.0)
        } else if h.kind == HZ_PINE {
            if h.z > fh { continue }
            draw_obj(ASSET_PINE, vec3(h.x, obj_y_haz[i], h.z), fixed(i) * 1.3, 3.5)
        } else {
            if h.z > fh { continue }
            draw_obj(ASSET_PYLON, vec3(h.x, obj_y_haz[i], h.z), PI, 2.5)
        }
    }
    for i in 0..GATES_N {
        let g = GATES[i]
        if g.z < near || g.z > fg { continue }
        draw_obj(ASSET_GATE, vec3(g.x, obj_y_gate[i], g.z), PI, 4.0)
    }
    if FINISH_Z >= near && FINISH_Z < cam_z + FAR_FINISH {
        draw_obj(ASSET_FINISH, vec3(0.0, course_y(FINISH_Z), FINISH_Z), PI, 12.0)
    }
}
