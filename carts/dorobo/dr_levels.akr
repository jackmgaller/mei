// The levels' worlds (B's, worlds.txt): which World Kit world each level of the game is. A level
// is one world holding its rooms (dr_world.akr reads it), played as one run. Level 1 is `level1`
// (levels/level1/ROUTE.md); Gate 1's hard platform, `platform`, is the next level, started by A
// at level 1's end line (B's proposal, NOTES_B.md). After the last level, A starts the first again.
import "level1.akr"
import "platform.akr"

const LEVELS = 2
var level: s32                 // the level being played (0: level 1)

// Opens the level's world (the reader keeps one pack open).
fn level_open() -> bool {
    if level == 1 { return world_platform_load() }
    return world_level1_load()
}
