// The watchers: patrol guards on their routes, posted guards and cameras turning on the clock,
// and hearing (DESIGN.md, "Caught means restart": walk to the noise, look around, walk back).

const GUARD_R: fixed = 0.3         // a guard's footprint
const TURN_RATE: fixed = 0.0698    // radians a tick: 240 degrees a second (each watcher's default)
const NOISE_PACE: fixed = 1.5      // a guard goes to a noise this much faster than he patrols (default)
const LOOK_TICKS = 150             // looking around at a noise
const LOOK_SWING: fixed = 1.2217   // 70 degrees each way
const STUCK_TICKS = 40
const NEAR_NOISE: fixed = 0.8      // he stops this near the noise (or the toy he follows)

enum GMode: u8 { Route, Wait, Hold, Posted, GoNoise, Look, Back, Resume }

struct Guard {
    x: fixed
    z: fixed
    head: fixed
    mode: GMode
    target: s32        // the waypoint he walks to (Route), or -1
    timer: s32
    away: bool         // off his route for a noise (bx.. hold where he left)
    bx: fixed
    bz: fixed
    bmode: GMode
    btarget: s32
    btimer: s32
    nx: fixed          // the noise he goes to
    nz: fixed
    toy: s32           // the toy he follows, -1 none
    look_base: fixed
    stuck: s32
    best: fixed        // the nearest he has come to where he is going, since `stuck` was reset
    caught: bool       // his fan (or his body) caught the thief this tick
    fan: Fan
}

var guards: [MAX_WATCH]Guard

// Noise this tick.
const MAX_NOISE = 16
struct Noise {
    x: fixed
    z: fixed
    r: fixed           // how far it carries (0: as far as each guard hears running)
    toy: s32           // the toy making it, -1 none
}
var noises: [MAX_NOISE]Noise
var nnoise: s32

fn noise(x: fixed, z: fixed, r: fixed, toy: s32) {
    if nnoise >= MAX_NOISE { return }
    noises[nnoise] = Noise { x: x, z: z, r: r, toy: toy }
    nnoise += 1
}

fn guards_reset() {
    for i in 0..room.nwatch {
        let d = &room.watch[i]
        let g = &guards[i]
        *g = Guard { x: d.x, z: d.z, head: d.head, target: d.route, toy: -1 }
        match d.kind {
            Patrol => {
                if d.route >= 0 { g.mode = GMode.Route } else { g.mode = GMode.Hold }
            }
            Posted, Camera => {
                g.mode = GMode.Posted
                g.head = posted_head(d, 0)
            }
        }
    }
}

// A posted guard's or camera's heading at clock t: look_a for hold, turn to look_b, hold,
// turn back.
fn posted_head(d: *WatchDef, t: s32) -> fixed {
    let cycle = 2 * (d.hold + d.turn)
    if cycle <= 0 { return d.look_a }
    var p = (t + d.phase) % cycle
    if p < 0 { p += cycle }
    if p < d.hold { return d.look_a }
    p -= d.hold
    if p < d.turn { return d.look_a + (d.look_b - d.look_a) * p / d.turn }
    p -= d.turn
    if p < d.hold { return d.look_b }
    p -= d.hold
    return d.look_b + (d.look_a - d.look_b) * p / d.turn
}

// Moves the guard toward (tx, tz) at `step` a tick, turning his head the way he walks, and
// keeps him out of the walls and the tracks. True when he is there (within `stop`).
fn guard_walk(g: *Guard, tx: fixed, tz: fixed, step: fixed, stop: fixed, rate: fixed) -> bool {
    let dx = tx - g.x
    let dz = tz - g.z
    let d2 = dx * dx + dz * dz
    if d2 <= stop * stop + step * step / 4 {
        if stop == 0.0 {
            g.x = tx
            g.z = tz
        }
        return true
    }
    let d = sqrt(d2)
    let k = min(step, d - stop) / d
    var x = g.x + dx * k
    var z = g.z + dz * k
    g.head = turn_toward(g.head, heading_to(dx, dz), rate)
    for _pass in 0..2 {
        for i in 0..room.nwalls {
            let b = &room.walls[i]
            if b.solid {
                let p = box_push(b, x, z, GUARD_R)
                x = p.x
                z = p.y
            }
        }
        for i in 0..room.nbands {
            let p = box_push(&room.bands[i], x, z, GUARD_R)
            x = p.x
            z = p.y
        }
    }
    g.x = x
    g.z = z
    return false
}

// Progress toward where he is going: stuck for STUCK_TICKS without coming 5 cm nearer.
fn guard_progress(g: *Guard, tx: fixed, tz: fixed) -> bool {
    let d = dist2(g.x, g.z, tx, tz)
    if d < g.best - 0.01 {
        g.best = d
        g.stuck = 0
        return true
    }
    g.stuck += 1
    return g.stuck < STUCK_TICKS
}

fn guard_hear(d: *WatchDef, g: *Guard) {
    if d.kind == WKind.Camera { return }
    for i in 0..nnoise {
        let n = &noises[i]
        var r = n.r
        if r == 0.0 { r = d.hear }
        if dist2(g.x, g.z, n.x, n.z) > r * r { continue }
        if n.toy >= 0 && g.toy == n.toy && g.mode == GMode.GoNoise { continue }
        if !g.away {
            g.away = true
            g.bx = g.x
            g.bz = g.z
            g.bmode = g.mode
            g.btarget = g.target
            g.btimer = g.timer
        }
        g.mode = GMode.GoNoise
        g.nx = n.x
        g.nz = n.z
        g.toy = n.toy
        g.stuck = 0
        g.best = 30000.0
    }
}

fn guard_update(i: s32, t: s32) {
    let d = &room.watch[i]
    let g = &guards[i]
    guard_hear(d, g)
    let pace = d.speed * d.pace
    match g.mode {
        Route => {
            let w = &room.wps[g.target]
            if guard_walk(g, w.x, w.z, d.speed, 0.0, d.turn_rate) {
                if w.wait > 0 {
                    g.mode = GMode.Wait
                    g.timer = w.wait
                } else if w.next >= 0 {
                    g.target = w.next
                } else {
                    g.mode = GMode.Hold
                }
            }
        }
        Wait => {
            let w = &room.wps[g.target]
            g.head = turn_toward(g.head, w.look, d.turn_rate)
            g.timer -= 1
            if g.timer <= 0 {
                if w.next >= 0 {
                    g.target = w.next
                    g.mode = GMode.Route
                } else {
                    g.mode = GMode.Hold
                }
            }
        }
        Hold => {
            if g.target >= 0 { g.head = turn_toward(g.head, room.wps[g.target].look, d.turn_rate) }
        }
        Posted => { g.head = posted_head(d, t) }
        Resume => {
            let want = posted_head(d, t)
            g.head = turn_toward(g.head, want, d.turn_rate)
            if abs(wrap_angle(want - g.head)) < d.turn_rate * 2 { g.mode = GMode.Posted }
        }
        GoNoise => {
            if g.toy >= 0 && toys[g.toy].ticks > 0 {
                g.nx = toys[g.toy].x
                g.nz = toys[g.toy].z
            }
            let there = guard_walk(g, g.nx, g.nz, pace, NEAR_NOISE, d.turn_rate)
            if there {
                g.head = turn_toward(g.head, heading_to(g.nx - g.x, g.nz - g.z), d.turn_rate)
            }
            let following = g.toy >= 0 && toys[g.toy].ticks > 0
            if (there && !following) || (!there && !guard_progress(g, g.nx, g.nz)) {
                g.mode = GMode.Look
                g.timer = LOOK_TICKS
                g.look_base = g.head
                g.toy = -1
            }
        }
        Look => {
            g.timer -= 1
            let u = LOOK_TICKS - g.timer
            g.head = wrap_angle(g.look_base + LOOK_SWING * sin(TAU * u / (LOOK_TICKS / 2)))
            if g.timer <= 0 {
                g.mode = GMode.Back
                g.stuck = 0
                g.best = 30000.0
            }
        }
        Back => {
            if guard_walk(g, g.bx, g.bz, d.speed, 0.0, d.turn_rate) || !guard_progress(g, g.bx, g.bz) {
                g.away = false
                g.mode = g.bmode
                g.target = g.btarget
                g.timer = g.btimer
                if g.mode == GMode.Posted { g.mode = GMode.Resume }
            }
        }
    }
}

// The fans, after everyone has moved.
fn guards_sight() {
    for i in 0..room.nwatch {
        let d = &room.watch[i]
        let g = &guards[i]
        fan_cast(&g.fan, g.x, g.z, g.head, d.half, d.sight)
    }
}
