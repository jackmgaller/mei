// World Viewer: the camera, walking, the overlay and the frame loop.
// The worlds' generated files (test_room.akr, two_districts.akr and their games' GAME.game.akr)
// are not in this folder: make builds them from carts/worldview/worlds.txt into the build
// directory and passes it to meic with -I.
import "test_room.akr"
import "two_districts.akr"

struct World {
    name: *u8
    eye: vec3          // where the camera starts, flying
    yaw: fixed
    // The game schema's probe (GAME.game.akr), the body the kit classified collision for:
    radius: fixed      // walls push the walking camera this far
    height: fixed      // the walking eye is this far above the floor (the top of the body)
    step: fixed        // the highest floor a walking step climbs onto
}

const WORLD_COUNT = 2
const WORLDS: [2]World = [
    World { name: "test_room", eye: vec3(32.0, 3.0, 10.0), yaw: 0.0, radius: GARDEN_PROBE_RADIUS,
            height: GARDEN_PROBE_HEIGHT, step: GARDEN_PROBE_STEP },
    World { name: "two_districts", eye: vec3(2.0, 3.0, 6.0), yaw: 1.5708,     // looking +X
            radius: CITY_PROBE_RADIUS, height: CITY_PROBE_HEIGHT, step: CITY_PROBE_STEP },
]

fn world_load(k: s32) -> bool {
    if k == 0 { return world_test_room_load() }
    return world_two_districts_load()
}

fn eye_height() -> fixed { return WORLDS[world].height }

const FLY_SPEED: fixed = 0.25
const WALK_SPEED: fixed = 0.08
const TURN: fixed = 0.04
const PITCH_MAX: fixed = 1.4

var world: s32
var eye: vec3              // the camera (world coordinates)
var yaw: fixed
var pitch: fixed
var walking: bool
var variant: s32           // the palette variant every region shows (its last, if it has fewer)
var layer: s32             // the layer SELECT chooses and X switches
var overlay = true
var message: *u8           // a short note in the overlay ("no floor below")
var message_t: s32
var tick: s32
var entities: s32          // entity meshes drawn in the last frame

var pad_now: u32
var pad_prev: u32
fn held(b: u32) -> bool { return pad_now & b != 0 }
fn pressed(b: u32) -> bool { return pad_now & ~pad_prev & b != 0 }

fn init() {
    open_world(0)
}

fn open_world(k: s32) {
    world = k
    assert(world_load(k))
    eye = WORLDS[k].eye
    yaw = WORLDS[k].yaw
    pitch = -0.15
    walking = false
    variant = 0
    layer = 0
}

// ---- palette variants

fn region_variants(k: s32) -> s32 { return wp_region(k).variant_count as s32 }

fn variants_max() -> s32 {
    var n = 1
    for k in 0..wp_region_count() { n = max(n, region_variants(k)) }
    return n
}

fn show_variant(v: s32) {
    variant = v
    for k in 0..wp_region_count() {
        let n = region_variants(k)
        if n > 0 && wp_region(k).colour_count > 0 { wp_palette_load(k, min(v, n - 1)) }
    }
}

// ---- moving

// Walking: the feet move by d, walls push them out at knee and chest height (the probe's
// radius), and they stand on the highest floor no more than the probe's step above them, or
// drop to the next floor below. A camera kept on the floor, not a character: no gravity,
// jumping or limit on slopes.
fn walk(d: vec3) {
    let r = WORLDS[world].radius
    var p = eye - vec3(0.0, eye_height(), 0.0) + d
    for h in 0..2 {
        let q = wp_push(p + vec3(0.0, 0.5 + 0.7 * h, 0.0), r)
        p = vec3(q.x, p.y, q.z)
    }
    if wp_floor(p, WORLDS[world].step) { p.y = wp_hit.y }
    eye = p + vec3(0.0, eye_height(), 0.0)
}

fn toggle_walk() {
    if walking {
        walking = false
        return
    }
    if !wp_floor(eye, 0.0) {
        note("no floor below")
        return
    }
    walking = true
    eye.y = wp_hit.y + eye_height()
    walk(vec3(0.0, 0.0, 0.0))
}

fn note(s: *u8) {
    message = s
    message_t = 90
}

fn update() {
    pad_prev = pad_now
    pad_now = input_pad(tick)
    let s = input_stick(tick)
    var look = input_look(tick)
    if held(LEFT) { look.x = -1.0 }
    if held(RIGHT) { look.x = 1.0 }
    if held(UP) { look.y = 1.0 }
    if held(DOWN) { look.y = -1.0 }
    yaw = wrap_angle(yaw + look.x * TURN)
    pitch = clamp(pitch + look.y * TURN, -PITCH_MAX, PITCH_MAX)

    let fwd = vec3(sin(yaw), 0.0, cos(yaw))
    let right = vec3(cos(yaw), 0.0, -sin(yaw))
    if walking {
        walk((fwd * s.y + right * s.x) * WALK_SPEED)
    } else {
        eye = eye + (fwd * s.y + right * s.x) * FLY_SPEED
        if held(L) { eye.y -= FLY_SPEED }
        if held(R) { eye.y += FLY_SPEED }
    }

    if pressed(A) { toggle_walk() }
    if pressed(B) { show_variant((variant + 1) % variants_max()) }
    if pressed(SELECT) && wp_layer_count() > 0 { layer = (layer + 1) % wp_layer_count() }
    if pressed(X) && wp_layer_count() > 0 { wp_layer_set(layer, !wp_layer_on(layer)) }
    if pressed(START) { open_world((world + 1) % WORLD_COUNT) }
    if pressed(Y) { overlay = !overlay }
    if message_t > 0 { message_t -= 1 }
    test_hook(tick)
    tick += 1
}

// ---- drawing

fn draw() {
    if variant == 0 { cls(rgb(110, 150, 200)) } else { cls(rgb(20, 24, 48)) }
    wp_draw(eye, yaw, pitch)
    entities = wp_draw_entities()      // the entities' meshes (a coin): wp_draw() leaves them
    if overlay {
        // the world's paths (rails, wires, routes), as lines over the picture
        for k in 0..wp_path_count() { wp_path_draw(wp_path(k), rgb(255, 220, 60)) }
        draw_overlay()
    }
}

fn ink() -> u32 { return rgb(255, 255, 255) }
fn dim() -> u32 { return rgb(150, 180, 200) }

// A fixed value with two decimals.
fn text_fixed(x: s32, y: s32, f: fixed, colour: u32) -> s32 {
    var v = (f * 100.0) as s32
    var nx = x
    if v < 0 {
        text(nx, y, "-", colour)
        nx += 8
        v = -v
    }
    nx = text_int(nx, y, v / 100, colour)
    text(nx, y, ".", colour)
    if v % 100 < 10 {
        text(nx + 8, y, "0", colour)
        return text_int(nx + 16, y, v % 100, colour)
    }
    return text_int(nx + 8, y, v % 100, colour)
}

fn draw_overlay() {
    rect(0, 0, 320, 44, rgb(24, 32, 40))
    var x = 0
    text(4, 2, WORLDS[world].name, ink())
    if walking { text(140, 2, "WALK", ink()) } else { text(140, 2, "FLY", ink()) }
    text(184, 2, wp_variant_name(0, min(variant, region_variants(0) - 1)), ink())
    let c = wp_cell_at(eye)
    text(4, 12, "cell", dim())
    if c == null {
        text(44, 12, "none", ink())
    } else {
        x = text_int(44, 12, c.i as s32, ink())
        text(x, 12, ",", ink())
        text_int(x + 8, 12, c.j as s32, ink())
    }
    text(108, 12, "tris", dim())
    text_int(148, 12, tris_drawn(), ink())
    text(196, 12, "drawn", dim())
    x = text_int(244, 12, wp_stats.drawn, ink())
    text(x, 12, "+", dim())
    text_int(x + 8, 12, wp_stats.standins, ink())
    text(4, 22, "cpu", dim())
    text_int(36, 22, cpu_used(), ink())
    text(108, 22, "gpu", dim())
    text_int(140, 22, gpu_used(), ink())
    text(4, 32, "floor", dim())
    if wp_floor(eye, 0.0) {
        text_fixed(52, 32, wp_hit.y, ink())
        text(108, 32, "surface", dim())
        text_int(172, 32, wp_hit.surface, ink())
    } else {
        text(52, 32, "none", ink())
    }
    if wp_layer_count() > 0 {
        text(196, 32, wp_layer_name(layer), ink())
        if wp_layer_on(layer) { text(296, 32, "on", ink()) } else { text(296, 32, "off", dim()) }
    }
    if message_t > 0 { text(4, 48, message, rgb(255, 208, 112)) }
    rect(0, 228, 320, 12, rgb(24, 32, 40))
    text(4, 230, "A walk  B palette  X layer  START world", dim())
}
