// What Tsumiki's parts cost, measured with cycle_count() (the numbers in docs/TSUMIKI.md):
//     build/meic carts/playroom/tests/bench.akr -o /tmp/bench.mei
//     build/mei-headless /tmp/bench.mei --frames 400
// Each line is cycles per call (or per item), averaged over many.
cart "Tsumiki bench"
import "tsumiki.akr"
import "../toys.akr"

var hero: *TkBody
var frame_n: s32
var anims: [8]*TkAnim
var m: *TkMorph
var w: *TkMorph
var cube: *Mesh

fn report(name: *u8, cycles: s32, n: s32) {
    print(name)
    print(": ")
    print_int(cycles / n)
    println("")
}

fn init() {
    tk_open(TK_SKY)
    tk_load_atlas(&TOYS_ATLAS)
    // building: 40 blocks in a level piece
    var c = cycle_count()
    tk_ground_begin()
    tk_paint(TK_WHITE, FLOORBOARDS)
    tk_grid(vec3(-12.0, 0.0, -12.0), vec3(12.0, 0.0, 12.0), 8, 8)
    tk_ground_end()
    report("build: tk_grid 8x8 in the ground (each tile)", cycle_count() - c, 64)
    c = cycle_count()
    tk_level_begin()
    for i in 0..40 {
        let x = fixed(i % 8) * 2.5 - 9.0
        let z = fixed(i / 8) * 3.0 - 2.0
        tk_paint(TK_TOY_COLOURS[i % 6], TK_WOOD)
        tk_box(vec3(x, 0.0, z), vec3(x + 1.0, 1.0 + fixed(i % 3) * 0.5, z + 1.0))
    }
    tk_level_end()
    report("build: tk_box in a level, with its solid (each, and the piece cut into chunks)", cycle_count() - c, 40)
    c = cycle_count()
    tk_shape_begin()
    tk_smooth(true)
    for i in 0..10 { tk_sphere(vec3(fixed(i), 0.0, 0.0), 0.3, 4) }
    cube = tk_shape_end()
    report("build: tk_sphere with 4 rings (each)", cycle_count() - c, 10)

    hero = tk_new_body(vec3(0.0, 0.0, -6.0))
    tk_cam_follow(hero, 0)
    for i in 0..8 {
        anims[i] = tk_new_anim(&ZENMAI)
        tk_play(anims[i], &ZENMAI_RUN, 0)
    }
    // shape queries against the 41 solids
    var hit: TkHit
    c = cycle_count()
    for i in 0..100 { let _ = tk_raycast(vec3(-10.0, 0.5, fixed(i) * 0.1 - 2.0), vec3(10.0, 2.0, 3.0), &hit) }
    report("tk_raycast across the level (41 solids, many in its path)", cycle_count() - c, 100)
    c = cycle_count()
    for i in 0..100 { let _ = tk_raycast(vec3(0.0, 0.5, -6.0), vec3(1.0, 2.5, -9.0), &hit) }
    report("tk_raycast, a short one (camera pull-in)", cycle_count() - c, 100)
    c = cycle_count()
    for i in 0..100 { let _ = tk_floor_at(fixed(i) * 0.1 - 5.0, 1.0, 5.0) }
    report("tk_floor_at (41 solids)", cycle_count() - c, 100)
    c = cycle_count()
    for i in 0..100 { let _ = tk_overlap_sphere(vec3(fixed(i) * 0.1 - 5.0, 0.5, 1.0), 0.4) }
    report("tk_overlap_sphere (41 solids)", cycle_count() - c, 100)
    c = cycle_count()
    for i in 0..100 { let _ = tk_capsule_box(vec3(0.0, 0.0, 0.0), vec3(0.0, 1.0, 0.0), 0.3, vec3(0.2, 0.0, 0.0), vec3(1.0, 1.0, 1.0)) }
    report("tk_capsule_box", cycle_count() - c, 100)
    c = cycle_count()
    for i in 0..100 { let _ = tk_capsule_capsule(vec3(0.0, 0.0, 0.0), vec3(0.0, 1.0, 0.0), 0.3, vec3(0.5, 0.0, 0.2), vec3(0.5, 1.0, 0.0), 0.3) }
    report("tk_capsule_capsule", cycle_count() - c, 100)
    // morphs
    m = tk_new_morph(&ZENMAI_HEAD_MORPH)
    w = tk_new_morph_mesh(cube)
    c = cycle_count()
    for i in 0..20 { tk_morph_blend(m, 0, 1, fixed(i) / 20) }
    report("tk_morph_blend (per vertex)", cycle_count() - c, 20 * m.nverts)
    c = cycle_count()
    for i in 0..5 { tk_morph_wave(w, vec3(0.0, 0.1, 0.0), vec3(3.0, 0.0, 2.0), fixed(i), vec3(0.0, 0.0, 0.0)) }
    report("tk_morph_wave (per vertex)", cycle_count() - c, 5 * w.nverts)
}

fn update() {
    frame_n += 1
    if frame_n == 5 {
        // bodies: one running into the blocks
        var c = cycle_count()
        for i in 0..60 {
            tk_drive(hero, vec3(0.3, 0.0, 1.0), i % 30 == 0)
            __tk_body_step(hero)
        }
        report("body step (running among blocks, jumping)", cycle_count() - c, 60)
        c = cycle_count()
        for i in 0..60 { __tk_anim_step(anims[0]) }
        report("animation step, 7 parts", cycle_count() - c, 60)
        tk_play(anims[1], &ZENMAI_IDLE, 1000)
        c = cycle_count()
        for i in 0..60 { __tk_anim_step(anims[1]) }
        report("animation step, 7 parts, cross-fading", cycle_count() - c, 60)
        c = cycle_count()
        for i in 0..60 { __tk_cam_step() }
        report("camera step (follow, with pull-in rays)", cycle_count() - c, 60)
    }
    if frame_n == 10 {
        for i in 0..256 { tk_burst(TK_SPARKLE, vec3(fixed(i % 16) * 0.4 - 3.0, 1.0, fixed(i / 16) * 0.3 - 3.0), 1) }
    }
    if frame_n >= 11 && frame_n < 14 { for i in 0..64 { tk_burst(TK_SPARKLE, vec3(0.0, 1.0, 0.0), 1) } }
    var c = cycle_count()
    tk_update()
    if frame_n == 20 {
        report("tk_update with 1 body, 8 animations, 256 particles", cycle_count() - c, 1)
        c = cycle_count()
        __tk_particles_step()
        report("particle step (per live particle)", cycle_count() - c, tk_particles_alive())
    }
}

fn draw() {
    var c = cycle_count()
    tk_draw()
    let d = cycle_count() - c
    if frame_n == 20 {
        report("tk_draw: ground, 40 blocks, 1 body, 256 particles (160 drawn)", d, 1)
        c = cycle_count()
        tk_particle_cap(256)
        __tk_particles_draw()
        report("particle draw (per drawn particle)", cycle_count() - c, max(tk_particles_drawn(), 1))
        c = cycle_count()
        for i in 0..8 { tk_anim_draw(anims[i], tk_place(vec3(fixed(i) * 0.6 - 2.0, 0.0, -3.0), PI)) }
        report("tk_anim_draw Zenmai (7 parts, 191 faces, on screen)", cycle_count() - c, 8)
        c = cycle_count()
        for i in 0..20 { tk_shadow(vec3(fixed(i) * 0.2 - 2.0, 0.0, -2.0), 0.3) }
        report("tk_shadow (a floor lookup and a quad)", cycle_count() - c, 20)
        c = cycle_count()
        for i in 0..20 { let _ = tk_visible(vec3(fixed(i), 1.0, 2.0), 1.0) }
        report("tk_visible", cycle_count() - c, 20)
        c = cycle_count()
        for i in 0..20 { tk_sprite(TK_STAR, i * 10, 10, 16, 16, TK_YELLOW, BLEND_NONE) }
        report("tk_sprite", cycle_count() - c, 20)
        c = cycle_count()
        tk_logo(20, 200, 24, 0)
        report("tk_logo", cycle_count() - c, 1)
    }
}
