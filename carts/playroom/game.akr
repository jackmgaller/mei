// The Playroom: Zenmai the wind-up toy tidies five stars away. A tour of Tsumiki.
//
// Stars sit on the block tower, the book stairs, the high shelf (ride the lift), the table
// (climb the chair) and in the toy chest, which opens when Zenmai stands on the red button.
// Y changes the camera; X shows the cost counters. Everything reads the pad through
// tk_input_pad(), so a test can play it.
import "tsumiki.akr"
import "toys.akr"
import "room.akr"

enum Mode { Title, Play, Tidy }

const NSTARS = 5
const STAR_SPOTS: [5]vec3 = [
    vec3(-10.6, 3.15, -2.0),         // on the tall blue block
    vec3(10.9, 2.45, -3.3),          // the top of the book stairs
    vec3(10.2, 4.3, 8.4),            // the high shelf (the lift goes up to it)
    vec3(8.0, 3.25, -5.8),           // on the table, by the cake
    vec3(0.0, 1.5, 6.4),             // out of the toy chest, once it is open
]
const CAM_NAMES: [5]*u8 = ["FOLLOW", "ORBIT", "EYES", "CORNER CAM", "RAIL CAM"]
const START_POS: vec3 = vec3(0.0, 0.0, -6.0)
const CANDLE = 6                 // a particle style of our own (6-15 are free)

var mode: Mode
var mode_t: s32
var hero: *TkBody
var face: *TkMorph
var chest: *TkAnim
var stars: [5]*TkProp
var got: s32                     // stars tidied away
var lift: *TkPlatform
var button: *TkProp
var button_zone: *TkZone
var pool_zone: *TkZone
var engine: *TkProp
var carriage: *TkProp
var smoke: *TkEmitter
var lid_open: bool
var lid_t: s32                   // frames since the lid opened
var cam_mode: s32
var key_turn: fixed              // Zenmai's wind-up key
var msg: *u8
var msg_t: s32
var show_costs: bool
var pad: u32
var pad_was: u32

fn pressed(b: u32) -> bool { return (pad & ~pad_was & b) != 0 }

fn init() {
    tk_open(rgb(250, 236, 222))

    build_room()
    // the toys
    tk_cam.dist = 3.7                               // a little closer than the default
    hero = tk_new_body(START_POS)
    hero.anim = tk_new_anim(&ZENMAI)
    tk_body_clips(hero, &ZENMAI_IDLE, &ZENMAI_RUN, &ZENMAI_JUMP)
    face = tk_new_morph(&ZENMAI_HEAD_MORPH)
    tk_anim_part_mesh(hero.anim, ZENMAI_HEAD, face.mesh)
    chest = tk_new_anim(&CHEST)
    let lid = tk_new_prop(null, CHEST_POS)
    lid.anim = chest
    lid.yaw = PI                                    // its front (TOYS) faces the room
    // the chest's sides and floor are solid; the inside is a hollow to jump into
    let c = CHEST_POS
    let _ = tk_add_box(c + vec3(-1.6, 0.0, -1.0), c + vec3(1.6, 0.18, 1.0))
    let _ = tk_add_box(c + vec3(-1.6, 0.0, -1.0), c + vec3(1.6, 1.2, -0.86))
    let _ = tk_add_box(c + vec3(-1.6, 0.0, 0.86), c + vec3(1.6, 1.2, 1.0))
    let _ = tk_add_box(c + vec3(-1.6, 0.0, -0.86), c + vec3(-1.46, 1.2, 0.86))
    let _ = tk_add_box(c + vec3(1.46, 0.0, -0.86), c + vec3(1.6, 1.2, 0.86))
    button = tk_new_prop(BUTTON, BUTTON_POS)
    button_zone = tk_new_zone(BUTTON_POS - vec3(0.6, 0.0, 0.6), BUTTON_POS + vec3(0.6, 0.5, 0.6))
    pool_zone = tk_new_zone(POOL_LO + vec3(0.25, 0.0, 0.25), POOL_HI - vec3(0.25, 0.0, 0.25))
    for i in 0..NSTARS {
        stars[i] = tk_new_prop(STAR, STAR_SPOTS[i])
        stars[i].spin = 0.045
        stars[i].bob = 0.12
        stars[i].shadow = 0.3
        stars[i].scale = 0.9
    }
    stars[4].shown = false                          // in the chest until it opens
    lift = tk_new_platform(lift_mesh, LIFT_LOW + vec3(0.0, 0.3, 0.0), vec3(-0.8, -0.3, -0.8), vec3(0.8, 0.0, 0.8))
    tk_platform_path(lift, LIFT_LOW + vec3(0.0, 0.3, 0.0), LIFT_HIGH + vec3(0.0, 0.3, 0.0), 150)
    lift.pause = 70
    engine = tk_new_prop(TRAIN, TRAIN_CENTRE)
    engine.shadow = 0.7
    carriage = tk_new_prop(CARRIAGE, TRAIN_CENTRE)
    carriage.shadow = 0.6
    smoke = tk_new_emitter(TK_SMOKE, TRAIN_CENTRE)
    smoke.rate = 0.2
    // candle flames: the fire preset, made smaller (a style of our own)
    *tk_style(CANDLE) = *tk_style(TK_FIRE)
    tk_style(CANDLE).size0 = 0.15
    tk_style(CANDLE).lift = 0.012
    tk_style(CANDLE).life = 16
    for i in 0..3 {
        let e = tk_new_emitter(CANDLE, CANDLES[i] + vec3(0.0, 0.06, 0.0))
        e.rate = 0.4
    }
    enter(Mode.Title)
}

fn enter(m: Mode) {
    mode = m
    mode_t = 0
    match m {
        Title => {
            tk_body_clips(hero, &ZENMAI_IDLE, &ZENMAI_RUN, &ZENMAI_JUMP)
            title_camera()
        }
        Play => {
            cam_mode = 0
            tk_cam_follow(hero, 50)
            show_message("FIND THE FIVE STARS!")
        }
        Tidy => {
            tk_body_clips(hero, null, null, null)
            tk_play(hero.anim, &ZENMAI_CHEER, 10)
            tk_cam_orbit(hero, 60)
            tk_cam_turn(tk_wrap(hero.yaw + PI - tk_cam.yaw), 0.05)    // round to its face
            show_message("ALL TIDY!")
        }
    }
}

fn reset_game() {
    tk_teleport(hero, START_POS)
    hero.yaw = 0.0
    got = 0
    for i in 0..NSTARS {
        stars[i].shown = i < 4
        stars[i].pos = STAR_SPOTS[i]
    }
    lid_open = false
    tk_restart(chest, &CHEST_SHUT, 0)
}

fn show_message(s: *u8) {
    msg = s
    msg_t = 150
}

// The title camera: a slow turn round the room.
fn title_camera() {
    let a = frame_angle(mode_t, 0.004) + 3.6
    tk_cam_fixed(vec3(sin(a) * 9.5, 5.2, cos(a) * 7.5), null, vec3(0.0, 1.0, 0.0), 0)
}

fn next_camera() {
    cam_mode = (cam_mode + 1) % 5
    match cam_mode {
        0 => tk_cam_follow(hero, 30)
        1 => tk_cam_orbit(hero, 30)
        2 => tk_cam_first_person(hero, 30)
        3 => tk_cam_fixed(CORNER_EYE, hero, vec3(0.0, 0.0, 0.0), 30)
        else => tk_cam_rail(&RAIL[0], len(RAIL), hero, 30)
    }
}

fn update() {
    pad_was = pad
    pad = tk_input_pad()
    mode_t += 1
    if pressed(X) { show_costs = !show_costs }
    match mode {
        Title => {
            title_camera()
            tk_drive(hero, vec3(0.0, 0.0, 0.0), false)
            if pressed(START) {
                reset_game()
                enter(Mode.Play)
            }
        }
        Play => {
            if pressed(Y) { next_camera() }
            tk_drive_pad(hero)
            if pressed(START) {
                reset_game()
                enter(Mode.Title)
            }
        }
        Tidy => {
            tk_drive(hero, vec3(0.0, 0.0, 0.0), false)
            tk_cam_turn(0.008, 0.0)
            if mode_t % 40 == 1 { tk_burst(TK_CONFETTI, hero.pos + vec3(0.0, 1.2, 0.0), 14) }
            if pressed(START) && mode_t > 60 {
                reset_game()
                enter(Mode.Title)
            }
        }
    }
    tk_update()
    update_toys()
    wave_room(tk_ticks())
    if msg_t > 0 { msg_t -= 1 }
}

// Everything that reacts to Zenmai, after the step.
fn update_toys() {
    let t = tk_ticks()
    // the wind-up key turns faster the faster Zenmai runs, and a blink every few seconds
    key_turn = tk_wrap(key_turn + 0.06 + hero.moving * 0.3)
    tk_anim_joint(hero.anim, ZENMAI_KEY).rot.z = key_turn
    let bl = t % 200
    var shut: fixed = 0.0
    if bl < 5 { shut = fixed(bl) / 5 } else if bl < 10 { shut = fixed(10 - bl) / 5 }
    tk_morph_blend(face, ZENMAI_HEAD_BASE, ZENMAI_HEAD_BLINK, shut)
    // footsteps kick up a little dust
    if hero.on_ground && hero.moving > 0.5 && (tk_anim_passed(hero.anim, 0) || tk_anim_passed(hero.anim, 10)) {
        tk_burst(TK_DUST, hero.pos, 1)
    }
    if hero.landed && hero.impact > 0.2 { tk_shake(0.25, 12) }

    // the train runs round the rug, puffing; it bumps Zenmai out of its way
    let a = frame_angle(t, 0.011)
    engine.pos = TRAIN_CENTRE + vec3(cos(a), 0.0, sin(a)) * TRAIN_RADIUS
    engine.yaw = -a
    let b = a - 0.62
    carriage.pos = TRAIN_CENTRE + vec3(cos(b), 0.0, sin(b)) * TRAIN_RADIUS
    carriage.yaw = -b
    smoke.pos = engine.pos + vec3(sin(engine.yaw) * 0.65, 1.2, cos(engine.yaw) * 0.65)
    if mode == Mode.Play && tk_body_touches(hero, engine.pos + vec3(0.0, 0.5, 0.0), 0.65) {
        let away = normalize(vec3(hero.pos.x - engine.pos.x, 0.0, hero.pos.z - engine.pos.z))
        tk_launch(hero, away * 0.12 + vec3(0.0, 0.12, 0.0))
        tk_shake(0.3, 15)
        show_message("TOOT TOOT!")
    }

    // the button opens the toy chest, and the last star rises out of it
    if tk_zone_entered(button_zone) && !lid_open && mode == Mode.Play {
        lid_open = true
        lid_t = 0
        tk_play(chest, &CHEST_OPEN, 0)
        tk_shake(0.2, 20)
        show_message("THE TOY BOX OPENED!")
    }
    if lid_open {
        lid_t += 1
        if lid_t == 18 { tk_burst(TK_CONFETTI, CHEST_POS + vec3(0.0, 1.4, 0.0), 50) }
        if lid_t >= 18 && lid_t < 70 && got < NSTARS && !stars[4].shown {
            stars[4].shown = true
        }
        if lid_t < 70 {
            let k = tk_ease(fixed(lid_t - 18) / 52)
            stars[4].pos = CHEST_POS + vec3(0.0, 0.6, 0.0) + (STAR_SPOTS[4] - CHEST_POS - vec3(0.0, 0.6, 0.0)) * k
        }
    }
    // the button sinks while it is stood on
    button.pos.y = BUTTON_POS.y
    if tk_zone_count(button_zone) > 0 { button.pos.y = BUTTON_POS.y - 0.1 }

    // splashing in the pool: slower going, and splashes
    let wet = tk_zone_has(pool_zone, hero)
    if wet { hero.speed = 0.055 } else { hero.speed = 0.085 }
    if tk_zone_entered(pool_zone) || (wet && hero.landed) {
        tk_burst_moving(TK_SPLASH, hero.pos + vec3(0.0, 0.25, 0.0), 16, vec3(0.0, 0.02, 0.0))
    }
    if wet && hero.moving > 0.4 && t % 8 == 0 { tk_burst(TK_SPLASH, hero.pos + vec3(0.0, 0.2, 0.0), 2) }

    // stars
    if mode == Mode.Play {
        for i in 0..NSTARS {
            let s = stars[i]
            if s.shown && (i < 4 || lid_t >= 70) && tk_body_touches(hero, tk_prop_spot(s), 0.45) {
                s.shown = false
                got += 1
                tk_burst(TK_SPARKLE, tk_prop_spot(s), 28)
                tk_shake(0.12, 8)
                if got < NSTARS { show_message("A STAR!") }
            }
        }
        if got == NSTARS { enter(Mode.Tidy) }
    }
    // the stars glitter now and then
    for i in 0..NSTARS {
        if stars[i].shown && (t + i * 17) % 40 == 0 { tk_burst(TK_SPARKLE, tk_prop_spot(stars[i]), 3) }
    }
}

fn draw() {
    tk_draw()
    draw_room_extras()
    match mode {
        Title => draw_title()
        Play => draw_hud()
        Tidy => draw_tidy()
    }
    if show_costs { draw_costs() }
}

fn draw_title() {
    let w = tk_logo_width(30)
    tk_logo(160 - w / 2, 38, 30, mode_t)
    font_shadow(rgb(60, 40, 30))
    font_text_align(160, 84, "P L A Y R O O M", rgb(255, 250, 235), ALIGN_CENTRE)
    if (mode_t / 30) % 2 == 0 { font_text_align(160, 200, "PRESS START", rgb(255, 240, 150), ALIGN_CENTRE) }
    font_text_align(160, 222, "a wind-up toy tidies up", rgb(240, 230, 220), ALIGN_CENTRE)
    font_shadow_off()
}

fn draw_hud() {
    // five stars along the top: bright for each one tidied
    for i in 0..NSTARS {
        var c = rgb(90, 80, 70)
        if i < got { c = rgb(255, 220, 60) }
        tk_sprite(HUD_STAR, 6 + i * 20, 6, 20, 20, c, BLEND_NONE)
    }
    font_shadow(rgb(50, 40, 30))
    font_text_align(314, 8, CAM_NAMES[cam_mode], rgb(255, 250, 235), ALIGN_RIGHT)
    font_text_align(314, 19, "Y: camera", rgb(220, 210, 200), ALIGN_RIGHT)
    if msg_t > 0 && (msg_t > 30 || (msg_t / 4) % 2 == 0) {
        font_text_align(160, 200, msg, rgb(255, 245, 160), ALIGN_CENTRE)
    }
    font_shadow_off()
}

fn draw_tidy() {
    let w = tk_logo_width(22)
    tk_logo(160 - w / 2, 30, 22, mode_t)
    font_shadow(rgb(50, 40, 30))
    font_text_align(160, 70, "ALL TIDY!  THANK YOU!", rgb(255, 245, 160), ALIGN_CENTRE)
    if mode_t > 60 { font_text_align(160, 214, "START: play again", rgb(255, 250, 235), ALIGN_CENTRE) }
    font_shadow_off()
}

fn draw_costs() {
    rect_blend(4, 196, 150, 40, rgb(20, 16, 30), BLEND_HALF)
    text(8, 200, "CPU", rgb(255, 255, 255))
    text_int(48, 200, cpu_used(), rgb(255, 255, 255))
    text(8, 210, "GPU", rgb(255, 255, 255))
    text_int(48, 210, gpu_used(), rgb(255, 255, 255))
    text(8, 220, "TRI", rgb(255, 255, 255))
    text_int(48, 220, tris_drawn(), rgb(255, 255, 255))
    text(96, 220, "P", rgb(255, 255, 255))
    text_int(112, 220, tk_particles_drawn(), rgb(255, 255, 255))
}
