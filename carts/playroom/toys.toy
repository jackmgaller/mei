# The Playroom's toys, for tools/tsumiki.py:
#     python3 tools/tsumiki.py carts/playroom/toys.toy
# writes toys.akr and the .bin meshes and textures next to this file.
#
# Models face +Z (yaw 0) and stand on y = 0. One unit is about Zenmai's height.

# ---------------------------------------------------------------- texture cells (slot 0)

texture slot 0 palette 0
cell floorboards planks 32x32 #8a5630 #e8b47c
cell wallpaper stripes 32x32 #f2d0c4 #fbeadf
cell skirting wood 32x32 #c8b090 #fff4e0
cell rug check 32x32 #6f9fd8 #f6ecd8
cell rug_edge stripes 32x32 #e05050 #f6ecd8
cell sky_window dots 32x32 #ffffff #9fd0f4
cell cake_icing dots 32x32 #f05a8c #fff0f4
cell book_spine stripes 16x32 #b0a080 #ffffff
cell letter_t letter:T 32x32 #f6e2b8 #c89a5c #d83c30
cell letter_o letter:O 32x32 #f6e2b8 #c89a5c #2860c8
cell letter_y letter:Y 32x32 #f6e2b8 #c89a5c #3c9c44
cell letter_s letter:S 32x32 #f6e2b8 #c89a5c #e08c1c
cell letter_a letter:A 32x32 #f6e2b8 #c89a5c #d83c30
cell letter_b letter:B 32x32 #f6e2b8 #c89a5c #2860c8
cell letter_c letter:C 32x32 #f6e2b8 #c89a5c #3c9c44
cell letter_m letter:M 32x32 #f6e2b8 #c89a5c #8c4cb4
cell letter_e letter:E 32x32 #f6e2b8 #c89a5c #e08c1c
cell letter_i letter:I 32x32 #f6e2b8 #c89a5c #d83c30
cell button_top dots 32x32 #ffffff #ffd040
cell hud_star star5 32x32 #000000 #3c2814 #ffffff

# ---------------------------------------------------------------- Zenmai, the wind-up toy

# toys turn about, so they are lit mostly from above and a little from the front (+Z)
light -0.25 0.9 0.35 ambient 0.6

model zenmai
part body joint 0 0.22 0
  paint red smooth
  cylinder 0 0.2 0   0.25 0.36 sides 10           # the tin barrel
  paint yellow smooth
  cylinder 0 0.33 0  0.262 0.07 sides 10 open     # its band (no ends: they are inside)
  paint #f0f0f0 smooth
  sphere 0 0.33 0.255  0.04 rings 2               # a rivet on the band

part head parent body joint 0 0.56 0
  paint cream smooth
  sphere 0 0.77 0  0.215 rings 4
  paint black flat                                # the face: panels facing +z
  panel -0.12 0.74 0.212   -0.045 0.875 0.212 +z  # eyes
  panel  0.045 0.74 0.212    0.12 0.875 0.212 +z
  paint white flat
  panel -0.105 0.835 0.214  -0.08 0.86 0.214 +z   # a glint in each
  panel  0.06 0.835 0.214   0.085 0.86 0.214 +z
  paint pink flat
  panel -0.17 0.70 0.19  -0.115 0.735 0.19 +z     # cheeks
  panel  0.115 0.70 0.19   0.17 0.735 0.19 +z
  paint red flat
  panel -0.035 0.69 0.208  0.035 0.705 0.208 +z   # a little mouth
  paint blue smooth
  cylinder 0 0.94 0  0.14 0.06 sides 6            # cap
  paint blue flat
  box -0.08 0.95 0.1  0.08 0.97 0.2               # its peak
  paint red smooth
  sphere 0 1.03 0  0.05 rings 2                   # pompom
# the blink: the eyes close to a line (pose 1)
pose blink
  scale 1 0.1 1 about 0 0.8 0 inside -0.13 0.73 0.205  0.13 0.88 0.23

part key parent body joint 0 0.4 -0.25
  paint #e8c040 smooth
  cylinder 0 0.4 -0.25  0.03 0.12 sides 5 axis -z open  # the shaft, out of its back
  paint #f0cc50 flat
  sphere -0.1 0.4 -0.38  0.085 rings 2 scale 1 1 0.3   # the bow: two lobes
  sphere  0.1 0.4 -0.38  0.085 rings 2 scale 1 1 0.3
  box -0.03 0.37 -0.4  0.03 0.43 -0.36

part arm_l parent body joint -0.27 0.5 0
  paint red smooth
  cylinder -0.27 0.33 0  0.045 0.17 sides 5 open
  paint cream smooth
  sphere -0.27 0.31 0  0.065 rings 2

part arm_r parent body joint 0.27 0.5 0
  paint red smooth
  cylinder 0.27 0.33 0  0.045 0.17 sides 5 open
  paint cream smooth
  sphere 0.27 0.31 0  0.065 rings 2

part leg_l parent body joint -0.11 0.21 0
  paint #505860 smooth
  cylinder -0.11 0.07 0  0.05 0.14 sides 5 open
  paint blue flat
  box -0.18 0.0 -0.08  -0.04 0.085 0.14           # a shoe

part leg_r parent body joint 0.11 0.21 0
  paint #505860 smooth
  cylinder 0.11 0.07 0  0.05 0.14 sides 5 open
  paint blue flat
  box 0.04 0.0 -0.08  0.18 0.085 0.14

# standing: a slow sway, arms hanging
clip zenmai idle 60 loop
  key 0  body move 0 0 0
  key 30 body move 0 0.025 0
  key 0  head rot 0 0 4
  key 30 head rot 0 0 -4
  key 0  arm_l rot 0 0 -6
  key 30 arm_l rot 0 0 -12
  key 0  arm_r rot 0 0 6
  key 30 arm_r rot 0 0 12

# running: a wind-up waddle, rocking from foot to foot
clip zenmai run 20 loop
  key 0  body rot -8 0 8   move 0 0 0
  key 5  body rot -8 0 0   move 0 0.07 0
  key 10 body rot -8 0 -8  move 0 0 0
  key 15 body rot -8 0 0   move 0 0.07 0
  key 0  head rot 6 0 -5
  key 10 head rot 6 0 5
  key 0  leg_l rot 38 0 0
  key 10 leg_l rot -38 0 0
  key 0  leg_r rot -38 0 0
  key 10 leg_r rot 38 0 0
  key 0  arm_l rot -45 0 -10
  key 10 arm_l rot 45 0 -10
  key 0  arm_r rot 45 0 10
  key 10 arm_r rot -45 0 10

# in the air: arms flung up, feet tucked
clip zenmai jump 16 loop
  key 0  arm_l rot 0 0 -140
  key 8  arm_l rot 10 0 -160
  key 0  arm_r rot 0 0 140
  key 8  arm_r rot 10 0 160
  key 0  leg_l rot 30 0 -6
  key 8  leg_l rot 20 0 -6
  key 0  leg_r rot -10 0 6
  key 8  leg_r rot 0 0 6
  key 0  head rot -8 0 0
  key 0  body rot 6 0 0

# all tidy: hopping and waving both arms
clip zenmai cheer 24 loop
  key 0  body move 0 0 0
  key 6  body move 0 0.16 0
  key 12 body move 0 0 0
  key 0  arm_l rot 0 0 -165
  key 6  arm_l rot 0 0 -120
  key 12 arm_l rot 0 0 -165
  key 0  arm_r rot 0 0 120
  key 6  arm_r rot 0 0 165
  key 12 arm_r rot 0 0 120
  key 0  head rot 0 0 -8
  key 12 head rot 0 0 8

# ---------------------------------------------------------------- the toy chest

model chest
part base joint 0 0 0
  paint #3c6cc8 wood
  box -1.6 0 -1.0   1.6 0.18 1.0                  # floor of it
  box -1.6 0.18 -1.0   1.6 1.2 -0.86              # back
  box -1.6 0.18 0.86   1.6 1.2 1.0                # front
  box -1.6 0.18 -0.86  -1.46 1.2 0.86             # sides
  box 1.46 0.18 -0.86   1.6 1.2 0.86
  paint walnut flat
  box -1.46 0.18 -0.86  1.46 0.2 0.86             # the dark inside
  paint yellow wood
  box -1.66 0.0 -1.06  1.66 0.14 1.06             # trim at the bottom and top
  box -1.66 1.08 -1.06  -1.5 1.2 1.06
  box 1.5 1.08 -1.06  1.66 1.2 1.06
  box -1.5 1.08 0.9  1.5 1.2 1.06
  box -1.5 1.08 -1.06  1.5 1.2 -0.9
  paint white letter_t                            # T O Y S on the front (seen from the
  box 0.71 0.32 1.0  1.21 0.82 1.08               # front, +X is on the left)
  paint white letter_o
  box 0.1 0.32 1.0  0.6 0.82 1.08
  paint white letter_y
  box -0.6 0.32 1.0  -0.1 0.82 1.08
  paint white letter_s
  box -1.21 0.32 1.0  -0.71 0.82 1.08

part lid parent base joint 0 1.2 -1.0
  paint #3c6cc8 wood
  box -1.66 1.2 -1.06  1.66 1.42 1.06
  paint yellow wood
  box -1.7 1.18 0.94  1.7 1.46 1.1                # its front edge
  paint red smooth
  sphere 0 1.32 1.13  0.09 rings 3                # a knob

# the lid springs open, overshoots a little and settles
clip chest open 40 once
  key 0  lid rot 0 0 0
  key 26 lid rot 118 0 0
  key 33 lid rot 104 0 0
  key 40 lid rot 108 0 0

clip chest shut 1 once
  key 0 lid rot 0 0 0

# ---------------------------------------------------------------- small things

mesh star
  paint yellow
  star 0 0 0  0.4 0.18 0.16 points 5

mesh train
  paint green smooth
  cylinder 0 0.42 -0.05  0.28 0.95 sides 8 axis z      # the boiler
  paint red wood
  box -0.32 0.12 -0.8  0.32 0.36 0.95                  # chassis
  box -0.36 0.36 -0.85  0.36 1.12 -0.25                # cab
  paint black flat
  box -0.4 1.12 -0.92  0.4 1.2 -0.18                   # cab roof
  cylinder 0 0.68 0.65  0.09 0.42 sides 6 open         # chimney
  cylinder 0 1.08 0.65  0.14 0.06 sides 6
  paint yellow smooth
  cylinder 0.32 0.2 0.55  0.2 0.08 sides 7 axis x      # wheels
  cylinder 0.32 0.2 -0.5  0.2 0.08 sides 7 axis x
  cylinder -0.4 0.2 0.55  0.2 0.08 sides 7 axis x
  cylinder -0.4 0.2 -0.5  0.2 0.08 sides 7 axis x

mesh carriage
  paint blue wood
  box -0.32 0.12 -0.6  0.32 0.62 0.6
  paint yellow flat
  box -0.36 0.6 -0.64  0.36 0.68 0.64
  paint orange smooth
  cylinder 0.32 0.2 0.35  0.18 0.08 sides 7 axis x
  cylinder 0.32 0.2 -0.35  0.18 0.08 sides 7 axis x
  cylinder -0.4 0.2 0.35  0.18 0.08 sides 7 axis x
  cylinder -0.4 0.2 -0.35  0.18 0.08 sides 7 axis x

mesh button
  paint red smooth
  cylinder 0 0 0  0.7 0.2 sides 10
  paint white button_top
  cylinder 0 0.2 0  0.55 0.04 sides 10
