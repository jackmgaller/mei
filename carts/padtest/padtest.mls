// Controller tester: shows both pads' buttons and sticks, and logs presses and
// releases to the debug console.
cart "Pad Test"

var prev1: u32
var prev2: u32
var prev_dir: s32

// Stick direction as a code: 1 right, 2 left, 4 up, 8 down (combined), 0 centred.
fn stick_dir(s: vec2) -> s32 {
    var d = 0
    if s.x > 0.5 { d = d | 1 }
    if s.x < -0.5 { d = d | 2 }
    if s.y > 0.5 { d = d | 4 }
    if s.y < -0.5 { d = d | 8 }
    return d
}

fn button(x: s32, y: s32, name: *u8, held: bool) {
    if held {
        rect(x - 2, y - 2, 52, 12, rgb(250, 190, 60))
        text(x, y, name, rgb(20, 20, 30))
    } else {
        rect(x - 2, y - 2, 52, 12, rgb(40, 44, 64))
        text(x, y, name, rgb(140, 145, 170))
    }
}

fn pad(x: s32, y: s32, title: *u8, held: u32, s: vec2) {
    text(x, y, title, rgb(255, 255, 255))
    button(x, y + 16, "UP", held & UP != 0)
    button(x, y + 30, "DOWN", held & DOWN != 0)
    button(x, y + 44, "LEFT", held & LEFT != 0)
    button(x, y + 58, "RIGHT", held & RIGHT != 0)
    button(x + 56, y + 16, "A", held & A != 0)
    button(x + 56, y + 30, "B", held & B != 0)
    button(x + 56, y + 44, "X", held & X != 0)
    button(x + 56, y + 58, "Y", held & Y != 0)
    button(x, y + 72, "L", held & L != 0)
    button(x + 56, y + 72, "R", held & R != 0)
    button(x, y + 86, "START", held & START != 0)
    button(x + 56, y + 86, "SELECT", held & SELECT != 0)

    // stick: a 61x61 box, y up
    let cx = x + 30
    let cy = y + 136
    rect(cx - 30, cy - 30, 61, 61, rgb(40, 44, 64))
    rect(cx, cy - 30, 1, 61, rgb(70, 75, 100))
    rect(cx - 30, cy, 61, 1, rgb(70, 75, 100))
    let dx = (s.x * 28) as s32
    let dy = (s.y * 28) as s32
    rect(cx + dx - 2, cy - dy - 2, 5, 5, rgb(120, 220, 255))
    text_int(x + 66, cy - 8, (s.x * 100) as s32, rgb(140, 145, 170))
    text_int(x + 66, cy + 4, (s.y * 100) as s32, rgb(140, 145, 170))
}

fn log_changes(player: s32, now: u32, before: u32) {
    if now == before { return }
    print("pad ")
    print_int(player)
    print(": ")
    print_hex(now)
    println("")
}

fn update() {
    log_changes(1, PAD1, prev1)
    log_changes(2, PAD2, prev2)
    let d = stick_dir(stick())
    if d != prev_dir {
        print("stick 1: ")
        if d & 4 != 0 { print("up ") }
        if d & 8 != 0 { print("down ") }
        if d & 2 != 0 { print("left ") }
        if d & 1 != 0 { print("right ") }
        if d == 0 { print("centre") }
        println("")
        prev_dir = d
    }
    prev1 = PAD1
    prev2 = PAD2
}

fn draw() {
    cls(rgb(16, 18, 28))
    text(8, 6, "PAD TEST", rgb(250, 190, 60))
    pad(16, 24, "CONTROLLER 1", PAD1, stick())
    pad(176, 24, "CONTROLLER 2", PAD2, stick2())
}
