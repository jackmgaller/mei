// A stand-in platform of agent A's, to build the rules against until B's world is in. The same
// shape as the Gate 1 plan's room: an island platform 30 m long between two tracks, pillars,
// benches, a stair at the left (the way in), a staff door at the right (the exit), two patrol
// guards, a posted guard, a camera, a train on each track, two hiding places, two fragile things.
// It is not the puzzle (that is B's); it exercises every rule.

const SI_PLAT_Z: fixed = 3.0       // the platform: z -3..3, x -15..15, y 0
const SI_TRACK_Z: fixed = 4.3      // the tracks' centre lines
const SI_ROOM_X: fixed = 15.0
const SI_ROOM_Z: fixed = 6.0

fn standin_load() {
    room_clear()
    room.name = "stand-in platform"
    room.cx = 0.0
    room.cz = 0.0
    room.sx = 30.0
    room.sz = 12.0
    room.spawn_x = -10.4
    room.spawn_z = 1.6
    room.spawn_head = HALF_PI
    room.exit = box2(14.45, -1.8, 0.8, 2.0, 1.2, 0.0, false, false)
    room.toys = 2
    room.bells = 1
    // walls: back, front (cut at 1 m), the platform's two ends
    room_wall(box2(0.0, 6.15, 30.6, 3.2, 0.3, 0.0, true, true))
    room_wall(box2(0.0, -6.15, 30.6, 1.0, 0.3, 0.0, true, true))
    room_wall(box2(-15.15, 0.0, 0.3, 3.2, 6.0, 0.0, true, true))
    room_wall(box2(15.15, 0.0, 0.3, 3.2, 6.0, 0.0, true, true))
    // pillars
    room_wall(box2(-9.0, 0.0, 0.6, 3.2, 0.6, 0.0, true, true))
    room_wall(box2(-3.0, 0.0, 0.6, 3.2, 0.6, 0.0, true, true))
    room_wall(box2(3.0, 0.0, 0.6, 3.2, 0.6, 0.0, true, true))
    room_wall(box2(9.0, 0.0, 0.6, 3.2, 0.6, 0.0, true, true))
    // benches: seen over, not walked through
    room_wall(box2(-6.0, 0.0, 1.6, 0.45, 0.5, 0.0, false, true))
    room_wall(box2(6.0, 0.0, 1.6, 0.45, 0.5, 0.0, false, true))
    // the stair down from the concourse (the way in), and a glass screen beside it
    room_wall(box2(-12.8, 1.6, 4.0, 2.6, 1.8, 0.0, true, true))
    room_wall(box2(-10.6, -0.3, 0.06, 1.4, 1.6, 0.0, false, true))
    // the staff door's frame at the right
    room_wall(box2(14.45, -0.95, 0.9, 2.4, 0.3, 0.0, true, true))
    room_wall(box2(14.45, -2.65, 0.9, 2.4, 0.3, 0.0, true, true))

    // patrol 1: the left half, a loop round the pillar at -9
    let a = room_waypoint(-12.5, -2.2, -1, 60, -90.0)
    let b = room_waypoint(-12.5, -0.6, -1, 0, 0.0)
    let c = room_waypoint(-5.6, 2.2, -1, 60, 90.0)
    let d = room_waypoint(-5.6, -2.2, -1, 0, 0.0)
    room.wps[a].next = b
    room.wps[b].next = c
    room.wps[c].next = d
    room.wps[d].next = a
    room_watch(WatchDef { kind: WKind.Patrol, x: -7.0, z: -2.2, head: -HALF_PI, route: a, sight: 6.0,
                          half: 30.0 * DEG, speed: 0.02, hold: 60, turn: 90, hear: 6.0 })
    // patrol 2: the right half
    let e = room_waypoint(1.5, 2.2, -1, 60, -90.0)
    let f = room_waypoint(1.5, -2.2, -1, 0, 0.0)
    let g = room_waypoint(11.0, -2.2, -1, 90, 90.0)
    let h = room_waypoint(11.0, 2.2, -1, 0, 0.0)
    room.wps[e].next = f
    room.wps[f].next = g
    room.wps[g].next = h
    room.wps[h].next = e
    room_watch(WatchDef { kind: WKind.Patrol, x: 6.0, z: 2.2, head: -HALF_PI, route: e, sight: 6.0,
                          half: 30.0 * DEG, speed: 0.02, hold: 60, turn: 90, hear: 6.0 })
    // the posted guard by the staff door
    room_watch(WatchDef { kind: WKind.Posted, x: 13.0, z: 1.6, route: -1, sight: 5.0, half: 30.0 * DEG,
                          speed: 0.02, look_a: 180.0 * DEG, look_b: 270.0 * DEG, hold: 90, turn: 60,
                          hear: 6.0 })
    // the camera on the back wall, over the middle of the platform
    room_watch(WatchDef { kind: WKind.Camera, x: 0.0, z: 2.85, route: -1, sight: 6.5, half: 25.0 * DEG,
                          speed: 0.0, look_a: 135.0 * DEG, look_b: 225.0 * DEG, hold: 60, turn: 150 })

    // the trains: the front track runs to the right, the back track to the left; doors open on
    // the platform's side (their left)
    standin_train(0, -17.0, -SI_TRACK_Z, 17.0, -SI_TRACK_Z, 1800, 240)
    standin_train(1, 17.0, SI_TRACK_Z, -17.0, SI_TRACK_Z, 2100, 1200)

    room_spot(box2(-7.5, 2.45, 1.0, 1.9, 0.9, 0.0, false, false))
    room_spot(box2(6.4, 2.45, 1.0, 1.9, 0.9, 0.0, false, false))
    room_fragile(-1.4, 2.5, 0.35, 8.0)
    room_fragile(11.8, -2.4, 0.35, 8.0)
    room_finish()
}

fn standin_train(i: s32, x0: fixed, z0: fixed, x1: fixed, z1: fixed, period: s32, offset: s32) {
    let t = &room.trains[i]
    t.path.n = 2
    t.path.x[0] = x0
    t.path.z[0] = z0
    t.path.x[1] = x1
    t.path.z[1] = z1
    t.path.y = 0.0
    t.period = period
    t.offset = offset
    t.arrive = 240
    t.dwell = 420
    t.leave = 240
    t.stop = 30.0
    t.cars = 2
    t.car_len = 10.0
    t.width = 2.6
    t.doors = 3
    t.door_w = 1.3
    t.left = true
    t.right = false
    room.ntrains = max(room.ntrains, i + 1)
}

// The stand-in room's mesh: floors, track beds, walls by their boxes (at their heights), the
// exit's mat. Built once (dr_view.akr draws it when there is no world).
fn standin_mesh(b: *MB) {
    let floor = rgb(92, 96, 104)
    let bed = rgb(38, 36, 40)
    let wall = rgb(150, 146, 136)
    mb_box(b, -SI_ROOM_X, -0.2, -SI_PLAT_Z, SI_ROOM_X, 0.0, SI_PLAT_Z, floor)
    mb_box(b, -SI_ROOM_X, -1.3, -SI_ROOM_Z, SI_ROOM_X, -1.1, -SI_PLAT_Z, bed)
    mb_box(b, -SI_ROOM_X, -1.3, SI_PLAT_Z, SI_ROOM_X, -1.1, SI_ROOM_Z, bed)
    // the platform edges' faces down to the beds, and a yellow line along each edge
    mb_box(b, -SI_ROOM_X, -1.1, -SI_PLAT_Z, SI_ROOM_X, -0.2, -SI_PLAT_Z + 0.1, rgb(70, 72, 78))
    mb_box(b, -SI_ROOM_X, -1.1, SI_PLAT_Z - 0.1, SI_ROOM_X, -0.2, SI_PLAT_Z, rgb(70, 72, 78))
    mb_box(b, -SI_ROOM_X, 0.0, -SI_PLAT_Z + 0.25, SI_ROOM_X, 0.01, -SI_PLAT_Z + 0.4, rgb(200, 170, 40))
    mb_box(b, -SI_ROOM_X, 0.0, SI_PLAT_Z - 0.4, SI_ROOM_X, 0.01, SI_PLAT_Z - 0.25, rgb(200, 170, 40))
    // rails
    for k in 0..2 {
        let z = if_f(k == 0, -SI_TRACK_Z, SI_TRACK_Z)
        mb_box(b, -SI_ROOM_X, -1.1, z - 0.8, SI_ROOM_X, -0.98, z - 0.72, rgb(120, 120, 128))
        mb_box(b, -SI_ROOM_X, -1.1, z + 0.72, SI_ROOM_X, -0.98, z + 0.8, rgb(120, 120, 128))
    }
    for i in 0..room.nwalls {
        let w = &room.walls[i]
        var col = wall
        if !w.blocks { col = rgb(110, 150, 170) }
        if w.h < 0.6 { col = rgb(120, 84, 60) }
        mb_obox(b, w, 0.0, w.h, col)
    }
    // the exit's mat
    mb_obox(b, &room.exit, 0.0, 0.015, rgb(60, 200, 110))
}

// An oriented plan box from y0 to y1.
fn mb_obox(b: *MB, w: *Box2, y0: fixed, y1: fixed, col: u32) {
    let first = b.nv
    mb_box(b, -w.hx, y0, -w.hz, w.hx, y1, w.hz, col)
    for k in first..b.nv {
        let v = b.v[k]
        b.v[k] = vec4(w.cx + v.x * w.c + v.z * w.s, v.y, w.cz - v.x * w.s + v.z * w.c, 1.0)
    }
}
