// The levels' worlds (B's, worlds.txt): which World Kit world each level of the game is. A level
// is one world holding its rooms (dr_world.akr reads it), played as one run. Stage 1 is `level1`
// (levels/level1/ROUTE.md); stage 2, keycards and backtracking, is `level2` (rooms of doors,
// dr_keys.akr); stage 3 is Gate 1's hard platform, `platform` (B's order, NOTES_B.md). A's end
// line starts the next; after the last, the first again.
import "level1.akr"
import "level2.akr"
import "platform.akr"

const LEVELS = 3
const STAGE2 = 1               // level2's index
const PLATFORM_LEVEL = 2       // the platform's
var level: s32                 // the level being played (0: level 1)

// Opens the level's world (the reader keeps one pack open).
fn level_open() -> bool { return level_open_n(level) }

// Opens level n's world without making it the level played (E's stage select draws each stage's
// model from its world; the run then reopens its own through stage_start()).
fn level_open_n(n: s32) -> bool {
    if n == STAGE2 { return world_level2_load() }
    if n == PLATFORM_LEVEL { return world_platform_load() }
    return world_level1_load()
}
