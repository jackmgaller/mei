// A level's World Kit world into the room the runtime plays (dr_room.akr), and its drawing. The
// worlds are B's (worlds.txt; dr_levels.akr opens the level's); their entities are the game's
// types in afterhours.game.mochi (NOTES_B.md). This file is the only one that reads them, and it reads
// whichever After Hours world is open.
//
// How a level's rooms sit in its world (B's, NOTES_B.md "Level 1"): each room in its own cell,
// side by side; an entity belongs to the room whose box (the room entity's position, size / 2 in
// x and z) holds it; the room with `first` starts the level and each room's `next` is the one its
// exit leads to (a world with no `first`: its rooms in entity order). The room entity's y is the
// room's floor. Entering a room enters its cell's region (textures, palettes).
//
// A stage of doors (stage 2, level2): `next` only numbers the rooms (rooms off that chain follow
// in entity order); each `door` entity leads to the room holding its `to` door. A door's number
// in the stage (dr_keys.akr) is its entity number, a keycard's too. The doors of a room are
// numbered in entity order (B's S2_LEG_DOOR counts them the same way).
import "dr_levels.akr"

// The run's rooms come from the level's world (replaces dr_game.akr's weak defaults).
fn room_load_n(k: s32) -> bool { return world_room_load(k) }
fn room_count() -> s32 { return level_rooms() }
fn stage_of() -> s32 { return level }

// Opens level n's world for the next run (replaces dr_game.akr's weak default): the level after
// this one when n is -1, the first after the last.
fn level_switch(n: s32) -> bool {
    var next = n
    if next < 0 { next = (level + 1) % LEVELS }
    level = next
    norder = -1
    wp_region_loaded = -1
    return level_open()
}

// Whether the open stage's rooms join by doors (dr_game.akr's weak default).
fn stage_has_doors() -> bool {
    let _ = level_rooms()
    return order_doors
}

const MAX_ENTITIES = 512

fn deg(d: fixed) -> fixed { return d * DEG }

// A name parameter's string in the open pack.
fn pack_string(offset: u32) -> *u8 { return (wp_pack as u32 + offset) as *u8 }

var order: [MAX_RUN]s32        // the level's rooms' entity numbers, in the run's order
var norder: s32 = -1           // -1: not worked out for the open pack yet
var order_doors: bool          // the open pack has doors
// The level's rooms, in order: from the `first` one along `next`, or in entity order.
fn level_rooms() -> s32 {
    if norder >= 0 { return norder }
    assert(level_open(), "the level's world did not open")
    let count = wp_pack.entity_count as s32
    norder = 0
    var first = -1
    for n in 0..count {
        let e = wp_entity(n)
        if e.type_id as s32 == AFTERHOURS_TYPE_ROOM && (wp_entity_params(e) as *AfterhoursRoom).first { first = n }
    }
    if first >= 0 {
        var n = first
        while n >= 0 && norder < MAX_RUN {
            order[norder] = n
            norder += 1
            let nx = (wp_entity_params(wp_entity(n)) as *AfterhoursRoom).next
            if nx == 0xFFFFFFFF { n = -1 } else { n = nx as s32 }
        }
    }
    // the rooms off the chain (all of them without `first`), in entity order
    order_doors = false
    for n in 0..count {
        let ty = wp_entity(n).type_id as s32
        if ty == AFTERHOURS_TYPE_DOOR { order_doors = true }
        if ty != AFTERHOURS_TYPE_ROOM || norder >= MAX_RUN { continue }
        var have = false
        for k in 0..norder {
            if order[k] == n { have = true }
        }
        if !have {
            order[norder] = n
            norder += 1
        }
    }
    return norder
}

// Whether room entity r's box holds the point (as world_room_load's rooms).
fn room_holds(r: s32, p: vec3) -> bool {
    let re = wp_entity(r)
    let rpos = wp_entity_pos(re)
    let rsize = (wp_entity_params(re) as *AfterhoursRoom).size
    return abs(p.x - rpos.x) <= rsize.x / 2 + 0.5 && abs(p.z - rpos.z) <= rsize.z / 2 + 0.5
}

// The run's room holding entity n (-1: none).
fn room_of_entity(n: s32) -> s32 {
    let p = wp_entity_pos(wp_entity(n))
    for k in 0..level_rooms() {
        if room_holds(order[k], p) { return k }
    }
    return -1
}

// Door entity n's number among its room's doors (entity order).
fn door_index(n: s32, k: s32) -> s32 {
    var i = 0
    for m in 0..n {
        let e = wp_entity(m)
        if e.type_id as s32 == AFTERHOURS_TYPE_DOOR && room_holds(order[k], wp_entity_pos(e)) { i += 1 }
    }
    return i
}

// The world position of where he comes into room k by door d (-1: the room's entry), on its
// floor: for E's transition, before the room is loaded.
fn room_door_spawn(k: s32, d: s32) -> vec3 {
    if k < 0 || k >= level_rooms() { return vec3(0.0, 0.0, 0.0) }
    let r = order[k]
    let p = wp_entity_params(wp_entity(r)) as *AfterhoursRoom
    var sp = p.entry as s32
    if d >= 0 {
        var i = 0
        for m in 0..wp_pack.entity_count as s32 {
            let e = wp_entity(m)
            if e.type_id as s32 != AFTERHOURS_TYPE_DOOR || !room_holds(r, wp_entity_pos(e)) { continue }
            if i == d {
                let dp = wp_entity_params(e) as *AfterhoursDoor
                if dp.spawn != 0xFFFFFFFF { sp = dp.spawn as s32 }
            }
            i += 1
        }
    }
    let q = wp_entity_pos(wp_entity(sp))
    return vec3(q.x, wp_entity_pos(wp_entity(r)).y, q.z)
}

// Room k of the run: its entities, read into the room model. False when the level has no room k.
fn world_room_load(k: s32) -> bool {
    if k >= level_rooms() { return false }
    let count = wp_pack.entity_count as s32
    assert(count <= MAX_ENTITIES, "too many entities")
    let ri = order[k]
    let re = wp_entity(ri)
    let rpos = wp_entity_pos(re)
    let rsize = (wp_entity_params(re) as *AfterhoursRoom).size
    let hx = rsize.x / 2 + 0.5
    let hz = rsize.z / 2 + 0.5
    var mine: [MAX_ENTITIES]bool          // the entity lies in room k's box
    for n in 0..count {
        let p = wp_entity_pos(wp_entity(n))
        mine[n] = abs(p.x - rpos.x) <= hx && abs(p.z - rpos.z) <= hz
    }
    room_clear()
    room_is_world = true
    room.name = "world room"
    room.floor = rpos.y
    let cell = wp_cell_at(rpos)
    if cell != null && cell.region as s32 != wp_region_loaded { wp_region_enter(cell.region as s32, 0) }
    var wp_of: [MAX_ENTITIES]s16          // entity number -> waypoint index
    for n in 0..count { wp_of[n] = -1 }
    // the waypoints first, so that refs to them resolve
    for n in 0..count {
        let e = wp_entity(n)
        if !mine[n] || e.type_id as s32 != AFTERHOURS_TYPE_WAYPOINT { continue }
        let p = wp_entity_params(e) as *AfterhoursWaypoint
        let pos = wp_entity_pos(e)
        wp_of[n] = room_waypoint(pos.x, pos.z, -1, p.wait as s32, p.look) as s16
    }
    for n in 0..count {
        if !mine[n] { continue }
        let e = wp_entity(n)
        let pos = wp_entity_pos(e)
        let ty = e.type_id as s32
        if ty == AFTERHOURS_TYPE_ROOM && n != ri { continue }
        let prm = wp_entity_params(e)
        if ty == AFTERHOURS_TYPE_WAYPOINT {
            let p = prm as *AfterhoursWaypoint
            if p.next != 0xFFFFFFFF { room.wps[wp_of[n] as s32].next = wp_of[p.next as s32] as s32 }
        } else if ty == AFTERHOURS_TYPE_ROOM {
            let p = prm as *AfterhoursRoom
            room.name = pack_string(p.name)
            room.cx = pos.x
            room.cz = pos.z
            room.sx = p.size.x
            room.sz = p.size.z
            room.toys = p.toys as s32
            room.bells = p.bells as s32
            let sp = wp_entity(p.entry as s32)
            let spos = wp_entity_pos(sp)
            room.spawn_x = spos.x
            room.spawn_z = spos.z
            room.spawn_head = deg((wp_entity_params(sp) as *AfterhoursSpawn).yaw)
            if p.exit != 0xFFFFFFFF {
                let ex = wp_entity(p.exit as s32)
                let epos = wp_entity_pos(ex)
                let es = (wp_entity_params(ex) as *AfterhoursExit).size
                room.exit = box2(epos.x, epos.z, es.x, es.y, es.z, ex.yaw, false, false)
                room.has_exit = true
            }
        } else if ty == AFTERHOURS_TYPE_GUARD {
            let p = prm as *AfterhoursGuard
            var w = WatchDef { x: pos.x, z: pos.z, head: e.yaw, route: -1, sight: p.sight,
                               half: deg(fixed(p.fov as s32)) / 2, speed: p.speed / 60,
                               look_a: deg(p.look_a), look_b: deg(p.look_b), hold: p.hold as s32,
                               turn: p.turn as s32, phase: p.phase as s32, hear: p.hear,
                               turn_rate: deg(p.turn_rate) / 60 }
            match p.kind {
                Patrol => w.kind = WKind.Patrol
                Posted => w.kind = WKind.Posted
                Camera => w.kind = WKind.Camera
            }
            if p.route != 0xFFFFFFFF { w.route = wp_of[p.route as s32] as s32 }
            room_watch(w)
        } else if ty == AFTERHOURS_TYPE_TRAIN {
            let p = prm as *AfterhoursTrain
            assert(room.ntrains < MAX_TRAINS, "too many trains")
            let t = &room.trains[room.ntrains]
            room.ntrains += 1
            let path = wp_path_find(pack_string(p.path))
            assert(path != null, "a train's path is not in the world")
            let np = min(wp_path_points(path), MAX_PATH)
            t.path.n = np
            for k in 0..np {
                let q = wp_path_point(path, k)
                t.path.x[k] = q.x
                t.path.z[k] = q.z
                t.path.y = q.y
            }
            t.period = p.period as s32
            t.offset = p.offset as s32
            t.arrive = p.arrive as s32
            t.dwell = p.dwell as s32
            t.leave = p.leave as s32
            t.stop = p.stop
            t.cars = min(p.cars as s32, MAX_CARS)
            t.car_len = p.car_length
            t.width = p.width
            t.doors = p.doors as s32
            t.door_w = p.door_width
            t.left = p.sides != AfterhoursTrainSides.Right
            t.right = p.sides != AfterhoursTrainSides.Left
        } else if ty == AFTERHOURS_TYPE_HIDE_SPOT {
            let p = prm as *AfterhoursHideSpot
            room_spot(box2(pos.x, pos.z, p.size.x, p.size.y, p.size.z, e.yaw, false, false))
        } else if ty == AFTERHOURS_TYPE_FRAGILE {
            let p = prm as *AfterhoursFragile
            room_fragile(pos.x, pos.z, p.radius, p.noise)
        } else if ty == AFTERHOURS_TYPE_WALL {
            let p = prm as *AfterhoursWall
            room_wall(box2(pos.x, pos.z, p.size.x, p.size.y, p.size.z, e.yaw, p.blocks, p.solid))
        } else if ty == AFTERHOURS_TYPE_DOOR {
            let p = prm as *AfterhoursDoor
            var to_room = -1
            var to_door = -1
            var to_key = -1
            if p.to != 0xFFFFFFFF {
                to_key = p.to as s32
                to_room = room_of_entity(to_key)
                if to_room >= 0 { to_door = door_index(to_key, to_room) }
            }
            let i = room_door(box2(pos.x, pos.z, p.size.x, p.size.y, p.size.z, e.yaw, true, true),
                              p.card as s32, to_room, to_door, p.end, n, to_key)
            if p.spawn != 0xFFFFFFFF {
                let sp = wp_entity(p.spawn as s32)
                let spos = wp_entity_pos(sp)
                door_in(i, spos.x, spos.z, deg((wp_entity_params(sp) as *AfterhoursSpawn).yaw))
            }
        } else if ty == AFTERHOURS_TYPE_KEYCARD {
            let p = prm as *AfterhoursKeycard
            room_card(pos.x, pos.z, p.colour as s32 + 1, n)
        }
    }
    room_finish()
    return true
}

// The world drawn from the game's camera (replaces dr_view.akr's weak default): the near pass
// only, out past the room's far side; the cart's own meshes are then drawn round its origin.
fn world_draw(eye: vec3, yaw: fixed, pitch: fixed) {
    camera_fov(CAM_FOV)
    wp_clip_near = CAM_DIST - 14.0
    wp_near_far = CAM_DIST + 14.0
    wp_far_ring = 0
    wp_draw(eye, yaw, pitch)
    view_origin = wp_view_origin()
}
