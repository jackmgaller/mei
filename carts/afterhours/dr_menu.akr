// The title, the stage select and the stage's end (agent E). All three are the dark void with a
// stage's section as a small lit model (dr_section.akr), turning slowly:
//
// - the title: the first stage's model, every room lit, the name, PRESS START;
// - the stage select: the stages down the left; the hovered one's model on the right (a locked
//   stage a silhouette), its rooms lit as the save has them cleared, the route traced through
//   the cleared ones, each room's best time and the stage's best total; A plays it, B goes back;
// - the stage's end (the rank): the stage's model with the whole route, each room's time and
//   restarts, the total, the new bests and what the stage unlocked; A goes to the select.
//
// The stages are A's levels, in order (dr_levels.akr): stage n is level n. Gate 1's platform is
// the last (stage_def()).

struct StageDef {
    name: *u8          // the stage select's line
    place: *u8         // a line under it
    level: s32         // A's level (dr_levels.akr): the stage's place in the list
    save: s32          // its save slot (dr_save.akr): fixed, whatever the order
    names: s32         // its rooms' names: ROOM_NAMES from here, one a room (-1: none)
}

// Every stage the select knows, each at A's level for it (dr_levels.akr's constants), so the
// list's order is A's: the station, the tower, the aquarium (J's), the store, the platform. A new
// stage is a row here with a save slot of its own. The names are placeholders (the game's title
// and stage names are open). `names`: the rooms' names in ROOM_NAMES when the world gives none
// (each room's `name`, as the_last_train, is used first).
const STAGES: [5]StageDef = [
    StageDef { name: "THE STATION", place: "The last train's platform, the gates, the passage", level: STAGE_STATION, save: 0, names: 0 },
    StageDef { name: "THE TOWER", place: "The lobby, the trading floor, up to the roof", level: STAGE_TOWER, save: 1, names: -1 },
    StageDef { name: "THE AQUARIUM", place: "The galleries, back of house, the tank tops", level: STAGE_AQUARIUM, save: 2, names: -1 },
    StageDef { name: "AFTER CLOSING", place: "The store and the cinema, keycards and back again", level: STAGE_STORE, save: 3, names: -1 },
    StageDef { name: "THE WAY HOME", place: "The station's platform, the long way round", level: PLATFORM_LEVEL, save: 4, names: 5 },
]
const ROOM_NAMES: [6]*u8 = ["THE LAST TRAIN", "THE TICKET GATES", "THE PASSAGE", "THE LOBBY",
                            "THE AQUARIUM", "THE PLATFORM"]
const STAGE_N = LEVELS
const PLATFORM_STAGE = PLATFORM_LEVEL  // Gate 1's platform: the last stage

// Stage n's row (n is A's level).
fn stage_def(n: s32) -> *StageDef {
    for i in 0..len(STAGES) {
        if STAGES[i].level == n { return &STAGES[i] }
    }
    return &STAGES[0]
}

// Stage n's save slot, its progress, and the save calls by stage.
fn stage_slot(n: s32) -> s32 { return stage_def(n).save }
fn stage_save(n: s32) -> *StageSave { return &save.stages[stage_slot(n)] }
fn stage_unlocked(n: s32) -> bool { return n == 0 || slot_unlocked(stage_slot(n)) }
fn stage_cleared(n: s32) -> bool { return slot_cleared(stage_slot(n)) }
fn stage_room(n: s32, k: s32, ticks: s32) -> bool { return save_room(stage_slot(n), k, ticks) }
fn stage_room_cleared(n: s32, k: s32) { save_room_cleared(stage_slot(n), k) }

// Stage n ended (save_stage()'s bits): the stage after it in the list is unlocked.
fn stage_end(n: s32, total_ticks: s32, restarts_n: s32) -> s32 {
    var next = -1
    if n + 1 < STAGE_N { next = stage_slot(n + 1) }
    return save_stage(stage_slot(n), total_ticks, restarts_n, next)
}

const COL_TEXT = 0xEEE6E0          // rgb(224, 230, 238)
const COL_DIM = 0x8C7A6E           // rgb(110, 122, 140)
const COL_FAINT = 0x5A4C44         // rgb(68, 76, 90)
const COL_WARM = 0xB4E6FF          // rgb(255, 230, 180)
const COL_ORANGE = 0x2080FF        // rgb(255, 128, 32): the thief's colour
const COL_LOCK = 0x6E5A50          // rgb(80, 90, 110)

var scr_t: s32                     // frames on this screen
var sel: s32                       // the stage hovered
var shown: s32 = -1                // the stage whose world is open for the model
var shown_lit: u32                 // its rooms lit
var go_t: s32 = -1                 // frames since a stage was picked (the fade out), -1 none
var fade_in: s32                   // frames of the fade in left (the first room)
var end_flags: s32                 // the stage's end: save_stage()'s bits
var end_stage: s32
var end_best: [SAVE_ROOMS]bool     // the rooms whose time is a new best
var menu_buf: [80]u8
var frames_n: s32                  // frames since boot (the models' turn)

fn menu_init() {
    font_load(FONT_TITLE)
    font_load(FONT_HEAD)
}

var name_buf: [40]u8

// Room k's name in capitals: the open world's (section_read(): the_last_train becomes THE LAST
// TRAIN), else from ROOM_NAMES. The result lasts until the next call.
fn room_name(stage: s32, k: s32) -> *u8 {
    if k >= 0 && k < sec_n && sec[k].name[0] != 0 {
        let src = sec[k].name
        var i = 0
        while i < len(name_buf) - 1 && src[i] != 0 {
            var c = src[i] as s32
            if c == '_' { c = ' ' }
            if c >= 'a' && c <= 'z' { c = c - 32 }
            name_buf[i] = c as u8
            i += 1
        }
        name_buf[i] = 0
        return &name_buf[0]
    }
    let first = stage_def(stage).names
    if first < 0 { return "" }
    let i = first + k
    if i < 0 || i >= len(ROOM_NAMES) { return "" }
    return ROOM_NAMES[i]
}

// The section of stage n, open for drawing: its world (A's level_open_n), its rooms, their
// lights (lit: bit k, room k).
fn menu_show(n: s32, lit: u32) {
    if shown != n {
        assert(world_show(n), "a stage's world did not open")
        section_read()
        shown = n
        shown_lit = 0xFFFFFFFF
    }
    show_textures()
    let pal = section_lights_for(lit)
    if shown_lit != pal {
        section_lights(pal)
        shown_lit = pal
    }
}

// Opens stage n's world to draw its model, without entering a region (A's level_open_bare(): the
// pack, its palette swatch and every region's palettes). The kit's stand-ins draw
// palette-backed far colours, so they need no textures; copying a region's texture set (up to
// eight 32 KB slots, about 56,000 cycles each) is what made the select's frames heavy. A world of
// one region with textures and no stand-ins (its model draws its placements) gets its textures
// one a frame (show_textures()), its model held back until they are in. stage_start() opens the
// world again in full (A's level_switch()).
var show_region: s32 = -1      // the region whose textures show_textures() is copying (-1: none)
var show_tex: s32

fn world_show(n: s32) -> bool {
    if !level_open_bare(stage_def(n).level) { return false }
    wp_region_loaded = -1
    show_region = -1
    show_tex = 0
    if wp_region_count() == 1 && wp_region(0).texture_count > 0 {
        var standins = true
        for i in 0..wp_pack.w as s32 * wp_pack.h as s32 {
            let c = wp_cell(wp_pack.i0 as s32 + i % wp_pack.w as s32, wp_pack.j0 as s32 + i / wp_pack.w as s32)
            if c != null && c.standin_off == 0 { standins = false }
        }
        if !standins { show_region = 0 }
    }
    return true
}

// One texture a frame of the shown world's, when its model needs them.
fn show_textures() {
    if show_region < 0 { return }
    if show_tex < wp_region(show_region).texture_count as s32 {
        wp_texture_load(show_region, show_tex)
        show_tex += 1
    }
}

// Whether the shown world's model can be drawn (its textures in, when it needs them).
fn show_ready() -> bool { return show_region < 0 || show_tex >= wp_region(show_region).texture_count as s32 }

// The rooms of stage s the save has cleared, as a mask.
fn saved_lit(s: s32) -> u32 { return stage_save(s).rooms }

// The model's slow turn: about 26 degrees either side of the front, over 14 s.
fn menu_yaw() -> fixed { return sin(fixed(frames_n % 840) * (TAU / 840)) * 0.45 }

fn text_c(x: s32, y: s32, s: *u8, col: u32) { let _ = font_text_align(x, y, s, col, ALIGN_CENTRE) }

fn fade_cover(k: s32) {
    if k <= 0 { return }
    let v = clamp(k, 0, 255)
    rect_blend(0, 0, 320, 240, rgb(v, v, v), BLEND_SUB)
}

fn saving_mark() {
    font_use(null)
    if save_writing {
        let _ = font_text_align(304, 226, "SAVING", COL_FAINT, ALIGN_RIGHT)
    } else if !card_present(1) && mode != Mode.Transition {
        let _ = font_text_align(304, 226, "NO MEMORY CARD", COL_FAINT, ALIGN_RIGHT)
    }
}

// ---- the title

fn title_begin() {
    game_mode(Mode.Title)
    au_ambience(AMB_NONE)
    scr_t = 0
    go_t = -1
}

fn title_update(press: u32) {
    scr_t += 1
    if scr_t > 12 && press & (START | A) != 0 {
        au_menu_ok()
        select_begin(sel)
    }
}

fn title_draw() {
    cls(VOID)
    menu_show(0, 0xFFFFFFFF)
    if show_ready() { section_view(160, 146, 270, menu_yaw(), -0.55, false, false, 0xFFFFFFFF) }
    font_use(FONT_TITLE)
    text_c(160, 26, "AFTER HOURS", COL_WARM)
    font_use(FONT_HEAD)
    text_c(160, 62, "TOKYO  1990", COL_DIM)
    if (scr_t / 30) % 3 != 2 { text_c(160, 212, "PRESS START", COL_TEXT) }
    font_use(null)
    saving_mark()
    fade_cover(255 - scr_t * 8)
}

// ---- the stage select

fn select_begin(n: s32) {
    game_mode(Mode.Select)
    au_ambience(AMB_NONE)
    sel = clamp(n, 0, STAGE_N - 1)
    scr_t = 0
    go_t = -1
}

fn select_update(pad: u32, press: u32) {
    scr_t += 1
    if go_t >= 0 {
        // the fade out: the stage's world opened (stage_prepare(), A's, on the press) and its
        // first room's textures copied a frame each, so that the start's frame does not
        let ready = stage_prepare_step()
        go_t += 1
        if (go_t >= 14 && ready) || go_t >= 40 { play_stage(sel) }
        return
    }
    if press & UP != 0 && sel > 0 {
        sel -= 1
        au_menu_move()
    } else if press & DOWN != 0 && sel + 1 < STAGE_N {
        sel += 1
        au_menu_move()
    } else if press & (A | START) != 0 {
        // L and R held: a locked stage starts too (playtesting; the save is not changed)
        if stage_unlocked(sel) || pad & (L | R) == (L | R) {
            au_menu_ok()
            go_t = 0
            stage_prepare(stage_def(sel).level)
            shown = sel            // the same world, open again (bare): the model keeps its rooms
        } else {
            au_menu_deny()
        }
    } else if press & B != 0 {
        au_menu_back()
        title_begin()
    }
    let _ = pad
}

// Plays stage n from its first room, in control, fading in.
fn play_stage(n: s32) {
    go_t = -1
    shown = -1
    gpu_fog_off()
    stage_start(stage_def(n).level)
    fade_in = 20
}

fn select_draw() {
    cls(VOID)
    let locked = !stage_unlocked(sel)
    let lit = saved_lit(sel)
    menu_show(sel, if_u(locked, 0xFFFFFFFF, lit))
    if show_ready() { section_view(234, 84, 150, menu_yaw(), -0.6, true, locked, lit) }
    font_use(FONT_HEAD)
    let _ = font_text(16, 10, "SELECT STAGE", COL_DIM)
    // the stages
    for i in 0..STAGE_N {
        let y = 28 + i * 22
        let open = stage_unlocked(i)
        let b = &menu_buf[0]
        str_copy(b, 80, "")
        str_append_int(b, 80, i + 1, 0, false)
        str_append(b, 80, "   ")
        if open { str_append(b, 80, stage_def(i).name) } else { str_append(b, 80, "LOCKED") }
        var col = COL_DIM
        if !open { col = COL_LOCK }
        if i == sel {
            rect(10, y + 1, 2, 20, COL_ORANGE)
            col = if_u(open, COL_TEXT, COL_DIM)
        }
        font_use(FONT_HEAD)
        let _ = font_text(18, y, b, col)
        font_use(null)
        str_copy(b, 80, "")
        if !open {
            str_append(b, 80, "Clear stage ")
            str_append_int(b, 80, i, 0, false)
            str_append(b, 80, " to open")
        } else if stage_cleared(i) {
            str_append(b, 80, "Best ")
            str_append_ticks(b, 80, stage_save(i).best_total)
            str_append(b, 80, "  restarts ")
            str_append_int(b, 80, stage_save(i).best_restarts, 0, false)
        } else {
            str_append(b, 80, "Not cleared yet")
        }
        let _ = font_text(31, y + 12, b, if_u(i == sel, COL_DIM, COL_FAINT))
    }
    // the hovered stage's rooms, in two columns under the model: lit when cleared, with their
    // best times
    if !locked {
        font_use(null)
        let _ = font_text(16, 146, stage_def(sel).place, COL_FAINT)
        rect(16, 158, 288, 1, COL_FAINT)
        let half = (sec_n + 1) / 2
        for k in 0..sec_n {
            let x = if_s(k < half, 16, 170)
            let y = 164 + (k % half) * 11
            let done = (lit >> k as u32) & 1 != 0
            rect(x, y + 2, 4, 4, if_u(done, COL_ORANGE, COL_FAINT))
            let _ = font_text(x + 9, y, room_name(sel, k), if_u(done, COL_TEXT, COL_DIM))
            let b = &menu_buf[0]
            str_copy(b, 80, "")
            let t = stage_save(sel).room_best[k]
            if t > 0 { str_append_ticks(b, 80, t) } else { str_append(b, 80, "-") }
            let _ = font_text_align(x + 134, y, b, if_u(done, COL_WARM, COL_FAINT), ALIGN_RIGHT)
        }
    }
    font_use(FONT_HEAD)
    let _ = font_text(16, 222, "A  PLAY     B  TITLE", COL_FAINT)
    font_use(null)
    saving_mark()
    fade_cover(go_t * 20)
}

fn if_s(c: bool, a: s32, b: s32) -> s32 {
    if c { return a }
    return b
}

fn if_u(c: bool, a: u32, b: u32) -> u32 {
    if c { return a }
    return b
}

// ---- the stage's end: the rank

// The stage's last room is cleared (Ev.StageClear): the save, and the end screen.
fn end_begin() {
    end_stage = clamp(stage_of(), 0, STAGE_N - 1)
    // a stage of doors: each room's time over its visits is its best for the save (a stage of
    // rooms in a line saved each room's as it was left)
    if exit_door != EXIT_LINE && exit_door >= 0 {
        for k in 0..min(run_length, SAVE_ROOMS) {
            if (run_visited >> k as u32) & 1 != 0 && room_time[k] > 0 { let _ = stage_room(end_stage, k, room_time[k]) }
        }
    }
    end_flags = stage_end(end_stage, total, run_restarts())
    section_read()
    show_region = -1               // the stage's own world, open in full
    shown = end_stage
    shown_lit = 0xFFFFFFFF
    section_lights(0xFFFFFFFF)
    scr_t = 0
}

fn end_update(press: u32) {
    scr_t += 1
    if scr_t > 30 && press & (A | START) != 0 {
        au_menu_ok()
        var next = end_stage
        if end_flags & 4 != 0 { next = end_stage + 1 }
        select_begin(next)
    }
}

fn end_draw() {
    cls(VOID)
    section_view(160, 80, 210, menu_yaw() * 0.6, -0.5, true, false, 0xFFFFFFFF)
    font_use(FONT_TITLE)
    text_c(160, 8, "STAGE CLEAR", COL_WARM)
    let n = run_length
    let y0 = 156 - n * 6
    font_use(null)
    let b = &menu_buf[0]
    for k in 0..n {
        let y = y0 + k * 11
        str_copy(b, 80, "")
        str_append_int(b, 80, k + 1, 0, false)
        str_append(b, 80, "  ")
        str_append(b, 80, room_name(end_stage, k))
        let _ = font_text(56, y, b, COL_TEXT)
        str_copy(b, 80, "")
        str_append_ticks(b, 80, room_time[k])
        let _ = font_text_align(222, y, b, COL_WARM, ALIGN_RIGHT)
        str_copy(b, 80, "")
        str_append_int(b, 80, room_restarts[k], 0, false)
        let _ = font_text_align(272, y, b, COL_DIM, ALIGN_RIGHT)
        if room_time[k] == stage_save(end_stage).room_best[k] && stage_save(end_stage).runs > 1 {
            rect(48, y + 2, 4, 4, COL_ORANGE)
        }
    }
    let _ = font_text_align(222, y0 - 12, "TIME", COL_FAINT, ALIGN_RIGHT)
    let _ = font_text_align(272, y0 - 12, "RESTARTS", COL_FAINT, ALIGN_RIGHT)
    let yt = y0 + n * 11 + 6
    rect(56, yt - 3, 216, 1, COL_FAINT)
    font_use(FONT_HEAD)
    let _ = font_text(56, yt, "TOTAL", COL_TEXT)
    str_copy(b, 80, "")
    str_append_ticks(b, 80, total)
    let _ = font_text_align(222, yt, b, COL_WARM, ALIGN_RIGHT)
    str_copy(b, 80, "")
    str_append_int(b, 80, run_restarts(), 0, false)
    let _ = font_text_align(272, yt, b, COL_DIM, ALIGN_RIGHT)
    var y = yt + 18
    if end_flags & 1 != 0 && stage_save(end_stage).runs > 1 {
        text_c(160, y, "NEW BEST TIME", COL_ORANGE)
        y += 14
    }
    if end_flags & 4 != 0 {
        str_copy(b, 80, "STAGE ")
        str_append_int(b, 80, end_stage + 2, 0, false)
        str_append(b, 80, " OPEN: ")
        str_append(b, 80, stage_def(end_stage + 1).name)
        text_c(160, y, b, COL_TEXT)
    }
    if scr_t > 30 { let _ = font_text(16, 222, "A  CONTINUE", COL_FAINT) }
    font_use(null)
    saving_mark()
    fade_cover(255 - scr_t * 10)
}

// ---- the transition's caption: the next room's number and name (dr_trans.akr)

fn trans_caption(k: s32, alpha: s32) {
    let st = clamp(stage_of(), 0, STAGE_N - 1)
    let b = &menu_buf[0]
    str_copy(b, 80, "ROOM ")
    str_append_int(b, 80, k + 1, 0, false)
    font_use(null)
    let a = fixed(alpha) / 255
    text_c(160, 196, b, col_scale(COL_DIM, a))
    font_use(FONT_HEAD)
    text_c(160, 207, room_name(st, k), col_scale(COL_TEXT, a))
    font_use(null)
}
