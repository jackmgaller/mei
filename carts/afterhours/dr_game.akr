// The frame loop: the run of rooms, the room clock, the attempt, the caught freeze and the
// restart, the exit into the next room, the run's end. The entry point (afterhours.akr) supplies the
// input hooks; the test harness replaces them.
//
// A run is the rooms the loader gives, numbered in order (room_load_n(0), (1), ...). In level 1
// and the platform going through a room's exit loads the next one with its clock at 0. In a
// stage of doors (stage 2) each door leads to a door of another room, whose clock starts at 0
// with the thief at that door, whichever way he came and however often; caught, he starts again
// at the door he came in by (dr_keys.akr: the cards and the staff doors). A restart stays in the
// room; after the stage's end the run's end shows each room's time and restarts (every visit's)
// and the run's total (DESIGN.md, "Level 1"). The run's total counts every attempt.
//
// One tick a frame. A tick runs, in order: the trains (at the clock), the thief (his input),
// the tools, the guards (routes, hearing), the fans, the test. The frame then draws that state,
// so the fans drawn are the fans the thief was tested against.
import "depth.akr"
import "dr_hooks.akr"          // the hooks E (front end) and F (audio) build on
import "dr_mesh.akr"
import "dr_room.akr"
import "dr_sight.akr"
import "dr_train.akr"
import "dr_watch.akr"
import "dr_thief.akr"
import "dr_tape.akr"
import "dr_standin.akr"
import "dr_view.akr"
import "dr_keys.akr"

const FREEZE = 20              // ticks the game stops when the thief is seen

enum Phase: u8 { Play, Caught, Clear }     // Clear: the run is over (its end is shown)

const MAX_RUN = 8              // rooms in a run

enum Why: u8 { None, Seen, Touched, Doors }

var phase: Phase
var clock: s32                 // the room clock: ticks since the door (this attempt)
var freeze: s32
var restarts: s32              // in this room
var total: s32                 // ticks over every attempt of the run (the rank's time)
var run_room: s32              // the room of the run being played (0 first)
var room_time: [MAX_RUN]s32    // each cleared room: the clearing attempt's ticks
var room_restarts: [MAX_RUN]s32
var room_spent: [MAX_RUN]s32   // each room: ticks over all its attempts
var room_entered: s32          // `total` when this room was entered
var next_room: bool            // the thief went through the exit this tick
var standin_run: s32           // (the tests) a run of this many stand-in rooms instead of the loader's
var catcher: s32               // the watcher who caught him (-1: a train's doors)
var why: Why
var caught_at: s32             // the clock of the catch
var caught_n: s32              // catches so far (the tests)
var cleared_n: s32
var frame_n: s32               // update() calls
var raw_prev: u32              // the pad of the frame before (START, and A on the clear line)
var tick_prev: u32             // the pad of the tick before (this attempt's presses)
var tick_cycles: s32           // cycles the last tick took
var room_cycles: s32           // cycles the last update() took
var test_no_catch: bool        // (the tests) cones, guards and doors catch nobody
var mode: Mode = Mode.Play     // dr_hooks.akr: A plays the rooms in Play; E owns the others
var trans_to: s32 = -1         // in a transition: the room it leads to
var trans_ready: bool          // ... and it is loaded, at its clock 0, not running
var ghost_stage: s32           // the stage the ghosts (bests) were recorded on
var sim_quiet: bool            // events are not sent (a room set up again at its clock 0)
var entry_door: s32 = -1       // the door of this room he came in by (-1: the room's entry)
var exit_door: s32 = -1        // the way out he took (a door, EXIT_LINE)
var exit_to_room: s32 = -2     // where it leads: a room, -1 the stage's end (-2: not leaving)
var exit_to_door: s32 = -1     // ... and the door of that room he comes in by
var trans_door: s32 = -1       // in a transition: the door of trans_to he comes in by
var run_visited: u32           // the rooms he has been in this run (bit k)
var run_cleared: u32           // the rooms he has left by a way out this run
var spent_before: s32          // room_spent of this room before this visit
var visits: s32                // rooms entered this run (the tests)
var load_cycles: s32           // the last room_load_n()'s cycles (the tests)

fn init() {
    render_depth(true)
    render_perspective(true)
    view_init()
    run_start()
    fe_start()
    test_init()
}

// Each tick after the guards: what a stage's rooms do beyond the rules (dr_world.akr replaces it:
// the tower roof's searchlight's sound).
weak fn stage_tick() {}

// Whether stage n's world was opened by stage_prepare() (dr_world.akr replaces it).
weak fn stage_prepared(_n: s32) -> bool { return false }

// The stage (level) being played (dr_world.akr replaces it).
weak fn stage_of() -> s32 { return 0 }

// ---- for E (dr_hooks.akr): moving the game on

// Sets the mode (E: Title, Select, End; Play only through stage_start or transition_control).
fn game_mode(m: Mode) { mode = m }

// Starts stage n from its first room, in control (Mode.Play). Its world is opened again (the
// stage select may have opened another to draw it), unless stage_prepare(n) opened it and
// stage_prepare_step() copied its first room's textures over the frames before (dr_world.akr);
// the ghosts are forgotten when n is not the stage they were recorded on.
fn stage_start(n: s32) {
    if standin_run == 0 {
        if !stage_prepared(n) { assert(level_switch(n), "no such stage") }
        if n != ghost_stage {
            ghosts_clear()
            ghost_stage = n
        }
    }
    mode = Mode.Play
    run_start()
}

// In a transition: loads the next room and sets it at its clock 0, not running (E may draw it
// now). Once; transition_control() does it if E did not.
fn transition_ready() {
    while !transition_ready_step() {}
}

// The same a piece at a time, for a transition that spreads the load over frames (H's
// tr_load_piece() calls it once a frame): ready_piece says how many are done. 0: the room's
// entities (room_load_n()); 1: its doors and sight segments; 2: its framing; 3: the entry at
// clock 0 (Ev.RoomReady). True when the room is ready (and on every call after, and outside a
// transition).
var ready_piece: s32           // pieces of the transition's room load done
fn transition_ready_step() -> bool {
    if mode != Mode.Transition || trans_ready { return true }
    if ready_piece < 3 {
        assert(load_room_piece(trans_to, ready_piece), "the next room did not load")
        ready_piece += 1
        return false
    }
    entry_door = trans_door
    enter_room()
    ready_piece = 4
    trans_ready = true
    event(Ev.RoomReady, run_room)
    return true
}

// Ends the transition: the next room is played from its clock 0, the thief in control.
fn transition_control() {
    if mode != Mode.Transition { return }
    transition_ready()
    mode = Mode.Play
    trans_to = -1
    trans_door = -1
    trans_ready = false
    event(Ev.RoomEnter, run_room)
}

// The thief went through the exit or a door: the room it leads to (at once, or through E's
// transition), or the stage's end (Mode.End with E; A's end line without). What he took and
// opened in the room is the run's now.
fn room_exit() {
    keys_commit()
    run_cleared = run_cleared | ((1 as u32) << run_room as u32)
    exit_to_door = -1
    if exit_door == EXIT_LINE || exit_door < 0 {
        exit_to_room = -1
        if run_room + 1 < run_length { exit_to_room = run_room + 1 }
    } else {
        let d = &room.doors[exit_door]
        exit_to_room = d.to_room
        exit_to_door = d.to_door
        if d.end { exit_to_room = -1 }
    }
    event(Ev.RoomExit, run_room)
    au_exit()
    if exit_to_room < 0 {
        phase = Phase.Clear
        event(Ev.StageClear, stage_of())
        au_clear()
        if fe_owns_transition() { mode = Mode.End }
        return
    }
    if fe_owns_transition() {
        mode = Mode.Transition
        trans_to = exit_to_room
        trans_door = exit_to_door
        trans_ready = false
        ready_piece = 0
        return
    }
    assert(load_room(exit_to_room), "the next room did not load")
    entry_door = exit_to_door
    enter_room()
    event(Ev.RoomEnter, run_room)
}

// Room k of the run: B's world when it is in (dr_world.akr replaces this), else one stand-in
// room. False when the run has no room k.
weak fn room_load_n(k: s32) -> bool {
    if k > 0 { return false }
    standin_load()
    return true
}

// Opens another level for the next run (dr_world.akr replaces it; -1: the next level). False:
// there are no levels, the run plays again.
weak fn level_switch(_n: s32) -> bool { return false }

// How many rooms the run has (dr_world.akr replaces it).
weak fn room_count() -> s32 { return 1 }

// Loads room k of the run (false: there is none); its best attempt becomes the ghost.
fn load_room(k: s32) -> bool {
    for p in 0..3 {
        if !load_room_piece(k, p) { return false }
    }
    return true
}

// Loading room k in three pieces (transition_ready_step() spreads them over frames): 0 its
// entities (the loader), 1 its doors and sight segments, 2 its framing.
fn load_room_piece(k: s32, piece: s32) -> bool {
    if piece == 1 {
        doors_setup()
        room_segs()
        return true
    }
    if piece == 2 {
        view_init_room()
        return true
    }
    if k >= MAX_RUN { return false }
    var ok = false
    if standin_aqua {
        ok = k < STANDIN_AQUA_ROOMS
        if ok { standin_aqua_load(k) }
        run_length = STANDIN_AQUA_ROOMS
    } else if standin_graph {
        ok = k < STANDIN_GRAPH_ROOMS
        if ok { standin_graph_load(k) }
        run_length = STANDIN_GRAPH_ROOMS
    } else if standin_run > 0 {
        ok = k < standin_run
        if ok { standin_load() }
        run_length = standin_run
    } else {
        let c0 = cycle_count()
        ok = room_load_n(k)
        load_cycles = cycle_count() - c0
        run_length = room_count()
    }
    if !ok { return false }
    run_room = k
    return true
}

// Whether the way out he took leads to another room (at Ev.RoomExit); before he leaves, whether
// the room has a way to another.
var run_length: s32 = 1        // the run's rooms (the loader's count)
var standin_graph: bool        // (the tests) the stand-in rooms of doors instead of the loader's
var standin_aqua: bool         // (the tests) the stand-in aquarium rooms (dark, two levels)
fn room_load_more() -> bool {
    if exit_to_room > -2 { return exit_to_room >= 0 }
    if room.ndoors == 0 { return run_room + 1 < run_length }
    for i in 0..room.ndoors {
        if room.doors[i].to_room >= 0 { return true }
    }
    return false
}

// The run from its first room.
fn run_start() {
    keys_reset()
    run_visited = 0
    run_cleared = 0
    visits = 0
    entry_door = -1
    assert(load_room(0), "the run has no first room")
    total = 0
    for k in 0..MAX_RUN {
        room_time[k] = 0
        room_restarts[k] = 0
        room_spent[k] = 0
    }
    event(Ev.StageStart, stage_of())
    au_music(true)
    enter_room()
    event(Ev.RoomEnter, 0)
}

// A room entered (the first of a run, or the next through its exit or a transition): its clock
// at 0, its restarts 0, its ambience. (Ev.RoomEnter follows when the thief is in control.)
fn enter_room() {
    restarts = 0
    room_entered = total
    spent_before = room_spent[run_room]
    exit_to_room = -2
    exit_door = -1
    if entry_door >= 0 && entry_door < room.ndoors && room.doors[entry_door].way_in {
        let d = &room.doors[entry_door]
        room.spawn_x = d.sx
        room.spawn_z = d.sz
        room.spawn_head = d.sh
        room.spawn_level = d.box.level
    } else {
        entry_door = -1
    }
    best = ghost_for(run_room, entry_door)
    run_visited = run_visited | ((1 as u32) << run_room as u32)
    visits += 1
    restart_attempt()
    au_room(room_amb())
}

// The room's ambience for au_room(): the stage's (stage_amb(), dr_world.akr); 0 for a stand-in
// room.
fn room_amb() -> s32 {
    if !room_is_world { return 0 }
    return stage_amb(run_room)
}

// Room k's ambience in the stage being played (dr_world.akr replaces it).
weak fn stage_amb(_k: s32) -> s32 { return 1 }

// Whether the stage's rooms join by doors (stage 2; dr_world.akr replaces it).
weak fn stage_has_doors() -> bool { return false }

// The room again from its clock 0 at the door he came in by, as a restart (START without E's
// pause, SELECT, or E's pause menu's "Restart room"): the attempt ends (kept as the ghost if it
// is the best), one restart counted.
fn room_restart() {
    tape_now.caught = false
    tape_end()
    restarts += 1
    restart_attempt()
    au_retry()
    event(Ev.Restart, run_room)
}

fn restart_attempt() {
    phase = Phase.Play
    clock = 0
    freeze = 0
    catcher = -1
    why = Why.None
    tick_prev = 0
    thief_reset()
    doors_reset()
    guards_reset()
    sim_quiet = true
    trains_update(0)
    lights_update(0)
    sim_quiet = false
    guards_sight()
    nnoise = 0
    tape_begin(&tape_now)
    view_restart()
    cones_forget()
    au_restart()
}

fn quantize(v: fixed) -> s32 { return clamp((v * 127) as s32, -127, 127) }

fn update() {
    let c0 = cycle_count()
    water_tick()                   // agent W: the water's tiles (dr_water.akr; a function of frame() only)
    let pad = input_pad(frame_n)
    let st = input_stick(frame_n)
    let press_raw = pad & ~raw_prev
    raw_prev = pad
    test_hook(frame_n)
    if mode != Mode.Play {
        fe_update(pad, press_raw)
        frame_n += 1
        au_tick()
        room_cycles = cycle_count() - c0
        return
    }
    match phase {
        Play => {
            if press_raw & START != 0 && fe_pause() {
                // E opened its pause menu (Mode.Pause): nothing ticks until it resumes
            } else if press_raw & (START | SELECT) != 0 {
                room_restart()
            } else {
                var inp = Input { pad: pad & ~(START | SELECT), sx: quantize(st.x), sy: quantize(st.y) }
                inp.press = inp.pad & ~tick_prev
                tick_prev = inp.pad
                tick(&inp)
                if next_room {
                    next_room = false
                    room_exit()
                }
            }
        }
        Caught => {
            freeze -= 1
            if freeze <= 0 {
                restarts += 1
                restart_attempt()
                event(Ev.Restart, run_room)
            }
        }
        Clear => {
            if press_raw & A != 0 {
                if standin_run == 0 && !standin_graph && !standin_aqua && level_switch(-1) {
                    ghosts_clear()
                    ghost_stage = stage_of()
                }
                run_start()
            }
        }
    }
    frame_n += 1
    view_update()
    au_tick()
    room_cycles = cycle_count() - c0
}

fn tick(inp: *Input) {
    let c0 = cycle_count()
    nnoise = 0
    trains_update(clock)
    lights_update(clock)
    thief_update(inp, clock)
    keys_update(clock)
    au_thief(thief.moved, thief.running, thief.x - cam_x)
    for i in 0..room.ntrains {
        au_train(i, trains[i].phase as s32, trains[i].head, train_mid_x(i) - cam_x, trains[i].to_close)
    }
    tools_update(clock)
    for i in 0..room.nwatch { guard_update(i, clock) }
    stage_tick()
    let s0 = cycle_count()
    sight_rays_tested = 0
    guards_sight()
    sight_cycles = cycle_count() - s0
    dash_path_test()               // agent G: a dash's path this tick, tested point by point
    tape_record(&tape_now, inp, thief.x, thief.z)
    tape_now.near = min(tape_now.near, exit_dist())
    total += 1
    // seen (a fan covers his centre), touched, or shut in a train
    var who = -1
    var w = Why.None
    for i in 0..room.nwatch {
        let g = &guards[i]
        g.caught = false
        if w != Why.None { continue }
        if watcher_sees(i, thief.x, thief.z) {
            who = i
            w = Why.Seen
        } else if room.watch[i].kind != WKind.Camera && room.watch[i].level == thief.level {
            let r = THIEF_R + GUARD_R
            if !thief.hidden && dist2(thief.x, thief.z, g.x, g.z) < r * r {
                who = i
                w = Why.Touched
            }
        }
    }
    if w == Why.None && thief.car >= 0 && trains[thief.car / 16].closing { w = Why.Doors }
    if test_no_catch { w = Why.None }
    if w != Why.None {
        if who >= 0 { guards[who].caught = true }
        caught(who, w)
    } else {
        let out = way_out()
        if out >= 0 {
            cleared_n += 1
            tape_now.cleared = true
            tape_end()
            room_time[run_room] += tape_now.ticks
            room_restarts[run_room] += restarts
            exit_door = out
            next_room = true
        }
    }
    room_spent[run_room] = spent_before + total - room_entered
    clock += 1
    tick_cycles = cycle_count() - c0
}

// Whether watcher i sees the thief were his centre at (x, z) this tick: not hidden, on the
// watcher's level, inside the drawn fan, and (a dark-eyed watcher in a dark room) lit.
fn watcher_sees(i: s32, x: fixed, z: fixed) -> bool {
    if thief.hidden || room.watch[i].level != thief.level { return false }
    if !fan_covers(&guards[i].fan, x, z) { return false }
    if dark_eyed(i) && !lit_at(x, z, thief.level) { return false }
    return true
}

// The run's restarts so far (the rooms left, every visit, and this attempt's room).
fn run_restarts() -> s32 {
    var n = 0
    for k in 0..MAX_RUN { n += room_restarts[k] }
    if phase == Phase.Clear { return n }
    return n + restarts
}

fn caught(who: s32, w: Why) {
    phase = Phase.Caught
    freeze = FREEZE
    catcher = who
    why = w
    caught_at = clock
    caught_n += 1
    tape_now.caught = true
    tape_end()
    au_caught()
    event(Ev.Caught, w as s32)
}

// The room being played (Play, Transition, and the stage's end line without E), unless E draws
// the frame itself; then E's front end; A's HUD when E drew none.
fn draw() {
    let in_room = mode == Mode.Play || mode == Mode.Transition || (mode == Mode.End && !fe_owns_transition())
    let shown = in_room && fe_draw_room()
    if shown { view_draw_room() } else { cls(VOID) }
    if !fe_draw() && shown { draw_hud() }
}
