// Stand-in meshes built in RAM (LANGUAGE.md, "Mesh format"): boxes, prisms, fans and rings in
// flat colours. Gate 1 has no art; everything the runtime draws is made here at init, and the
// fans and rings are rebuilt each frame.

// A mesh being built in a buffer of the cart's: the 16-byte header, then cap_v vertices, then
// the faces.
struct MB {
    m: *Mesh
    v: *vec4
    f: *Face
    nv: s32
    nf: s32
    cap_v: s32
    cap_f: s32
}

// words: the buffer's size in u32s; cap_v vertices are reserved, the rest is faces (36 bytes).
fn mb_init(b: *MB, buf: *u32, words: s32, cap_v: s32) {
    b.m = buf as *Mesh
    b.v = (buf as u32 + 16) as *vec4
    b.f = (buf as u32 + 16 + (cap_v * 16) as u32) as *Face
    b.nv = 0
    b.nf = 0
    b.cap_v = cap_v
    b.cap_f = (words * 4 - 16 - cap_v * 16) / 36
    b.m.verts = 16
    b.m.faces = (16 + cap_v * 16) as u32
    b.m.windows = 0
    b.m.nverts = 0
    b.m.nfaces = 0
}

fn mb_reset(b: *MB) {
    b.nv = 0
    b.nf = 0
    b.m.nverts = 0
    b.m.nfaces = 0
}

fn mb_vert(b: *MB, x: fixed, y: fixed, z: fixed) -> s32 {
    assert(b.nv < b.cap_v, "mb_vert: mesh full")
    b.v[b.nv] = vec4(x, y, z, 1.0)
    b.nv += 1
    b.m.nverts = b.nv as u16
    return b.nv - 1
}

fn __mb_face(b: *MB, flags: u32, blend: u32, col: u32) -> *Face {
    assert(b.nf < b.cap_f, "mb face: mesh full")
    let f = &b.f[b.nf]
    b.nf += 1
    b.m.nfaces = b.nf as u16
    f.flags = flags as u8
    f.blend = blend as u8
    f.tex = 0
    f.palette = 0
    f.col[0] = col
    f.col[1] = col
    f.col[2] = col
    f.col[3] = col
    f.uv[0] = 0
    f.uv[1] = 0
    f.uv[2] = 0
    f.uv[3] = 0
    return f
}

// A triangle, counter-clockwise seen from its front. flags: FACE_SEMI, FACE_DOUBLE; blend: a
// BLEND_* mode for semi-transparent faces.
fn mb_tri(b: *MB, i0: s32, i1: s32, i2: s32, col: u32, flags: u32, blend: u32) {
    let f = __mb_face(b, flags, blend, col)
    f.idx[0] = i0 as u16
    f.idx[1] = i1 as u16
    f.idx[2] = i2 as u16
    f.idx[3] = i2 as u16
}

// A quad in strip order seen from its front: bottom-left, bottom-right, top-left, top-right.
fn mb_quad(b: *MB, i0: s32, i1: s32, i2: s32, i3: s32, col: u32, flags: u32, blend: u32) {
    let f = __mb_face(b, flags | FACE_QUAD, blend, col)
    f.idx[0] = i0 as u16
    f.idx[1] = i1 as u16
    f.idx[2] = i2 as u16
    f.idx[3] = i3 as u16
}

// Shading by the side a face looks to: the light comes from the front left, above.
const SHADE_TOP: fixed = 1.0
const SHADE_FRONT: fixed = 0.78
const SHADE_LEFT: fixed = 0.66
const SHADE_RIGHT: fixed = 0.56
const SHADE_BACK: fixed = 0.5

// An axis-aligned box without a bottom.
fn mb_box(b: *MB, x0: fixed, y0: fixed, z0: fixed, x1: fixed, y1: fixed, z1: fixed, col: u32) {
    mb_box_ex(b, x0, y0, z0, x1, y1, z1, col, 0, 0, true)
}

// The same, with face flags and a blend mode, and the top only when `top`.
fn mb_box_ex(b: *MB, x0: fixed, y0: fixed, z0: fixed, x1: fixed, y1: fixed, z1: fixed, col: u32,
             flags: u32, blend: u32, top: bool) {
    let a = mb_vert(b, x0, y0, z0)    // the bottom, then the top: (x0,z0) (x1,z0) (x0,z1) (x1,z1)
    let _ = mb_vert(b, x1, y0, z0)
    let _ = mb_vert(b, x0, y0, z1)
    let _ = mb_vert(b, x1, y0, z1)
    let _ = mb_vert(b, x0, y1, z0)
    let _ = mb_vert(b, x1, y1, z0)
    let _ = mb_vert(b, x0, y1, z1)
    let _ = mb_vert(b, x1, y1, z1)
    if top { mb_quad(b, a + 4, a + 5, a + 6, a + 7, col_scale(col, SHADE_TOP), flags, blend) }
    mb_quad(b, a + 0, a + 1, a + 4, a + 5, col_scale(col, SHADE_FRONT), flags, blend)   // -z
    mb_quad(b, a + 3, a + 2, a + 7, a + 6, col_scale(col, SHADE_BACK), flags, blend)    // +z
    mb_quad(b, a + 1, a + 3, a + 5, a + 7, col_scale(col, SHADE_RIGHT), flags, blend)   // +x
    mb_quad(b, a + 2, a + 0, a + 6, a + 4, col_scale(col, SHADE_LEFT), flags, blend)    // -x
}

// An n-sided prism round the y axis at (cx, cz), radius r, from y0 to y1, with a top.
fn mb_prism(b: *MB, cx: fixed, cz: fixed, r: fixed, y0: fixed, y1: fixed, n: s32, col: u32) {
    let first = b.nv
    for k in 0..n {
        let a = TAU * k / n
        let x = cx + r * sin(a)
        let z = cz + r * cos(a)
        let _ = mb_vert(b, x, y0, z)
        let _ = mb_vert(b, x, y1, z)
    }
    let c = mb_vert(b, cx, y1, cz)
    for k in 0..n {
        let k1 = (k + 1) % n
        let lo0 = first + 2 * k
        let lo1 = first + 2 * k1
        // the side's shade by the way it faces: (sin a, cos a) at its middle
        let a = TAU * (2 * k + 1) / (2 * n)
        let nx = sin(a)
        let nz = cos(a)
        var shade = SHADE_FRONT
        if nz > 0.5 { shade = SHADE_BACK } else if nx > 0.5 { shade = SHADE_RIGHT } else if nx < -0.5 { shade = SHADE_LEFT }
        mb_quad(b, lo1, lo0, lo1 + 1, lo0 + 1, col_scale(col, shade), 0, 0)
        mb_tri(b, c, lo1 + 1, lo0 + 1, col, 0, 0)
    }
}

// A flat ring (annulus) round (0, y, 0) from radius r0 to r1, n segments, semi-transparent.
fn mb_ring_build(b: *MB, r0: fixed, r1: fixed, y: fixed, n: s32, col: u32, blend: u32) {
    let first = b.nv
    for k in 0..n {
        let a = TAU * k / n
        let s = sin(a)
        let c = cos(a)
        let _ = mb_vert(b, r0 * s, y, r0 * c)
        let _ = mb_vert(b, r1 * s, y, r1 * c)
    }
    for k in 0..n {
        let k1 = (k + 1) % n
        let i0 = first + 2 * k
        let i1 = first + 2 * k1
        mb_quad(b, i0, i1, i0 + 1, i1 + 1, col, FACE_SEMI | FACE_DOUBLE, blend)
    }
}
