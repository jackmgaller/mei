// After Hours' scenarios (tests/run.sh SCENARIO FRAMES OUT; tests/check.sh runs them all). Each plays
// a tape (dr_tape.akr's spans, indexed by the room clock, so a restart replays it from its
// start) or drives the pad itself, and checks the rules. A check prints "OK what value"; a failed
// one prints "FAIL what value" and stops the run (exit status 2). A passing run's last line is
// "DONE n: name, k checks".
//
// The rules' scenarios (2-9) run on agent A's stand-in platform (dr_standin.akr), whose numbers
// they know; the solution's (1) on B's room.

import "a_tapes.akr"
import "../dr_world.akr"       // B's room (the cart's own; the rules' scenarios load the stand-in)
import "../dr_audio.akr"       // F's sounds, so the scenarios run the cart's audio calls too
import "tapes/platform_solution.akr"   // B's solution tapes: Gate 1's platform
import "tapes/level1_solution.akr"     // and level 1's, a room each
import "tapes/level2_solution.akr"     // and stage 2's, a leg (a visit to a room) each

const L1_TAPES: [5]*Span = [SOLUTION_L1_ARRIVAL, SOLUTION_L1_GATES, SOLUTION_L1_PASSAGE,
                            SOLUTION_L1_LOBBY, SOLUTION_L1_AQUARIUM]
const L1_LENS: [5]s32 = [len(SOLUTION_L1_ARRIVAL), len(SOLUTION_L1_GATES), len(SOLUTION_L1_PASSAGE),
                         len(SOLUTION_L1_LOBBY), len(SOLUTION_L1_AQUARIUM)]
var test_run: bool             // scenario 46: each room of the run plays its own tape

// ---- the harness as a front end (dr_hooks.akr): every event is counted and the room flow
// logged; with test_fe (scenario 48) the harness runs the transitions as E's does: the exit goes
// to Mode.Transition, transition_ready() at frame 46 (the next room loaded at its clock 0, not
// running), transition_control() at frame 90; the stage's end is Mode.End.
var test_fe: bool
var ev_count: [len(Ev)]s32
var ev_log_e: [64]u8
var ev_log_a: [64]s8
var ev_n: s32
var flow_log: [32]u8           // the room-flow events alone (StageStart .. StageClear), in order
var flow_n: s32
var fe_frames: s32
var fe_trans: s32              // transitions run
var fe_hold_clock_ok: bool = true

fn fe_event(e: Ev, a: s32) {
    ev_count[e] += 1
    if flow_n < 32 && (e == Ev.StageStart || e == Ev.RoomEnter || e == Ev.RoomExit || e == Ev.RoomReady || e == Ev.StageClear) {
        flow_log[flow_n] = e as u8
        flow_n += 1
    }
    if ev_n < 64 && e != Ev.Step && e != Ev.Heard {
        ev_log_e[ev_n] = e as u8
        ev_log_a[ev_n] = a as s8
        ev_n += 1
    }
    if test_fe && e == Ev.RoomEnter {
        always(mode == Mode.Play && clock == 0 && phase == Phase.Play, "in control at the room's clock 0", fixed(clock))
        always(thief.x == room.spawn_x && thief.z == room.spawn_z, "at the room's door", thief.x)
    }
    if e == Ev.RoomExit {
        fe_frames = 0
        if s2_exits <= S2_LEGS {
            s2_exit_door[s2_exits] = exit_door
            s2_exit_room[s2_exits] = run_room
            s2_exit_ticks[s2_exits] = tape_now.ticks
            s2_exits += 1
        }
    }
}

fn fe_owns_transition() -> bool { return test_fe }

fn fe_update(_pad: u32, _press: u32) {
    if !test_fe { return }
    fe_frames += 1
    if mode == Mode.Transition {
        if fe_frames == 46 { transition_ready() }
        if trans_ready && clock != 0 { fe_hold_clock_ok = false }
        if fe_frames == 90 {
            fe_trans += 1
            transition_control()
        }
    }
}

var name: *u8 = "picture"
var checks: s32
var tape: *Span
var tape_n: s32
var tape_on: bool
var pad_v: u32
var stick_v: vec2
var done_at: s32 = -1
var finished: bool
var t0: s32 = -1
var t1: s32 = -1
var t2: s32 = -1
var n0: s32
var n1: s32
var flag0: bool
var flag1: bool
var hashes: [3000]u32          // scenario 3: a hash of the room at each tick of the first attempt
var hash_n: s32
var worst_cpu: s32
var worst_gpu: s32
var worst_sight: s32
var worst_tick: s32
var worst_rays: s32

// ---- the hooks

fn input_pad(f: s32) -> u32 {
    if test_run { play(L1_TAPES[run_room], L1_LENS[run_room]) }
    pad_v = 0
    stick_v = vec2(0.0, 0.0)
    if tape_on && phase == Phase.Play {
        let s = span_at(tape, tape_n, clock)
        pad_v = s.pad as u32
        stick_v = vec2(fixed(s.sx as s32) / 127, fixed(s.sy as s32) / 127)
    }
    scenario(f)
    return pad_v
}

fn input_stick(_f: s32) -> vec2 { return stick_v }

fn play(t: *Span, n: s32) {
    tape = t
    tape_n = n
    tape_on = true
}

fn test_init() {
    match SCENARIO {
        1 => { name = "the solution tape reaches the exit unseen"; platform_run(); play(&SOLUTION_PLATFORM[0], len(SOLUTION_PLATFORM)) }
        14 => { name = "B's second solution (on foot) reaches the exit unseen"; platform_run(); play(&SOLUTION_PLATFORM_ON_FOOT[0], len(SOLUTION_PLATFORM_ON_FOOT)) }
        15 => { name = "B's third solution (the bell) reaches the exit unseen"; platform_run(); play(&SOLUTION_PLATFORM_BELL[0], len(SOLUTION_PLATFORM_BELL)) }
        2 => { name = "walking into a cone: caught on the tick the drawn fan first covers him, restart at the door"; standin(); play(&TAPE_INTO_CONE[0], len(TAPE_INTO_CONE)) }
        3 => { name = "the same tape twice: the same room on every tick"; standin(); test_no_catch = true; play(&TAPE_BUSY[0], len(TAPE_BUSY)) }
        4 => { name = "trains: cone blocking lines up with the drawn cars"; standin(); room.nwatch = 0; restart_attempt() }
        16 => { name = "B's platform: the trains' cone blocking lines up with the drawn cars"; platform_run(); room.nwatch = 0; restart_attempt() }
        17 => { name = "a cone enters a stopped train through its open door, not through its sides"; standin(); room.nwatch = 0; restart_attempt() }
        5 => { name = "hearing: to the noise, look around, back to the route"; standin(); test_no_catch = true; play(&TAPE_RUN[0], len(TAPE_RUN)) }
        6 => { name = "the wind-up toy and the pocket bell"; standin(); test_no_catch = true; play(&TAPE_TOOLS[0], len(TAPE_TOOLS)) }
        7 => { name = "hiding: a cone over the hiding place does not see him"; standin(); play(&TAPE_HIDE[0], len(TAPE_HIDE)) }
        8 => { name = "a stopped train: in at a door, the doors close on him"; standin(); room.nwatch = 0; restart_attempt(); play(&TAPE_TRAIN[0], len(TAPE_TRAIN)) }
        9 => { name = "sight: cut by walls, pillars and trains, not by glass or benches"; standin() }
        10 => { name = "fragile things: one noise, knocked down"; standin(); test_no_catch = true; play(&TAPE_FRAGILE[0], len(TAPE_FRAGILE)) }
        11 => { name = "a run of two rooms: the exit loads the next at clock 0, the run's end, A again with the ghost"; standin_n(2); test_no_catch = true; play(&TAPE_EXIT[0], len(TAPE_EXIT)) }
        12 => { name = "B's platform: walking into a cone, caught on the tick the drawn fan first covers him"; platform_run(); play(&TAPE_INTO_CONE_B[0], len(TAPE_INTO_CONE_B)) }
        13 => { name = "B's platform: the same tape twice, the same room on every tick"; platform_run(); test_no_catch = true; play(&TAPE_TOUR[0], len(TAPE_TOUR)) }
        20 => { name = "shot: a train passing (B's platform)"; platform_run(); test_no_catch = true; play(&TAPE_SHOT_TRAIN[0], len(TAPE_SHOT_TRAIN)) }
        21 => { name = "shot: the camera's cone cut by a pillar (B's platform)"; platform_run(); test_no_catch = true; play(&TAPE_SHOT_PILLAR[0], len(TAPE_SHOT_PILLAR)) }
        22 => { name = "shot: the caught freeze (B's platform)"; platform_run(); play(&TAPE_INTO_CONE_B[0], len(TAPE_INTO_CONE_B)) }
        30 => { name = "budget: the worst frame"; standin(); test_no_catch = true; play(&TAPE_BUSY[0], len(TAPE_BUSY)) }
        31 => { name = "budget: the worst frame on B's platform"; platform_run(); test_no_catch = true; play(&TAPE_TOUR[0], len(TAPE_TOUR)) }
        41, 42, 43, 44, 45 => { name = "level 1: a room's solution tape reaches its exit unseen"; level_room(SCENARIO - 41) }
        47 => { name = "framing: every room's floor, front to back, on the picture clear of the HUD" }
        50, 51, 52, 53, 54 => { name = "shot: a level 1 room's front row"; level_room(SCENARIO - 50); test_no_catch = true; play(&TAPE_FRONT[0], len(TAPE_FRONT)) }
        56 => { name = "shot: hidden in the gates' hiding place"; level_room(1) }
        55 => { name = "shot: the platform's front row"; platform_run(); test_no_catch = true; play(&TAPE_FRONT[0], len(TAPE_FRONT)) }
        46 => { name = "level 1 as one run: five rooms' tapes, the run's totals"; test_run = true }
        48 => { name = "the state flow: level 1 through four transitions run by a front end, its end, the stage again"; test_run = true; test_fe = true; ev_n = 0; for e in Ev { ev_count[e] = 0 }; flow_n = 0; stage_start(0) }
        49 => { name = "events: footsteps, the trains, catches"; platform_run(); test_no_catch = true; ev_n = 0; for e in Ev { ev_count[e] = 0 }; play(&TAPE_SHOT_TRAIN[0], len(TAPE_SHOT_TRAIN)) }
        40 => { name = "B's platform: a tour"; platform_run(); test_no_catch = true; play(&TAPE_TOUR[0], len(TAPE_TOUR)) }
        60 => { name = "stage 2's rules: a keycard, a staff door, re-entry by either door, the run's state across rooms"; graph_run() }
        61 => { name = "stage 2's rules: caught or START, back at the door he came in by, the room as it was"; graph_run() }
        62 => { name = "stage 2's rules through a front end's transitions: any door to any door"; test_fe = true; graph_run() }
        63 => { name = "stage 2 (level2) as one run: B's eight legs in order, the cards and doors carried"; s2_run() }
        64 => { name = "stage 2 (level2) through a front end's transitions: seven, door to door, back and on"; test_fe = true; s2_run() }
        else => {}
    }
}

fn test_hook(_f: s32) {}

// The stand-in rooms of doors (dr_standin.akr) as the run.
fn graph_run() {
    standin_graph = true
    ev_n = 0
    for e in Ev { ev_count[e] = 0 }
    run_start()
}

// Gate 1's platform (the second level) as the run.
fn platform_run() {
    assert(level_switch(PLATFORM_LEVEL), "the platform did not open")
    run_start()
}

// Level 1 from room k (its tape by the room's clock).
fn level_room(k: s32) {
    assert(level_switch(0), "level 1 did not open")
    assert(load_room(k), "level 1 has no such room")
    enter_room()
    play(L1_TAPES[k], L1_LENS[k])
}

// A run of the stand-in room (n of them in a row: scenario 11 plays two).
fn standin() { standin_n(1) }

fn standin_n(n: s32) {
    standin_run = n
    run_start()
}


// ---- reporting

fn report(word: *u8, what: *u8, v: fixed) {
    print(word)
    print(what)
    print(" ")
    print_fixed(v)
    print("  (clock ")
    print_int(clock)
    print(", thief ")
    print_fixed(thief.x)
    print_char(' ')
    print_fixed(thief.z)
    println(")")
}

fn expect(c: bool, what: *u8, v: fixed) {
    if !c {
        report("FAIL ", what, v)
        assert(false)
    }
    checks += 1
    report("OK ", what, v)
}

// A check that runs every tick: silent while it holds.
fn always(c: bool, what: *u8, v: fixed) {
    if !c {
        report("FAIL ", what, v)
        assert(false)
    }
}

fn note(what: *u8, v: fixed) { report("NOTE ", what, v) }

fn done() {
    if finished { return }
    finished = true
    print("DONE ")
    print_int(SCENARIO)
    print(": ")
    print(name)
    print(", ")
    print_int(checks)
    println(" checks")
}

fn press(b: u32) { pad_v = pad_v | b }

// ---- an independent cover test: the point inside a triangle (edges included; a triangle with no
// area covers nothing), by its three edges' signs

fn tri_cover(ax: fixed, az: fixed, bx: fixed, bz: fixed, cx: fixed, cz: fixed, x: fixed, z: fixed) -> bool {
    let d1 = (bx - ax) * (z - az) - (bz - az) * (x - ax)
    let d2 = (cx - bx) * (z - bz) - (cz - bz) * (x - bx)
    let d3 = (ax - cx) * (z - cz) - (az - cz) * (x - cx)
    let area = (bx - ax) * (cz - az) - (bz - az) * (cx - ax)
    if area == 0.0 { return false }
    let neg = d1 < 0.0 || d2 < 0.0 || d3 < 0.0
    let pos = d1 > 0.0 || d2 > 0.0 || d3 > 0.0
    return !(neg && pos)
}

// Whether the drawn cone of watcher i covers the thief's centre: the triangles of its mesh (the
// vertices mesh_at() drew at the apex), tested with the function above.
fn drawn_cover(i: s32) -> bool {
    let f = &guards[i].fan
    let m = &mb_cones[i]
    if m.nv < RAYS + 1 { return false }
    let ax = f.ax + m.v[0].x
    let az = f.az + m.v[0].z
    for k in 0..RAYS - 1 {
        let bx = f.ax + m.v[k + 1].x
        let bz = f.az + m.v[k + 1].z
        let cx = f.ax + m.v[k + 2].x
        let cz = f.az + m.v[k + 2].z
        if tri_cover(ax, az, bx, bz, cx, cz, thief.x, thief.z) { return true }
    }
    return false
}

// The drawn cone's vertices are the fan's points, exactly.
fn drawn_is_fan(i: s32) -> bool {
    let f = &guards[i].fan
    let m = &mb_cones[i]
    for k in 0..RAYS {
        if f.ax + m.v[k + 1].x != f.px[k] || f.az + m.v[k + 1].z != f.pz[k] { return false }
    }
    return true
}

// A hash of the room: the thief, the guards, their fans, the trains, the tools.
fn mix(h: u32, v: s32) -> u32 { return ((h << 5) | (h >> 27)) ^ (v as u32) }

fn room_hash() -> u32 {
    var h: u32 = 0x9E3779B9
    h = mix(h, bits(thief.x))
    h = mix(h, bits(thief.z))
    h = mix(h, bits(thief.head))
    h = mix(h, thief.hidden as s32)
    for i in 0..room.nwatch {
        let g = &guards[i]
        h = mix(h, bits(g.x))
        h = mix(h, bits(g.z))
        h = mix(h, bits(g.head))
        h = mix(h, g.mode as s32)
        h = mix(h, g.timer)
        for k in 0..RAYS {
            h = mix(h, bits(g.fan.px[k]))
            h = mix(h, bits(g.fan.pz[k]))
        }
    }
    for i in 0..room.ntrains { h = mix(h, bits(trains[i].head)) }
    for i in 0..MAX_TOYS { h = mix(h, bits(toys[i].x) ^ bits(toys[i].z) ^ toys[i].ticks) }
    for i in 0..MAX_BELLS { h = mix(h, bells[i].ticks) }
    h = mix(h, phase as s32)
    return h
}

// ---- the scenarios

fn scenario(f: s32) {
    if finished { return }
    match SCENARIO {
        2, 12, 22 => s_into_cone(f)
        3, 13 => s_twice(f)
        11 => s_exit(f)
        4, 16 => s_trains(f)
        17 => s_door_sight(f)
        5 => s_hearing(f)
        6 => s_tools(f)
        7 => s_hide(f)
        8 => s_train_doors(f)
        9 => s_sight(f)
        10 => s_fragile(f)
        20, 21 => s_shot(f)
        30, 31 => s_budget(f)
        1, 14, 15 => s_solution(f)
        41, 42, 43, 44, 45 => s_l1_room(f)
        46 => s_l1_run(f)
        48 => s_flow(f)
        49 => s_events(f)
        47 => s_framing(f)
        50, 51, 52, 53, 54, 55 => { if clock >= 100 { done() } }
        56 => s_hidden_shot(f)
        60, 62 => s_doors(f)
        61 => s_doors_caught(f)
        63, 64 => s_s2_run(f)
        else => {}
    }
}

// 1, 14, 15: B's solution tapes on B's platform: never caught, and in the exit before the tape
// runs out (and a second after).
fn s_solution(f: s32) {
    if f == 0 { return }
    if f > 2 {
        if cpu_used() > worst_cpu {
            worst_cpu = cpu_used()
            worst_tick = clock
        }
        worst_gpu = max(worst_gpu, gpu_used())
        worst_sight = max(worst_sight, sight_cycles)
        worst_rays = max(worst_rays, sight_rays_tested)
        sum_sight += sight_cycles / 16
        sum_n += 1
    }
    if caught_n > 0 {
        print("FAIL caught by watcher ")
        print_int(catcher)
        print(" (why ")
        print_int(why as s32)
        print(") at clock ")
        print_int(caught_at)
        println("")
        expect(false, "the solution is never caught", fixed(caught_at))
    }
    if phase == Phase.Clear {
        expect(caught_n == 0, "never caught", 0.0)
        expect(in_exit(), "in the exit", thief.x)
        note("cleared on tick", fixed(tape_now.ticks))
        print("CLEAR ")
        print_int(tape_now.ticks)
        print(" ticks; worst frame: cpu ")
        print_int(worst_cpu)
        print(" (clock ")
        print_int(worst_tick)
        print(") gpu ")
        print_int(worst_gpu)
        print("; sight worst ")
        print_int(worst_sight)
        print(" mean ")
        print_int(sum_sight / max(sum_n, 1) * 16)
        print(", ray-segment tests worst ")
        print_int(worst_rays)
        println("")
        done()
        return
    }
    if clock > spans_ticks(tape, tape_n) + 60 {
        expect(false, "the tape ran out before the exit", fixed(clock))
    }
}

// 2: every tick while he plays, no drawn cone covers him (or he would have been caught); on the
// catch, the catching cone covers him and none did the tick before; FREEZE ticks later he is at
// the door with the clock at 0.
fn s_into_cone(f: s32) {
    if f == 0 { return }
    if phase == Phase.Play && caught_n == 0 {
        for i in 0..room.nwatch {
            always(drawn_is_fan(i), "the drawn cone is the fan", fixed(i))
            always(!drawn_cover(i), "no drawn cone covers him while he plays", fixed(i))
        }
        flag0 = true
    }
    if phase == Phase.Caught && t0 < 0 {
        t0 = f
        expect(flag0, "he played clean up to the catch", 0.0)
        expect(why == Why.Seen, "caught by being seen", fixed(why as s32))
        expect(catcher >= 0 && drawn_cover(catcher), "the catching cone covers him", fixed(catcher))
        expect(drawn_is_fan(catcher), "the catching cone is drawn as the fan tested", 0.0)
        expect(guards[catcher].caught, "the catching cone is the one highlighted", 0.0)
        n0 = spans_ticks(&tape_now.spans[0], tape_now.nspans)
        if SCENARIO == 22 && SHOT != 0 { done_at = f + 4 }
    }
    if t0 >= 0 && phase == Phase.Play && t1 < 0 {
        t1 = f
        expect(f - t0 == FREEZE, "the freeze lasts FREEZE frames", fixed(f - t0))
        expect(f - t0 < 60, "under 60 frames from the catch to the next try", fixed(f - t0))
        expect(clock == 0, "the clock is back at 0", fixed(clock))
        expect(thief.x == room.spawn_x && thief.z == room.spawn_z, "he is back at the door", thief.x)
        expect(restarts == 1, "one restart counted", fixed(restarts))
        expect(ev_count[Ev.Caught] == 1 && ev_count[Ev.Restart] == 1, "a Caught event, then a Restart", fixed(ev_count[Ev.Restart]))
        expect(best.have && best.ticks == caught_at + 1, "the attempt's tape is kept as the best", fixed(best.ticks))
        expect(n0 == best.ticks, "its spans cover every tick", fixed(n0))
        done()
    }
    if done_at >= 0 && f >= done_at { done() }
}

// 3: the busy tape (tools, running, trains, guards hearing; nobody catches him): the first
// attempt's hashes for 1,500 ticks, then START, then the second attempt compared tick by tick
// (the tape replays from the clock's 0 after the restart).
fn s_twice(f: s32) {
    if phase != Phase.Play { return }
    let _ = f
    if restarts == 0 {
        if clock < len(hashes) {
            hashes[clock] = room_hash()
            hash_n = clock + 1
        }
        if clock == 1500 { press(START) }
    } else if restarts == 1 {
        if clock < hash_n {
            always(hashes[clock] == room_hash(), "the second attempt matches the first", fixed(clock))
            n0 = clock + 1
        }
        if clock == hash_n - 1 {
            expect(n0 == hash_n, "every tick of the first attempt compared", fixed(n0))
            expect(hash_n > 1000, "the attempt was long enough to mean something", fixed(hash_n))
            var heard = 0
            for i in 0..room.nwatch {
                if guards[i].away || guards[i].mode == GMode.Look || guards[i].mode == GMode.Back { heard += 1 }
            }
            note("guards off their routes at the end", fixed(heard))
            done()
        }
    }
}

// 4: for every car on every tick, the drawn floor's corners (its model matrix applied to the unit
// box's vertices) are the corners of the sides that cut the cones, and a ray across the track
// at the car's middle stops at its near side.
fn s_trains(f: s32) {
    if f == 0 { return }
    var seen_cars = 0
    for i in 0..room.ntrains {
        let st = &trains[i]
        let d = &room.trains[i]
        for k in 0..st.ncars {
            let c = &st.cars[k]
            let model = car_model(c, -c.len / 2, c.len / 2, -c.w / 2, c.w / 2, 0.0, 1.0)
            // the unit box's four bottom corners, as mesh_xf transforms them, against the car's
            // corners (the sight segments' ends)
            for q in 0..4 {
                let v = mb_car_floor.v[q]
                let wx = dot(model[0], v) + view_origin.x
                let wz = dot(model[2], v) + view_origin.z
                let sl = if_f(q == 1 || q == 3, 1.0, -1.0)
                let sw = if_f(q >= 2, 1.0, -1.0)
                let p = car_corner(c, sl, sw)
                always(abs(wx - p.x) < 0.002 && abs(wz - p.y) < 0.002, "the drawn car's corner is the blocking rectangle's", wx - p.x)
            }
            // rays across the track from the room's middle line: between two doors it stops at the
            // car's near side; through an open door on that side, it goes into the car
            let az = room.cz
            let side = if_f(c.cz < az, -1.0, 1.0)
            let near = c.cz - side * c.w / 2
            var along: fixed = 0.0
            if d.doors >= 2 { along = (door_mid(d, c.len, 0) + door_mid(d, c.len, 1)) / 2 }
            else if d.doors == 1 { along = (door_mid(d, c.len, 0) - c.len / 2) / 2 }
            let hit = ray_across(c, along, az, side)
            always(abs(hit - near) < 0.002, "a ray across the track between doors stops at the car's near side", hit - near)
            let near_left = (az - c.cz) * c.ux > 0.0
            if st.open && c.whole && side_doors(d, near_left) {
                let h2 = ray_across(c, door_mid(d, c.len, 0), az, side)
                always((h2 - near) * side > 0.5, "a ray through an open door goes into the car", h2 - near)
                n1 += 1
            }
            seen_cars += 1
            if st.phase == TPhase.Stopped { flag1 = true }
        }
        let _ = d
    }
    if seen_cars > 0 { n0 += 1 }
    if f == 2400 {
        expect(n0 > 600, "ticks with a train on the path, all checked", fixed(n0))
        expect(flag1, "a stopped train checked", 0.0)
        expect(n1 > 100, "rays through open doors checked", fixed(n1))
        done()
    }
}

// Where a ray across the track (along z, toward `side`) from the room's middle line at the x of
// a point `along` the car first meets a train: its z.
fn ray_across(c: *Car, along: fixed, az: fixed, side: fixed) -> fixed {
    let ax = c.cx + c.ux * along
    var t: fixed = 1.0
    for s in 0..ndyn { t = ray_seg(ax, az, 0.0, side * 10.0, &dyn_segs[s], t) }
    return az + side * 10.0 * t
}

// 5: running near patrol 1 makes him go to the noise, look around and walk back to his route.
fn s_hearing(f: s32) {
    let g = &guards[0]
    if f == 0 {
        expect(g.mode == GMode.Route, "patrol 1 on his route", fixed(g.mode as s32))
    }
    if t0 < 0 && g.mode == GMode.GoNoise {
        t0 = f
        expect(f <= 3, "he hears the run at once (within his hear)", fixed(f))
        n0 = bits(g.bx)
        n1 = bits(g.bz)
    }
    if t0 >= 0 && t1 < 0 && g.mode == GMode.Look {
        t1 = f
        let d = sqrt(dist2(g.x, g.z, g.nx, g.nz))
        expect(d <= NEAR_NOISE + 0.1, "he stops by the noise", d)
    }
    if t1 >= 0 && t2 < 0 && g.mode == GMode.Back {
        t2 = f
        expect(f - t1 == LOOK_TICKS, "he looks around LOOK_TICKS", fixed(f - t1))
    }
    if t2 >= 0 && !flag0 && !g.away {
        flag0 = true
        expect(g.x == from_bits(n0) && g.z == from_bits(n1), "he is back where he left his route", g.x)
        expect(g.mode == GMode.Route || g.mode == GMode.Wait, "and walks it again", fixed(g.mode as s32))
        done()
    }
}

// 6: the toy walks and clicks, a guard follows it until it runs down; the bell beeps at 3 s and a
// guard within 9 m goes to it.
fn s_tools(f: s32) {
    if f == 0 { return }
    if t0 < 0 && toys[0].on {
        t0 = clock
        expect(thief.toys == 1, "a toy used, one left", fixed(thief.toys))
        expect(toys[0].ticks == TOY_TICKS - 1, "it starts running", fixed(toys[0].ticks))
    }
    if t0 >= 0 && toys[0].ticks > 0 {
        for i in 0..room.nwatch {
            if guards[i].toy == 0 { flag0 = true }
        }
    }
    if t0 >= 0 && toys[0].ticks == 0 && n0 == 0 {
        n0 = 1
        expect(clock - (t0 - 1) == TOY_TICKS, "the toy runs TOY_TICKS (from the tick it is set down)", fixed(clock - t0 + 1))
        expect(flag0, "a guard followed the toy", 0.0)
    }
    if t1 < 0 && bells[0].on {
        t1 = clock
        expect(thief.bells == 0, "the bell used", fixed(thief.bells))
    }
    if t1 >= 0 && t2 < 0 && bells[0].rang_at >= 0 {
        t2 = clock
        expect(bells[0].rang_at - bells[0].placed_at == BELL_DELAY, "the bell beeps 3 s after it is set down", fixed(bells[0].rang_at - bells[0].placed_at))
        var who = -1
        for i in 0..room.nwatch {
            let g = &guards[i]
            if room.watch[i].kind != WKind.Camera && g.mode == GMode.GoNoise && g.nx == bells[0].x && g.nz == bells[0].z { who = i }
        }
        expect(who >= 0, "a guard goes to the bell", fixed(who))
    }
    if n0 == 1 && t2 >= 0 { done() }
}

// 7: in the hiding place, hidden, while patrol 1's cone passes over him.
fn s_hide(f: s32) {
    if f == 0 { return }
    expect_play_clean()
    if thief.hidden {
        if t0 < 0 {
            t0 = f
            expect(box_contains(&room.spots[0], thief.x, thief.z), "hidden in the hiding place", 0.0)
        }
        for i in 0..room.nwatch {
            if fan_covers(&guards[i].fan, thief.x, thief.z) { n0 += 1 }
        }
    }
    if t0 >= 0 && f > t0 + 700 {
        expect(n0 > 10, "cones passed over him while he hid", fixed(n0))
        expect(caught_n == 0, "and none saw him", fixed(caught_n))
        done()
    }
}

fn expect_play_clean() {
    if caught_n > 0 && !flag1 {
        flag1 = true
        expect(false, "caught", fixed(catcher))
    }
}

// 8: the front train stops at tick 480 with its doors open until 899. Before, the platform edge
// stops him; at a door he walks in; inside, he is in a car; the doors close on him: caught.
fn s_train_doors(f: s32) {
    if f == 0 { return }
    if clock == 470 && phase == Phase.Play && t0 < 0 {
        t0 = 0
        expect(thief.z >= -SI_PLAT_Z + THIEF_R - 0.01, "the edge held him before the train came", thief.z)
        expect(!trains[0].open, "the train is not yet open", 0.0)
    }
    if phase == Phase.Play && thief.car >= 0 && t1 < 0 {
        t1 = clock
        expect(trains[0].open, "in through an open door", fixed(clock))
        expect(thief.car / 16 == 0, "into the front train", fixed(thief.car))
    }
    if phase == Phase.Caught && t2 < 0 {
        t2 = clock
        expect(why == Why.Doors, "the doors closed on him", fixed(why as s32))
        expect(caught_at == 240 + 240 + 420 - 1, "on the last tick of the dwell", fixed(caught_at))
        done()
    }
}

// 9: fans cast where the stand-in's numbers are known.
fn s_sight(f: s32) {
    if f != 2 { return }
    var fan: Fan
    // from (-12, 0) looking +x at the pillar at x -9 (its face at -9.3): the middle ray stops there
    fan_cast(&fan, -12.0, 0.0, HALF_PI, 30.0 * DEG, 6.0)
    expect(abs(fan.px[8] - (-9.3)) < 0.002, "the middle ray stops at the pillar's face", fan.px[8])
    expect(abs(sqrt(dist2(fan.px[0], fan.pz[0], -12.0, 0.0)) - 6.0) < 0.002, "an outer ray passes the pillar, full length", fan.px[0])
    expect(!fan_covers(&fan, -8.0, 0.0), "behind the pillar: unseen", 0.0)
    expect(fan_covers(&fan, -8.0, 1.2), "beside its shadow: seen", 0.0)
    // through the glass screen at x -10.6 (z -1.1..0.5): not cut
    fan_cast(&fan, -11.6, -0.3, HALF_PI, 20.0 * DEG, 5.0)
    expect(fan.px[8] > -9.4, "glass does not cut the cone", fan.px[8])
    // over the bench at x -6: not cut
    fan_cast(&fan, -7.5, 0.0, HALF_PI, 10.0 * DEG, 3.0)
    expect(abs(fan.px[8] - (-4.5)) < 0.002, "a bench does not cut the cone", fan.px[8])
    // the back wall at z 6: a fan looking +z from z 3 stops at its face (6.0)
    fan_cast(&fan, 12.0, 2.0, 0.0, 5.0 * DEG, 8.0)
    expect(abs(fan.pz[8] - 6.0) < 0.002, "the back wall cuts the cone", fan.pz[8])
    // the edge does not cut: across the front track from the platform, with no train, the front
    // wall (z -6.0) does
    fan_cast(&fan, 0.0, -1.0, PI, 5.0 * DEG, 7.0)
    expect(abs(fan.pz[8] - (-6.0)) < 0.002, "the platform's edge does not cut the cone; the front wall does", fan.pz[8])
    // a fan's polygon: the centre test at its edges, whatever the footprint overlaps
    fan_cast(&fan, 0.0, 0.0, HALF_PI, 30.0 * DEG, 2.0)
    expect(fan_covers(&fan, 1.98, 0.0), "a centre just inside the far edge", 0.0)
    expect(!fan_covers(&fan, 2.02, 0.0), "a centre just beyond it, his body over it, is unseen", 0.0)
    expect(fan_covers(&fan, 1.0, 0.55), "a centre just inside the side edge (29 degrees)", 0.0)
    expect(!fan_covers(&fan, 1.0, 0.6), "and just outside it (31 degrees)", 0.0)
    done()
}

// 10: brushing a fragile thing makes a noise once and knocks it down; the caught freeze is
// FREEZE frames long.
fn s_fragile(f: s32) {
    if f == 0 { return }
    if t0 < 0 && fragile_down[0] {
        t0 = clock
        var heard = false
        for i in 0..nnoise {
            if noises[i].x == room.frag_x[0] && noises[i].r == room.frag_noise[0] { heard = true }
        }
        expect(heard, "the crash is a noise", 0.0)
    }
    if t0 >= 0 && t1 < 0 && clock == t0 + 2 {
        t1 = clock
        var again = false
        for i in 0..nnoise {
            if noises[i].x == room.frag_x[0] { again = true }
        }
        expect(!again, "once", 0.0)
        done()
    }
}

// 20, 21: pictures at a set tick (SHOT=1 hides nothing here: the HUD is the game's).
fn s_shot(_f: s32) {
    let at = if_s(SCENARIO == 20, 620, 450)
    if clock >= at && t0 < 0 {
        t0 = clock
        done()
    }
}

fn if_s(c: bool, a: s32, b: s32) -> s32 {
    if c { return a }
    return b
}

// 30: the worst frame of a busy run: every watcher's fan, both trains, the tools, running.
var sum_cpu: s32
var sum_tick: s32
var sum_sight: s32
var sum_n: s32
fn s_budget(f: s32) {
    if f > 2 {
        sum_cpu += cpu_used() / 16
        sum_tick += tick_cycles / 16
        sum_sight += sight_cycles / 16
        sum_n += 1
        let c = cpu_used()
        if c > worst_cpu {
            worst_cpu = c
            worst_tick = clock
        }
        worst_gpu = max(worst_gpu, gpu_used())
        worst_sight = max(worst_sight, sight_cycles)
        worst_rays = max(worst_rays, sight_rays_tested)
    }
    if f == 1990 {
        print("MEAN cpu ")
        print_int(sum_cpu / sum_n * 16)
        print(" tick ")
        print_int(sum_tick / sum_n * 16)
        print(" sight ")
        print_int(sum_sight / sum_n * 16)
        println("")
        print("BUDGET cpu ")
        print_int(worst_cpu)
        print(" gpu ")
        print_int(worst_gpu)
        print(" sight ")
        print_int(worst_sight)
        print(" ray-segment tests ")
        print_int(worst_rays)
        print(" at clock ")
        print_int(worst_tick)
        println("")
        expect(worst_cpu < 1000000, "the worst frame is within the CPU budget", fixed(worst_cpu / 1000))
        expect(worst_gpu < 2000000, "and the GPU budget", fixed(worst_gpu / 1000))
        done()
    }
}

// 11: a run of two stand-in rooms, each crossed along its front to the staff door: the first
// exit loads the second room at clock 0; the second ends the run, with each room's time and the
// run's total; A starts the run again, with the first room's ghost on its cleared path.
fn s_exit(f: s32) {
    if f == 0 { return }
    if run_room == 1 && t2 < 0 {
        t2 = f
        expect(cleared_n == 1 && clock == 0 && restarts == 0 && phase == Phase.Play, "the exit loads the next room, its clock at 0", fixed(clock))
        expect(room_time[0] > 0 && room_spent[0] == room_time[0], "the first room's time kept", fixed(room_time[0]))
        expect(!best.have, "the new room has no ghost yet", 0.0)
    }
    if phase == Phase.Clear && t0 < 0 {
        t0 = f
        expect(in_exit(), "he is in the last room's exit", thief.x)
        expect(cleared_n == 2 && run_room == 1, "two rooms cleared", fixed(cleared_n))
        expect(total == room_spent[0] + room_spent[1], "the run's total is its rooms' time", fixed(total))
        expect(run_restarts() == 0, "no restarts", fixed(run_restarts()))
        expect(best.have && best.cleared && best.ticks == tape_now.ticks, "the cleared tape is the room's best", fixed(best.ticks))
        if SHOT != 0 { done_at = f + 2 }
    }
    if done_at >= 0 && f >= done_at {
        done()
        return
    }
    if t0 >= 0 && f == t0 + 30 { press(A) }
    if t0 >= 0 && phase == Phase.Play && t1 < 0 {
        t1 = f
        expect(clock == 0 && restarts == 0 && run_room == 0 && total == 0, "A plays the run again from its first room", fixed(clock))
    }
    if t1 >= 0 && clock == 200 && !flag0 {
        flag0 = true
        let g = ghost_at(clock)
        expect(best.have && abs(g.x - thief.x) < 0.02 && abs(g.y - thief.z) < 0.02, "the ghost walks the first room's cleared path", g.x - thief.x)
        done()
    }
}

// 17: the stand-in's front train (arriving 240-479, doors open on the platform's side 480-899,
// car 1's middle door at x -2.0, its gap x -2.65..-1.35 at z -3.0). A fan from the platform
// (-2, 0) looking -z: while the train comes in, closed, it stops at the car's side; while the
// doors are open, it reaches into the car through the gap only, to the far side (no doors there).
fn s_door_sight(f: s32) {
    if f == 0 { return }
    var fan: Fan
    if clock == 470 && t0 < 0 {
        t0 = clock
        fan_cast(&fan, -2.0, 0.0, PI, 30.0 * DEG, 6.0)
        expect(abs(fan.pz[8] - (-3.0)) < 0.002, "closed: the middle ray stops at the car's side", fan.pz[8])
        expect(!fan_covers(&fan, -2.2, -4.3), "closed: a thief inside is unseen", 0.0)
    }
    if clock == 600 && t1 < 0 {
        t1 = clock
        fan_cast(&fan, -2.0, 0.0, PI, 30.0 * DEG, 6.0)
        expect(abs(fan.pz[8] - (-5.6)) < 0.002, "open: the middle ray goes through the door to the far side", fan.pz[8])
        expect(abs(fan.pz[0] - (-3.0)) < 0.002 && abs(fan.pz[16] - (-3.0)) < 0.002, "open: the outer rays stop at the side", fan.pz[0])
        expect(fan_covers(&fan, -2.2, -4.3), "open: a thief inside in line with the door is seen", 0.0)
        expect(!fan_covers(&fan, -3.2, -4.3), "open: one inside beside the door is not", 0.0)
        done()
    }
}

fn budget_watch() {
    if cpu_used() > worst_cpu {
        worst_cpu = cpu_used()
        worst_tick = clock
    }
    worst_gpu = max(worst_gpu, gpu_used())
    worst_sight = max(worst_sight, sight_cycles)
    worst_rays = max(worst_rays, sight_rays_tested)
}

fn never_caught() {
    if caught_n > 0 {
        print("FAIL caught in room ")
        print_int(run_room + 1)
        print(" by watcher ")
        print_int(catcher)
        print(" (why ")
        print_int(why as s32)
        print(") at clock ")
        print_int(caught_at)
        println("")
        expect(false, "the tape is never caught", fixed(caught_at))
    }
}

// 41-45: level 1's room k (SCENARIO - 41) from its clock 0 with B's tape: never caught, and
// through its exit (into the next room, or the run's end after the last) before the tape runs out.
fn s_l1_room(f: s32) {
    let k = SCENARIO - 41
    if f == 0 { return }
    never_caught()
    if run_room != k || phase == Phase.Clear {
        expect(cleared_n == 1, "through the room's exit", fixed(cleared_n))
        if k < 4 { expect(run_room == k + 1 && clock == 0, "into the next room, its clock at 0", fixed(run_room)) }
        else { expect(phase == Phase.Clear, "the last room: the run's end", 0.0) }
        print("CLEAR room ")
        print_int(k + 1)
        print(" on tick ")
        print_int(room_time[k])
        println("")
        done()
        return
    }
    if clock > spans_ticks(tape, tape_n) + 60 { expect(false, "the tape ran out before the exit", fixed(clock)) }
}

// 46: the whole of level 1 as one run, each room with its tape: never caught, every room
// cleared in turn, the run's end, and its totals: the total is the rooms' times, no restarts.
fn s_l1_run(f: s32) {
    if f == 0 { return }
    if f > 2 { budget_watch() }
    never_caught()
    if phase == Phase.Clear && t0 < 0 {
        t0 = f
        expect(cleared_n == 5 && run_room == 4, "five rooms cleared, in order", fixed(cleared_n))
        var sum = 0
        for k in 0..5 {
            expect(room_time[k] > 0 && room_time[k] == room_spent[k] && room_restarts[k] == 0, "a room cleared on its first attempt", fixed(room_time[k]))
            sum += room_time[k]
            print("ROOM ")
            print_int(k + 1)
            print(" ")
            print_int(room_time[k])
            println(" ticks")
        }
        expect(total == sum, "the run's total is the rooms' times", fixed(total))
        expect(run_restarts() == 0, "no restarts", fixed(run_restarts()))
        print("RUN ")
        print_int(total)
        print(" ticks; worst frame: cpu ")
        print_int(worst_cpu)
        print(" (room ")
        print_int(run_room + 1)
        print(") gpu ")
        print_int(worst_gpu)
        print("; sight worst ")
        print_int(worst_sight)
        print(", ray-segment tests worst ")
        print_int(worst_rays)
        println("")
        done()
    }
    if f > 6000 { expect(false, "the run did not end", fixed(run_room)) }
}

// 47: each room of level 1 and the platform, one a frame: with the camera as far toward the front
// as it goes, the floor's front edge is on the picture above FRONT_Y + 1; as far toward the back,
// its back edge below BACK_Y - 1; and the pixels a metre at the target stay about 24.
fn frame_check(what: *u8) {
    let zf = room.cz - room.sz / 2
    let zb = room.cz + room.sz / 2
    camera_look(cam_eye(room.cx, cam_goal_z(zf)), 0.0, CAM_PITCH)
    let pf = project_point(vec3(room.cx, room.floor, zf))
    expect(pf.y <= FRONT_Y + 1 && pf.y >= BACK_Y - 1, what, fixed(pf.y))
    camera_look(cam_eye(room.cx, cam_goal_z(zb)), 0.0, CAM_PITCH)
    let pb = project_point(vec3(room.cx, room.floor, zb))
    expect(pb.y >= BACK_Y - 1 && pb.y <= FRONT_Y + 1, "  and its back edge", fixed(pb.y))
    let p0 = project_point(vec3(room.cx, room.floor, zb))
    let p1 = project_point(vec3(room.cx + 1.0, room.floor, zb))
    note("  px a metre (x, at the back edge)", fixed(p1.x - p0.x))
    print("FRAME ")
    print(what)
    print(": depth ")
    print_fixed(room.sz)
    print(" m, pans in z ")
    print_fixed(cam_tz_hi - cam_tz_lo)
    println(" m")
}

fn s_framing(f: s32) {
    if f >= 1 && f <= 5 {
        assert(level_switch(0), "level 1 did not open")
        assert(load_room(f - 1), "no room")
        frame_check("a level 1 room's front edge")
    }
    if f == 6 {
        assert(level_switch(PLATFORM_LEVEL), "the platform did not open")
        assert(load_room(0), "no platform")
        frame_check("the platform's front edge")
        done()
    }
}

// 56: the gates' tape until he has been hidden 40 ticks (and 8 ticks after he comes out, with
// SHOT=2: the cue of leaving).
fn s_hidden_shot(_f: s32) {
    if thief.hidden && t0 < 0 { t0 = clock }
    if !thief.hidden && t0 >= 0 && t1 < 0 { t1 = clock }
    if SHOT != 2 && t0 >= 0 && clock >= t0 + 40 && !finished { note("frame", fixed(_f)); done() }
    if SHOT == 2 && t1 >= 0 && clock >= t1 + 8 && !finished { note("frame", fixed(_f)); done() }
}

// 48: level 1 with the harness as its front end (as E's runs it): each exit goes to
// Mode.Transition; the next room is ready at frame 46 (its clock held at 0), in control at 90
// (RoomEnter at clock 0, checked in fe_event). The last exit ends the stage (Mode.End,
// StageClear) with the same times as without transitions; stage_start(0) plays it again.
fn s_flow(f: s32) {
    if f == 0 { return }
    never_caught()
    if mode == Mode.End && t0 < 0 {
        t0 = f
        expect(fe_trans == 4, "four transitions, each 90 frames", fixed(fe_trans))
        expect(fe_hold_clock_ok, "the next room's clock stays at 0 until control", 0.0)
        expect(ev_count[Ev.StageClear] == 1 && ev_count[Ev.RoomExit] == 5 && ev_count[Ev.RoomEnter] == 5 && ev_count[Ev.RoomReady] == 4, "5 exits, 4 ready, 5 in control, the stage cleared", fixed(ev_count[Ev.RoomEnter]))
        // StageStart, RoomEnter, then (RoomExit, RoomReady, RoomEnter) four times, RoomExit,
        // StageClear
        var seq_ok = flow_n == 16
        for i in 0..min(flow_n, 16) {
            let want = match i {
                0 => Ev.StageStart
                1 => Ev.RoomEnter
                14 => Ev.RoomExit
                15 => Ev.StageClear
                else => match (i - 2) % 3 { 0 => Ev.RoomExit, 1 => Ev.RoomReady, else => Ev.RoomEnter }
            }
            if flow_log[i] as Ev != want { seq_ok = false }
        }
        expect(seq_ok, "each transition is RoomExit, RoomReady, RoomEnter", fixed(flow_n))
        expect(ev_count[Ev.HideIn] >= 1 && ev_count[Ev.HideIn] == ev_count[Ev.HideOut], "hiding in and out (the gates)", fixed(ev_count[Ev.HideIn]))
        expect(ev_count[Ev.Step] > 60, "footsteps", fixed(ev_count[Ev.Step]))
        var sum = 0
        for r in 0..5 { sum += room_time[r] }
        expect(total == sum && sum == 4786, "the stage's time is its rooms' (the transitions do not count)", fixed(total))
        expect(phase == Phase.Clear, "the stage's end", 0.0)
    }
    if t0 >= 0 && f == t0 + 20 {
        test_run = false
        stage_start(0)
    }
    if t0 >= 0 && f == t0 + 22 {
        expect(mode == Mode.Play && run_room == 0 && clock <= 2 && total <= 2, "stage_start plays it again from room 1", fixed(run_room))
        expect(bests[0].have, "the ghosts kept (the same stage)", 0.0)
        done()
    }
    if f > 7000 { expect(false, "the stage did not end", fixed(run_room)) }
}

// 49: on the platform, standing by track A: each train's events in order (it comes in, its doors
// open, close, it is gone), and footsteps at the walk's stride.
fn s_events(f: s32) {
    if f == 160 {
        // 38 ticks down, 120 right at 0.04 m: about 6.3 m less what the walls took
        expect(ev_count[Ev.Step] >= 5 && ev_count[Ev.Step] <= 9, "footsteps every 0.8 m walked", fixed(ev_count[Ev.Step]))
        n0 = ev_count[Ev.Step]
    }
    if f == 3000 {
        expect(ev_count[Ev.Step] == n0, "no footsteps standing still", fixed(ev_count[Ev.Step]))
        for t in 0..room.ntrains {
            var stage = 0
            var ok = true
            var seen_n = 0
            for i in 0..ev_n {
                let e = ev_log_e[i] as Ev
                if ev_log_a[i] as s32 != t { continue }
                let s = match e { TrainArrive => 1, DoorsOpen => 2, DoorsClose => 3, TrainGone => 4, else => 0 }
                if s == 0 { continue }
                if s != stage % 4 + 1 { ok = false }
                stage = s
                seen_n += 1
            }
            expect(ok && seen_n >= 4, "a train's events in order: in, doors open, doors close, gone", fixed(seen_n))
        }
        done()
    }
}

// ---- stage 2's rules on the stand-in rooms of doors (dr_standin.akr): the hall (0; its door 0
// at the right to the store, door 1 the BLUE staff door in its back wall to the vault), the store
// (1; door 0 at the left back to the hall, the blue card at (2, 1.5), a posted guard by the front
// wall), the vault (2; door 0 back to the hall's blue door, door 1 the end).

var sg_seen: s32               // the visit the scenario last saw
var sg_step: s32
var sg_t: s32

// The stick toward (x, z); true when he is there.
fn steer(x: fixed, z: fixed) -> bool {
    let dx = x - thief.x
    let dz = z - thief.z
    let d = sqrt(dx * dx + dz * dz)
    if d < 0.05 { return true }
    stick_v = vec2(dx / d, dz / d)
    return false
}

// The middle ray of a fan from (2, 2) looking +z, through the hall's blue doorway.
fn through_blue() -> fixed {
    var fan: Fan
    fan_cast(&fan, 2.0, 2.0, 0.0, 20.0 * DEG, 5.0)
    return fan.pz[8]
}

fn blue_wall_on() -> bool { return room.walls[room.doors[1].wall].solid && room.walls[room.doors[1].wall].blocks }

// He came into room k by door d (-1: its way in), at (x, z), the clock at 0.
fn came_in(k: s32, d: s32, x: fixed, z: fixed) {
    expect(run_room == k && entry_door == d, "into the room by the door its way out leads to", fixed(run_room * 10 + d))
    expect(clock == 0 && phase == Phase.Play, "its clock at 0", fixed(clock))
    expect(abs(thief.x - x) < 0.001 && abs(thief.z - z) < 0.001, "at that door's spawn", thief.x)
    expect(best == ghost_for(k, d), "the ghost of this room by this door", 0.0)
}

// 60 (62 with transitions): hall (shut blue door) -> store (the card) -> hall by its right door
// (opens the blue door) -> vault -> hall by the blue door (still open) -> vault -> the end.
fn s_doors(f: s32) {
    if f == 0 { return }
    if visits != sg_seen && mode == Mode.Play {
        sg_seen = visits
        sg_step = 0
        match visits {
            1 => expect(run_room == 0 && entry_door == -1 && best == ghost_for(0, -1), "the stage starts in the hall at its way in", fixed(run_room))
            2 => {
                came_in(1, 0, -7.0, 0.0)
                expect(!best.have, "a room entered by a new door has no ghost yet", 0.0)
            }
            3 => {
                came_in(0, 0, 7.0, 0.0)
                expect(!best.have, "the hall by its right door: a ghost of its own", 0.0)
                expect(ghost_for(0, -1).have, "the hall by its way in kept its own", 0.0)
                expect(held == 4 && run_held == 4, "the blue card is the run's: he left the store with it", fixed(held as s32))
                expect(!door_open(&room.doors[1]) && blue_wall_on(), "the blue door is still shut", 0.0)
                expect(abs(through_blue() - 2.8) < 0.002, "shut, it cuts a cone", through_blue())
            }
            4 => came_in(2, 0, -7.0, 0.0)
            5 => {
                came_in(0, 1, 2.0, 2.0)
                expect(door_open(&room.doors[1]) && !blue_wall_on(), "the blue door stays open for the run", 0.0)
                expect(through_blue() > 6.99, "open, a cone goes through it", through_blue())
            }
            6 => came_in(2, 0, -7.0, 0.0)
            else => expect(false, "a visit too many", fixed(visits))
        }
    }
    if mode != Mode.Play && mode != Mode.End { return }
    if phase == Phase.Clear || mode == Mode.End {
        if t0 < 0 {
            t0 = f
            var sum = 0
            var spent = 0
            for k in 0..3 {
                sum += room_time[k]
                spent += room_spent[k]
            }
            expect(visits == 6 && run_cleared == 7, "six visits to three rooms, each left", fixed(visits))
            expect(sum == total && spent == total && run_restarts() == 0, "the rooms' times (every visit) make the run's total", fixed(total))
            expect(ev_count[Ev.CardTake] == 1 && ev_count[Ev.Unlock] == 1, "one card taken, one door opened", fixed(ev_count[Ev.Unlock]))
            if SCENARIO == 62 {
                expect(fe_trans == 5 && fe_hold_clock_ok, "five transitions, each room held at its clock 0", fixed(fe_trans))
                expect(mode == Mode.End, "the end door ends the stage", 0.0)
            }
            done()
        }
        return
    }
    if phase != Phase.Play { return }
    match visits {
        1 => {
            if sg_step == 0 {
                if steer(2.0, 2.0) {
                    sg_step = 1
                    sg_t = clock
                }
            } else if sg_step == 1 {
                stick_v = vec2(0.0, 1.0)
                if clock - sg_t == 30 {
                    expect(!door_open(&room.doors[1]) && abs(thief.z - 2.5) < 0.01, "the shut blue door stops him", thief.z)
                    expect(held == 0 && room_load_more(), "no card held; the hall has ways on", fixed(held as s32))
                    sg_step = 2
                }
            } else {
                let _ = steer(8.5, 0.0)
            }
        }
        2 => {
            if sg_step == 0 {
                let _ = steer(2.0, 1.5)
                if cards_n == 1 {
                    expect(held == 4 && card_taken(0) && ev_count[Ev.CardTake] == 1, "the blue card is picked up", fixed(held as s32))
                    expect(run_held == 0, "not the run's until he leaves", fixed(run_held as s32))
                    sg_step = 1
                }
            } else {
                let _ = steer(-8.5, 0.0)
            }
        }
        3 => {
            if sg_step == 0 {
                if steer(2.0, 2.0) { sg_step = 1 }
            } else {
                stick_v = vec2(0.0, 1.0)
                if sg_step == 1 && opened_n == 1 {
                    sg_step = 2
                    expect(door_open(&room.doors[1]) && !blue_wall_on() && ev_count[Ev.Unlock] == 1, "holding blue, he opens the blue door by walking into it", 0.0)
                    expect(thief.z > 2.8 - THIEF_R - DOOR_REACH - 0.05 && thief.z <= 2.5, "it opens as he reaches it", thief.z)
                    expect(through_blue() > 6.99, "open, a cone goes through it", through_blue())
                }
            }
        }
        4 => { let _ = steer(-8.5, 0.0) }
        5 => { let _ = steer(2.0, 3.5) }
        6 => { let _ = steer(8.5, 0.0) }
        else => {}
    }
}

// 61: hall -> store: the card, then caught: back at the store's door, the card lying there again;
// the card again, out -> the hall by its right door: the blue door opened, then START: the hall
// as he came in (the door shut, the card still his) -> opened again -> vault -> the end.
fn s_doors_caught(f: s32) {
    if f == 0 { return }
    if visits != sg_seen {
        sg_seen = visits
        sg_step = 0
        if visits == 2 { came_in(1, 0, -7.0, 0.0) }
        if visits == 3 { came_in(0, 0, 7.0, 0.0) }
    }
    if phase == Phase.Clear {
        expect(visits == 4 && run_restarts() == 2 && room_restarts[0] == 1 && room_restarts[1] == 1, "two restarts, one in each room", fixed(run_restarts()))
        expect(ev_count[Ev.CardTake] == 2 && ev_count[Ev.Unlock] == 2, "the card taken twice, the door opened twice", fixed(ev_count[Ev.CardTake]))
        done()
        return
    }
    if visits == 1 {
        let _ = steer(8.5, 0.0)
    } else if visits == 2 {
        if sg_step == 0 {
            let _ = steer(2.0, 1.5)
            if cards_n == 1 { sg_step = 1 }
        } else if sg_step == 1 {
            let _ = steer(3.5, -2.0)
            if phase == Phase.Caught {
                expect(why == Why.Seen && held == 4, "seen, holding the card", fixed(why as s32))
                sg_step = 2
            }
        } else if sg_step == 2 {
            if phase == Phase.Play {
                expect(clock == 0 && restarts == 1, "the room again, its clock at 0", fixed(clock))
                expect(abs(thief.x - (-7.0)) < 0.001 && abs(thief.z) < 0.001, "at the door he came in by", thief.x)
                expect(held == 0 && !card_taken(0), "the card lies there again", fixed(held as s32))
                expect(best.have && best == ghost_for(1, 0), "the caught attempt is the store's ghost by its door", 0.0)
                sg_step = 3
            }
        } else if sg_step == 3 {
            let _ = steer(2.0, 1.5)
            if cards_n == 2 { sg_step = 4 }
        } else {
            let _ = steer(-8.5, 0.0)
        }
    } else if visits == 3 {
        if sg_step == 0 {
            if steer(2.0, 2.0) { sg_step = 1 }
        } else if sg_step == 1 {
            stick_v = vec2(0.0, 1.0)
            if opened_n == 1 {
                press(START)
                sg_step = 2
            }
        } else if sg_step == 2 {
            if clock == 0 {
                expect(restarts == 1 && abs(thief.x - 7.0) < 0.001, "START: back at the door he came in by", thief.x)
                expect(!door_open(&room.doors[1]) && blue_wall_on(), "the door he opened is shut again", 0.0)
                expect(held == 4, "the card is still his (the run's since the store)", fixed(held as s32))
                expect(best.have && best == ghost_for(0, 0) && best != ghost_for(0, -1), "the hall by this door keeps its own ghost", 0.0)
                sg_step = 3
            }
        } else if sg_step == 3 {
            if steer(2.0, 2.0) { sg_step = 4 }
        } else {
            stick_v = vec2(0.0, 1.0)
        }
    } else if visits == 4 {
        let _ = steer(8.5, 0.0)
    }
}

// ---- 63: stage 2 (B's level2) as one run: the eight legs' tapes in order, the state carried

const S2_TAPES: [S2_LEGS]*Span = [SOLUTION_S2_LEG_0, SOLUTION_S2_LEG_1, SOLUTION_S2_LEG_2, SOLUTION_S2_LEG_3,
                                  SOLUTION_S2_LEG_4, SOLUTION_S2_LEG_5, SOLUTION_S2_LEG_6, SOLUTION_S2_LEG_7]
const S2_LENS: [S2_LEGS]s32 = [len(SOLUTION_S2_LEG_0), len(SOLUTION_S2_LEG_1), len(SOLUTION_S2_LEG_2),
                               len(SOLUTION_S2_LEG_3), len(SOLUTION_S2_LEG_4), len(SOLUTION_S2_LEG_5),
                               len(SOLUTION_S2_LEG_6), len(SOLUTION_S2_LEG_7)]
var s2_leg: s32 = -1
var s2_exits: s32              // RoomExit events seen
var s2_exit_door: [S2_LEGS + 1]s32
var s2_exit_room: [S2_LEGS + 1]s32
var s2_exit_ticks: [S2_LEGS + 1]s32

fn s2_run() {
    assert(level_switch(STAGE2), "level2 did not open")
    ghosts_clear()
    ev_n = 0
    for e in Ev { ev_count[e] = 0 }
    run_start()
}

fn s_s2_run(f: s32) {
    if visits - 1 != s2_leg && mode == Mode.Play && phase == Phase.Play {
        s2_leg = visits - 1
        expect(s2_leg < S2_LEGS, "no more legs than B's", fixed(s2_leg))
        if s2_leg > 0 {
            let k = s2_leg - 1
            expect(s2_exit_room[k] == S2_LEG_ROOM[k] as s32 && s2_exit_door[k] == S2_LEG_DOOR[k] as s32,
                   "the leg left its room by its door", fixed(s2_exit_door[k]))
            print("LEG ")
            print_int(k + 1)
            print(" room ")
            print_int(s2_exit_room[k])
            print(" door ")
            print_int(s2_exit_door[k])
            print(" ticks ")
            print_int(s2_exit_ticks[k])
            print("\n")
        }
        expect(run_room == S2_LEG_ROOM[s2_leg] as s32 && clock <= 1, "the leg starts in its room at its clock 0", fixed(run_room))
        play(S2_TAPES[s2_leg], S2_LENS[s2_leg])
    }
    always(caught_n == 0, "never caught", fixed(caught_n))
    if f > 1 {
        if cpu_used() > worst_cpu {
            worst_cpu = cpu_used()
            worst_tick = run_room
        }
        worst_gpu = max(worst_gpu, gpu_used())
        worst_sight = max(worst_sight, sight_cycles)
    }
    if phase == Phase.Clear {
        let k = S2_LEGS - 1
        expect(s2_leg == k && s2_exit_door[k] == S2_LEG_DOOR[k] as s32, "the last leg leaves by the end door", fixed(s2_leg))
        var sum = 0
        for r in 0..MAX_RUN { sum += room_time[r] }
        expect(sum == total && run_restarts() == 0, "the rooms' times make the run's total", fixed(total))
        expect(run_held != 0, "cards held at the end", fixed(run_held as s32))
        print("LEG 8 room ")
        print_int(s2_exit_room[k])
        print(" door ")
        print_int(s2_exit_door[k])
        print(" ticks ")
        print_int(s2_exit_ticks[k])
        print("\nRUN2 ")
        print_int(total)
        print(" ticks; worst frame: cpu ")
        print_int(worst_cpu)
        print(" (room ")
        print_int(worst_tick + 1)
        print(") gpu ")
        print_int(worst_gpu)
        print("; sight worst ")
        print_int(worst_sight)
        print("\n")
        expect(worst_cpu < 1000000 && worst_gpu < 2000000, "every frame within the budgets", fixed(worst_cpu / 1000))
        if SCENARIO == 64 {
            expect(fe_trans == S2_LEGS - 1 && fe_hold_clock_ok, "seven transitions, each room held at its clock 0", fixed(fe_trans))
            expect(mode == Mode.End, "the end door ends the stage", 0.0)
        }
        done()
    }
}
