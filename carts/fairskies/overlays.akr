// Things that slide in over the page: the remote control (type a page number, Teletext style,
// or use the four Fastext keys) and the settings.

// ---- the remote

const RM_X = 206
const RM_Y = 40
const RM_W = 108
const RM_H = 174
const RM_KEY_W = 28
const RM_KEY_H = 22

var rm_open: bool
var rm_slide: s32                 // 0 hidden .. 10 fully in
var rm_row: s32                   // key cursor: rows 0-3 digits, 4 the Fastext keys
var rm_col: s32
var rm_digits: [3]s32
var rm_n: s32                     // digits typed

const RM_KEYS: [12]s32 = [1, 2, 3, 4, 5, 6, 7, 8, 9, -1, 0, -2]     // -1 delete, -2 go
const FASTEXT: [4]u32 = [0x5050F0, 0x60D060, 0x40D0F0, 0xE0D060]   // red, green, yellow, cyan
const FASTEXT_NAMES: [4]*u8 = ["Home", "Index", "US", "Time"]

fn remote_open() {
    rm_open = true
    rm_row = 0
    rm_col = 0
    rm_n = 0
    settings_shown = false
    sfx_open()
}

private fn remote_close() {
    rm_open = false
    rm_n = 0
    set_page_field(view_page(next_view, next_loc))
    sfx_close()
}

private fn rm_field() {
    let b = &hdr_page_text[0]
    str_copy(b, 8, "P")
    for k in 0..3 {
        if k < rm_n { str_append_char(b, 8, '0' + rm_digits[k]) } else { str_append_char(b, 8, '-') }
    }
}

private fn rm_press_digit(d: s32) {
    if rm_n >= 3 { rm_n = 0 }
    rm_digits[rm_n] = d
    rm_n += 1
    rm_field()
    sfx_key()
    if rm_n == 3 {
        let page = rm_digits[0] << 8 | rm_digits[1] << 4 | rm_digits[2]
        if go_page(page) {
            rm_open = false
            rm_n = 0
        } else {
            let b = sbuf()
            str_copy(b, SB, "Page ")
            str_append(b, SB, s_page(page))
            str_append(b, SB, " is not on air")
            toast(b)
            rm_n = 0
            sfx_close()
        }
    }
}

private fn rm_press() {
    if rm_row == 4 {
        // Fastext
        let h = max(loc_find(BC_HOME), 0)
        match rm_col {
            0 => go(View.Now, h)
            1 => go(View.Regions, cur)
            2 => go(View.Map, max(loc_find(BC_NATIONAL), 0))
            else => go(View.Clock, cur)
        }
        rm_open = false
        rm_n = 0
        return
    }
    let k = RM_KEYS[rm_row * 3 + rm_col]
    if k >= 0 { rm_press_digit(k) }
    else if k == -1 {
        if rm_n > 0 { rm_n -= 1 }
        rm_field()
        sfx_key()
    } else {
        if rm_n == 0 { remote_close() }
        else { sfx_close() }
    }
}

private fn remote_input() {
    if pressed(B) || pressed(X) {
        remote_close()
        return
    }
    let cols = match rm_row { 4 => 4, else => 3 }
    if pressed(UP) {
        rm_row = (rm_row + 4) % 5
        sfx_tick()
    }
    if pressed(DOWN) {
        rm_row = (rm_row + 1) % 5
        sfx_tick()
    }
    let ncols = match rm_row { 4 => 4, else => 3 }
    if ncols != cols { rm_col = min(rm_col, ncols - 1) }
    if pressed(LEFT) {
        rm_col = (rm_col + ncols - 1) % ncols
        sfx_tick()
    }
    if pressed(RIGHT) {
        rm_col = (rm_col + 1) % ncols
        sfx_tick()
    }
    if pressed(A) { rm_press() }
}

private fn remote_draw(t: s32) {
    if rm_open { rm_slide = min(rm_slide + 2, 10) } else { rm_slide = max(rm_slide - 2, 0) }
    if rm_slide == 0 { return }
    let x = RM_X + (10 - rm_slide) * (RM_W + 8) / 10
    let y = RM_Y
    // the body: a glossy silver-blue handset
    rect_grad(x, y, RM_W, RM_H, 0xE0C8B4, 0x907060, BLEND_NONE)
    rect_blend(x, y, RM_W, 1, WHITE, BLEND_NONE)
    rect_blend(x, y + RM_H - 1, RM_W, 1, 0x402818, BLEND_NONE)
    rect_blend(x, y, 1, RM_H, 0xF0E0D0, BLEND_NONE)
    // the display
    rect(x + 8, y + 8, RM_W - 16, 26, 0x281408)
    rect_blend(x + 8, y + 8, RM_W - 16, 1, 0x000000, BLEND_NONE)
    let b = sbuf()
    str_copy(b, SB, "P")
    for k in 0..3 {
        if k < rm_n { str_append_char(b, SB, '0' + rm_digits[k]) }
        else if k == rm_n && (t / 20) % 2 == 0 { str_append_char(b, SB, '_') }
        else { str_append_char(b, SB, ' ') }
    }
    txt(F_BIG, x + 14, y + 6, b, C_GOLD)
    txt_a(F_TINY, x + RM_W - 12, y + 24, "MeiNet", C_CYAN, ALIGN_RIGHT)
    // the keys
    for r in 0..4 {
        for c in 0..3 {
            let kx = x + 8 + c * (RM_KEY_W + 4)
            let ky = y + 42 + r * (RM_KEY_H + 4)
            let sel = rm_row == r && rm_col == c
            var top: u32 = 0xF8F0E8
            var bot: u32 = 0xC0A898
            if sel {
                top = 0x90E8FF
                bot = 0x2A90F0
            }
            rect_grad(kx, ky, RM_KEY_W, RM_KEY_H, top, bot, BLEND_NONE)
            rect_outline(kx, ky, RM_KEY_W, RM_KEY_H, 0x604030, BLEND_NONE)
            let k = RM_KEYS[r * 3 + c]
            var lbl = s_int(k)
            if k == -1 { lbl = "<" }
            if k == -2 { lbl = "OK" }
            var col: u32 = 0x3A1E10
            if sel { col = WHITE }
            txt_a(F_MED, kx + RM_KEY_W / 2, ky + 3, lbl, col, ALIGN_CENTRE)
        }
    }
    // Fastext
    for c in 0..4 {
        let kx = x + 8 + c * 23
        let ky = y + 148
        rect_grad(kx, ky, 20, 10, col_add(FASTEXT[c], 0x303030), FASTEXT[c], BLEND_NONE)
        if rm_row == 4 && rm_col == c {
            rect_outline(kx - 2, ky - 2, 24, 14, WHITE, BLEND_NONE)
            txt_a(F_TINY, x + RM_W / 2, y + 161, FASTEXT_NAMES[c], 0x3A1E10, ALIGN_CENTRE)
        }
    }
}

// ---- settings

var settings_shown: bool
var st_sel: s32
private var st_changed: bool
const ST_ITEMS = 6

fn settings_open() {
    settings_shown = true
    st_sel = 0
    st_changed = false
    rm_open = false
    sfx_open()
}

private fn settings_close() {
    settings_shown = false
    if st_changed { store_save_settings() }
    sfx_close()
}

private fn st_change(d: s32) {
    match st_sel {
        0 => cfg.units = (1 - cfg.units as s32) as u8
        1 => cfg.tour = ((cfg.tour as s32 + d + 4) % 4) as u8
        2 => {
            cfg.music = clamp(cfg.music as s32 + d, 0, 4) as u8
            music_volume_changed()
        }
        3 => cfg.sfx = (1 - cfg.sfx as s32) as u8
        4 => {
            cfg.source = ((cfg.source as s32 + d + 3) % 3) as u8
            if cfg.source == 2 { rx_use_demo(true) }
            else if cfg.source == 1 { rx_use_demo(false) }
            // automatic keeps what is playing
        }
        else => {}
    }
    st_changed = true
    sfx_tick()
}

private fn settings_input() {
    if pressed(B) || pressed(START) {
        settings_close()
        return
    }
    if pressed(UP) {
        st_sel = (st_sel + ST_ITEMS - 1) % ST_ITEMS
        sfx_tick()
    }
    if pressed(DOWN) {
        st_sel = (st_sel + 1) % ST_ITEMS
        sfx_tick()
    }
    if pressed(LEFT) { st_change(-1) }
    if pressed(RIGHT) || pressed(A) { st_change(1) }
}

const ST_NAMES: [6]*u8 = ["Temperature", "Idle tour", "Music", "Sounds", "Source", "Reception"]

private fn st_value(k: s32) -> *u8 {
    return match k {
        0 => match cfg.units { 1 => "Celsius `C", else => "Fahrenheit `F" }
        1 => match cfg.tour { 0 => "Off", 1 => "After 1 minute", 2 => "After 2 minutes", else => "After 5 minutes" }
        2 => match cfg.music { 0 => "Off", 1 => "Quiet", 2 => "Soft", 3 => "Medium", else => "Full" }
        3 => match cfg.sfx { 0 => "Off", else => "On" }
        4 => match cfg.source { 0 => "Automatic", 1 => "Antenna", else => "Sample tape" }
        else => ""
    }
}

private fn settings_draw(t: s32) {
    if !settings_shown { return }
    let x = 40
    let y = 46
    let w = 240
    let h = 164
    rect_blend(x + 4, y + 4, w, h, 0x200C04, BLEND_HALF)
    panel(x, y, w, h)
    gloss(x, y + 1, w, 24)
    txt_s(F_MED, x + 10, y + 5, "Settings", WHITE, ALIGN_LEFT)
    txt_a(F_TINY, x + w - 10, y + 9, "Saved to the memory card", C_DIM, ALIGN_RIGHT)
    for k in 0..ST_ITEMS {
        let ry = y + 30 + k * 20
        if k == st_sel {
            rect_hgrad(x + 4, ry - 2, w - 8, 18, C_BAR_BOT, C_BAR_TOP, BLEND_NONE)
        }
        var lc = C_SOFT
        if k == st_sel { lc = WHITE }
        txt(F_SMALL, x + 12, ry + 1, ST_NAMES[k], lc)
        if k == 5 {
            reception_line(x + w - 12, ry + 1)
            continue
        }
        let v = st_value(k)
        var vx = x + w - 12
        if k == st_sel && k != 5 {
            txt_a(F_SMALL, vx, ry + 1, ">", C_GOLD, ALIGN_RIGHT)
            vx -= 10
        }
        txt_a(F_SMALL, vx, ry + 1, v, WHITE, ALIGN_RIGHT)
        if k == st_sel {
            txt_a(F_SMALL, vx - txt_w(F_SMALL, v) - 4, ry + 1, "<", C_GOLD, ALIGN_RIGHT)
        }
    }
    txt_a(F_TINY, x + w / 2, y + h - 12, "UP/DOWN choose  LEFT/RIGHT change  B close", C_DIM, ALIGN_CENTRE)
}

private fn reception_line(rx_: s32, y: s32) {
    let b = sbuf()
    str_append_int(b, SB, rx_ok() as s32, 0, false)
    str_append(b, SB, " ok  ")
    str_append_int(b, SB, rx_fixed() as s32, 0, false)
    str_append(b, SB, " fixed  ")
    str_append_int(b, SB, rx_dropped() as s32, 0, false)
    str_append(b, SB, " lost")
    let w = txt_w(F_TINY, b)
    txt_a(F_TINY, rx_, y + 3, b, WHITE, ALIGN_RIGHT)
    signal_bars(rx_ - w - 22, y + 1, rx_signal())
}

// ---- dispatch

fn overlay_open() -> bool { return rm_open || settings_shown }

// Handles the input of an open overlay; true if one had it.
fn overlays_input() -> bool {
    if settings_shown {
        settings_input()
        return true
    }
    if rm_open {
        remote_input()
        return true
    }
    // START from the "no signal" page plays the sample tape
    if pressed(START) && !rx_carrier() && model_seen == 0 && !store_has_pages() {
        cfg.source = 2
        rx_use_demo(true)
        toast("Playing the sample tape")
        return true
    }
    return false
}

fn overlays_draw(t: s32) {
    remote_draw(t)
    settings_draw(t)
}
