// The look: colours, text and number formatting, sprites.

const WHITE: u32 = 0xFFFFFF
const INK_SHADOW: u32 = 0x3A1408           // navy drop shadow (0xBBGGRR)
const C_GOLD: u32 = 0x46C2FA               // teletext yellow, warmed
const C_CYAN: u32 = 0xF0E07A
const C_SOFT: u32 = 0xF4DCC0               // pale blue-white for labels
const C_DIM: u32 = 0xC09A84
const C_NAVY: u32 = 0x3C180C
const C_PANEL_TOP: u32 = 0x9A4A2A
const C_PANEL_BOT: u32 = 0x6A2816
const C_PANEL_HI: u32 = 0xF0B47C
const C_BAR_TOP: u32 = 0x5AB8FA            // gold title bar
const C_BAR_BOT: u32 = 0x2A78E2
const C_GREEN: u32 = 0x8CE08C

// The degree sign in the cart's fonts.
const DEG = '`'

struct Settings {
    magic: u32
    units: u8                  // 0 Fahrenheit, 1 Celsius
    tour: u8                   // idle tour after: 0 off, 1 one minute, 2 two, 3 five
    music: u8                  // music volume 0 (off) - 4
    sfx: u8                    // 0 off, 1 on
    source: u8                 // 0 automatic, 1 antenna only, 2 the sample tape
    pad: [3]u8
}

const SETTINGS_MAGIC: u32 = 0x31534B46     // "FKS1"
var cfg = Settings { magic: SETTINGS_MAGIC, units: 0, tour: 2, music: 3, sfx: 1, source: 0 }

// ---- sprites

fn spr(s: Spr, x: s32, y: s32) {
    sprite_ex(tex_page(s.slot as s32, s.pal as s32, true), s.u as s32, s.v as s32, s.w as s32, s.h as s32,
              x, y, s.w as s32, s.h as s32, 0x808080, BLEND_NONE)
}

fn spr_c(s: Spr, cx: s32, cy: s32) { spr(s, cx - s.w as s32 / 2, cy - s.h as s32 / 2) }

fn spr_tint(s: Spr, x: s32, y: s32, tint: u32, mode: s32) {
    sprite_ex(tex_page(s.slot as s32, s.pal as s32, true), s.u as s32, s.v as s32, s.w as s32, s.h as s32,
              x, y, s.w as s32, s.h as s32, tint, mode)
}

fn spr_rot(s: Spr, cx: s32, cy: s32, angle: fixed) {
    sprite_rot(tex_page(s.slot as s32, s.pal as s32, true), s.u as s32, s.v as s32, s.w as s32, s.h as s32,
               cx, cy, s.w as s32, s.h as s32, angle, 0x808080, BLEND_NONE)
}

// ---- text

fn txt(f: *Font, x: s32, y: s32, s: *u8, c: u32) -> s32 {
    font_use(f)
    return font_text(x, y, s, c)
}

fn txt_a(f: *Font, x: s32, y: s32, s: *u8, c: u32, align: s32) -> s32 {
    font_use(f)
    return font_text_align(x, y, s, c, align)
}

// With a soft navy drop shadow.
fn txt_s(f: *Font, x: s32, y: s32, s: *u8, c: u32, align: s32) -> s32 {
    font_use(f)
    font_shadow(INK_SHADOW)
    let r = font_text_align(x, y, s, c, align)
    font_shadow_off()
    return r
}

fn txt_w(f: *Font, s: *u8) -> s32 {
    font_use(f)
    return text_width(s)
}

// Scratch strings: a ring of buffers, so a few formatted values can be alive at once.
private var sbufs: [12 * 48]u8
private var snext: s32

fn sbuf() -> *u8 {
    let b = &sbufs[snext * 48]
    snext = (snext + 1) % 12
    b[0] = 0
    return b
}

const SB = 48

fn s_int(n: s32) -> *u8 { return str_append_int(sbuf(), SB, n, 0, false) }

fn temp_known(t: s32) -> bool { return t != BC_TEMP_UNKNOWN }

// A half-degree C temperature in the chosen unit, rounded.
fn temp_u(t: s32) -> s32 {
    if cfg.units == 1 { return bc_temp_c(t) }
    return bc_temp_f(t)
}

// "68`" or "--".
fn s_temp(t: s32) -> *u8 {
    let b = sbuf()
    if !temp_known(t) { return str_copy(b, SB, "--") }
    str_append_int(b, SB, temp_u(t), 0, false)
    return str_append_char(b, SB, DEG)
}

// "68" without the degree sign.
fn s_temp_n(t: s32) -> *u8 {
    let b = sbuf()
    if !temp_known(t) { return str_copy(b, SB, "--") }
    return str_append_int(b, SB, temp_u(t), 0, false)
}

fn unit_letter() -> *u8 {
    if cfg.units == 1 { return "C" }
    return "F"
}

// A wind speed (km/h) in mph or km/h.
fn wind_u(kmh: s32) -> s32 {
    if cfg.units == 1 { return kmh }
    return (kmh * 621 + 500) / 1000
}

fn s_wind(dir: s32, kmh: s32) -> *u8 {
    let b = sbuf()
    if kmh == 255 { return str_copy(b, SB, "--") }
    if kmh == 0 { return str_copy(b, SB, "Calm") }
    if dir != 255 {
        str_append(b, SB, bc_compass(dir))
        str_append_char(b, SB, ' ')
    }
    str_append_int(b, SB, wind_u(kmh), 0, false)
    if cfg.units == 1 { return str_append(b, SB, " km/h") }
    return str_append(b, SB, " mph")
}

fn s_pct(p: s32) -> *u8 {
    let b = sbuf()
    if p == 255 { return str_copy(b, SB, "--") }
    str_append_int(b, SB, p, 0, false)
    return str_append_char(b, SB, '%')
}

// Pressure field -> "30.02 in" or "1016 hPa".
fn s_pressure(p: s32) -> *u8 {
    let b = sbuf()
    if p == 0xFFFF { return str_copy(b, SB, "--") }
    if cfg.units == 1 {
        str_append_int(b, SB, (p + 9000 + 5) / 10, 0, false)
        return str_append(b, SB, " hPa")
    }
    // inHg = hPa * 0.02953: (p + 9000) / 10 * 0.02953 = (p + 9000) * 2953 / 1000000
    let h = ((p + 9000) * 2953 + 5000) / 10000      // hundredths of an inch
    str_append_int(b, SB, h / 100, 0, false)
    str_append_char(b, SB, '.')
    str_append_int(b, SB, h % 100, 2, true)
    return str_append(b, SB, " in")
}

// Minutes after midnight -> "6:04 PM" (or with seconds).
fn s_clock(minutes: s32) -> *u8 {
    let b = sbuf()
    if minutes < 0 || minutes >= 1440 { return str_copy(b, SB, "--") }
    let h = minutes / 60
    var h12 = h % 12
    if h12 == 0 { h12 = 12 }
    str_append_int(b, SB, h12, 0, false)
    str_append_char(b, SB, ':')
    str_append_int(b, SB, minutes % 60, 2, true)
    if h < 12 { return str_append(b, SB, " AM") }
    return str_append(b, SB, " PM")
}

// An hour of the day -> "6a", "12p".
fn s_hour(h: s32) -> *u8 {
    let b = sbuf()
    var h12 = h % 12
    if h12 == 0 { h12 = 12 }
    str_append_int(b, SB, h12, 0, false)
    if h % 24 < 12 { return str_append_char(b, SB, 'a') }
    return str_append_char(b, SB, 'p')
}

fn s_upper(s: *u8) -> *u8 {
    let b = sbuf()
    var i = 0
    while s[i] != 0 && i < SB - 1 {
        var c = s[i] as s32
        if c >= 'a' && c <= 'z' { c -= 32 }
        b[i] = c as u8
        i += 1
    }
    b[i] = 0
    return b
}

fn s_cat(a: *u8, c: *u8) -> *u8 {
    let b = sbuf()
    str_copy(b, SB, a)
    return str_append(b, SB, c)
}

// Page number in hex: "400", "4FF".
fn s_page(p: s32) -> *u8 {
    let b = sbuf()
    for k in 0..3 {
        let d = (p >> ((2 - k) * 4) as u32) & 15
        if d < 10 { b[k] = ('0' + d) as u8 } else { b[k] = ('A' + d - 10) as u8 }
    }
    b[3] = 0
    return b
}

// ---- panels

// A glassy panel: gradient body with a light top edge and a dark bottom edge.
fn panel(x: s32, y: s32, w: s32, h: s32) {
    rect_grad(x, y, w, h, C_PANEL_TOP, C_PANEL_BOT, BLEND_NONE)
    rect_blend(x, y, w, 1, C_PANEL_HI, BLEND_NONE)
    rect_blend(x, y + h - 1, w, 1, 0x200A04, BLEND_NONE)
}

// A thin glossy highlight along the top half of a box (added light).
fn gloss(x: s32, y: s32, w: s32, h: s32) {
    rect_grad(x, y, w, h / 2, 0x403020, 0x000000, BLEND_ADD)
}
