// The movement garden's scenarios (tests/run.sh SCENARIO FRAMES OUT; tests/check.sh runs them
// all). Each places the player in the shrine town, drives the pad and stick (reacting to what the
// player does, so a press can come a set number of ticks after a landing or a wall), and checks
// the outcome against the tuning: heights, distances, speeds, states and windows. A check prints
// "OK what value"; a failed one prints "FAIL what value" and stops the run (exit status 2). The
// last line of a passing run is "DONE n: name, k checks".
//
// The moves' test spots (carts/garden/shrinetown, metres): the lane is the front road's
// carriageway, z 111 between its kerbs (z 108.5..113.5), flat open ground at 0 from x 90 to 230;
// the kick wall is the fire-escape building's east face, x 200, z 47.6..102, 15.2 high, open
// ground east of it to the gym (x 214); the ledge is the record shop's upper roof (7.3, x 140..146)
// over its lower roof (5.0, x 146..152, z 75..83), 2.3 m; the cemetery's first terrace (1.8) meets
// the second (3.6) at a wall at z 141; the station hall's ceiling is 3.40 over its floor (0.06),
// x 147..167, z 6..16; the overpass's west ramp rises 25.8 degrees (under the slide angle) east
// from x 246 at 0 to its deck (7.0) at x 260.5, z 96..99, and the temple's front steps the same
// north from the inner precinct (5.0) at z 202.75 to the podium (8.6) at z 210, x 155..165 (the
// level has no slope steeper than its floors' 40 degrees and over 26 that is not a roof); awning
// e0 (x 164.5..166, z 44.9..52.9, 2.6..2.95) is a bounce surface and the park's playground slide
// (x 11.7..12.3, down north from its platform, 3.0, at z 138.5 to 1.0 at z 141.5) a slide surface;
// the kick chimney is two rock faces 3 m apart, x 195 and 198, z 321.5..332.5, from its terrace
// (16) to 46. Numbers that depend on an asset's exact shape are read from the world (wp_floor,
// wp_ceiling); `ground_y` is the floor a scenario's checks expect the feet back on.
//
// Frames are ticks here (nothing runs late, which scenario 26 checks), so "n frames after" is
// n ticks after. A scenario's code at frame f runs before that frame's ticks (input_pad): it
// sees the state the frame before left, and its pad and stick are this frame's.

const TEST = 1

// The workers' scenarios: the camera's are numbered 100-199, the attachments' 200-299.
import "camera_cases.akr"
import "attach_cases.akr"
import "shrinetown_cases.akr" // the shrine town's, 400-449 (and the sh_ route and view helpers)
import "goals_cases.akr"      // the goals' (in the shrine town), 450-479
import "town_route_cases.akr" // the shrine town's street, east and canal routes, 480-499
import "frame_cases.akr"      // the shrine town's frame, 580-584
import "sn_cases.akr"          // the shadow and the card names, 600-619
import "shrinezone_cases.akr" // the shrine zone's routes, 700-789
import "sp_cases.akr"         // the sound and the far plain, 660-679 (the shrine town)
import "fu_cases.akr"         // the alpha follow-ups, 680-699 (the shrine town)
import "updraft_cases.akr"    // the shrine town's updrafts, 640-659
import "arrival_cases.akr"    // arriving by train (in the shrine town), 620-639
import "sf_cases.akr"         // the footsteps' surfaces, 560-579

var pad_v: u32                 // the pad and stick for the next frame
var stick_v: vec2
var seen: [len(St)]s32         // the first frame each state was seen at the end of
var checks: s32
var name: *u8
var apex: fixed                // the highest the feet have been since mark()
var t0: s32                    // frames of events, per scenario
var t1: s32
var t2: s32
var x0: fixed
var y0: fixed
var v0: fixed
var reach9: s32 = -1
var burned: bool
var ground_y: fixed            // the floor the scenario's checks expect the feet on
var late0: s32                 // late ticks before frame 10: the world's opening (25, 26)

const FWD: vec2 = vec2(0.0, 1.0)
const BACK: vec2 = vec2(0.0, -1.0)
const STILL: vec2 = vec2(0.0, 0.0)
const WEST: fixed = -1.5708
const EAST: fixed = 1.5708     // yaw facing +x
const NORTH: fixed = 0.0       // yaw facing +z

// The test spots (the header).
const LANE_Z: fixed = 111.0
const LANE_START: vec3 = vec3(100.0, 0.0, LANE_Z)
const LANE: vec3 = vec3(109.0, 0.0, LANE_Z)
const KICK_X: fixed = 200.0                       // the kick wall's face
const KICK: vec3 = vec3(208.0, 0.0, 75.0)
const LEDGE_X: fixed = 146.0                      // the ledge's face (the upper roof west of it)
const LEDGE: vec3 = vec3(149.0, 5.0, 78.0)
const STEP_Z: fixed = 141.0                       // the cemetery terrace wall's face
const STEP: vec3 = vec3(302.5, 1.8, 138.0)        // between two rows of graves
const HALL: vec3 = vec3(153.0, 0.06, 11.0)
const RAMP_FOOT: fixed = 246.0                    // the overpass ramp's foot (x) ...
const RAMP_Z: fixed = 97.5
const RAMP_RISE: fixed = 0.4828                   // ... and its rise a metre (25.8 degrees)
const STEPS_X: fixed = 160.0                      // the temple's front steps
const STEPS_FOOT: fixed = 202.75
const BOUNCE_AT: vec3 = vec3(165.25, 3.0, 48.9)   // over awning e0
const SLIDE_AT: vec3 = vec3(12.0, 2.5, 139.5)     // over the park slide's slope
const SLIDE_END_Z: fixed = 141.54                 // where its slide surface ends
const CHIMNEY: vec3 = vec3(195.4, 16.0, 326.0)    // the kick chimney's foot, by its west face

// The scenario runs before each frame's ticks: it sees the state at the end of the frame
// before, and sets the pad and stick for this frame.
fn input_pad(f: s32) -> u32 {
    pad_v = 0
    stick_v = STILL
    scenario(f)
    return pad_v
}
fn input_stick(_f: s32) -> vec2 { return stick_v }
fn input_look(_f: s32) -> vec2 { return vec2(0.0, 0.0) }

// ---- reporting

fn report(word: *u8, what: *u8, v: fixed) {
    print(word)
    print(what)
    print(" ")
    print_fixed(v)
    print("  (")
    print(ST_NAMES[pl.st])
    print(" at ")
    print_fixed(pl.pos.x)
    print_char(' ')
    print_fixed(pl.pos.y)
    print_char(' ')
    print_fixed(pl.pos.z)
    println(")")
}

fn expect(c: bool, what: *u8, v: fixed) {
    if !c {
        report("FAIL ", what, v)
        assert(false)
    }
    checks += 1
    report("OK ", what, v)
}

fn note(what: *u8, v: fixed) { report("NOTE ", what, v) }

fn done() {
    print("DONE ")
    print_int(SCENARIO)
    print(": ")
    print(name)
    print(", ")
    print_int(checks)
    println(" checks")
}

fn near(a: fixed, b: fixed, tol: fixed) -> bool { return abs(a - b) <= tol }
fn speed_ms() -> fixed { return hspeed() * 60 }
fn mark() { apex = pl.pos.y }
fn seen_at(s: St) -> s32 { return seen[s] }
fn was(s: St) -> bool { return seen[s] >= 0 }

// The apex the discrete integration reaches from vy (m/s): vy^2/2g less half a tick's rise.
fn apex_ticks(vy: fixed) -> fixed { return apex_of(vy) - vy / 120 }

// ---- setting up

fn place(p: vec3, yaw: fixed) {
    player_place(p, yaw)
    cam_reset()
}

fn test_init() {
    for s in St { seen[s] = -1 }
    cam.lock = true
    t0 = -1
    t1 = -1
    t2 = -1
    let lane = LANE
    let start = LANE_START
    match SCENARIO {
        1 => { name = "run and stop"; place(start, EAST) }
        2 => { name = "jump, held"; place(lane, EAST) }
        3 => { name = "jump, tapped"; place(lane, EAST) }
        4 => { name = "double jump, then the glider"; place(lane, EAST) }
        5 => { name = "a late second press is a single jump"; place(lane, EAST) }
        6 => { name = "jump, double, third, glide (running)"; place(start, EAST); pl.fwd = mps(T.RunSpeed) }
        7 => { name = "glide mode third: no glider from the double"; place(lane, EAST); tv[T.GlideMode] = 0.0 }
        8 => { name = "long jump"; place(start, EAST) }
        9 => { name = "backflip"; place(vec3(lane.x + 4.0, 0.0, LANE_Z), EAST) }
        10 => { name = "skid and side flip"; place(start, EAST) }
        11 => { name = "wall kick, early press"; place(KICK, WEST) }
        12 => { name = "wall kick, late press"; place(KICK, WEST) }
        13 => { name = "wall slide, no press"; place(KICK, WEST) }
        14 => { name = "wall kick, press just before the wall"; place(KICK, WEST) }
        15 => { name = "ledge: hop, hang, climb"; place(LEDGE, WEST) }
        16 => { name = "ledge: hang and drop"; place(LEDGE, WEST) }
        17 => { name = "ledge: a jump that clears it lands on top"; place(STEP, NORTH) }
        18 => { name = "ceiling stops the head"; place(HALL, NORTH) }
        19 => { name = "ground pound"; place(lane, EAST) }
        20 => { name = "dive, belly slide, rollout"; place(start, EAST) }
        21 => { name = "walk up the overpass's ramp"; place(vec3(RAMP_FOOT - 4.0, 0.0, RAMP_Z), EAST) }
        22 => {
            name = "steep slope slides"
            tv[T.SlideAngle] = 25.0
            ground_y = sh_floor(STEPS_X, STEPS_FOOT - 2.0, 7.0)       // the inner precinct
            place(vec3(STEPS_X, 9.0, 207.5), NORTH)
        }
        23 => { name = "slide surface"; ground_y = sh_floor(SLIDE_AT.x, SLIDE_END_Z + 2.0, 2.0); place(SLIDE_AT, NORTH) }
        24 => { name = "bounce surface"; place(BOUNCE_AT, EAST) }
        25 => { name = "tuning menu and readout"; place_at_spawn() }      // where the world opened: no cells to load
        26 => { name = "a late frame runs the ticks it missed"; place_at_spawn() }
        27 => { name = "tour: frame timing"; place(TOUR[3] + vec3(1.0, 0.0, 1.0), EAST); cam.lock = false }
        29 => { name = "kick alley: four kicks up"; place(CHIMNEY, EAST) }
        31 => { name = "dive up the temple's steps, then A: stays on the slope"; slope_start(true) }
        32 => { name = "dive up the overpass's ramp, then B (rollout): stays on the slope"; slope_start(false) }
        33 => { name = "long jump up the overpass's ramp: stays on the slope"; slope_start(false) }
        34 => { name = "ground pound onto the overpass's ramp: stays on the slope"; slope_start(false); place(vec3(RAMP_FOOT + 5.0, 4.0, RAMP_Z), EAST) }
        35 => { name = "jumps and dives up the temple's steps: stay on the slope"; slope_start(true) }
        36 => { name = "standing on the park slide's platform, close camera: the body is not cut"; place(vec3(12.0, 3.5, 138.1), NORTH) }
        37 => { name = "standing on the race train, close camera: the body is not cut"; place(lane, EAST) }
        38 => { name = "standing on the precinct's south wall, close camera: the body is not cut"; place(vec3(135.0, 8.0, 168.65), EAST) }
        30 => { name = "camera sweep at the spawn: frame timing"; place_at_spawn(); cam_reset() }
        28 => { name = "crouch and crawl"; place(lane, EAST) }
        else => {
            if !camera_case_init() && !attach_case_init() && !town_case_init() && !goals_case_init() && !route_case_init() && !frame_case_init() && !shz_case_init() && !sp_case_init() && !fu_case_init() && !sn_case_init() && !ud_case_init() && !at_case_init() && !sf_case_init() { name = "picture" }
        }
    }
    // the floor the moves come back down to: where the player was put, unless the scenario said
    if SCENARIO < 100 && SCENARIO != 22 && SCENARIO != 23 && SCENARIO != 34 && SCENARIO != 35 { ground_y = pl.pos.y }
}

// ---- each frame

fn test_hook(f: s32) {
    if seen[pl.st] < 0 { seen[pl.st] = f }
    apex = max(apex, pl.pos.y)
    frame_case_hook()
}

fn scenario(f: s32) {
    match SCENARIO {
        1 => s_run(f)
        2 => s_jump_held(f)
        3 => s_jump_tapped(f)
        4 => s_double(f)
        5 => s_late_chain(f)
        6 => s_triple(f)
        7 => s_glide_mode(f)
        8 => s_long(f)
        9 => s_backflip(f)
        10 => s_sideflip(f)
        11, 12, 13, 14 => s_kick(f)
        15, 16 => s_ledge(f)
        17 => s_ledge_clear(f)
        18 => s_ceiling(f)
        19 => s_pound(f)
        20 => s_dive(f)
        21 => s_ramp(f)
        22, 23 => s_slide(f)
        24 => s_bounce(f)
        25 => s_menu(f)
        26 => s_late(f)
        27 => s_tour(f)
        28 => s_crouch(f)
        29 => s_alley(f)
        30 => s_sweep(f)
        36, 37, 38 => s_body_shown(f)
        31, 32, 33, 34, 35 => s_slope_moves(f)
        else => {
            camera_case(f)
            attach_case(f)
            town_case(f)
            goals_case(f)
            route_case(f)
            frame_case(f)
            if SCENARIO >= 700 && SCENARIO < 790 { shz_case(f) }     // its else runs a route (and prints DONE) for any number
            sp_case(f)
            fu_case(f)
            sn_case(f)
            ud_case(f)
            at_case(f)
            sf_case(f)
        }
    }
}

fn s_run(f: s32) {
    if f < 120 { stick_v = FWD }
    if reach9 < 0 && speed_ms() >= 9.0 { reach9 = f }
    if f == 100 { expect(near(speed_ms(), tv[T.RunSpeed], 0.1), "top speed m/s", speed_ms()) }
    if f == 110 { expect(reach9 >= 75 && reach9 <= 100, "ticks to 9 m/s", fixed(reach9)) }
    if f == 120 { x0 = pl.pos.x }
    if f == 250 {
        expect(speed_ms() == 0.0 && pl.st == St.Ground, "stopped", speed_ms())
        let want = tv[T.RunSpeed] * tv[T.RunSpeed] / (tv[T.StopDecel] * 2)
        expect(near(pl.pos.x - x0, want, 0.25), "stopping distance m", pl.pos.x - x0)
        done()
    }
}

fn s_jump_held(f: s32) {
    if f >= 10 && f < 70 { pad_v = A }
    if f == 9 { mark() }
    if f > 10 && t0 < 0 && pl.st == St.Ground { t0 = f }
    if f == 80 {
        expect(seen_at(St.Jump) == 10, "jump on the press", fixed(seen_at(St.Jump)))
        expect(near(apex, apex_ticks(tv[T.JumpVy]), 0.03), "apex m", apex)
        expect(t0 - 10 >= 40 && t0 - 10 <= 44, "ticks in the air", fixed(t0 - 10))
        expect(pl.st == St.Ground && pl.pos.y == ground_y, "landed", pl.pos.y)
        done()
    }
}

fn s_jump_tapped(f: s32) {
    if f >= 10 && f < 13 { pad_v = A }
    if f == 9 { mark() }
    if f == 60 {
        expect(apex > 0.4 && apex < 1.0, "apex m, tapped", apex)
        expect(pl.st == St.Ground, "landed", pl.pos.y)
        done()
    }
}

// Jump; two ticks after landing, jump again and hold: the double jump, then (mode either) the
// glider at its apex.
fn s_double(f: s32) {
    if f >= 10 && f < 40 { pad_v = A }
    if f > 10 && t0 < 0 && pl.st == St.Ground { t0 = f }
    if t0 >= 0 && f >= t0 + 2 && f < t0 + 200 { pad_v = A }
    if t0 >= 0 && f == t0 + 1 { mark() }
    if t1 < 0 && pl.st == St.Glide {
        t1 = f
        expect(seen_at(St.DoubleJump) == t0 + 2, "double jump", fixed(seen_at(St.DoubleJump)))
        expect(near(apex, apex_ticks(tv[T.DoubleVy]), 0.04), "double apex m", apex)
        y0 = pl.pos.y
        x0 = pl.pos.x
    }
    if t1 >= 0 && f == t1 + 60 {
        expect(near(-pl.vel.y * 60, tv[T.GlideSink], 0.1), "glide sink m/s", -pl.vel.y * 60)
        expect(near(speed_ms(), tv[T.GlideSpeed], 0.2), "glide speed m/s", speed_ms())
        note("glide ratio so far", (pl.pos.x - x0) / (y0 - pl.pos.y))
    }
    if t1 >= 0 && t2 < 0 && pl.st == St.Ground { t2 = f }
    if f == 400 {
        expect(t2 > t1 && pl.pos.y == ground_y, "glided down to the floor", fixed(t2 - t1))
        done()
    }
}

fn s_late_chain(f: s32) {
    if f >= 10 && f < 40 { pad_v = A }
    if f > 10 && t0 < 0 && pl.st == St.Ground { t0 = f }
    let late = ticks(T.ChainWindow) + 3
    if t0 >= 0 && f >= t0 + late && f < t0 + late + 40 { pad_v = A }
    if f == 160 {
        expect(!was(St.DoubleJump) && seen_at(St.Jump) == 10, "no double jump", fixed(t0))
        done()
    }
}

// Running at full speed: jump, double (let go before its apex), third (held: the glider).
fn s_triple(f: s32) {
    stick_v = FWD
    if f >= 2 && f < 30 { pad_v = A }
    if t0 < 0 && f > 2 && pl.st == St.Ground { t0 = f }
    if t0 >= 0 && f >= t0 + 1 && f < t0 + 9 { pad_v = A }
    if t0 >= 0 && t1 < 0 && f > t0 + 1 && pl.st == St.Ground { t1 = f }
    if t1 >= 0 && f >= t1 + 1 && f < t1 + 300 { pad_v = A }
    if t1 >= 0 && f == t1 { mark() }
    if t2 < 0 && pl.st == St.Glide {
        t2 = f
        expect(was(St.DoubleJump) && was(St.ThirdJump), "jump, double, third", fixed(seen_at(St.ThirdJump)))
        let vy = tv[T.ThirdVy] + tv[T.RunSpeed] * tv[T.JumpSpeedAdd]
        expect(near(apex, apex_ticks(vy), 0.1), "third apex m", apex)
    }
    if t2 >= 0 && f == t2 + 40 {
        expect(near(speed_ms(), tv[T.GlideSpeed], 0.2), "glide speed m/s", speed_ms())
        done()
    }
}

fn s_glide_mode(f: s32) {
    if f >= 10 && f < 40 { pad_v = A }
    if f > 10 && t0 < 0 && pl.st == St.Ground { t0 = f }
    if t0 >= 0 && f >= t0 + 2 { pad_v = A }
    if f == 200 {
        expect(was(St.DoubleJump) && !was(St.Glide), "double jump, no glider", fixed(seen_at(St.DoubleJump)))
        done()
    }
}

fn s_long(f: s32) {
    if t0 < 0 || pl.st != St.Ground { stick_v = FWD }
    if f >= 100 && f < 106 { pad_v = R }
    if f >= 103 && f < 106 { pad_v = R | A }
    if f == 102 {
        expect(pl.st == St.CrouchSlide, "crouch slide", speed_ms())
        v0 = pl.fwd
    }
    if f == 104 {
        expect(pl.st == St.LongJump, "long jump", speed_ms())
        x0 = pl.pos.x - pl.vel.x
        let want = min((v0 - mps2(T.CrouchDecel)) * tv[T.LongMul], mps(T.LongMax)) * 60
        expect(near(speed_ms(), want, 0.05), "long jump speed m/s", speed_ms())
    }
    if f > 103 && t0 < 0 && pl.st == St.Ground {
        t0 = f
        expect(pl.pos.x - x0 >= 6.0 && pl.pos.x - x0 <= 8.0, "long jump distance m", pl.pos.x - x0)
    }
    if f == 200 {
        expect(t0 > 0, "landed", fixed(t0))
        done()
    }
}

fn s_backflip(f: s32) {
    if f >= 5 && f < 30 { pad_v = R }
    if f >= 10 && f < 60 { pad_v |= A }
    if f == 9 {
        expect(pl.st == St.Crouch, "crouch", pl.pos.y)
        mark()
        x0 = pl.pos.x
    }
    if f == 11 { expect(pl.st == St.Backflip, "backflip", pl.pos.y) }
    if f > 10 && t0 < 0 && pl.st == St.Ground { t0 = f }
    if f == 120 {
        expect(near(apex, apex_ticks(tv[T.FlipVy]), 0.05), "backflip apex m", apex)
        expect(x0 - pl.pos.x > 3.0, "went backward m", x0 - pl.pos.x)
        done()
    }
}

fn s_sideflip(f: s32) {
    if f < 80 { stick_v = FWD }
    if f >= 80 && f < 86 { stick_v = BACK }
    if f >= 84 && f < 110 { pad_v = A }
    if f == 81 { expect(pl.st == St.Skid, "skid", speed_ms()) }
    if f == 83 { mark() }
    if f == 85 {
        expect(pl.st == St.SideFlip, "side flip", speed_ms())
        expect(abs(wrap_angle(pl.yaw + EAST)) < 0.05, "facing back", pl.yaw)
    }
    if f == 160 {
        expect(near(apex, apex_ticks(tv[T.FlipVy]), 0.05), "side flip apex m", apex)
        done()
    }
}

// Run west at the kick wall (its east face at KICK_X), jump 3.5 m before it, touch it in the air.
// 11: press 1 tick after touching; 12: 15 ticks after; 13: no press; 14: press 2 ticks before.
fn s_kick(f: s32) {
    if t0 < 0 { stick_v = FWD }
    if t0 < 0 && f > 1 && pl.pos.x <= KICK_X + 3.5 && t2 < 0 { t2 = f }
    if t2 >= 0 && f >= t2 && f < t2 + 14 { pad_v = A }
    if SCENARIO == 14 && t0 < 0 && t2 >= 0 && f >= t2 + 16 {
        let gap = pl.pos.x - (KICK_X + BODY_RADIUS)
        if gap < -pl.vel.x * 2 && gap >= -pl.vel.x { pad_v = A }
    }
    if t0 < 0 && (pl.st == St.WallSlide || pl.kicks > 0) {
        t0 = f
        y0 = pl.pos.y
        expect(near(pl.pos.x, KICK_X + BODY_RADIUS, 0.02), "on the wall x", pl.pos.x)
        note("touched at height", pl.pos.y)
    }
    if t0 < 0 { return }
    if SCENARIO == 11 && f == t0 { pad_v = A }
    if SCENARIO == 12 && f == t0 + 14 { pad_v = A }
    if t1 < 0 && pl.st == St.WallKick {
        t1 = f
        mark()
        y0 = pl.pos.y
        note("kick at ticks after touching", fixed(pl.kick_at))
    }
    if f == t0 + 90 {
        if SCENARIO == 13 {
            expect(pl.kicks == 0, "no kick", fixed(pl.kicks))
            expect(seen_at(St.Fall) - seen_at(St.WallSlide) == ticks(T.KickSlide), "slid ticks", fixed(seen_at(St.Fall) - seen_at(St.WallSlide)))
            expect(pl.st == St.Ground && pl.pos.y == ground_y, "down on the floor", pl.pos.y)
        } else {
            expect(pl.kicks == 1, "kicked", fixed(pl.kick_at))
            if SCENARIO == 11 { expect(pl.kick_good && pl.kick_at == 1, "early: the better kick", fixed(pl.kick_at)) }
            if SCENARIO == 12 { expect(!pl.kick_good && pl.kick_at == 15, "late: the lesser kick", fixed(pl.kick_at)) }
            if SCENARIO == 14 { expect(pl.kick_good && pl.kick_at < 0, "buffered: the better kick", fixed(pl.kick_at)) }
            var vy = tv[T.KickVyLate]
            if pl.kick_good { vy = tv[T.KickVyGood] }
            expect(near(apex - y0, apex_ticks(vy), 0.05), "height gained m", apex - y0)
            expect(pl.pos.x > KICK_X + 2.0, "away from the wall", pl.pos.x)
        }
        done()
    }
}

// Run west on the record shop's lower roof and hop 1.6 m before the upper roof's face (x 146,
// 2.3 m over the feet): too high to land on, so hang from its top. 15: hold the stick toward it
// to climb; 16: R to drop.
fn s_ledge(f: s32) {
    let hanging = pl.st == St.LedgeHang || pl.st == St.LedgeClimb
    if t0 < 0 && !hanging { stick_v = FWD }
    if SCENARIO == 15 && hanging { stick_v = FWD }
    if t2 < 0 && pl.pos.x <= LEDGE_X + 1.6 { t2 = f }
    if t2 >= 0 && f >= t2 && f < t2 + 3 { pad_v = A }
    if t0 < 0 && pl.st == St.LedgeHang {
        t0 = f
        expect(near(pl.pos.y, pl.ledge_to.y - LEDGE_HANG, 0.001) && pl.ledge_to.y - ground_y > 2.0, "hanging below the top", pl.ledge_to.y - ground_y)
    }
    if SCENARIO == 16 && t0 >= 0 && f >= t0 + 12 && f < t0 + 14 { pad_v = R }
    if SCENARIO == 15 && t1 < 0 && t0 >= 0 && pl.st == St.Ground {
        t1 = f
        expect(near(pl.pos.y, pl.ledge_to.y, 0.001) && pl.pos.x < LEDGE_X, "climbed onto the top", pl.pos.y)
        expect(seen_at(St.LedgeClimb) == t0 + LEDGE_GRAB_TICKS - 1, "climbed after the grab ticks", fixed(seen_at(St.LedgeClimb) - t0 + 1))
    }
    if f == 200 {
        expect(t0 >= 0, "hung", fixed(t0))
        if SCENARIO == 16 { expect(pl.st == St.Ground && pl.pos.y == ground_y && !was(St.LedgeClimb), "dropped to the floor", pl.pos.y) }
        done()
    }
}

// Walk north at a third of the stick at the cemetery's terrace wall (1.8 m) and jump, held, 1 m
// before it: the jump clears the wall and lands on the terrace above, with no hang.
fn s_ledge_clear(f: s32) {
    stick_v = vec2(0.0, 0.3)
    if t2 < 0 && pl.pos.z >= STEP_Z - 1.0 { t2 = f }
    if t2 >= 0 && f >= t2 && f < t2 + 30 { pad_v = A }
    if t2 >= 0 && t1 < 0 && f > t2 + 1 && pl.st == St.Ground {
        t1 = f
        expect(!was(St.LedgeHang) && pl.pos.y > ground_y + 1.0 && pl.pos.z > STEP_Z, "landed on top, no hang", pl.pos.y - ground_y)
        done()
    }
}

fn s_ceiling(f: s32) {
    if f >= 10 && f < 60 { pad_v = A }
    if f == 9 {
        mark()
        assert(wp_ceiling(pl.pos + vec3(0.0, 0.5, 0.0), 0.0))
        y0 = wp_hit.y
        note("the station hall's ceiling", y0)
    }
    if pl.bonked && t0 < 0 { t0 = f }
    if f == 80 {
        expect(t0 > 0, "bonked", fixed(t0))
        expect(near(apex, y0 - BODY_HEIGHT - 0.01, 0.01), "head stopped at the ceiling m", apex + BODY_HEIGHT)
        done()
    }
}

fn s_pound(f: s32) {
    if f >= 10 && f < 40 { pad_v = A }
    if t0 < 0 && f > 10 && pl.vel.y <= 0.0 { t0 = f }
    if t0 >= 0 && f >= t0 + 1 && f < t0 + 3 { pad_v = R }
    if f == t0 + 1 { y0 = pl.pos.y }
    if t0 >= 0 && f == t0 + 2 { expect(pl.st == St.PoundSpin && pl.pos.y == y0, "spin holds still", pl.pos.y) }
    if t1 < 0 && pl.st == St.PoundFall {
        t1 = f
        let n = seen_at(St.PoundFall) - seen_at(St.PoundSpin)
        expect(n == ticks(T.PoundHang), "spin ticks", fixed(n))
    }
    if t1 >= 0 && f == t1 + 2 && pl.st == St.PoundFall { expect(near(-pl.vel.y * 60, tv[T.PoundFall], 0.01), "pound fall m/s", -pl.vel.y * 60) }
    if t2 < 0 && pl.st == St.Ground && t1 >= 0 {
        t2 = f
        let n = f - 1 - seen_at(St.PoundLand)
        expect(n == ticks(T.PoundLand), "landing ticks", fixed(n))
    }
    if f == 150 {
        expect(t2 > 0 && pl.pos.y == ground_y, "down", pl.pos.y)
        done()
    }
}

fn s_dive(f: s32) {
    if f < 60 { stick_v = FWD }
    if f == 60 { pad_v = B }
    if f == 60 { v0 = pl.fwd }
    if f == 61 {
        expect(pl.st == St.Dive, "dive", speed_ms())
        expect(near(pl.fwd, min(v0 + mps(T.DiveBoost), mps(T.DiveMax)), 0.0001), "dive speed m/s", speed_ms())
    }
    if t0 < 0 && pl.st == St.BellySlide { t0 = f }
    if t0 >= 0 && f == t0 + 5 { pad_v = A }
    if t0 >= 0 && f == t0 + 5 { expect(pl.st == St.BellySlide, "belly slide", speed_ms()) }
    if t0 >= 0 && f == t0 + 6 { expect(pl.st == St.Rollout, "rollout", speed_ms()) }
    if f == 240 {
        expect(pl.st == St.Ground && pl.pos.y == ground_y, "back on foot", speed_ms())
        done()
    }
}

// Up the overpass's west ramp (25.8 degrees, under the slide angle) at half stick: on foot all
// the way, 7 m along it (3.4 m up).
fn s_ramp(f: s32) {
    if t0 < 0 { stick_v = vec2(0.0, 0.5) }
    if t0 < 0 && pl.pos.x >= RAMP_FOOT + 7.0 {
        t0 = f
        expect(pl.st == St.Ground && near(pl.pos.y, (pl.pos.x - RAMP_FOOT) * RAMP_RISE, 0.1), "on the ramp (25.8 degrees) y", pl.pos.y)
        note("speed uphill m/s", speed_ms())
    }
    if f == 200 {
        expect(t0 > 0 && !was(St.Slide), "walked up, no slide", fixed(t0))
        done()
    }
}

// 22: on the temple's front steps (25.8 degrees) with the slide angle lowered to 25 degrees: slides
// down south to the inner precinct; 23: on the park's playground slide: slides down north past
// its foot to the park's ground.
fn s_slide(f: s32) {
    if f == 1 { expect(pl.st == St.Slide, "sliding", pl.pos.y) }
    if f == 200 {
        var past = pl.pos.z < STEPS_FOOT - 0.5
        if SCENARIO == 23 { past = pl.pos.z > SLIDE_END_Z + 0.5 }
        expect(was(St.Slide) && past && pl.st == St.Ground && pl.pos.y == ground_y, "slid down to the ground", pl.pos.z)
        done()
    }
}

var kick_y: [8]fixed

// The kick chimney: jump at its east face, then press A on every wall touched (one tick after):
// each kick starts higher than the one before.
fn s_alley(f: s32) {
    if t2 < 0 { stick_v = FWD }
    if t1 < 0 && pl.pos.x >= CHIMNEY.x + 0.6 { t1 = f }
    if t1 >= 0 && f >= t1 && f < t1 + 4 { pad_v = A }
    if pl.st == St.WallSlide {
        pad_v = A
        if t2 < 0 { t2 = f }
    }
    if pl.st == St.WallKick && pl.t == 1 && pl.kicks <= 8 { kick_y[pl.kicks - 1] = pl.pos.y }
    if f == 240 {
        expect(pl.kicks >= 4, "kicks", fixed(pl.kicks))
        for k in 1..4 { expect(kick_y[k] > kick_y[k - 1] + 1.5, "each kick higher m", kick_y[k]) }
        expect(apex - ground_y > 10.0, "apex m", apex - ground_y)
        done()
    }
}

fn s_bounce(f: s32) {
    if f >= 10 && f < 15 { pad_v = A }
    if t0 < 0 && pl.st == St.Bounce {
        t0 = f
        mark()
        y0 = pl.pos.y
    }
    if t0 >= 0 && f == t0 + 40 {
        expect(near(apex - y0, apex_ticks(tv[T.BounceVy]), 0.05), "bounce height m", apex - y0)
        done()
    }
}

// The menu and the readout; the frame counts from the cart's start, less the late ticks of the
// world's opening (the shrine town's first frame at the spawn draws the cells round it: about
// 1.5 budgets, one late tick).
fn s_menu(f: s32) {
    if f == 10 { late0 = timing.late }
    if f == 5 || f == 29 { pad_v = START }
    if f == 8 || f == 11 { pad_v = DOWN }
    if f == 14 || f == 17 || f == 20 { pad_v = RIGHT }
    if f == 23 { pad_v = RIGHT | X }
    if f == 26 { pad_v = Y }
    if f == 32 || f == 35 || f == 38 { pad_v = SELECT }
    if f == 6 { expect(menu_open, "menu open", 0.0) }
    if f == 12 { expect(menu_sel == T.RunDrag as s32, "chose run drag", fixed(menu_sel)) }
    if f == 21 { expect(near(tv[T.RunDrag], 0.85, 0.001), "three steps up", tv[T.RunDrag]) }
    if f == 24 { expect(near(tv[T.RunDrag], 1.35, 0.001), "ten steps up", tv[T.RunDrag]) }
    if f == 27 { expect(tv[T.RunDrag] == TUNE[T.RunDrag].def, "back to the default", tv[T.RunDrag]) }
    if f == 30 { expect(!menu_open, "menu closed", 0.0) }
    if f == 3 { expect(readout == 2, "readout: nothing at the start", 0.0) }
    if f == 33 { expect(readout == 0, "readout: timing", 0.0) }
    if f == 36 { expect(readout == 1, "readout: state", 0.0) }
    if f == 39 { expect(readout == 2, "readout: nothing", 0.0) }
    if f == 60 {
        expect(timing.shown == 60 && timing.ticks == 60 + late0 && timing.late == late0, "60 shown, 60 ticks (and the opening's)", fixed(timing.ticks))
        expect(timing.cpu > 0 && timing.cpu < CPU_BUDGET && timing.gpu > 0, "cpu and gpu measured", fixed(timing.cpu / 1000))
        done()
    }
}

// Spend 1.5 frames' cycles in one frame (the frame's own work, as the frame before's, and the
// rest burnt here): the next update runs two ticks, and a jump window measured in ticks still
// closes on time. Counted past the late ticks of the world's opening (25).
fn s_late(f: s32) {
    if f == 10 { late0 = timing.late }
    if f == 30 {
        let c = cycle_count()
        while cycle_count() - c < CPU_BUDGET * 3 / 2 - timing.cpu {}
    }
    if f == 32 {
        expect(sim_t == 33 + late0, "ticks run, frames shown (and the opening's)", fixed(sim_t))
        expect(timing.late == 1 + late0 && timing.last_ticks == 2, "readout: one late (and the opening's)", fixed(timing.late))
        note("late ticks of the world's opening", fixed(late0))
        done()
    }
}

// Run a loop of the schoolyard's open ground (0, between the pool, the gym and the school) with
// jumps, kicks and a glide, and report the frame timing. (The outer courtyard, the first place
// tried, peaks at 766,000 CPU cycles a frame, over half the budget: the town's busier views cost
// more than the city block's did.)
const TOUR: [4]vec3 = [vec3(254.0, 0.0, 44.0), vec3(254.0, 0.0, 62.0), vec3(241.0, 0.0, 62.0), vec3(241.0, 0.0, 44.0)]
var tour_k: s32

// Loop the schoolyard (the camera free to follow), steering toward each corner of TOUR in turn,
// with the stick turned by the camera's yaw.
fn s_tour(f: s32) {
    var d = TOUR[tour_k] - pl.pos
    d.y = 0.0
    if abs(d.x) + abs(d.z) < 2.0 { tour_k = (tour_k + 1) % 4 }
    d = normalize(d)
    let fw = fwd_dir(cam.yaw)
    stick_v = vec2(d.x * fw.z - d.z * fw.x, d.x * fw.x + d.z * fw.z)
    if f % 45 < 20 { pad_v = A }
    if f % 300 > 280 { pad_v = R }
    // measured from frame 30: the first frames load the cells round the place the tour was
    // jumped to from the spawn (sh_view's note), which running there never does at once
    if f == 30 { t0 = timing.late }
    if f >= 30 {
        x0 = max(x0, fixed(timing.cpu / 100) / 10)
        y0 = max(y0, fixed(timing.gpu / 100) / 10)
    }
    if f == 590 {
        note("cpu peak, thousand cycles", x0)
        note("gpu peak, thousand cycles", y0)
        note("tris", fixed(timing.tris))
        expect(timing.late == t0, "no late frames", fixed(timing.late - t0))
        expect(pl.pos.y > ground_y - 0.5 && tour_k >= 0, "still in the schoolyard", pl.pos.y)
        expect(x0 < fixed(CPU_BUDGET / 2000) && y0 < fixed(GPU_BUDGET / 2000), "within half the budgets", x0)
        done()
    }
}

fn s_crouch(f: s32) {
    if f >= 5 && f < 60 { pad_v = R }
    if f >= 20 && f < 50 { stick_v = FWD }
    if f == 6 { x0 = pl.pos.x }
    if f == 10 { expect(pl.st == St.Crouch, "crouch", pl.pos.y) }
    if f == 50 { expect(pl.st == St.Crouch && near(pl.pos.x - x0, tv[T.CrawlSpeed] * 30 / 60, 0.05), "crawled m", pl.pos.x - x0) }
    if f == 61 { expect(pl.st == St.Ground, "up again", pl.pos.y) }
    if f == 70 { done() }
}

// Turn the camera once round at the spawn (8 s) and report the frame timing the world costs.
fn s_sweep(f: s32) {
    cam.yaw = wrap_angle(fixed(f) * TAU / 480)
    if f >= 30 {
        x0 = max(x0, fixed(timing.cpu / 100) / 10)
        y0 = max(y0, fixed(timing.gpu / 100) / 10)
    }
    if f == 500 {
        note("cpu peak, thousand cycles", x0)
        note("gpu peak, thousand cycles", y0)
        note("late ticks", fixed(timing.late))
        expect(timing.shown == 500, "ran", fixed(timing.ticks))
        done()
    }
}

// Running up a ramp: a regression test for the owner's report that a dive up a ramp followed
// by a jump fell through the floor. Every frame the feet must be at or above the floor under
// them (the floor found from above), and the run must end standing on something. 32-34 on the
// overpass's west ramp (running east), 31 and 35 on the temple's front steps (running north),
// each started at a run 2 m before the foot; ground_y is the foot's floor. (31's jumps on the
// overpass grab the deck's 1.1 m parapet from the deck as a ledge and hang with the feet 0.4 m
// into the deck: a fault of the controller's ledge grab, not of this test, found porting it.)
fn slope_start(temple: bool) {
    if temple {
        place(vec3(STEPS_X, 6.0, STEPS_FOOT - 2.0), NORTH)
    } else {
        place(vec3(RAMP_FOOT - 2.0, 1.0, RAMP_Z), EAST)
    }
    ground_y = pl.pos.y
    pl.fwd = mps(T.RunSpeed)
}

var under_max: fixed

fn s_slope_moves(f: s32) {
    stick_v = FWD
    if wp_floor(pl.pos + vec3(0.0, 4.0, 0.0), 0.0) {
        under_max = max(under_max, wp_hit.y - pl.pos.y)
    }
    if SCENARIO == 31 || SCENARIO == 32 {
        if f == 6 { pad_v = B }
        if f > 8 && f % 6 == 0 {
            if SCENARIO == 31 { pad_v = A } else { pad_v = B }
        }
    }
    if SCENARIO == 33 {
        if f >= 4 && f < 8 { pad_v = R }
        if f >= 6 && f < 8 { pad_v = R | A }
    }
    if SCENARIO == 34 {
        stick_v = STILL
        if f >= 10 && f < 25 { pad_v = A }
        if f == 30 { pad_v = R }
    }
    if SCENARIO == 35 && f > 2 {
        if f % 20 < 3 { pad_v = A }
        if f % 20 == 10 { pad_v = B }
    }
    if f == 120 {
        note("the most the feet went below the floor m", under_max)
        expect(under_max < 0.05, "never under the floor", under_max)
        if SCENARIO == 34 { expect(was(St.PoundLand), "pounded", pl.pos.y) }
        expect(pl.pos.y > ground_y + 0.5 || pl.st != St.Fall, "standing on the slope or past it", pl.pos.y - ground_y)
        done()
    }
}

// A pixel of the picture presented last (the buffer that is not the back buffer), and whether
// it is the robot's red shell (230, 90, 60, lit and dithered).
fn shown_px(x: s32, y: s32) -> u32 {
    var fb: u32 = 0x400000
    if GPU_BACK == 0x400000 { fb = 0x425800 }
    return (fb as *u16)[y * 320 + x] as u32
}

fn body_pixels() -> s32 {
    var n = 0
    for y in 36..220 {
        for x in 0..320 {
            let v = shown_px(x, y)
            let r = (v & 31) as s32
            let g = ((v >> 5) & 31) as s32
            let b = ((v >> 10) & 31) as s32
            if r >= 12 && g * 2 <= r + 1 && g * 4 >= r && b * 3 <= r + 1 { n += 1 }
        }
    }
    return n
}

// 36: the park slide's platform (0.5 x 0.75, at 3.0), 37: the race train's roof (moving, so the
// counts differ a little; the level has no lift: the city block's gondola was one), 38: the
// precinct's south wall's top (0.9 wide, 7.6), as the city block's kick wall's top (1 x 12) that
// cut half the body under the ordering table. Standing on a platform with the camera close and
// above: nothing is in front of the body, so it shows as many pixels with the world drawn as
// drawn alone with the same camera.
fn s_body_shown(f: s32) {
    if f == 1 {
        tv[T.CamDist] = 2.5
        tv[T.CamPitch] = -0.8
    }
    if SCENARIO == 37 {
        // the race train: started (its flag's rise sets its clock to 0 on the first tick), set
        // half way along its leg east (moving at its fastest), and the player on its roof
        let m = &movers[mover_started_by("race5")]
        if f == 0 { flag_set("race5") }
        if f == 1 { m.mt = m.delay + m.period / 2 - 60 }
        if f == 2 { place_on_mover(m, EAST) }
        if f == 3 { expect(mover_live(m) && pl.st == St.Ground && pl.pos.y > m.pos.y + 3.0, "on the train's roof", pl.pos.y - m.pos.y) }
    }
    if f == 50 { robot_hold = true }           // the robot's pose still: its idle and key move
    if f == 60 { body_test_mode = 1 }
    if f == 62 { t0 = body_pixels() }
    if f == 62 { body_test_mode = 0 }
    if f == 64 {
        t2 = body_pixels()
        note("body pixels, drawn alone", fixed(t0))
        note("body pixels, with the world", fixed(t2))
        expect(t0 > 400, "the body is in view", fixed(t0))
        expect(t2 * 100 >= t0 * 97, "not cut by the platform", fixed(t2))
        done()
    }
}
