// The shrine world's scenarios (numbered 300-399), run by harness.akr in the shrine
// (start_world()); check.sh runs the ones shrine_cases.sh lists. The route scenarios walk the
// level as a list of legs: each leg puts the player on the floor at its start, facing its end,
// and steers there with the stick through the camera (cc_stick); a jump leg presses A once the
// player has run `at` metres (twice for a double jump), and passes when the player stands
// again within `tol` of the end, no lower than `min_y`. A leg is a check; a scenario passes
// when all of its legs do. They show every walk and jump of the route is possible with the
// controller's default tuning.

struct Leg {
    from: vec3         // x, z of the start (y: 0 = on the floor there; else the height to start at)
    to: vec3           // x, z of the end, and y: the lowest the feet may land (0 = no check)
    kind: s32          // LEG_WALK, LEG_JUMP, LEG_DOUBLE, LEG_LONG
    at: fixed          // jumps: metres run before A
    tol: fixed         // how near the end to count as there
}

const LEG_WALK = 0
const LEG_JUMP = 1
const LEG_DOUBLE = 2
const LEG_LONG = 3
const SHRINE_TRACE = 0       // debugging: notes the position every 10 ticks of this leg (0: none)

