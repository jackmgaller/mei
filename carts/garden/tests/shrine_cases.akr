var sh_leg: s32
var sh_t: s32              // ticks into the leg
var sh_start: vec3
var sh_air: bool
var sh_presses: s32
var sh_hold: bool
var sh_prev_walk: bool     // the leg before was a walk
var sh_fails: s32

fn shrine_case_init() -> bool {
    match SCENARIO {
        300 => { name = "shrine: the spawn on the road, walk north through the great torii" }
        301 => { name = "shrine: wading in the pond is slow, and no jump from deep water" }
        302 => { name = "shrine: the forest loop, west: trail, spring, stairs" }
        303 => { name = "shrine: the pond crossing, back to the courtyard" }
        304 => { name = "shrine: the forest loop: the treetop walkway to the fox shrine" }
        305 => { name = "shrine: the forest loop: the torii tunnel, the stage, down to the sacred tree" }
        306 => { name = "shrine: the forest loop: the hollow log, the falls, the stream, to the pond" }
        307 => { name = "shrine: every coin has a floor under it and can be taken" }
        308 => { name = "shrine: the konbini door leads to the garden" }
        309 => { name = "shrine: the garden's shrine torii leads to the shrine" }
        else => { return false }
    }
    cam.lock = false
    sh_leg = -1
    return true
}

fn shrine_case(f: s32) {
    match SCENARIO {
        300 => sh_spawn(f)
        301 => sh_wade(f)
        302 => sh_route(f, &ROUTE_WEST[0], len(ROUTE_WEST) as s32)
        303 => sh_route(f, &ROUTE_POND[0], len(ROUTE_POND) as s32)
        304 => sh_route(f, &ROUTE_WALKWAY[0], len(ROUTE_WALKWAY) as s32)
        305 => sh_route(f, &ROUTE_MOUNTAIN[0], len(ROUTE_MOUNTAIN) as s32)
        306 => sh_route(f, &ROUTE_FALLS[0], len(ROUTE_FALLS) as s32)
        307 => sh_coins(f)
        308 => sh_door(f)
        309 => sh_door_in(f)
        else => {}
    }
}

// Every coin and red coin: a floor under it that the player can stand on, the coin within
// reach above it (0.5 to 1.8 m), and standing there takes it. 11 rooftop coins and 8 red ones.
var sh_n: s32 = -1
var sh_gold: s32
var sh_red: s32

fn sh_next_coin(from: s32) -> s32 {
    for n in from..wp_pack.entity_count as s32 {
        let ty = wp_entity(n).type_id as s32
        if ty == COIN_TYPE || ty == RED_COIN_TYPE { return n }
    }
    return -1
}

fn sh_coins(f: s32) {
    if sh_n == -1 && f == 0 { sh_n = sh_next_coin(0); sh_t = 0 }
    if sh_n == -2 { return }
    if sh_n < 0 {
        sh_n = -2
        expect(sh_gold == 11, "rooftop coins taken", fixed(sh_gold))
        expect(sh_red == 8, "red coins taken", fixed(sh_red))
        expect(coins == 11 && red_coins == 8, "the game counted them", fixed(coins + red_coins))
        done()
        return
    }
    let e = wp_entity(sh_n)
    let c = wp_entity_pos(e)
    if sh_t == 0 {
        expect(wp_floor(c, 0.0), "a floor under the coin", c.y)
        let rise = c.y - wp_hit.y
        expect(rise > 0.5 && rise < 1.8, "the coin within reach above it, m", rise)
        place(vec3(c.x, wp_hit.y, c.z), NORTH)
    }
    sh_t += 1
    if sh_t == 4 {
        expect(coin_taken(e.number as s32), "standing there takes it", c.y)
        if e.type_id as s32 == RED_COIN_TYPE { sh_red += 1 } else { sh_gold += 1 }
        sh_n = sh_next_coin(sh_n + 1)
        sh_t = 0
    }
}

// The torii at the foot of the garden's shrine hill leads to the shrine, to its spawn on the road.
fn sh_door_in(f: s32) {
    if f == 0 {
        expect(world_k == GARDEN_WORLD_GARDEN, "starts in the garden", fixed(world_k))
        place(vec3(101.0, 0.0, 6.0), atan2(0.0, -1.0))
    }
    if f < 60 && world_k == GARDEN_WORLD_GARDEN { stick_v = FWD }
    if f == 80 {
        expect(world_k == GARDEN_WORLD_SHRINE, "the torii took the player to the shrine", fixed(world_k))
        expect(near(pl.pos.z, 8.0, 0.5) && near(pl.pos.x, 95.0, 0.5), "at the shrine's spawn, z", pl.pos.z)
        done()
    }
}

// The konbini's door leads to the movement garden.
fn sh_door(f: s32) {
    if f == 0 {
        expect(world_k == GARDEN_WORLD_SHRINE, "starts in the shrine", fixed(world_k))
        place(vec3(32.0, 0.15, 17.0), atan2(0.0, -1.0))
    }
    if f < 60 && world_k == GARDEN_WORLD_SHRINE { stick_v = FWD }
    if f == 80 {
        expect(world_k == GARDEN_WORLD_GARDEN, "the door took the player to the garden", fixed(world_k))
        expect(wp_cell_at(pl.pos) != null, "standing in the garden", pl.pos.y)
        done()
    }
}

// The floor under (x, z), from high up.
fn sh_floor(x: fixed, z: fixed, from: fixed) -> fixed {
    if wp_floor(vec3(x, from, z), 0.0) { return wp_hit.y }
    return -100.0
}

fn sh_heading(to: vec3) -> fixed { return atan2(to.x - pl.pos.x, to.z - pl.pos.z) }

fn sh_spawn(f: s32) {
    if f == 0 {
        expect(near(pl.pos.z, 8.0, 0.5), "spawn on the south sidewalk, z", pl.pos.z)
        mark()
    }
    if f < 280 { stick_v = FWD }
    if f == 280 {
        expect(pl.pos.z > 44.0, "walked north through the torii, z", pl.pos.z)
        expect(pl.st == St.Ground, "on the ground", pl.pos.y)
        done()
    }
}

fn sh_wade(f: s32) {
    if f == 0 { place(vec3(176.0, -1.6, 58.0), WEST) }
    if f < 120 { stick_v = FWD }
    if f == 100 {
        expect(pl_wade > 0.9, "deep in the pond, depth", pl_wade)
        let v = speed_ms()
        expect(v < tv[T.RunSpeed] * 0.5, "wading speed under half the run, m/s", v)
        mark()
    }
    if f == 102 { pad_v = A }
    if f == 120 {
        expect(apex < pl.pos.y + 0.3, "no jump from deep water, rise", apex - pl.pos.y)
        done()
    }
}

// Runs the legs one after another; each must reach its end in 15 seconds.
fn sh_route(f: s32, legs: *Leg, n: s32) {
    if sh_leg < 0 || sh_leg >= n {
        if sh_leg < 0 { sh_leg = 0; sh_begin(legs[0]) }
        else { done(); return }
    }
    let lg = legs[sh_leg]
    sh_t += 1
    if SHRINE_TRACE != 0 && sh_leg == SHRINE_TRACE && sh_t % 10 == 1 { note("trace, tick", fixed(sh_t)) }
    let to = vec3(lg.to.x, pl.pos.y, lg.to.z)
    let d = length(vec3(to.x - pl.pos.x, 0.0, to.z - pl.pos.z))
    let ran = length(vec3(pl.pos.x - sh_start.x, 0.0, pl.pos.z - sh_start.z))
    if is_air(pl.st) || pl.st == St.Glide { sh_air = true }
    if !sh_air {
        if d > 0.3 { stick_v = cc_stick(sh_heading(to), 1.0) }
    } else {
        // in the air: steer by where the body would come down about 0.4 s from now
        let ahead = pl.pos + vec3(pl.vel.x, 0.0, pl.vel.z) * 24
        let err = vec3(to.x - ahead.x, 0.0, to.z - ahead.z)
        let m = min(length(err), 1.0)
        if m > 0.1 { stick_v = cc_stick(atan2(err.x, err.z), m) }
    }
    if lg.kind != LEG_WALK && sh_presses == 0 && ran >= lg.at { pad_v = A; sh_presses = 1; sh_hold = true }
    else if sh_hold && (!sh_air || pl.vel.y > 0.0) { pad_v = A }       // held: the full jump
    else if sh_hold { sh_hold = false }                                   // released at the apex
    else if lg.kind == LEG_DOUBLE && sh_presses == 1 && sh_air { pad_v = A; sh_presses = 2; sh_hold = true }
    var arrived = false
    if lg.kind == LEG_WALK { arrived = d < lg.tol && pl.st == St.Ground }
    else { arrived = sh_air && pl.st == St.Ground && sh_t > 4 }
    if arrived {
        if lg.kind != LEG_WALK {
            expect(d < lg.tol, "landed at the end, off by", d)
        } else {
            expect(true, "reached the end of a walk, ticks", fixed(sh_t))
        }
        if lg.to.y != 0.0 { expect(pl.pos.y >= lg.to.y, "high enough, y", pl.pos.y) }
        sh_prev_walk = lg.kind == LEG_WALK
        sh_leg += 1
        if sh_leg < n { sh_begin(legs[sh_leg]) }
        return
    }
    if sh_t > 900 {
        note("stuck: wall hit", fixed(pl.wall_hit as s32))
        note("wall normal x", pl.wall_n.x)
        note("wall normal z", pl.wall_n.z)
        note("wall normal y", pl.wall_ny)
        note("floor normal y", pl.floor_n.y)
        note("speed", speed_ms())
        note("state", fixed(pl.st as s32))
        report("FAIL ", "leg not finished, leg", fixed(sh_leg))
        assert(false)
    }
}

fn sh_begin(lg: Leg) {
    // A leg that starts where the last one ended goes on from there, as a player would.
    let dir = normalize(vec3(lg.to.x - lg.from.x, 0.0, lg.to.z - lg.from.z))
    let turn = dot(dir, fwd_dir(pl.yaw))
    if sh_leg > 0 && lg.kind == LEG_WALK && sh_prev_walk && turn > 0.7 && pl.st == St.Ground && length(vec3(pl.pos.x - lg.from.x, 0.0, pl.pos.z - lg.from.z)) < 1.6 {
        sh_start = pl.pos
        sh_t = 0
        sh_air = false
        sh_presses = 0
        sh_hold = false
        return
    }
    var y = lg.from.y
    var p = vec3(lg.from.x, 0.0, lg.from.z)
    if y == 0.0 {
        // on the floor there; a start exactly on the seam between two floors (a bridge's end
        // at a deck's edge) is moved 0.3 m along the leg
        y = sh_floor(p.x, p.z, 90.0)
        if y < -50.0 {
            p = p + normalize(vec3(lg.to.x - p.x, 0.0, lg.to.z - p.z)) * 0.3
            y = sh_floor(p.x, p.z, 90.0)
        }
    }
    place(vec3(p.x, y, p.z), atan2(lg.to.x - lg.from.x, lg.to.z - lg.from.z))
    cam.lock = false
    sh_start = pl.pos
    sh_t = 0
    sh_air = false
    sh_presses = 0
    sh_hold = false
}
