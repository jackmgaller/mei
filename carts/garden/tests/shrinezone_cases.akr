    za(150.0, 23.2, 216.6, ZK_VDOUBLE, 1.5)
    za(150.0, 24.0, 218.4, ZK_JUMP, 1.5)
    za(150.0, 27.3, 220.9, ZK_JUMP, 1.2)
    za(150.0, 27.3, 221.75, ZK_WALK, 0.4); zn(172.5, 27.3, 221.75)
}

