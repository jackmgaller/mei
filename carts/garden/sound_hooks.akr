// The cart's side of the sound (carts/garden/audio/WIRING.md): what the player, the goals and
// the movers do, turned into sound.akr's calls. game.akr imports it after hud.akr and calls:
//
// - sound_init(): once, in init(), after cam_reset(): takes the 16 channels and the reverb,
//   then sound_world().
// - sound_world(): a world was opened (init() and world_switch()).
// - sound_tick(): each tick, after goals_tick(): the player's state changes, footsteps, loops,
//   splash, bonk, pole and hang clicks, the challenge's clock and its end, the stars coming
//   down, the last train's chime and departure melody.
// - sound_frame(): each frame, after cam_place(): coins, a star taken, the door, the train's
//   emitter, then sound.akr's frame (the zone, music, beds, reverb, emitters, timers, life).
// - sound_trig(e, p): from trig_fire() (goals.akr): the bell's rope, a shortcut, the omamori.
//
// Most events are read from the cart's own state (the coin counts, note_star_at, chal_end and
// chal_end_at, world_k) rather than called where they happen, so the cart's code stays as it
// is. Nothing here reads RAND or changes the game's state: sound never changes a scenario.
//
// Footsteps: the material is the floor's raw surface byte (pl.floor_byte; README.md, "Surfaces")
// when it names one (3 water, 4 wood, 5 gravel, 6 earth, 7 tile, 8 metal), water when wading,
// else the zone's (gen_sounds.py ZONES_TOWN). pl.floor_surf, through ground.akr's surface map,
// is what the controller reads, and sees all of 4-8 as plain ground.
import "audio/sound.akr"

var snd_prev: St
var snd_wade: fixed
var snd_pole_y: fixed
var snd_hang_at: vec3
var snd_star_was: [16]fixed     // each star's star_drop() last tick (-1: not there)
var snd_world: s32 = -1         // the world sound_world() last saw
var snd_coins: s32
var snd_reds: s32
var snd_train: s32 = -1         // the last train's mover (start flag "race5"), or -1
var snd_train_mt: s32           // its clock last tick
var snd_cycles: s32             // what sound_tick() and sound_frame() cost last frame (the tests)
var snd_tick_cycles: s32

// The last train's clock (game.py: TRAIN_DELAY 1,800, TRAIN_LEG 600, TRAIN_PAUSE 2,700): it is at
// the platform from tick 2,400 of its clock and leaves at 5,100. The chime as it stops; the
// departure melody 5.5 s before it leaves (the melody is about 5 s).
const SND_TRAIN_AT = 2400
const SND_TRAIN_DEPART = 4770
const SND_PLATFORM: vec3 = vec3(160.0, 12.0, 8.0)

fn sound_init() {
    ga_init()
    sound_world()
}

// When world_k has been opened (init() and world_switch()).
fn sound_world() {
    if snd_world >= 0 && snd_world != world_k { ga_play(GA_S_DOOR) }
    snd_world = world_k
    ga_world(world_k)
    snd_prev = pl.st
    snd_coins = coins
    snd_reds = red_coins
    for k in 0..16 { snd_star_was[k] = 0.0 }
    for k in 0..star_n { snd_star_was[k] = star_drop(stars[k]) }
    snd_train = -1
    if world_k == GARDEN_WORLD_SHRINETOWN {
        for k in 0..mover_n {
            if movers[k].start != null && streq(movers[k].start, "race5") { snd_train = k }
        }
    }
    snd_train_mt = -1
}

// Every tick, after player_tick() and goals_tick().
fn sound_tick() {
    let c0 = cycle_count()
    let s = pl.st
    let prev = snd_prev
    snd_prev = s
    let wading = pl_wade > 0.05
    let mat = ga_material(pl.floor_byte, wading)
    if s != prev {
        if s == St.Jump || s == St.Rollout { ga_jump(0) }
        else if s == St.DoubleJump { ga_jump(1) }
        else if s == St.ThirdJump || s == St.Backflip || s == St.SideFlip { ga_jump(2) }
        else if s == St.LongJump { ga_jump(3) }
        else if s == St.WallKick { ga_play(GA_S_KICK) }
        else if s == St.Bounce { ga_play(GA_S_BOUNCE) }
        else if s == St.Glide { ga_play(GA_S_GLIDE_OPEN) }
        else if s == St.LedgeHang { ga_play(GA_S_LEDGE_GRAB) }
        else if s == St.LedgeClimb { ga_play(GA_S_LEDGE_CLIMB) }
        else if s == St.PoundSpin { ga_play(GA_S_POUND_SPIN) }
        else if s == St.PoundLand { ga_land(true, mat) }
        else if s == St.Dive { ga_play(GA_S_DIVE) }
        else if s == St.Skid { ga_play(GA_S_SKID) }
        else if s == St.Pole || s == St.Rail || s == St.Hang {
            ga_play(GA_S_POLE_GRAB)
            snd_pole_y = pl.pos.y
            snd_hang_at = pl.pos
        } else if standing(s) && is_air(prev) { ga_land(false, mat) }
    }
    // into water from the air: a splash (walking in from the bank is only wet footsteps)
    if wading && snd_wade <= 0.05 && is_air(prev) { ga_play(GA_S_SPLASH) }
    snd_wade = pl_wade
    if pl.bonked { ga_play(GA_S_BONK) }
    // climbing a pole: a ratchet click every half metre; along a hang rail, hand over hand
    if s == St.Pole && abs(pl.pos.y - snd_pole_y) >= 0.5 {
        snd_pole_y = pl.pos.y
        ga_play(GA_S_POLE_CLIMB)
    }
    if s == St.Hang {
        let d = pl.pos - snd_hang_at
        if abs(d.x) + abs(d.z) >= 0.7 {
            snd_hang_at = pl.pos
            ga_sound(GA_S_POLE_CLIMB, GA_SND[GA_S_POLE_CLIMB * 6 + 4] * 3 / 4, 0, 0.85, GA_PRI_ROBOT)
        }
    }
    // the robot's loop
    if s == St.Glide { ga_loop(GA_S_GLIDE, 120, 1.0) }
    else if s == St.Rail { ga_loop(GA_S_RAIL_GRIND, 130, 0.8 + hspeed() * 2.0) }
    else if s == St.WallSlide { ga_loop(GA_S_WALL_SLIDE, 120, 1.0) }
    else if s == St.BellySlide || s == St.Slide || s == St.CrouchSlide { ga_loop(GA_S_WALL_SLIDE, 80, 0.75) }
    else { ga_loop(-1, 0, 1.0) }
    // footsteps
    ga_walk(hspeed(), s == St.Ground, pl.floor_byte, wading)
    // the challenge's clock, and its end this tick (trig_fire() wins it, goals_tick() or a
    // respawn loses it)
    ga_clock(chal_left)
    if chal_end_at == sim_t && chal_end == 1 { ga_play(GA_S_WON) }
    if chal_end_at == sim_t && chal_end == 2 { ga_play(GA_S_LOST) }
    // stars coming down
    for k in 0..star_n {
        let d = star_drop(stars[k])
        if d > 0.0 && snd_star_was[k] < 0.0 { ga_star_appear(wp_entity_pos(stars[k])) }
        snd_star_was[k] = d
    }
    // the last train: the chime as it stops at the platform, the melody before it leaves
    if snd_train >= 0 {
        let mt = movers[snd_train].mt
        if mt >= SND_TRAIN_AT && snd_train_mt < SND_TRAIN_AT && snd_train_mt >= 0 { ga_play_at(GA_S_STATION_CHIME, SND_PLATFORM, 12, 110) }
        if mt >= SND_TRAIN_DEPART && snd_train_mt < SND_TRAIN_DEPART && snd_train_mt >= 0 { ga_play_at(GA_S_DEPARTURE, SND_PLATFORM, 12, 110) }
        snd_train_mt = mt
    }
    snd_tick_cycles += cycle_count() - c0
}

// From trig_fire(), once it has fired: the stage's bell rope rings the bell (heard in the whole
// level); the kept triggers (the shortcuts) and a timed one (the omamori, starting the clock)
// sound the shortcut.
fn sound_trig(e: *WpEntity, p: *GardenTrigger) {
    let nm = pname(p.flag)
    if nm != null && streq(nm, "bell") { ga_bell(wp_entity_pos(e)) }
    else if p.keep || p.timer > 0 { ga_play(GA_S_SHORTCUT) }
}

// Every frame, after cam_place().
fn sound_frame() {
    let c0 = cycle_count()
    if world_k != snd_world { sound_world() }
    // coins (collect_coins() counts them; world_switch() sets them back to 0)
    if coins > snd_coins { ga_play(GA_S_COIN) }
    if red_coins > snd_reds {
        if red_total > 0 && red_coins >= red_total { ga_play(GA_S_RED_ALL) } else { ga_red_coin(red_coins) }
    }
    snd_coins = coins
    snd_reds = red_coins
    // a star taken this frame (goals_collect())
    if note_star_at == sim_t { ga_star_get() }
    // the train, moving
    if snd_train >= 0 {
        let m = &movers[snd_train]
        ga_emitter_move(GA_EM_TRAIN, m.pos + vec3(0.0, 2.0, 0.0), mover_live(m))
    }
    ga_frame(cam.eye, cam.yaw, pl.pos)
    snd_cycles = snd_tick_cycles + cycle_count() - c0
    snd_tick_cycles = 0
}
