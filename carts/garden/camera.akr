// The follow camera (the camera worker's file), in the spirit of Mario 64's: behind and above
// the player, turned by the right stick (or the d-pad when the tuning menu is closed), swung
// behind the player by L, and turned slowly behind a running or gliding player. The numbers
// are tuning.akr's camera block (T.Cam*).
//
// Height: the camera follows the ground the player last stood on, not every jump. In the air
// it keeps the take-off height until the feet go more than CamBand above it or drop below it;
// on the ground it eases to the new height (CamLift) up, and follows at once down. It looks at
// a point CamTilt of the way from that height up to the player's head, so a jump tilts the view
// a little instead of moving the eye.
//
// Walls: once a frame a segment from the player's head to the eye (and CAM_MARGIN past it)
// goes through wp_ray(). Something in the way pulls the eye in at once to CAM_MARGIN short of
// it, then moved CAM_PUSH off the surface when a second ray finds that clear; the eye goes
// back out at CamPullOut m/s, so a pull-in that changes from frame to frame does not jitter.
// A wall that pulls the eye in also turns the camera along it (CamWallTurn, faster the further
// in), toward the side that is free, unless the stick turned it in the last CamHold ticks.
// Pulled in closer than CAM_NEAR, it looks down at the player's middle. Before all that, the
// eye is lifted to stand CAM_CLEAR above the floor under it (slopes, steps).
// Cost: two rays at most and one floor query a frame, about 4,000-12,000 cycles.
//
// Zones: the world's camera_zone entities (read once, in cam_reset()), boxes in world axes.
// While the player's feet are inside one, the camera eases (CamZoneEase) to the zone's view:
//   fixed: on the line through the box's centre along `look`, CamZoneDist behind the player
//          along it (backing away when the player comes toward it); it turns to face `look`.
//   rail:  on the box's long axis, at the player's place along it, CamZoneDist back against
//          the way the player is going along the axis (chosen on entry from its velocity, or
//          its facing when still; `look` only breaks a tie), so it looks ahead of a runner either
//          way; running back the other way for CAM_BACK_TICKS turns it round (CAM_ZONE_TURN a
//          tick, the eye swinging round the player).
//   follow: the normal camera.
// In both, the eye's height rises with the player (CamZoneRise above the feet, eased by
// CamLift) and it pitches to keep the player's middle in view. The zone the player is in is held
// until the feet leave it, even where another overlaps it (the alleys' crossings), and a change
// from one zone to the next turns the view (CAM_ZONE_TURN a tick) instead of jumping. A world
// with more zones than CAM_MAX_ZONES fails to load (cam_read_zones()), as poles and rails do.
//
// The body is not drawn while the eye is closer to the head than CAM_BODY_HIDE (a stairwell, a
// cave's back): the screen would be the robot's head (game.akr's draw()).
//
// The opening (cam_intro(), when a world opens): for CAM_INTRO ticks the view looks up, level
// with the horizon, along the spawn's facing (the level's axis), then eases back; the stick, L
// or a run ends it sooner.
//
// cam.lock (the tests) holds the yaw: no following, no zones, so the stick stays world-fixed.
// An outside change to cam.yaw is taken as it is (the frame-timing sweep sets it).

const CAM_HEAD: fixed = 1.3      // the walls ray starts this far above the feet (the head)
const CAM_MARGIN: fixed = 0.35   // the eye stays this far short of what blocks it (near 0.1)
const CAM_PUSH: fixed = 0.2      // and this far off its surface, when that is clear
const CAM_CLEAR: fixed = 0.5     // the eye stays this far above the floor under it
const CAM_MIN: fixed = 0.15      // the eye comes no closer to the head than this
const CAM_NEAR: fixed = 2.5      // pulled in closer than this, it looks more at the player
const CAM_PITCH_LO: fixed = -1.3
const CAM_PITCH_HI: fixed = 0.7
const CAM_MAX_ZONES = 24
const CAM_ZONE_TURN: fixed = 0.06  // a zone's view turning to a new look, radians a tick
const CAM_BACK_TICKS = 40          // running against a rail zone's look this long turns it round
const CAM_BACK_SPEED: fixed = 2.0  // m/s against it that counts
const CAM_BODY_HIDE: fixed = 0.8   // the body is not drawn with the eye nearer the head than this
const CAM_INTRO = 150              // the opening's ticks (the last 60 easing back)
const CAM_INTRO_PITCH: fixed = 0.02
const CAM_RECENTRE: fixed = 0.15 // L: the share of the angle left that is turned each tick,
const CAM_SWING_MAX: fixed = 0.08 // at most this (radians a tick: 4.8 a second)

struct CamZone {
    lo: vec3            // the box (world)
    hi: vec3
    mode: s32           // GardenCameraZoneMode as s32
    look: vec3          // horizontal unit; zero: the game's choice (the yaw on entry)
    along_x: bool       // its long axis (a rail's) is x
}

struct Cam {
    eye: vec3          // world
    target: vec3       // what it looks at (world)
    yaw: fixed         // the view's heading, which the stick is turned by
    pitch: fixed
    lock: bool         // the tests hold the yaw still
    // follow
    base: fixed        // the height of the ground followed (feet)
    fy: fixed          // the follow focus's height (eased)
    hold: s32          // ticks left before following again after a manual turn
    swing: bool        // L: turning behind the player
    swing_to: fixed
    reach: fixed       // how far the eye is from the head (pulled in, easing out)
    squeeze: fixed     // 0 (free) .. 1: how far a wall pulled the eye in this frame
    wall_n: vec3       // that wall's normal (horizontal, toward the head)
    lift: fixed        // how far the eye is lifted off the floor under it
    // zones
    zone: s32          // the zone being blended in or out, or -1
    w: fixed           // 0 (follow) .. 1 (the zone's view), linear
    zy: fixed          // the zone eye's height (eased)
    zyaw: fixed        // the zone's view's heading (eased toward zwant)
    zwant: fixed       // the heading it turns to: chosen on entry (a rail's: by the player's way)
    zback: s32         // ticks the player has run against a rail zone's look
    intro: s32         // the opening's ticks left (cam_intro())
    // for the tests
    blocked: bool      // the walls ray found something this frame
    cycles: s32        // the cost of the last cam_place() and the cam_tick()s before it
    tick_cycles: s32
}

var cam: Cam
var cam_zones: [CAM_MAX_ZONES]CamZone
var cam_zone_n: s32 = -1          // -1: the world not read yet

fn cam_head() -> vec3 { return pl.pos + vec3(0.0, CAM_HEAD, 0.0) }

// Read the world's camera zones (once).
fn cam_read_zones() {
    cam_zone_n = 0
    for n in 0..wp_pack.entity_count as s32 {
        let e = wp_entity(n)
        if e.type_id as s32 != GARDEN_TYPE_CAMERA_ZONE { continue }
        assert(cam_zone_n < CAM_MAX_ZONES)      // a world with more zones than the cart holds stops here
        let p = wp_entity_params(e) as *GardenCameraZone
        if p == null { continue }
        let at = wp_entity_pos(e)
        let h = vec3(p.size.x / 2, 0.0, p.size.z / 2)
        var z = CamZone {}
        z.lo = at - h
        z.hi = at + h + vec3(0.0, p.size.y, 0.0)
        z.mode = p.mode as s32
        let lh = vec3(p.look.x, 0.0, p.look.z)
        if abs(lh.x) + abs(lh.z) > 0.001 { z.look = normalize(lh) }
        z.along_x = p.size.x > p.size.z
        cam_zones[cam_zone_n] = z
        cam_zone_n += 1
    }
}

fn cam_in_zone(k: s32, p: vec3) -> bool {
    let z = &cam_zones[k]
    return p.x >= z.lo.x && p.x <= z.hi.x && p.z >= z.lo.z && p.z <= z.hi.z && p.y >= z.lo.y - 1.0 && p.y <= z.hi.y
}

// The zone (not a follow one) the player's feet are in, or -1.
fn cam_zone_at(p: vec3) -> s32 {
    for k in 0..cam_zone_n {
        if cam_zones[k].mode == GardenCameraZoneMode.Follow as s32 { continue }
        if cam_in_zone(k, p) { return k }
    }
    return -1
}

// The zone the player is in now: the one it was in while the feet stay in it (hysteresis where
// zones overlap), else the first that has them.
fn cam_zone_now(p: vec3) -> s32 {
    if cam.zone >= 0 && cam.w > 0.0 && cam_in_zone(cam.zone, p) { return cam.zone }
    return cam_zone_at(p)
}

// A rail zone's heading: along its long axis, the way the player goes along it (its velocity, or
// its facing when nearly still); `look` breaks a tie (going across the axis).
fn cam_rail_yaw(z: *CamZone) -> fixed {
    var a = vec3(0.0, 0.0, 1.0)
    if z.along_x { a = vec3(1.0, 0.0, 0.0) }
    var v = vec3(pl.vel.x, 0.0, pl.vel.z)
    if hspeed() < 0.02 { v = fwd_dir(pl.yaw) * 0.1 }
    var s = dot(v, a)
    if abs(s) < tlen(v) * 0.3 && abs(z.look.x) + abs(z.look.z) > 0.0 { s = dot(z.look, a) }
    if s < 0.0 { a = -a }
    return yaw_of(a)
}

fn cam_reset() {
    if cam_zone_n < 0 { cam_read_zones() }
    cam.yaw = pl.yaw
    cam.pitch = tv[T.CamPitch]
    cam.base = pl.pos.y
    cam.fy = pl.pos.y + tv[T.CamHeight]
    cam.hold = 0
    cam.swing = false
    cam.reach = 1000.0
    cam.lift = 0.0
    cam.zone = -1
    cam.w = 0.0
    cam.intro = 0
    if !cam.lock {
        cam.zone = cam_zone_at(pl.pos)
        if cam.zone >= 0 {
            cam.w = 1.0
            cam_enter_zone(false)
            cam.yaw = cam.zyaw
        }
    }
    cam.zy = pl.pos.y + tv[T.CamZoneRise]
    cam.target = pl.pos + vec3(0.0, tv[T.CamHeight], 0.0)
    cam_place()
}

// The zone cam.zone entered: its heading; turned to (from another zone's) or taken at once.
fn cam_enter_zone(turn: bool) {
    let z = &cam_zones[cam.zone]
    if z.mode == GardenCameraZoneMode.Rail as s32 {
        cam.zwant = cam_rail_yaw(z)
    } else if z.look.x == 0.0 && z.look.z == 0.0 {
        cam.zwant = cam.yaw
    } else {
        cam.zwant = yaw_of(z.look)
    }
    if !turn { cam.zyaw = cam.zwant }
    cam.zback = 0
}

// The opening view (a world opened): looking up the spawn's way, level, for CAM_INTRO ticks.
fn cam_intro() { cam.intro = CAM_INTRO }

fn smooth01(w: fixed) -> fixed { return w * w * (3.0 - w * 2) }

// Each tick: turn by `turn` (-1..1, the stick or d-pad), swing behind the player on L, follow
// its facing while it runs or glides, follow its height, and blend zones in and out.
fn cam_tick(turn: fixed, recentre: bool) {
    let c0 = cycle_count()
    // zones
    var want_w: fixed = 0.0
    if !cam.lock {
        let z = cam_zone_now(pl.pos)
        if z >= 0 {
            if z != cam.zone {
                let from_zone = cam.zone >= 0 && cam.w > 0.0
                cam.zone = z
                cam_enter_zone(from_zone)
            }
            want_w = 1.0
        }
    }
    if cam.zone >= 0 {
        // a rail zone: run back against its look a while and it turns round
        if want_w > 0.0 && cam_zones[cam.zone].mode == GardenCameraZoneMode.Rail as s32 {
            let d = fwd_dir(cam.zwant)
            if pl.vel.x * d.x + pl.vel.z * d.z < -CAM_BACK_SPEED / 60 { cam.zback += 1 } else { cam.zback = 0 }
            if cam.zback > CAM_BACK_TICKS {
                cam.zwant = wrap_angle(cam.zwant + PI)
                cam.zback = 0
            }
        }
        cam.zyaw = wrap_angle(cam.zyaw + clamp(wrap_angle(cam.zwant - cam.zyaw), -CAM_ZONE_TURN, CAM_ZONE_TURN))
    }
    // the opening: ended by the stick, L or a run
    if cam.intro > 0 {
        cam.intro -= 1
        if turn != 0.0 || recentre || (pl.st == St.Ground && pl.fwd > mps(T.RunSpeed) / 2) { cam.intro = min(cam.intro, 60) }
    }
    let dw = tv[T.CamZoneEase] / 60
    if want_w > 0.0 { cam.w = min(cam.w + dw, 1.0) } else { cam.w = max(cam.w - dw, 0.0) }
    if cam.w == 0.0 { cam.zone = -1 }
    let in_zone = want_w > 0.0

    // turning
    if turn != 0.0 && !in_zone {
        cam.yaw = wrap_angle(cam.yaw + turn * rps(T.CamOrbit))
        cam.hold = ticks(T.CamHold)
        cam.swing = false
    }
    if recentre {
        cam.swing = true
        cam.swing_to = pl.yaw
    }
    if in_zone && !cam.lock {
        cam.swing = false
        let k = smooth01(cam.w) * 0.1
        cam.yaw = wrap_angle(cam.yaw + wrap_angle(cam.zyaw - cam.yaw) * k)
    } else if cam.swing {
        let d = wrap_angle(cam.swing_to - cam.yaw)
        if abs(d) < 0.01 {
            cam.yaw = cam.swing_to
            cam.swing = false
        } else {
            cam.yaw = wrap_angle(cam.yaw + clamp(d * CAM_RECENTRE, -CAM_SWING_MAX, CAM_SWING_MAX))
        }
    } else if cam.hold > 0 {
        cam.hold -= 1
    } else if !cam.lock && turn == 0.0 {
        // A wall pulling the eye in turns the camera along it, toward the side that is free.
        if cam.squeeze > 0.0 {
            let b = fwd_dir(cam.yaw)
            if dot(b, cam.wall_n) > 0.0 {
                var r = rps(T.CamWallTurn) * cam.squeeze
                if b.z * cam.wall_n.x - b.x * cam.wall_n.z > 0.0 { r = -r }
                cam.yaw = wrap_angle(cam.yaw + r)
            }
        }
        // Turn behind a runner, faster the faster it goes and the more it runs away from the
        // camera; not at all toward the camera (no swinging round).
        var speed: fixed = 0.0
        if pl.st == St.Ground { speed = pl.fwd / max(mps(T.RunSpeed), 0.01) }
        if pl.st == St.Glide { speed = 1.0 }
        if speed > 0.0 {
            let d = wrap_angle(pl.yaw - cam.yaw)
            let k = rps(T.CamFollow) * min(speed, 1.0) * (1.0 + cos(d)) / 2
            cam.yaw = wrap_angle(cam.yaw + d * k)
        }
    }

    // height: the ground followed, and the focus eased to it
    let feet = pl.pos.y
    let band = tv[T.CamBand]
    if pl.st == St.Ground || pl.st == St.Skid || pl.st == St.Crouch || pl.st == St.CrouchSlide || pl.st == St.Slide || pl.st == St.BellySlide || pl.st == St.PoundLand {
        cam.base = feet
    } else {
        cam.base = clamp(cam.base, feet - band, feet)
    }
    let h = tv[T.CamHeight]
    cam.fy = cam.fy + (cam.base + h - cam.fy) * tv[T.CamLift] / 60
    cam.fy = clamp(cam.fy, feet + h - band, feet + h)
    cam.zy = cam.zy + (feet + tv[T.CamZoneRise] - cam.zy) * tv[T.CamLift] / 60
    cam.zy = max(cam.zy, feet + 0.5)
    cam.tick_cycles += cycle_count() - c0
}

// The zone's eye (world), before walls.
fn cam_zone_eye() -> vec3 {
    let z = &cam_zones[cam.zone]
    let c = (z.lo + z.hi) / 2
    let lk = fwd_dir(cam.zyaw)
    let p = pl.pos
    var e: vec3
    if z.mode == GardenCameraZoneMode.Rail as s32 {
        var q = vec3(c.x, 0.0, clamp(p.z, z.lo.z, z.hi.z))
        if z.hi.x - z.lo.x > z.hi.z - z.lo.z { q = vec3(clamp(p.x, z.lo.x, z.hi.x), 0.0, c.z) }
        e = q - lk * tv[T.CamZoneDist]
    } else {
        let s = lk.x * (p.x - c.x) + lk.z * (p.z - c.z) - tv[T.CamZoneDist]
        e = vec3(c.x + lk.x * s, 0.0, c.z + lk.z * s)
    }
    e.y = cam.zy
    return e
}

// Once a frame: the eye from the follow and zone views, lifted off the floor, pulled in to what
// blocks it from the head; the pitch to what it looks at.
fn cam_place() {
    let c0 = cycle_count()
    let h = tv[T.CamHeight]
    let head = cam_head()

    // the follow view: from the focus back along the yaw and pitch
    let cp = cos(tv[T.CamPitch])
    let f = vec3(sin(cam.yaw) * cp, sin(tv[T.CamPitch]), cos(cam.yaw) * cp)
    let focus = vec3(pl.pos.x, cam.fy, pl.pos.z)
    var eye = focus - f * tv[T.CamDist]
    var look = vec3(pl.pos.x, cam.fy + (pl.pos.y + h - cam.fy) * tv[T.CamTilt], pl.pos.z)
    if cam.zone >= 0 && cam.w > 0.0 {
        let s = smooth01(cam.w)
        eye = lerp(eye, cam_zone_eye(), s)
        look = lerp(look, pl.pos + vec3(0.0, 0.9, 0.0), s)
    }

    // off the floor under it: lifted at once, let down slowly
    var need: fixed = 0.0
    if wp_floor(eye, 1.0) { need = max(wp_hit.y + CAM_CLEAR - eye.y, 0.0) }
    cam.lift = max(need, cam.lift - 0.05)
    eye.y += cam.lift

    // out of the walls: in at once, out at CamPullOut
    let d = eye - head
    let len = max(length(d), 0.01)
    let dir = d / len
    var free = len
    cam.blocked = false
    cam.squeeze = 0.0
    if wp_ray(head, head + dir * (len + CAM_MARGIN)) {
        free = max(wp_hit.t * (len + CAM_MARGIN) - CAM_MARGIN, CAM_MIN)
        cam.blocked = true
        if wp_hit.kind == WP_WALL {
            let n = wp_hit_normal()
            let nh = vec3(n.x, 0.0, n.z)
            if abs(nh.x) + abs(nh.z) > 0.1 {
                cam.wall_n = normalize(nh)
                if dot(cam.wall_n, dir) > 0.0 { cam.wall_n = -cam.wall_n }
                cam.squeeze = 1.0 - free / len
            }
        }
    }
    if free < cam.reach {
        cam.reach = free
    } else {
        cam.reach = min(cam.reach + tv[T.CamPullOut] / 60, free)
    }
    eye = head + dir * cam.reach
    if cam.blocked && cam.reach == free {
        // close to the surface: step off it if that is clear too
        var n = wp_hit_normal()
        if dot(n, dir) > 0.0 { n = -n }
        let off = eye + n * CAM_PUSH
        if !wp_ray(head, off) { eye = off }
    }
    // pulled in close: look at the player's middle, not over it
    let near = clamp((CAM_NEAR - cam.reach) / (CAM_NEAR - CAM_MIN), 0.0, 1.0)
    look = lerp(look, pl.pos + vec3(0.0, 0.8, 0.0), near)
    cam.eye = eye
    cam.target = look

    // the pitch to the look point, along the yaw
    let v = look - eye
    let ahead = max(v.x * sin(cam.yaw) + v.z * cos(cam.yaw), 0.3)
    cam.pitch = clamp(atan2(v.y, ahead), CAM_PITCH_LO, CAM_PITCH_HI)
    if cam.intro > 0 {
        let u = smooth01(min(fixed(cam.intro) / 60, 1.0))
        cam.pitch = lerp(cam.pitch, CAM_INTRO_PITCH, u)
    }
    cam.cycles = cycle_count() - c0 + cam.tick_cycles
    cam.tick_cycles = 0
}
