// The player drawn: the robot (robot/robot.akr), posed by what it is doing. The gem on its
// antenna shows the state's colour, as the stand-in box's colour did (a good wall kick green, a
// late one yellow-green).
import "robot/robot.akr"

fn body_init() { robot_init() }

fn state_colour(s: St) -> u32 {
    if s == St.WallSlide { return rgb(250, 160, 40) }
    if s == St.WallKick {
        if pl.kick_good { return rgb(120, 240, 120) }
        return rgb(200, 200, 90)
    }
    if s == St.Glide { return rgb(110, 170, 250) }
    if s == St.LedgeHang || s == St.LedgeClimb { return rgb(200, 120, 230) }
    if s >= St.PoundSpin && s <= St.PoundLand { return rgb(140, 90, 60) }
    if s == St.Dive || s == St.BellySlide { return rgb(240, 120, 170) }
    return rgb(255, 205, 80)
}

var body_test_mode: s32       // the tests: 1 draws the body alone (nothing else this frame)
var body_test_wade: fixed     // the pose sheet: a water depth to wade in

// How deep the feet are in water, for the wading walk (0: dry). The garden has no water yet;
// a world with water answers here (the shrine's player.akr keeps it in pl_wade).
fn body_wade() -> fixed { return body_test_wade }

fn body_draw() {
    if body_test_mode == 1 { ot_clear() }      // the world's faces so far: dropped
    robot_draw(pl.pos - wp_view_origin(), body_wade(), state_colour(pl.st))
}
