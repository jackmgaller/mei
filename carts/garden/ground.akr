// The world the garden runs on, and everything about it that is not the same in every world:
// which generated file to import, how to open it, where the player starts and what its surface
// bytes mean. Nothing else in the cart names a world.
//
// Today this is the World Kit's test_room (examples/worlds/test_room, listed in worlds.txt),
// until the garden's grey box is merged. Its game schema is also called "garden", so the
// GARDEN_PROBE_* constants and GARDEN_TYPE_COIN are the same names in both.
//
// Switching to the garden world: in worlds.txt, replace the line with
// carts/garden/world/garden.world.json; here, replace the TEST ROOM block with the GARDEN
// block below it (uncommented). The rest of the cart does not change.

// ---- TEST ROOM
import "test_room.akr"

fn world_load() -> bool { return world_test_room_load() }

// No spawn entity in test_room: the middle of the room's floor, looking +Z.
const WORLD_SPAWN: vec3 = vec3(32.0, 0.0, 30.0)
const WORLD_SPAWN_YAW: fixed = 0.0
fn world_spawn_type() -> s32 { return -1 }

// test_room's tags are floor 1, ledge 1, slope 2, wall 3, roof 4: none of them means anything
// to the controller, so every byte reads as 0 (normal). The tests map bytes themselves.
const WORLD_SURFACES: [8]u8 = [0, 0, 0, 0, 0, 0, 0, 0]
// ---- END TEST ROOM

// ---- GARDEN (carts/garden/README.md: the surface bytes and the spawn entity)
// NOTE: a world named "garden" generates garden.akr, and an import looks next to the importing
// file first, so it would find this cart's own garden.akr. The world needs another name (or
// the main session decides otherwise); WORLD is that name below.
// import "WORLD.akr"
// fn world_load() -> bool { return world_WORLD_load() }
// const WORLD_SPAWN: vec3 = vec3(44.0, 0.0, 121.0)    // used only if the world has no spawn
// const WORLD_SPAWN_YAW: fixed = 3.1416
// fn world_spawn_type() -> s32 { return GARDEN_TYPE_SPAWN }
// const WORLD_SURFACES: [8]u8 = [0, 1, 2, 0, 0, 0, 0, 0]
// ---- END GARDEN

// The probe the kit classified collision for (the game schema's): the player's body.
const BODY_RADIUS: fixed = GARDEN_PROBE_RADIUS
const BODY_HEIGHT: fixed = GARDEN_PROBE_HEIGHT
const BODY_STEP: fixed = GARDEN_PROBE_STEP
const COIN_TYPE = GARDEN_TYPE_COIN
