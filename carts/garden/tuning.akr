// The glider's deploy modes (T.GlideMode).
const GLIDE_THIRD = 0      // only from the third jump: hold the button through its apex
const GLIDE_DOUBLE = 1     // only from the double jump: hold the button through its apex
const GLIDE_EITHER = 2

const GLIDE_MODE_NAMES: [3]*u8 = ["third", "double", "either"]

var tv: [len(T)]fixed

fn tune_defaults() {
    for t in T { tv[t] = TUNE[t].def }
}

fn tune_set(t: T, v: fixed) { tv[t] = clamp(v, TUNE[t].lo, TUNE[t].hi) }

fn mps(t: T) -> fixed { return tv[t] / 60 }        // m/s -> metres a tick
fn mps2(t: T) -> fixed { return tv[t] / 3600 }     // m/s2 -> metres a tick per tick
fn rps(t: T) -> fixed { return tv[t] / 60 }        // radians a second -> radians a tick
fn ticks(t: T) -> s32 { return tv[t] as s32 }
fn rad_of(t: T) -> fixed { return tv[t] * PI / 180 }

// ---- what the numbers come to (shown under the menu)

// The apex of a jump from rest at vy (m/s) under gravity: vy^2 / 2g.
fn apex_of(vy: fixed) -> fixed { return vy * vy / (tv[T.Gravity] * 2) }

// Horizontal distance of a jump at vy (m/s) and h (m/s) landing at the height it left.
fn reach_of(vy: fixed, h: fixed) -> fixed { return h * vy * 2 / tv[T.Gravity] }

// Metres forward per metre lost, gliding.
fn glide_ratio() -> fixed { return tv[T.GlideSpeed] / tv[T.GlideSink] }
