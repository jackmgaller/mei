// Every movement number, adjustable in the game (the tuning menu, hud.akr). Values are in the
// units a person thinks in: metres, metres a second (m/s), m/s per second (m/s2), radians a
// second (r/s), degrees, multipliers (x) and ticks (t, 1/60 s; timing windows are counted in
// ticks, never in presented frames). The defaults start from Super Mario 64, where one unit
// is about a centimetre and the game runs at 30 frames a second: u/f x 0.3 = m/s, and
// u/f per frame x 9 = m/s2.
//
// The code reads them through mps() (m/s -> metres a tick), mps2() (m/s2 -> metres a tick per
// tick), rps() (r/s -> radians a tick) and ticks().

enum T {
    // running
    RunSpeed, RunAccel, RunDrag, StopDecel, TurnRate, SkidSpeed, SkidDecel, CrawlSpeed,
    // jumping
    Gravity, FallMax, JumpVy, JumpSpeedAdd, JumpCut, DoubleVy, ChainWindow, ThirdVy, ThirdSpeed,
    AirAccel, AirTurn, AirMax, AirDrag,
    // crouch moves
    SlideMin, CrouchDecel, LongVy, LongMul, LongMax, LongMin, FlipVy, FlipBack, SideFlip,
    // glider
    GlideMode, GlideSpeed, GlideSink, GlideTurn, GlideEase,
    // wall kick
    KickEarly, KickSlide, KickBuffer, KickVyGood, KickHGood, KickVyLate, KickHLate,
    WallFall0, WallFall1, KickMinSpeed, KickTilt, KickRegrab,
    // ledges
    LedgeLow, LedgeHigh, LedgeClimb,
    // ground pound and dive
    PoundHang, PoundFall, PoundLand, DiveBoost, DiveMax, DiveVy, BellyDecel, RolloutVy,
    // slopes and surfaces
    SlideAngle, SlopeGrav, SlideFriction, SlideMax, SlopeWalk, BounceVy,
    // camera
    CamDist, CamHeight, CamPitch, CamOrbit, CamFollow,
}

