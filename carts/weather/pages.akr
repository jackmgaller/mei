// The pages: current conditions, the 5-day and 24-hour forecasts, the map with its cities,
// the regions directory and the clock, and the one calm placeholder they show until a
// location's weather has arrived.

// ---- helpers

// The name a location goes by on screen: its city ("New York"), the home city's name once a
// page has given it, or the region for the national map.
fn loc_name(i: s32) -> *u8 {
    let l = &locs[i]
    if l.city[0] != 0 { return bc_name(&l.city[0]) }
    if loc_is_home(i) && wx_has(i, K_NOW) && wx[i].cur.city[0] != 0 { return bc_name(&wx[i].cur.city[0]) }
    return bc_name(&l.region[0])
}

fn loc_region(i: s32) -> *u8 { return bc_name(&locs[i].region[0]) }

// Whether it is night at location i now (the current conditions' daytime flag).
fn loc_night(i: s32) -> bool {
    if i >= 0 && wx_has(i, K_NOW) { return wx[i].cur.flags & 1 == 0 }
    return clk.hour < 6 || clk.hour >= 19
}

const WAITING = "Waiting for the weather..."

// The placeholder: a gently drifting cloud and one line, until the page has arrived.
fn waiting_draw(t: s32) {
    panel(6, BODY_Y, 308, BODY_H)
    gloss(6, BODY_Y + 1, 308, 40)
    icon_draw(BC_ICON_PARTLY, 160, 100, false, t, false)
    txt_s(F_MED, 160, 128, WAITING, WHITE, ALIGN_CENTRE)
}

// ---- current conditions

private fn stat_row(y: s32, label: *u8, value: *u8) {
    txt(F_SMALL, 162, y, label, C_SOFT)
    txt_a(F_SMALL, 306, y, value, WHITE, ALIGN_RIGHT)
}

fn now_draw(i: s32, t: s32) {
    if !wx_has(i, K_NOW) {
        waiting_draw(t)
        return
    }
    let c = &wx[i].cur
    let night = c.flags & 1 == 0
    panel(6, BODY_Y, 308, BODY_H)
    gloss(6, BODY_Y + 1, 308, 40)
    rect(154, 38, 1, 168, 0x8A4424)
    // left: the icon and the conditions
    icon_draw(icon_of(c.wmo as s32), 80, 86, true, t, night)
    txt_s(F_MED, 80, 134, bc_wmo_text(c.wmo as s32), WHITE, ALIGN_CENTRE)
    if temp_known(c.feels as s32) {
        txt_a(F_SMALL, 80, 156, s_cat("Feels like ", s_temp(c.feels as s32)), C_SOFT, ALIGN_CENTRE)
    }
    // sunrise and sunset, under the conditions
    rect(18, 180, 124, 1, 0x8A4424)
    if c.sunrise as s32 != 0xFFFF {
        spr(G_RISE, 9, 186)
        txt(F_SMALL, 32, 192, s_clock(c.sunrise as s32), WHITE)
    }
    if c.sunset as s32 != 0xFFFF {
        spr(G_SET, 82, 186)
        txt(F_SMALL, 105, 192, s_clock(c.sunset as s32), WHITE)
    }
    // right: the temperature, today's high and low
    let tx = txt_s(F_HUGE, 162, 36, s_temp_n(c.temp as s32), WHITE, ALIGN_LEFT)
    txt_s(F_MED, tx + 1, 38, s_cat("`", unit_letter()), C_SOFT, ALIGN_LEFT)
    txt(F_SMALL, 252, 44, "High", C_SOFT)
    txt_a(F_MED, 306, 41, s_temp(c.high as s32), ramp_rgb(c.high as s32), ALIGN_RIGHT)
    txt(F_SMALL, 252, 64, "Low", C_SOFT)
    txt_a(F_MED, 306, 61, s_temp(c.low as s32), ramp_rgb(c.low as s32), ALIGN_RIGHT)
    rect(162, 92, 144, 1, 0x8A4424)
    var y = 100
    stat_row(y, "Humidity", s_pct(c.humidity as s32))
    y += 17
    stat_row(y, "Wind", s_wind(c.wind_dir as s32, c.wind as s32))
    y += 17
    if c.gusts as s32 != 255 && c.gusts > c.wind {
        stat_row(y, "Gusts", s_wind(255, c.gusts as s32))
        y += 17
    }
    stat_row(y, "Pressure", s_pressure(c.pressure as s32))
    y += 17
    stat_row(y, "Chance of rain", s_pct(c.pop as s32))
    y += 17
    if c.uv as s32 != 255 {
        let b = sbuf()
        str_append_int(b, SB, (c.uv as s32 + 5) / 10, 0, false)
        stat_row(y, "UV index", b)
    }
}

// ---- the 5-day forecast

const DAY_COND_W = 54

// Splits a description over two lines at a space if it is too wide for a column.
private fn two_lines(s: *u8) -> *u8 {
    if txt_w(F_TINY, s) <= DAY_COND_W { return s }
    let b = sbuf()
    str_copy(b, SB, s)
    // break at the last space that leaves the first line narrow enough
    var best = -1
    var i = 0
    while b[i] != 0 {
        if b[i] == ' ' {
            b[i] = 0
            let w = txt_w(F_TINY, b)
            b[i] = ' '
            if w <= DAY_COND_W { best = i }
        }
        i += 1
    }
    if best >= 0 { b[best] = '\n' }
    return b
}

fn week_draw(i: s32, t: s32) {
    if !wx_has(i, K_WEEK) {
        waiting_draw(t)
        return
    }
    let d = &wx[i].daily
    panel(6, BODY_Y, 308, BODY_H)
    let n = clamp(d.count as s32, 1, 5)
    for k in 0..n {
        let day = &d.day[k]
        let x = 10 + k * 61
        let cx = x + 29
        rect_grad(x, 34, 58, 176, 0xB05A34, 0x7A3018, BLEND_NONE)
        rect_blend(x, 34, 58, 1, 0xF8C890, BLEND_NONE)
        var name = DAY_SHORT[day.weekday as s32 % 7]
        if k == 0 { name = "Today" }
        txt_s(F_MED, cx, 39, name, WHITE, ALIGN_CENTRE)
        icon_draw(icon_of(day.wmo as s32), cx, 80, false, t + k * 37, false)
        txt_a(F_TINY, cx, 105, two_lines(bc_wmo_text(day.wmo as s32)), C_SOFT, ALIGN_CENTRE)
        txt_s(F_BIG, cx, 126, s_temp(day.high as s32), WHITE, ALIGN_CENTRE)
        // the day's range as a strip of the temperature ramp
        rect_hgrad(x + 6, 157, 46, 2, ramp_rgb(day.low as s32), ramp_rgb(day.high as s32), BLEND_NONE)
        txt_a(F_MED, cx, 164, s_temp(day.low as s32), C_SOFT, ALIGN_CENTRE)
        if day.pop as s32 != 255 {
            let w = txt_w(F_SMALL, s_pct(day.pop as s32)) + 10
            spr(G_DROP, cx - w / 2, 191)
            txt(F_SMALL, cx - w / 2 + 10, 190, s_pct(day.pop as s32), C_CYAN)
        }
    }
}

// ---- the 24-hour forecast

const HR_X0 = 26
const HR_DX = 12
const HR_TOP = 86
const HR_BOT = 168

fn hours_draw(i: s32, t: s32) {
    if !wx_has(i, K_HOURS) {
        waiting_draw(t)
        return
    }
    let h = &wx[i].hourly
    let n = clamp(h.count as s32, 2, 24)
    panel(6, BODY_Y, 308, BODY_H)
    // night hours a little darker, from the location's sunrise and sunset
    var sr = 6 * 60 + 30
    var ss = 19 * 60
    if wx_has(i, K_NOW) && wx[i].cur.sunrise as s32 != 0xFFFF {
        sr = wx[i].cur.sunrise as s32
        ss = wx[i].cur.sunset as s32
    }
    for k in 0..n {
        let hr = (h.hour as s32 + k) % 24
        let m = hr * 60 + 30
        if m < sr || m > ss {
            rect_grad(HR_X0 + k * HR_DX - HR_DX / 2, 34, HR_DX, 176, 0x7A3418, 0x4E1C0C, BLEND_NONE)
        }
    }
    // the range
    var lo = 1000
    var hi = -1000
    for k in 0..n {
        let v = h.hours[k].temp as s32
        if !temp_known(v) { continue }
        lo = min(lo, v)
        hi = max(hi, v)
    }
    if lo > hi {
        lo = 0
        hi = 10
    }
    if hi - lo < 12 {
        let mid = (hi + lo) / 2
        lo = mid - 6
        hi = mid + 6
    }
    var px: [24]s32
    var py: [24]s32
    for k in 0..n {
        var v = h.hours[k].temp as s32
        if !temp_known(v) { v = (lo + hi) / 2 }
        px[k] = HR_X0 + k * HR_DX
        py[k] = HR_BOT - (v - lo) * (HR_BOT - HR_TOP) / (hi - lo)
    }
    // the area under the curve and the curve
    for k in 0..n - 1 {
        let c0 = ramp_rgb(h.hours[k].temp as s32)
        let c1 = ramp_rgb(h.hours[k + 1].temp as s32)
        let d0 = col_mix(c0, 0x5A2010, 0.7)
        let d1 = col_mix(c1, 0x5A2010, 0.7)
        let b0 = col_mix(c0, 0x5A2010, 0.9)
        tri_grad(px[k], py[k], px[k + 1], py[k + 1], px[k], HR_BOT + 4, d0, d1, b0, BLEND_NONE)
        tri_grad(px[k + 1], py[k + 1], px[k + 1], HR_BOT + 4, px[k], HR_BOT + 4, d1, b0, b0, BLEND_NONE)
    }
    for k in 0..n - 1 {
        line_ex(px[k], py[k] - 1, px[k + 1], py[k + 1] - 1, 2, ramp_rgb(h.hours[k].temp as s32),
                ramp_rgb(h.hours[k + 1].temp as s32), BLEND_NONE)
    }
    rect(HR_X0 - 6, HR_BOT + 4, n * HR_DX, 1, 0xC08050)
    // every third hour: icon, temperature, time
    var k = 0
    while k < n {
        let e = &h.hours[k]
        let hr = (h.hour as s32 + k) % 24
        let m = hr * 60 + 30
        rect(px[k] - 1, py[k] - 2, 3, 3, WHITE)
        icon_small(icon_of(e.wmo as s32), px[k] - 10, 38, m < sr || m > ss)
        txt_s(F_SMALL, px[k], 57, s_temp(e.temp as s32), WHITE, ALIGN_CENTRE)
        var lbl = s_hour(hr)
        if k == 0 { lbl = "Now" }
        txt_a(F_TINY, px[k], 178, lbl, C_SOFT, ALIGN_CENTRE)
        k += 3
    }
    // chance of rain: a bar an hour
    txt(F_TINY, 10, 194, "Rain", C_DIM)
    for j in 0..n {
        let p = h.hours[j].pop as s32
        if p == 255 || p == 0 { continue }
        let bh = max(1, p * 16 / 100)
        rect(px[j] - 3, 210 - bh, 6, bh, col_mix(0xF0B060, 0xFFE0A0, fixed(p) / 100))
    }
}

// ---- the map

const PILL_H = 32

fn map_draw_page(i: s32, t: s32) {
    let mx = MAP_X
    let my = MAP_Y
    let have = wx_has(i, K_MAP)
    mt_show(i)
    let ov = ov_show(i)
    if have {
        map_draw(mx, my, ov)
    } else {
        rect(mx, my, MAP_W, MAP_H, 0x583024)
        if ov { sprite_ex(ov_page(), 0, 0, 256, 192, mx, my, MAP_W, MAP_H, 0x808080, BLEND_NONE) }
    }
    rect_outline(mx - 1, my - 1, MAP_W + 2, MAP_H + 2, 0x2A1008, BLEND_NONE)
    legend_draw(i, 266, my)
    if !have {
        // the placeholder, in the middle of the empty map
        let w = txt_w(F_MED, WAITING) + 24
        rect_blend(mx + MAP_W / 2 - w / 2, my + MAP_H / 2 - 14, w, 26, 0x2A0C04, BLEND_HALF)
        txt_s(F_MED, mx + MAP_W / 2, my + MAP_H / 2 - 11, WAITING, WHITE, ALIGN_CENTRE)
        return
    }
    // the title pill, bottom left (the open sea on the national map)
    let pw = pill_w(i)
    let py = my + MAP_H - PILL_H - 4
    rect_blend(mx + 4, py, pw, PILL_H, 0x2A0C04, BLEND_HALF)
    rect_blend(mx + 4, py, pw, 1, C_GOLD, BLEND_NONE)
    txt_s(F_MED, mx + 10, py + 2, pill_name(i), WHITE, ALIGN_LEFT)
    txt(F_TINY, mx + 10, py + 20, PILL_SUB, C_SOFT)
    cities_draw(i)
}

const PILL_SUB = "Current temperatures"

private fn pill_name(i: s32) -> *u8 {
    if loc_is_home(i) { return loc_name(i) }
    return loc_region(i)
}

fn pill_w(i: s32) -> s32 { return max(txt_w(F_MED, pill_name(i)), txt_w(F_TINY, PILL_SUB)) + 14 }

// ---- the cities on the map: a dot, the temperature with a small icon where it fits, and the
// name. Labels are placed once (when the map, its cities, the units or the tour change) round
// their dots - right, left, above, below - where they cover no other dot or label, the title
// pill or the tour's logo; a city whose label fits nowhere is left out.

const LAB_NONE = 0
const LAB_ICON = 1                 // icon and temperature, the name under them
const LAB_PLAIN = 2                // temperature, the name under it
const LAB_TEMP = 3                 // the temperature alone

struct CityLabel {
    x: s32                         // the dot
    y: s32
    city: s32                      // index in the location's cities
    mode: s32                      // LAB_*
    lx: s32                        // the label's box
    ly: s32
    lw: s32
    lh: s32
}

var lab: [24]CityLabel             // the cities on the map shown (the tests check the layout)
var nlab: s32
private var lab_loc = -1
private var lab_gen = -1
private var lab_units = -1
private var lab_tour = false

// Boxes already taken.
private var lb: [64 * 4]s32
private var nlb: s32

private fn block(x: s32, y: s32, w: s32, h: s32) {
    if nlb >= 64 { return }
    lb[nlb * 4] = x
    lb[nlb * 4 + 1] = y
    lb[nlb * 4 + 2] = w
    lb[nlb * 4 + 3] = h
    nlb += 1
}

private fn hits(x: s32, y: s32, w: s32, h: s32) -> bool {
    for k in 0..nlb {
        let b = &lb[k * 4]
        if x < b[0] + b[2] && b[0] < x + w && y < b[1] + b[3] && b[1] < y + h { return true }
    }
    return false
}

// Tries the four places round dot (px, py) for a w x h label; true (and lx, ly) if one is free.
private fn place(px: s32, py: s32, w: s32, h: s32, out: *s32) -> bool {
    let mx = MAP_X
    let my = MAP_Y
    for c in 0..4 {
        var lx = px + 4
        var ly = py - 8
        match c {
            1 => lx = px - 4 - w
            2 => {
                lx = px - w / 2
                ly = py - 4 - h
            }
            3 => {
                lx = px - w / 2
                ly = py + 4
            }
            else => {}
        }
        // slide along the dot's side to stay on the map
        if c < 2 { ly = clamp(ly, my + 2, my + MAP_H - 2 - h) } else { lx = clamp(lx, mx + 2, mx + MAP_W - 2 - w) }
        if lx < mx + 2 || lx + w > mx + MAP_W - 2 || ly < my + 2 || ly + h > my + MAP_H - 2 { continue }
        if hits(lx - 1, ly, w + 2, h) { continue }
        out[0] = lx
        out[1] = ly
        return true
    }
    return false
}

private fn layout_cities(i: s32) {
    lab_loc = i
    lab_gen = wx[i].gen
    lab_units = cfg.units as s32
    lab_tour = tour_on
    nlb = 0
    nlab = 0
    block(MAP_X + 4, MAP_Y + MAP_H - PILL_H - 4, pill_w(i), PILL_H)
    if tour_on { block(tour_logo_x(), tour_logo_y(), LOGO.w as s32, LOGO.h as s32) }
    let w = &wx[i]
    // every dot first, so no label covers one
    for k in 0..w.ncities {
        let c = &w.cities[k]
        let l = &lab[nlab]
        var p: [2]s32
        if !map_point(i, c.lat as s32, c.lon as s32, MAP_X, MAP_Y, &p[0]) { continue }
        if hits(p[0] - 2, p[1] - 2, 5, 5) { continue }      // under the pill or the logo
        l.x = p[0]
        l.y = p[1]
        l.city = k
        l.mode = LAB_NONE
        block(p[0] - 2, p[1] - 2, 5, 5)
        nlab += 1
    }
    // then the labels, most prominent first
    for j in 0..nlab {
        let l = &lab[j]
        let c = &w.cities[l.city]
        let tw = txt_w(F_MED, s_temp(c.temp as s32))
        let nw = txt_w(F_TINY, bc_name(&c.name[0]))
        var at: [2]s32
        var mode = LAB_NONE
        var bw = 0
        var bh = 0
        if place(l.x, l.y, max(SMALL_ICON_W + 1 + tw, nw), 24, &at[0]) {
            mode = LAB_ICON
            bw = max(SMALL_ICON_W + 1 + tw, nw)
            bh = 24
        } else if place(l.x, l.y, max(tw, nw), 23, &at[0]) {
            mode = LAB_PLAIN
            bw = max(tw, nw)
            bh = 23
        } else if place(l.x, l.y, tw, 15, &at[0]) {
            mode = LAB_TEMP
            bw = tw
            bh = 15
        }
        l.lx = at[0]
        l.ly = at[1]
        l.lw = bw
        l.lh = bh
        l.mode = mode
        if mode != LAB_NONE { block(at[0], at[1], bw, bh) }
    }
}

private fn cities_draw(i: s32) {
    let w = &wx[i]
    if w.ncities == 0 { return }
    if lab_loc != i || lab_gen != w.gen || lab_units != cfg.units as s32 || lab_tour != tour_on {
        layout_cities(i)
    }
    for j in 0..nlab {
        let l = &lab[j]
        if l.mode == LAB_NONE { continue }
        let c = &w.cities[l.city]
        rect(l.x - 2, l.y - 2, 5, 5, 0x200800)
        rect(l.x - 1, l.y - 1, 3, 3, WHITE)
        let ts = s_temp(c.temp as s32)
        let nm = bc_name(&c.name[0])
        match l.mode {
            LAB_ICON => {
                icon_small(icon_of(c.wmo as s32), l.lx, l.ly, c.flags & 1 == 0)
                txt_s(F_MED, l.lx + SMALL_ICON_W + 1, l.ly, ts, WHITE, ALIGN_LEFT)
                txt_s(F_TINY, l.lx, l.ly + 16, nm, C_SOFT, ALIGN_LEFT)
            }
            LAB_PLAIN => {
                txt_s(F_MED, l.lx, l.ly, ts, WHITE, ALIGN_LEFT)
                txt_s(F_TINY, l.lx, l.ly + 15, nm, C_SOFT, ALIGN_LEFT)
            }
            else => txt_s(F_MED, l.lx, l.ly, ts, WHITE, ALIGN_LEFT)
        }
    }
}

// The band legend of location i's map, from its header: 16 swatches, top warmest.
fn legend_draw(i: s32, x: s32, y: s32) {
    panel(x, y, 50, MAP_H)
    txt_s(F_MED, x + 25, y + 3, s_cat("`", unit_letter()), WHITE, ALIGN_CENTRE)
    if !wx_has(i, K_MAP) { return }
    let base = wx[i].map.base as s32
    let step = wx[i].map.step as s32
    for b in 0..16 {
        let band = 15 - b
        let yy = y + 24 + b * 10
        let centre_q = 2 * base + (2 * band + 1) * step
        let c = RAMP_RGB[clamp(centre_q / 4, -30, 45) + 30]
        rect(x + 6, yy, 12, 10, c)
        if band % 2 == 1 {
            let edge = base + band * step          // the band's lower edge, half degrees
            txt_a(F_TINY, x + 46, yy + 6, s_temp_n(edge), C_SOFT, ALIGN_RIGHT)
        }
    }
    rect_outline(x + 5, y + 23, 14, 162, 0x200800, BLEND_NONE)
}

// ---- the regions directory (page 101)

var reg_sel: s32

fn regions_draw(t: s32) {
    panel(6, BODY_Y, 308, BODY_H)
    let rows = min(nlocs, 11)
    let top = max(0, min(reg_sel - 5, nlocs - rows))
    for r in 0..rows {
        let j = top + r
        let y = 35 + r * 16
        if j == reg_sel {
            rect_hgrad(8, y - 1, 304, 16, C_BAR_BOT, C_BAR_TOP, BLEND_NONE)
            rect_blend(8, y - 1, 304, 1, 0xB0E8FF, BLEND_NONE)
        }
        var pc = C_GOLD
        if j == reg_sel { pc = WHITE }
        text(12, y + 3, s_page(locs[j].page), pc)
        var name = loc_region(j)
        if loc_is_home(j) { name = "Home" }
        txt_s(F_MED, 44, y - 1, name, WHITE, ALIGN_LEFT)
        var cc = C_SOFT
        if j == reg_sel { cc = WHITE }
        if loc_is_national(j) {
            txt_a(F_SMALL, 306, y + 2, "Temperature map", cc, ALIGN_RIGHT)
            continue
        }
        txt(F_SMALL, 140, y + 2, loc_name(j), cc)
        if wx_has(j, K_NOW) {
            let c = &wx[j].cur
            icon_small(icon_of(c.wmo as s32), 238, y - 1, c.flags & 1 == 0)
            txt_s(F_MED, 306, y - 1, s_temp(c.temp as s32), WHITE, ALIGN_RIGHT)
        }
    }
}

// ---- the clock (page 100)

fn clock_draw(t: s32) {
    panel(6, BODY_Y, 308, BODY_H)
    gloss(6, BODY_Y + 1, 308, 40)
    var h12 = clk.hour % 12
    if h12 == 0 { h12 = 12 }
    let b = sbuf()
    str_append_int(b, SB, h12, 0, false)
    str_append_char(b, SB, ':')
    str_append_int(b, SB, clk.minute, 2, true)
    let w = txt_w(F_HUGE, b)
    let x0 = 150 - w / 2
    let x1 = txt_s(F_HUGE, x0, 40, b, WHITE, ALIGN_LEFT)
    let sb = sbuf()
    str_append_char(sb, SB, ':')
    str_append_int(sb, SB, clk.second, 2, true)
    txt_s(F_MED, x1 + 3, 42, sb, C_SOFT, ALIGN_LEFT)
    var ap = "AM"
    if clk.hour >= 12 { ap = "PM" }
    txt_s(F_MED, x1 + 3, 68, ap, C_GOLD, ALIGN_LEFT)
    let d = sbuf()
    str_copy(d, SB, DAY_NAMES[clk.weekday % 7])
    str_append(d, SB, ", ")
    str_append(d, SB, MONTH_NAMES[clamp(clk.month - 1, 0, 11)])
    str_append_char(d, SB, ' ')
    str_append_int(d, SB, clk.day, 0, false)
    txt_s(F_MED, 160, 100, d, WHITE, ALIGN_CENTRE)
    var src = "The console's clock"
    if clk.on_air {
        src = "MeiNet time"
        if clk_tz[0] != 0 { src = s_cat("MeiNet time, ", bc_name(&clk_tz[0])) }
    }
    txt_a(F_SMALL, 160, 121, src, C_SOFT, ALIGN_CENTRE)
    day_arc(t)
}

// The day's arc at home: sunrise to sunset, with the sun where it is now.
private fn day_arc(t: s32) {
    let h = loc_find(BC_HOME)
    if h < 0 || !wx_has(h, K_NOW) { return }
    let c = &wx[h].cur
    let sr = c.sunrise as s32
    let ss = c.sunset as s32
    if sr == 0xFFFF || ss == 0xFFFF || ss <= sr { return }
    let cx = 160
    let base = 190
    let rx = 100
    let ry = 44
    rect(cx - rx - 20, base, 2 * rx + 40, 1, 0xC08050)
    var px = cx - rx
    var py = base
    for s in 1..25 {
        let a = PI * fixed(s) / 24
        let x = cx - (cos(a) * rx) as s32
        let y = base - (sin(a) * ry) as s32
        line(px, py, x, y, 0x90C8F0)
        px = x
        py = y
    }
    // the sunrise and sunset glyphs sit on the horizon at the arc's ends, the times under them
    spr(G_RISE, cx - rx - 11, base - 15)
    txt_a(F_TINY, cx - rx, base + 6, s_clock(sr), C_SOFT, ALIGN_CENTRE)
    spr(G_SET, cx + rx - 11, base - 15)
    txt_a(F_TINY, cx + rx, base + 6, s_clock(ss), C_SOFT, ALIGN_CENTRE)
    let now = clock_minutes()
    if now >= sr && now <= ss {
        let a = PI * fixed(now - sr) / (ss - sr)
        let x = cx - (cos(a) * rx) as s32
        let y = base - (sin(a) * ry) as s32
        spr_rot(IM_RAYS, x, y, frame_angle(t, 0.01))
        spr_c(IM_DISC, x, y)
    } else {
        spr_c(IM_MOON, cx, base - ry - 2)
    }
}
