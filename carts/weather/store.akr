// The memory card: save 0 holds the settings, save 1 the pages last received (the locations
// and their cached pages, maps packed two bands a byte), so the cart can show the weather it
// last saw when there is no signal. Nothing on screen says so: it is just the weather.
//
// The cache is written a little after pages first arrive, then at most every five minutes
// while new pages come in, without stopping the frame loop. The sample tape is never saved.

const SAVE_SETTINGS = 0
const SAVE_CACHE = 1
const CACHE_MAGIC: u32 = 0x3243574D        // "MWC2"
const CACHE_FIRST_DELAY = 20 * 60
const CACHE_EVERY = 5 * 60 * 60

struct CacheHead {
    magic: u32
    nlocs: s32
    flags: s32                 // bit 0 the index had arrived, bit 1 no home city
    size: s32                  // bytes of the whole save
}

// What is saved of a location's cache (the bands follow, packed).
struct WxSaved {
    have: s32
    ver: [5]s32
    cur: BcCurrent
    daily: BcDaily
    hourly: BcHourly
    map: BcMapHeader
    ncities: s32
    cities: [24]BcCity
}

const CACHE_PER_LOC = sizeof(Loc) + sizeof(WxSaved) + 1536
const CACHE_MAX = 32000                     // a save's limit (docs/MEMCARD.md)

private var buf: [32000]u8
private var meta: SaveMeta
private var saving: bool
private var loaded_pages: bool
private var last_save: s32 = -1
private var first_seen: s32 = -1

fn store_has_pages() -> bool { return loaded_pages }

fn store_load() {
    if !card_present(1) { return }
    var s: Settings
    if card_load(SAVE_SETTINGS, &s as *u8, sizeof(Settings)) == sizeof(Settings) && s.magic == SETTINGS_MAGIC {
        cfg = s
        cfg.units = min(cfg.units as s32, 1) as u8
        cfg.tour = min(cfg.tour as s32, 3) as u8
        cfg.music = min(cfg.music as s32, 4) as u8
        cfg.sfx = min(cfg.sfx as s32, 1) as u8
        cfg.source = min(cfg.source as s32, 2) as u8
    }
    let n = card_load(SAVE_CACHE, &buf[0], len(buf))
    if n < sizeof(CacheHead) { return }
    let h = &buf[0] as *CacheHead
    if h.magic != CACHE_MAGIC || h.size != n || h.nlocs < 1 || h.nlocs > MAX_LOCS { return }
    let per = CACHE_PER_LOC
    if n != sizeof(CacheHead) + h.nlocs * per { return }
    nlocs = h.nlocs
    index_ok = h.flags & 1 != 0
    home_off = h.flags & 2 != 0
    var p = sizeof(CacheHead)
    for i in 0..nlocs {
        memcpy(&locs[i] as *u8, &buf[p], sizeof(Loc) as u32)
        p += sizeof(Loc)
        let ws = &buf[p] as *WxSaved
        let w = &wx[i]
        w.have = ws.have
        for k in 0..KINDS { w.ver[k] = ws.ver[k] }
        w.cur = ws.cur
        w.daily = ws.daily
        w.hourly = ws.hourly
        w.map = ws.map
        w.ncities = clamp(ws.ncities, 0, MAX_CITIES)
        for k in 0..MAX_CITIES { w.cities[k] = ws.cities[k] }
        w.gen += 1
        p += sizeof(WxSaved)
        for k in 0..1536 {
            let b = buf[p + k]
            w.bands[2 * k] = b & 15
            w.bands[2 * k + 1] = b >> 4
        }
        p += 1536
        if w.have != 0 { loaded_pages = true }
    }
    // the versions on air may have nothing to do with these: compare contents, not versions
    for i in 0..nlocs {
        for k in 0..KINDS { wx[i].ver[k] = -1 }
    }
}

fn store_save_settings() {
    if !card_present(1) || card_busy() { return }
    meta = *SAVE_ICON
    card_set_title(&meta, "Mei Weather settings")
    card_save(SAVE_SETTINGS, &cfg as *u8, sizeof(Settings), &meta)
}

private fn save_cache() {
    let per = CACHE_PER_LOC
    let h = &buf[0] as *CacheHead
    h.magic = CACHE_MAGIC
    h.nlocs = min(nlocs, (CACHE_MAX - sizeof(CacheHead)) / per)    // all of them, unless a gateway adds many regions
    h.flags = 0
    if index_ok { h.flags = h.flags | 1 }
    if home_off { h.flags = h.flags | 2 }
    h.size = sizeof(CacheHead) + h.nlocs * per
    var p = sizeof(CacheHead)
    for i in 0..h.nlocs {
        memcpy(&buf[p], &locs[i] as *u8, sizeof(Loc) as u32)
        p += sizeof(Loc)
        let ws = &buf[p] as *WxSaved
        let w = &wx[i]
        ws.have = w.have
        for k in 0..KINDS { ws.ver[k] = w.ver[k] }
        ws.cur = w.cur
        ws.daily = w.daily
        ws.hourly = w.hourly
        ws.map = w.map
        ws.ncities = w.ncities
        for k in 0..MAX_CITIES { ws.cities[k] = w.cities[k] }
        p += sizeof(WxSaved)
        for k in 0..1536 {
            buf[p + k] = (w.bands[2 * k] & 15) | (w.bands[2 * k + 1] << 4)
        }
        p += 1536
    }
    meta = *SAVE_ICON
    card_set_title(&meta, "Mei Weather")
    if card_save(SAVE_CACHE, &buf[0], h.size, &meta) == CARD_OK {
        saving = true
        model_dirty = 0
        last_save = tick
    }
}

// Every frame: saves the cache when it is time (never while the card is busy).
fn store_update() {
    if saving {
        if !card_busy() { saving = false }
        return
    }
    if rx_demo || model_dirty == 0 || model_seen == 0 { return }
    if first_seen < 0 { first_seen = tick }
    var due = false
    if last_save < 0 { due = tick - first_seen >= CACHE_FIRST_DELAY }
    else { due = tick - last_save >= CACHE_EVERY }
    if due && card_present(1) && !card_busy() { save_cache() }
}
