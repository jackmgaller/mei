// The weather model: the locations on air (from the index page, or the spec's defaults before
// it arrives), a cache of every page received, and which pages the decoder's eight slots
// collect.
//
// Slots: the time page (clock.akr), the index, the five kinds of the location on screen (the
// "focus": current conditions, the forecasts, the map and its cities), and a scanner that
// walks the other locations' pages, fetching the ones whose version in the index differs from
// the cached one. Pages are taken whole once they are complete, so what is on screen is always
// a finished page.

const MAX_LOCS = 16
const KINDS = 5
const K_NOW = 0
const K_WEEK = 1
const K_HOURS = 2
const K_MAP = 3
const K_CITIES = 4
const MAX_CITIES = 24
const LF_HOME = 1
const LF_NATIONAL = 4
const SCAN_SLOTS = 1
const SCAN_PATIENCE = 26 * 60       // frames the scanner waits for a page before moving on
const SCAN_PATIENCE_MAP = 70 * 60   // ... for a map or its cities (the map sequence takes ~65 s)

struct Loc {
    page: s32                // 0x400..0x4FF
    kinds: s32               // kinds on air (bit k)
    flags: s32               // LF_*
    iver: [5]s32             // versions in the index, -1 unknown
    lat: s32                 // hundredths of a degree
    lon: s32
    south: s32
    north: s32
    west: s32
    east: s32
    region: [16]u8           // name fields (length byte, text)
    city: [16]u8
}

// The cache of one location's pages.
struct Wx {
    have: s32                // bit k: kind k cached
    ver: [5]s32              // version of each cached kind, -1 none
    gen: s32                 // counts changes to the map and the cities (for what is drawn from them)
    cur: BcCurrent
    daily: BcDaily
    hourly: BcHourly
    map: BcMapHeader
    ncities: s32
    cities: [24]BcCity
    bands: [3072]u8          // 64 x 48 bands
}

var locs: [16]Loc
var nlocs: s32
var wx: [16]Wx
var focus = -1               // location on screen
var index_ok: bool           // the index page has arrived
var home_off: bool           // the index says no home city is set
var model_dirty: s32         // pages received since the cache was last saved
var model_seen: s32          // pages received since start

private var idx: BcIndex
private var page_buf: [3328]u8
private var focus_page: s32 = -1
private var scan_pid: [1]s32
private var scan_since: [1]s32
private var scan_next: s32
private var frame_n: s32

struct LocDefault {
    page: s32
    region: *u8
    city: *u8
    lat: s32
    lon: s32
    south: s32
    north: s32
    west: s32
    east: s32
}

// The spec's regions (docs/BROADCAST.md), used until the index arrives.
const DEFAULT_LOCS: [9]LocDefault = [
    LocDefault { page: 0x401, region: "Northeast", city: "New York", lat: 4071, lon: -7401, south: 3700, north: 4750, west: -8050, east: -6700 },
    LocDefault { page: 0x402, region: "Southeast", city: "Atlanta", lat: 3375, lon: -8439, south: 2500, north: 3700, west: -9150, east: -7550 },
    LocDefault { page: 0x403, region: "Midwest", city: "Chicago", lat: 4188, lon: -8763, south: 3600, north: 4950, west: -9750, east: -8050 },
    LocDefault { page: 0x404, region: "South", city: "Dallas", lat: 3278, lon: -9680, south: 2550, north: 3700, west: -10650, east: -8850 },
    LocDefault { page: 0x405, region: "Mountain", city: "Denver", lat: 3974, lon: -10499, south: 3700, north: 4900, west: -11700, east: -10200 },
    LocDefault { page: 0x406, region: "Southwest", city: "Phoenix", lat: 3345, lon: -11207, south: 3130, north: 3700, west: -12000, east: -10300 },
    LocDefault { page: 0x407, region: "West", city: "Los Angeles", lat: 3405, lon: -11824, south: 3250, north: 4200, west: -12450, east: -11400 },
    LocDefault { page: 0x408, region: "Pacific NW", city: "Seattle", lat: 4761, lon: -12233, south: 4200, north: 4900, west: -12480, east: -11100 },
    LocDefault { page: 0x4FF, region: "United States", city: "", lat: 3900, lon: -9600, south: 2450, north: 4950, west: -12500, east: -6650 }
]

fn name_set(dst: *u8, s: *u8) {
    let n = min(strlen(s), 14)
    dst[0] = n as u8
    for i in 0..15 {
        if i < n { dst[1 + i] = s[i] } else { dst[1 + i] = 0 }
    }
}

private fn wx_clear(w: *Wx) {
    mem_fill(w as *u8, 0, sizeof(Wx))
    for k in 0..KINDS { w.ver[k] = -1 }
}

private fn loc_blank(l: *Loc, page: s32) {
    mem_fill(l as *u8, 0, sizeof(Loc))
    l.page = page
    l.kinds = 31
    for k in 0..KINDS { l.iver[k] = -1 }
}

// The default locations: home first, the eight regions, the national map last.
fn model_reset() {
    nlocs = 0
    let h = &locs[0]
    loc_blank(h, BC_HOME)
    h.flags = LF_HOME
    name_set(&h.region[0], "Home")
    nlocs = 1
    for d in 0..len(DEFAULT_LOCS) {
        let src = &DEFAULT_LOCS[d]
        let l = &locs[nlocs]
        loc_blank(l, src.page)
        name_set(&l.region[0], src.region)
        name_set(&l.city[0], src.city)
        l.lat = src.lat
        l.lon = src.lon
        l.south = src.south
        l.north = src.north
        l.west = src.west
        l.east = src.east
        if src.page == BC_NATIONAL {
            l.flags = LF_NATIONAL
            l.kinds = (1 << K_MAP as u32) | (1 << K_CITIES as u32)
        }
        nlocs += 1
    }
    for i in 0..MAX_LOCS { wx_clear(&wx[i]) }
    index_ok = false
    home_off = false
    model_dirty = 0
    model_seen = 0
    focus = 0
    focus_page = -1
    for s in 0..SCAN_SLOTS {
        scan_pid[s] = -1
        scan_since[s] = 0
    }
}

// The receiver changed (antenna <-> sample tape): every slot is to be selected again.
fn model_source_changed() {
    focus_page = -1
    for s in 0..SCAN_SLOTS { scan_pid[s] = -1 }
}

fn loc_find(page: s32) -> s32 {
    for i in 0..nlocs {
        if locs[i].page == page { return i }
    }
    return -1
}

fn loc_is_home(i: s32) -> bool { return locs[i].flags & LF_HOME != 0 }
fn loc_is_national(i: s32) -> bool { return locs[i].flags & LF_NATIONAL != 0 }
fn loc_has_kind(i: s32, k: s32) -> bool { return (locs[i].kinds >> k as u32) & 1 != 0 }
fn wx_has(i: s32, k: s32) -> bool { return (wx[i].have >> k as u32) & 1 != 0 }

// ---- the index

private fn take_index() {
    let n = rx_read(BC_INDEX_PAGE, &page_buf[0])
    if n < 52 { return }
    memcpy(&idx as *u8, &page_buf[0], n as u32)
    let cnt = min(idx.head.count as s32, (n - 52) / 52)
    if cnt == 0 { return }               // nothing on air yet: keep what we have
    index_ok = true
    home_off = idx.head.flags & 1 == 0
    // rebuild the table in the index's order, keeping each location's cache
    var new_locs: [16]Loc
    var from: [16]s32
    var k = 0
    for e in 0..cnt {
        if k >= MAX_LOCS { break }
        let en = &idx.entry[e]
        let l = &new_locs[k]
        loc_blank(l, en.page as s32)
        l.kinds = en.kinds as s32
        l.flags = en.flags as s32 & (LF_HOME | LF_NATIONAL)
        for j in 0..KINDS {
            var v = en.cities_version as s32
            if j < 4 { v = en.versions[j] as s32 }
            if (l.kinds >> j as u32) & 1 != 0 { l.iver[j] = v } else { l.iver[j] = -1 }
        }
        l.lat = en.lat as s32
        l.lon = en.lon as s32
        l.south = en.south as s32
        l.north = en.north as s32
        l.west = en.west as s32
        l.east = en.east as s32
        memcpy(&l.region[0], &en.region[0], 15)
        memcpy(&l.city[0], &en.city[0], 16)
        if l.page == BC_HOME { l.flags = l.flags | LF_HOME }
        if l.page == BC_NATIONAL { l.flags = l.flags | LF_NATIONAL }
        from[k] = loc_find(l.page)
        k += 1
    }
    var focus_pg = -1
    if focus >= 0 && focus < nlocs { focus_pg = locs[focus].page }
    wx_reorder(&from[0], k)
    for i in 0..k { locs[i] = new_locs[i] }
    nlocs = k
    focus = max(loc_find(focus_pg), 0)
    model_dirty += 1
}

// Rearranges the caches so that wx[i] holds what wx[order[i]] held (order[i] -1: empty).
private var wx_tmp: [16]Wx
private fn wx_reorder(order: *s32, n: s32) {
    var same = n == nlocs
    for i in 0..n {
        if order[i] != i { same = false }
    }
    if same { return }                     // the usual case: nothing moves
    for i in 0..MAX_LOCS { wx_tmp[i] = wx[i] }
    for i in 0..MAX_LOCS {
        if i < n && order[i] >= 0 { wx[i] = wx_tmp[order[i]] } else { wx_clear(&wx[i]) }
        wx[i].gen += 1
    }
}

// ---- pages

fn pid_of(i: s32, k: s32) -> s32 { return (k << 12) | locs[i].page }

// Copies a complete page into the cache. False if it was not ready.
private fn take(i: s32, k: s32) -> bool {
    let pid = pid_of(i, k)
    let ver = rx_version(pid)
    let n = rx_read(pid, &page_buf[0])
    if n <= 0 { return false }
    let w = &wx[i]
    match k {
        K_NOW => memcpy(&w.cur as *u8, &page_buf[0], 52)
        K_WEEK => memcpy(&w.daily as *u8, &page_buf[0], 52)
        K_HOURS => memcpy(&w.hourly as *u8, &page_buf[0], 104)
        K_CITIES => {
            let all = &page_buf[0] as *BcCities
            let cnt = min(bc_city_count(all, n), MAX_CITIES)
            memcpy(&w.cities[0] as *u8, &page_buf[0], (cnt * BC_CITY_BYTES) as u32)
            w.ncities = cnt
            w.gen += 1
        }
        else => {
            var hdr: BcMapHeader
            memcpy(&hdr as *u8, &page_buf[0], 52)
            var tmp: [3072]u8
            if !bc_map_decode(&page_buf[0] as *BcMap, &tmp[0]) { return false }
            memcpy(&w.bands[0], &tmp[0], 3072)
            w.map = hdr
            w.gen += 1
        }
    }
    w.have = w.have | (1 << k as u32)
    w.ver[k] = ver
    if k == K_NOW && loc_is_home(i) && locs[i].city[0] == 0 {
        memcpy(&locs[i].city[0], &w.cur.city[0], 16)
    }
    model_dirty += 1
    model_seen += 1
    return true
}

// Selects the focus location's pages (releasing the previous ones).
fn model_focus(i: s32) {
    if i < 0 || i >= nlocs { return }
    focus = i
    let page = locs[i].page
    if page == focus_page { return }
    if focus_page >= 0 {
        for k in 0..KINDS { rx_release((k << 12) | focus_page) }
    }
    focus_page = page
    // a scanner holding one of these pages lets it go to the focus
    for s in 0..SCAN_SLOTS {
        if scan_pid[s] >= 0 && scan_pid[s] & 0xFFF == page {
            scan_pid[s] = -1
        }
    }
    for k in 0..KINDS {
        if loc_has_kind(i, k) { rx_select(pid_of(i, k)) }
    }
}

// Every frame: the index, the focus pages, the scanner.
fn model_update() {
    frame_n += 1
    rx_select(BC_INDEX_PAGE)
    if rx_changed(BC_INDEX_PAGE) { take_index() }
    if focus >= nlocs { focus = 0 }
    if focus_page != locs[focus].page { model_focus(focus) }
    let f = focus
    for k in 0..KINDS {
        if loc_has_kind(f, k) && rx_changed(pid_of(f, k)) { take(f, k) }
    }
    scan()
}

// ---- the scanner

// Whether page (i, k) is worth fetching: never received, or the index has a newer version.
private fn wanted(i: s32, k: s32) -> bool {
    if !loc_has_kind(i, k) { return false }
    if !wx_has(i, k) { return true }
    let iv = locs[i].iver[k]
    return iv >= 0 && iv != wx[i].ver[k]
}

private fn scanning(pid: s32) -> bool {
    for s in 0..SCAN_SLOTS {
        if scan_pid[s] == pid { return true }
    }
    return false
}

// The order a location's pages go by on air (the cities just before their map).
const SCAN_KINDS: [5]s32 = [K_NOW, K_WEEK, K_HOURS, K_CITIES, K_MAP]

// The next page the scanner should collect: the other locations' current conditions first,
// then home's pages, then everyone's 5-day and 24-hour forecasts, then the cities and maps.
// Within a pass it goes in page order from where it last was, which is the order the pages
// go by on air, so one slot can catch a whole run of them.
private fn pick() -> s32 {
    let n = nlocs
    for pass in 0..5 {
        for j in 0..n {
            let i = (scan_next + j) % n
            if i == focus { continue }
            for kk in 0..KINDS {
                let k = SCAN_KINDS[kk]
                let take_it = match pass {
                    0 => k == K_NOW
                    1 => loc_is_home(i)
                    2 => k == K_WEEK
                    3 => k == K_HOURS
                    else => k == K_CITIES || k == K_MAP
                }
                if !take_it { continue }
                let pid = pid_of(i, k)
                if wanted(i, k) && !scanning(pid) {
                    scan_next = i
                    return pid
                }
            }
        }
    }
    return -1
}

private fn scan() {
    for s in 0..SCAN_SLOTS {
        let pid = scan_pid[s]
        if pid >= 0 {
            let i = loc_find(pid & 0xFFF)
            let k = (pid >> 12) & 15
            var patience = SCAN_PATIENCE
            if k == K_MAP || k == K_CITIES { patience = SCAN_PATIENCE_MAP }
            if i >= 0 && rx_changed(pid) {
                take(i, k)
                rx_release(pid)
                scan_pid[s] = -1
            } else if i < 0 || frame_n - scan_since[s] > patience {
                rx_release(pid)
                scan_pid[s] = -1
                if i >= 0 { scan_next = (i + 1) % max(nlocs, 1) }
            }
        }
        if scan_pid[s] < 0 && rx_carrier() {
            let p = pick()
            if p >= 0 && rx_select(p) >= 0 {
                scan_pid[s] = p
                scan_since[s] = frame_n
            }
        }
    }
}
