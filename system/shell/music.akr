// Quiet ambient music for the shell: a small sequencer playing composed scores with ADPCM
// instruments through the hardware reverb. Everything musical (samples, instruments and
// scores) comes from tools/gen_shell_music.py as mu_data.akr and one sample bank per style.
//
// MUSIC_STYLE picks one of three candidates (all three banks are in the ROM, about 190-220 KB
// each; once one is chosen the generator can drop the others):
//   0 Glasshouse  electric piano and pad on a voice-led progression in A, a vibraphone theme
//                 that comes and goes; F# minor at night
//   1 Airports    felt piano and choir tape loops of different lengths drifting in and out of
//                 phase over a slow bass line (Music for Airports)
//   2 Crystal     quartal pad chords planing over a sub bass, a glass-bell arpeggio with echoes
//                 and high sparkles in a long space reverb
//
// A score is a set of tracks. Each track plays a cycle of slots; each slot has a few
// variant sections and a random one plays each time (never the same twice in a row). A track
// has a day and a night version and picks one from the sky (sky_day, from SYS_TIME) whenever
// it comes back round to its first slot. Night scores also play slower.
//
// Channels 0-5 and 8-15 (14 voices); 6-7 stay with the UI sounds. The reverb is global: the
// music sets it while it plays and turns it off when it stops.

import "mu_data.akr"

const MUSIC_STYLE = 0

const MU_NV = 14
const MU_CHANS: [14]s32 = [8, 9, 10, 11, 12, 13, 14, 15, 0, 1, 2, 3, 4, 5]
const MU_FULL = 32767            // envelope full scale
const MU_TWO_PI = 411775         // 2 pi in fixed-point bits
const MU_KILL = 2                // a voice below this VOL level is stopped
const MU_PITCH: [3]fixed = [1.0, 2.0, 4.0]   // samples play at their pitch or octaves up

var mu_running: bool
var mu_gain: s32                 // 0..256 master level (fades and ducking)
var mu_target: s32
var mu_speed: s32 = 2            // gain change per frame
var mu_night: s32                // 0 day, 1 night: the version tracks pick next
var mu_wet: s32                  // reverb wet level before the gain, eased toward the mood's
var mu_wet_reg: s32 = -1

// voices
var mv_on: [14]bool
var mv_inst: [14]s32             // MU_INST row
var mv_lvl: [14]s32              // envelope 0..MU_FULL
var mv_state: [14]s32            // 1 attack, 2 sustain or decay, 3 release
var mv_age: [14]s32              // frames since the note started
var mv_hold: [14]s32             // struck: frames before the decay starts
var mv_rel: [14]s32              // frame (age) at which the release starts, -1 none
var mv_vol: [14]s32              // note volume 0..255
var mv_pan: [14]s32              // 0 left .. 256 right
var mv_ph: [14]s32               // tremolo phase (fixed-point bits)
var mv_out: [14]s32              // the VOL level written last frame (for stealing)

// tracks (at most 12)
var mt_count: s32
var mt_row: [12]s32              // MU_TRACK row
var mt_night: [12]s32
var mt_slot: [12]s32
var mt_last: [12]s32             // the variant played last, to avoid an immediate repeat
var mt_sec: [12]s32              // MU_SEC row
var mt_pos: [12]s32              // ticks x 256 into the section
var mt_ev: [12]s32               // next event
var mt_end: [12]s32
var mt_tempo: [12]s32            // ticks x 256 per frame

fn mu_bank() -> *u8 {
    if MUSIC_STYLE == 1 { return MU_BANK1 }
    if MUSIC_STYLE == 2 { return MU_BANK2 }
    return MU_BANK0
}

fn mu_style(i: s32) -> s32 { return MU_STYLE[MUSIC_STYLE * 10 + i] }

fn mu_reg(ch: s32) -> *u32 {
    if ch < 8 { return (AUDIO_BASE + ch * 32) as *u32 }
    return (AUDIO_HI_BASE + (ch - 8) * 32) as *u32
}

fn mu_night_now() -> s32 {
    if sky_day < 128 { return 1 }
    return 0
}

// ---- tracks

// Starts the section for the track's current slot: a random variant, not the last one.
// A score's first pass plays variant 0 (the full theme).
fn mt_begin(k: s32) {
    let tr = mt_row[k] * 4 + mt_night[k] * 2
    let slot = (MU_TRACK[tr] + mt_slot[k]) * 2
    let n = MU_SLOT[slot + 1]
    var v = 0
    if n > 1 && mt_last[k] >= 0 {
        v = rnd(n - 1)
        if v >= mt_last[k] { v += 1 }
    }
    mt_last[k] = v
    let sec = (MU_SLOT[slot] + v) * 3
    mt_sec[k] = sec
    mt_ev[k] = MU_SEC[sec]
    mt_end[k] = MU_SEC[sec] + MU_SEC[sec + 1]
    mt_tempo[k] = mu_style(6 + mt_night[k])
}

fn mt_start(k: s32, row: s32) {
    mt_row[k] = row
    mt_night[k] = mu_night
    mt_slot[k] = 0
    mt_last[k] = -1
    mt_pos[k] = 0
    mt_begin(k)
}

fn mt_frame(k: s32) {
    mt_pos[k] += mt_tempo[k]
    while true {
        let now = mt_pos[k] >> 8
        var e = mt_ev[k]
        while e < mt_end[k] && MU_EV[e * 2] & 0xFFFF <= now {
            mu_note(MU_EV[e * 2 + 1], MU_EV[e * 2] >> 16, mt_tempo[k])
            e += 1
        }
        mt_ev[k] = e
        let length = MU_SEC[mt_sec[k] + 2]
        if now < length { return }
        // next slot; back at the first one, follow the sky
        mt_pos[k] -= length << 8
        let tr = mt_row[k] * 4 + mt_night[k] * 2
        mt_slot[k] += 1
        if mt_slot[k] >= MU_TRACK[tr + 1] {
            mt_slot[k] = 0
            if mt_night[k] != mu_night {
                mt_night[k] = mu_night
                mt_last[k] = -1
            }
        }
        mt_begin(k)
    }
}

// ---- voices

// Plays one event: packed = inst | note << 4 | velocity << 11 | pan << 18.
fn mu_note(packed: s32, dur: s32, tempo: s32) {
    let inst = (mu_style(0) + (packed & 15)) * 12
    let note = (packed >> 4) & 127
    let lo = MU_INST[inst + 9]
    if note < lo || note > MU_INST[inst + 10] { return }
    let map = MU_NMAP[MU_INST[inst + 8] + note - lo]
    if map < 0 { return }
    let smp = (map & 0xFFFF) * 4
    let shift = map >> 16

    // a free voice, or the quietest one; a held note (sustained, not releasing) only if
    // every voice is one
    var v = -1
    var quiet = 1 << 30
    for i in 0..MU_NV {
        if !mv_on[i] {
            v = i
            break
        }
        var q = mv_out[i]
        if MU_INST[mv_inst[i]] == 2 && mv_state[i] != 3 { q += 1024 }
        if q < quiet {
            quiet = q
            v = i
        }
    }
    let ch = MU_CHANS[v]
    var flags = SND_ADPCM | SND_LOOP
    if MU_INST[inst + 5] != 0 { flags = flags | SND_REVERB }
    play_sample(ch, mu_bank() + MU_SAMP[smp], MU_SAMP[smp + 1] as u32, MU_SAMP[smp + 2] as u32,
                MU_PITCH[shift], 0, 0, flags as u32)
    mv_on[v] = true
    mv_inst[v] = inst
    mv_age[v] = 0
    mv_hold[v] = MU_SAMP[smp + 3] >> shift
    mv_vol[v] = ((packed >> 11) & 127) * MU_INST[inst + 4] >> 7
    mv_pan[v] = ((packed >> 18) & 127) * 2 + 1
    mv_ph[v] = rnd(MU_TWO_PI)
    mv_out[v] = 0
    if MU_INST[inst] == 1 {
        mv_lvl[v] = MU_FULL
        mv_state[v] = 2
    } else {
        mv_lvl[v] = 0
        mv_state[v] = 1
    }
    if dur > 0 { mv_rel[v] = dur * 256 / tempo } else { mv_rel[v] = -1 }
}

fn mv_frame(i: s32) {
    let inst = mv_inst[i]
    let age = mv_age[i] + 1
    mv_age[i] = age
    var l = mv_lvl[i]
    var st = mv_state[i]
    if mv_rel[i] >= 0 && age >= mv_rel[i] { st = 3 }
    if st == 1 {
        l += MU_INST[inst + 1]
        if l >= MU_FULL {
            l = MU_FULL
            st = 2
        }
    } else if st == 2 {
        if MU_INST[inst] == 1 && age > mv_hold[i] {
            l = l * MU_INST[inst + 2] >> 16
            if l < MU_FULL / 24 { l = 0 }        // -28 dB: the reverb has the rest
        }
    } else {
        l = l * MU_INST[inst + 3] >> 16
        if l < MU_FULL / 16 { l = 0 }            // -24 dB into the release: gone
    }
    mv_lvl[i] = l
    mv_state[i] = st
    var v = mv_vol[i] * l >> 15
    let depth = MU_INST[inst + 6]
    if depth > 0 {
        let ph = (mv_ph[i] + MU_INST[inst + 7]) % MU_TWO_PI
        mv_ph[i] = ph
        let s = bits(sin(from_bits(ph))) >> 8          // -256..256
        v = v * (256 - (depth * (256 - s) >> 9)) >> 8
    }
    if v < MU_KILL && st != 1 {
        mv_on[i] = false
        stop(MU_CHANS[i])
        return
    }
    mv_out[i] = v
    v = v * mu_gain >> 8
    let pan = mv_pan[i]
    let left = clamp(v * min(256, (256 - pan) * 2) >> 8, 0, 255)
    let right = clamp(v * min(256, pan * 2) >> 8, 0, 255)
    mu_reg(MU_CHANS[i])[4] = (left as u32) | ((right as u32) << 8)
}

// ---- control (system.akr)

// Starts the music (after the boot, or back from a preview); it fades in.
fn mu_start() {
    if mu_running { return }
    mu_running = true
    mu_gain = 0
    mu_speed = 1
    sky_update()                  // the sky may not have been drawn yet
    mu_night = mu_night_now()
    for i in 0..MU_NV {
        mv_on[i] = false
        stop(MU_CHANS[i])
    }
    reverb(mu_style(3), 0, 0)
    reverb_decay(mu_style(8 + mu_night))
    mu_wet = mu_style(4 + mu_night)
    mu_wet_reg = -1
    mt_count = mu_style(2)
    for k in 0..mt_count { mt_start(k, mu_style(1) + k) }
}

fn mu_stop() {
    if !mu_running { return }
    mu_running = false
    for i in 0..MU_NV {
        mv_on[i] = false
        stop(MU_CHANS[i])
    }
    reverb(REVERB_OFF, 0, 0)
    mu_gain = 0
}

// target: 0..256; speed: gain change per frame.
fn mu_set_target(target: s32, speed: s32) {
    mu_target = target
    mu_speed = speed
}

// Once per frame while the shell runs.
fn mu_frame() {
    if !mu_running { return }
    if mu_gain < mu_target { mu_gain = min(mu_target, mu_gain + mu_speed) }
    else if mu_gain > mu_target { mu_gain = max(mu_target, mu_gain - mu_speed) }
    mu_night = mu_night_now()

    for k in 0..mt_count { mt_frame(k) }

    let active = sound_active()
    for i in 0..MU_NV {
        if mv_on[i] {
            if (active >> (MU_CHANS[i] as u32)) & 1 == 0 { mv_on[i] = false } else { mv_frame(i) }
        }
    }

    // the reverb follows the gain, and drifts wetter at night
    let wet = mu_style(4 + mu_night)
    if mu_wet < wet { mu_wet += 1 } else if mu_wet > wet { mu_wet -= 1 }
    let w = mu_wet * mu_gain >> 8
    if w != mu_wet_reg {
        mu_wet_reg = w
        REVERB_VOL = (w as u32) | ((w as u32) << 8)
    }
}
